{"arm": "direct", "model": "z-ai/glm-5.3-flashx", "i": 4, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Tidepool \u2014 Plan your week, together</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --ink:#0e2a2b;\n    --ink-soft:#3d5a58;\n    --paper:#faf6ee;\n    --paper-deep:#f2ebdd;\n    --sea:#0d7377;\n    --sea-deep:#084c4f;\n    --foam:#e3efe9;\n    --coral:#e8734a;\n    --hairline:rgba(14,42,43,.14);\n    --serif:'Fraunces',Georgia,serif;\n    --sans:'Inter',sans-serif;\n  }\n  *{margin:0;padding:0;box-sizing:border-box}\n  html{scroll-behavior:smooth}\n  body{background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:16px;line-height:1.65;-webkit-font-smoothing:antialiased;overflow-x:hidden}\n  ::selection{background:var(--sea);color:var(--paper)}\n\n  /* ---------- NAV ---------- */\n  nav{position:fixed;top:0;left:0;right:0;z-index:50;display:flex;align-items:center;justify-content:space-between;\n      padding:20px 5vw;transition:background .35s,box-shadow .35s,padding .35s}\n  nav.scrolled{background:rgba(250,246,238,.92);backdrop-filter:blur(12px);box-shadow:0 1px 0 var(--hairline);padding:12px 5vw}\n  .logo{font-family:var(--serif);font-size:1.35rem;font-weight:600;letter-spacing:-.01em;display:flex;align-items:center;gap:9px;text-decoration:none;color:var(--ink)}\n  .logo svg{display:block}\n  .nav-links{display:flex;gap:32px;align-items:center}\n  .nav-links a{color:var(--ink-soft);text-decoration:none;font-size:.9rem;font-weight:500;transition:color .2s}\n  .nav-links a:hover{color:var(--sea)}\n  .btn{display:inline-block;border:none;cursor:pointer;font-family:var(--sans);font-weight:600;font-size:.92rem;\n       padding:12px 24px;border-radius:100px;text-decoration:none;transition:transform .2s,box-shadow .2s,background .2s}\n  .btn-primary{background:var(--sea);color:#fff}\n  .btn-primary:hover{background:var(--sea-deep);transform:translateY(-2px);box-shadow:0 8px 22px rgba(13,115,119,.28)}\n  .btn-ghost{background:transparent;color:var(--ink);border:1.5px solid var(--ink);padding:10.5px 23px}\n  .btn-ghost:hover{background:var(--ink);color:var(--paper)}\n  .btn-sm{padding:9px 20px;font-size:.85rem}\n\n  /* ---------- HERO ---------- */\n  .hero{position:relative;min-height:100vh;display:flex;flex-direction:column;justify-content:center;\n        padding:140px 5vw 0;overflow:hidden}\n  #tide{position:absolute;inset:0;width:100%;height:100%;z-index:0}\n  .hero-inner{position:relative;z-index:2;max-width:840px}\n  .eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:.78rem;font-weight:600;letter-spacing:.14em;\n           text-transform:uppercase;color:var(--sea);margin-bottom:26px}\n  .eyebrow::before{content:\"\";width:28px;height:1.5px;background:var(--sea)}\n  h1{font-family:var(--serif);font-weight:400;font-size:clamp(2.8rem,6.4vw,5.2rem);line-height:1.04;letter-spacing:-.02em}\n  h1 em{font-style:italic;color:var(--sea)}\n  .hero p{margin-top:28px;max-width:520px;font-size:1.13rem;color:var(--ink-soft)}\n  .hero-cta{margin-top:38px;display:flex;gap:16px;flex-wrap:wrap;align-items:center}\n  .hero-note{font-size:.83rem;color:var(--ink-soft);opacity:.75}\n\n  .scroll-hint{position:absolute;bottom:34px;left:5vw;z-index:2;display:flex;align-items:center;gap:10px;\n                font-size:.78rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-soft)}\n  .scroll-hint .line{width:1.5px;height:44px;background:var(--ink-soft);position:relative;overflow:hidden}\n  .scroll-hint .line::after{content:\"\";position:absolute;left:0;top:-50%;width:100%;height:50%;background:var(--sea);\n                             animation:drip 1.8s ease-in-out infinite}\n  @keyframes drip{to{top:110%}}\n\n  /* ---------- MARQUEE STRIP ---------- */\n  .strip{background:var(--ink);color:var(--paper);padding:16px 0;overflow:hidden;white-space:nowrap}\n  .strip-track{display:inline-flex;animation:slide 32s linear infinite}\n  .strip span{font-family:var(--serif);font-style:italic;font-size:1rem;padding:0 34px;opacity:.85}\n  .strip span::after{content:\"\u00b7\";margin-left:34px;color:var(--coral)}\n  @keyframes slide{to{transform:translateX(-50%)}}\n\n  /* ---------- SECTION SHELL ---------- */\n  section{padding:110px 5vw}\n  .section-label{font-size:.78rem;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--coral);margin-bottom:18px}\n  h2{font-family:var(--serif);font-weight:400;font-size:clamp(2rem,4vw,3.1rem);line-height:1.12;letter-spacing:-.015em;max-width:640px}\n  h2 em{font-style:italic;color:var(--sea)}\n\n  /* ---------- RHYTHM (three steps, offset \u2014 no uniform cards) ---------- */\n  .rhythm{background:var(--paper)}\n  .steps{margin-top:70px;display:flex;flex-direction:column;gap:0;max-width:1050px}\n  .step{display:grid;grid-template-columns:120px 1fr 1.1fr;gap:40px;align-items:start;\n        padding:44px 0;border-top:1px solid var(--hairline)}\n  .step:last-child{border-bottom:1px solid var(--hairline)}\n  .step:nth-child(2){transform:translateX(4%)}\n  .step:nth-child(3){transform:translateX(8%)}\n  .step-num{font-family:var(--serif);font-size:3.4rem;font-weight:300;font-style:italic;color:var(--sea);line-height:1}\n  .step h3{font-family:var(--serif);font-size:1.55rem;font-weight:500;margin-bottom:12px}\n  .step p{color:var(--ink-soft);font-size:.98rem}\n  .step-visual{background:#fff;border:1px solid var(--hairline);border-radius:14px;padding:22px;\n               box-shadow:0 12px 34px rgba(14,42,43,.07)}\n  .chip-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}\n  .chip{font-size:.75rem;font-weight:600;padding:5px 12px;border-radius:100px;background:var(--foam);color:var(--sea-deep)}\n  .chip.warm{background:#fbe9e0;color:#a44a26}\n  .mini-week{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}\n  .mini-day{background:var(--foam);border-radius:8px;height:64px;position:relative;overflow:hidden}\n  .mini-day b{position:absolute;top:6px;left:8px;font-size:.68rem;color:var(--sea-deep);font-weight:600}\n  .mini-day i{position:absolute;left:6px;right:6px;border-radius:4px;background:var(--sea);opacity:.85}\n  .mini-day i.c{background:var(--coral)}\n  .vote{display:flex;gap:10px;align-items:center}\n  .vote-pill{flex:1;background:var(--foam);border-radius:10px;padding:12px 14px;display:flex;justify-content:space-between;align-items:center;font-size:.82rem;font-weight:500;color:var(--sea-deep)}\n  .vote-pill.warm{background:#fbe9e0;color:#a44a26}\n  .vote-pill .v{font-family:var(--serif);font-style:italic;font-size:1rem}\n\n  /* ---------- SIGNATURE: WEEK TIDE PLAYGROUND ---------- */\n  .tide-lab{background:var(--ink);color:var(--paper);position:relative;overflow:hidden}\n  .tide-lab::before{content:\"\";position:absolute;inset:0;\n      background:radial-gradient(ellipse 70% 55% at 75% 20%, rgba(13,115,119,.35), transparent 70%)}\n  .tide-lab-inner{position:relative;z-index:2;display:grid;grid-template-columns:1fr 1.15fr;gap:70px;align-items:center}\n  .tide-lab h2{color:var(--paper)}\n  .tide-lab h2 em{color:#5bc8c2}\n  .tide-lab p{color:rgba(250,246,238,.72);margin-top:20px;max-width:440px}\n  .lab-hint{margin-top:26px;display:inline-flex;align-items:center;gap:10px;font-size:.82rem;color:#5bc8c2;\n            border:1px solid rgba(91,200,194,.35);padding:9px 18px;border-radius:100px}\n  .lab-hint svg{animation:sway 2.4s ease-in-out infinite}\n  @keyframes sway{0%,100%{transform:translateX(-3px)}50%{transform:translateX(3px)}}\n  .board{background:rgba(250,246,238,.06);border:1px solid rgba(250,246,238,.14);border-radius:18px;padding:26px;\n         backdrop-filter:blur(6px)}\n  .board-head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:20px}\n  .board-head strong{font-family:var(--serif);font-weight:500;font-size:1.15rem}\n  .board-head span{font-size:.78rem;color:rgba(250,246,238,.55)}\n  .pool{display:grid;grid-template-columns:180px 1fr;gap:20px}\n  .pool-items{display:flex;flex-direction:column;gap:10px}\n  .pool-item{background:rgba(250,246,238,.1);border:1px solid rgba(250,246,238,.2);border-radius:10px;\n             padding:11px 14px;font-size:.85rem;cursor:grab;user-select:none;transition:background .2s,transform .2s;\n             display:flex;align-items:center;gap:9px}\n  .pool-item:hover{background:rgba(250,246,238,.2);transform:translateX(3px)}\n  .pool-item.dragging{opacity:.35}\n  .pool-item .dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}\n  .pool-empty{font-size:.78rem;color:rgba(250,246,238,.45);font-style:italic;font-family:var(--serif)}\n  .week-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;min-height:230px}\n  .day-col{background:rgba(250,246,238,.06);border:1px dashed rgba(250,246,238,.2);border-radius:10px;\n           padding:8px;display:flex;flex-direction:column;gap:6px;transition:border-color .2s,background .2s}\n  .day-col.over{border-color:#5bc8c2;background:rgba(91,200,194,.12)}\n  .day-col b{font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;color:rgba(250,246,238,.55);font-weight:600;padding:2px 4px 6px}\n  .day-task{background:var(--sea);border-radius:7px;padding:8px 9px;font-size:.75rem;font-weight:500;line-height:1.35;\n            animation:dropIn .3s cubic-bezier(.34,1.56,.64,1)}\n  .day-task.coral{background:var(--coral)}\n  .day-task.calm{background:#5bc8c2;color:var(--ink)}\n  @keyframes dropIn{from{transform:scale(.7);opacity:0}to{transform:scale(1);opacity:1}}\n  .board-foot{margin-top:18px;font-size:.8rem;color:rgba(250,246,238,.55);display:flex;justify-content:space-between}\n\n  /* ---------- MANIFESTO ---------- */\n  .manifesto{background:var(--paper-deep)}\n  .manifesto-wrap{max-width:880px}\n  .manifesto blockquote{font-family:var(--serif);font-weight:300;font-size:clamp(1.5rem,3vw,2.3rem);line-height:1.4;\n                        letter-spacing:-.01em;margin-top:34px}\n  .manifesto blockquote em{font-style:italic;color:var(--sea)}\n  .manifesto cite{display:block;margin-top:34px;font-style:normal;font-size:.9rem;color:var(--ink-soft)}\n  .manifesto cite b{color:var(--ink)}\n  .avatars{display:flex;margin-top:10px}\n  .avatars i{width:34px;height:34px;border-radius:50%;border:2px solid var(--paper-deep);margin-left:-10px}\n  .avatars i:first-child{margin-left:0}\n  .avatars i:nth-child(1){background:#0d7377}.avatars i:nth-child(2){background:#e8734a}\n  .avatars i:nth-child(3){background:#084c4f}.avatars i:nth-child(4){background:#5bc8c2}\n\n  /* ---------- CTA ---------- */\n  .cta{text-align:center;padding:130px 5vw;position:relative;background:var(--paper)}\n  .cta h2{margin:0 auto;max-width:680px}\n  .cta p{max-width:440px;margin:22px auto 0;color:var(--ink-soft)}\n  .cta form{margin-top:40px;display:flex;gap:12px;justify-content:center;flex-wrap:wrap}\n  .cta input{font-family:var(--sans);font-size:.95rem;padding:13px 22px;border-radius:100px;border:1.5px solid var(--hairline);\n             background:#fff;min-width:280px;color:var(--ink);outline:none;transition:border-color .2s}\n  .cta input:focus{border-color:var(--sea)}\n  .cta .fine{font-size:.78rem;margin-top:18px;opacity:.65}\n\n  /* ---------- FOOTER ---------- */\n  footer{background:var(--ink);color:rgba(250,246,238,.65);padding:56px 5vw 40px;\n         display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:30px}\n  footer .logo{color:var(--paper)}\n  footer .f-links{display:flex;gap:26px}\n  footer a{color:rgba(250,246,238,.65);text-decoration:none;font-size:.85rem;transition:color .2s}\n  footer a:hover{color:#5bc8c2}\n  footer small{font-size:.78rem;opacity:.6}\n\n  /* ---------- REVEAL ---------- */\n  .reveal{opacity:0;transform:translateY(28px);transition:opacity .8s ease,transform .8s ease}\n  .reveal.in{opacity:1;transform:none}\n\n  @media(max-width:920px){\n    .tide-lab-inner{grid-template-columns:1fr}\n    .pool{grid-template-columns:1fr}\n    .step{grid-template-columns:1fr;gap:18px}\n    .step:nth-child(2),.step:nth-child(3){transform:none}\n    .nav-links a:not(.btn){display:none}\n    .week-grid{grid-template-columns:repeat(3,1fr)}\n  }\n</style>\n</head>\n<body>\n\n<nav id=\"nav\">\n  <a class=\"logo\" href=\"#\">\n    <svg width=\"26\" height=\"26\" viewBox=\"0 0 26 26\" fill=\"none\">\n      <circle cx=\"13\" cy=\"13\" r=\"12\" stroke=\"#0d7377\" stroke-width=\"2\"/>\n      <path d=\"M4 15c3-2.5 6-2.5 9 0s6 2.5 9 0\" stroke=\"#e8734a\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n      <path d=\"M4 10c3-2.5 6-2.5 9 0s6 2.5 9 0\" stroke=\"#0d7377\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n    </svg>\n    Tidepool\n  </a>\n  <div class=\"nav-links\">\n    <a href=\"#rhythm\">How it works</a>\n    <a href=\"#playground\">The board</a>\n    <a href=\"#start\" class=\"btn btn-primary btn-sm\">Start free</a>\n  </div>\n</nav>\n\n<!-- HERO -->\n<header class=\"hero\">\n  <canvas id=\"tide\"></canvas>\n  <div class=\"hero-inner\">\n    <span class=\"eyebrow\">Weekly planning for small teams</span>\n    <h1>Your week has a rhythm.<br>Stop fighting it. <em>Plan with it.</em></h1>\n    <p>Tidepool is a gentle weekly ritual for teams of 2\u201315. Everyone drops their intentions into the pool, the team shapes the week together, and Monday stops being a scramble.</p>\n    <div class=\"hero-cta\">\n      <a href=\"#start\" class=\"btn btn-primary\">Start your first tide \u2014 free</a>\n      <a href=\"#playground\" class=\"btn btn-ghost\">Try the board \u2192</a>\n    </div>\n    <p class=\"hero-note\" style=\"margin-top:20px\">No credit card. Set up in 4 minutes.</p>\n  </div>\n  <div class=\"scroll-hint\"><span class=\"line\"></span>Drift down</div>\n</header>\n\n<!-- MARQUEE -->\n<div class=\"strip\" aria-hidden=\"true\">\n  <div class=\"strip-track\" id=\"stripTrack\">\n    <span>Monday standups, cancelled</span>\n    <span>Fridays that actually end</span>\n    <span>One shared plan, zero guessing</span>\n    <span>Capacity you can see</span>\n    <span>Overcommitment, outgrown</span>\n  </div>\n</div>\n\n<!-- RHYTHM -->\n<section class=\"rhythm\" id=\"rhythm\">\n  <div class=\"reveal\">\n    <p class=\"section-label\">The weekly rhythm</p>\n    <h2>Three tides a week.<br><em>That's the whole tool.</em></h2>\n  </div>\n  <div class=\"steps\">\n    <div class=\"step reveal\">\n      <div class=\"step-num\">01</div>\n      <div>\n        <h3>Drop it in the pool</h3>\n        <p>Anytime before planning, everyone tosses in what they're thinking about \u2014 new ideas, loose threads, that thing from last week that never shipped. Nothing is a commitment yet.</p>\n        <div class=\"chip-row\">\n          <span class=\"chip\">Redesign onboarding</span>\n          <span class=\"chip warm\">Fix invoice bug</span>\n          <span class=\"chip\">Draft Q3 narrative</span>\n          <span class=\"chip warm\">Call with Priya</span>\n        </div>\n      </div>\n      <div class=\"step-visual\">\n        <div style=\"font-size:.75rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:8px\">This week's pool</div>\n        <div class=\"chip-row\" style=\"margin-top:4px\">\n          <span class=\"chip\">\u00b7 6 items from 4 people</span>\n          <span class=\"chip warm\">\u00b7 2 flagged \u201csoon\u201d</span>\n          <span class=\"chip\">\u00b7 1 carries over</span>\n        </div>\n      </div>\n    </div>\n    <div class=\"step reveal\">\n      <div class=\"step-num\">02</div>\n      <div>\n        <h3>Shape it together</h3>\n        <p>A 20-minute session \u2014 async or live. The team votes, nudges, and places items into days while Tidepool watches everyone's real capacity, so nobody quietly drowns.</p>\n      </div>\n      <div class=\"step-visual\">\n        <div style=\"font-size:.75rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:14px\">Team votes</div>\n        <div class=\"vote\">\n          <div class=\"vote-pill\">Redesign onboarding <span class=\"v\">\u2665 4</span></div>\n          <div class=\"vote-pill warm\">Fix invoice bug <span class=\"v\">\u2665 3</span></div>\n        </div>\n        <div style=\"margin-top:12px;font-size:.8rem;color:var(--ink-soft)\">\u26a0 Maya is at 105% if this all lands Wednesday.</div>\n      </div>\n    </div>\n    <div class=\"step reveal\">\n      <div class=\"step-num\">03</div>\n      <div>\n        <h3>Let the week flow</h3>\n        <p>When reality shifts \u2014 and it will \u2014 drag things between days. The whole team sees the ripple instantly. No re-planning meetings, no stale docs.</p>\n      </div>\n      <div class=\"step-visual\">\n        <div class=\"mini-week\">\n          <div class=\"mini-day\"><b>M</b><i style=\"top:26px;height:16px\"></i><i class=\"c\" style=\"top:46px;height:10px\"></i></div>\n          <div class=\"mini-day\"><b>T</b><i style=\"top:26px;height:12px\"></i></div>\n          <div class=\"mini-day\"><b>W</b><i class=\"c\" style=\"top:26px;height:16px\"></i><i style=\"top:46px;height:14px\"></i></div>\n          <div class=\"mini-day\"><b>T</b><i style=\"top:30px;height:12px\"></i></div>\n          <div class=\"mini-day\"><b>F</b><i style=\"top:52px;height:8px\"></i></div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- SIGNATURE PLAYGROUND -->\n<section class=\"tide-lab\" id=\"playground\">\n  <div class=\"tide-lab-inner\">\n    <div class=\"reveal\">\n      <p class=\"section-label\" style=\"color:#5bc8c2\">Try it right here</p>\n      <h2>Drag a thought<br>into your week. <em>Feel the ease.</em></h2>\n      <p>This is a live Tidepool board. Pull an item from the pool and drop it on any day \u2014 exactly how your team will do it every Monday. That's the entire learning curve.</p>\n      <div class=\"lab-hint\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M2 8h12M2 8l3-3M2 8l3 3M14 8l-3-3M14 8l-3 3\" stroke=\"#5bc8c2\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n        Drag items into the days\n      </div>\n    </div>\n    <div class=\"board reveal\" id=\"board\">\n      <div class=\"board-head\">\n        <strong>Week of June 9</strong>\n        <span>Fern &amp; Ripple \u00b7 4 people</span>\n      </div>\n      <div class=\"pool\">\n        <div class=\"pool-items\" id=\"pool\">\n          <div class=\"pool-empty\" id=\"poolEmpty\">The pool is calm\u2026</div>\n        </div>\n        <div class=\"week-grid\" id=\"weekGrid\">\n          <div class=\"day-col\" data-day=\"Mon\"><b>Mon</b></div>\n          <div class=\"day-col\" data-day=\"Tue\"><b>Tue</b></div>\n          <div class=\"day-col\" data-day=\"Wed\"><b>Wed</b></div>\n          <div class=\"day-col\" data-day=\"Thu\"><b>Thu</b></div>\n          <div class=\"day-col\" data-day=\"Fri\"><b>Fri</b></div>\n        </div>\n      </div>\n      <div class=\"board-foot\">\n        <span id=\"boardCount\">4 items waiting in the pool</span>\n        <span>Everyone's capacity: \u2713 healthy</span>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- MANIFESTO -->\n<section class=\"manifesto\">\n  <div class=\"manifesto-wrap reveal\">\n    <p class=\"section-label\">Why we built this</p>\n    <blockquote>\u201cWe tried every project tool with a thousand features. What our team actually needed was one honest conversation about the week \u2014 <em>and a place to put it.</em>\u201d</blockquote>\n    <div class=\"avatars\"><i></i><i></i><i></i><i></i></div>\n    <cite><b>The Tidepool team</b> \u2014 former leads at three startups that planned too much, too fast, every single week.</cite>\n  </div>\n</section>\n\n<!-- CTA -->\n<section class=\"cta\" id=\"start\">\n  <div class=\"reveal\">\n    <p class=\"section-label\" style=\"justify-content:center;display:flex\">Slack in, calm out</p>\n    <h2>Next Monday could feel<br><em>different.</em></h2>\n    <p>Free for teams up to 5, forever. Works alongside Slack \u2014 no migration, no ceremony.</p>\n    <form onsubmit=\"event.preventDefault();this.querySelector('input').value='';this.querySelector('button').textContent='You\\u2019re in the pool \u2713';\">\n      <input type=\"email\" required placeholder=\"you@yourteam.com\" aria-label=\"Work email\">\n      <button class=\"btn btn-primary\" type=\"submit\">Start your first tide</button>\n    </form>\n    <p class=\"fine\">Questions? Just reply to the welcome email \u2014 a human answers.</p>\n  </div>\n</section>\n\n<footer>\n  <div>\n    <a class=\"logo\" href=\"#\" style=\"margin-bottom:14px\">\n      <svg width=\"24\" height=\"24\" viewBox=\"0 0 26 26\" fill=\"none\">\n        <circle cx=\"13\" cy=\"13\" r=\"12\" stroke=\"#5bc8c2\" stroke-width=\"2\"/>\n        <path d=\"M4 15c3-2.5 6-2.5 9 0s6 2.5 9 0\" stroke=\"#e8734a\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n        <path d=\"M4 10c3-2.5 6-2.5 9 0s6 2.5 9 0\" stroke=\"#5bc8c2\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n      </svg>\n      Tidepool\n    </a>\n    <small>\u00a9 2025 Tidepool. Made slowly, on purpose.</small>\n  </div>\n  <div class=\"f-links\">\n    <a href=\"#rhythm\">Rhythm</a><a href=\"#playground\">Board</a><a href=\"#start\">Pricing</a><a href=\"#\">Privacy</a>\n  </div>\n</footer>\n\n<script>\n/* ---------- nav scroll ---------- */\nconst nav = document.getElementById('nav');\naddEventListener('scroll', () => nav.classList.toggle('scrolled', scrollY > 40), {passive:true});\n\n/* ---------- duplicate marquee for seamless loop ---------- */\nconst track = document.getElementById('stripTrack');\ntrack.innerHTML += track.innerHTML;\n\n/* ---------- reveal on scroll ---------- */\nconst io = new IntersectionObserver(es => es.forEach(e => {\n  if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }\n}), {threshold:.12});\ndocument.querySelectorAll('.reveal').forEach(el => io.observe(el));\n\n/* ---------- hero tide canvas ---------- */\nconst cv = document.getElementById('tide'), ctx = cv.getContext('2d');\nlet W, H, t = 0;\nfunction resize(){ W = cv.width = innerWidth; H = cv.height = cv.parentElement.offsetHeight; }\nresize(); addEventListener('resize', resize);\nconst waves = [\n  {y:.72, amp:26, len:.008, sp:.012, col:'rgba(13,115,119,.10)'},\n  {y:.78, amp:34, len:.006, sp:.017, col:'rgba(13,115,119,.16)'},\n  {y:.85, amp:22, len:.011, sp:.009, col:'rgba(8,76,79,.14)'},\n  {y:.91, amp:30, len:.007, sp:.014, col:'rgba(8,76,79,.22)'}\n];\n(function draw(){\n  ctx.clearRect(0,0,W,H);\n  waves.forEach(w => {\n    ctx.beginPath(); ctx.moveTo(0,H);\n    for (let x=0; x<=W; x+=4){\n      const y = H*w.y + Math.sin(x*w.len + t*w.sp*60)*w.amp\n                      + Math.sin(x*w.len*2.3 + t*w.sp*38)*w.amp*.4;\n      ctx.lineTo(x,y);\n    }\n    ctx.lineTo(W,H); ctx.closePath();\n    ctx.fillStyle = w.col; ctx.fill();\n  });\n  t += .016;\n  requestAnimationFrame(draw);\n})();\n\n/* ---------- signature: draggable week board ---------- */\nconst items = [\n  {label:'Ship pricing page', c:''},\n  {label:'Interview notes \u2192 insights', c:'calm'},\n  {label:'Fix the invoice bug \ud83d\udc1b'.replace(' \ud83d\udc1b',''), c:'coral'},\n  {label:'Team retro + snacks', c:'calm'}\n];\nconst pool = document.getElementById('pool'), poolEmpty = document.getElementById('poolEmpty');\nconst boardCount = document.getElementById('boardCount');\nfunction updateCount(){\n  boardCount.textContent = items.length\n    ? items.length + ' item' + (items.length>1?'s':'') + ' waiting in the pool'\n    : 'Pool is clear \u2014 nice week ahead';\n  poolEmpty.style.display = items.length ? 'block' : 'none';\n}\nitems.forEach((it,i) => {\n  const el = document.createElement('div');\n  el.className = 'pool-item'; el.draggable = true; el.dataset.c = it.c;\n  el.innerHTML = '<span class=\"dot\" style=\"background:'+(it.c==='coral'?'#e8734a':it.c==='calm'?'#5bc8c2':'#5bc8c2')+'\"></span>'+it.label;\n  pool.appendChild(el);\n  wire(el);\n});\nfunction wire(el){\n  el.addEventListener('dragstart', () => { el.classList.add('dragging'); dragged = el; });\n  el.addEventListener('dragend', () => { el.classList.remove('dragging'); dragged = null; });\n}\nlet dragged = null;\ndocument.querySelectorAll('.day-col').forEach(col => {\n  col.addEventListener('dragover', e => { e.preventDefault(); col.classList.add('over'); });\n  col.addEventListener('dragleave', () => col.classList.remove('over'));\n  col.addEventListener('drop', e => {\n    e.preventDefault(); col.classList.remove('over');\n    if (!dragged) return;\n    const task = document.createElement('div');\n    task.className = 'day-task ' + (dragged.dataset.c||'');\n    task.textContent = dragged.textContent.trim();\n    task.draggable = true;\n    // allow moving between days / back to pool\n    task.addEventListener('dragstart', () => { task.classList.add('dragging'); dragged = task; fromCol = task.parentElement; });\n    task.addEventListener('dragend', () => { task.classList.remove('dragging'); dragged = null; });\n    if (dragged.classList.contains('pool-item')) {\n      items.splice(items.findIndex(x => x.label === dragged.textContent.trim()),1);\n      updateCount();\n    }\n    col.appendChild(task);\n    dragged.remove();\n  });\n});\nlet fromCol = null;\npool.addEventListener('dragover', e => e.preventDefault());\npool.addEventListener('drop', e => {\n  e.preventDefault();\n  if (dragged && dragged.classList.contains('day-task')){\n    items.push({label: dragged.textContent.trim(), c: dragged.dataset.c || ''});\n    updateCount();\n    dragged.remove();\n  }\n});\nupdateCount();\n</script>\n</body>\n</html>\n"}