{"arm": "direct", "model": "anthropic/claude-haiku-5.5", "i": 1, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Tidepool: Plan your week together</title>\n<meta name=\"description\" content=\"Tidepool helps small teams plan their week together, with shared priorities, quick check-ins, and a Friday review that takes minutes.\">\n<style>\n  :root {\n    --ink: #0e2a33;\n    --ink-soft: #3d5a63;\n    --sea: #1d6b74;\n    --sea-deep: #134b53;\n    --foam: #e8f4f2;\n    --mist: #f4f9f8;\n    --sand: #f8f3e9;\n    --shell: #fffdf8;\n    --coral: #ff7a59;\n    --coral-deep: #e8613f;\n    --kelp: #3f9d74;\n    --sun: #f6c453;\n    --line: #d8e7e4;\n    --radius: 18px;\n    --shadow: 0 1px 2px rgba(14,42,51,.06), 0 12px 32px rgba(14,42,51,.10);\n    --font: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n  }\n\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  html { scroll-behavior: smooth; }\n  body {\n    font-family: var(--font);\n    color: var(--ink);\n    background: var(--shell);\n    line-height: 1.6;\n    -webkit-font-smoothing: antialiased;\n  }\n  a { color: inherit; text-decoration: none; }\n  img, svg { display: block; max-width: 100%; }\n\n  .wrap { width: min(1120px, 92%); margin-inline: auto; }\n\n  /* ---------- Buttons ---------- */\n  .btn {\n    display: inline-flex; align-items: center; justify-content: center; gap: .5rem;\n    padding: .85rem 1.4rem; border-radius: 999px; font-weight: 600; font-size: 1rem;\n    border: 2px solid transparent; cursor: pointer; transition: transform .15s ease, background .2s ease, box-shadow .2s ease;\n    white-space: nowrap;\n  }\n  .btn:hover { transform: translateY(-1px); }\n  .btn-primary { background: var(--coral); color: #fff; box-shadow: 0 8px 20px rgba(255,122,89,.35); }\n  .btn-primary:hover { background: var(--coral-deep); }\n  .btn-ghost { background: transparent; color: var(--ink); border-color: var(--line); }\n  .btn-ghost:hover { border-color: var(--sea); color: var(--sea); }\n  .btn-light { background: #fff; color: var(--sea-deep); }\n  .btn-light:hover { background: var(--foam); }\n  .btn-sm { padding: .55rem 1.05rem; font-size: .92rem; }\n\n  /* ---------- Nav ---------- */\n  .nav {\n    position: sticky; top: 0; z-index: 50;\n    background: rgba(255,253,248,.86); backdrop-filter: saturate(1.4) blur(10px);\n    border-bottom: 1px solid var(--line);\n  }\n  .nav .wrap { display: flex; align-items: center; justify-content: space-between; height: 72px; }\n  .logo { display: flex; align-items: center; gap: .6rem; font-weight: 800; font-size: 1.25rem; letter-spacing: -.01em; color: var(--sea-deep); }\n  .nav-links { display: flex; gap: 2rem; font-size: .95rem; color: var(--ink-soft); font-weight: 500; }\n  .nav-links a:hover { color: var(--sea); }\n  .nav-actions { display: flex; align-items: center; gap: .75rem; }\n  .nav-login { font-weight: 600; font-size: .95rem; color: var(--ink-soft); padding: .5rem .7rem; }\n  .nav-login:hover { color: var(--sea); }\n\n  /* ---------- Hero ---------- */\n  .hero {\n    position: relative; overflow: hidden;\n    background:\n      radial-gradient(1000px 500px at 85% -10%, rgba(63,157,116,.16), transparent 60%),\n      radial-gradient(800px 480px at -10% 20%, rgba(29,107,116,.20), transparent 60%),\n      linear-gradient(180deg, var(--mist), var(--shell));\n    padding: 88px 0 96px;\n  }\n  .hero-grid { display: grid; grid-template-columns: 1.02fr .98fr; gap: 56px; align-items: center; }\n  .eyebrow {\n    display: inline-flex; align-items: center; gap: .5rem;\n    background: #fff; border: 1px solid var(--line); border-radius: 999px;\n    padding: .35rem .85rem; font-size: .85rem; font-weight: 600; color: var(--sea);\n    margin-bottom: 1.4rem;\n  }\n  .eyebrow .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--kelp); box-shadow: 0 0 0 4px rgba(63,157,116,.2); }\n  h1 {\n    font-size: clamp(2.5rem, 5.2vw, 4.1rem);\n    line-height: 1.04; letter-spacing: -.035em; font-weight: 800; color: var(--ink);\n  }\n  h1 em { font-style: normal; color: var(--sea); }\n  .lead { font-size: 1.2rem; color: var(--ink-soft); margin-top: 1.4rem; max-width: 34em; }\n  .hero-ctas { display: flex; flex-wrap: wrap; gap: .9rem; margin-top: 2.2rem; }\n  .hero-note { margin-top: 1.1rem; font-size: .9rem; color: var(--ink-soft); display: flex; align-items: center; gap: .5rem; }\n  .check { color: var(--kelp); font-weight: 700; }\n\n  /* Mock app */\n  .mock {\n    background: var(--shell); border-radius: 22px; box-shadow: 0 30px 70px rgba(14,42,51,.18), 0 0 0 1px rgba(14,42,51,.06);\n    overflow: hidden; transform: rotate(-1.2deg);\n  }\n  .mock-bar {\n    display: flex; align-items: center; justify-content: space-between;\n    padding: .85rem 1.1rem; border-bottom: 1px solid var(--line); background: var(--mist);\n  }\n  .mock-dots { display: flex; gap: 6px; }\n  .mock-dots span { width: 10px; height: 10px; border-radius: 50%; background: #cfe0dc; }\n  .mock-dots span:first-child { background: #f4a6a0; }\n  .mock-dots span:nth-child(2) { background: #f7d38b; }\n  .mock-dots span:nth-child(3) { background: #a8d8bf; }\n  .mock-title { font-weight: 700; font-size: .9rem; color: var(--ink-soft); }\n  .mock-week { font-size: .8rem; color: var(--ink-soft); background: #fff; border: 1px solid var(--line); padding: .2rem .6rem; border-radius: 999px; }\n  .mock-tide {\n    display: flex; align-items: center; gap: .75rem; padding: 1rem 1.1rem;\n    background: linear-gradient(90deg, var(--sea), #2b8a8f); color: #fff;\n  }\n  .mock-tide-icon { width: 34px; height: 34px; border-radius: 10px; background: rgba(255,255,255,.18); display: grid; place-items: center; flex-shrink: 0; }\n  .mock-tide p { font-size: .9rem; line-height: 1.35; }\n  .mock-tide strong { display: block; font-size: .72rem; text-transform: uppercase; letter-spacing: .08em; opacity: .8; font-weight: 700; }\n  .mock-days { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; padding: 1rem; }\n  .mock-day { background: var(--mist); border-radius: 12px; padding: .6rem; min-height: 214px; }\n  .mock-day.today { background: #fff; box-shadow: inset 0 0 0 2px var(--sea); }\n  .mock-day h4 { font-size: .75rem; color: var(--ink-soft); font-weight: 700; margin-bottom: .55rem; display: flex; justify-content: space-between; }\n  .mock-day h4 span { color: var(--sea); }\n  .task {\n    background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: .45rem .5rem;\n    font-size: .72rem; line-height: 1.3; margin-bottom: .45rem; box-shadow: 0 1px 2px rgba(14,42,51,.04);\n  }\n  .task .who { display: flex; align-items: center; gap: .3rem; margin-top: .35rem; color: var(--ink-soft); font-size: .65rem; }\n  .av { width: 16px; height: 16px; border-radius: 50%; display: inline-grid; place-items: center; font-size: .5rem; font-weight: 800; color: #fff; flex-shrink: 0; }\n  .av.a { background: var(--coral); }\n  .av.b { background: var(--sea); }\n  .av.c { background: var(--kelp); }\n  .av.d { background: #8a6fd1; }\n  .task.done { opacity: .55; }\n  .task.done p { text-decoration: line-through; }\n  .task.focus { border-left: 3px solid var(--sun); }\n  .mock-foot {\n    display: flex; justify-content: space-between; align-items: center;\n    padding: .8rem 1.1rem; border-top: 1px solid var(--line); font-size: .8rem; color: var(--ink-soft); background: var(--mist);\n  }\n  .progress { flex: 1; height: 8px; background: #d9ebe7; border-radius: 999px; margin: 0 .9rem; overflow: hidden; }\n  .progress i { display: block; height: 100%; width: 64%; background: linear-gradient(90deg, var(--kelp), #6fc49b); border-radius: 999px; }\n\n  /* Floating chip */\n  .chip {\n    position: absolute; background: #fff; border-radius: 14px; padding: .7rem .9rem;\n    box-shadow: var(--shadow); font-size: .85rem; display: flex; align-items: center; gap: .6rem; font-weight: 600;\n  }\n  .chip small { display: block; font-weight: 500; color: var(--ink-soft); font-size: .75rem; }\n  .chip-1 { left: -22px; bottom: 56px; }\n  .chip-2 { right: -18px; top: 34px; }\n\n  .hero-visual { position: relative; padding: 16px 24px 24px; }\n\n  /* ---------- Stats strip ---------- */\n  .strip { background: var(--sea-deep); color: #d6ebe8; }\n  .strip .wrap { display: grid; grid-template-columns: repeat(4, 1fr); text-align: center; padding: 28px 0; gap: 12px; }\n  .strip strong { display: block; font-size: 1.9rem; color: #fff; letter-spacing: -.02em; }\n  .strip span { font-size: .92rem; opacity: .85; }\n\n  /* ---------- Sections ---------- */\n  section { padding: 100px 0; }\n  .section-head { text-align: center; max-width: 680px; margin: 0 auto 60px; }\n  .kicker { color: var(--coral-deep); font-weight: 700; font-size: .85rem; text-transform: uppercase; letter-spacing: .12em; }\n  h2 { font-size: clamp(2rem, 3.6vw, 2.8rem); line-height: 1.12; letter-spacing: -.025em; margin-top: .6rem; font-weight: 800; }\n  .section-head p { color: var(--ink-soft); margin-top: 1rem; font-size: 1.1rem; }\n\n  /* Features */\n  .features { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }\n  .card {\n    background: #fff; border: 1px solid var(--line); border-radius: var(--radius);\n    padding: 32px 28px; box-shadow: 0 1px 2px rgba(14,42,51,.04); transition: transform .2s ease, box-shadow .2s ease;\n  }\n  .card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }\n  .icon {\n    width: 52px; height: 52px; border-radius: 15px; display: grid; place-items: center; margin-bottom: 20px;\n  }\n  .icon.sea { background: var(--foam); color: var(--sea); }\n  .icon.coral { background: #ffeee9; color: var(--coral-deep); }\n  .icon.kelp { background: #e5f4ec; color: var(--kelp); }\n  .card h3 { font-size: 1.25rem; margin-bottom: .6rem; letter-spacing: -.01em; }\n  .card p { color: var(--ink-soft); font-size: .98rem; }\n\n  /* How it works */\n  .how { background: var(--sand); }\n  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; position: relative; counter-reset: step; }\n  .step { position: relative; padding-top: 8px; }\n  .step-num {\n    width: 56px; height: 56px; border-radius: 50%; background: var(--ink); color: #fff;\n    display: grid; place-items: center; font-weight: 800; font-size: 1.2rem; margin-bottom: 22px;\n    box-shadow: 0 0 0 8px var(--sand);\n  }\n  .step h3 { font-size: 1.3rem; margin-bottom: .5rem; }\n  .step p { color: var(--ink-soft); }\n  .step ul { list-style: none; margin-top: 1rem; display: grid; gap: .45rem; }\n  .step li { font-size: .93rem; color: var(--ink-soft); padding-left: 1.4rem; position: relative; }\n  .step li::before { content: \"\"; position: absolute; left: 0; top: .55em; width: 8px; height: 8px; border-radius: 50%; background: var(--kelp); }\n\n  /* Quote */\n  .quote-wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }\n  .quote-card {\n    background: linear-gradient(160deg, var(--sea), var(--sea-deep)); color: #fff; border-radius: 26px; padding: 48px;\n    position: relative; overflow: hidden;\n  }\n  .quote-card::after {\n    content: \"\"; position: absolute; right: -60px; bottom: -60px; width: 220px; height: 220px; border-radius: 50%;\n    background: radial-gradient(circle, rgba(246,196,83,.35), transparent 70%);\n  }\n  .quote-card blockquote { font-size: 1.45rem; line-height: 1.45; font-weight: 600; letter-spacing: -.01em; position: relative; z-index: 1; }\n  .quote-by { margin-top: 1.6rem; display: flex; align-items: center; gap: .8rem; position: relative; z-index: 1; font-size: .95rem; }\n  .quote-by .av { width: 42px; height: 42px; font-size: .9rem; background: var(--sun); color: var(--ink); }\n  .quote-by small { display: block; opacity: .75; }\n  .quote-points h2 { margin-bottom: 1.2rem; }\n  .quote-points ul { list-style: none; display: grid; gap: 1.1rem; margin-top: 1.5rem; }\n  .quote-points li { display: flex; gap: .9rem; }\n  .quote-points li b { display: block; margin-bottom: .15rem; }\n  .quote-points li span { color: var(--ink-soft); font-size: .97rem; }\n  .tick {\n    flex-shrink: 0; width: 28px; height: 28px; border-radius: 9px; background: #e5f4ec; color: var(--kelp);\n    display: grid; place-items: center; margin-top: 2px;\n  }\n\n  /* Pricing */\n  .pricing { background: var(--mist); }\n  .plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; align-items: stretch; }\n  .plan { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 36px 30px; display: flex; flex-direction: column; }\n  .plan.featured { border: 2px solid var(--sea); box-shadow: var(--shadow); position: relative; }\n  .badge {\n    position: absolute; top: -14px; left: 50%; transform: translateX(-50%);\n    background: var(--coral); color: #fff; font-size: .75rem; font-weight: 700; padding: .3rem .8rem; border-radius: 999px; letter-spacing: .04em; white-space: nowrap;\n  }\n  .plan h3 { font-size: 1.15rem; }\n  .plan .desc { color: var(--ink-soft); font-size: .93rem; margin-top: .3rem; min-height: 2.8em; }\n  .price { margin: 1.4rem 0 1.6rem; display: flex; align-items: baseline; gap: .3rem; }\n  .price strong { font-size: 2.8rem; letter-spacing: -.03em; font-weight: 800; }\n  .price span { color: var(--ink-soft); font-size: .95rem; }\n  .plan ul { list-style: none; display: grid; gap: .65rem; margin-bottom: 2rem; flex: 1; }\n  .plan li { font-size: .95rem; display: flex; gap: .6rem; color: var(--ink-soft); }\n  .plan li::before { content: \"\u2713\"; color: var(--kelp); font-weight: 800; }\n  .plan .btn { width: 100%; }\n\n  /* FAQ */\n  .faq-wrap { display: grid; grid-template-columns: .8fr 1.2fr; gap: 60px; }\n  .faq-wrap h2 { margin-bottom: 1rem; }\n  .faq-wrap > div:first-child p { color: var(--ink-soft); }\n  .faq-wrap .mini-cta { margin-top: 1.6rem; font-size: .95rem; color: var(--ink-soft); }\n  .faq-wrap .mini-cta a { color: var(--sea); font-weight: 700; border-bottom: 2px solid var(--foam); }\n  details { border-bottom: 1px solid var(--line); padding: 22px 0; }\n  details:first-child { border-top: 1px solid var(--line); }\n  summary { cursor: pointer; list-style: none; font-weight: 700; font-size: 1.06rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }\n  summary::-webkit-details-marker { display: none; }\n  summary::after { content: \"+\"; font-size: 1.5rem; color: var(--sea); font-weight: 400; transition: transform .2s; }\n  details[open] summary::after { transform: rotate(45deg); }\n  details p { color: var(--ink-soft); margin-top: .8rem; padding-right: 2rem; }\n\n  /* Final CTA */\n  .final {\n    padding: 0 0 100px;\n  }\n  .final-box {\n    border-radius: 30px; padding: 80px 40px; text-align: center; color: #fff; position: relative; overflow: hidden;\n    background:\n      radial-gradient(500px 260px at 15% 0%, rgba(246,196,83,.35), transparent 70%),\n      linear-gradient(135deg, #1d6b74, #134b53);\n  }\n  .final-box h2 { color: #fff; max-width: 17ch; margin-inline: auto; }\n  .final-box p { color: #cfe8e5; margin: 1rem auto 2.2rem; max-width: 36em; font-size: 1.1rem; }\n  .final-box .waves { position: absolute; left: 0; right: 0; bottom: 0; opacity: .18; }\n\n  /* Footer */\n  footer { background: var(--ink); color: #a9c3c0; padding: 64px 0 36px; font-size: .95rem; }\n  .foot-grid { display: grid; grid-template-columns: 1.6fr repeat(3, 1fr); gap: 40px; }\n  footer .logo { color: #fff; }\n  footer .tag { margin-top: 1rem; max-width: 26ch; line-height: 1.5; }\n  footer h5 { color: #fff; font-size: .9rem; margin-bottom: 1rem; letter-spacing: .02em; }\n  footer ul { list-style: none; display: grid; gap: .6rem; }\n  footer ul a:hover { color: #fff; }\n  .foot-bottom { margin-top: 56px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,.1); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; font-size: .85rem; }\n\n  /* ---------- Responsive ---------- */\n  @media (max-width: 960px) {\n    .hero-grid, .quote-wrap, .faq-wrap { grid-template-columns: 1fr; }\n    .hero-visual { margin-top: 24px; }\n    .mock { transform: none; }\n    .chip-1 { left: 8px; } .chip-2 { right: 8px; }\n    .features, .steps, .plans { grid-template-columns: 1fr; }\n    .strip .wrap { grid-template-columns: repeat(2, 1fr); }\n    .foot-grid { grid-template-columns: 1fr 1fr; }\n    .nav-links { display: none; }\n    section { padding: 76px 0; }\n  }\n  @media (max-width: 600px) {\n    .mock-days { grid-template-columns: 1fr; }\n    .mock-day { min-height: auto; }\n    .chip { display: none; }\n    .nav-login { display: none; }\n    .final-box { padding: 56px 24px; }\n    .quote-card { padding: 32px; }\n  }\n</style>\n</head>\n<body>\n\n<!-- NAV -->\n<header class=\"nav\">\n  <div class=\"wrap\">\n    <a href=\"#\" class=\"logo\" aria-label=\"Tidepool home\">\n      <svg width=\"30\" height=\"30\" viewBox=\"0 0 32 32\" aria-hidden=\"true\">\n        <circle cx=\"16\" cy=\"16\" r=\"15\" fill=\"#1d6b74\"/>\n        <path d=\"M5 13c3-3 6-3 9 0s6 3 9 0 4-2.5 4-2.5\" stroke=\"#fff\" stroke-width=\"2.6\" fill=\"none\" stroke-linecap=\"round\"/>\n        <path d=\"M5 20c3-3 6-3 9 0s6 3 9 0 4-2.5 4-2.5\" stroke=\"#f6c453\" stroke-width=\"2.6\" fill=\"none\" stroke-linecap=\"round\"/>\n      </svg>\n      Tidepool\n    </a>\n    <nav class=\"nav-links\" aria-label=\"Primary\">\n      <a href=\"#features\">Features</a>\n      <a href=\"#how\">How it works</a>\n      <a href=\"#pricing\">Pricing</a>\n      <a href=\"#faq\">FAQ</a>\n    </nav>\n    <div class=\"nav-actions\">\n      <a href=\"#\" class=\"nav-login\">Log in</a>\n      <a href=\"#start\" class=\"btn btn-primary btn-sm\">Start free</a>\n    </div>\n  </div>\n</header>\n\n<main>\n\n<!-- HERO -->\n<section class=\"hero\" style=\"padding-top:88px;padding-bottom:96px;\">\n  <div class=\"wrap hero-grid\">\n    <div>\n      <span class=\"eyebrow\"><span class=\"dot\"></span> Now with Friday reviews</span>\n      <h1>Plan your week <em>together</em>, not in ten different tabs.</h1>\n      <p class=\"lead\">Tidepool gives small teams one shared view of the week: what matters most, who owns what, and what's still in the water. Set it up in five minutes and spend Monday doing the work, not chasing status.</p>\n      <div class=\"hero-ctas\">\n        <a href=\"#start\" class=\"btn btn-primary\">Start planning free</a>\n        <a href=\"#how\" class=\"btn btn-ghost\">See how it works</a>\n      </div>\n      <p class=\"hero-note\"><span class=\"check\">\u2713</span> Free for teams of up to 5 &nbsp;\u00b7&nbsp; <span class=\"check\">\u2713</span> No credit card</p>\n    </div>\n\n    <div class=\"hero-visual\">\n      <div class=\"mock\" role=\"img\" aria-label=\"Preview of a Tidepool weekly board with five day columns and shared tasks\">\n        <div class=\"mock-bar\">\n          <div class=\"mock-dots\"><span></span><span></span><span></span></div>\n          <div class=\"mock-title\">Team Lumen \u00b7 Week 24</div>\n          <div class=\"mock-week\">Jun 10 \u2013 14</div>\n        </div>\n        <div class=\"mock-tide\">\n          <div class=\"mock-tide-icon\">\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2.2\" stroke-linecap=\"round\"><path d=\"M2 9c2.5-2.5 5-2.5 7.5 0S14.5 11.5 17 9s3.5-2 5-.5\"/><path d=\"M2 16c2.5-2.5 5-2.5 7.5 0S14.5 18.5 17 16s3.5-2 5-.5\"/></svg>\n          </div>\n          <p><strong>This week's tide</strong>Ship onboarding v2 to 10 beta teams before Thursday</p>\n        </div>\n        <div class=\"mock-days\">\n          <div class=\"mock-day\">\n            <h4>Mon <span>10</span></h4>\n            <div class=\"task focus\"><p>Kickoff and scope check</p><div class=\"who\"><span class=\"av a\">M</span> Maya</div></div>\n            <div class=\"task\"><p>Draft migration plan</p><div class=\"who\"><span class=\"av b\">J</span> Jon</div></div>\n          </div>\n          <div class=\"mock-day\">\n            <h4>Tue <span>11</span></h4>\n            <div class=\"task\"><p>Copy review for emails</p><div class=\"who\"><span class=\"av c\">R</span> Rae</div></div>\n            <div class=\"task done\"><p>Set up staging env</p><div class=\"who\"><span class=\"av b\">J</span> Jon</div></div>\n          </div>\n          <div class=\"mock-day today\">\n            <h4>Wed <span>12 \u00b7 today</span></h4>\n            <div class=\"task focus\"><p>Beta invites out</p><div class=\"who\"><span class=\"av a\">M</span> Maya</div></div>\n            <div class=\"task\"><p>Bug triage, 30 min</p><div class=\"who\"><span class=\"av d\">S</span> Sam</div></div>\n          </div>\n          <div class=\"mock-day\">\n            <h4>Thu <span>13</span></h4>\n            <div class=\"task\"><p>Ship v2 to beta cohort</p><div class=\"who\"><span class=\"av b\">J</span> Jon</div></div>\n          </div>\n          <div class=\"mock-day\">\n            <h4>Fri <span>14</span></h4>\n            <div class=\"task\"><p>Friday review, 15 min</p><div class=\"who\"><span class=\"av a\">M</span> Maya</div></div>\n          </div>\n        </div>\n        <div class=\"mock-foot\">\n          <span>Tasks done</span>\n          <div class=\"progress\"><i></i></div>\n          <strong>64%</strong>\n        </div>\n      </div>\n\n      <div class=\"chip chip-1\">\n        <span class=\"av c\" style=\"width:30px;height:30px;font-size:.8rem;\">R</span>\n        <div>Rae checked in<small>\"Copy is blocked on pricing\"</small></div>\n      </div>\n      <div class=\"chip chip-2\">\n        <span style=\"font-size:1.3rem;\">\ud83c\udf0a</span>\n        <div>Weekly tide set<small>Shared with 4 teammates</small></div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- STATS -->\n<div class=\"strip\">\n  <div class=\"wrap\">\n    <div><strong>5 min</strong><span>to plan the week</span></div>\n    <div><strong>2\u201312</strong><span>people per team</span></div>\n    <div><strong>1</strong><span>shared view, no tab-switching</span></div>\n    <div><strong>15 min</strong><span>Friday review ritual</span></div>\n  </div>\n</div>\n\n<!-- FEATURES -->\n<section id=\"features\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <div class=\"kicker\">Features</div>\n      <h2>Everything a small team needs to start the week right.</h2>\n      <p>Tidepool deliberately leaves out the things a big team needs and keeps the things a small team uses every day.</p>\n    </div>\n\n    <div class=\"features\">\n      <article class=\"card\">\n        <div class=\"icon sea\">\n          <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><circle cx=\"12\" cy=\"12\" r=\"4.5\"/><circle cx=\"12\" cy=\"12\" r=\"1\"/></svg>\n        </div>\n        <h3>One weekly tide</h3>\n        <p>Name the one or two outcomes that define the week. They sit pinned at the top of every board, so priorities stay visible even when the calendar gets chaotic.</p>\n      </article>\n\n      <article class=\"card\">\n        <div class=\"icon coral\">\n          <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"3\"/><path d=\"M3 10h18M8 3v4M16 3v4\"/></svg>\n        </div>\n        <h3>Drag, drop, and own</h3>\n        <p>Plan tasks onto days and assign an owner in one motion. Everyone sees who's carrying what, so nothing lives in someone's head or a forgotten thread.</p>\n      </article>\n\n      <article class=\"card\">\n        <div class=\"icon kelp\">\n          <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 5h16v11H9l-5 4z\"/><path d=\"M8 10h8\"/></svg>\n        </div>\n        <h3>Async check-ins</h3>\n        <p>Each person posts a two-line update in the morning. Blockers surface automatically, and nobody has to sit through a status meeting to find out what's stuck.</p>\n      </article>\n\n      <article class=\"card\">\n        <div class=\"icon sea\">\n          <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3v4M12 17v4M3 12h4M17 12h4\"/><circle cx=\"12\" cy=\"12\" r=\"4\"/></svg>\n        </div>\n        <h3>Focus blocks</h3>\n        <p>Protect deep-work time on the shared calendar. Teammates can see when you're heads-down, which means fewer interruptions and fewer \"got a sec?\" messages.</p>\n      </article>\n\n      <article class=\"card\">\n        <div class=\"icon coral\">\n          <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 12l5 5L20 6\"/></svg>\n        </div>\n        <h3>Friday review</h3>\n        <p>A guided 15-minute retro asks three questions: what shipped, what slipped, and what moves next week. Unfinished work carries over with a note on why.</p>\n      </article>\n\n      <article class=\"card\">\n        <div class=\"icon kelp\">\n          <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M16 11a4 4 0 1 0-8 0\"/><path d=\"M3 21a9 9 0 0 1 18 0\"/></svg>\n        </div>\n        <h3>Built for small crews</h3>\n        <p>No admin console, no permission matrix, no seat-counting headaches. Invite your team with a link, and you're planning together before the coffee cools.</p>\n      </article>\n    </div>\n  </div>\n</section>\n\n<!-- HOW IT WORKS -->\n<section id=\"how\" class=\"how\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <div class=\"kicker\">How it works</div>\n      <h2>A simple weekly rhythm, in three moves.</h2>\n      <p>Tidepool follows the natural tide of a week: plan the swell on Monday, ride it through the middle, and pull back to reflect on Friday.</p>\n    </div>\n\n    <div class=\"steps\">\n      <div class=\"step\">\n        <div class=\"step-num\">1</div>\n        <h3>Set the tide</h3>\n        <p>On Monday morning, the team agrees on the one or two outcomes that matter most this week.</p>\n        <ul>\n          <li>Write it once, in plain language</li>\n          <li>Pin it to the top of the board</li>\n          <li>Takes about five minutes</li>\n        </ul>\n      </div>\n      <div class=\"step\">\n        <div class=\"step-num\">2</div>\n        <h3>Map the week</h3>\n        <p>Drop tasks onto days, assign owners, and flag the few items that need focus time.</p>\n        <ul>\n          <li>Pull from last week's carryover</li>\n          <li>Block time on everyone's calendar</li>\n          <li>See load at a glance</li>\n        </ul>\n      </div>\n      <div class=\"step\">\n        <div class=\"step-num\">3</div>\n        <h3>Check the shore</h3>\n        <p>On Friday, review what landed, what didn't, and what the next tide should carry forward.</p>\n        <ul>\n          <li>Guided 15-minute review</li>\n          <li>Slipped tasks get a reason</li>\n          <li>Next week starts from a clean slate</li>\n        </ul>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- QUOTE + POINTS -->\n<section>\n  <div class=\"wrap quote-wrap\">\n    <figure class=\"quote-card\">\n      <blockquote>\"We used to lose Monday to figuring out what we were doing. Now we open Tidepool, see the tide, and get to work. Our Friday reviews are the first meetings nobody complains about.\"</blockquote>\n      <figcaption class=\"quote-by\">\n        <span class=\"av\">PL</span>\n        <div>Priya Lin<small>Founder, four-person design studio</small></div>\n      </figcaption>\n    </figure>\n\n    <div class=\"quote-points\">\n      <div class=\"kicker\">Why small teams switch</div>\n      <h2>Less coordination overhead. More actual work.</h2>\n      <ul>\n        <li>\n          <span class=\"tick\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 12l5 5L20 6\"/></svg></span>\n          <div><b>Replace the status meeting</b><span>Async check-ins and a shared board answer \"where are we?\" before anyone asks.</span></div>\n        </li>\n        <li>\n          <span class=\"tick\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 12l5 5L20 6\"/></svg></span>\n          <div><b>Catch slipping work early</b><span>Overloaded days and unowned tasks are flagged before they become Thursday emergencies.</span></div>\n        </li>\n        <li>\n          <span class=\"tick\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 12l5 5L20 6\"/></svg></span>\n          <div><b>Keep a record without the homework</b><span>Friday reviews build a readable history of what your team shipped and why.</span></div>\n        </li>\n      </ul>\n    </div>\n  </div>\n</section>\n\n<!-- PRICING -->\n<section id=\"pricing\" class=\"pricing\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <div class=\"kicker\">Pricing</div>\n      <h2>Start free. Pay only when your crew grows.</h2>\n      <p>Every plan includes the weekly tide, the shared board, and the Friday review. No feature gates on the basics.</p>\n    </div>\n\n    <div class=\"plans\">\n      <div class=\"plan\">\n        <h3>Starter</h3>\n        <p class=\"desc\">For a small crew finding its rhythm.</p>\n        <div class=\"price\"><strong>$0</strong><span>forever</span></div>\n        <ul>\n          <li>Up to 5 teammates</li>\n          <li>Unlimited weekly tides</li>\n          <li>Async check-ins</li>\n          <li>Friday review templates</li>\n        </ul>\n        <a href=\"#start\" class=\"btn btn-ghost\">Start free</a>\n      </div>\n\n      <div class=\"plan featured\">\n        <span class=\"badge\">Most popular</span>\n        <h3>Team</h3>\n        <p class=\"desc\">For teams that plan together every week.</p>\n        <div class=\"price\"><strong>$6</strong><span>per person / month</span></div>\n        <ul>\n          <li>Up to 15 teammates</li>\n          <li>Everything in Starter</li>\n          <li>Calendar focus blocks</li>\n          <li>Carryover history and insights</li>\n          <li>Email and chat support</li>\n        </ul>\n        <a href=\"#start\" class=\"btn btn-primary\">Start 30-day trial</a>\n      </div>\n\n      <div class=\"plan\">\n        <h3>Studio</h3>\n        <p class=\"desc\">For organizations running several small teams.</p>\n        <div class=\"price\"><strong>$12</strong><span>per person / month</span></div>\n        <ul>\n          <li>Unlimited teammates and teams</li>\n          <li>Everything in Team</li>\n          <li>Shared templates across teams</li>\n          <li>Single sign-on</li>\n          <li>Priority onboarding call</li>\n        </ul>\n        <a href=\"#start\" class=\"btn btn-ghost\">Talk to us</a>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- FAQ -->\n<section id=\"faq\">\n  <div class=\"wrap faq-wrap\">\n    <div>\n      <div class=\"kicker\">FAQ</div>\n      <h2>Questions, answered.</h2>\n      <p>Still curious? Here are the things teams ask us most before they start.</p>\n      <p class=\"mini-cta\">Something else on your mind? <a href=\"#\">Email our team</a>.</p>\n    </div>\n\n    <div>\n      <details open>\n        <summary>How long does setup take?</summary>\n        <p>Most teams are planning their first week within ten minutes. Invite your people with a link, write the first weekly tide, and drop in the tasks you already have.</p>\n      </details>\n      <details>\n        <summary>Does Tidepool replace Slack, Notion, or our calendar?</summary>\n        <p>No. Tidepool sits next to the tools you already use. It keeps the weekly plan in one place and links out to the docs, threads, and events it relates to.</p>\n      </details>\n      <details>\n        <summary>What happens to tasks that don't get finished?</summary>\n        <p>On the Friday review, unfinished tasks are shown with a single prompt: carry over, drop, or reschedule. Carried tasks keep their history, so you can see what keeps slipping.</p>\n      </details>\n      <details>\n        <summary>Can we work across time zones?</summary>\n        <p>Yes. Check-ins are asynchronous by default, and the board shows each teammate's local time so people know when their updates will be read.</p>\n      </details>\n      <details>\n        <summary>Is our data private?</summary>\n        <p>Your plans are visible only to the team you invite. We don't sell data or use it to train models, and you can export or delete everything at any time.</p>\n      </details>\n    </div>\n  </div>\n</section>\n\n<!-- FINAL CTA -->\n<section id=\"start\" class=\"final\">\n  <div class=\"wrap\">\n    <div class=\"final-box\">\n      <h2>Find your tide for next week.</h2>\n      <p>Bring your team into one shared week. It's free to start, and your first Friday review takes fifteen minutes.</p>\n      <div class=\"hero-ctas\" style=\"justify-content:center;\">\n        <a href=\"#\" class=\"btn btn-light\">Start planning free</a>\n        <a href=\"#how\" class=\"btn btn-ghost\" style=\"color:#fff;border-color:rgba(255,255,255,.35);\">Watch a 2-minute tour</a>\n      </div>\n      <svg class=\"waves\" viewBox=\"0 0 1440 120\" preserveAspectRatio=\"none\" aria-hidden=\"true\">\n        <path d=\"M0 60c120-40 240-40 360 0s240 40 360 0 240-40 360 0 240 40 360 0V120H0z\" fill=\"#fff\"/>\n      </svg>\n    </div>\n  </div>\n</section>\n\n</main>\n\n<!-- FOOTER -->\n<footer>\n  <div class=\"wrap\">\n    <div class=\"foot-grid\">\n      <div>\n        <a href=\"#\" class=\"logo\">\n          <svg width=\"30\" height=\"30\" viewBox=\"0 0 32 32\" aria-hidden=\"true\">\n            <circle cx=\"16\" cy=\"16\" r=\"15\" fill=\"#1d6b74\"/>\n            <path d=\"M5 13c3-3 6-3 9 0s6 3 9 0 4-2.5 4-2.5\" stroke=\"#fff\" stroke-width=\"2.6\" fill=\"none\" stroke-linecap=\"round\"/>\n            <path d=\"M5 20c3-3 6-3 9 0s6 3 9 0 4-2.5 4-2.5\" stroke=\"#f6c453\" stroke-width=\"2.6\" fill=\"none\" stroke-linecap=\"round\"/>\n          </svg>\n          Tidepool\n        </a>\n        <p class=\"tag\">A weekly planning tool for small teams who would rather build than coordinate.</p>\n      </div>\n      <div>\n        <h5>Product</h5>\n        <ul>\n          <li><a href=\"#features\">Features</a></li>\n          <li><a href=\"#pricing\">Pricing</a></li>\n          <li><a href=\"#how\">How it works</a></li>\n          <li><a href=\"#\">Changelog</a></li>\n        </ul>\n      </div>\n      <div>\n        <h5>Company</h5>\n        <ul>\n          <li><a href=\"#\">About</a></li>\n          <li><a href=\"#\">Careers</a></li>\n          <li><a href=\"#\">Contact</a></li>\n        </ul>\n      </div>\n      <div>\n        <h5>Resources</h5>\n        <ul>\n          <li><a href=\"#faq\">FAQ</a></li>\n          <li><a href=\"#\">Friday review guide</a></li>\n          <li><a href=\"#\">Privacy</a></li>\n          <li><a href=\"#\">Terms</a></li>\n        </ul>\n      </div>\n    </div>\n    <div class=\"foot-bottom\">\n      <span>\u00a9 2025 Tidepool. All rights reserved.</span>\n      <span>Made for small teams, slowly.</span>\n    </div>\n  </div>\n</footer>\n\n</body>\n</html>\n"}