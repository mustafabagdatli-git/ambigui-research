{"arm": "vs", "model": "openai/gpt-6-luna", "i": 5, "finish": "stop", "dirs": [{"direction": "Calm editorial \u2014 generous whitespace, deep navy typography, and soft sea-glass accents; frames weekly planning as a thoughtful team ritual.", "probability": 0.28}, {"direction": "Playful tide chart \u2014 bold curves, layered blues, and buoy-like task markers; makes the team\u2019s week feel fluid and easy to navigate.", "probability": 0.22}, {"direction": "Crisp productivity dashboard \u2014 structured grids, compact UI previews, and bright action accents; leads with clarity and practical utility.", "probability": 0.2}, {"direction": "Warm collaborative studio \u2014 cream backgrounds, hand-drawn details, and friendly illustrations; emphasizes the human side of planning together.", "probability": 0.17}, {"direction": "Bold typographic launch page \u2014 oversized headlines, high-contrast color blocking, and minimal interface elements; presents Tidepool as a confident new way to work.", "probability": 0.13}], "pick": {"direction": "Calm editorial \u2014 generous whitespace, deep navy typography, and soft sea-glass accents; frames weekly planning as a thoughtful team ritual.", "probability": 0.28}, "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <meta name=\"description\" content=\"Tidepool helps small teams plan their week together, with more clarity and a little more breathing room.\" />\n  <title>Tidepool \u2014 Make room for a better week</title>\n  <style>\n    :root {\n      --ink: #172c3a;\n      --muted: #657782;\n      --paper: #fbfaf7;\n      --white: #ffffff;\n      --sea: #dceee8;\n      --sea-dark: #8bbdaf;\n      --mint: #edf5ef;\n      --line: #e5e9e4;\n      --coral: #e5a18a;\n      --blue: #dce9f0;\n      --serif: Georgia, \"Times New Roman\", serif;\n      --sans: -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n    }\n\n    * { box-sizing: border-box; }\n\n    html { scroll-behavior: smooth; }\n\n    body {\n      margin: 0;\n      background: var(--paper);\n      color: var(--ink);\n      font-family: var(--sans);\n      -webkit-font-smoothing: antialiased;\n    }\n\n    a { color: inherit; text-decoration: none; }\n\n    .wrap {\n      width: min(1160px, calc(100% - 48px));\n      margin: 0 auto;\n    }\n\n    .topbar {\n      height: 82px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      border-bottom: 1px solid rgba(23, 44, 58, 0.08);\n    }\n\n    .brand {\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      font-size: 21px;\n      font-weight: 650;\n      letter-spacing: -0.7px;\n    }\n\n    .brand-mark {\n      position: relative;\n      width: 27px;\n      height: 27px;\n      border: 1.5px solid #88b8a9;\n      border-radius: 50%;\n      display: inline-block;\n    }\n\n    .brand-mark::before,\n    .brand-mark::after {\n      content: \"\";\n      position: absolute;\n      border: 1.5px solid #88b8a9;\n      border-radius: 50%;\n    }\n\n    .brand-mark::before {\n      width: 15px;\n      height: 15px;\n      top: 4.5px;\n      left: 4.5px;\n    }\n\n    .brand-mark::after {\n      width: 5px;\n      height: 5px;\n      top: 9.5px;\n      left: 9.5px;\n      background: #88b8a9;\n    }\n\n    .nav-links {\n      display: flex;\n      align-items: center;\n      gap: 34px;\n      color: #536671;\n      font-size: 13px;\n    }\n\n    .nav-links a:hover { color: var(--ink); }\n\n    .nav-actions {\n      display: flex;\n      align-items: center;\n      gap: 23px;\n      font-size: 13px;\n    }\n\n    .login { color: #536671; }\n\n    .button {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: 9px;\n      border-radius: 999px;\n      padding: 13px 20px;\n      background: var(--ink);\n      color: white;\n      font-size: 13px;\n      font-weight: 600;\n      transition: transform .2s ease, background .2s ease;\n    }\n\n    .button:hover {\n      background: #284757;\n      transform: translateY(-2px);\n    }\n\n    .button .arrow { font-size: 17px; line-height: 10px; }\n\n    .hero {\n      min-height: 665px;\n      padding: 82px 0 74px;\n      display: grid;\n      grid-template-columns: .88fr 1.12fr;\n      align-items: center;\n      gap: 56px;\n    }\n\n    .eyebrow {\n      display: inline-flex;\n      align-items: center;\n      gap: 9px;\n      color: #55766d;\n      text-transform: uppercase;\n      letter-spacing: 1.45px;\n      font-size: 10px;\n      font-weight: 700;\n    }\n\n    .eyebrow::before {\n      content: \"\";\n      width: 23px;\n      height: 1px;\n      background: #8bbdaf;\n    }\n\n    h1 {\n      max-width: 530px;\n      margin: 23px 0 22px;\n      font-family: var(--serif);\n      font-weight: 400;\n      font-size: clamp(52px, 5.6vw, 76px);\n      line-height: .99;\n      letter-spacing: -3.5px;\n    }\n\n    h1 em {\n      color: #619787;\n      font-weight: 400;\n    }\n\n    .hero-copy > p {\n      max-width: 430px;\n      margin: 0;\n      color: var(--muted);\n      font-size: 16px;\n      line-height: 1.75;\n    }\n\n    .hero-actions {\n      display: flex;\n      align-items: center;\n      gap: 18px;\n      margin-top: 31px;\n    }\n\n    .text-link {\n      color: #536671;\n      font-size: 13px;\n      font-weight: 600;\n    }\n\n    .text-link span { margin-left: 5px; color: #679989; }\n\n    .fine-print {\n      margin-top: 15px;\n      color: #8a979b;\n      font-size: 11px;\n    }\n\n    .planner-wrap {\n      position: relative;\n      padding: 35px 0 28px 20px;\n    }\n\n    .planner-glow {\n      position: absolute;\n      inset: 0 -15px 0 0;\n      border-radius: 48% 52% 43% 57% / 44% 42% 58% 56%;\n      background: #e7f1e9;\n      transform: rotate(-3deg);\n    }\n\n    .planner {\n      position: relative;\n      z-index: 1;\n      padding: 25px 24px 22px;\n      background: rgba(255, 255, 255, .95);\n      border: 1px solid rgba(23, 44, 58, .08);\n      border-radius: 15px;\n      box-shadow: 0 24px 65px rgba(43, 69, 68, .12);\n      transform: rotate(1deg);\n    }\n\n    .planner-head {\n      display: flex;\n      justify-content: space-between;\n      align-items: flex-start;\n      padding-bottom: 19px;\n      border-bottom: 1px solid #edf0ed;\n    }\n\n    .week-label {\n      color: #8a999e;\n      font-size: 9px;\n      text-transform: uppercase;\n      letter-spacing: 1.2px;\n      font-weight: 700;\n    }\n\n    .planner-title {\n      margin-top: 5px;\n      font-family: var(--serif);\n      font-size: 22px;\n      letter-spacing: -.5px;\n    }\n\n    .team-avatars {\n      display: flex;\n      padding-top: 3px;\n    }\n\n    .avatar {\n      width: 28px;\n      height: 28px;\n      display: grid;\n      place-items: center;\n      margin-left: -6px;\n      border: 2px solid white;\n      border-radius: 50%;\n      color: #38584f;\n      background: #cfe4d9;\n      font-size: 9px;\n      font-weight: 700;\n    }\n\n    .avatar:nth-child(2) { background: #f1d9ce; color: #805c4b; }\n    .avatar:nth-child(3) { background: #d8e5ef; color: #4b6273; }\n    .avatar:nth-child(4) { background: #e9e1c9; color: #746d4b; }\n\n    .week-grid {\n      display: grid;\n      grid-template-columns: 54px repeat(5, 1fr);\n      padding-top: 17px;\n    }\n\n    .day {\n      color: #829096;\n      text-align: center;\n      font-size: 9px;\n      font-weight: 700;\n      letter-spacing: .65px;\n      padding-bottom: 14px;\n    }\n\n    .day.today { color: #477a6b; }\n\n    .day.today span {\n      display: block;\n      width: 21px;\n      height: 21px;\n      margin: 5px auto 0;\n      padding-top: 5px;\n      border-radius: 50%;\n      background: #dceee8;\n      color: #477a6b;\n      letter-spacing: 0;\n    }\n\n    .time {\n      height: 61px;\n      padding-top: 2px;\n      color: #a1aaad;\n      font-size: 8px;\n    }\n\n    .slot {\n      min-width: 0;\n      height: 61px;\n      border-left: 1px solid #f0f2ef;\n      border-top: 1px solid #f0f2ef;\n      padding: 5px 3px 3px;\n    }\n\n    .event {\n      height: 100%;\n      overflow: hidden;\n      border-radius: 5px;\n      padding: 6px 5px;\n      color: #416658;\n      background: #e5f1e9;\n      font-size: 8px;\n      line-height: 1.3;\n    }\n\n    .event strong {\n      display: block;\n      margin-bottom: 3px;\n      font-size: 8px;\n      font-weight: 650;\n    }\n\n    .event.blue { color: #4e6c7d; background: #e7eff4; }\n    .event.peach { color: #8d6655; background: #f8ece5; }\n    .event.yellow { color: #7d7046; background: #f5f0dc; }\n    .event.soft { background: #f0f5ef; }\n\n    .planner-foot {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      padding-top: 15px;\n      color: #879397;\n      font-size: 9px;\n    }\n\n    .week-status {\n      display: inline-flex;\n      align-items: center;\n      gap: 6px;\n      color: #648577;\n    }\n\n    .week-status::before {\n      content: \"\";\n      width: 6px;\n      height: 6px;\n      border-radius: 50%;\n      background: #85b59f;\n    }\n\n    .floating-note {\n      position: absolute;\n      z-index: 2;\n      right: -23px;\n      bottom: 4px;\n      width: 190px;\n      padding: 15px 17px;\n      border: 1px solid rgba(23, 44, 58, .07);\n      border-radius: 10px;\n      background: #fffefa;\n      box-shadow: 0 12px 30px rgba(43, 69, 68, .1);\n      transform: rotate(-3deg);\n    }\n\n    .note-top {\n      display: flex;\n      align-items: center;\n      gap: 7px;\n      color: #81908d;\n      font-size: 9px;\n      font-weight: 650;\n      text-transform: uppercase;\n      letter-spacing: .8px;\n    }\n\n    .note-spark { color: #d39c73; font-size: 13px; }\n    .floating-note p {\n      margin: 8px 0 0;\n      color: #42575b;\n      font-family: var(--serif);\n      font-size: 14px;\n      line-height: 1.35;\n    }\n\n    .proof {\n      padding: 26px 0 33px;\n      border-top: 1px solid var(--line);\n      border-bottom: 1px solid var(--line);\n      text-align: center;\n    }\n\n    .proof-label {\n      margin-bottom: 19px;\n      color: #8b9798;\n      text-transform: uppercase;\n      letter-spacing: 1.25px;\n      font-size: 9px;\n      font-weight: 700;\n    }\n\n    .proof-list {\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      flex-wrap: wrap;\n      gap: 48px;\n      color: #748184;\n      font-family: var(--serif);\n      font-size: 17px;\n    }\n\n    .proof-list span:nth-child(2) { font-style: italic; }\n    .proof-list span:nth-child(3) { font-family: var(--sans); font-size: 14px; font-weight: 650; letter-spacing: -.5px; }\n    .proof-list span:nth-child(4) { font-size: 15px; letter-spacing: 1px; }\n    .proof-list span:nth-child(5) { font-style: italic; }\n\n    .section {\n      padding: 112px 0;\n    }\n\n    .section-intro {\n      max-width: 590px;\n      margin: 0 auto 53px;\n      text-align: center;\n    }\n\n    .section-intro .eyebrow { justify-content: center; }\n\n    h2 {\n      margin: 17px 0 14px;\n      font-family: var(--serif);\n      font-size: clamp(37px, 4vw, 51px);\n      font-weight: 400;\n      line-height: 1.08;\n      letter-spacing: -1.7px;\n    }\n\n    .section-intro p {\n      max-width: 465px;\n      margin: 0 auto;\n      color: var(--muted);\n      font-size: 14px;\n      line-height: 1.75;\n    }\n\n    .feature-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 17px;\n    }\n\n    .feature {\n      min-height: 228px;\n      padding: 26px 25px;\n      border: 1px solid #e7ebe5;\n      border-radius: 10px;\n      background: #fffefa;\n    }\n\n    .feature-icon {\n      width: 37px;\n      height: 37px;\n      display: grid;\n      place-items: center;\n      margin-bottom: 24px;\n      border-radius: 50%;\n      background: #e5f0e9;\n      color: #5e897b;\n      font-size: 17px;\n    }\n\n    .feature:nth-child(2) .feature-icon { background: #f5e9df; color: #a5745c; }\n    .feature:nth-child(3) .feature-icon { background: #e7eef2; color: #648093; }\n\n    .feature h3 {\n      margin: 0 0 9px;\n      font-family: var(--serif);\n      font-size: 21px;\n      font-weight: 400;\n      letter-spacing: -.3px;\n    }\n\n    .feature p {\n      max-width: 285px;\n      margin: 0;\n      color: var(--muted);\n      font-size: 12px;\n      line-height: 1.7;\n    }\n\n    .ritual {\n      position: relative;\n      overflow: hidden;\n      padding: 91px 0 95px;\n      background: #193442;\n      color: #f8f7f1;\n    }\n\n    .ritual::after {\n      content: \"\";\n      position: absolute;\n      width: 510px;\n      height: 510px;\n      right: -120px;\n      top: -230px;\n      border: 1px solid rgba(180, 218, 201, .14);\n      border-radius: 50%;\n      box-shadow: 0 0 0 45px rgba(180, 218, 201, .025), 0 0 0 95px rgba(180, 218, 201, .02);\n    }\n\n    .ritual-inner {\n      position: relative;\n      z-index: 1;\n      display: grid;\n      grid-template-columns: .85fr 1.15fr;\n      gap: 100px;\n      align-items: center;\n    }\n\n    .ritual .eyebrow { color: #a7c8bb; }\n    .ritual h2 { max-width: 390px; margin-top: 19px; }\n    .ritual-copy p {\n      max-width: 390px;\n      color: #c2d0d1;\n      font-size: 13px;\n      line-height: 1.8;\n    }\n\n    .ritual .button {\n      margin-top: 15px;\n      background: #dceee8;\n      color: #1b3945;\n    }\n\n    .ritual .button:hover { background: #fff; }\n\n    .steps {\n      display: grid;\n      gap: 0;\n    }\n\n    .step {\n      display: grid;\n      grid-template-columns: 44px 1fr;\n      gap: 17px;\n      padding: 20px 0;\n      border-bottom: 1px solid rgba(229, 239, 233, .15);\n    }\n\n    .step:last-child { border-bottom: 0; }\n\n    .step-number {\n      width: 34px;\n      height: 34px;\n      display: grid;\n      place-items: center;\n      border: 1px solid rgba(184, 218, 202, .42);\n      border-radius: 50%;\n      color: #b6d8c9;\n      font-family: var(--serif);\n      font-size: 15px;\n    }\n\n    .step h3 {\n      margin: 1px 0 6px;\n      font-family: var(--serif);\n      font-size: 19px;\n      font-weight: 400;\n    }\n\n    .step p {\n      max-width: 390px;\n      margin: 0;\n      color: #b2c2c3;\n      font-size: 11px;\n      line-height: 1.65;\n    }\n\n    .quote-section {\n      padding: 93px 0;\n      text-align: center;\n    }\n\n    .quote-mark {\n      color: #8bbdaf;\n      font-family: var(--serif);\n      font-size: 51px;\n      line-height: .6;\n    }\n\n    blockquote {\n      max-width: 730px;\n      margin: 25px auto 22px;\n      font-family: var(--serif);\n      font-size: clamp(25px, 3.1vw, 37px);\n      line-height: 1.3;\n      letter-spacing: -.7px;\n    }\n\n    .quote-credit {\n      color: #829093;\n      font-size: 11px;\n    }\n\n    .quote-credit strong { color: #4c6268; font-weight: 650; }\n\n    .cta {\n      padding: 74px 30px;\n      border-radius: 13px;\n      background: #e5f0e9;\n      text-align: center;\n      margin-bottom: 72px;\n    }\n\n    .cta h2 {\n      max-width: 530px;\n      margin: 0 auto 14px;\n    }\n\n    .cta p {\n      margin: 0 auto 24px;\n      color: #657782;\n      font-size: 13px;\n      line-height: 1.7;\n    }\n\n    footer {\n      padding: 26px 0 34px;\n      border-top: 1px solid var(--line);\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      color: #879397;\n      font-size: 10px;\n    }\n\n    .footer-brand { color: var(--ink); font-size: 16px; }\n    .footer-links { display: flex; gap: 24px; }\n    .footer-links a:hover { color: var(--ink); }\n\n    @media (max-width: 900px) {\n      .hero { gap: 25px; grid-template-columns: .9fr 1.1fr; }\n      .planner-wrap { padding-left: 0; }\n      .planner { padding: 20px 16px; }\n      .floating-note { right: -7px; }\n      .ritual-inner { gap: 55px; }\n      .nav-links { gap: 19px; }\n    }\n\n    @media (max-width: 700px) {\n      .wrap { width: min(100% - 36px, 520px); }\n      .topbar { height: 70px; }\n      .nav-links, .login { display: none; }\n      .nav-actions { gap: 0; }\n      .nav-actions .button { padding: 11px 15px; font-size: 12px; }\n      .hero {\n        display: flex;\n        flex-direction: column;\n        align-items: stretch;\n        gap: 31px;\n        padding: 65px 0 54px;\n      }\n      h1 { font-size: clamp(52px, 14vw, 69px); letter-spacing: -2.7px; }\n      .hero-copy > p { font-size: 14px; }\n      .planner-wrap { margin: 0 2px; padding: 16px 0 30px; }\n      .planner { transform: none; padding: 19px 13px 16px; }\n      .planner-glow { inset: 0; }\n      .floating-note { right: 0; bottom: -4px; width: 168px; padding: 12px 14px; }\n      .floating-note p { font-size: 12px; }\n      .week-grid { grid-template-columns: 37px repeat(5, 1fr); }\n      .event { font-size: 7px; padding: 5px 3px; }\n      .event strong { font-size: 7px; }\n      .time { font-size: 7px; }\n      .proof-list { gap: 18px 28px; font-size: 15px; }\n      .section { padding: 76px 0; }\n      .section-intro { margin-bottom: 34px; }\n      .feature-grid { grid-template-columns: 1fr; gap: 11px; }\n      .feature { min-height: auto; padding: 22px; }\n      .feature-icon { margin-bottom: 16px; }\n      .feature p { max-width: 100%; }\n      .ritual { padding: 72px 0; }\n      .ritual-inner { grid-template-columns: 1fr; gap: 34px; }\n      .ritual-copy p { max-width: 100%; }\n      .quote-section { padding: 72px 0; }\n      .cta { padding: 56px 20px; margin-bottom: 48px; }\n      footer { align-items: flex-start; flex-wrap: wrap; gap: 18px; }\n      .footer-links { width: 100%; order: 2; gap: 19px; flex-wrap: wrap; }\n    }\n\n    @media (max-width: 380px) {\n      .hero-actions { align-items: flex-start; flex-direction: column; }\n      .proof-list { gap: 16px 20px; }\n      .planner-title { font-size: 19px; }\n      .week-grid { grid-template-columns: 32px repeat(5, 1fr); }\n    }\n  </style>\n</head>\n<body>\n  <header class=\"wrap topbar\">\n    <a class=\"brand\" href=\"#\" aria-label=\"Tidepool home\">\n      <span class=\"brand-mark\" aria-hidden=\"true\"></span>\n      tidepool\n    </a>\n\n    <nav class=\"nav-links\" aria-label=\"Main navigation\">\n      <a href=\"#how-it-works\">How it works</a>\n      <a href=\"#why-tidepool\">Why Tidepool</a>\n      <a href=\"#stories\">Stories</a>\n    </nav>\n\n    <div class=\"nav-actions\">\n      <a class=\"login\" href=\"#\">Log in</a>\n      <a class=\"button\" href=\"#get-started\">Try it free <span class=\"arrow\">\u2197</span></a>\n    </div>\n  </header>\n\n  <main>\n    <section class=\"wrap hero\">\n      <div class=\"hero-copy\">\n        <div class=\"eyebrow\">A calmer way to work together</div>\n        <h1>Make room for a <em>better week.</em></h1>\n        <p>\n          A little time to get on the same page changes everything.\n          Tidepool helps your team make a thoughtful plan\u2014and feel good about it.\n        </p>\n        <div class=\"hero-actions\">\n          <a class=\"button\" href=\"#get-started\">Plan your first week <span class=\"arrow\">\u2197</span></a>\n          <a class=\"text-link\" href=\"#how-it-works\">See how it works <span>\u2192</span></a>\n        </div>\n        <div class=\"fine-print\">Free for small teams. No card, no fuss.</div>\n      </div>\n\n      <div class=\"planner-wrap\" aria-label=\"Preview of a shared team weekly planner\">\n        <div class=\"planner-glow\"></div>\n        <div class=\"planner\">\n          <div class=\"planner-head\">\n            <div>\n              <div class=\"week-label\">Your team, in sync</div>\n              <div class=\"planner-title\">The week ahead</div>\n            </div>\n            <div class=\"team-avatars\" aria-label=\"Four team members\">\n              <span class=\"avatar\">AL</span>\n              <span class=\"avatar\">JM</span>\n              <span class=\"avatar\">SK</span>\n              <span class=\"avatar\">+2</span>\n            </div>\n          </div>\n\n          <div class=\"week-grid\">\n            <div></div>\n            <div class=\"day today\">MON<span>20</span></div>\n            <div class=\"day\">TUE<span>21</span></div>\n            <div class=\"day\">WED<span>22</span></div>\n            <div class=\"day\">THU<span>23</span></div>\n            <div class=\"day\">FRI<span>24</span></div>\n\n            <div class=\"time\">9:00</div>\n            <div class=\"slot\"><div class=\"event\"><strong>Weekly check-in</strong>Team \u00b7 30 min</div></div>\n            <div class=\"slot\"><div class=\"event blue\"><strong>Focus time</strong>Alex \u00b7 project plan</div></div>\n            <div class=\"slot\"></div>\n            <div class=\"slot\"><div class=\"event peach\"><strong>Client kickoff</strong>Sam + Jamie</div></div>\n            <div class=\"slot\"></div>\n\n            <div class=\"time\">11:00</div>\n            <div class=\"slot\"><div class=\"event soft\"><strong>Write the brief</strong>Jamie \u00b7 deep work</div></div>\n            <div class=\"slot\"></div>\n            <div class=\"slot\"><div class=\"event yellow\"><strong>Design review</strong>Team \u00b7 45 min</div></div>\n            <div class=\"slot\"></div>\n            <div class=\"slot\"><div class=\"event blue\"><strong>Wrap & reflect</strong>Team \u00b7 20 min</div></div>\n\n            <div class=\"time\">1:00</div>\n            <div class=\"slot\"></div>\n            <div class=\"slot\"><div class=\"event peach\"><strong>Partner notes</strong>Sam \u00b7 follow-up</div></div>\n            <div class=\"slot\"><div class=\"event soft\"><strong>Open afternoon</strong>Room to think</div></div>\n            <div class=\"slot\"><div class=\"event yellow\"><strong>Share progress</strong>Jamie \u00b7 async</div></div>\n            <div class=\"slot\"></div>\n          </div>\n\n          <div class=\"planner-foot\">\n            <span class=\"week-status\">Everyone's in the loop</span>\n            <span>3 shared priorities</span>\n          </div>\n        </div>\n\n        <div class=\"floating-note\">\n          <div class=\"note-top\"><span class=\"note-spark\">\u2733</span> A small reminder</div>\n          <p>Leave a little space for the unexpected.</p>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"proof\" aria-label=\"Teams who use Tidepool\">\n      <div class=\"proof-label\">A little more in sync, together</div>\n      <div class=\"proof-list\">\n        <span>Goodkind</span>\n        <span>Fieldnotes</span>\n        <span>northstar studio</span>\n        <span>COMMON GROUND</span>\n        <span>Daybreak</span>\n      </div>\n    </section>\n\n    <section class=\"wrap section\" id=\"why-tidepool\">\n      <div class=\"section-intro\">\n        <div class=\"eyebrow\">A better kind of planning</div>\n        <h2>Less status chasing.<br />More meaningful work.</h2>\n        <p>\n          The best weeks aren\u2019t packed to the edges. They\u2019re built around what matters,\n          with enough clarity for everyone to find their rhythm.\n        </p>\n      </div>\n\n      <div class=\"feature-grid\">\n        <article class=\"feature\">\n          <div class=\"feature-icon\" aria-hidden=\"true\">\u25f7</div>\n          <h3>Start together</h3>\n          <p>Gather priorities, energy, and availability in one easy weekly check-in. No meeting marathon required.</p>\n        </article>\n        <article class=\"feature\">\n          <div class=\"feature-icon\" aria-hidden=\"true\">\u2197</div>\n          <h3>Find your focus</h3>\n          <p>See the shape of the week at a glance, so deep work and important conversations have room to happen.</p>\n        </article>\n        <article class=\"feature\">\n          <div class=\"feature-icon\" aria-hidden=\"true\">\u2301</div>\n          <h3>Keep it human</h3>\n          <p>Make space for capacity, context, and the unexpected. A plan should support your people, not crowd them.</p>\n        </article>\n      </div>\n    </section>\n\n    <section class=\"ritual\" id=\"how-it-works\">\n      <div class=\"wrap ritual-inner\">\n        <div class=\"ritual-copy\">\n          <div class=\"eyebrow\">A ritual worth keeping</div>\n          <h2>Make Monday feel a little lighter.</h2>\n          <p>\n            Tidepool turns the weekly scramble into a simple shared habit.\n            Ten thoughtful minutes can give your team a whole lot of clarity.\n          </p>\n          <a class=\"button\" href=\"#get-started\">Find your team\u2019s rhythm <span class=\"arrow\">\u2197</span></a>\n        </div>\n\n        <div class=\"steps\">\n          <article class=\"step\">\n            <div class=\"step-number\">1</div>\n            <div>\n              <h3>Everyone checks in</h3>\n              <p>Share what\u2019s on your plate, what needs attention, and where you have room.</p>\n            </div>\n          </article>\n          <article class=\"step\">\n            <div class=\"step-number\">2</div>\n            <div>\n              <h3>Make a plan that fits</h3>\n              <p>Bring priorities and availability together into a week your team can actually do.</p>\n            </div>\n          </article>\n          <article class=\"step\">\n            <div class=\"step-number\">3</div>\n            <div>\n              <h3>Let the week unfold</h3>\n              <p>Stay connected as things change, without turning every update into another meeting.</p>\n            </div>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"wrap quote-section\" id=\"stories\">\n      <div class=\"quote-mark\" aria-hidden=\"true\">\u201c</div>\n      <blockquote>\n        It feels less like managing a calendar and more like making a promise to each other about the week.\n      </blockquote>\n      <div class=\"quote-credit\"><strong>Riley Chen</strong> \u00b7 Co-founder, Goodkind Studio</div>\n    </section>\n\n    <section class=\"wrap\" id=\"get-started\">\n      <div class=\"cta\">\n        <div class=\"eyebrow\">Your next week starts here</div>\n        <h2>Make a little space for better work.</h2>\n        <p>Bring your people together. We\u2019ll help you find a rhythm that feels like yours.</p>\n        <a class=\"button\" href=\"mailto:hello@tidepool.team\">Try Tidepool free <span class=\"arrow\">\u2197</span></a>\n      </div>\n    </section>\n  </main>\n\n  <footer class=\"wrap\">\n    <a class=\"brand footer-brand\" href=\"#\">\n      <span class=\"brand-mark\" aria-hidden=\"true\"></span>\n      tidepool\n    </a>\n    <div>\u00a9 2024 Tidepool. Made for the way teams really work.</div>\n    <nav class=\"footer-links\" aria-label=\"Footer navigation\">\n      <a href=\"#\">Privacy</a>\n      <a href=\"#\">Terms</a>\n      <a href=\"mailto:hello@tidepool.team\">Say hello</a>\n    </nav>\n  </footer>\n</body>\n</html>\n"}