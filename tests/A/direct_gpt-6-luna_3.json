{"arm": "direct", "model": "openai/gpt-6-luna", "i": 3, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <meta name=\"theme-color\" content=\"#f7f6f1\">\n  <title>Tidepool \u2014 Make room for the work that matters</title>\n  <style>\n    :root {\n      --paper: #f7f6f1;\n      --white: #fffefa;\n      --ink: #20312d;\n      --muted: #687772;\n      --line: #e7e8df;\n      --green: #245b4b;\n      --green-dark: #194538;\n      --mint: #dceee5;\n      --coral: #f18d6e;\n      --yellow: #f5d789;\n      --lavender: #e8e4f3;\n      --shadow: 0 24px 70px rgba(37, 58, 49, .12);\n    }\n\n    * { box-sizing: border-box; }\n\n    html { scroll-behavior: smooth; }\n\n    body {\n      margin: 0;\n      background: var(--paper);\n      color: var(--ink);\n      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      -webkit-font-smoothing: antialiased;\n    }\n\n    a { color: inherit; text-decoration: none; }\n\n    .page-shell {\n      max-width: 1440px;\n      margin: 0 auto;\n      overflow: hidden;\n    }\n\n    .nav {\n      height: 86px;\n      padding: 0 7.3%;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n    }\n\n    .brand {\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      font-size: 21px;\n      font-weight: 750;\n      letter-spacing: -1px;\n    }\n\n    .brand-mark {\n      width: 32px;\n      height: 32px;\n      display: grid;\n      place-items: center;\n      border-radius: 11px;\n      background: var(--green);\n    }\n\n    .brand-mark svg { display: block; }\n\n    .nav-links {\n      display: flex;\n      align-items: center;\n      gap: 35px;\n      color: #53635d;\n      font-size: 14px;\n      font-weight: 550;\n    }\n\n    .nav-links a:hover { color: var(--green); }\n\n    .nav-cta {\n      padding: 12px 19px;\n      border-radius: 999px;\n      background: var(--green);\n      color: white !important;\n      font-weight: 650;\n      transition: background .2s, transform .2s;\n    }\n\n    .nav-cta:hover {\n      background: var(--green-dark);\n      transform: translateY(-1px);\n    }\n\n    .hero {\n      padding: 78px 7.3% 100px;\n      display: grid;\n      grid-template-columns: .9fr 1.1fr;\n      gap: 60px;\n      align-items: center;\n      min-height: 650px;\n    }\n\n    .eyebrow {\n      display: inline-flex;\n      align-items: center;\n      gap: 9px;\n      color: var(--green);\n      background: #e8f0e8;\n      border: 1px solid #d9e7dc;\n      border-radius: 999px;\n      padding: 8px 13px;\n      font-size: 12px;\n      font-weight: 700;\n      letter-spacing: .025em;\n    }\n\n    .eyebrow-dot {\n      width: 7px;\n      height: 7px;\n      border-radius: 50%;\n      background: #6fb58f;\n      box-shadow: 0 0 0 3px #cde7d7;\n    }\n\n    h1 {\n      max-width: 570px;\n      margin: 23px 0 19px;\n      font-size: clamp(48px, 5.7vw, 76px);\n      line-height: .99;\n      letter-spacing: -5px;\n      font-weight: 680;\n    }\n\n    h1 span { color: var(--green); }\n\n    .hero-copy {\n      max-width: 470px;\n      margin: 0;\n      color: var(--muted);\n      font-size: 17px;\n      line-height: 1.7;\n    }\n\n    .hero-actions {\n      display: flex;\n      align-items: center;\n      gap: 18px;\n      margin-top: 30px;\n    }\n\n    .button {\n      display: inline-flex;\n      justify-content: center;\n      align-items: center;\n      gap: 10px;\n      min-height: 51px;\n      padding: 0 22px;\n      border-radius: 9px;\n      background: var(--green);\n      color: white;\n      font-size: 14px;\n      font-weight: 700;\n      box-shadow: 0 6px 16px rgba(36, 91, 75, .15);\n      transition: background .2s, transform .2s;\n    }\n\n    .button:hover {\n      background: var(--green-dark);\n      transform: translateY(-2px);\n    }\n\n    .button svg { width: 16px; height: 16px; }\n\n    .quiet-link {\n      color: #586761;\n      font-size: 14px;\n      font-weight: 650;\n    }\n\n    .quiet-link:hover { color: var(--green); }\n\n    .social-proof {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      margin-top: 33px;\n      color: #77827c;\n      font-size: 12px;\n    }\n\n    .avatars { display: flex; padding-left: 4px; }\n\n    .avatar {\n      width: 27px;\n      height: 27px;\n      margin-left: -5px;\n      display: grid;\n      place-items: center;\n      border: 2px solid var(--paper);\n      border-radius: 50%;\n      color: #fff;\n      font-size: 9px;\n      font-weight: 800;\n    }\n\n    .avatar:nth-child(1) { background: #c97958; }\n    .avatar:nth-child(2) { background: #6a8b77; }\n    .avatar:nth-child(3) { background: #8276a4; }\n    .avatar:nth-child(4) { background: #d19c42; }\n\n    .proof-strong { color: #374940; font-weight: 700; }\n\n    .visual {\n      position: relative;\n      min-width: 0;\n      padding: 34px 0 28px 24px;\n    }\n\n    .visual::before {\n      content: \"\";\n      position: absolute;\n      width: 490px;\n      height: 490px;\n      top: 50%;\n      left: 50%;\n      transform: translate(-48%, -48%);\n      background: #e7eee5;\n      border-radius: 50%;\n      z-index: 0;\n    }\n\n    .visual::after {\n      content: \"\";\n      position: absolute;\n      width: 82px;\n      height: 82px;\n      top: 9px;\n      right: 22px;\n      border: 1px solid #d8ddd2;\n      border-radius: 50%;\n      z-index: 0;\n    }\n\n    .dashboard {\n      position: relative;\n      z-index: 1;\n      width: 100%;\n      max-width: 630px;\n      margin-left: auto;\n      overflow: hidden;\n      border: 1px solid #e6e7df;\n      border-radius: 16px;\n      background: var(--white);\n      box-shadow: var(--shadow);\n      transform: rotate(-1deg);\n    }\n\n    .dash-top {\n      height: 58px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 0 21px;\n      border-bottom: 1px solid #edeee8;\n    }\n\n    .dash-brand {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      font-size: 12px;\n      font-weight: 750;\n      letter-spacing: -.3px;\n    }\n\n    .tiny-mark {\n      width: 20px;\n      height: 20px;\n      display: grid;\n      place-items: center;\n      border-radius: 7px;\n      background: var(--green);\n    }\n\n    .dash-top-right {\n      display: flex;\n      align-items: center;\n      gap: 13px;\n      color: #829087;\n      font-size: 10px;\n    }\n\n    .mini-avatars { display: flex; }\n\n    .mini-avatars i {\n      width: 22px;\n      height: 22px;\n      display: grid;\n      place-items: center;\n      margin-left: -5px;\n      border: 2px solid var(--white);\n      border-radius: 50%;\n      color: white;\n      font-size: 7px;\n      font-style: normal;\n      font-weight: 800;\n    }\n\n    .mini-avatars i:nth-child(1) { background: #c97958; }\n    .mini-avatars i:nth-child(2) { background: #6a8b77; }\n    .mini-avatars i:nth-child(3) { background: #8276a4; }\n    .mini-avatars i:nth-child(4) { background: #d19c42; }\n\n    .dash-content { padding: 22px 23px 25px; }\n\n    .dash-heading {\n      display: flex;\n      justify-content: space-between;\n      align-items: flex-start;\n      margin-bottom: 20px;\n    }\n\n    .dash-heading h2 {\n      margin: 0 0 5px;\n      font-size: 20px;\n      letter-spacing: -.8px;\n    }\n\n    .dash-heading p {\n      margin: 0;\n      color: #87918b;\n      font-size: 10px;\n    }\n\n    .week-label {\n      display: flex;\n      align-items: center;\n      gap: 7px;\n      padding: 8px 10px;\n      border: 1px solid #e8eae4;\n      border-radius: 7px;\n      color: #59675f;\n      font-size: 9px;\n      font-weight: 650;\n    }\n\n    .week-label svg { width: 12px; height: 12px; }\n\n    .focus-card {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 12px;\n      padding: 13px 15px;\n      margin-bottom: 20px;\n      border: 1px solid #e5ede4;\n      border-radius: 10px;\n      background: #f1f6ef;\n    }\n\n    .focus-left {\n      display: flex;\n      align-items: center;\n      gap: 11px;\n    }\n\n    .focus-icon {\n      width: 31px;\n      height: 31px;\n      display: grid;\n      place-items: center;\n      border-radius: 9px;\n      background: #dcecdf;\n      color: var(--green);\n    }\n\n    .focus-icon svg { width: 16px; height: 16px; }\n\n    .focus-copy strong {\n      display: block;\n      margin-bottom: 3px;\n      font-size: 10px;\n    }\n\n    .focus-copy span {\n      display: block;\n      color: #758079;\n      font-size: 9px;\n    }\n\n    .focus-tag {\n      padding: 6px 9px;\n      border-radius: 999px;\n      background: white;\n      color: #527764;\n      font-size: 8px;\n      font-weight: 700;\n      white-space: nowrap;\n    }\n\n    .board-head, .task-row {\n      display: grid;\n      grid-template-columns: 1.03fr 1.55fr .85fr .55fr;\n      align-items: center;\n      gap: 8px;\n    }\n\n    .board-head {\n      padding: 0 9px 9px;\n      border-bottom: 1px solid #eff0eb;\n      color: #9aa39d;\n      font-size: 8px;\n      font-weight: 750;\n      letter-spacing: .07em;\n      text-transform: uppercase;\n    }\n\n    .task-row {\n      min-height: 47px;\n      padding: 0 9px;\n      border-bottom: 1px solid #f1f2ee;\n      font-size: 9px;\n    }\n\n    .task-row:last-child { border-bottom: 0; }\n\n    .day {\n      display: flex;\n      align-items: center;\n      gap: 7px;\n      color: #506158;\n      font-weight: 700;\n    }\n\n    .day-num {\n      width: 23px;\n      height: 23px;\n      display: grid;\n      place-items: center;\n      border-radius: 7px;\n      background: #f3f4ef;\n      color: #708078;\n      font-size: 9px;\n    }\n\n    .day.today .day-num {\n      background: var(--green);\n      color: white;\n    }\n\n    .task-name {\n      color: #34453d;\n      font-weight: 600;\n    }\n\n    .task-status {\n      width: fit-content;\n      padding: 5px 8px;\n      border-radius: 999px;\n      font-size: 8px;\n      font-weight: 700;\n      white-space: nowrap;\n    }\n\n    .status-green { background: #e4f1e7; color: #4c7a5b; }\n    .status-yellow { background: #fbf0d4; color: #987731; }\n    .status-purple { background: #eeebf7; color: #756899; }\n\n    .task-person {\n      width: 21px;\n      height: 21px;\n      display: grid;\n      place-items: center;\n      border-radius: 50%;\n      color: white;\n      font-size: 7px;\n      font-weight: 800;\n    }\n\n    .person-a { background: #c97958; }\n    .person-b { background: #6a8b77; }\n    .person-c { background: #8276a4; }\n    .person-d { background: #d19c42; }\n\n    .float-note {\n      position: absolute;\n      z-index: 2;\n      right: -7px;\n      bottom: 7px;\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      padding: 12px 15px;\n      border: 1px solid #ebe9df;\n      border-radius: 11px;\n      background: var(--white);\n      box-shadow: 0 12px 30px rgba(37, 58, 49, .1);\n      transform: rotate(2deg);\n    }\n\n    .note-check {\n      width: 25px;\n      height: 25px;\n      display: grid;\n      place-items: center;\n      border-radius: 50%;\n      background: #e3f1e6;\n      color: #4c8a61;\n    }\n\n    .note-check svg { width: 13px; height: 13px; }\n\n    .float-note strong {\n      display: block;\n      font-size: 9px;\n      margin-bottom: 3px;\n    }\n\n    .float-note span {\n      display: block;\n      color: #818b84;\n      font-size: 8px;\n    }\n\n    .section {\n      padding: 91px 7.3%;\n    }\n\n    .benefits {\n      background: #fffefa;\n      border-top: 1px solid #eeeee8;\n      border-bottom: 1px solid #eeeee8;\n    }\n\n    .section-intro {\n      max-width: 540px;\n      margin: 0 auto 47px;\n      text-align: center;\n    }\n\n    .section-kicker {\n      color: #64816f;\n      font-size: 11px;\n      font-weight: 750;\n      letter-spacing: .13em;\n      text-transform: uppercase;\n    }\n\n    .section-intro h2 {\n      margin: 12px 0 13px;\n      font-size: clamp(31px, 4vw, 45px);\n      line-height: 1.1;\n      letter-spacing: -2px;\n      font-weight: 670;\n    }\n\n    .section-intro p {\n      margin: 0;\n      color: var(--muted);\n      font-size: 15px;\n      line-height: 1.65;\n    }\n\n    .feature-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 19px;\n      max-width: 1050px;\n      margin: auto;\n    }\n\n    .feature-card {\n      min-height: 215px;\n      padding: 25px 24px;\n      border: 1px solid #ecece5;\n      border-radius: 13px;\n      background: #fffefa;\n    }\n\n    .feature-icon {\n      width: 40px;\n      height: 40px;\n      display: grid;\n      place-items: center;\n      margin-bottom: 22px;\n      border-radius: 12px;\n      color: var(--green);\n    }\n\n    .feature-icon svg { width: 20px; height: 20px; }\n    .feature-icon.mint { background: #e2f0e7; }\n    .feature-icon.peach { background: #fae9df; color: #a86448; }\n    .feature-icon.lilac { background: #eeebf7; color: #756899; }\n\n    .feature-card h3 {\n      margin: 0 0 8px;\n      font-size: 16px;\n      letter-spacing: -.3px;\n    }\n\n    .feature-card p {\n      margin: 0;\n      color: #77827c;\n      font-size: 13px;\n      line-height: 1.65;\n    }\n\n    .quote-section {\n      padding: 83px 7.3%;\n      text-align: center;\n      background: #edf2eb;\n    }\n\n    .quote-mark {\n      color: #8aab91;\n      font-family: Georgia, serif;\n      font-size: 62px;\n      line-height: .7;\n    }\n\n    blockquote {\n      max-width: 700px;\n      margin: 21px auto 22px;\n      font-size: clamp(22px, 3vw, 31px);\n      line-height: 1.36;\n      letter-spacing: -1px;\n      font-weight: 580;\n    }\n\n    .quote-credit {\n      color: #728077;\n      font-size: 12px;\n    }\n\n    .quote-credit strong { color: #405348; }\n\n    .cta-section {\n      padding: 82px 7.3% 85px;\n      text-align: center;\n    }\n\n    .cta-card {\n      position: relative;\n      max-width: 1050px;\n      margin: 0 auto;\n      padding: 58px 25px;\n      overflow: hidden;\n      border-radius: 18px;\n      background: var(--green);\n      color: white;\n    }\n\n    .cta-card::before, .cta-card::after {\n      content: \"\";\n      position: absolute;\n      border: 1px solid rgba(255,255,255,.14);\n      border-radius: 50%;\n    }\n\n    .cta-card::before {\n      width: 320px;\n      height: 320px;\n      top: -210px;\n      left: -70px;\n    }\n\n    .cta-card::after {\n      width: 380px;\n      height: 380px;\n      right: -160px;\n      bottom: -260px;\n    }\n\n    .cta-content { position: relative; z-index: 1; }\n\n    .cta-card h2 {\n      margin: 0 0 12px;\n      font-size: clamp(31px, 4vw, 44px);\n      letter-spacing: -2px;\n    }\n\n    .cta-card p {\n      margin: 0 0 25px;\n      color: #d1e0d8;\n      font-size: 15px;\n    }\n\n    .cta-card .button {\n      background: #fffefa;\n      color: var(--green);\n      box-shadow: none;\n    }\n\n    .cta-card .button:hover { background: #eaf2eb; }\n\n    footer {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 23px 7.3%;\n      border-top: 1px solid #e7e8df;\n      color: #7a847e;\n      font-size: 11px;\n    }\n\n    footer .brand { color: var(--ink); font-size: 16px; }\n    footer .brand-mark { width: 25px; height: 25px; border-radius: 8px; }\n    footer .brand-mark svg { width: 15px; height: 15px; }\n    .footer-links { display: flex; gap: 22px; }\n    .footer-links a:hover { color: var(--green); }\n\n    @media (max-width: 900px) {\n      .nav { padding: 0 5%; }\n      .hero {\n        padding: 55px 5% 82px;\n        grid-template-columns: 1fr;\n        gap: 33px;\n      }\n      .hero-copy { max-width: 540px; }\n      .visual { max-width: 660px; width: 100%; margin: auto; }\n      .dashboard { margin: auto; }\n      .section, .quote-section, .cta-section { padding-left: 5%; padding-right: 5%; }\n      footer { padding-left: 5%; padding-right: 5%; }\n    }\n\n    @media (max-width: 620px) {\n      .nav { height: 72px; }\n      .nav-links { gap: 14px; }\n      .nav-links a:not(.nav-cta) { display: none; }\n      .nav-cta { padding: 10px 15px; font-size: 12px; }\n      .hero { padding-top: 42px; }\n      h1 { letter-spacing: -3.4px; }\n      .hero-copy { font-size: 15px; }\n      .hero-actions { gap: 14px; }\n      .button { min-height: 47px; padding: 0 16px; font-size: 13px; }\n      .visual { padding: 24px 0 24px; }\n      .visual::before { width: 360px; height: 360px; }\n      .dash-top { padding: 0 13px; }\n      .dash-content { padding: 17px 13px 18px; }\n      .dash-heading h2 { font-size: 17px; }\n      .board-head, .task-row { grid-template-columns: .85fr 1.45fr .8fr .35fr; gap: 5px; }\n      .task-row { font-size: 8px; }\n      .task-status { padding: 4px 6px; font-size: 7px; }\n      .day { gap: 4px; font-size: 8px; }\n      .day-num { width: 20px; height: 20px; }\n      .float-note { right: -3px; bottom: 0; padding: 9px 11px; }\n      .feature-grid { grid-template-columns: 1fr; gap: 12px; }\n      .feature-card { min-height: auto; padding: 21px; }\n      .feature-icon { margin-bottom: 14px; }\n      .section { padding-top: 68px; padding-bottom: 68px; }\n      .section-intro { margin-bottom: 31px; }\n      .quote-section { padding-top: 65px; padding-bottom: 65px; }\n      .cta-section { padding-top: 60px; padding-bottom: 60px; }\n      .cta-card { padding: 48px 20px; }\n      footer { align-items: flex-start; flex-direction: column; gap: 17px; }\n      .footer-links { gap: 17px; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      html { scroll-behavior: auto; }\n      *, *::before, *::after { transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"page-shell\">\n    <header class=\"nav\">\n      <a class=\"brand\" href=\"#\" aria-label=\"Tidepool home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M3.5 14.3c2.3 0 2.3-2.7 4.7-2.7s2.4 2.7 4.8 2.7 2.4-2.7 4.8-2.7 2.4 2.7 2.7 2.7\" stroke=\"#fffefa\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n            <path d=\"M3.5 18.3c2.3 0 2.3-2.7 4.7-2.7s2.4 2.7 4.8 2.7 2.4-2.7 4.8-2.7 2.4 2.7 2.7 2.7\" stroke=\"#bce0c9\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n            <circle cx=\"12\" cy=\"6\" r=\"2\" fill=\"#f5d789\"/>\n          </svg>\n        </span>\n        tidepool\n      </a>\n      <nav class=\"nav-links\" aria-label=\"Main navigation\">\n        <a href=\"#how-it-works\">How it works</a>\n        <a href=\"#why-tidepool\">Why Tidepool</a>\n        <a class=\"nav-cta\" href=\"#get-started\">Get started <span aria-hidden=\"true\">\u2197</span></a>\n      </nav>\n    </header>\n\n    <main>\n      <section class=\"hero\" aria-labelledby=\"hero-title\">\n        <div class=\"hero-text\">\n          <div class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> A calmer way to work together</div>\n          <h1 id=\"hero-title\">Make room for the work <span>that matters.</span></h1>\n          <p class=\"hero-copy\">Tidepool helps your team turn a pile of priorities into a week that feels clear, doable, and shared.</p>\n          <div class=\"hero-actions\">\n            <a class=\"button\" href=\"#get-started\">Plan your week <span aria-hidden=\"true\">\u2192</span></a>\n            <a class=\"quiet-link\" href=\"#how-it-works\">See how it works</a>\n          </div>\n          <div class=\"social-proof\">\n            <div class=\"avatars\" aria-hidden=\"true\">\n              <span class=\"avatar\">AM</span><span class=\"avatar\">JL</span><span class=\"avatar\">SK</span><span class=\"avatar\">TR</span>\n            </div>\n            <span><span class=\"proof-strong\">2,000+ small teams</span> found their flow</span>\n          </div>\n        </div>\n\n        <div class=\"visual\" aria-label=\"Preview of the Tidepool weekly planning board\">\n          <div class=\"dashboard\">\n            <div class=\"dash-top\">\n              <div class=\"dash-brand\">\n                <span class=\"tiny-mark\" aria-hidden=\"true\">\n                  <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\">\n                    <path d=\"M3 13c2.4 0 2.4-3 4.8-3s2.4 3 4.8 3 2.4-3 4.8-3 2.4 3 3.6 3\" stroke=\"white\" stroke-width=\"2.4\" stroke-linecap=\"round\"/>\n                    <path d=\"M3 18c2.4 0 2.4-3 4.8-3s2.4 3 4.8 3 2.4-3 4.8-3 2.4 3 3.6 3\" stroke=\"#bce0c9\" stroke-width=\"2.4\" stroke-linecap=\"round\"/>\n                  </svg>\n                </span>\n                tidepool\n              </div>\n              <div class=\"dash-top-right\">\n                <span>Studio team</span>\n                <div class=\"mini-avatars\" aria-label=\"Four team members\">\n                  <i>AM</i><i>JL</i><i>SK</i><i>TR</i>\n                </div>\n              </div>\n            </div>\n\n            <div class=\"dash-content\">\n              <div class=\"dash-heading\">\n                <div>\n                  <h2>Our week, at a glance</h2>\n                  <p>One clear plan. Room for real life.</p>\n                </div>\n                <div class=\"week-label\">\n                  <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n                    <rect x=\"3.5\" y=\"5\" width=\"17\" height=\"15.5\" rx=\"2.5\" stroke=\"currentColor\" stroke-width=\"1.7\"/>\n                    <path d=\"M7.5 3.5v3M16.5 3.5v3M4 9.5h16\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/>\n                  </svg>\n                  May 13 \u2013 17\n                </div>\n              </div>\n\n              <div class=\"focus-card\">\n                <div class=\"focus-left\">\n                  <span class=\"focus-icon\" aria-hidden=\"true\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\">\n                      <path d=\"M12 3.5v3M12 17.5v3M3.5 12h3M17.5 12h3M6 6l2.1 2.1m7.8 7.8L18 18M18 6l-2.1 2.1M8.1 15.9 6 18\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n                      <circle cx=\"12\" cy=\"12\" r=\"4\" stroke=\"currentColor\" stroke-width=\"1.8\"/>\n                    </svg>\n                  </span>\n                  <div class=\"focus-copy\">\n                    <strong>This week\u2019s big thing</strong>\n                    <span>Ship the new member welcome flow</span>\n                  </div>\n                </div>\n                <span class=\"focus-tag\">Team focus</span>\n              </div>\n\n              <div class=\"board-head\">\n                <span>Day</span><span>What\u2019s happening</span><span>Energy</span><span>Who</span>\n              </div>\n              <div class=\"task-row\">\n                <span class=\"day today\"><span class=\"day-num\">13</span> Mon</span>\n                <span class=\"task-name\">Sketch welcome journey</span>\n                <span class=\"task-status status-green\">In the flow</span>\n                <span class=\"task-person person-a\">AM</span>\n              </div>\n              <div class=\"task-row\">\n                <span class=\"day\"><span class=\"day-num\">14</span> Tue</span>\n                <span class=\"task-name\">Review first-round copy</span>\n                <span class=\"task-status status-yellow\">Needs a chat</span>\n                <span class=\"task-person person-b\">JL</span>\n              </div>\n              <div class=\"task-row\">\n                <span class=\"day\"><span class=\"day-num\">15</span> Wed</span>\n                <span class=\"task-name\">Build the first draft</span>\n                <span class=\"task-status status-green\">In the flow</span>\n                <span class=\"task-person person-c\">SK</span>\n              </div>\n              <div class=\"task-row\">\n                <span class=\"day\"><span class=\"day-num\">16</span> Thu</span>\n                <span class=\"task-name\">Team show &amp; tell</span>\n                <span class=\"task-status status-purple\">Good together</span>\n                <span class=\"task-person person-d\">TR</span>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"float-note\">\n            <span class=\"note-check\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\">\n                <path d=\"m6 12.5 4 4 8-9\" stroke=\"currentColor\" stroke-width=\"2.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n            </span>\n            <div><strong>Everyone\u2019s on the same page</strong><span>And no one\u2019s carrying it alone.</span></div>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"section benefits\" id=\"how-it-works\">\n        <div class=\"section-intro\">\n          <span class=\"section-kicker\">A little more breathing room</span>\n          <h2>Less \u201cwhat are we doing?\u201d<br>More \u201cwe\u2019ve got this.\u201d</h2>\n          <p>Weekly planning shouldn\u2019t feel like another project. Tidepool gives your team a simple rhythm to find focus and keep it.</p>\n        </div>\n\n        <div class=\"feature-grid\" id=\"why-tidepool\">\n          <article class=\"feature-card\">\n            <span class=\"feature-icon mint\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\">\n                <path d=\"M4 6.5h16M4 12h10M4 17.5h7\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n                <circle cx=\"18\" cy=\"16\" r=\"3\" stroke=\"currentColor\" stroke-width=\"1.8\"/>\n                <path d=\"m20.2 18.2 1.3 1.3\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n              </svg>\n            </span>\n            <h3>Find the real priorities</h3>\n            <p>Get everything out of everyone\u2019s head, then agree on what actually matters this week.</p>\n          </article>\n\n          <article class=\"feature-card\">\n            <span class=\"feature-icon peach\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\">\n                <circle cx=\"8\" cy=\"8\" r=\"3\" stroke=\"currentColor\" stroke-width=\"1.8\"/>\n                <circle cx=\"17\" cy=\"9\" r=\"2.4\" stroke=\"currentColor\" stroke-width=\"1.8\"/>\n                <path d=\"M2.8 19c.4-3.1 2.2-4.7 5.2-4.7s4.8 1.6 5.2 4.7M14.1 14.8c2.9-.8 5.8.7 6.7 3.4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n              </svg>\n            </span>\n            <h3>Make the load visible</h3>\n            <p>See who\u2019s got space, who needs a hand, and where a small shift can make a big difference.</p>\n          </article>\n\n          <article class=\"feature-card\">\n            <span class=\"feature-icon lilac\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\">\n                <path d=\"M4 16.5c2.5-5.5 5-5.5 7.5 0s5 5.5 8.5-1\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\"/>\n                <path d=\"M16.5 15.5H20v3.5\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n                <circle cx=\"6\" cy=\"7\" r=\"2\" stroke=\"currentColor\" stroke-width=\"1.7\"/>\n                <circle cx=\"18\" cy=\"7\" r=\"2\" stroke=\"currentColor\" stroke-width=\"1.7\"/>\n              </svg>\n            </span>\n            <h3>Leave room to adapt</h3>\n            <p>Plans change. Keep the important things in view without turning every pivot into a reset.</p>\n          </article>\n        </div>\n      </section>\n\n      <section class=\"quote-section\" aria-label=\"Customer testimonial\">\n        <div class=\"quote-mark\" aria-hidden=\"true\">\u201c</div>\n        <blockquote>We stopped ending Mondays with a longer to-do list than we started with. That\u2019s a pretty big deal.</blockquote>\n        <div class=\"quote-credit\"><strong>Rae Kim</strong> \u00b7 Co-founder, Goodwell Studio</div>\n      </section>\n\n      <section class=\"cta-section\" id=\"get-started\">\n        <div class=\"cta-card\">\n          <div class=\"cta-content\">\n            <h2>Make next week feel lighter.</h2>\n            <p>Bring your people, your priorities, and a little breathing room.</p>\n            <a class=\"button\" href=\"mailto:hello@tidepool.team\">Start planning together <span aria-hidden=\"true\">\u2192</span></a>\n          </div>\n        </div>\n      </section>\n    </main>\n\n    <footer>\n      <a class=\"brand\" href=\"#\" aria-label=\"Tidepool home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M3.5 14.3c2.3 0 2.3-2.7 4.7-2.7s2.4 2.7 4.8 2.7 2.4-2.7 4.8-2.7 2.4 2.7 2.7 2.7\" stroke=\"#fffefa\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n            <path d=\"M3.5 18.3c2.3 0 2.3-2.7 4.7-2.7s2.4 2.7 4.8 2.7 2.4-2.7 4.8-2.7 2.4 2.7 2.7 2.7\" stroke=\"#bce0c9\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n          </svg>\n        </span>\n        tidepool\n      </a>\n      <span>\u00a9 2025 Tidepool. Good work, together.</span>\n      <div class=\"footer-links\">\n        <a href=\"mailto:hello@tidepool.team\">Contact</a>\n        <a href=\"#why-tidepool\">About</a>\n        <a href=\"#get-started\">Get started</a>\n      </div>\n    </footer>\n  </div>\n</body>\n</html>\n"}