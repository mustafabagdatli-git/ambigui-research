{"arm": "vs", "model": "z-ai/glm-5.3-flashx", "i": 5, "finish": "stop", "dirs": [{"direction": "Editorial paper-like layout with warm cream background, serif headlines, and a hand-drawn-feel weekly grid hero \u2014 feels calm and human like a shared notebook", "probability": 0.34}, {"direction": "Dark, typographic, product-led page with a large interactive demo of the weekly planner front and center", "probability": 0.22}, {"direction": "Bold brutalist style: chunky borders, bright coastal blue/orange palette, oversized type, flat graphic shapes evoking tides", "probability": 0.18}, {"direction": "Minimal SaaS classic: white space, small centered hero, feature triads, logo strip, testimonials carousel", "probability": 0.14}, {"direction": "Playful illustration-driven page with animated waves, blobs, and character avatars collaborating around a calendar", "probability": 0.12}], "pick": {"direction": "Minimal SaaS classic: white space, small centered hero, feature triads, logo strip, testimonials carousel", "probability": 0.14}, "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Tidepool \u2014 Plan your week together</title>\n<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n  :root {\n    --ink: #1a2332;\n    --muted: #5b6577;\n    --line: #e6e9ef;\n    --accent: #2f6fed;\n    --accent-dark: #1e56c8;\n    --tint: #f4f7fb;\n    --radius: 12px;\n  }\n  html { scroll-behavior: smooth; }\n  body {\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n    color: var(--ink);\n    background: #fff;\n    line-height: 1.6;\n    -webkit-font-smoothing: antialiased;\n  }\n  .container { max-width: 1080px; margin: 0 auto; padding: 0 24px; }\n\n  /* ---------- Nav ---------- */\n  nav {\n    position: sticky; top: 0; z-index: 100;\n    background: rgba(255,255,255,.85);\n    backdrop-filter: blur(10px);\n    border-bottom: 1px solid var(--line);\n  }\n  .nav-inner {\n    display: flex; align-items: center; justify-content: space-between;\n    height: 64px;\n  }\n  .logo {\n    display: flex; align-items: center; gap: 10px;\n    font-weight: 700; font-size: 18px; letter-spacing: -0.02em;\n    text-decoration: none; color: var(--ink);\n  }\n  .logo svg { display: block; }\n  .nav-links { display: flex; align-items: center; gap: 32px; }\n  .nav-links a {\n    text-decoration: none; color: var(--muted); font-size: 14.5px; font-weight: 500;\n    transition: color .15s;\n  }\n  .nav-links a:hover { color: var(--ink); }\n  .btn {\n    display: inline-block; text-decoration: none; font-weight: 600; font-size: 15px;\n    padding: 10px 20px; border-radius: 8px;\n    transition: background .15s, transform .15s, box-shadow .15s;\n  }\n  .btn-primary {\n    background: var(--accent); color: #fff;\n    box-shadow: 0 1px 2px rgba(47,111,237,.3);\n  }\n  .btn-primary:hover { background: var(--accent-dark); transform: translateY(-1px); }\n  .btn-ghost { color: var(--ink); }\n  .btn-ghost:hover { background: var(--tint); }\n  .btn-lg { padding: 14px 28px; font-size: 16px; border-radius: 10px; }\n\n  /* ---------- Hero ---------- */\n  .hero { text-align: center; padding: 96px 0 72px; }\n  .eyebrow {\n    display: inline-block; font-size: 13px; font-weight: 600;\n    color: var(--accent); background: #eef3fe;\n    padding: 6px 14px; border-radius: 100px; margin-bottom: 24px;\n    letter-spacing: .02em;\n  }\n  .hero h1 {\n    font-size: clamp(38px, 6vw, 58px);\n    line-height: 1.1; letter-spacing: -0.03em; font-weight: 800;\n    max-width: 720px; margin: 0 auto 20px;\n  }\n  .hero h1 .accent { color: var(--accent); }\n  .hero p {\n    font-size: 19px; color: var(--muted); max-width: 560px;\n    margin: 0 auto 36px;\n  }\n  .hero-cta { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-bottom: 16px; }\n  .hero-note { font-size: 13px; color: #8a93a5; }\n\n  /* App mockup */\n  .mockup {\n    margin: 56px auto 0; max-width: 880px;\n    border: 1px solid var(--line); border-radius: 16px;\n    box-shadow: 0 30px 60px -20px rgba(26,35,50,.18);\n    overflow: hidden; text-align: left; background: #fff;\n  }\n  .mockup-bar {\n    display: flex; gap: 6px; align-items: center;\n    padding: 12px 16px; border-bottom: 1px solid var(--line); background: #fafbfd;\n  }\n  .dot { width: 10px; height: 10px; border-radius: 50%; }\n  .mockup-url {\n    margin-left: 12px; font-size: 12px; color: #8a93a5;\n    background: #fff; border: 1px solid var(--line);\n    border-radius: 6px; padding: 3px 14px;\n  }\n  .mockup-body { display: grid; grid-template-columns: 180px 1fr; }\n  .mockup-side { border-right: 1px solid var(--line); padding: 18px 14px; background: #fafbfd; }\n  .side-item {\n    font-size: 13px; color: var(--muted); padding: 7px 10px;\n    border-radius: 7px; margin-bottom: 2px;\n  }\n  .side-item.active { background: #eef3fe; color: var(--accent); font-weight: 600; }\n  .mockup-main { padding: 20px; }\n  .week-header {\n    display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;\n  }\n  .week-title { font-weight: 700; font-size: 15px; }\n  .avatars { display: flex; }\n  .avatar {\n    width: 26px; height: 26px; border-radius: 50%;\n    border: 2px solid #fff; margin-left: -8px;\n    font-size: 10px; font-weight: 700; color: #fff;\n    display: flex; align-items: center; justify-content: center;\n  }\n  .day-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; }\n  .day {\n    border: 1px solid var(--line); border-radius: 8px; padding: 8px; min-height: 130px;\n  }\n  .day-name { font-size: 11px; font-weight: 700; color: #8a93a5; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 8px; }\n  .task {\n    font-size: 11px; border-radius: 5px; padding: 5px 7px; margin-bottom: 5px;\n    background: var(--tint); color: var(--ink); font-weight: 500;\n  }\n  .task.blue { background: #eef3fe; color: var(--accent-dark); }\n  .task.green { background: #eaf7ef; color: #1e7a45; }\n  .task.amber { background: #fdf3e2; color: #a06514; }\n  .task.dim { opacity: .55; }\n\n  /* ---------- Logo strip ---------- */\n  .logos { padding: 56px 0 24px; text-align: center; }\n  .logos p {\n    font-size: 13px; font-weight: 600; color: #8a93a5;\n    text-transform: uppercase; letter-spacing: .1em; margin-bottom: 28px;\n  }\n  .logo-row {\n    display: flex; justify-content: center; align-items: center;\n    gap: 56px; flex-wrap: wrap; opacity: .55;\n  }\n  .logo-row span {\n    font-size: 19px; font-weight: 700; letter-spacing: -0.01em; color: var(--ink);\n  }\n  .logo-row span.serif { font-family: Georgia, serif; font-weight: 600; }\n  .logo-row span.mono { font-family: \"SF Mono\", Menlo, monospace; font-size: 17px; }\n  .logo-row span.wide { letter-spacing: .22em; font-size: 15px; text-transform: uppercase; }\n\n  /* ---------- Features ---------- */\n  .features { padding: 96px 0 24px; }\n  .section-head { text-align: center; max-width: 560px; margin: 0 auto 56px; }\n  .section-head h2 {\n    font-size: clamp(28px, 4vw, 38px); letter-spacing: -0.02em;\n    font-weight: 800; margin-bottom: 14px;\n  }\n  .section-head p { color: var(--muted); font-size: 17px; }\n  .triad {\n    display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px;\n  }\n  .feature {\n    padding: 32px 28px; border: 1px solid var(--line); border-radius: var(--radius);\n    transition: box-shadow .2s, transform .2s;\n  }\n  .feature:hover { box-shadow: 0 12px 32px -12px rgba(26,35,50,.14); transform: translateY(-3px); }\n  .feature-icon {\n    width: 44px; height: 44px; border-radius: 10px;\n    display: flex; align-items: center; justify-content: center;\n    margin-bottom: 20px; background: #eef3fe;\n  }\n  .feature h3 { font-size: 17px; font-weight: 700; margin-bottom: 8px; letter-spacing: -0.01em; }\n  .feature p { font-size: 14.5px; color: var(--muted); }\n\n  /* ---------- How it works ---------- */\n  .how { padding: 96px 0; }\n  .how-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }\n  .step-num {\n    font-size: 13px; font-weight: 700; color: var(--accent);\n    letter-spacing: .08em; margin-bottom: 12px; display: block;\n  }\n  .how-grid h3 { font-size: 18px; font-weight: 700; margin-bottom: 8px; }\n  .how-grid p { font-size: 14.5px; color: var(--muted); }\n\n  /* ---------- Testimonials ---------- */\n  .testimonials { background: var(--tint); padding: 96px 0; }\n  .carousel { position: relative; max-width: 680px; margin: 0 auto; text-align: center; }\n  .slides { position: relative; min-height: 240px; }\n  .slide {\n    position: absolute; inset: 0;\n    opacity: 0; transform: translateY(8px); pointer-events: none;\n    transition: opacity .35s ease, transform .35s ease;\n  }\n  .slide.active { opacity: 1; transform: none; pointer-events: auto; }\n  .slide blockquote {\n    font-size: clamp(20px, 3vw, 26px); font-weight: 600;\n    letter-spacing: -0.015em; line-height: 1.4; margin-bottom: 28px;\n  }\n  .slide .who { display: flex; align-items: center; justify-content: center; gap: 12px; }\n  .slide .pic {\n    width: 44px; height: 44px; border-radius: 50%; color: #fff;\n    font-weight: 700; font-size: 15px;\n    display: flex; align-items: center; justify-content: center;\n  }\n  .slide .who-text { text-align: left; line-height: 1.35; }\n  .slide .who-text strong { display: block; font-size: 15px; }\n  .slide .who-text span { font-size: 13.5px; color: var(--muted); }\n  .carousel-nav { display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 40px; }\n  .c-dot {\n    width: 8px; height: 8px; border-radius: 50%; border: none; cursor: pointer;\n    background: #c6cdd9; padding: 0; transition: background .2s, width .2s;\n  }\n  .c-dot.active { background: var(--accent); width: 22px; border-radius: 100px; }\n  .c-arrow {\n    position: absolute; top: 45%; transform: translateY(-50%);\n    width: 40px; height: 40px; border-radius: 50%;\n    border: 1px solid var(--line); background: #fff; cursor: pointer;\n    color: var(--muted); font-size: 17px;\n    display: flex; align-items: center; justify-content: center;\n    transition: background .15s, color .15s;\n  }\n  .c-arrow:hover { background: var(--ink); color: #fff; }\n  .c-arrow.prev { left: -72px; }\n  .c-arrow.next { right: -72px; }\n\n  /* ---------- CTA ---------- */\n  .cta { text-align: center; padding: 104px 0; }\n  .cta h2 { font-size: clamp(30px, 4.5vw, 42px); letter-spacing: -0.02em; font-weight: 800; margin-bottom: 16px; }\n  .cta p { color: var(--muted); font-size: 17px; margin-bottom: 32px; }\n\n  /* ---------- Footer ---------- */\n  footer { border-top: 1px solid var(--line); padding: 48px 0; }\n  .footer-inner {\n    display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px;\n  }\n  .footer-links { display: flex; gap: 28px; }\n  .footer-links a { font-size: 14px; color: var(--muted); text-decoration: none; }\n  .footer-links a:hover { color: var(--ink); }\n  .copyright { font-size: 13.5px; color: #8a93a5; }\n\n  /* ---------- Responsive ---------- */\n  @media (max-width: 860px) {\n    .nav-links a:not(.btn) { display: none; }\n    .triad, .how-grid { grid-template-columns: 1fr; }\n    .mockup-body { grid-template-columns: 1fr; }\n    .mockup-side { display: none; }\n    .c-arrow.prev { left: -8px; }\n    .c-arrow.next { right: -8px; }\n    .day-grid { grid-template-columns: repeat(2, 1fr); }\n    .logo-row { gap: 32px; }\n  }\n</style>\n</head>\n<body>\n\n<nav>\n  <div class=\"container nav-inner\">\n    <a class=\"logo\" href=\"#\">\n      <svg width=\"26\" height=\"26\" viewBox=\"0 0 26 26\" fill=\"none\">\n        <rect width=\"26\" height=\"26\" rx=\"7\" fill=\"#2f6fed\"/>\n        <path d=\"M4 16c3-4 6 4 9 0s6 4 9 0\" stroke=\"#fff\" stroke-width=\"2.2\" stroke-linecap=\"round\" fill=\"none\"/>\n        <path d=\"M4 10.5c3-4 6 4 9 0s6 4 9 0\" stroke=\"#bcd2fa\" stroke-width=\"2.2\" stroke-linecap=\"round\" fill=\"none\"/>\n      </svg>\n      Tidepool\n    </a>\n    <div class=\"nav-links\">\n      <a href=\"#features\">Features</a>\n      <a href=\"#how\">How it works</a>\n      <a href=\"#customers\">Customers</a>\n      <a href=\"#\" class=\"btn btn-ghost\">Sign in</a>\n      <a href=\"#\" class=\"btn btn-primary\">Get started</a>\n    </div>\n  </div>\n</nav>\n\n<header class=\"hero container\">\n  <span class=\"eyebrow\">\u2726 New: Weekly retro templates</span>\n  <h1>Plan your week <span class=\"accent\">together</span>, not in silos</h1>\n  <p>Tidepool gives small teams one shared space to set weekly priorities, see who's doing what, and ship with momentum \u2014 without another meeting.</p>\n  <div class=\"hero-cta\">\n    <a href=\"#\" class=\"btn btn-primary btn-lg\">Start free \u2014 no card needed</a>\n    <a href=\"#how\" class=\"btn btn-ghost btn-lg\">See how it works</a>\n  </div>\n  <span class=\"hero-note\">Free for teams up to 5 \u00b7 Set up in under 2 minutes</span>\n\n  <div class=\"mockup\" aria-hidden=\"true\">\n    <div class=\"mockup-bar\">\n      <span class=\"dot\" style=\"background:#ff5f57\"></span>\n      <span class=\"dot\" style=\"background:#febc2e\"></span>\n      <span class=\"dot\" style=\"background:#28c840\"></span>\n      <span class=\"mockup-url\">app.tidepool.io/week/24</span>\n    </div>\n    <div class=\"mockup-body\">\n      <div class=\"mockup-side\">\n        <div class=\"side-item active\">This week</div>\n        <div class=\"side-item\">Last week</div>\n        <div class=\"side-item\">Backlog</div>\n        <div class=\"side-item\">Team</div>\n        <div class=\"side-item\">Retros</div>\n      </div>\n      <div class=\"mockup-main\">\n        <div class=\"week-header\">\n          <span class=\"week-title\">Week 24 \u00b7 Jun 10\u201314</span>\n          <div class=\"avatars\">\n            <span class=\"avatar\" style=\"background:#2f6fed\">AM</span>\n            <span class=\"avatar\" style=\"background:#1e7a45\">JK</span>\n            <span class=\"avatar\" style=\"background:#a06514\">RS</span>\n            <span class=\"avatar\" style=\"background:#7a4fd0\">TL</span>\n          </div>\n        </div>\n        <div class=\"day-grid\">\n          <div class=\"day\"><div class=\"day-name\">Mon</div>\n            <div class=\"task blue\">Kickoff: v2 scope</div>\n            <div class=\"task\">Draft launch copy</div>\n          </div>\n          <div class=\"day\"><div class=\"day-name\">Tue</div>\n            <div class=\"task green\">Ship billing fix</div>\n            <div class=\"task dim\">Design review</div>\n          </div>\n          <div class=\"day\"><div class=\"day-name\">Wed</div>\n            <div class=\"task amber\">Customer calls</div>\n            <div class=\"task\">Sprint planning</div>\n          </div>\n          <div class=\"day\"><div class=\"day-name\">Thu</div>\n            <div class=\"task blue\">API docs pass</div>\n            <div class=\"task dim\">Bug triage</div>\n          </div>\n          <div class=\"day\"><div class=\"day-name\">Fri</div>\n            <div class=\"task green\">Weekly retro \ud83c\udf89</div>\n            <div class=\"task dim\">Demo day</div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</header>\n\n<section class=\"logos container\">\n  <p>Trusted by teams at</p>\n  <div class=\"logo-row\">\n    <span class=\"serif\">Fernwell</span>\n    <span class=\"mono\">buildkit_</span>\n    <span class=\"wide\">Northloop</span>\n    <span>Paper Crane</span>\n    <span class=\"mono\">hexlab</span>\n    <span class=\"serif\">Oakhurst&nbsp;Co.</span>\n  </div>\n</section>\n\n<section class=\"features container\" id=\"features\">\n  <div class=\"section-head\">\n    <h2>Everything a small week needs</h2>\n    <p>No bloat, no 40-column spreadsheets. Just the essentials, done beautifully.</p>\n  </div>\n  <div class=\"triad\">\n    <div class=\"feature\">\n      <div class=\"feature-icon\">\n        <svg width=\"22\" height=\"22\" viewBox=\"0 0 22 22\" fill=\"none\"><rect x=\"2\" y=\"3\" width=\"18\" height=\"16\" rx=\"3\" stroke=\"#2f6fed\" stroke-width=\"1.8\"/><path d=\"M2 8h18M7 2v3M15 2v3\" stroke=\"#2f6fed\" stroke-width=\"1.8\" stroke-linecap=\"round\"/><path d=\"M7 13l2.5 2.5L15 11\" stroke=\"#2f6fed\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n      </div>\n      <h3>Shared weekly board</h3>\n      <p>Everyone's priorities on one calendar-style board. See the whole week at a glance and spot conflicts before they happen.</p>\n    </div>\n    <div class=\"feature\">\n      <div class=\"feature-icon\">\n        <svg width=\"22\" height=\"22\" viewBox=\"0 0 22 22\" fill=\"none\"><circle cx=\"8\" cy=\"7\" r=\"3.5\" stroke=\"#2f6fed\" stroke-width=\"1.8\"/><path d=\"M2 19c.5-4 3-6 6-6s5.5 2 6 6\" stroke=\"#2f6fed\" stroke-width=\"1.8\" stroke-linecap=\"round\"/><circle cx=\"16\" cy=\"8\" r=\"2.5\" stroke=\"#2f6fed\" stroke-width=\"1.8\"/><path d=\"M15.5 13.5c2.5.2 4 2 4.5 5\" stroke=\"#2f6fed\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg>\n      </div>\n      <h3>Async check-ins</h3>\n      <p>Lightweight Monday prompts and Friday wrap-ups replace status meetings. Two minutes each, visible to everyone.</p>\n    </div>\n    <div class=\"feature\">\n      <div class=\"feature-icon\">\n        <svg width=\"22\" height=\"22\" viewBox=\"0 0 22 22\" fill=\"none\"><path d=\"M3 19V9M9 19V3M15 19v-8M21 19H1\" stroke=\"#2f6fed\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg>\n      </div>\n      <h3>Momentum insights</h3>\n      <p>A gentle weekly digest shows what got done, what carried over, and where the team is trending \u2014 no micromanagement.</p>\n    </div>\n  </div>\n</section>\n\n<section class=\"how container\" id=\"how\">\n  <div class=\"section-head\">\n    <h2>Up and running by your next Monday</h2>\n    <p>Three steps. That's the whole onboarding.</p>\n  </div>\n  <div class=\"how-grid\">\n    <div>\n      <span class=\"step-num\">STEP 1</span>\n      <h3>Invite your team</h3>\n      <p>Share a link. Your whole team joins in seconds \u2014 no accounts to configure, no seats to agonize over.</p>\n    </div>\n    <div>\n      <span class=\"step-num\">STEP 2</span>\n      <h3>Set the week's focus</h3>\n      <p>Each person drops their top priorities onto the shared board. Everyone sees the picture in one glance.</p>\n    </div>\n    <div>\n      <span class=\"step-num\">STEP 3</span>\n      <h3>Close the loop Friday</h3>\n      <p>Tidepool wraps the week automatically: wins, carry-overs, and a running thread of what your team shipped.</p>\n    </div>\n  </div>\n</section>\n\n<section class=\"testimonials\" id=\"customers\">\n  <div class=\"container\">\n    <div class=\"section-head\">\n      <h2>Teams that found their rhythm</h2>\n    </div>\n    <div class=\"carousel\" id=\"carousel\">\n      <button class=\"c-arrow prev\" id=\"prev\" aria-label=\"Previous testimonial\">\u2190</button>\n      <div class=\"slides\">\n        <div class=\"slide active\">\n          <blockquote>\"We killed our Monday status meeting in week one. Tidepool gives us the same clarity in a tenth of the time \u2014 and honestly, better clarity.\"</blockquote>\n          <div class=\"who\">\n            <span class=\"pic\" style=\"background:#2f6fed\">MK</span>\n            <span class=\"who-text\"><strong>Maya Krishnan</strong><span>Co-founder, Fernwell (team of 6)</span></span>\n          </div>\n        </div>\n        <div class=\"slide\">\n          <blockquote>\"I've tried every planning tool on the market. Tidepool is the only one my team actually opens every single week without me nagging.\"</blockquote>\n          <div class=\"who\">\n            <span class=\"pic\" style=\"background:#1e7a45\">DB</span>\n            <span class=\"who-text\"><strong>Daniel Brooks</strong><span>Engineering Lead, Hexlab</span></span>\n          </div>\n        </div>\n        <div class=\"slide\">\n          <blockquote>\"The Friday wrap-up thread has become our favorite ritual. It's the first time remote work has felt genuinely connected, not just coordinated.\"</blockquote>\n          <div class=\"who\">\n            <span class=\"pic\" style=\"background:#a06514\">SA</span>\n            <span class=\"who-text\"><strong>Sofia Alvarez</strong><span>Head of Product, Paper Crane</span></span>\n          </div>\n        </div>\n        <div class=\"slide\">\n          <blockquote>\"Setup took two minutes. Within a month our on-time delivery went from 'vibes-based' to reliably consistent. Small tool, big habit shift.\"</blockquote>\n          <div class=\"who\">\n            <span class=\"pic\" style=\"background:#7a4fd0\">JL</span>\n            <span class=\"who-text\"><strong>James Lee</strong><span>Founder, Northloop Studio</span></span>\n          </div>\n        </div>\n      </div>\n      <button class=\"c-arrow next\" id=\"next\" aria-label=\"Next testimonial\">\u2192</button>\n      <div class=\"carousel-nav\" id=\"dots\"></div>\n    </div>\n  </div>\n</section>\n\n<section class=\"cta container\">\n  <h2>Make next week your best one yet</h2>\n  <p>Join 2,400+ small teams planning together with Tidepool.</p>\n  <a href=\"#\" class=\"btn btn-primary btn-lg\">Start your free week</a>\n</section>\n\n<footer>\n  <div class=\"container footer-inner\">\n    <a class=\"logo\" href=\"#\">\n      <svg width=\"22\" height=\"22\" viewBox=\"0 0 26 26\" fill=\"none\">\n        <rect width=\"26\" height=\"26\" rx=\"7\" fill=\"#2f6fed\"/>\n        <path d=\"M4 16c3-4 6 4 9 0s6 4 9 0\" stroke=\"#fff\" stroke-width=\"2.2\" stroke-linecap=\"round\" fill=\"none\"/>\n        <path d=\"M4 10.5c3-4 6 4 9 0s6 4 9 0\" stroke=\"#bcd2fa\" stroke-width=\"2.2\" stroke-linecap=\"round\" fill=\"none\"/>\n      </svg>\n      Tidepool\n    </a>\n    <div class=\"footer-links\">\n      <a href=\"#\">Product</a>\n      <a href=\"#\">Pricing</a>\n      <a href=\"#\">Changelog</a>\n      <a href=\"#\">Privacy</a>\n      <a href=\"#\">Contact</a>\n    </div>\n    <span class=\"copyright\">\u00a9 2025 Tidepool, Inc. Made for small teams everywhere.</span>\n  </div>\n</footer>\n\n<script>\n  const slides = document.querySelectorAll('.slide');\n  const dotsWrap = document.getElementById('dots');\n  let idx = 0, timer;\n\n  slides.forEach((_, i) => {\n    const d = document.createElement('button');\n    d.className = 'c-dot' + (i === 0 ? ' active' : '');\n    d.setAttribute('aria-label', 'Go to testimonial ' + (i + 1));\n    d.onclick = () => go(i);\n    dotsWrap.appendChild(d);\n  });\n  const dots = document.querySelectorAll('.c-dot');\n\n  function go(i) {\n    slides[idx].classList.remove('active');\n    dots[idx].classList.remove('active');\n    idx = (i + slides.length) % slides.length;\n    slides[idx].classList.add('active');\n    dots[idx].classList.add('active');\n    restart();\n  }\n  function restart() { clearInterval(timer); timer = setInterval(() => go(idx + 1), 6000); }\n  document.getElementById('prev').onclick = () => go(idx - 1);\n  document.getElementById('next').onclick = () => go(idx + 1);\n  restart();\n</script>\n\n</body>\n</html>\n"}