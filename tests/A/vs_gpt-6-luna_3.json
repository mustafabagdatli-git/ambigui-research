\n\n    a { color: inherit; text-decoration: none; }\n\n    .page-shell {\n      max-width: 1440px;\n      margin: 0 auto;\n      overflow: hidden;\n    }\n\n    .site-header {\n      height: 92px;\n      padding: 0 7.2%;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      border-bottom: 1px solid rgba(29, 52, 56, .1);\n    }\n\n    .brand {\n      display: inline-flex;\n      align-items: center;\n      gap: 11px;\n      font-family: var(--serif);\n      font-size: 25px;\n      letter-spacing: -.7px;\n    }\n\n    .brand-mark {\n      width: 31px;\n      height: 31px;\n      display: grid;\n      place-items: center;\n      border: 1px solid var(--sea-dark);\n      border-radius: 50%;\n      color: #547f74;\n    }\n\n    .brand-mark svg { width: 19px; height: 19px; }\n\n    .nav-links {\n      display: flex;\n      align-items: center;\n      gap: 38px;\n      color: #536366;\n      font-size: 13px;\n    }\n\n    .nav-links a:not(.nav-cta):hover { color: var(--ink); }\n\n    .nav-cta {\n      padding: 12px 19px;\n      border: 1px solid #9aaba4;\n      border-radius: 3px;\n      color: var(--ink);\n      transition: background .2s, border-color .2s;\n    }\n\n    .nav-cta:hover { background: var(--sea); border-color: var(--sea-dark); }\n\n    .hero {\n      min-height: 635px;\n      padding: 72px 7.2% 76px;\n      display: grid;\n      grid-template-columns: .91fr 1.09fr;\n      align-items: center;\n      gap: 5.5%;\n      position: relative;\n    }\n\n    .hero-copy { position: relative; z-index: 1; padding-bottom: 10px; }\n\n    .eyebrow {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      color: #637873;\n      font-size: 11px;\n      font-weight: 700;\n      letter-spacing: 1.7px;\n      text-transform: uppercase;\n    }\n\n    .eyebrow::before {\n      content: \"\";\n      width: 25px;\n      height: 1px;\n      background: var(--coral);\n    }\n\n    h1 {\n      max-width: 600px;\n      margin: 24px 0 22px;\n      font-family: var(--serif);\n      font-size: clamp(62px, 7.1vw, 101px);\n      font-weight: 400;\n      letter-spacing: -5.4px;\n      line-height: .96;\n    }\n\n    h1 em {\n      color: #6f9b8d;\n      font-weight: 400;\n    }\n\n    .hero-description {\n      max-width: 420px;\n      margin: 0;\n      color: #5b6a6b;\n      font-size: 16px;\n      line-height: 1.8;\n    }\n\n    .hero-actions {\n      display: flex;\n      align-items: center;\n      gap: 20px;\n      margin-top: 30px;\n    }\n\n    .button {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: 13px;\n      min-height: 51px;\n      padding: 0 21px;\n      border-radius: 3px;\n      background: var(--ink);\n      color: var(--white);\n      font-size: 13px;\n      transition: transform .2s, background .2s;\n    }\n\n    .button:hover { transform: translateY(-2px); background: #294a4e; }\n\n    .button svg { width: 15px; height: 15px; }\n\n    .quiet-link {\n      color: #526466;\n      font-size: 13px;\n      border-bottom: 1px solid #aebbb4;\n      padding-bottom: 3px;\n    }\n\n    .quiet-link:hover { color: var(--ink); border-color: var(--ink); }\n\n    .micro-note {\n      margin-top: 25px;\n      color: #7a8581;\n      font-size: 11px;\n      letter-spacing: .1px;\n    }\n\n    .hero-art {\n      min-width: 0;\n      position: relative;\n      padding: 18px 0 22px;\n    }\n\n    .art-wash {\n      position: absolute;\n      z-index: 0;\n      width: 440px;\n      height: 440px;\n      top: 50%;\n      left: 50%;\n      border-radius: 50%;\n      transform: translate(-45%, -49%);\n      background: radial-gradient(circle, #e2ece3 0%, #e8eee5 46%, rgba(245,243,236,0) 72%);\n    }\n\n    .chart-orbit {\n      position: absolute;\n      z-index: 0;\n      width: 490px;\n      height: 490px;\n      top: 50%;\n      left: 50%;\n      transform: translate(-42%, -50%);\n      opacity: .65;\n    }\n\n    .planner {\n      position: relative;\n      z-index: 1;\n      max-width: 600px;\n      margin-left: auto;\n      padding: 23px 23px 20px;\n      border: 1px solid rgba(34, 61, 61, .11);\n      border-radius: 7px;\n      background: rgba(255, 254, 250, .96);\n      box-shadow: 0 24px 65px rgba(38, 58, 53, .11), 0 3px 10px rgba(38, 58, 53, .04);\n      transform: rotate(.6deg);\n    }\n\n    .planner-top {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding-bottom: 17px;\n      border-bottom: 1px solid #e9e8df;\n    }\n\n    .planner-heading {\n      font-family: var(--serif);\n      font-size: 21px;\n      letter-spacing: -.4px;\n    }\n\n    .planner-heading small {\n      display: block;\n      margin-top: 5px;\n      color: #89938d;\n      font-family: var(--sans);\n      font-size: 10px;\n      letter-spacing: .25px;\n    }\n\n    .avatar-stack { display: flex; align-items: center; }\n    .avatar {\n      width: 27px;\n      height: 27px;\n      display: grid;\n      place-items: center;\n      margin-left: -6px;\n      border: 2px solid var(--white);\n      border-radius: 50%;\n      color: #38534e;\n      background: #d4e3d8;\n      font-size: 8px;\n      font-weight: 700;\n    }\n    .avatar:first-child { margin-left: 0; background: #edcfbd; color: #865b4c; }\n    .avatar:nth-child(3) { background: #e6dfc9; color: #686149; }\n    .avatar.more { background: #f0eee7; color: #78827d; font-size: 9px; }\n\n    .week-labels {\n      display: grid;\n      grid-template-columns: 68px repeat(5, 1fr);\n      padding: 14px 0 8px;\n      color: #8b9690;\n      font-size: 9px;\n      text-align: center;\n      text-transform: uppercase;\n      letter-spacing: .6px;\n    }\n\n    .week-labels span:first-child { text-align: left; }\n    .week-labels .today { color: #4d8977; font-weight: 700; }\n\n    .plan-row {\n      display: grid;\n      grid-template-columns: 68px repeat(5, 1fr);\n      min-height: 62px;\n      border-top: 1px solid #eeede6;\n      align-items: center;\n    }\n\n    .person {\n      display: flex;\n      align-items: center;\n      gap: 7px;\n      color: #566665;\n      font-size: 10px;\n      white-space: nowrap;\n    }\n\n    .person-dot {\n      width: 7px;\n      height: 7px;\n      border-radius: 50%;\n      background: var(--sea-dark);\n    }\n    .person-dot.coral { background: var(--coral); }\n    .person-dot.gold { background: #c5a962; }\n\n    .task {\n      min-height: 32px;\n      margin: 3px 3px;\n      padding: 6px 7px;\n      border-radius: 3px;\n      color: #45675c;\n      background: #e4eee7;\n      font-size: 9px;\n      line-height: 1.3;\n    }\n    .task.peach { color: #895d4d; background: #f3e5db; }\n    .task.sand { color: #746843; background: #f0ecd9; }\n    .task.blank { background: transparent; }\n\n    .focus-strip {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      margin-top: 17px;\n      padding: 12px 13px;\n      border-radius: 3px;\n      background: #f3f2ec;\n      color: #65726d;\n      font-size: 10px;\n    }\n\n    .focus-strip strong {\n      color: #3d6257;\n      font-weight: 600;\n    }\n\n    .focus-progress {\n      width: 69px;\n      height: 4px;\n      margin-left: auto;\n      overflow: hidden;\n      border-radius: 3px;\n      background: #d9ded5;\n    }\n\n    .focus-progress span {\n      display: block;\n      width: 62%;\n      height: 100%;\n      background: #7ea998;\n    }\n\n    .floating-note {\n      position: absolute;\n      z-index: 2;\n      right: -21px;\n      bottom: -5px;\n      display: flex;\n      align-items: center;\n      gap: 11px;\n      padding: 13px 16px;\n      border: 1px solid rgba(34, 61, 61, .09);\n      border-radius: 4px;\n      background: var(--white);\n      box-shadow: 0 12px 30px rgba(38, 58, 53, .1);\n      color: #576867;\n      font-size: 10px;\n      transform: rotate(-2deg);\n    }\n\n    .note-icon {\n      width: 27px;\n      height: 27px;\n      display: grid;\n      place-items: center;\n      border-radius: 50%;\n      background: #f3e4d9;\n      color: #b66d53;\n    }\n\n    .note-icon svg { width: 14px; height: 14px; }\n    .floating-note strong { display: block; margin-bottom: 3px; color: var(--ink); font-size: 11px; }\n\n    .trust-band {\n      min-height: 110px;\n      padding: 25px 7.2%;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 25px;\n      border-top: 1px solid var(--line);\n      border-bottom: 1px solid var(--line);\n    }\n\n    .trust-copy {\n      max-width: 235px;\n      color: #7a8580;\n      font-family: var(--serif);\n      font-size: 16px;\n      line-height: 1.4;\n    }\n\n    .trust-logos {\n      display: flex;\n      align-items: center;\n      justify-content: flex-end;\n      gap: clamp(25px, 5vw, 69px);\n      color: #6c7b77;\n    }\n\n    .trust-logos span {\n      font-family: var(--serif);\n      font-size: 18px;\n      letter-spacing: -.5px;\n      white-space: nowrap;\n    }\n\n    .trust-logos span:nth-child(2) { font-style: italic; }\n    .trust-logos span:nth-child(3) { font-family: var(--sans); font-size: 13px; font-weight: 700; letter-spacing: 1px; }\n    .trust-logos span:nth-child(4) { font-size: 20px; }\n\n    .manifesto {\n      padding: 103px 7.2% 108px;\n      display: grid;\n      grid-template-columns: .75fr 1.25fr;\n      gap: 10%;\n      align-items: start;\n    }\n\n    .manifesto-label {\n      padding-top: 12px;\n      color: #75847e;\n      font-size: 11px;\n      font-weight: 700;\n      letter-spacing: 1.5px;\n      text-transform: uppercase;\n    }\n\n    .manifesto-label::after {\n      content: \"\";\n      display: block;\n      width: 37px;\n      height: 1px;\n      margin-top: 18px;\n      background: var(--coral);\n    }\n\n    .manifesto h2 {\n      max-width: 690px;\n      margin: 0;\n      font-family: var(--serif);\n      font-weight: 400;\n      font-size: clamp(36px, 4.3vw, 58px);\n      line-height: 1.12;\n      letter-spacing: -1.8px;\n    }\n\n    .manifesto h2 em { color: #6f9b8d; font-weight: 400; }\n\n    .manifesto p {\n      max-width: 480px;\n      margin: 23px 0 0;\n      color: #657371;\n      font-size: 14px;\n      line-height: 1.8;\n    }\n\n    .bottom-cta {\n      margin: 0 7.2% 64px;\n      padding: 52px 6%;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 30px;\n      background: #e5ede5;\n    }\n\n    .bottom-cta h2 {\n      margin: 0;\n      font-family: var(--serif);\n      font-size: clamp(30px, 4vw, 47px);\n      font-weight: 400;\n      letter-spacing: -1px;\n    }\n\n    .bottom-cta p {\n      margin: 10px 0 0;\n      color: #63736e;\n      font-size: 13px;\n    }\n\n    .site-footer {\n      padding: 24px 7.2% 34px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      color: #7d8882;\n      font-size: 11px;\n    }\n\n    .footer-brand {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      color: #506663;\n      font-family: var(--serif);\n      font-size: 17px;\n    }\n\n    .footer-brand svg { width: 18px; height: 18px; }\n    .footer-links { display: flex; gap: 22px; }\n    .footer-links a:hover { color: var(--ink); }\n\n    @media (max-width: 900px) {\n      .site-header { padding: 0 5%; }\n      .hero { padding: 65px 5% 70px; grid-template-columns: .9fr 1.1fr; gap: 3%; }\n      h1 { font-size: clamp(58px, 8vw, 78px); letter-spacing: -3.8px; }\n      .planner { padding: 18px 16px; }\n      .week-labels, .plan-row { grid-template-columns: 57px repeat(5, 1fr); }\n      .person { font-size: 9px; }\n      .task { font-size: 8px; padding: 5px; }\n      .floating-note { right: -7px; }\n      .trust-band, .manifesto { padding-left: 5%; padding-right: 5%; }\n      .bottom-cta { margin-left: 5%; margin-right: 5%; }\n      .trust-logos { gap: 22px; }\n    }\n\n    @media (max-width: 680px) {\n      .site-header { height: 74px; }\n      .brand { font-size: 23px; }\n      .nav-links { gap: 16px; }\n      .nav-links a:not(.nav-cta) { display: none; }\n      .nav-cta { padding: 10px 13px; font-size: 12px; }\n      .hero {\n        display: block;\n        padding: 58px 6% 72px;\n      }\n      h1 { max-width: 500px; font-size: clamp(64px, 15vw, 88px); }\n      .hero-description { max-width: 390px; font-size: 15px; }\n      .hero-art { margin: 38px -3% 0; }\n      .planner { max-width: 520px; margin: 0 auto; transform: none; }\n      .art-wash { width: 360px; height: 360px; }\n      .chart-orbit { width: 390px; height: 390px; }\n      .floating-note { right: 0; bottom: -23px; }\n      .trust-band { align-items: flex-start; flex-direction: column; padding: 28px 6%; }\n      .trust-copy { max-width: none; }\n      .trust-logos { width: 100%; flex-wrap: wrap; justify-content: flex-start; gap: 15px 27px; }\n      .trust-logos span { font-size: 16px; }\n      .manifesto {\n        padding: 72px 6%;\n        display: block;\n      }\n      .manifesto-label { margin-bottom: 25px; }\n      .manifesto h2 { font-size: clamp(37px, 9vw, 52px); }\n      .bottom-cta {\n        margin: 0 6% 42px;\n        padding: 34px 7%;\n        align-items: flex-start;\n        flex-direction: column;\n      }\n      .site-footer { padding: 22px 6% 28px; flex-wrap: wrap; gap: 16px; }\n      .footer-links { gap: 15px; }\n    }\n\n    @media (max-width: 400px) {\n      .hero-actions { gap: 13px; }\n      .button { padding: 0 15px; }\n      .week-labels, .plan-row { grid-template-columns: 49px repeat(5, 1fr); }\n      .person { gap: 4px; font-size: 8px; }\n      .task { margin: 2px; font-size: 7px; }\n      .planner-heading { font-size: 19px; }\n      .focus-strip { font-size: 9px; }\n      .footer-links { width: 100%; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      html { scroll-behavior: auto; }\n      *, *::before, *::after { transition-duration: .01ms !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"page-shell\">\n    <header class=\"site-header\">\n      <a class=\"brand\" href=\"#\" aria-label=\"Tidepool home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M3.5 9.5c2.8-2 5.6-2 8.5 0s5.7 2 8.5 0M3.5 14c2.8-2 5.6-2 8.5 0s5.7 2 8.5 0\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\n          </svg>\n        </span>\n        Tidepool\n      </a>\n      <nav class=\"nav-links\" aria-label=\"Main navigation\">\n        <a href=\"#why-tidepool\">Why Tidepool</a>\n        <a href=\"#how-it-works\">How it works</a>\n        <a class=\"nav-cta\" href=\"#get-started\">Get started <span aria-hidden=\"true\">\u2197</span></a>\n      </nav>\n    </header>\n\n    <main>\n      <section class=\"hero\" aria-labelledby=\"hero-title\">\n        <div class=\"hero-copy\">\n          <div class=\"eyebrow\">A calmer kind of planning</div>\n          <h1 id=\"hero-title\">Make room for <em>good work.</em></h1>\n          <p class=\"hero-description\">\n            Tidepool gives your team one thoughtful place to shape the week, share what matters, and leave a little space for the unexpected.\n          </p>\n          <div class=\"hero-actions\">\n            <a class=\"button\" href=\"#get-started\">\n              Plan your first week\n              <svg viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\">\n                <path d=\"M4 10h11m-4.5-4.5L15 10l-4.5 4.5\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n            </a>\n            <a class=\"quiet-link\" href=\"#how-it-works\">Take a look around</a>\n          </div>\n          <p class=\"micro-note\">Free to start \u00b7 Made for teams of 2\u201320</p>\n        </div>\n\n        <div class=\"hero-art\" aria-label=\"Preview of a shared weekly plan\">\n          <div class=\"art-wash\" aria-hidden=\"true\"></div>\n          <svg class=\"chart-orbit\" viewBox=\"0 0 500 500\" fill=\"none\" aria-hidden=\"true\">\n            <circle cx=\"250\" cy=\"250\" r=\"214\" stroke=\"#92b4a5\" stroke-width=\"1\" stroke-dasharray=\"2 8\"/>\n            <circle cx=\"250\" cy=\"250\" r=\"178\" stroke=\"#c5d8cc\" stroke-width=\"1\"/>\n            <path d=\"M55 285c45-46 74-46 119 0s74 46 119 0 74-46 119 0 74 46 119 0\" stroke=\"#c78168\" stroke-width=\"1.2\" opacity=\".7\"/>\n            <path d=\"M56 303c45-46 74-46 119 0s74 46 119 0 74-46 119 0 74 46 119 0\" stroke=\"#8daf9f\" stroke-width=\"1.2\" opacity=\".75\"/>\n            <circle cx=\"405\" cy=\"133\" r=\"3\" fill=\"#c78168\"/>\n            <circle cx=\"112\" cy=\"387\" r=\"2.5\" fill=\"#84a99a\"/>\n          </svg>\n\n          <div class=\"planner\">\n            <div class=\"planner-top\">\n              <div class=\"planner-heading\">\n                This week\n                <small>October 14 \u2013 18 \u00b7 Team studio</small>\n              </div>\n              <div class=\"avatar-stack\" aria-label=\"Four teammates\">\n                <span class=\"avatar\">AM</span>\n                <span class=\"avatar\">JL</span>\n                <span class=\"avatar\">RK</span>\n                <span class=\"avatar more\">+1</span>\n              </div>\n            </div>\n\n            <div class=\"week-labels\" aria-hidden=\"true\">\n              <span>People</span><span>Mon</span><span class=\"today\">Tue</span><span>Wed</span><span>Thu</span><span>Fri</span>\n            </div>\n\n            <div class=\"plan-row\">\n              <div class=\"person\"><span class=\"person-dot\"></span>Alex</div>\n              <div class=\"task\">Research<br>interviews</div>\n              <div class=\"task\">Synthesis</div>\n              <div class=\"task blank\"></div>\n              <div class=\"task\">Share<br>findings</div>\n              <div class=\"task blank\"></div>\n            </div>\n            <div class=\"plan-row\">\n              <div class=\"person\"><span class=\"person-dot coral\"></span>Jamie</div>\n              <div class=\"task peach\">Kickoff</div>\n              <div class=\"task peach\">Wireframes</div>\n              <div class=\"task peach\">Wireframes</div>\n              <div class=\"task blank\"></div>\n              <div class=\"task peach\">Review</div>\n            </div>\n            <div class=\"plan-row\">\n              <div class=\"person\"><span class=\"person-dot gold\"></span>Ravi</div>\n              <div class=\"task blank\"></div>\n              <div class=\"task sand\">Build v1</div>\n              <div class=\"task sand\">Build v1</div>\n              <div class=\"task sand\">QA pass</div>\n              <div class=\"task blank\"></div>\n            </div>\n\n            <div class=\"focus-strip\">\n              <span>Team focus: <strong>Make onboarding feel effortless</strong></span>\n              <span class=\"focus-progress\" aria-label=\"62 percent planned\"><span></span></span>\n            </div>\n          </div>\n\n          <div class=\"floating-note\">\n            <span class=\"note-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 20 20\" fill=\"none\">\n                <path d=\"M10 3v14M3 10h14M5.5 5.5l9 9m0-9-9 9\" stroke=\"currentColor\" stroke-width=\"1.25\" stroke-linecap=\"round\"/>\n              </svg>\n            </span>\n            <span><strong>Room to breathe</strong>Friday stays open.</span>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"trust-band\" aria-label=\"Teams that plan with Tidepool\">\n        <div class=\"trust-copy\">A little more in sync.<br>A lot less in the weeds.</div>\n        <div class=\"trust-logos\" aria-label=\"Trusted by teams at\">\n          <span>fieldnotes</span>\n          <span>common ground</span>\n          <span>MONDAY STUDIO</span>\n          <span>goodkind</span>\n        </div>\n      </section>\n\n      <section class=\"manifesto\" id=\"why-tidepool\">\n        <div class=\"manifesto-label\">The week, in perspective</div>\n        <div id=\"how-it-works\">\n          <h2>Planning shouldn\u2019t take over the work. It should help you <em>find its rhythm.</em></h2>\n          <p>\n            Bring your priorities, people, and plans into one shared view. Tidepool helps everyone see what\u2019s moving, where help is needed, and when it\u2019s time to take a breath.\n          </p>\n        </div>\n      </section>\n\n      <section class=\"bottom-cta\" id=\"get-started\">\n        <div>\n          <h2>Start the week on the same page.</h2>\n          <p>Good plans begin with a small conversation.</p>\n        </div>\n        <a class=\"button\" href=\"mailto:hello@tidepool.team\">\n          Make a plan together\n          <svg viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\">\n            <path d=\"M4 10h11m-4.5-4.5L15 10l-4.5 4.5\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          </svg>\n        </a>\n      </section>\n    </main>\n\n    <footer class=\"site-footer\">\n      <a class=\"footer-brand\" href=\"#\" aria-label=\"Tidepool home\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n          <path d=\"M3.5 9.5c2.8-2 5.6-2 8.5 0s5.7 2 8.5 0M3.5 14c2.8-2 5.6-2 8.5 0s5.7 2 8.5 0\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\n        </svg>\n        Tidepool\n      </a>\n      <span>Thoughtful weeks, together. \u00a9 2024 Tidepool</span>\n      <nav class=\"footer-links\" aria-label=\"Footer navigation\">\n        <a href=\"mailto:hello@tidepool.team\">Contact</a>\n        <a href=\"#why-tidepool\">About</a>\n        <a href=\"#get-started\">Get started</a>\n      </nav>\n    </footer>\n  </div>\n</body>\n</html>\n"}