{"arm": "direct", "model": "z-ai/glm-5.3-flashx", "i": 7, "finish": "stop", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tidepool \u2014 Plan your week together</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Instrument+Sans:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n:root{\n  --ink:#12333a;\n  --ink-soft:#3d5a60;\n  --teal:#0e6e6b;\n  --teal-deep:#0a4d4b;\n  --coral:#e5673f;\n  --coral-soft:#fbe9e0;\n  --sand:#f7f2e9;\n  --sand-deep:#efe7d8;\n  --foam:#ffffff;\n  --line:#dcd2c0;\n  --radius:18px;\n  --serif:'Fraunces',serif;\n  --sans:'Instrument Sans',sans-serif;\n}\n*{margin:0;padding:0;box-sizing:border-box}\nhtml{scroll-behavior:smooth}\nbody{\n  font-family:var(--sans);\n  color:var(--ink);\n  background:var(--sand);\n  line-height:1.6;\n  -webkit-font-smoothing:antialiased;\n}\nh1,h2,h3{font-family:var(--serif);font-weight:500;line-height:1.12;letter-spacing:-.01em}\na{color:inherit;text-decoration:none}\nimg{max-width:100%}\n.wrap{max-width:1120px;margin:0 auto;padding:0 24px}\n\n/* ---------- nav ---------- */\nheader{\n  position:sticky;top:0;z-index:50;\n  background:rgba(247,242,233,.88);\n  backdrop-filter:blur(10px);\n  border-bottom:1px solid var(--line);\n}\n.nav{display:flex;align-items:center;justify-content:space-between;height:68px}\n.logo{display:flex;align-items:center;gap:10px;font-family:var(--serif);font-size:22px;font-weight:600}\n.logo svg{display:block}\n.nav-links{display:flex;gap:32px;font-size:15px;font-weight:500;color:var(--ink-soft)}\n.nav-links a{transition:color .2s}\n.nav-links a:hover{color:var(--teal)}\n.nav-cta{display:flex;align-items:center;gap:12px}\n.btn{\n  display:inline-flex;align-items:center;gap:8px;\n  font-family:var(--sans);font-weight:600;font-size:15px;\n  padding:11px 22px;border-radius:999px;border:none;cursor:pointer;\n  transition:transform .18s ease, box-shadow .18s ease, background .18s;\n}\n.btn-primary{background:var(--teal);color:#fff;box-shadow:0 2px 0 var(--teal-deep)}\n.btn-primary:hover{transform:translateY(-2px);box-shadow:0 6px 16px rgba(14,110,107,.28);background:var(--teal-deep)}\n.btn-ghost{background:transparent;color:var(--ink);padding:11px 14px}\n.btn-ghost:hover{color:var(--teal)}\n\n/* ---------- hero ---------- */\n.hero{position:relative;overflow:hidden;padding:96px 0 0}\n.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center}\n.eyebrow{\n  display:inline-flex;align-items:center;gap:8px;\n  font-size:13px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;\n  color:var(--teal);background:#e3efec;border-radius:999px;padding:6px 14px;margin-bottom:22px;\n}\n.eyebrow .dot{width:7px;height:7px;border-radius:50%;background:var(--coral);animation:pulse 2.4s infinite}\n@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.45;transform:scale(.75)}}\n.hero h1{font-size:clamp(40px,5.4vw,64px);color:var(--ink)}\n.hero h1 em{font-style:italic;color:var(--teal);font-weight:600}\n.hero p.lede{margin:22px 0 32px;font-size:19px;color:var(--ink-soft);max-width:46ch}\n.hero-actions{display:flex;gap:14px;flex-wrap:wrap;align-items:center}\n.hero-note{font-size:13.5px;color:var(--ink-soft);margin-top:18px}\n\n/* signature: drifting tide blobs behind hero */\n.hero::before{\n  content:\"\";position:absolute;inset:auto -20% -40% -20%;height:70%;z-index:-1;\n  background:\n    radial-gradient(45% 55% at 20% 80%, rgba(14,110,107,.10), transparent 70%),\n    radial-gradient(40% 50% at 75% 90%, rgba(229,103,63,.10), transparent 70%);\n  animation:drift 14s ease-in-out infinite alternate;\n}\n@keyframes drift{from{transform:translateX(-2%)}to{transform:translateX(2%)}}\n\n/* ---------- product mock ---------- */\n.mock{\n  background:var(--foam);border:1px solid var(--line);border-radius:22px;\n  box-shadow:0 24px 60px -20px rgba(18,51,58,.22);\n  overflow:hidden;transform:rotate(1.2deg);\n  transition:transform .4s ease;\n}\n.mock:hover{transform:rotate(0deg) translateY(-4px)}\n.mock-bar{display:flex;align-items:center;gap:8px;padding:14px 18px;border-bottom:1px solid var(--line);background:var(--sand)}\n.mock-bar span{width:10px;height:10px;border-radius:50%}\n.mock-bar .r{background:#f0b1a0}.mock-bar .y{background:#f2d49b}.mock-bar .g{background:#a9d3bd}\n.mock-bar .title{margin-left:10px;font-size:13px;color:var(--ink-soft);font-weight:500}\n.mock-body{padding:20px 20px 24px}\n.mock-week{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}\n.day{background:var(--sand);border-radius:12px;padding:10px;min-height:150px}\n.day h4{font-size:12px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:10px;display:flex;justify-content:space-between}\n.day h4 small{color:var(--teal);font-weight:600}\n.chip{\n  font-size:11.5px;font-weight:500;border-radius:8px;padding:6px 8px;margin-bottom:6px;\n  border:1px solid transparent;line-height:1.35;\n}\n.chip b{display:block;font-weight:600}\n.c-teal{background:#e0efec;border-color:#bcdcd6;color:var(--teal-deep)}\n.c-coral{background:var(--coral-soft);border-color:#f2cbb8;color:#9c3f1e}\n.c-sand{background:#f2ecdf;border-color:var(--line);color:var(--ink-soft)}\n.c-focus{box-shadow:0 0 0 2px var(--coral);animation:ripple 2.6s ease-in-out infinite}\n@keyframes ripple{0%,100%{box-shadow:0 0 0 2px var(--coral)}50%{box-shadow:0 0 0 4px rgba(229,103,63,.25)}}\n\n/* wave divider */\n.wave{display:block;width:100%;height:70px;margin-top:-40px}\n\n/* ---------- logos strip ---------- */\n.strip{background:var(--teal);color:#eaf5f2;padding:34px 0}\n.strip .wrap{display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap}\n.strip p{font-size:13px;letter-spacing:.1em;text-transform:uppercase;opacity:.75;font-weight:600}\n.strip .logos{display:flex;gap:40px;flex-wrap:wrap;align-items:center;opacity:.9}\n.strip .logos span{font-family:var(--serif);font-size:19px;font-style:italic}\n\n/* ---------- features ---------- */\n.section{padding:100px 0}\n.section-head{max-width:640px;margin-bottom:56px}\n.section-head h2{font-size:clamp(30px,3.6vw,44px)}\n.section-head p{margin-top:14px;font-size:18px;color:var(--ink-soft)}\n.features{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}\n.card{\n  background:var(--foam);border:1px solid var(--line);border-radius:var(--radius);\n  padding:30px 26px;transition:transform .25s ease, box-shadow .25s ease;\n}\n.card:hover{transform:translateY(-5px);box-shadow:0 18px 40px -18px rgba(18,51,58,.25)}\n.card .icon{\n  width:46px;height:46px;border-radius:12px;display:grid;place-items:center;margin-bottom:20px;\n  background:#e3efec;color:var(--teal);\n}\n.card:nth-child(2) .icon{background:var(--coral-soft);color:var(--coral)}\n.card:nth-child(3) .icon{background:#f2ecdf;color:#8a6b2f}\n.card h3{font-size:21px;margin-bottom:10px}\n.card p{font-size:15px;color:var(--ink-soft)}\n\n/* ---------- how it works ---------- */\n.how{background:var(--foam);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}\n.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:0;counter-reset:step}\n.step{padding:0 34px;position:relative}\n.step + .step{border-left:1px solid var(--line)}\n.step .num{\n  font-family:var(--serif);font-style:italic;font-size:52px;color:var(--teal);\n  line-height:1;margin-bottom:16px;opacity:.85;\n}\n.step h3{font-size:21px;margin-bottom:10px}\n.step p{font-size:15px;color:var(--ink-soft)}\n\n/* ---------- quote ---------- */\n.quote{padding:100px 0;text-align:center}\n.quote blockquote{\n  font-family:var(--serif);font-style:italic;font-weight:400;\n  font-size:clamp(24px,3vw,34px);max-width:760px;margin:0 auto;line-height:1.4;\n}\n.quote blockquote em{color:var(--coral)}\n.quote .who{margin-top:26px;display:flex;align-items:center;justify-content:center;gap:14px;color:var(--ink-soft);font-size:15px}\n.avatar{\n  width:44px;height:44px;border-radius:50%;display:grid;place-items:center;\n  background:var(--teal);color:#fff;font-weight:600;font-size:15px;\n}\n\n/* ---------- CTA ---------- */\n.cta{\n  background:var(--teal-deep);color:#fff;border-radius:26px;\n  padding:72px 48px;text-align:center;position:relative;overflow:hidden;\n}\n.cta::before,.cta::after{\n  content:\"\";position:absolute;border-radius:50%;filter:blur(2px);\n}\n.cta::before{width:340px;height:340px;background:radial-gradient(circle, rgba(255,255,255,.07), transparent 70%);top:-140px;left:-100px}\n.cta::after{width:280px;height:280px;background:radial-gradient(circle, rgba(229,103,63,.35), transparent 70%);bottom:-140px;right:-80px}\n.cta h2{font-size:clamp(30px,3.6vw,44px);position:relative;z-index:1}\n.cta p{margin:16px auto 32px;max-width:46ch;opacity:.85;font-size:17px;position:relative;z-index:1}\n.cta .btn-primary{background:var(--coral);box-shadow:0 2px 0 #b34e2c;position:relative;z-index:1}\n.cta .btn-primary:hover{background:#d05a34;box-shadow:0 8px 20px rgba(0,0,0,.25)}\n.cta small{display:block;margin-top:16px;opacity:.6;font-size:13px;position:relative;z-index:1}\n\n/* ---------- footer ---------- */\nfooter{padding:56px 0 40px;color:var(--ink-soft)}\n.foot{display:flex;justify-content:space-between;align-items:flex-start;gap:32px;flex-wrap:wrap;border-top:1px solid var(--line);padding-top:40px}\n.foot .logo{color:var(--ink)}\n.foot-links{display:flex;gap:56px;flex-wrap:wrap}\n.foot-links h5{font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink);margin-bottom:12px}\n.foot-links a{display:block;font-size:14px;margin-bottom:8px;transition:color .2s}\n.foot-links a:hover{color:var(--teal)}\n.foot-bottom{margin-top:40px;font-size:13px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px}\n\n/* ---------- responsive ---------- */\n@media(max-width:920px){\n  .hero-grid{grid-template-columns:1fr;gap:48px}\n  .features,.steps{grid-template-columns:1fr}\n  .step{padding:0 0 40px}\n  .step + .step{border-left:none;border-top:1px solid var(--line);padding-top:40px}\n  .mock-week{grid-template-columns:repeat(2,1fr)}\n  .nav-links{display:none}\n  .cta{padding:56px 28px}\n}\n</style>\n</head>\n<body>\n\n<header>\n  <div class=\"wrap nav\">\n    <a href=\"#\" class=\"logo\">\n      <svg width=\"28\" height=\"28\" viewBox=\"0 0 28 28\" fill=\"none\" aria-hidden=\"true\">\n        <circle cx=\"14\" cy=\"14\" r=\"12.5\" stroke=\"#0e6e6b\" stroke-width=\"2.4\"/>\n        <path d=\"M3 16c3.5-4 6.5 3 10-1s5.5 3 11-1\" stroke=\"#e5673f\" stroke-width=\"2.4\" stroke-linecap=\"round\"/>\n      </svg>\n      Tidepool\n    </a>\n    <nav class=\"nav-links\">\n      <a href=\"#features\">Features</a>\n      <a href=\"#how\">How it works</a>\n      <a href=\"#teams\">Teams</a>\n      <a href=\"#pricing\">Pricing</a>\n    </nav>\n    <div class=\"nav-cta\">\n      <a href=\"#\" class=\"btn btn-ghost\">Sign in</a>\n      <a href=\"#cta\" class=\"btn btn-primary\">Start free</a>\n    </div>\n  </div>\n</header>\n\n<section class=\"hero\">\n  <div class=\"wrap hero-grid\">\n    <div>\n      <span class=\"eyebrow\"><span class=\"dot\"></span> Built for teams of 3\u201312</span>\n      <h1>Plan your week together, <em>like water finding its level</em>.</h1>\n      <p class=\"lede\">Tidepool turns Monday-morning chaos into a shared, living weekly plan. One board, fifteen minutes, everyone aligned \u2014 no status meetings required.</p>\n      <div class=\"hero-actions\">\n        <a href=\"#cta\" class=\"btn btn-primary\">Start your first week \u2014 free</a>\n        <a href=\"#how\" class=\"btn btn-ghost\">See how it works \u2192</a>\n      </div>\n      <p class=\"hero-note\">No credit card \u00b7 Set up in under 3 minutes</p>\n    </div>\n\n    <div class=\"mock\" aria-label=\"Product preview of a weekly planning board\">\n      <div class=\"mock-bar\">\n        <span class=\"r\"></span><span class=\"y\"></span><span class=\"g\"></span>\n        <span class=\"title\">Tidepool \u2014 Week of Oct 14 \u00b7 Fern &amp; Co.</span>\n      </div>\n      <div class=\"mock-body\">\n        <div class=\"mock-week\">\n          <div class=\"day\">\n            <h4>Mon <small>3 tasks</small></h4>\n            <div class=\"chip c-teal\"><b>Maya</b>Ship pricing page</div>\n            <div class=\"chip c-sand\"><b>Jonas</b>Q4 metrics review</div>\n          </div>\n          <div class=\"day\">\n            <h4>Tue <small>2 tasks</small></h4>\n            <div class=\"chip c-focus c-coral\"><b>Team</b>Weekly sync \u00b7 9:30</div>\n            <div class=\"chip c-teal\"><b>Priya</b>Draft onboarding emails</div>\n          </div>\n          <div class=\"day\">\n            <h4>Wed <small>4 tasks</small></h4>\n            <div class=\"chip c-sand\"><b>Jonas</b>Customer calls \u00d73</div>\n            <div class=\"chip c-teal\"><b>Maya</b>Fix signup bug</div>\n          </div>\n          <div class=\"day\">\n            <h4>Thu <small>2 tasks</small></h4>\n            <div class=\"chip c-teal\"><b>Priya</b>Landing copy v2</div>\n            <div class=\"chip c-sand\"><b>Maya</b>1:1 with Jonas</div>\n          </div>\n          <div class=\"day\">\n            <h4>Fri <small>1 task</small></h4>\n            <div class=\"chip c-coral\"><b>Team</b>Retro &amp; wins \ud83c\udf89</div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <svg class=\"wave\" viewBox=\"0 0 1440 90\" preserveAspectRatio=\"none\" aria-hidden=\"true\">\n    <path d=\"M0,50 C240,95 480,5 720,45 C960,85 1200,15 1440,55 L1440,90 L0,90 Z\" fill=\"#0e6e6b\"/>\n  </svg>\n</section>\n\n<section class=\"strip\">\n  <div class=\"wrap\">\n    <p>Trusted by small teams at</p>\n    <div class=\"logos\">\n      <span>Fern &amp; Co.</span>\n      <span>Harborlight</span>\n      <span>Studio Mollusk</span>\n      <span>Driftworks</span>\n      <span>Kelp Lab</span>\n    </div>\n  </div>\n</section>\n\n<section class=\"section\" id=\"features\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <h2>Everything a small week needs, nothing it doesn't.</h2>\n      <p>Tidepool isn't another project manager. It's a weekly rhythm your team will actually keep.</p>\n    </div>\n    <div class=\"features\">\n      <div class=\"card\">\n        <div class=\"icon\">\n          <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"17\" rx=\"2\"/><path d=\"M3 9h18M8 2v4M16 2v4\"/></svg>\n        </div>\n        <h3>One shared board</h3>\n        <p>Everyone's week on a single screen. See who's doing what at a glance, spot overload before it happens, and rebalance in seconds.</p>\n      </div>\n      <div class=\"card\">\n        <div class=\"icon\">\n          <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 12a9 9 0 1 1-9-9\"/><path d=\"M21 3l-9 9\"/></svg>\n        </div>\n        <h3>Friday auto-retro</h3>\n        <p>When the week closes, Tidepool collects what shipped, what slipped, and why \u2014 so next Monday starts with context, not archaeology.</p>\n      </div>\n      <div class=\"card\">\n        <div class=\"icon\">\n          <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75\"/></svg>\n        </div>\n        <h3>Async check-ins</h3>\n        <p>A gentle Monday prompt \u2014 one question, two minutes. Plans update themselves from answers, and the weekly meeting shrinks to 15 minutes.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"section how\" id=\"how\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <h2>A rhythm, not a ritual.</h2>\n      <p>Three small moments a week. That's the whole system.</p>\n    </div>\n    <div class=\"steps\">\n      <div class=\"step\">\n        <div class=\"num\">01</div>\n        <h3>Monday: set the tide</h3>\n        <p>Answer one prompt, drag your priorities onto the board. Your teammates' plans appear as you type.</p>\n      </div>\n      <div class=\"step\">\n        <div class=\"num\">02</div>\n        <h3>Midweek: let it flow</h3>\n        <p>Tasks shift, blockers surface automatically, and Tidepool nudges the right person \u2014 never the whole team.</p>\n      </div>\n      <div class=\"step\">\n        <div class=\"num\">03</div>\n        <h3>Friday: read the water</h3>\n        <p>A five-minute recap lands in Slack. Wins celebrated, carryovers rolled forward, next week half-written.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"quote\" id=\"teams\">\n  <div class=\"wrap\">\n    <blockquote>\n      \u201cWe killed our Monday standup three weeks after switching. Now everyone just <em>knows</em> the plan \u2014 it's the calmest our team has ever been.\u201d\n    </blockquote>\n    <div class=\"who\">\n      <div class=\"avatar\">MP</div>\n      <div><b>Maya Park</b> \u00b7 Co-founder, Fern &amp; Co. \u2014 a team of 7</div>\n    </div>\n  </div>\n</section>\n\n<section class=\"section\" id=\"pricing\" style=\"padding-top:0\">\n  <div class=\"wrap\">\n    <div class=\"cta\" id=\"cta\">\n      <h2>Your best week is one Monday away.</h2>\n      <p>Free for teams up to 5, forever. Pro unlocks retros, integrations, and unlimited history at $4 per person per month.</p>\n      <a href=\"#\" class=\"btn btn-primary\">Start free \u2014 invite your team</a>\n      <small>No credit card \u00b7 Cancel anytime \u00b7 Your data stays yours</small>\n    </div>\n  </div>\n</section>\n\n<footer>\n  <div class=\"wrap\">\n    <div class=\"foot\">\n      <div>\n        <a href=\"#\" class=\"logo\">\n          <svg width=\"24\" height=\"24\" viewBox=\"0 0 28 28\" fill=\"none\" aria-hidden=\"true\">\n            <circle cx=\"14\" cy=\"14\" r=\"12.5\" stroke=\"#0e6e6b\" stroke-width=\"2.4\"/>\n            <path d=\"M3 16c3.5-4 6.5 3 10-1s5.5 3 11-1\" stroke=\"#e5673f\" stroke-width=\"2.4\" stroke-linecap=\"round\"/>\n          </svg>\n          Tidepool\n        </a>\n        <p style=\"font-size:14px;margin-top:12px;max-width:30ch\">Weekly planning that flows, for teams that ship.</p>\n      </div>\n      <div class=\"foot-links\">\n        <div>\n          <h5>Product</h5>\n          <a href=\"#features\">Features</a>\n          <a href=\"#pricing\">Pricing</a>\n          <a href=\"#\">Changelog</a>\n        </div>\n        <div>\n          <h5>Company</h5>\n          <a href=\"#\">About</a>\n          <a href=\"#\">Blog</a>\n          <a href=\"#\">Careers</a>\n        </div>\n        <div>\n          <h5>Support</h5>\n          <a href=\"#\">Help center</a>\n          <a href=\"#\">Privacy</a>\n          <a href=\"#\">Terms</a>\n        </div>\n      </div>\n    </div>\n    <div class=\"foot-bottom\">\n      <span>\u00a9 2025 Tidepool, Inc.</span>\n      <span>Made carefully, on the coast.</span>\n    </div>\n  </div>\n</footer>\n\n</body>\n</html>\n"}