radient(ellipse at 10% 20%, rgba(255,255,255,.78) 0, transparent 37%),\n        radial-gradient(ellipse at 85% 5%, rgba(230,222,204,.20) 0, transparent 30%),\n        repeating-linear-gradient(0deg, rgba(93, 83, 56, .017) 0, rgba(93, 83, 56, .017) 1px, transparent 1px, transparent 4px);\n      font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      -webkit-font-smoothing: antialiased;\n    }\n\n    a {\n      color: inherit;\n      text-decoration: none;\n    }\n\n    button {\n      font: inherit;\n    }\n\n    .page-shell {\n      width: min(1180px, calc(100% - 56px));\n      margin: 0 auto;\n    }\n\n    .site-header {\n      height: 86px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      border-bottom: 1px solid rgba(70, 78, 67, .11);\n      position: relative;\n      z-index: 2;\n    }\n\n    .brand {\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      font-size: 21px;\n      font-weight: 750;\n      letter-spacing: -1px;\n    }\n\n    .brand-mark {\n      display: grid;\n      place-items: center;\n      width: 35px;\n      height: 35px;\n      border-radius: 12px 10px 13px 9px;\n      background: var(--ink);\n      transform: rotate(-5deg);\n    }\n\n    .brand-mark svg {\n      width: 24px;\n      height: 24px;\n    }\n\n    .nav-links {\n      display: flex;\n      align-items: center;\n      gap: 34px;\n      color: #59645d;\n      font-size: 14px;\n      font-weight: 550;\n    }\n\n    .nav-links a:hover {\n      color: var(--coral-dark);\n    }\n\n    .nav-cta {\n      padding: 11px 17px;\n      border: 1px solid rgba(35, 51, 46, .22);\n      border-radius: 8px 10px 9px 7px;\n      color: var(--ink);\n      background: rgba(255,255,255,.34);\n      transition: .2s ease;\n    }\n\n    .nav-cta:hover {\n      background: var(--ink);\n      color: white;\n      border-color: var(--ink);\n    }\n\n    .hero {\n      min-height: 638px;\n      padding: 69px 0 76px;\n      display: grid;\n      grid-template-columns: .91fr 1.09fr;\n      align-items: center;\n      gap: 54px;\n    }\n\n    .hero-copy {\n      position: relative;\n      z-index: 1;\n      padding-bottom: 7px;\n    }\n\n    .eyebrow {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      color: #58675d;\n      background: rgba(255,255,255,.48);\n      border: 1px solid rgba(50, 75, 58, .12);\n      padding: 8px 12px;\n      border-radius: 20px 17px 21px 18px;\n      font-size: 12px;\n      font-weight: 700;\n      letter-spacing: .035em;\n      text-transform: uppercase;\n    }\n\n    .eyebrow-dot {\n      width: 7px;\n      height: 7px;\n      display: inline-block;\n      border-radius: 50%;\n      background: #6e9a75;\n      box-shadow: 0 0 0 3px rgba(110, 154, 117, .14);\n    }\n\n    h1 {\n      margin: 22px 0 19px;\n      max-width: 550px;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: clamp(50px, 6.1vw, 76px);\n      line-height: .99;\n      letter-spacing: -4.3px;\n      font-weight: 500;\n    }\n\n    .headline-mark {\n      position: relative;\n      display: inline-block;\n      white-space: nowrap;\n    }\n\n    .headline-mark::after {\n      content: \"\";\n      position: absolute;\n      height: 9px;\n      left: 1px;\n      right: -5px;\n      bottom: 1px;\n      z-index: -1;\n      border-radius: 60% 35% 50% 30%;\n      background: #efc875;\n      transform: rotate(-1.5deg);\n      opacity: .82;\n    }\n\n    .hero-copy > p {\n      max-width: 440px;\n      margin: 0;\n      color: #65716a;\n      font-size: 17px;\n      line-height: 1.68;\n    }\n\n    .hero-actions {\n      display: flex;\n      align-items: center;\n      gap: 18px;\n      margin-top: 29px;\n    }\n\n    .button-primary {\n      display: inline-flex;\n      align-items: center;\n      gap: 11px;\n      padding: 14px 18px 14px 20px;\n      border-radius: 9px 11px 8px 10px;\n      color: #fffdf7;\n      background: var(--ink);\n      box-shadow: 0 5px 0 rgba(35, 51, 46, .12);\n      font-size: 14px;\n      font-weight: 700;\n      transition: transform .2s ease, background .2s ease;\n    }\n\n    .button-primary:hover {\n      transform: translateY(-2px) rotate(-.5deg);\n      background: #314b40;\n    }\n\n    .button-primary svg {\n      width: 16px;\n      height: 16px;\n    }\n\n    .quiet-note {\n      color: #7a8079;\n      font-size: 12px;\n    }\n\n    .proof-line {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      margin-top: 32px;\n      color: #717a72;\n      font-size: 12px;\n    }\n\n    .avatar-stack {\n      display: flex;\n      padding-left: 3px;\n    }\n\n    .avatar {\n      width: 27px;\n      height: 27px;\n      margin-left: -4px;\n      display: grid;\n      place-items: center;\n      border: 2px solid var(--paper);\n      border-radius: 50%;\n      color: #31433a;\n      font-size: 9px;\n      font-weight: 800;\n    }\n\n    .avatar:nth-child(1) { background: #e8b9a4; }\n    .avatar:nth-child(2) { background: #b5c9b1; }\n    .avatar:nth-child(3) { background: #edcf7d; }\n    .avatar:nth-child(4) { background: #b6ced1; }\n\n    .proof-line strong {\n      color: #38473e;\n      font-weight: 700;\n    }\n\n    /* The planning board */\n    .hero-art {\n      min-width: 0;\n      position: relative;\n      padding: 21px 8px 22px 20px;\n    }\n\n    .board {\n      position: relative;\n      padding: 21px 21px 19px;\n      border: 1px solid rgba(78, 79, 63, .12);\n      border-radius: 12px 10px 13px 9px;\n      background-color: #fffdf8;\n      background-image:\n        repeating-linear-gradient(0deg, transparent 0, transparent 31px, rgba(134, 157, 151, .105) 31px, rgba(134, 157, 151, .105) 32px);\n      box-shadow: var(--shadow), 0 2px 3px rgba(42, 55, 43, .04);\n      transform: rotate(1.2deg);\n    }\n\n    .board::before {\n      content: \"\";\n      position: absolute;\n      inset: 7px;\n      border: 1px solid rgba(97, 103, 78, .075);\n      border-radius: 8px;\n      pointer-events: none;\n    }\n\n    .board-top {\n      display: flex;\n      justify-content: space-between;\n      align-items: flex-start;\n      margin-bottom: 18px;\n      position: relative;\n    }\n\n    .board-title {\n      display: flex;\n      align-items: center;\n      gap: 9px;\n    }\n\n    .board-spark {\n      width: 29px;\n      height: 29px;\n      display: grid;\n      place-items: center;\n      color: #fff;\n      background: #6e9381;\n      border-radius: 50% 46% 48% 43%;\n      transform: rotate(-9deg);\n    }\n\n    .board-spark svg {\n      width: 17px;\n      height: 17px;\n    }\n\n    .board-title h2 {\n      margin: 0;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: 20px;\n      font-weight: 500;\n      letter-spacing: -.5px;\n    }\n\n    .board-title small {\n      display: block;\n      margin-top: 3px;\n      color: #899087;\n      font-size: 10px;\n    }\n\n    .week-pill {\n      padding: 7px 10px;\n      border: 1px solid #e8e3d9;\n      border-radius: 7px;\n      color: #748077;\n      background: rgba(255,255,255,.72);\n      font-size: 10px;\n      font-weight: 650;\n    }\n\n    .board-members {\n      display: flex;\n      align-items: center;\n      margin: 0 1px 15px;\n      padding-bottom: 13px;\n      border-bottom: 1px dashed #dddcd2;\n    }\n\n    .member {\n      display: flex;\n      align-items: center;\n      gap: 6px;\n      margin-right: 15px;\n      color: #68726b;\n      font-size: 10px;\n    }\n\n    .member-dot {\n      width: 9px;\n      height: 9px;\n      border-radius: 50%;\n    }\n\n    .dot-olive { background: #77a07d; }\n    .dot-coral { background: #df9074; }\n    .dot-blue { background: #88abb1; }\n\n    .invite {\n      margin-left: auto;\n      color: #a0a49b;\n      font-size: 10px;\n    }\n\n    .week-grid {\n      display: grid;\n      grid-template-columns: repeat(5, 1fr);\n      gap: 9px;\n      position: relative;\n    }\n\n    .day-column {\n      min-width: 0;\n    }\n\n    .day-heading {\n      padding: 0 3px 8px;\n      display: flex;\n      justify-content: space-between;\n      color: #7c857c;\n      font-size: 9px;\n      font-weight: 750;\n      letter-spacing: .065em;\n      text-transform: uppercase;\n    }\n\n    .day-heading span:last-child {\n      color: #adb1a7;\n      font-weight: 500;\n    }\n\n    .task {\n      min-height: 60px;\n      margin-bottom: 8px;\n      padding: 8px 8px 7px;\n      border: 1px solid rgba(65, 73, 57, .08);\n      border-radius: 5px 7px 5px 6px;\n      box-shadow: 0 2px 4px rgba(50, 57, 43, .045);\n      font-size: 9px;\n      line-height: 1.35;\n      color: #405047;\n      position: relative;\n    }\n\n    .task strong {\n      display: block;\n      margin-bottom: 6px;\n      font-size: 9px;\n      line-height: 1.3;\n      font-weight: 700;\n    }\n\n    .task small {\n      display: flex;\n      align-items: center;\n      gap: 4px;\n      color: #788078;\n      font-size: 8px;\n    }\n\n    .task small i {\n      display: inline-block;\n      width: 6px;\n      height: 6px;\n      border-radius: 50%;\n      background: currentColor;\n      opacity: .7;\n    }\n\n    .task.mint { background: #edf3e9; transform: rotate(-.8deg); }\n    .task.peach { background: #fae9df; transform: rotate(.7deg); }\n    .task.blue { background: #e8f0f0; transform: rotate(-.5deg); }\n    .task.yellow { background: #f9f0d7; transform: rotate(.9deg); }\n    .task.lilac { background: #efedf4; transform: rotate(-.6deg); }\n    .task.white { background: #fffefa; }\n    .task.empty {\n      min-height: 43px;\n      background: rgba(255,255,255,.28);\n      border: 1px dashed #deded3;\n      box-shadow: none;\n    }\n\n    .board-bottom {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      margin-top: 9px;\n      padding-top: 12px;\n      border-top: 1px dashed #deded4;\n      color: #899087;\n      font-size: 9px;\n    }\n\n    .board-bottom strong {\n      color: #64836d;\n      font-weight: 700;\n    }\n\n    .hand-note {\n      position: absolute;\n      z-index: 1;\n      color: #bd644f;\n      font-family: \"Comic Sans MS\", \"Segoe Print\", cursive;\n      font-size: 14px;\n      line-height: 1.2;\n      transform: rotate(-9deg);\n    }\n\n    .note-left {\n      left: -10px;\n      top: 79px;\n    }\n\n    .note-left svg {\n      position: absolute;\n      top: 24px;\n      right: -29px;\n      width: 34px;\n      height: 24px;\n      overflow: visible;\n    }\n\n    .note-right {\n      right: -8px;\n      bottom: 58px;\n      color: #658879;\n      transform: rotate(7deg);\n    }\n\n    .note-right svg {\n      width: 31px;\n      height: 25px;\n      position: absolute;\n      top: -18px;\n      left: -28px;\n    }\n\n    .tape {\n      position: absolute;\n      z-index: 2;\n      width: 71px;\n      height: 19px;\n      top: 8px;\n      right: 21%;\n      background: rgba(233, 199, 126, .63);\n      transform: rotate(5deg);\n      clip-path: polygon(3% 8%, 100% 0, 96% 90%, 0 100%);\n    }\n\n    .benefits {\n      padding: 31px 0 35px;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      gap: 45px;\n      border-top: 1px solid rgba(70, 78, 67, .12);\n      border-bottom: 1px solid rgba(70, 78, 67, .12);\n    }\n\n    .benefit {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      color: #59665d;\n      font-size: 13px;\n      font-weight: 600;\n    }\n\n    .benefit-icon {\n      width: 31px;\n      height: 31px;\n      display: grid;\n      place-items: center;\n      border-radius: 9px 7px 10px 8px;\n      background: #e9eee4;\n      color: #5c8068;\n    }\n\n    .benefit:nth-child(2) .benefit-icon {\n      background: #f8e7dc;\n      color: #c2765e;\n    }\n\n    .benefit:nth-child(3) .benefit-icon {\n      background: #e4edef;\n      color: #668e96;\n    }\n\n    .benefit-icon svg {\n      width: 16px;\n      height: 16px;\n    }\n\n    .section-intro {\n      max-width: 570px;\n      margin: 0 auto 35px;\n      text-align: center;\n    }\n\n    .section-intro .eyebrow {\n      margin-bottom: 13px;\n    }\n\n    .section-intro h2 {\n      margin: 0 0 11px;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: 39px;\n      font-weight: 500;\n      letter-spacing: -1.7px;\n    }\n\n    .section-intro p {\n      margin: 0;\n      color: #727b73;\n      font-size: 15px;\n      line-height: 1.65;\n    }\n\n    .how-it-works {\n      padding: 81px 0 88px;\n    }\n\n    .steps {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 17px;\n    }\n\n    .step-card {\n      min-height: 196px;\n      padding: 22px 23px 21px;\n      border: 1px solid rgba(73, 79, 64, .11);\n      border-radius: 10px 13px 9px 12px;\n      background: rgba(255, 253, 248, .55);\n      position: relative;\n    }\n\n    .step-card:nth-child(2) {\n      transform: rotate(.6deg);\n      background: rgba(235, 241, 232, .72);\n    }\n\n    .step-card:nth-child(3) {\n      transform: rotate(-.5deg);\n      background: rgba(250, 235, 225, .62);\n    }\n\n    .step-number {\n      width: 31px;\n      height: 31px;\n      display: grid;\n      place-items: center;\n      margin-bottom: 20px;\n      border-radius: 50%;\n      color: #fff;\n      background: #72927a;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: 15px;\n    }\n\n    .step-card:nth-child(2) .step-number { background: #d28a70; }\n    .step-card:nth-child(3) .step-number { background: #7b9ea4; }\n\n    .step-card h3 {\n      margin: 0 0 8px;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: 20px;\n      font-weight: 500;\n    }\n\n    .step-card p {\n      max-width: 290px;\n      margin: 0;\n      color: #737c73;\n      font-size: 13px;\n      line-height: 1.6;\n    }\n\n    .closing {\n      margin-bottom: 70px;\n      padding: 39px 42px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 24px;\n      color: #f8f5ea;\n      background: #344b40;\n      border-radius: 12px 16px 11px 14px;\n      position: relative;\n      overflow: hidden;\n    }\n\n    .closing::after {\n      content: \"\";\n      position: absolute;\n      width: 300px;\n      height: 300px;\n      right: 20%;\n      top: -220px;\n      border: 1px solid rgba(255,255,255,.09);\n      border-radius: 50%;\n      box-shadow: 0 0 0 27px rgba(255,255,255,.025), 0 0 0 55px rgba(255,255,255,.02);\n    }\n\n    .closing h2 {\n      position: relative;\n      z-index: 1;\n      max-width: 510px;\n      margin: 0;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-weight: 500;\n      font-size: 32px;\n      letter-spacing: -.8px;\n    }\n\n    .closing p {\n      margin: 8px 0 0;\n      color: #c5d0c4;\n      font-size: 13px;\n    }\n\n    .closing .button-primary {\n      flex: none;\n      position: relative;\n      z-index: 1;\n      color: var(--ink);\n      background: #f4d992;\n      box-shadow: 0 4px 0 rgba(13, 29, 22, .12);\n    }\n\n    .closing .button-primary:hover {\n      background: #ffe4a0;\n    }\n\n    footer {\n      min-height: 73px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      color: #899087;\n      font-size: 11px;\n    }\n\n    footer .brand {\n      color: #536258;\n      font-size: 16px;\n    }\n\n    footer .brand-mark {\n      width: 27px;\n      height: 27px;\n      border-radius: 9px;\n    }\n\n    footer .brand-mark svg {\n      width: 19px;\n      height: 19px;\n    }\n\n    .footer-links {\n      display: flex;\n      gap: 21px;\n    }\n\n    .footer-links a:hover {\n      color: var(--coral-dark);\n    }\n\n    @media (max-width: 900px) {\n      .hero {\n        grid-template-columns: 1fr;\n        gap: 28px;\n        padding-top: 58px;\n      }\n\n      .hero-copy {\n        max-width: 660px;\n      }\n\n      .hero-art {\n        width: min(660px, 100%);\n        margin: 0 auto;\n      }\n\n      .benefits {\n        gap: 22px;\n      }\n\n      .benefit {\n        font-size: 12px;\n      }\n    }\n\n    @media (max-width: 620px) {\n      .page-shell {\n        width: min(100% - 36px, 500px);\n      }\n\n      .site-header {\n        height: 72px;\n      }\n\n      .nav-links {\n        gap: 0;\n      }\n\n      .nav-links a:not(.nav-cta) {\n        display: none;\n      }\n\n      .nav-cta {\n        padding: 9px 12px;\n        font-size: 12px;\n      }\n\n      .hero {\n        min-height: auto;\n        padding: 49px 0 48px;\n        gap: 25px;\n      }\n\n      h1 {\n        font-size: clamp(47px, 12vw, 64px);\n        letter-spacing: -3px;\n      }\n\n      .hero-copy > p {\n        font-size: 15px;\n      }\n\n      .hero-actions {\n        align-items: flex-start;\n        flex-direction: column;\n        gap: 10px;\n      }\n\n      .proof-line {\n        margin-top: 24px;\n      }\n\n      .hero-art {\n        padding: 19px 0 16px;\n      }\n\n      .board {\n        padding: 17px 12px 14px;\n      }\n\n      .board-title h2 {\n        font-size: 17px;\n      }\n\n      .week-grid {\n        gap: 5px;\n      }\n\n      .day-heading {\n        font-size: 8px;\n      }\n\n      .task {\n        min-height: 58px;\n        padding: 7px 5px 6px;\n      }\n\n      .task strong {\n        font-size: 8px;\n      }\n\n      .task small {\n        font-size: 7px;\n      }\n\n      .member {\n        margin-right: 9px;\n        font-size: 9px;\n      }\n\n      .invite {\n        font-size: 9px;\n      }\n\n      .hand-note {\n        font-size: 11px;\n      }\n\n      .note-left {\n        left: -1px;\n        top: 4px;\n      }\n\n      .note-right {\n        right: 1px;\n        bottom: -1px;\n      }\n\n      .benefits {\n        padding: 20px 0;\n        display: grid;\n        grid-template-columns: 1fr;\n        gap: 13px;\n        width: fit-content;\n        margin: 0 auto;\n        border: 0;\n      }\n\n      .benefit-icon {\n        width: 27px;\n        height: 27px;\n      }\n\n      .how-it-works {\n        padding: 51px 0 59px;\n      }\n\n      .section-intro h2 {\n        font-size: 33px;\n      }\n\n      .steps {\n        grid-template-columns: 1fr;\n        gap: 12px;\n      }\n\n      .step-card {\n        min-height: auto;\n        padding: 19px;\n      }\n\n      .step-number {\n        margin-bottom: 13px;\n      }\n\n      .closing {\n        margin-bottom: 38px;\n        padding: 28px 23px;\n        align-items: flex-start;\n        flex-direction: column;\n      }\n\n      .closing h2 {\n        font-size: 28px;\n      }\n\n      footer {\n        gap: 12px;\n        flex-wrap: wrap;\n        padding: 14px 0;\n      }\n\n      .footer-links {\n        gap: 13px;\n      }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      html { scroll-behavior: auto; }\n      *, *::before, *::after { transition-duration: .01ms !important; }\n    }\n  </style>\n</head>\n<body>\n  <header class=\"site-header page-shell\">\n    <a class=\"brand\" href=\"#\" aria-label=\"Tidepool home\">\n      <span class=\"brand-mark\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 28 28\" fill=\"none\">\n          <path d=\"M4 11.2c2.1-2.2 4.2-2.2 6.3 0s4.2 2.2 6.3 0 4.2-2.2 6.3 0\" stroke=\"#F7F4EC\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n          <path d=\"M4 16.6c2.1-2.2 4.2-2.2 6.3 0s4.2 2.2 6.3 0 4.2-2.2 6.3 0\" stroke=\"#F7F4EC\" stroke-width=\"2\" stroke-linecap=\"round\" opacity=\".76\"/>\n        </svg>\n      </span>\n      tidepool\n    </a>\n    <nav class=\"nav-links\" aria-label=\"Main navigation\">\n      <a href=\"#how-it-works\">How it works</a>\n      <a href=\"#why-tidepool\">Why Tidepool</a>\n      <a class=\"nav-cta\" href=\"#get-started\">Get started <span aria-hidden=\"true\">\u2197</span></a>\n    </nav>\n  </header>\n\n  <main>\n    <section class=\"hero page-shell\">\n      <div class=\"hero-copy\">\n        <div class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> A calmer kind of teamwork</div>\n        <h1>Make room for a <span class=\"headline-mark\">good week.</span></h1>\n        <p>Tidepool gives your small team one friendly place to figure out what matters, share the load, and make a plan that feels doable.</p>\n        <div class=\"hero-actions\">\n          <a class=\"button-primary\" href=\"#get-started\">\n            Plan your week together\n            <svg viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\">\n              <path d=\"M4 10h11M10 5l5 5-5 5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            </svg>\n          </a>\n          <span class=\"quiet-note\">Free for small teams \u00b7 No card needed</span>\n        </div>\n        <div class=\"proof-line\">\n          <div class=\"avatar-stack\" aria-hidden=\"true\">\n            <span class=\"avatar\">AM</span><span class=\"avatar\">JL</span><span class=\"avatar\">SK</span><span class=\"avatar\">+</span>\n          </div>\n          <span><strong>Less \u201cwho\u2019s doing that?\u201d</strong> More \u201cwe\u2019ve got this.\u201d</span>\n        </div>\n      </div>\n\n      <div class=\"hero-art\" aria-label=\"Preview of a team's shared weekly planning board\">\n        <div class=\"hand-note note-left\">\n          the whole week,<br />in one place\n          <svg viewBox=\"0 0 40 28\" fill=\"none\" aria-hidden=\"true\">\n            <path d=\"M2 3c11 0 15 6 17 14 1 4 5 7 12 7\" stroke=\"#BD644F\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\n            <path d=\"m26 20 6 4-6 2\" stroke=\"#BD644F\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          </svg>\n        </div>\n        <div class=\"tape\" aria-hidden=\"true\"></div>\n        <div class=\"board\">\n          <div class=\"board-top\">\n            <div class=\"board-title\">\n              <span class=\"board-spark\" aria-hidden=\"true\">\n                <svg viewBox=\"0 0 20 20\" fill=\"none\">\n                  <path d=\"M10 2.5v15M2.5 10h15M4.7 4.7l10.6 10.6m0-10.6L4.7 15.3\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\"/>\n                </svg>\n              </span>\n              <div>\n                <h2>Studio week</h2>\n                <small>A little plan, made together</small>\n              </div>\n            </div>\n            <span class=\"week-pill\">MAY 13 \u2013 17&nbsp; \u25be</span>\n          </div>\n\n          <div class=\"board-members\">\n            <span class=\"member\"><i class=\"member-dot dot-olive\"></i> Alex</span>\n            <span class=\"member\"><i class=\"member-dot dot-coral\"></i> Jamie</span>\n            <span class=\"member\"><i class=\"member-dot dot-blue\"></i> Sam</span>\n            <span class=\"invite\">+ invite your people</span>\n          </div>\n\n          <div class=\"week-grid\">\n            <div class=\"day-column\">\n              <div class=\"day-heading\"><span>Mon</span><span>13</span></div>\n              <div class=\"task mint\"><strong>Set our weekly focus</strong><small><i></i> Alex</small></div>\n              <div class=\"task peach\"><strong>Sketch first ideas</strong><small><i></i> Jamie</small></div>\n              <div class=\"task empty\"></div>\n            </div>\n            <div class=\"day-column\">\n              <div class=\"day-heading\"><span>Tue</span><span>14</span></div>\n              <div class=\"task yellow\"><strong>Customer chats</strong><small><i></i> Sam + Alex</small></div>\n              <div class=\"task blue\"><strong>Share what we heard</strong><small><i></i> Sam</small></div>\n              <div class=\"task empty\"></div>\n            </div>\n            <div class=\"day-column\">\n              <div class=\"day-heading\"><span>Wed</span><span>15</span></div>\n              <div class=\"task peach\"><strong>Make the first draft</strong><small><i></i> Jamie</small></div>\n              <div class=\"task empty\"></div>\n              <div class=\"task mint\"><strong>Midweek check-in</strong><small><i></i> All of us</small></div>\n            </div>\n            <div class=\"day-column\">\n              <div class=\"day-heading\"><span>Thu</span><span>16</span></div>\n              <div class=\"task blue\"><strong>Build a tiny prototype</strong><small><i></i> Alex</small></div>\n              <div class=\"task lilac\"><strong>Get fresh eyes</strong><small><i></i> Sam</small></div>\n              <div class=\"task empty\"></div>\n            </div>\n            <div class=\"day-column\">\n              <div class=\"day-heading\"><span>Fri</span><span>17</span></div>\n              <div class=\"task mint\"><strong>Polish + wrap up</strong><small><i></i> Jamie</small></div>\n              <div class=\"task yellow\"><strong>Little team retro</strong><small><i></i> All of us</small></div>\n              <div class=\"task empty\"></div>\n            </div>\n          </div>\n\n          <div class=\"board-bottom\">\n            <span>\u2728&nbsp; 2 things moved forward already</span>\n            <strong>Looking good, team!</strong>\n          </div>\n        </div>\n        <div class=\"hand-note note-right\">\n          room to<br />breathe, too\n          <svg viewBox=\"0 0 35 28\" fill=\"none\" aria-hidden=\"true\">\n            <path d=\"M32 25C23 23 20 17 19 10 18 6 14 3 7 3\" stroke=\"#658879\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\n            <path d=\"m12 0-6 3 5 4\" stroke=\"#658879\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          </svg>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"benefits page-shell\" id=\"why-tidepool\" aria-label=\"Tidepool benefits\">\n      <div class=\"benefit\">\n        <span class=\"benefit-icon\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 20 20\" fill=\"none\"><path d=\"M4 5h12M4 10h8M4 15h5\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/><path d=\"m13 14 1.5 1.5L18 12\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n        </span>\n        Clear priorities, without the pile-on\n      </div>\n      <div class=\"benefit\">\n        <span class=\"benefit-icon\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 20 20\" fill=\"none\"><path d=\"M10 3v14M3 10h14\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/><circle cx=\"10\" cy=\"10\" r=\"7.2\" stroke=\"currentColor\" stroke-width=\"1.2\"/></svg>\n        </span>\n        Shared ownership, fewer surprises\n      </div>\n      <div class=\"benefit\">\n        <span class=\"benefit-icon\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 20 20\" fill=\"none\"><path d=\"M3 12c2-2.2 4-2.2 6 0s4 2.2 6 0 3-2.2 4-1\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/><path d=\"M4 6.5h12\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" opacity=\".7\"/></svg>\n        </span>\n        A pace your people can actually keep\n      </div>\n    </section>\n\n    <section class=\"how-it-works page-shell\" id=\"how-it-works\">\n      <div class=\"section-intro\">\n        <span class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> Simple by design</span>\n        <h2>Good work starts with a good check-in.</h2>\n        <p>No complicated setup. Just a small ritual that gets everyone pointed in the same direction.</p>\n      </div>\n      <div class=\"steps\">\n        <article class=\"step-card\">\n          <div class=\"step-number\">1</div>\n          <h3>Get it all out</h3>\n          <p>Bring the ideas, loose ends, and \u201cwe should probably\u2026\u201d thoughts to one shared page.</p>\n        </article>\n        <article class=\"step-card\">\n          <div class=\"step-number\">2</div>\n          <h3>Pick what matters</h3>\n          <p>Choose a few real priorities together. Give each one a person, a day, and a little breathing room.</p>\n        </article>\n        <article class=\"step-card\">\n          <div class=\"step-number\">3</div>\n          <h3>Make it a week</h3>\n          <p>Keep the plan close, check in as you go, and celebrate the small things that move you forward.</p>\n        </article>\n      </div>\n    </section>\n\n    <section class=\"closing page-shell\" id=\"get-started\">\n      <div>\n        <h2>A better week doesn\u2019t need a bigger process.</h2>\n        <p>Just your people, a shared plan, and somewhere to start.</p>\n      </div>\n      <a class=\"button-primary\" href=\"mailto:hello@tidepool.team\">\n        Try Tidepool for free\n        <svg viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\">\n          <path d=\"M4 10h11M10 5l5 5-5 5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </svg>\n      </a>\n    </section>\n  </main>\n\n  <footer class=\"page-shell\">\n    <a class=\"brand\" href=\"#\" aria-label=\"Tidepool home\">\n      <span class=\"brand-mark\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 28 28\" fill=\"none\">\n          <path d=\"M4 11.2c2.1-2.2 4.2-2.2 6.3 0s4.2 2.2 6.3 0 4.2-2.2 6.3 0M4 16.6c2.1-2.2 4.2-2.2 6.3 0s4.2 2.2 6.3 0 4.2-2.2 6.3 0\" stroke=\"#F7F4EC\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n        </svg>\n      </span>\n      tidepool\n    </a>\n    <span>Made for the work you do together. \u00a9 2024 Tidepool</span>\n    <div class=\"footer-links\">\n      <a href=\"#how-it-works\">About</a>\n      <a href=\"mailto:hello@tidepool.team\">Say hello</a>\n    </div>\n  </footer>\n</body>\n</html>\n"}