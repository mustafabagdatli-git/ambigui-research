background: var(--paper);\n      font-family: var(--sans);\n      -webkit-font-smoothing: antialiased;\n    }\n\n    a { color: inherit; text-decoration: none; }\n\n    .page-shell {\n      width: min(1240px, calc(100% - 64px));\n      margin: 0 auto;\n    }\n\n    header {\n      height: 88px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      border-bottom: 1px solid rgba(32, 43, 40, .12);\n    }\n\n    .brand {\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      font-size: 19px;\n      font-weight: 650;\n      letter-spacing: -.05em;\n    }\n\n    .brand-mark {\n      display: grid;\n      width: 30px;\n      height: 30px;\n      place-items: center;\n      border-radius: 50%;\n      background: var(--green);\n    }\n\n    .brand-mark svg { width: 19px; height: 19px; }\n\n    nav {\n      display: flex;\n      align-items: center;\n      gap: 36px;\n      color: #545c54;\n      font-size: 13px;\n    }\n\n    nav a:hover, .text-link:hover { color: var(--green); }\n\n    .nav-cta {\n      padding: 12px 18px;\n      color: var(--white);\n      background: var(--green);\n      border-radius: 4px;\n      font-weight: 600;\n      transition: background .2s ease, transform .2s ease;\n    }\n\n    .nav-cta:hover, .button-primary:hover {\n      background: #284a3c;\n      transform: translateY(-1px);\n    }\n\n    .hero {\n      min-height: 660px;\n      display: grid;\n      grid-template-columns: .91fr 1.09fr;\n      align-items: center;\n      gap: 55px;\n      padding: 78px 0 84px;\n    }\n\n    .eyebrow {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      margin: 0 0 25px;\n      color: var(--green);\n      font-size: 11px;\n      font-weight: 700;\n      letter-spacing: .14em;\n      text-transform: uppercase;\n    }\n\n    .eyebrow::before {\n      content: \"\";\n      width: 24px;\n      height: 1px;\n      background: var(--coral);\n    }\n\n    h1, h2, h3, p { margin-top: 0; }\n\n    h1 {\n      max-width: 540px;\n      margin-bottom: 23px;\n      font: 400 clamp(54px, 6vw, 78px)/.99 var(--serif);\n      letter-spacing: -.065em;\n    }\n\n    h1 em {\n      color: var(--green);\n      font-weight: 400;\n    }\n\n    .hero-copy {\n      max-width: 440px;\n      margin-bottom: 31px;\n      color: #656c64;\n      font-size: 16px;\n      line-height: 1.75;\n    }\n\n    .hero-actions {\n      display: flex;\n      align-items: center;\n      gap: 23px;\n    }\n\n    .button-primary {\n      display: inline-flex;\n      align-items: center;\n      gap: 22px;\n      padding: 15px 19px;\n      border-radius: 4px;\n      color: white;\n      background: var(--green);\n      font-size: 13px;\n      font-weight: 650;\n      transition: background .2s ease, transform .2s ease;\n    }\n\n    .button-primary span { font-size: 18px; line-height: 10px; }\n\n    .text-link {\n      color: #555e55;\n      font-size: 13px;\n      font-weight: 600;\n    }\n\n    .social-proof {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      margin-top: 45px;\n      color: #737970;\n      font-size: 11px;\n    }\n\n    .avatar-stack { display: flex; padding-left: 3px; }\n\n    .avatar {\n      width: 25px;\n      height: 25px;\n      display: grid;\n      place-items: center;\n      margin-left: -4px;\n      border: 2px solid var(--paper);\n      border-radius: 50%;\n      color: #30463b;\n      background: #d5c8a8;\n      font-size: 8px;\n      font-weight: 700;\n    }\n\n    .avatar:nth-child(2) { background: #c3d0bd; }\n    .avatar:nth-child(3) { background: #e4aa91; }\n    .avatar:nth-child(4) { background: #b9c6c4; }\n\n    .planner-wrap {\n      position: relative;\n      padding: 30px 24px 25px 18px;\n    }\n\n    .planner-wrap::before {\n      content: \"\";\n      position: absolute;\n      inset: 7% 2% 0 10%;\n      border-radius: 50%;\n      background: #e9e5d9;\n      filter: blur(1px);\n      z-index: -1;\n    }\n\n    .planner {\n      position: relative;\n      overflow: hidden;\n      padding: 24px 25px 22px;\n      background: var(--white);\n      border: 1px solid #e5e1d7;\n      box-shadow: 0 24px 65px rgba(53, 59, 49, .12);\n      transform: rotate(1.4deg);\n    }\n\n    .planner-top {\n      display: flex;\n      justify-content: space-between;\n      align-items: flex-start;\n      padding-bottom: 20px;\n      border-bottom: 1px solid var(--line);\n    }\n\n    .planner-kicker {\n      margin-bottom: 6px;\n      color: #81857b;\n      font-size: 9px;\n      font-weight: 700;\n      letter-spacing: .13em;\n      text-transform: uppercase;\n    }\n\n    .planner-title {\n      margin: 0;\n      font: 400 26px/1.1 var(--serif);\n      letter-spacing: -.04em;\n    }\n\n    .week-tag {\n      padding: 7px 9px;\n      border-radius: 2px;\n      color: var(--green);\n      background: var(--green-soft);\n      font-size: 9px;\n      font-weight: 700;\n      letter-spacing: .04em;\n      text-transform: uppercase;\n    }\n\n    .team-row {\n      display: flex;\n      align-items: center;\n      gap: 9px;\n      padding: 14px 0 16px;\n      color: #858980;\n      font-size: 10px;\n    }\n\n    .team-avatars { display: flex; }\n    .team-avatars .avatar {\n      width: 20px;\n      height: 20px;\n      margin-left: -5px;\n      border-color: var(--white);\n      font-size: 7px;\n    }\n    .team-avatars .avatar:first-child { margin-left: 0; }\n\n    .schedule {\n      display: grid;\n      grid-template-columns: 58px repeat(5, 1fr);\n      border-top: 1px solid #e9e6dd;\n      border-left: 1px solid #e9e6dd;\n    }\n\n    .cell {\n      min-width: 0;\n      min-height: 70px;\n      padding: 8px 6px;\n      border-right: 1px solid #e9e6dd;\n      border-bottom: 1px solid #e9e6dd;\n    }\n\n    .day {\n      min-height: auto;\n      padding: 11px 3px 10px;\n      text-align: center;\n      color: #83877e;\n      font-size: 8px;\n      font-weight: 700;\n      letter-spacing: .08em;\n      text-transform: uppercase;\n    }\n\n    .day strong {\n      display: block;\n      margin-top: 4px;\n      color: var(--ink);\n      font-size: 12px;\n      letter-spacing: 0;\n    }\n\n    .time {\n      display: flex;\n      align-items: flex-start;\n      padding-top: 12px;\n      color: #999b93;\n      font-size: 8px;\n    }\n\n    .event {\n      min-height: 48px;\n      padding: 7px 6px;\n      border-radius: 2px;\n      color: #355345;\n      background: #e2ebe1;\n      font-size: 8px;\n      line-height: 1.35;\n    }\n\n    .event b {\n      display: block;\n      margin-bottom: 4px;\n      font-size: 8px;\n      font-weight: 700;\n    }\n\n    .event.coral { color: #805244; background: #f4e1d9; }\n    .event.yellow { color: #786337; background: #f5edcf; }\n    .event.blue { color: #4e6464; background: #e1ebea; }\n    .event.blank { background: transparent; }\n\n    .planner-bottom {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      padding-top: 16px;\n      color: #8a8d84;\n      font-size: 9px;\n    }\n\n    .planner-bottom strong { color: var(--green); font-weight: 650; }\n\n    .floating-note {\n      position: absolute;\n      right: -9px;\n      bottom: 5px;\n      width: 150px;\n      padding: 14px 15px 13px;\n      background: #f1d991;\n      box-shadow: 0 9px 24px rgba(63, 56, 34, .13);\n      transform: rotate(-5deg);\n    }\n\n    .floating-note span {\n      display: block;\n      margin-bottom: 7px;\n      color: #8b7443;\n      font-size: 8px;\n      font-weight: 700;\n      letter-spacing: .1em;\n      text-transform: uppercase;\n    }\n\n    .floating-note p {\n      margin: 0;\n      color: #51462d;\n      font: 13px/1.35 var(--serif);\n    }\n\n    .trust-line {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 35px;\n      padding: 26px 0;\n      border-top: 1px solid rgba(32, 43, 40, .12);\n      border-bottom: 1px solid rgba(32, 43, 40, .12);\n      color: #898c82;\n      font-size: 10px;\n      letter-spacing: .11em;\n      text-transform: uppercase;\n    }\n\n    .trust-line strong {\n      color: #5c655c;\n      font: 400 16px var(--serif);\n      letter-spacing: -.04em;\n      text-transform: none;\n    }\n\n    .features {\n      display: grid;\n      grid-template-columns: .9fr 1.1fr;\n      gap: 100px;\n      padding: 105px 0 112px;\n    }\n\n    .features h2 {\n      max-width: 370px;\n      margin: 0;\n      font: 400 45px/1.08 var(--serif);\n      letter-spacing: -.055em;\n    }\n\n    .feature-intro p {\n      max-width: 330px;\n      margin-top: 19px;\n      color: var(--muted);\n      font-size: 14px;\n      line-height: 1.75;\n    }\n\n    .feature-list { display: grid; gap: 0; }\n\n    .feature {\n      display: grid;\n      grid-template-columns: 40px 1fr;\n      gap: 18px;\n      padding: 20px 0;\n      border-bottom: 1px solid var(--line);\n    }\n\n    .feature:first-child { padding-top: 0; }\n\n    .feature-icon {\n      width: 36px;\n      height: 36px;\n      display: grid;\n      place-items: center;\n      border-radius: 50%;\n      color: var(--green);\n      background: #e6e9df;\n      font-size: 16px;\n    }\n\n    .feature h3 {\n      margin: 1px 0 6px;\n      font: 400 20px var(--serif);\n      letter-spacing: -.03em;\n    }\n\n    .feature p {\n      max-width: 400px;\n      margin: 0;\n      color: var(--muted);\n      font-size: 12px;\n      line-height: 1.65;\n    }\n\n    .closing {\n      position: relative;\n      overflow: hidden;\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      gap: 35px;\n      margin-bottom: 54px;\n      padding: 43px 52px;\n      color: #f9f6ec;\n      background: var(--green);\n    }\n\n    .closing::after {\n      content: \"\";\n      position: absolute;\n      width: 240px;\n      height: 240px;\n      right: 14%;\n      top: -150px;\n      border: 1px solid rgba(255,255,255,.12);\n      border-radius: 50%;\n      box-shadow: 0 0 0 24px rgba(255,255,255,.035), 0 0 0 48px rgba(255,255,255,.025);\n    }\n\n    .closing p {\n      position: relative;\n      z-index: 1;\n      max-width: 520px;\n      margin: 0;\n      font: 400 31px/1.2 var(--serif);\n      letter-spacing: -.04em;\n    }\n\n    .closing .button-primary {\n      position: relative;\n      z-index: 1;\n      flex-shrink: 0;\n      color: var(--ink);\n      background: #f5f2ea;\n    }\n\n    .closing .button-primary:hover { background: white; }\n\n    footer {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      padding: 0 0 30px;\n      color: #858980;\n      font-size: 10px;\n    }\n\n    .footer-links { display: flex; gap: 24px; }\n\n    @media (max-width: 900px) {\n      .hero { grid-template-columns: 1fr 1fr; gap: 25px; }\n      .planner-wrap { padding-left: 0; padding-right: 10px; }\n      .planner { padding: 19px 16px; }\n      .schedule { grid-template-columns: 43px repeat(5, 1fr); }\n      .features { gap: 50px; }\n    }\n\n    @media (max-width: 680px) {\n      .page-shell { width: min(100% - 38px, 520px); }\n      header { height: 72px; }\n      nav { gap: 14px; }\n      nav a:not(.nav-cta) { display: none; }\n      .nav-cta { padding: 10px 13px; font-size: 11px; }\n      .hero {\n        display: block;\n        padding: 61px 0 55px;\n      }\n      h1 { font-size: clamp(54px, 15vw, 72px); }\n      .hero-copy { font-size: 14px; }\n      .social-proof { margin-top: 30px; }\n      .planner-wrap { margin: 30px -2px 0; padding: 18px 8px 25px 0; }\n      .planner { padding: 17px 12px; transform: rotate(.7deg); }\n      .planner-title { font-size: 23px; }\n      .schedule { grid-template-columns: 36px repeat(5, 1fr); }\n      .cell { padding: 6px 3px; }\n      .day { font-size: 7px; }\n      .event { padding: 6px 3px; font-size: 7px; }\n      .event b { font-size: 7px; }\n      .floating-note { right: -5px; bottom: -2px; width: 132px; }\n      .trust-line {\n        flex-wrap: wrap;\n        gap: 12px 20px;\n        padding: 21px 0;\n        font-size: 8px;\n      }\n      .trust-line strong { font-size: 14px; }\n      .features {\n        display: block;\n        padding: 72px 0 75px;\n      }\n      .features h2 { font-size: 39px; }\n      .feature-intro p { margin-bottom: 35px; }\n      .closing {\n        display: block;\n        margin-bottom: 35px;\n        padding: 32px 26px;\n      }\n      .closing p { margin-bottom: 23px; font-size: 27px; }\n      footer { align-items: flex-start; gap: 20px; }\n      .footer-links { gap: 13px; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      html { scroll-behavior: auto; }\n      *, *::before, *::after { transition-duration: .01ms !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"page-shell\">\n    <header>\n      <a class=\"brand\" href=\"#\" aria-label=\"Tidepool home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M3.5 9.2c2.2-1.7 4.2-1.7 6.4 0s4.2 1.7 6.4 0 4.2-1.7 6.2 0M3.5 14.2c2.2-1.7 4.2-1.7 6.4 0s4.2 1.7 6.4 0 4.2-1.7 6.2 0\" stroke=\"#F5F2EA\" stroke-width=\"1.7\" stroke-linecap=\"round\"/>\n          </svg>\n        </span>\n        tidepool\n      </a>\n      <nav aria-label=\"Main navigation\">\n        <a href=\"#how-it-works\">How it works</a>\n        <a href=\"#about\">Why Tidepool</a>\n        <a class=\"nav-cta\" href=\"#get-started\">Get started <span aria-hidden=\"true\">\u2197</span></a>\n      </nav>\n    </header>\n\n    <main>\n      <section class=\"hero\" aria-labelledby=\"hero-title\">\n        <div>\n          <p class=\"eyebrow\">A calmer way to work together</p>\n          <h1 id=\"hero-title\">Make room for a <em>good week.</em></h1>\n          <p class=\"hero-copy\">\n            Tidepool gives your team one clear place to make a plan, find a rhythm, and do work that matters \u2014 without another meeting about it.\n          </p>\n          <div class=\"hero-actions\">\n            <a class=\"button-primary\" href=\"#get-started\">Plan your week <span aria-hidden=\"true\">\u2192</span></a>\n            <a class=\"text-link\" href=\"#how-it-works\">See how it works</a>\n          </div>\n          <div class=\"social-proof\">\n            <div class=\"avatar-stack\" aria-hidden=\"true\">\n              <span class=\"avatar\">AM</span><span class=\"avatar\">JL</span><span class=\"avatar\">SK</span><span class=\"avatar\">+</span>\n            </div>\n            <span>For small teams doing thoughtful work</span>\n          </div>\n        </div>\n\n        <div class=\"planner-wrap\" aria-label=\"A preview of a team weekly plan\">\n          <div class=\"planner\">\n            <div class=\"planner-top\">\n              <div>\n                <p class=\"planner-kicker\">The week, at a glance</p>\n                <h2 class=\"planner-title\">A little room to focus.</h2>\n              </div>\n              <span class=\"week-tag\">May 13\u201317</span>\n            </div>\n            <div class=\"team-row\">\n              <div class=\"team-avatars\" aria-hidden=\"true\">\n                <span class=\"avatar\">AM</span><span class=\"avatar\">JL</span><span class=\"avatar\">SK</span>\n              </div>\n              <span>Studio North \u00b7 3 people</span>\n            </div>\n            <div class=\"schedule\" role=\"table\" aria-label=\"Weekly team schedule\">\n              <div class=\"cell day\"></div>\n              <div class=\"cell day\">Mon<strong>13</strong></div>\n              <div class=\"cell day\">Tue<strong>14</strong></div>\n              <div class=\"cell day\">Wed<strong>15</strong></div>\n              <div class=\"cell day\">Thu<strong>16</strong></div>\n              <div class=\"cell day\">Fri<strong>17</strong></div>\n\n              <div class=\"cell time\">MORNING</div>\n              <div class=\"cell\"><div class=\"event\"><b>Make</b>Sketch new ideas</div></div>\n              <div class=\"cell\"><div class=\"event coral\"><b>Share</b>Client check-in</div></div>\n              <div class=\"cell\"><div class=\"event blank\"></div></div>\n              <div class=\"cell\"><div class=\"event\"><b>Make</b>Build the first pass</div></div>\n              <div class=\"cell\"><div class=\"event yellow\"><b>Reflect</b>What\u2019s working?</div></div>\n\n              <div class=\"cell time\">AFTERNOON</div>\n              <div class=\"cell\"><div class=\"event blue\"><b>Together</b>Weekly hello</div></div>\n              <div class=\"cell\"><div class=\"event blank\"></div></div>\n              <div class=\"cell\"><div class=\"event coral\"><b>Share</b>Show &amp; tell</div></div>\n              <div class=\"cell\"><div class=\"event blank\"></div></div>\n              <div class=\"cell\"><div class=\"event blank\"></div></div>\n            </div>\n            <div class=\"planner-bottom\">\n              <span>Small steps, shared openly.</span>\n              <strong>3 intentions set \u2197</strong>\n            </div>\n          </div>\n          <aside class=\"floating-note\">\n            <span>A note from Jo</span>\n            <p>Let\u2019s leave Friday afternoon open. \ud83c\udf31</p>\n          </aside>\n        </div>\n      </section>\n\n      <div class=\"trust-line\" aria-label=\"Made for small teams\">\n        <span>Good work happens</span>\n        <strong>in studios</strong>\n        <strong>in co-ops</strong>\n        <strong>in tiny teams</strong>\n        <span>everywhere, really</span>\n      </div>\n\n      <section class=\"features\" id=\"how-it-works\">\n        <div class=\"feature-intro\" id=\"about\">\n          <p class=\"eyebrow\">Less juggling, more doing</p>\n          <h2>A shared plan should feel like a deep breath.</h2>\n          <p>Skip the status-chasing. Get on the same page, make space for focused work, and let the week unfold.</p>\n        </div>\n        <div class=\"feature-list\">\n          <article class=\"feature\">\n            <div class=\"feature-icon\" aria-hidden=\"true\">\u2733</div>\n            <div>\n              <h3>Start with what matters</h3>\n              <p>Gather everyone\u2019s priorities in one calm, clear view. No sprawling boards, no busywork.</p>\n            </div>\n          </article>\n          <article class=\"feature\">\n            <div class=\"feature-icon\" aria-hidden=\"true\">\u2197</div>\n            <div>\n              <h3>Find a rhythm together</h3>\n              <p>Shape a week that makes room for collaboration, deep focus, and the unexpected.</p>\n            </div>\n          </article>\n          <article class=\"feature\">\n            <div class=\"feature-icon\" aria-hidden=\"true\">~</div>\n            <div>\n              <h3>Keep the conversation going</h3>\n              <p>Leave thoughtful updates right where the plan lives, so everyone stays in the loop.</p>\n            </div>\n          </article>\n        </div>\n      </section>\n\n      <section class=\"closing\" id=\"get-started\">\n        <p>Make a little space for a better kind of workweek.</p>\n        <a class=\"button-primary\" href=\"mailto:hello@tidepool.team\">Try Tidepool free <span aria-hidden=\"true\">\u2192</span></a>\n      </section>\n    </main>\n\n    <footer>\n      <span>\u00a9 2024 Tidepool. Made for the work we care about.</span>\n      <div class=\"footer-links\">\n        <a href=\"mailto:hello@tidepool.team\">Contact</a>\n        <a href=\"#about\">About</a>\n        <a href=\"#get-started\">Get started</a>\n      </div>\n    </footer>\n  </div>\n</body>\n</html>\n"}