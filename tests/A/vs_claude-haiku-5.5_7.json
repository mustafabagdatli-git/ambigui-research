{"arm": "vs", "model": "anthropic/claude-haiku-5.5", "i": 7, "finish": "stop", "dirs": [{"direction": "Warm editorial: cream paper, serif headlines, and ink-like accents that feel like a planning notebook", "probability": 0.34}, {"direction": "Calm Swiss minimalism: strict grid, generous whitespace, one saturated accent, and monospace details for schedule times", "probability": 0.2}, {"direction": "Tide-inspired organic: soft gradients from sea-glass to deep blue, with CSS-drawn wave dividers and rounded, flowing shapes", "probability": 0.22}, {"direction": "Neo-brutalist: hard black borders, offset shadows, loud primary colors, and chunky sans-serif type", "probability": 0.1}, {"direction": "Dark-mode product console: a near-black interface with glowing status indicators and a dense, dashboard-style hero", "probability": 0.14}], "pick": {"direction": "Warm editorial: cream paper, serif headlines, and ink-like accents that feel like a planning notebook", "probability": 0.34}, "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Tidepool \u2014 Plan your week together</title>\n<meta name=\"description\" content=\"Tidepool helps small teams sketch out their week together, one shared page at a time.\">\n<style>\n  :root {\n    --paper: #f6efe1;\n    --paper-deep: #ede3cc;\n    --paper-edge: #e4d7badd;\n    --ink: #1f2a3c;\n    --ink-soft: #4d5669;\n    --ink-faint: #8a8476;\n    --rust: #b4532e;\n    --sea: #2f6b67;\n    --highlight: #f2d36b;\n    --rule: #d8cab0;\n    --margin: #e7a193;\n    --serif: \"Iowan Old Style\", \"Palatino Linotype\", Palatino, \"Book Antiqua\", Georgia, serif;\n    --sans: ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Helvetica, Arial, sans-serif;\n    --maxw: 1120px;\n  }\n\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n\n  html { scroll-behavior: smooth; }\n\n  body {\n    font-family: var(--serif);\n    font-size: 18px;\n    line-height: 1.6;\n    color: var(--ink);\n    background-color: var(--paper);\n    background-image:\n      radial-gradient(rgba(120, 95, 50, 0.05) 1px, transparent 1px),\n      radial-gradient(rgba(120, 95, 50, 0.04) 1px, transparent 1px),\n      linear-gradient(180deg, #f8f2e4 0%, var(--paper) 40%, #f2e9d5 100%);\n    background-size: 3px 3px, 7px 7px, 100% 100%;\n    background-attachment: fixed;\n    -webkit-font-smoothing: antialiased;\n    min-height: 100vh;\n  }\n\n  ::selection { background: var(--highlight); color: var(--ink); }\n\n  a { color: inherit; }\n\n  .wrap {\n    max-width: var(--maxw);\n    margin: 0 auto;\n    padding: 0 28px;\n  }\n\n  /* ---------- Nav ---------- */\n  .nav {\n    position: sticky;\n    top: 0;\n    z-index: 10;\n    background: rgba(246, 239, 225, 0.88);\n    backdrop-filter: blur(6px);\n    border-bottom: 1px solid var(--rule);\n  }\n  .nav .wrap {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    height: 68px;\n  }\n  .logo {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    text-decoration: none;\n    font-size: 22px;\n    font-weight: 700;\n    letter-spacing: -0.01em;\n  }\n  .logo-mark { width: 26px; height: 26px; flex: none; }\n  .nav-links {\n    display: flex;\n    align-items: center;\n    gap: 28px;\n    list-style: none;\n    font-family: var(--sans);\n    font-size: 14px;\n  }\n  .nav-links a {\n    text-decoration: none;\n    color: var(--ink-soft);\n    transition: color .2s;\n  }\n  .nav-links a:hover { color: var(--ink); }\n\n  /* ---------- Buttons ---------- */\n  .btn {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    font-family: var(--sans);\n    font-size: 15px;\n    font-weight: 600;\n    text-decoration: none;\n    padding: 12px 22px;\n    border-radius: 3px;\n    border: 1.5px solid var(--ink);\n    cursor: pointer;\n    transition: transform .15s ease, box-shadow .15s ease, background .2s, color .2s;\n    white-space: nowrap;\n  }\n  .btn-ink {\n    background: var(--ink);\n    color: var(--paper);\n    box-shadow: 3px 3px 0 var(--rust);\n  }\n  .btn-ink:hover { transform: translate(-1px, -1px); box-shadow: 4px 4px 0 var(--rust); }\n  .btn-ghost {\n    background: transparent;\n    color: var(--ink);\n  }\n  .btn-ghost:hover { background: var(--ink); color: var(--paper); }\n  .btn-sm { padding: 9px 16px; font-size: 14px; }\n\n  /* ---------- Hero ---------- */\n  .hero {\n    padding: 88px 0 96px;\n  }\n  .hero-grid {\n    display: grid;\n    grid-template-columns: 1.02fr 0.98fr;\n    gap: 64px;\n    align-items: center;\n  }\n  .kicker {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    font-family: var(--sans);\n    font-size: 12px;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 0.14em;\n    color: var(--rust);\n    margin-bottom: 22px;\n  }\n  .kicker::before {\n    content: \"\";\n    width: 28px;\n    height: 1.5px;\n    background: var(--rust);\n  }\n  h1 {\n    font-size: clamp(44px, 6.2vw, 76px);\n    line-height: 1.02;\n    font-weight: 600;\n    letter-spacing: -0.02em;\n    margin-bottom: 26px;\n  }\n  h1 em {\n    font-style: italic;\n    font-weight: 500;\n    color: var(--sea);\n  }\n  h1 .hl {\n    background: linear-gradient(transparent 62%, var(--highlight) 62%, var(--highlight) 92%, transparent 92%);\n    padding: 0 4px;\n    margin: 0 -4px;\n  }\n  .lede {\n    font-size: 21px;\n    line-height: 1.55;\n    color: var(--ink-soft);\n    max-width: 30em;\n    margin-bottom: 36px;\n  }\n  .cta-row {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 16px;\n    align-items: center;\n    margin-bottom: 26px;\n  }\n  .fine {\n    font-family: var(--sans);\n    font-size: 13px;\n    color: var(--ink-faint);\n  }\n\n  /* Notebook card */\n  .notebook-wrap {\n    position: relative;\n    transform: rotate(1.2deg);\n  }\n  .notebook {\n    position: relative;\n    background: #fffdf7;\n    border: 1px solid #d9ccb2;\n    border-radius: 4px 6px 6px 4px;\n    padding: 28px 28px 24px 56px;\n    box-shadow:\n      0 1px 0 #fff inset,\n      0 2px 3px rgba(60, 45, 20, 0.08),\n      0 18px 40px -12px rgba(60, 45, 20, 0.25);\n    background-image:\n      linear-gradient(90deg, transparent 43px, var(--margin) 43px, var(--margin) 45px, transparent 45px),\n      repeating-linear-gradient(180deg, transparent 0, transparent 31px, #e9e0cb 31px, #e9e0cb 32px);\n    background-position: 0 0, 0 58px;\n  }\n  .notebook::before {\n    /* binding holes */\n    content: \"\";\n    position: absolute;\n    left: 14px;\n    top: 0;\n    bottom: 0;\n    width: 14px;\n    background:\n      radial-gradient(circle at 7px 22px, var(--paper-deep) 4px, transparent 4.5px),\n      radial-gradient(circle at 7px 50%, var(--paper-deep) 4px, transparent 4.5px),\n      radial-gradient(circle at 7px calc(100% - 22px), var(--paper-deep) 4px, transparent 4.5px);\n    background-repeat: no-repeat;\n  }\n  .nb-head {\n    display: flex;\n    justify-content: space-between;\n    align-items: baseline;\n    border-bottom: 1.5px solid var(--ink);\n    padding-bottom: 10px;\n    margin-bottom: 6px;\n  }\n  .nb-head h3 {\n    font-size: 24px;\n    font-weight: 600;\n    letter-spacing: -0.01em;\n  }\n  .nb-head span {\n    font-family: var(--sans);\n    font-size: 12px;\n    color: var(--ink-faint);\n    text-transform: uppercase;\n    letter-spacing: 0.1em;\n  }\n  .nb-day {\n    display: grid;\n    grid-template-columns: 52px 1fr;\n    gap: 10px;\n    padding: 9px 0;\n    min-height: 32px;\n  }\n  .nb-day-label {\n    font-family: var(--sans);\n    font-size: 12px;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 0.08em;\n    color: var(--ink-faint);\n    padding-top: 3px;\n  }\n  .nb-day-label b {\n    display: block;\n    font-family: var(--serif);\n    font-size: 22px;\n    font-weight: 600;\n    color: var(--ink);\n    letter-spacing: 0;\n    text-transform: none;\n    line-height: 1;\n  }\n  .nb-items { list-style: none; }\n  .nb-items li {\n    display: flex;\n    align-items: flex-start;\n    gap: 9px;\n    font-size: 16px;\n    line-height: 1.35;\n    padding: 2px 0;\n  }\n  .box {\n    flex: none;\n    width: 13px;\n    height: 13px;\n    margin-top: 4px;\n    border: 1.5px solid var(--ink);\n    border-radius: 1px;\n    position: relative;\n  }\n  .box.done::after {\n    content: \"\";\n    position: absolute;\n    left: 2px;\n    top: -3px;\n    width: 6px;\n    height: 11px;\n    border-right: 2px solid var(--rust);\n    border-bottom: 2px solid var(--rust);\n    transform: rotate(40deg);\n  }\n  .done-text {\n    color: var(--ink-faint);\n    text-decoration: line-through;\n    text-decoration-color: var(--rust);\n    text-decoration-thickness: 1.5px;\n  }\n  .ink-note {\n    font-style: italic;\n    color: var(--rust);\n  }\n  .nb-hl {\n    background: var(--highlight);\n    padding: 0 3px;\n    margin: 0 -3px;\n    border-radius: 2px;\n  }\n  .sticky {\n    position: absolute;\n    right: -26px;\n    bottom: -30px;\n    background: #f7e9a7;\n    padding: 14px 16px;\n    width: 168px;\n    font-style: italic;\n    font-size: 15px;\n    line-height: 1.35;\n    color: var(--ink);\n    transform: rotate(-4deg);\n    box-shadow: 0 10px 20px -8px rgba(60,45,20,.35);\n  }\n  .sticky::before {\n    content: \"\";\n    position: absolute;\n    top: -8px;\n    left: 50%;\n    width: 60px;\n    height: 16px;\n    margin-left: -30px;\n    background: rgba(230, 220, 190, 0.7);\n    transform: rotate(2deg);\n  }\n  .sticky strong { font-style: normal; font-family: var(--sans); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; display: block; margin-bottom: 4px; color: var(--ink-soft); }\n\n  /* ---------- Trust strip ---------- */\n  .strip {\n    border-top: 1px solid var(--rule);\n    border-bottom: 1px solid var(--rule);\n    padding: 22px 0;\n  }\n  .strip .wrap {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    justify-content: space-between;\n    gap: 16px 32px;\n    font-family: var(--sans);\n    font-size: 13px;\n    color: var(--ink-faint);\n    letter-spacing: 0.04em;\n  }\n  .strip .names {\n    font-family: var(--serif);\n    font-style: italic;\n    font-size: 17px;\n    color: var(--ink-soft);\n    letter-spacing: 0;\n  }\n  .strip .names span { margin: 0 14px; color: var(--rule); font-style: normal; }\n\n  /* ---------- Sections ---------- */\n  section { position: relative; }\n  .section { padding: 112px 0; }\n  .section-head {\n    display: grid;\n    grid-template-columns: 180px 1fr;\n    gap: 40px;\n    margin-bottom: 64px;\n    align-items: start;\n  }\n  .section-num {\n    font-family: var(--sans);\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: .12em;\n    text-transform: uppercase;\n    color: var(--rust);\n    padding-top: 12px;\n    border-top: 1.5px solid var(--ink);\n  }\n  h2 {\n    font-size: clamp(34px, 4.2vw, 50px);\n    line-height: 1.08;\n    font-weight: 600;\n    letter-spacing: -0.015em;\n    max-width: 18em;\n  }\n  h2 em { font-style: italic; color: var(--sea); font-weight: 500; }\n  .section-sub {\n    margin-top: 18px;\n    color: var(--ink-soft);\n    font-size: 19px;\n    max-width: 34em;\n  }\n\n  /* Features: notebook entries */\n  .features {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    column-gap: 56px;\n  }\n  .feature {\n    padding: 34px 0 38px;\n    border-top: 1px solid var(--ink);\n  }\n  .feature:nth-child(-n+2) { border-top-width: 1.5px; }\n  .feature-top {\n    display: flex;\n    align-items: baseline;\n    gap: 16px;\n    margin-bottom: 12px;\n  }\n  .feature-n {\n    font-family: var(--serif);\n    font-style: italic;\n    font-size: 30px;\n    color: var(--rust);\n    line-height: 1;\n  }\n  .feature h3 {\n    font-size: 26px;\n    font-weight: 600;\n    letter-spacing: -0.01em;\n    line-height: 1.2;\n  }\n  .feature p {\n    color: var(--ink-soft);\n    font-size: 17px;\n    line-height: 1.6;\n  }\n  .feature .tag {\n    display: inline-block;\n    margin-top: 14px;\n    font-family: var(--sans);\n    font-size: 12px;\n    color: var(--sea);\n    border: 1px solid currentColor;\n    padding: 3px 9px;\n    border-radius: 99px;\n    letter-spacing: .02em;\n  }\n\n  /* How it works */\n  .steps-band {\n    background: var(--paper-deep);\n    border-top: 1px solid var(--rule);\n    border-bottom: 1px solid var(--rule);\n  }\n  .steps {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    counter-reset: step;\n  }\n  .step {\n    padding: 48px 36px 52px;\n    position: relative;\n  }\n  .step + .step {\n    border-left: 1px dashed #bfae8c;\n  }\n  .step-circle {\n    width: 54px;\n    height: 54px;\n    border-radius: 50%;\n    border: 1.5px solid var(--ink);\n    display: grid;\n    place-items: center;\n    font-size: 22px;\n    font-style: italic;\n    margin-bottom: 22px;\n    background: var(--paper);\n  }\n  .step h3 {\n    font-size: 24px;\n    font-weight: 600;\n    margin-bottom: 10px;\n  }\n  .step p { color: var(--ink-soft); font-size: 17px; }\n  .step .example {\n    margin-top: 18px;\n    font-style: italic;\n    font-size: 16px;\n    color: var(--ink-faint);\n    border-left: 2px solid var(--highlight);\n    padding-left: 12px;\n  }\n\n  /* Quote */\n  .quote {\n    padding: 120px 0;\n  }\n  .quote-inner {\n    max-width: 820px;\n    margin: 0 auto;\n    text-align: left;\n    position: relative;\n  }\n  .quote-mark {\n    font-size: 140px;\n    line-height: 0.6;\n    color: var(--rust);\n    font-family: Georgia, serif;\n    height: 60px;\n    display: block;\n  }\n  blockquote {\n    font-size: clamp(26px, 3.2vw, 36px);\n    line-height: 1.32;\n    font-style: italic;\n    font-weight: 500;\n    letter-spacing: -0.01em;\n  }\n  .quote-cite {\n    margin-top: 28px;\n    font-family: var(--sans);\n    font-size: 14px;\n    color: var(--ink-soft);\n  }\n  .quote-cite b { color: var(--ink); }\n\n  /* Pricing */\n  .pricing {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 28px;\n    max-width: 860px;\n  }\n  .plan {\n    background: #fffdf7;\n    border: 1px solid #d6c8ac;\n    padding: 36px 34px 34px;\n    position: relative;\n    box-shadow: 0 1px 2px rgba(60,45,20,.06);\n  }\n  .plan.featured {\n    border: 1.5px solid var(--ink);\n    box-shadow: 6px 6px 0 var(--ink);\n  }\n  .plan-badge {\n    position: absolute;\n    top: -13px;\n    left: 26px;\n    background: var(--rust);\n    color: var(--paper);\n    font-family: var(--sans);\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: .12em;\n    text-transform: uppercase;\n    padding: 5px 10px;\n  }\n  .plan h3 { font-size: 26px; font-weight: 600; }\n  .plan .price {\n    display: flex;\n    align-items: baseline;\n    gap: 6px;\n    margin: 14px 0 6px;\n  }\n  .plan .price strong {\n    font-size: 56px;\n    font-weight: 600;\n    letter-spacing: -0.03em;\n    line-height: 1;\n  }\n  .plan .price span { color: var(--ink-faint); font-size: 16px; font-family: var(--sans); }\n  .plan .desc { color: var(--ink-soft); font-size: 17px; margin-bottom: 22px; padding-bottom: 22px; border-bottom: 1px dashed #bfae8c; }\n  .plan ul { list-style: none; margin-bottom: 30px; }\n  .plan li {\n    font-family: var(--sans);\n    font-size: 15px;\n    padding: 7px 0 7px 26px;\n    position: relative;\n    color: var(--ink-soft);\n  }\n  .plan li::before {\n    content: \"\";\n    position: absolute;\n    left: 2px;\n    top: 13px;\n    width: 9px;\n    height: 5px;\n    border-left: 2px solid var(--sea);\n    border-bottom: 2px solid var(--sea);\n    transform: rotate(-45deg);\n  }\n  .plan .btn { width: 100%; justify-content: center; }\n  .pricing-note {\n    margin-top: 28px;\n    font-style: italic;\n    color: var(--ink-soft);\n    max-width: 40em;\n  }\n\n  /* FAQ */\n  .faq-grid {\n    display: grid;\n    grid-template-columns: 180px 1fr;\n    gap: 40px;\n  }\n  .faq details {\n    border-top: 1px solid var(--rule);\n  }\n  .faq details:last-child { border-bottom: 1px solid var(--rule); }\n  .faq summary {\n    list-style: none;\n    cursor: pointer;\n    padding: 24px 40px 24px 0;\n    font-size: 21px;\n    font-weight: 600;\n    position: relative;\n  }\n  .faq summary::-webkit-details-marker { display: none; }\n  .faq summary::after {\n    content: \"+\";\n    position: absolute;\n    right: 4px;\n    top: 16px;\n    font-family: var(--sans);\n    font-size: 26px;\n    font-weight: 300;\n    color: var(--rust);\n    transition: transform .2s;\n  }\n  .faq details[open] summary::after { content: \"\u2013\"; }\n  .faq details p {\n    padding: 0 40px 26px 0;\n    color: var(--ink-soft);\n    font-size: 17px;\n    max-width: 40em;\n  }\n\n  /* Final CTA */\n  .final {\n    background: var(--ink);\n    color: var(--paper);\n    padding: 110px 0;\n    position: relative;\n    overflow: hidden;\n  }\n  .final::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background-image:\n      repeating-linear-gradient(180deg, transparent 0, transparent 39px, rgba(246,239,225,.07) 39px, rgba(246,239,225,.07) 40px);\n    pointer-events: none;\n  }\n  .final-inner {\n    position: relative;\n    display: grid;\n    grid-template-columns: 1.3fr 1fr;\n    gap: 56px;\n    align-items: center;\n  }\n  .final h2 { color: var(--paper); }\n  .final h2 em { color: var(--highlight); }\n  .final p { color: #c9cbd2; font-size: 19px; margin-top: 18px; max-width: 30em; }\n  .final form {\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n    background: rgba(246,239,225,.04);\n    border: 1px solid rgba(246,239,225,.25);\n    padding: 26px;\n  }\n  .final label {\n    font-family: var(--sans);\n    font-size: 13px;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n    color: #b9bcc6;\n  }\n  .final input {\n    font-family: var(--serif);\n    font-size: 18px;\n    background: transparent;\n    border: none;\n    border-bottom: 1.5px solid rgba(246,239,225,.5);\n    padding: 10px 2px;\n    color: var(--paper);\n    outline: none;\n  }\n  .final input::placeholder { color: #7f8496; font-style: italic; }\n  .final input:focus { border-bottom-color: var(--highlight); }\n  .final .btn-ink {\n    background: var(--paper);\n    color: var(--ink);\n    border-color: var(--paper);\n    box-shadow: 3px 3px 0 var(--rust);\n    justify-content: center;\n    margin-top: 10px;\n  }\n  .final form .fine { color: #9fa3b0; margin-top: 4px; }\n\n  /* Footer */\n  footer {\n    padding: 56px 0 44px;\n    border-top: 1px solid var(--rule);\n    font-family: var(--sans);\n    font-size: 14px;\n    color: var(--ink-faint);\n  }\n  footer .wrap {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: space-between;\n    gap: 24px;\n    align-items: center;\n  }\n  footer ul {\n    list-style: none;\n    display: flex;\n    gap: 24px;\n  }\n  footer a { text-decoration: none; color: var(--ink-soft); }\n  footer a:hover { color: var(--rust); }\n  footer .colophon {\n    font-family: var(--serif);\n    font-style: italic;\n    font-size: 15px;\n    width: 100%;\n    margin-top: 8px;\n    padding-top: 20px;\n    border-top: 1px dashed #cbbd9d;\n  }\n\n  /* Responsive */\n  @media (max-width: 960px) {\n    .hero-grid { grid-template-columns: 1fr; gap: 56px; }\n    .notebook-wrap { transform: rotate(0.4deg); max-width: 560px; }\n    .section-head, .faq-grid { grid-template-columns: 1fr; gap: 18px; }\n    .section-num { border-top: none; padding-top: 0; }\n    .features { grid-template-columns: 1fr; }\n    .feature:nth-child(2) { border-top-width: 1px; }\n    .steps { grid-template-columns: 1fr; }\n    .step + .step { border-left: none; border-top: 1px dashed #bfae8c; }\n    .final-inner { grid-template-columns: 1fr; }\n    .pricing { grid-template-columns: 1fr; }\n    .nav-links li:not(:last-child) { display: none; }\n  }\n  @media (max-width: 560px) {\n    body { font-size: 17px; }\n    .hero { padding: 56px 0 72px; }\n    .section { padding: 80px 0; }\n    .notebook { padding-left: 42px; }\n    .notebook { background-image:\n      linear-gradient(90deg, transparent 31px, var(--margin) 31px, var(--margin) 33px, transparent 33px),\n      repeating-linear-gradient(180deg, transparent 0, transparent 31px, #e9e0cb 31px, #e9e0cb 32px);\n      background-position: 0 0, 0 58px; }\n    .sticky { right: -6px; width: 150px; }\n    .nb-day { grid-template-columns: 44px 1fr; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    html { scroll-behavior: auto; }\n    * { transition: none !important; }\n  }\n</style>\n</head>\n<body>\n\n<!-- NAV -->\n<header class=\"nav\">\n  <div class=\"wrap\">\n    <a href=\"#top\" class=\"logo\" aria-label=\"Tidepool home\">\n      <svg class=\"logo-mark\" viewBox=\"0 0 26 26\" aria-hidden=\"true\">\n        <path d=\"M3 9 C 8 4, 18 4, 23 9\" fill=\"none\" stroke=\"#1f2a3c\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n        <path d=\"M3 15 C 8 10, 18 10, 23 15\" fill=\"none\" stroke=\"#2f6b67\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n        <path d=\"M5 21 C 10 17, 16 17, 21 21\" fill=\"none\" stroke=\"#b4532e\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n      </svg>\n      Tidepool\n    </a>\n    <ul class=\"nav-links\">\n      <li><a href=\"#how\">How it works</a></li>\n      <li><a href=\"#features\">Features</a></li>\n      <li><a href=\"#pricing\">Pricing</a></li>\n      <li><a href=\"#faq\">Questions</a></li>\n      <li><a href=\"#start\" class=\"btn btn-ink btn-sm\">Start a week</a></li>\n    </ul>\n  </div>\n</header>\n\n<main id=\"top\">\n\n  <!-- HERO -->\n  <section class=\"hero\">\n    <div class=\"wrap hero-grid\">\n      <div>\n        <p class=\"kicker\">For teams of two to twelve</p>\n        <h1>Plan the week <em>together</em>, <span class=\"hl\">in ink.</span></h1>\n        <p class=\"lede\">\n          Tidepool is a shared weekly page for small teams. Sketch out who is doing what, leave notes in the margins, and check things off as the week moves, without another dashboard to babysit.\n        </p>\n        <div class=\"cta-row\">\n          <a href=\"#start\" class=\"btn btn-ink\">Open a blank week &rarr;</a>\n          <a href=\"#how\" class=\"btn btn-ghost\">See how it works</a>\n        </div>\n        <p class=\"fine\">Free for teams of up to five. No card required.</p>\n      </div>\n\n      <div class=\"notebook-wrap\" aria-label=\"Preview of a Tidepool weekly page\">\n        <div class=\"notebook\">\n          <div class=\"nb-head\">\n            <h3>Week of March 9</h3>\n            <span>Team Larkspur</span>\n          </div>\n\n          <div class=\"nb-day\">\n            <div class=\"nb-day-label\">Mon<b>9</b></div>\n            <ul class=\"nb-items\">\n              <li><span class=\"box done\"></span><span class=\"done-text\">Standup, 15 min</span></li>\n              <li><span class=\"box done\"></span><span class=\"done-text\">Send Q1 budget draft</span></li>\n            </ul>\n          </div>\n\n          <div class=\"nb-day\">\n            <div class=\"nb-day-label\">Tue<b>10</b></div>\n            <ul class=\"nb-items\">\n              <li><span class=\"box\"></span><span>Client call with <span class=\"nb-hl\">Hollis &amp; Co.</span></span></li>\n              <li><span class=\"box\"></span><span>Review onboarding copy <span class=\"ink-note\">\u2014 Priya</span></span></li>\n            </ul>\n          </div>\n\n          <div class=\"nb-day\">\n            <div class=\"nb-day-label\">Wed<b>11</b></div>\n            <ul class=\"nb-items\">\n              <li><span class=\"box\"></span><span>Ship invoice export</span></li>\n              <li><span class=\"box\"></span><span class=\"ink-note\">Ask Dev about the staging key?</span></li>\n            </ul>\n          </div>\n\n          <div class=\"nb-day\">\n            <div class=\"nb-day-label\">Thu<b>12</b></div>\n            <ul class=\"nb-items\">\n              <li><span class=\"box\"></span><span>Offsite prep, <span class=\"nb-hl\">book the room</span></span></li>\n            </ul>\n          </div>\n\n          <div class=\"nb-day\">\n            <div class=\"nb-day-label\">Fri<b>13</b></div>\n            <ul class=\"nb-items\">\n              <li><span class=\"box\"></span><span>Weekly wrap-up, 30 min</span></li>\n            </ul>\n          </div>\n\n          <div class=\"sticky\">\n            <strong>Margin note</strong>\n            Keep Tuesday light. Hollis wants answers, not decks.\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- TRUST STRIP -->\n  <div class=\"strip\">\n    <div class=\"wrap\">\n      <span>Used by small teams who would rather write than scroll</span>\n      <span class=\"names\">\n        Studio Marrow<span>&middot;</span>Fernhill Labs<span>&middot;</span>Pale Harbor<span>&middot;</span>Kettle &amp; Oar<span>&middot;</span>North Ledger\n      </span>\n    </div>\n  </div>\n\n  <!-- HOW IT WORKS -->\n  <section class=\"section\" id=\"how\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <div class=\"section-num\">01 &mdash; Method</div>\n        <div>\n          <h2>Three steps, <em>no</em> meetings about meetings.</h2>\n          <p class=\"section-sub\">Tidepool is built around a single page per week. Everyone writes on the same sheet, and nobody has to remember where anything lives.</p>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"steps-band\">\n      <div class=\"wrap\">\n        <div class=\"steps\">\n          <div class=\"step\">\n            <div class=\"step-circle\">i</div>\n            <h3>Open the week</h3>\n            <p>Start a fresh page for the coming week. Tidepool carries over anything unfinished from last time, so nothing falls through the cracks.</p>\n            <p class=\"example\">&ldquo;Carried over: two items from last Thursday.&rdquo;</p>\n          </div>\n          <div class=\"step\">\n            <div class=\"step-circle\">ii</div>\n            <h3>Write it down</h3>\n            <p>Add tasks to the day they belong on. Assign them with a name, pin a deadline, or tuck a note into the margin for context.</p>\n            <p class=\"example\">&ldquo;Priya takes the onboarding copy, due Tuesday.&rdquo;</p>\n          </div>\n          <div class=\"step\">\n            <div class=\"step-circle\">iii</div>\n            <h3>Cross it off</h3>\n            <p>Check items off as the week unfolds. Your team sees progress at a glance, and Friday's wrap-up writes itself from what got done.</p>\n            <p class=\"example\">&ldquo;Seven of nine done by Thursday afternoon.&rdquo;</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- FEATURES -->\n  <section class=\"section\" id=\"features\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <div class=\"section-num\">02 &mdash; Contents</div>\n        <div>\n          <h2>Everything a small team needs, <em>and not much more.</em></h2>\n          <p class=\"section-sub\">We left out the boards, the swimlanes, and the forty-field task forms. What remains is a page you can read in ten seconds.</p>\n        </div>\n      </div>\n\n      <div class=\"features\">\n        <article class=\"feature\">\n          <div class=\"feature-top\">\n            <span class=\"feature-n\">i.</span>\n            <h3>One shared page per week</h3>\n          </div>\n          <p>Everyone on the team sees the same sheet, updated live. There are no private versions to reconcile and no &ldquo;which tool is current&rdquo; conversations.</p>\n          <span class=\"tag\">Live for everyone</span>\n        </article>\n\n        <article class=\"feature\">\n          <div class=\"feature-top\">\n            <span class=\"feature-n\">ii.</span>\n            <h3>Margin notes that stay put</h3>\n          </div>\n          <p>Attach context to any line without cluttering the task itself. Notes are initialed and dated, so you always know who said what and when.</p>\n          <span class=\"tag\">Initialed &amp; dated</span>\n        </article>\n\n        <article class=\"feature\">\n          <div class=\"feature-top\">\n            <span class=\"feature-n\">iii.</span>\n            <h3>Carry-over, automatically</h3>\n          </div>\n          <p>Unfinished work moves to the next week instead of vanishing. You decide whether it stays, gets dropped, or gets a new day.</p>\n          <span class=\"tag\">Nothing lost</span>\n        </article>\n\n        <article class=\"feature\">\n          <div class=\"feature-top\">\n            <span class=\"feature-n\">iv.</span>\n            <h3>A wrap-up you can actually read</h3>\n          </div>\n          <p>On Friday, Tidepool drafts a short summary of what shipped, what slipped, and what moved forward. Edit it in place, then file it away.</p>\n          <span class=\"tag\">Drafted for you</span>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <!-- QUOTE -->\n  <section class=\"quote\">\n    <div class=\"wrap\">\n      <div class=\"quote-inner\">\n        <span class=\"quote-mark\" aria-hidden=\"true\">&ldquo;</span>\n        <blockquote>\n          We used to lose a whole morning to &ldquo;what are we doing this week?&rdquo; Now the page is already open when we sit down, and half the questions answer themselves.\n        </blockquote>\n        <p class=\"quote-cite\"><b>Marisol Ender</b>, operations lead at Studio Marrow, a team of seven</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- PRICING -->\n  <section class=\"section\" id=\"pricing\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <div class=\"section-num\">03 &mdash; Terms</div>\n        <div>\n          <h2>Priced for a team, <em>not</em> an enterprise.</h2>\n          <p class=\"section-sub\">Start free with a small group. When your team grows, pay a simple per-person rate. No seat minimums, no annual lock-in.</p>\n        </div>\n      </div>\n\n      <div class=\"pricing\">\n        <div class=\"plan\">\n          <h3>Notebook</h3>\n          <div class=\"price\"><strong>$0</strong><span>/ forever</span></div>\n          <p class=\"desc\">For a small crew getting the habit started.</p>\n          <ul>\n            <li>Up to five people</li>\n            <li>Unlimited weekly pages</li>\n            <li>Margin notes and assignments</li>\n            <li>Four weeks of history</li>\n          </ul>\n          <a href=\"#start\" class=\"btn btn-ghost\">Start for free</a>\n        </div>\n\n        <div class=\"plan featured\">\n          <span class=\"plan-badge\">Most teams choose this</span>\n          <h3>Field Edition</h3>\n          <div class=\"price\"><strong>$6</strong><span>/ person / month</span></div>\n          <p class=\"desc\">For teams that have made Tidepool part of the week.</p>\n          <ul>\n            <li>Up to twelve people</li>\n            <li>Full history and search</li>\n            <li>Friday wrap-up drafts</li>\n            <li>Carry-over rules and templates</li>\n            <li>Shared week archive export</li>\n          </ul>\n          <a href=\"#start\" class=\"btn btn-ink\">Try it free for 30 days</a>\n        </div>\n      </div>\n\n      <p class=\"pricing-note\">Prices in US dollars. Billed monthly, cancel any time, and your pages stay readable on the free plan.</p>\n    </div>\n  </section>\n\n  <!-- FAQ -->\n  <section class=\"section\" id=\"faq\" style=\"padding-top:40px\">\n    <div class=\"wrap faq-grid\">\n      <div class=\"section-num\">04 &mdash; Questions</div>\n      <div class=\"faq\">\n        <details open>\n          <summary>Is this just another project management tool?</summary>\n          <p>No. Tidepool does one thing: it helps a small team agree on what the week looks like and keep that agreement visible. It doesn't track sprints, estimate story points, or replace the tools you use to build things.</p>\n        </details>\n        <details>\n          <summary>How is it different from a shared document?</summary>\n          <p>A document doesn't know what week it is. Tidepool gives every week its own page, carries unfinished work forward, and drafts a wrap-up so the record builds itself instead of depending on someone remembering to write it.</p>\n        </details>\n        <details>\n          <summary>Can we bring in tasks from other tools?</summary>\n          <p>You can paste in a list or import a CSV in a few clicks. We're deliberately not building a dozen integrations; the goal is a clean weekly page, not a hub for everything.</p>\n        </details>\n        <details>\n          <summary>What happens to our data if we leave?</summary>\n          <p>You can export every week as a plain text or Markdown file at any time, including on the free plan. Your pages belong to you, and deleting a team removes its data within thirty days.</p>\n        </details>\n        <details>\n          <summary>Does it work on phones?</summary>\n          <p>Yes. The weekly page is responsive, so you can check off a task from the train or add a margin note from the back of a taxi. The layout is simplest on a laptop, but nothing essential is hidden on mobile.</p>\n        </details>\n      </div>\n    </div>\n  </section>\n\n  <!-- FINAL CTA -->\n  <section class=\"final\" id=\"start\">\n    <div class=\"wrap final-inner\">\n      <div>\n        <h2>Open this week's page <em>before Monday</em> starts.</h2>\n        <p>Bring your team in with a single link. The first page takes about two minutes to fill in, and it will still be there when you need it on Friday.</p>\n      </div>\n      <form onsubmit=\"event.preventDefault(); this.querySelector('button').textContent='Page opened. Check your inbox.';\">\n        <label for=\"email\">Work email</label>\n        <input id=\"email\" type=\"email\" placeholder=\"you@yourteam.com\" required>\n        <label for=\"team\">Team name</label>\n        <input id=\"team\" type=\"text\" placeholder=\"e.g. Larkspur\" autocomplete=\"organization\">\n        <button type=\"submit\" class=\"btn btn-ink\">Start a blank week &rarr;</button>\n        <p class=\"fine\">Free for up to five people. We'll only email about your page.</p>\n      </form>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <a href=\"#top\" class=\"logo\" style=\"color:var(--ink);font-size:18px\">\n      <svg class=\"logo-mark\" viewBox=\"0 0 26 26\" aria-hidden=\"true\" width=\"20\" height=\"20\">\n        <path d=\"M3 9 C 8 4, 18 4, 23 9\" fill=\"none\" stroke=\"#1f2a3c\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n        <path d=\"M3 15 C 8 10, 18 10, 23 15\" fill=\"none\" stroke=\"#2f6b67\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n        <path d=\"M5 21 C 10 17, 16 17, 21 21\" fill=\"none\" stroke=\"#b4532e\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n      </svg>\n      Tidepool\n    </a>\n    <ul>\n      <li><a href=\"#features\">Product</a></li>\n      <li><a href=\"#pricing\">Pricing</a></li>\n      <li><a href=\"#faq\">Help</a></li>\n      <li><a href=\"#top\">Privacy</a></li>\n      <li><a href=\"#top\">Terms</a></li>\n    </ul>\n    <p class=\"colophon\">Set in serif, ruled in ink, written every Monday. &copy; 2025 Tidepool.</p>\n  </div>\n</footer>\n\n</body>\n</html>\n"}