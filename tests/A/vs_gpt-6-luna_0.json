{"arm": "vs", "model": "openai/gpt-6-luna", "i": 0, "finish": "stop", "dirs": [{"direction": "Calm editorial \u2014 warm ivory canvas, deep navy typography, and generous whitespace; present weekly planning as a clear, reassuring ritual.", "probability": 0.28}, {"direction": "Playful tide charts \u2014 ocean-inspired colors, flowing curves, and buoy-like task markers; make team planning feel light and collaborative.", "probability": 0.24}, {"direction": "Practical workspace \u2014 crisp grid, compact cards, and a detailed product preview; emphasize how the tool works at a glance.", "probability": 0.2}, {"direction": "Human-first studio \u2014 candid team moments conveyed through simple illustrations, handwritten accents, and friendly copy; focus on shared ownership.", "probability": 0.16}, {"direction": "Bold typographic wave \u2014 oversized headline, high-contrast color blocks, and minimal interface details; give the brand an energetic, distinctive presence.", "probability": 0.12}], "pick": {"direction": "Playful tide charts \u2014 ocean-inspired colors, flowing curves, and buoy-like task markers; make team planning feel light and collaborative.", "probability": 0.24}, "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <meta name=\"theme-color\" content=\"#f6f8f3\">\n  <title>Tidepool \u2014 Make a little room for good work</title>\n  <style>\n    :root {\n      --ink: #143b48;\n      --ink-soft: #537079;\n      --ocean: #176f78;\n      --sea-glass: #cbe9df;\n      --foam: #f6f8f3;\n      --coral: #ff866d;\n      --sunshine: #f2cb70;\n      --lavender: #d9d8f4;\n      --line: #e6ece7;\n      --white: #fff;\n      --shadow: 0 24px 70px rgba(20, 59, 72, 0.11);\n    }\n\n    * { box-sizing: border-box; }\n\n    html { scroll-behavior: smooth; }\n\n    body {\n      margin: 0;\n      background: var(--foam);\n      color: var(--ink);\n      font-family: ui-rounded, \"Avenir Next\", Avenir, \"Segoe UI\", sans-serif;\n      -webkit-font-smoothing: antialiased;\n    }\n\n    a { color: inherit; text-decoration: none; }\n\n    .page {\n      width: min(1200px, calc(100% - 64px));\n      margin: 0 auto;\n    }\n\n    .topbar {\n      height: 88px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n    }\n\n    .brand {\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      font-size: 21px;\n      font-weight: 800;\n      letter-spacing: -0.8px;\n    }\n\n    .brand-mark {\n      width: 36px;\n      height: 36px;\n      display: grid;\n      place-items: center;\n      border-radius: 50%;\n      background: var(--ocean);\n      color: white;\n      box-shadow: inset 0 -4px 0 rgba(0, 0, 0, .08);\n    }\n\n    .brand-mark svg { width: 23px; height: 23px; }\n\n    .nav-links {\n      display: flex;\n      align-items: center;\n      gap: 34px;\n      color: var(--ink-soft);\n      font-size: 14px;\n      font-weight: 650;\n    }\n\n    .nav-links a:not(.nav-cta):hover { color: var(--ocean); }\n\n    .nav-cta, .button-primary {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: 9px;\n      border-radius: 999px;\n      background: var(--ink);\n      color: white;\n      font-size: 14px;\n      font-weight: 750;\n      transition: transform .2s ease, box-shadow .2s ease, background .2s ease;\n    }\n\n    .nav-cta {\n      padding: 12px 19px;\n      box-shadow: 0 5px 0 rgba(20, 59, 72, .12);\n    }\n\n    .nav-cta:hover, .button-primary:hover {\n      transform: translateY(-2px);\n      background: #205463;\n      box-shadow: 0 8px 20px rgba(20, 59, 72, .15);\n    }\n\n    .hero {\n      min-height: 620px;\n      display: grid;\n      grid-template-columns: .88fr 1.12fr;\n      align-items: center;\n      gap: 52px;\n      padding: 42px 0 76px;\n      position: relative;\n    }\n\n    .hero-copy { position: relative; z-index: 1; padding-bottom: 8px; }\n\n    .eyebrow {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      margin-bottom: 23px;\n      padding: 8px 12px;\n      border: 1px solid #dce9df;\n      border-radius: 999px;\n      color: var(--ocean);\n      background: rgba(255, 255, 255, .68);\n      font-size: 11px;\n      font-weight: 800;\n      letter-spacing: 1.1px;\n      text-transform: uppercase;\n    }\n\n    .eyebrow-dot {\n      width: 7px;\n      height: 7px;\n      border-radius: 50%;\n      background: var(--coral);\n      box-shadow: 0 0 0 4px #ff866d24;\n    }\n\n    h1 {\n      max-width: 560px;\n      margin: 0;\n      font-size: clamp(48px, 6.1vw, 76px);\n      line-height: .99;\n      letter-spacing: -5.4px;\n      font-weight: 800;\n    }\n\n    h1 .accent {\n      color: var(--ocean);\n      position: relative;\n      white-space: nowrap;\n    }\n\n    h1 .accent::after {\n      content: \"\";\n      height: 9px;\n      position: absolute;\n      left: 3px;\n      right: 5px;\n      bottom: -3px;\n      z-index: -1;\n      border-radius: 50%;\n      background: var(--sunshine);\n      transform: rotate(-2deg);\n    }\n\n    .hero-copy > p {\n      max-width: 440px;\n      margin: 25px 0 29px;\n      color: var(--ink-soft);\n      font-size: 17px;\n      line-height: 1.65;\n    }\n\n    .hero-actions {\n      display: flex;\n      align-items: center;\n      gap: 17px;\n    }\n\n    .button-primary { padding: 16px 22px; }\n\n    .button-primary svg { width: 16px; height: 16px; }\n\n    .quiet-link {\n      color: var(--ink-soft);\n      font-size: 13px;\n      font-weight: 700;\n    }\n\n    .quiet-link:hover { color: var(--ocean); }\n\n    .social-proof {\n      margin-top: 34px;\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      color: #73858a;\n      font-size: 12px;\n      font-weight: 600;\n    }\n\n    .avatars { display: flex; padding-left: 3px; }\n\n    .avatar {\n      width: 28px;\n      height: 28px;\n      display: grid;\n      place-items: center;\n      margin-left: -4px;\n      border: 2px solid var(--foam);\n      border-radius: 50%;\n      color: var(--ink);\n      font-size: 10px;\n      font-weight: 800;\n    }\n\n    .avatar:nth-child(1) { background: #f4c6a8; }\n    .avatar:nth-child(2) { background: #c7dbbb; }\n    .avatar:nth-child(3) { background: #d6d0ef; }\n    .avatar:nth-child(4) { background: #f2d77e; }\n\n    .hero-art {\n      min-width: 0;\n      position: relative;\n      padding: 8px 0 8px 9px;\n    }\n\n    .art-halo {\n      position: absolute;\n      width: 520px;\n      height: 470px;\n      top: 4px;\n      right: -38px;\n      z-index: -1;\n      border-radius: 48% 52% 49% 51%;\n      background:\n        radial-gradient(ellipse at 72% 28%, rgba(255, 211, 128, .56), transparent 34%),\n        radial-gradient(ellipse at 28% 71%, rgba(172, 220, 201, .72), transparent 48%),\n        #e9f1e8;\n      transform: rotate(-5deg);\n    }\n\n    .planner-card {\n      position: relative;\n      overflow: hidden;\n      border: 1px solid rgba(218, 229, 221, .9);\n      border-radius: 24px;\n      background: var(--white);\n      box-shadow: var(--shadow);\n      transform: rotate(1.1deg);\n    }\n\n    .planner-head {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 23px 25px 19px;\n    }\n\n    .planner-title {\n      margin: 0 0 5px;\n      font-size: 18px;\n      font-weight: 800;\n      letter-spacing: -.5px;\n    }\n\n    .planner-subtitle { color: #87979a; font-size: 11px; font-weight: 600; }\n\n    .week-pill {\n      display: flex;\n      align-items: center;\n      gap: 6px;\n      padding: 8px 11px;\n      border-radius: 999px;\n      background: #f1f7f2;\n      color: var(--ocean);\n      font-size: 10px;\n      font-weight: 800;\n    }\n\n    .week-pill span {\n      width: 6px;\n      height: 6px;\n      border-radius: 50%;\n      background: #6eb69a;\n    }\n\n    .chart-wrap {\n      position: relative;\n      height: 250px;\n      margin: 0 17px;\n      overflow: hidden;\n      border-radius: 14px;\n      background: linear-gradient(180deg, #fbfcfa 0%, #f5faf6 100%);\n    }\n\n    .chart-grid {\n      position: absolute;\n      inset: 18px 14px 36px 39px;\n      display: grid;\n      grid-template-columns: repeat(5, 1fr);\n      background-image:\n        linear-gradient(to right, #e8efeb 1px, transparent 1px),\n        linear-gradient(to bottom, #e8efeb 1px, transparent 1px);\n      background-size: 20% 100%, 100% 25%;\n      border-bottom: 1px solid #dfe9e3;\n    }\n\n    .chart-labels {\n      position: absolute;\n      top: 18px;\n      left: 8px;\n      bottom: 36px;\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      color: #a1aeaa;\n      font-size: 8px;\n      font-weight: 700;\n    }\n\n    .days {\n      position: absolute;\n      left: 39px;\n      right: 7px;\n      bottom: 11px;\n      display: grid;\n      grid-template-columns: repeat(5, 1fr);\n      text-align: center;\n      color: #809194;\n      font-size: 9px;\n      font-weight: 750;\n    }\n\n    .tide-line {\n      position: absolute;\n      inset: 0;\n      width: 100%;\n      height: 100%;\n      overflow: visible;\n    }\n\n    .tide-line .fill {\n      fill: url(#tideFill);\n      opacity: .75;\n    }\n\n    .tide-line .line {\n      fill: none;\n      stroke: #268d91;\n      stroke-width: 3;\n      stroke-linecap: round;\n      stroke-dasharray: 4 0;\n    }\n\n    .marker {\n      position: absolute;\n      z-index: 2;\n      display: flex;\n      align-items: center;\n      gap: 6px;\n      white-space: nowrap;\n      color: var(--ink);\n      font-size: 9px;\n      font-weight: 800;\n    }\n\n    .marker .buoy {\n      width: 19px;\n      height: 19px;\n      display: grid;\n      place-items: center;\n      border: 2px solid white;\n      border-radius: 50%;\n      color: white;\n      box-shadow: 0 2px 7px #143b4825;\n      font-size: 8px;\n    }\n\n    .marker.one { left: 20%; top: 34%; }\n    .marker.two { left: 47%; top: 53%; }\n    .marker.three { left: 68%; top: 25%; }\n    .marker.four { left: 78%; top: 69%; }\n    .marker.one .buoy { background: var(--coral); }\n    .marker.two .buoy { background: #8c88c9; }\n    .marker.three .buoy { background: #e8b94e; }\n    .marker.four .buoy { background: #55a58c; }\n\n    .floating-note {\n      position: absolute;\n      right: -17px;\n      top: 77px;\n      z-index: 3;\n      display: flex;\n      align-items: center;\n      gap: 9px;\n      padding: 11px 14px;\n      border: 1px solid #eee8d8;\n      border-radius: 14px;\n      background: #fffdf7;\n      box-shadow: 0 10px 30px rgba(20, 59, 72, .1);\n      transform: rotate(3deg);\n    }\n\n    .sun-icon {\n      width: 28px;\n      height: 28px;\n      display: grid;\n      place-items: center;\n      border-radius: 9px;\n      background: #fff1c6;\n      font-size: 15px;\n    }\n\n    .floating-note strong {\n      display: block;\n      font-size: 10px;\n      line-height: 1.4;\n    }\n\n    .floating-note small {\n      display: block;\n      color: #8a9995;\n      font-size: 9px;\n    }\n\n    .task-list {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 8px;\n      padding: 16px 20px 20px;\n    }\n\n    .task {\n      min-width: 0;\n      display: flex;\n      align-items: center;\n      gap: 9px;\n      padding: 9px 10px;\n      border: 1px solid #edf1ed;\n      border-radius: 11px;\n      background: #fff;\n    }\n\n    .task-dot {\n      width: 8px;\n      height: 8px;\n      flex: 0 0 auto;\n      border-radius: 50%;\n    }\n\n    .task:nth-child(1) .task-dot { background: var(--coral); }\n    .task:nth-child(2) .task-dot { background: #8c88c9; }\n    .task:nth-child(3) .task-dot { background: #e8b94e; }\n    .task:nth-child(4) .task-dot { background: #55a58c; }\n\n    .task span {\n      overflow: hidden;\n      color: #526b71;\n      font-size: 9px;\n      font-weight: 700;\n      text-overflow: ellipsis;\n      white-space: nowrap;\n    }\n\n    .section-divider {\n      height: 1px;\n      background: #e4ebe5;\n    }\n\n    .features {\n      padding: 50px 0 72px;\n    }\n\n    .features-intro {\n      display: flex;\n      align-items: end;\n      justify-content: space-between;\n      gap: 30px;\n      margin-bottom: 28px;\n    }\n\n    .section-kicker {\n      margin: 0 0 9px;\n      color: var(--ocean);\n      font-size: 10px;\n      font-weight: 850;\n      letter-spacing: 1.4px;\n      text-transform: uppercase;\n    }\n\n    h2 {\n      margin: 0;\n      font-size: 31px;\n      letter-spacing: -1.4px;\n    }\n\n    .features-intro > p {\n      max-width: 350px;\n      margin: 0 0 2px;\n      color: var(--ink-soft);\n      font-size: 13px;\n      line-height: 1.6;\n    }\n\n    .feature-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 15px;\n    }\n\n    .feature {\n      min-height: 164px;\n      padding: 21px;\n      border: 1px solid #e3ebe4;\n      border-radius: 17px;\n      background: rgba(255, 255, 255, .64);\n    }\n\n    .feature-icon {\n      width: 35px;\n      height: 35px;\n      display: grid;\n      place-items: center;\n      margin-bottom: 16px;\n      border-radius: 11px;\n      font-size: 17px;\n    }\n\n    .feature:nth-child(1) .feature-icon { background: #dff0e7; }\n    .feature:nth-child(2) .feature-icon { background: #fff0d0; }\n    .feature:nth-child(3) .feature-icon { background: #e6e3f8; }\n\n    .feature h3 {\n      margin: 0 0 7px;\n      font-size: 14px;\n      letter-spacing: -.2px;\n    }\n\n    .feature p {\n      max-width: 290px;\n      margin: 0;\n      color: var(--ink-soft);\n      font-size: 12px;\n      line-height: 1.55;\n    }\n\n    .bottom-cta {\n      position: relative;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 25px;\n      margin-bottom: 28px;\n      padding: 28px 34px;\n      border-radius: 20px;\n      background: #dcefe5;\n    }\n\n    .bottom-cta::after {\n      content: \"\";\n      position: absolute;\n      width: 240px;\n      height: 100px;\n      right: 220px;\n      bottom: -63px;\n      border: 2px solid rgba(38, 141, 145, .18);\n      border-radius: 50%;\n      box-shadow: 0 -12px 0 rgba(38, 141, 145, .05), 0 -24px 0 rgba(38, 141, 145, .04);\n      transform: rotate(-8deg);\n    }\n\n    .bottom-cta h2 { font-size: 24px; }\n    .bottom-cta p { margin: 6px 0 0; color: var(--ink-soft); font-size: 12px; }\n\n    .bottom-cta .button-primary { position: relative; z-index: 1; white-space: nowrap; }\n\n    footer {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 0 0 24px;\n      color: #82928e;\n      font-size: 11px;\n    }\n\n    footer .brand { color: var(--ink); font-size: 15px; }\n    footer .brand-mark { width: 27px; height: 27px; }\n    footer .brand-mark svg { width: 18px; height: 18px; }\n\n    .footer-links { display: flex; gap: 20px; }\n    .footer-links a:hover { color: var(--ocean); }\n\n    @media (max-width: 900px) {\n      .hero { grid-template-columns: 1fr; gap: 40px; padding-top: 48px; }\n      .hero-copy { max-width: 650px; }\n      .hero-art { width: min(650px, 100%); margin: 0 auto; }\n      .art-halo { right: -10px; }\n      .floating-note { right: -8px; }\n    }\n\n    @media (max-width: 620px) {\n      .page { width: min(100% - 36px, 480px); }\n      .topbar { height: 72px; }\n      .nav-links { gap: 0; }\n      .nav-links > a:not(.nav-cta) { display: none; }\n      .nav-cta { padding: 10px 14px; font-size: 12px; }\n      .hero { padding: 43px 0 55px; gap: 33px; }\n      h1 { font-size: clamp(48px, 14vw, 66px); letter-spacing: -3.8px; }\n      .hero-copy > p { font-size: 15px; }\n      .hero-actions { flex-wrap: wrap; }\n      .social-proof { margin-top: 25px; }\n      .planner-card { border-radius: 18px; }\n      .planner-head { padding: 19px 16px 15px; }\n      .chart-wrap { height: 220px; margin: 0 10px; }\n      .marker { font-size: 7px; gap: 3px; }\n      .marker .buoy { width: 17px; height: 17px; }\n      .marker.one { left: 16%; }\n      .marker.two { left: 43%; }\n      .marker.three { left: 65%; }\n      .marker.four { left: 73%; }\n      .floating-note { top: 57px; right: -6px; padding: 8px 10px; }\n      .task-list { padding: 12px; gap: 6px; }\n      .task { padding: 8px 7px; }\n      .task span { font-size: 8px; }\n      .features { padding: 39px 0 48px; }\n      .features-intro { display: block; }\n      .features-intro > p { margin-top: 12px; }\n      h2 { font-size: 27px; }\n      .feature-grid { grid-template-columns: 1fr; gap: 9px; }\n      .feature { min-height: auto; padding: 17px; }\n      .feature-icon { margin-bottom: 11px; }\n      .bottom-cta { display: block; padding: 24px; }\n      .bottom-cta .button-primary { margin-top: 17px; }\n      .bottom-cta::after { right: 10px; }\n      footer { align-items: flex-start; gap: 14px; flex-direction: column; }\n      .footer-links { gap: 15px; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      *, *::before, *::after {\n        scroll-behavior: auto !important;\n        transition-duration: .01ms !important;\n      }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"page\">\n    <header class=\"topbar\">\n      <a class=\"brand\" href=\"#\" aria-label=\"Tidepool home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M3 9.2c2.3 0 2.3-2.4 4.6-2.4s2.3 2.4 4.6 2.4 2.3-2.4 4.6-2.4 2.3 2.4 4.6 2.4M3 15.4c2.3 0 2.3-2.4 4.6-2.4s2.3 2.4 4.6 2.4 2.3-2.4 4.6-2.4 2.3 2.4 4.6 2.4\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n          </svg>\n        </span>\n        tidepool\n      </a>\n      <nav class=\"nav-links\" aria-label=\"Main navigation\">\n        <a href=\"#how-it-works\">How it works</a>\n        <a href=\"#why-tidepool\">Why Tidepool</a>\n        <a class=\"nav-cta\" href=\"#get-started\">Plan your week <span aria-hidden=\"true\">\u2197</span></a>\n      </nav>\n    </header>\n\n    <main>\n      <section class=\"hero\" aria-labelledby=\"hero-title\">\n        <div class=\"hero-copy\">\n          <div class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> A calmer kind of planning</div>\n          <h1 id=\"hero-title\">Make a little room for <span class=\"accent\">good work.</span></h1>\n          <p>Tidepool helps small teams shape the week together\u2014so everyone knows what matters, and there\u2019s still space to breathe.</p>\n          <div class=\"hero-actions\">\n            <a class=\"button-primary\" href=\"#get-started\">\n              Plan your week\n              <svg viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 10h11m-4-4 4 4-4 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            </a>\n            <a class=\"quiet-link\" href=\"#how-it-works\">Take a little look \u2193</a>\n          </div>\n          <div class=\"social-proof\">\n            <div class=\"avatars\" aria-hidden=\"true\">\n              <span class=\"avatar\">M</span><span class=\"avatar\">J</span><span class=\"avatar\">A</span><span class=\"avatar\">R</span>\n            </div>\n            <span>For small teams finding their flow</span>\n          </div>\n        </div>\n\n        <div class=\"hero-art\" aria-label=\"A preview of a shared Tidepool weekly plan\">\n          <div class=\"art-halo\" aria-hidden=\"true\"></div>\n          <div class=\"floating-note\">\n            <span class=\"sun-icon\" aria-hidden=\"true\">\u2600</span>\n            <span><strong>Room to focus</strong><small>Wednesday afternoon</small></span>\n          </div>\n\n          <div class=\"planner-card\">\n            <div class=\"planner-head\">\n              <div>\n                <p class=\"planner-title\">The week ahead</p>\n                <div class=\"planner-subtitle\">Your team\u2019s plans, in one place</div>\n              </div>\n              <div class=\"week-pill\"><span></span> LOOKING GOOD</div>\n            </div>\n\n            <div class=\"chart-wrap\">\n              <div class=\"chart-labels\" aria-hidden=\"true\">\n                <span>HIGH TIDE</span><span></span><span></span><span>LOW TIDE</span>\n              </div>\n              <div class=\"chart-grid\" aria-hidden=\"true\"></div>\n              <svg class=\"tide-line\" viewBox=\"0 0 600 250\" preserveAspectRatio=\"none\" aria-hidden=\"true\">\n                <defs>\n                  <linearGradient id=\"tideFill\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                    <stop offset=\"0%\" stop-color=\"#65bba7\" stop-opacity=\".22\"/>\n                    <stop offset=\"100%\" stop-color=\"#65bba7\" stop-opacity=\"0\"/>\n                  </linearGradient>\n                </defs>\n                <path class=\"fill\" d=\"M30 160 C95 142 105 75 175 89 S255 176 325 146 S420 62 470 91 S530 186 590 132 L590 215 L30 215 Z\"/>\n                <path class=\"line\" d=\"M30 160 C95 142 105 75 175 89 S255 176 325 146 S420 62 470 91 S530 186 590 132\"/>\n              </svg>\n              <div class=\"marker one\"><span class=\"buoy\">M</span><span>Launch page</span></div>\n              <div class=\"marker two\"><span class=\"buoy\">J</span><span>Partner sync</span></div>\n              <div class=\"marker three\"><span class=\"buoy\">A</span><span>Design review</span></div>\n              <div class=\"marker four\"><span class=\"buoy\">R</span><span>Ship it!</span></div>\n              <div class=\"days\" aria-hidden=\"true\">\n                <span>MON</span><span>TUE</span><span>WED</span><span>THU</span><span>FRI</span>\n              </div>\n            </div>\n\n            <div class=\"task-list\" aria-label=\"This week's shared tasks\">\n              <div class=\"task\"><span class=\"task-dot\"></span><span>Launch page \u00b7 Maya</span></div>\n              <div class=\"task\"><span class=\"task-dot\"></span><span>Partner sync \u00b7 Jules</span></div>\n              <div class=\"task\"><span class=\"task-dot\"></span><span>Design review \u00b7 Alex</span></div>\n              <div class=\"task\"><span class=\"task-dot\"></span><span>Ship it! \u00b7 Rowan</span></div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <div class=\"section-divider\"></div>\n\n      <section class=\"features\" id=\"how-it-works\" aria-labelledby=\"features-title\">\n        <div class=\"features-intro\">\n          <div>\n            <p class=\"section-kicker\">Less calendar tetris</p>\n            <h2 id=\"features-title\">Find your team\u2019s natural rhythm.</h2>\n          </div>\n          <p>A good week isn\u2019t wall-to-wall busy. Tidepool makes it easier to see the shape of your work\u2014and make a plan that works for everyone.</p>\n        </div>\n\n        <div class=\"feature-grid\" id=\"why-tidepool\">\n          <article class=\"feature\">\n            <div class=\"feature-icon\" aria-hidden=\"true\">\u3030</div>\n            <h3>See the whole tide</h3>\n            <p>Bring priorities, projects, and people into one simple view of the week.</p>\n          </article>\n          <article class=\"feature\">\n            <div class=\"feature-icon\" aria-hidden=\"true\">\u2693</div>\n            <h3>Drop tasks together</h3>\n            <p>Give every good idea an owner and a place to land\u2014without another meeting.</p>\n          </article>\n          <article class=\"feature\">\n            <div class=\"feature-icon\" aria-hidden=\"true\">\u2733</div>\n            <h3>Leave room to breathe</h3>\n            <p>Make space for focus time, the unexpected, and work that takes a little longer.</p>\n          </article>\n        </div>\n      </section>\n\n      <section class=\"bottom-cta\" id=\"get-started\" aria-label=\"Get started with Tidepool\">\n        <div>\n          <h2>Make next week feel lighter.</h2>\n          <p>Gather your crew. Pick your priorities. Find your flow.</p>\n        </div>\n        <a class=\"button-primary\" href=\"mailto:hello@tidepool.team\">Get started with Tidepool <span aria-hidden=\"true\">\u2197</span></a>\n      </section>\n    </main>\n\n    <footer>\n      <a class=\"brand\" href=\"#\" aria-label=\"Tidepool home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M3 9.2c2.3 0 2.3-2.4 4.6-2.4s2.3 2.4 4.6 2.4 2.3-2.4 4.6-2.4 2.3 2.4 4.6 2.4M3 15.4c2.3 0 2.3-2.4 4.6-2.4s2.3 2.4 4.6 2.4 2.3-2.4 4.6-2.4 2.3 2.4 4.6 2.4\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n          </svg>\n        </span>\n        tidepool\n      </a>\n      <span>Small teams, better weeks. \u00a9 2025 Tidepool</span>\n      <div class=\"footer-links\">\n        <a href=\"mailto:hello@tidepool.team\">Say hello</a>\n        <a href=\"#get-started\">Get started</a>\n      </div>\n    </footer>\n  </div>\n</body>\n</html>\n"}