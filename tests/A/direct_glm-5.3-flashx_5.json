{"arm": "direct", "model": "z-ai/glm-5.3-flashx", "i": 5, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Tidepool \u2014 Plan your week together</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,600;9..144,700&family=Instrument+Sans:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --ink:#0e2f2c;\n    --ink-soft:#3b5a55;\n    --paper:#f6f1e6;\n    --paper-deep:#efe7d6;\n    --coral:#e4572e;\n    --foam:#d8ebe2;\n    --sea:#1d6b5e;\n    --line:rgba(14,47,44,.16);\n    --serif:'Fraunces',serif;\n    --sans:'Instrument Sans',sans-serif;\n  }\n  *{margin:0;padding:0;box-sizing:border-box}\n  html{scroll-behavior:smooth}\n  body{background:var(--paper);color:var(--ink);font-family:var(--sans);line-height:1.6;overflow-x:hidden}\n  ::selection{background:var(--coral);color:var(--paper)}\n\n  /* ---------- Nav ---------- */\n  nav{position:fixed;top:0;left:0;right:0;z-index:100;display:flex;align-items:center;justify-content:space-between;\n      padding:1.1rem clamp(1.2rem,5vw,4rem);transition:background .35s,box-shadow .35s}\n  nav.scrolled{background:rgba(246,241,230,.92);backdrop-filter:blur(10px);box-shadow:0 1px 0 var(--line)}\n  .logo{display:flex;align-items:center;gap:.55rem;font-family:var(--serif);font-weight:700;font-size:1.35rem;letter-spacing:-.01em;text-decoration:none;color:var(--ink)}\n  .logo svg{display:block}\n  .nav-links{display:flex;align-items:center;gap:2.2rem;list-style:none}\n  .nav-links a{color:var(--ink);text-decoration:none;font-size:.92rem;font-weight:500;position:relative}\n  .nav-links a:not(.btn)::after{content:'';position:absolute;left:0;bottom:-4px;width:0;height:2px;background:var(--coral);transition:width .25s}\n  .nav-links a:not(.btn):hover::after{width:100%}\n  .btn{display:inline-flex;align-items:center;gap:.5rem;background:var(--ink);color:var(--paper);border:none;cursor:pointer;\n       font-family:var(--sans);font-weight:600;font-size:.92rem;padding:.7rem 1.4rem;border-radius:999px;text-decoration:none;\n       transition:transform .2s,background .2s}\n  .btn:hover{background:var(--coral);transform:translateY(-2px)}\n  .btn.ghost{background:transparent;color:var(--ink);box-shadow:inset 0 0 0 1.5px var(--ink)}\n  .btn.ghost:hover{background:var(--ink);color:var(--paper);transform:translateY(-2px)}\n  .btn.coral{background:var(--coral)}\n  .btn.coral:hover{background:var(--ink)}\n\n  /* ---------- Hero ---------- */\n  .hero{position:relative;min-height:100svh;display:flex;flex-direction:column;justify-content:flex-end;overflow:hidden}\n  #tideCanvas{position:absolute;inset:0;width:100%;height:100%}\n  .hero-inner{position:relative;z-index:2;padding:9rem clamp(1.2rem,5vw,4rem) 0;max-width:1200px;margin:0 auto;width:100%}\n  .kicker{display:inline-flex;align-items:center;gap:.6rem;font-size:.8rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--sea);\n          border:1px solid rgba(29,107,94,.35);padding:.4rem 1rem;border-radius:999px;background:rgba(216,235,226,.5);margin-bottom:1.6rem}\n  .kicker .dot{width:7px;height:7px;border-radius:50%;background:var(--coral);animation:pulse 2.4s infinite}\n  @keyframes pulse{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(1.5);opacity:.5}}\n  h1{font-family:var(--serif);font-weight:400;font-size:clamp(2.9rem,7.5vw,6.2rem);line-height:1.02;letter-spacing:-.02em;max-width:13ch}\n  h1 em{font-style:italic;font-weight:600;color:var(--sea)}\n  h1 .wave-underline{position:relative;white-space:nowrap}\n  h1 .wave-underline svg{position:absolute;left:0;bottom:-.18em;width:100%;height:.28em;overflow:visible}\n  h1 .wave-underline path{fill:none;stroke:var(--coral);stroke-width:5;stroke-linecap:round;\n    stroke-dasharray:520;stroke-dashoffset:520;animation:draw 1.6s .8s ease forwards}\n  @keyframes draw{to{stroke-dashoffset:0}}\n  .hero-sub{margin-top:1.6rem;font-size:clamp(1.05rem,1.6vw,1.25rem);color:var(--ink-soft);max-width:44ch}\n  .hero-ctas{display:flex;gap:1rem;margin-top:2.2rem;flex-wrap:wrap}\n  .hero-foot{position:relative;z-index:2;margin-top:auto;padding:3rem clamp(1.2rem,5vw,4rem) 2.4rem;display:flex;justify-content:space-between;\n             align-items:flex-end;gap:2rem;flex-wrap:wrap}\n  .hero-foot p{font-size:.85rem;color:var(--ink-soft);max-width:26ch}\n  .scroll-hint{display:flex;align-items:center;gap:.6rem;font-size:.8rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-soft)}\n  .scroll-hint svg{animation:bob 1.8s ease-in-out infinite}\n  @keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(6px)}}\n\n  /* ---------- Marquee ---------- */\n  .strip{background:var(--ink);color:var(--paper);overflow:hidden;padding:.9rem 0;border-block:3px solid var(--ink)}\n  .strip-track{display:flex;gap:3.5rem;width:max-content;animation:slide 30s linear infinite;font-family:var(--serif);font-style:italic;font-size:1.05rem;opacity:.9}\n  .strip-track span{display:flex;align-items:center;gap:3.5rem;white-space:nowrap}\n  @keyframes slide{to{transform:translateX(-50%)}}\n\n  /* ---------- Sections ---------- */\n  section{padding:clamp(5rem,9vw,8.5rem) clamp(1.2rem,5vw,4rem)}\n  .wrap{max-width:1200px;margin:0 auto}\n  .eyebrow{font-size:.78rem;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--coral);margin-bottom:1rem}\n  h2{font-family:var(--serif);font-weight:400;font-size:clamp(2rem,4.5vw,3.4rem);line-height:1.08;letter-spacing:-.015em;max-width:22ch}\n  h2 em{font-style:italic;font-weight:600;color:var(--sea)}\n\n  .reveal{opacity:0;transform:translateY(28px);transition:opacity .8s ease,transform .8s ease}\n  .reveal.in{opacity:1;transform:none}\n\n  /* ---------- Demo board ---------- */\n  .demo{background:var(--paper-deep);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}\n  .demo-head{display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:1.5rem;margin-bottom:2.5rem}\n  .board{background:var(--paper);border:1px solid var(--line);border-radius:22px;overflow:hidden;box-shadow:0 24px 60px -30px rgba(14,47,44,.28)}\n  .board-top{display:flex;align-items:center;justify-content:space-between;padding:1.1rem 1.5rem;border-bottom:1px solid var(--line);flex-wrap:wrap;gap:1rem}\n  .board-title{font-family:var(--serif);font-size:1.15rem;display:flex;align-items:center;gap:.6rem}\n  .avatar-row{display:flex}\n  .avatar{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.7rem;font-weight:600;\n          color:var(--paper);border:2px solid var(--paper);margin-left:-8px}\n  .avatar:first-child{margin-left:0}\n  .pool{display:flex;align-items:center;gap:.7rem;flex-wrap:wrap;padding:1.1rem 1.5rem;border-bottom:1px solid var(--line);background:rgba(216,235,226,.28)}\n  .pool-label{font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft);margin-right:.4rem}\n  .chip{display:inline-flex;align-items:center;gap:.45rem;padding:.45rem .9rem;border-radius:999px;background:var(--paper);\n        border:1.5px dashed rgba(14,47,44,.35);font-size:.85rem;font-weight:500;cursor:grab;transition:all .2s;user-select:none}\n  .chip svg{flex:none}\n  .chip:hover{border-color:var(--coral);color:var(--coral);transform:translateY(-2px)}\n  .chip.placed{opacity:0;pointer-events:none;position:absolute}\n  .week{display:grid;grid-template-columns:repeat(5,1fr);min-height:300px}\n  .day{padding:1.2rem 1.1rem;border-right:1px solid var(--line);transition:background .25s;position:relative}\n  .day:last-child{border-right:none}\n  .day.over{background:var(--foam)}\n  .day h4{font-size:.8rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-soft);display:flex;justify-content:space-between}\n  .day h4 .count{color:var(--coral)}\n  .day .slot{margin-top:.9rem;min-height:200px}\n  .task{background:var(--foam);border-radius:12px;padding:.7rem .85rem;font-size:.87rem;font-weight:500;margin-bottom:.6rem;cursor:grab;\n        border-left:4px solid var(--sea);animation:settle .5s ease;transition:transform .2s,box-shadow .2s;position:relative}\n  .task:hover{transform:translateY(-2px);box-shadow:0 8px 18px -8px rgba(14,47,44,.3)}\n  .task.coral{border-left-color:var(--coral)}\n  .task small{display:block;font-weight:400;color:var(--ink-soft);font-size:.75rem;margin-top:.15rem}\n  @keyframes settle{from{opacity:0;transform:translateY(14px) scale(.95)}to{opacity:1;transform:none}}\n  .ripple{position:absolute;inset:0;border-radius:12px;border:2px solid var(--sea);animation:rip .7s ease forwards;pointer-events:none}\n  @keyframes rip{to{transform:scale(1.12);opacity:0}}\n  .day-empty{font-size:.8rem;color:var(--ink-soft);font-style:italic;font-family:var(--serif);opacity:.7}\n  .board-note{display:flex;align-items:center;gap:.55rem;padding:.9rem 1.5rem;border-top:1px solid var(--line);font-size:.83rem;color:var(--ink-soft)}\n  .board-note svg{flex:none}\n\n  /* ---------- Principles (asymmetric) ---------- */\n  .principles .row{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,6vw,6rem);align-items:center;padding:3.5rem 0;border-bottom:1px solid var(--line)}\n  .principles .row:first-of-type{padding-top:0}\n  .principles .row:last-of-type{border-bottom:none;padding-bottom:0}\n  .principles .row:nth-child(even) .visual{order:-1}\n  .pnum{font-family:var(--serif);font-style:italic;font-size:1rem;color:var(--coral);margin-bottom:.7rem;display:block}\n  .principles h3{font-family:var(--serif);font-weight:400;font-size:clamp(1.6rem,3vw,2.3rem);line-height:1.15;margin-bottom:1rem}\n  .principles p{color:var(--ink-soft);max-width:42ch}\n  .visual{background:var(--foam);border-radius:24px;padding:2.2rem;position:relative;overflow:hidden;min-height:280px;display:flex;align-items:center;justify-content:center}\n  .visual .cap{position:absolute;bottom:1rem;left:1.4rem;font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:var(--sea);font-weight:600}\n\n  /* mini week viz */\n  .miniweek{display:flex;gap:.6rem;width:100%;max-width:340px}\n  .miniweek .col{flex:1;background:var(--paper);border-radius:10px;padding:.7rem .55rem;box-shadow:0 6px 14px -8px rgba(14,47,44,.25)}\n  .miniweek .col b{display:block;font-size:.62rem;text-transform:uppercase;letter-spacing:.08em;color:var(--ink-soft);margin-bottom:.5rem}\n  .bar{height:8px;border-radius:4px;background:var(--sea);margin-bottom:.4rem;animation:grow 1.2s ease backwards}\n  .bar.c{background:var(--coral)}\n  .bar:nth-child(2){animation-delay:.1s}.bar:nth-child(3){animation-delay:.2s}.bar:nth-child(4){animation-delay:.3s}\n  @keyframes grow{from{width:0 !important}}\n  .w1{width:90%}.w2{width:55%}.w3{width:75%}.w4{width:35%}\n\n  /* chat viz */\n  .chat{width:100%;max-width:340px;display:flex;flex-direction:column;gap:.7rem}\n  .bubble{background:var(--paper);padding:.7rem 1rem;border-radius:14px;font-size:.85rem;max-width:85%;box-shadow:0 6px 14px -8px rgba(14,47,44,.25);\n          opacity:0;transform:translateY(10px)}\n  .bubble.show{opacity:1;transform:none;transition:all .5s ease}\n  .bubble.me{align-self:flex-end;background:var(--sea);color:var(--paper);border-bottom-right-radius:4px}\n  .bubble.them{border-bottom-left-radius:4px}\n  .bubble .who{font-size:.68rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;opacity:.55;display:block;margin-bottom:.15rem}\n\n  /* tide viz */\n  .tideviz{width:100%;max-width:360px}\n  .tideviz svg{width:100%;height:auto;display:block}\n  .tideviz path{fill:none;stroke:var(--sea);stroke-width:2.5;stroke-linecap:round}\n  .tideviz .hl{stroke:var(--coral);stroke-width:3.5}\n\n  /* ---------- Quote ---------- */\n  .quote{background:var(--ink);color:var(--paper);text-align:center}\n  .quote blockquote{font-family:var(--serif);font-weight:300;font-style:italic;font-size:clamp(1.5rem,3.4vw,2.6rem);line-height:1.3;max-width:26ch;margin:0 auto}\n  .quote blockquote strong{font-weight:600;color:#8fd0bd}\n  .quote cite{display:block;margin-top:2rem;font-style:normal;font-size:.9rem;color:#8fa8a2}\n  .quote cite b{color:var(--paper);font-weight:600}\n\n  /* ---------- Pricing ---------- */\n  .price-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:1.4rem;margin-top:3rem;align-items:stretch}\n  .plan{border:1px solid var(--line);border-radius:22px;padding:2.4rem;background:var(--paper);display:flex;flex-direction:column}\n  .plan.featured{background:var(--ink);color:var(--paper);border-color:var(--ink);position:relative;overflow:hidden}\n  .plan h3{font-family:var(--serif);font-size:1.5rem;font-weight:400}\n  .plan .amount{font-family:var(--serif);font-size:clamp(2.6rem,5vw,3.8rem);font-weight:600;margin:1rem 0 .2rem;letter-spacing:-.02em}\n  .plan .amount span{font-size:1rem;font-family:var(--sans);font-weight:400;opacity:.6}\n  .plan ul{list-style:none;margin:1.4rem 0 2rem;flex:1}\n  .plan li{display:flex;gap:.7rem;padding:.45rem 0;font-size:.94rem;align-items:flex-start}\n  .plan li svg{flex:none;margin-top:.28rem}\n  .plan.featured .tag{position:absolute;top:1.4rem;right:1.4rem;background:var(--coral);color:var(--paper);font-size:.7rem;font-weight:600;\n                      letter-spacing:.1em;text-transform:uppercase;padding:.35rem .8rem;border-radius:999px}\n  .plan .btn{justify-content:center}\n\n  /* ---------- CTA + Footer ---------- */\n  .final{text-align:center;background:var(--paper-deep);border-top:1px solid var(--line)}\n  .final h2{margin:0 auto 1.4rem}\n  footer{background:var(--ink);color:#8fa8a2;padding:3rem clamp(1.2rem,5vw,4rem)}\n  .foot-wrap{max-width:1200px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1.5rem}\n  footer .logo{color:var(--paper)}\n  footer ul{display:flex;gap:1.8rem;list-style:none}\n  footer a{color:#8fa8a2;text-decoration:none;font-size:.88rem}\n  footer a:hover{color:var(--paper)}\n\n  /* ---------- Wave dividers ---------- */\n  .divider{display:block;width:100%;height:auto}\n\n  @media (max-width:860px){\n    .nav-links li:not(:last-child){display:none}\n    .week{grid-template-columns:1fr 1fr}\n    .day{border-bottom:1px solid var(--line)}\n    .principles .row,.price-grid{grid-template-columns:1fr}\n    .principles .row:nth-child(even) .visual{order:0}\n    .hero-foot{padding-bottom:1.5rem}\n  }\n</style>\n</head>\n<body>\n\n<nav id=\"nav\">\n  <a class=\"logo\" href=\"#\">\n    <svg width=\"30\" height=\"30\" viewBox=\"0 0 30 30\" fill=\"none\">\n      <circle cx=\"15\" cy=\"15\" r=\"13.5\" stroke=\"#0e2f2c\" stroke-width=\"2\"/>\n      <path d=\"M4 18c3-3 6-3 9 0s6 3 9 0\" stroke=\"#e4572e\" stroke-width=\"2.4\" stroke-linecap=\"round\"/>\n      <path d=\"M6 13c2.5-2.5 5-2.5 7.5 0\" stroke=\"#1d6b5e\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n    </svg>\n    Tidepool\n  </a>\n  <ul class=\"nav-links\">\n    <li><a href=\"#demo\">The board</a></li>\n    <li><a href=\"#how\">How it works</a></li>\n    <li><a href=\"#pricing\">Pricing</a></li>\n    <li><a class=\"btn\" href=\"#pricing\">Start free</a></li>\n  </ul>\n</nav>\n\n<!-- ============ HERO ============ -->\n<header class=\"hero\">\n  <canvas id=\"tideCanvas\"></canvas>\n  <div class=\"hero-inner\">\n    <span class=\"kicker\"><span class=\"dot\"></span>Weekly planning, without the meeting marathon</span>\n    <h1>Every week has a rhythm. <span class=\"wave-underline\">Tidepool<svg viewBox=\"0 0 300 20\" preserveAspectRatio=\"none\"><path d=\"M2 12 Q 30 2, 60 11 T 120 11 T 180 11 T 240 11 T 298 11\"/></svg></span> helps your team find it. <em>Together.</em></h1>\n    <p class=\"hero-sub\">A calm, shared space where small teams shape their week \u2014 see who's doing what, spot the overload before it happens, and spend less time syncing.</p>\n    <div class=\"hero-ctas\">\n      <a class=\"btn coral\" href=\"#demo\">Try the live board\n        <svg width=\"15\" height=\"15\" viewBox=\"0 0 15 15\" fill=\"none\"><path d=\"M2 7.5h11m0 0L8.5 3M13 7.5 8.5 12\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n      </a>\n      <a class=\"btn ghost\" href=\"#how\">How it works</a>\n    </div>\n  </div>\n  <div class=\"hero-foot\">\n    <p>Free for teams of five. No credit card, no onboarding call, no nonsense.</p>\n    <div class=\"scroll-hint\">Dip your toes in\n      <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M8 2v11m0 0 4.5-4.5M8 13 3.5 8.5\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n    </div>\n  </div>\n</header>\n\n<div class=\"strip\" aria-hidden=\"true\">\n  <div class=\"strip-track\">\n    <span>MondayIntentions \u2733 One board, one week \u2733 Fewer meetings, more doing \u2733 Plans that breathe \u2733&nbsp;</span>\n    <span>MondayIntentions \u2733 One board, one week \u2733 Fewer meetings, more doing \u2733 Plans that breathe \u2733&nbsp;</span>\n  </div>\n</div>\n\n<!-- ============ DEMO ============ -->\n<section class=\"demo\" id=\"demo\">\n  <div class=\"wrap\">\n    <div class=\"demo-head reveal\">\n      <div>\n        <p class=\"eyebrow\">A real board, right here</p>\n        <h2>Drag a task into the week. <em>Feel the calm.</em></h2>\n      </div>\n      <p style=\"max-width:30ch;color:var(--ink-soft)\">This isn't a screenshot \u2014 it's the actual planner. Grab a chip below and drop it on a day.</p>\n    </div>\n\n    <div class=\"board reveal\">\n      <div class=\"board-top\">\n        <div class=\"board-title\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 30 30\" fill=\"none\"><circle cx=\"15\" cy=\"15\" r=\"13\" stroke=\"#0e2f2c\" stroke-width=\"2\"/><path d=\"M4 18c3-3 6-3 9 0s6 3 9 0\" stroke=\"#e4572e\" stroke-width=\"2.4\" stroke-linecap=\"round\"/></svg>\n          Week of March 10\n        </div>\n        <div class=\"avatar-row\" aria-label=\"Team members\">\n          <div class=\"avatar\" style=\"background:#1d6b5e\">MK</div>\n          <div class=\"avatar\" style=\"background:#e4572e\">JT</div>\n          <div class=\"avatar\" style=\"background:#7a5ba6\">AL</div>\n          <div class=\"avatar\" style=\"background:#c58c2a\">RS</div>\n        </div>\n      </div>\n\n      <div class=\"pool\" id=\"pool\">\n        <span class=\"pool-label\">Unassigned</span>\n        <span class=\"chip\" draggable=\"true\" data-name=\"Draft launch copy\" data-who=\"MK\">\n          <svg width=\"13\" height=\"13\" viewBox=\"0 0 14 14\" fill=\"none\"><path d=\"M2 12 3 8.5 10 1.7a1.4 1.4 0 0 1 2 2L5.3 10.8 2 12Z\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linejoin=\"round\"/></svg>\n          Draft launch copy</span>\n        <span class=\"chip\" draggable=\"true\" data-name=\"User interviews \u00d73\" data-who=\"AL\">\n          <svg width=\"13\" height=\"13\" viewBox=\"0 0 14 14\" fill=\"none\"><circle cx=\"5\" cy=\"4.5\" r=\"2.4\" stroke=\"currentColor\" stroke-width=\"1.4\"/><path d=\"M1.5 12c.5-2.4 2-3.6 3.5-3.6S8 9.6 8.5 12M9.5 2.6a2.4 2.4 0 0 1 0 3.9M10.4 8.6c1.2.5 1.9 1.7 2.1 3.4\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\"/></svg>\n          User interviews \u00d73</span>\n        <span class=\"chip\" draggable=\"true\" data-name=\"Fix onboarding bug\" data-who=\"JT\" data-coral=\"1\">\n          <svg width=\"13\" height=\"13\" viewBox=\"0 0 14 14\" fill=\"none\"><path d=\"M7 1.5v3M7 9.5v3M1.5 7h3M9.5 7h3M3 3l2 2M9 9l2 2M11 3 9 5M5 9l-2 2\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\"/></svg>\n          Fix onboarding bug</span>\n        <span class=\"chip\" draggable=\"true\" data-name=\"Team retro\" data-who=\"All\">\n          <svg width=\"13\" height=\"13\" viewBox=\"0 0 14 14\" fill=\"none\"><circle cx=\"7\" cy=\"7\" r=\"5.5\" stroke=\"currentColor\" stroke-width=\"1.4\"/><path d=\"M7 4v3.2l2.2 1.4\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\"/></svg>\n          Team retro</span>\n        <span class=\"chip\" draggable=\"true\" data-name=\"Ship pricing page\" data-who=\"MK + JT\">\n          <svg width=\"13\" height=\"13\" viewBox=\"0 0 14 14\" fill=\"none\"><path d=\"M2 7.5 6 11l6-8\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          Ship pricing page</span>\n      </div>\n\n      <div class=\"week\" id=\"week\">\n        <div class=\"day\" data-day=\"Mon\"><h4>Monday</h4><div class=\"slot\"><p class=\"day-empty\">calm waters\u2026</p></div></div>\n        <div class=\"day\" data-day=\"Tue\"><h4>Tuesday</h4><div class=\"slot\"><p class=\"day-empty\">calm waters\u2026</p></div></div>\n        <div class=\"day\" data-day=\"Wed\"><h4>Wednesday</h4><div class=\"slot\"><p class=\"day-empty\">calm waters\u2026</p></div></div>\n        <div class=\"day\" data-day=\"Thu\"><h4>Thursday</h4><div class=\"slot\"><p class=\"day-empty\">calm waters\u2026</p></div></div>\n        <div class=\"day\" data-day=\"Fri\"><h4>Friday</h4><div class=\"slot\"><p class=\"day-empty\">calm waters\u2026</p></div></div>\n      </div>\n\n      <div class=\"board-note\">\n        <svg width=\"15\" height=\"15\" viewBox=\"0 0 15 15\" fill=\"none\"><circle cx=\"7.5\" cy=\"7.5\" r=\"6.5\" stroke=\"#e4572e\" stroke-width=\"1.5\"/><path d=\"M7.5 7v4M7.5 4.2v.3\" stroke=\"#e4572e\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg>\n        Click a placed task to send it back to the pool. Everyone sees the board change in real time.\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ PRINCIPLES ============ -->\n<section class=\"principles\" id=\"how\">\n  <div class=\"wrap\">\n    <div class=\"reveal\" style=\"margin-bottom:1rem\">\n      <p class=\"eyebrow\">How it works</p>\n      <h2>Three small habits. <em>That's the whole method.</em></h2>\n    </div>\n\n    <div class=\"row reveal\">\n      <div>\n        <span class=\"pnum\">No. 01</span>\n        <h3>Set intentions Monday morning</h3>\n        <p>Everyone drops their focus tasks on the shared board before their first coffee. Two minutes each \u2014 no stand-up required. The week starts aligned.</p>\n      </div>\n      <div class=\"visual\">\n        <div class=\"miniweek\">\n          <div class=\"col\"><b>M</b><div class=\"bar w2\"></div><div class=\"bar c w4\"></div></div>\n          <div class=\"col\"><b>T</b><div class=\"bar w3\"></div><div class=\"bar c w1\"></div></div>\n          <div class=\"col\"><b>W</b><div class=\"bar w1\"></div><div class=\"bar w4\"></div></div>\n          <div class=\"col\"><b>T</b><div class=\"bar c w3\"></div><div class=\"bar w2\"></div></div>\n          <div class=\"col\"><b>F</b><div class=\"bar w3\"></div><div class=\"bar c w2\"></div></div>\n        </div>\n        <span class=\"cap\">The week at a glance</span>\n      </div>\n    </div>\n\n    <div class=\"row reveal\">\n      <div>\n        <span class=\"pnum\">No. 02</span>\n        <h3>Adjust as the tide moves</h3>\n        <p>Plans change \u2014 Tidepool expects it. Slide a task to another day, and your team sees the ripple instantly. Comments live on the task, not in a chaotic channel.</p>\n      </div>\n      <div class=\"visual\">\n        <div class=\"chat\" id=\"chatViz\">\n          <div class=\"bubble them\"><span class=\"who\">Ana</span>Moving interviews to Thursday \u2014 the vendor pushed back.</div>\n          <div class=\"bubble me\"><span class=\"who\">You</span>No problem, I'll shift the pricing review to Wednesday.</div>\n          <div class=\"bubble them\"><span class=\"who\">Ana</span>Perfect. Week still looks balanced \ud83c\udf0a</div>\n        </div>\n        <span class=\"cap\">Ripples, in real time</span>\n      </div>\n    </div>\n\n    <div class=\"row reveal\">\n      <div>\n        <span class=\"pnum\">No. 03</span>\n        <h3>Close the week, gently</h3>\n        <p>Friday afternoon, Tidepool shows what flowed and what stalled. One glance \u2014 not a retro marathon. Then next week's board opens, already carrying the context.</p>\n      </div>\n      <div class=\"visual\">\n        <div class=\"tideviz\">\n          <svg viewBox=\"0 0 360 140\" fill=\"none\">\n            <line x1=\"10\" y1=\"110\" x2=\"350\" y2=\"110\" stroke=\"#0e2f2c\" stroke-width=\"1\" opacity=\".25\"/>\n            <path d=\"M10 95 C 40 55, 70 55, 100 85 S 150 120, 180 88 S 230 45, 265 70\"/>\n            <path class=\"hl\" d=\"M265 70 C 295 95, 320 70, 350 55\"/>\n            <circle cx=\"265\" cy=\"70\" r=\"5\" fill=\"#e4572e\"/>\n            <circle cx=\"100\" cy=\"85\" r=\"4\" fill=\"#1d6b5e\"/>\n            <circle cx=\"180\" cy=\"88\" r=\"4\" fill=\"#1d6b5e\"/>\n            <text x=\"100\" y=\"130\" font-size=\"11\" fill=\"#3b5a55\" text-anchor=\"middle\" font-family=\"Instrument Sans\">Mon</text>\n            <text x=\"180\" y=\"130\" font-size=\"11\" fill=\"#3b5a55\" text-anchor=\"middle\" font-family=\"Instrument Sans\">Wed</text>\n            <text x=\"265\" y=\"130\" font-size=\"11\" fill=\"#e4572e\" text-anchor=\"middle\" font-family=\"Instrument Sans\" font-weight=\"600\">Ship day</text>\n          </svg>\n        </div>\n        <span class=\"cap\">Friday's flow report</span>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ QUOTE ============ -->\n<section class=\"quote\">\n  <div class=\"wrap reveal\">\n    <blockquote>\"We replaced three recurring meetings with one board. Our week finally feels like <strong>a rhythm instead of a scramble.</strong>\"</blockquote>\n    <cite><b>Mara Kimura</b> \u2014 co-founder, Fern &amp; Field Studio (team of 6)</cite>\n  </div>\n</section>\n\n<!-- ============ PRICING ============ -->\n<section id=\"pricing\">\n  <div class=\"wrap\">\n    <div class=\"reveal\">\n      <p class=\"eyebrow\">Pricing</p>\n      <h2>Small price for <em>calm weeks.</em></h2>\n    </div>\n    <div class=\"price-grid reveal\">\n      <div class=\"plan\">\n        <h3>Drift</h3>\n        <div class=\"amount\">Free<span> forever, up to 5 people</span></div>\n        <ul>\n          <li><svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\"><path d=\"M2 7.5 6 11l6-8\" stroke=\"#1d6b5e\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>One shared weekly board</li>\n          <li><svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\"><path d=\"M2 7.5 6 11l6-8\" stroke=\"#1d6b5e\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Real-time team presence</li>\n          <li><svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\"><path d=\"M2 7.5 6 11l6-8\" stroke=\"#1d6b5e\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Friday flow report</li>\n        </ul>\n        <a class=\"btn ghost\" href=\"#\">Start drifting</a>\n      </div>\n      <div class=\"plan featured\">\n        <span class=\"tag\">Most teams</span>\n        <h3>Current</h3>\n        <div class=\"amount\">$4<span> per person / month</span></div>\n        <ul>\n          <li><svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\"><path d=\"M2 7.5 6 11l6-8\" stroke=\"#8fd0bd\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Unlimited boards &amp; history</li>\n          <li><svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\"><path d=\"M2 7.5 6 11l6-8\" stroke=\"#8fd0bd\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Workload balance warnings</li>\n          <li><svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\"><path d=\"M2 7.5 6 11l6-8\" stroke=\"#8fd0bd\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Calendar &amp; Slack ripples</li>\n          <li><svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\"><path d=\"M2 7.5 6 11l6-8\" stroke=\"#8fd0bd\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Carry-over context between weeks</li>\n        </ul>\n        <a class=\"btn coral\" href=\"#\">Ride the current</a>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ FINAL CTA ============ -->\n<section class=\"final\">\n  <div class=\"wrap reveal\">\n    <h2>Your best week starts <em>Monday, 9:04 a.m.</em></h2>\n    <p style=\"color:var(--ink-soft);max-width:44ch;margin:0 auto 2.2rem\">Set up in under five minutes. Your team's first board opens automatically \u2014 all you bring are intentions.</p>\n    <a class=\"btn coral\" href=\"#demo\" style=\"font-size:1.05rem;padding:.9rem 2rem\">Start free \u2014 no card needed</a>\n  </div>\n</section>\n\n<footer>\n  <div class=\"foot-wrap\">\n    <a class=\"logo\" href=\"#\">\n      <svg width=\"26\" height=\"26\" viewBox=\"0 0 30 30\" fill=\"none\"><circle cx=\"15\" cy=\"15\" r=\"13.5\" stroke=\"#f6f1e6\" stroke-width=\"2\"/><path d=\"M4 18c3-3 6-3 9 0s6 3 9 0\" stroke=\"#e4572e\" stroke-width=\"2.4\" stroke-linecap=\"round\"/></svg>\n      Tidepool\n    </a>\n    <ul>\n      <li><a href=\"#demo\">Board</a></li>\n      <li><a href=\"#how\">Method</a></li>\n      <li><a href=\"#pricing\">Pricing</a></li>\n      <li><a href=\"#\">Privacy</a></li>\n    </ul>\n    <p style=\"font-size:.82rem\">\u00a9 2025 Tidepool. Made near actual tidepools.</p>\n  </div>\n</footer>\n\n<script>\n/* ---------- Nav shadow ---------- */\nconst nav = document.getElementById('nav');\naddEventListener('scroll', () => nav.classList.toggle('scrolled', scrollY > 40), {passive:true});\n\n/* ---------- Hero tide canvas ---------- */\nconst canvas = document.getElementById('tideCanvas');\nconst ctx = canvas.getContext('2d');\nlet W, H, mx = 0.5, mouseTarget = 0.5;\nfunction resize(){ W = canvas.width = canvas.offsetWidth; H = canvas.height = canvas.offsetHeight; }\nresize(); addEventListener('resize', resize);\naddEventListener('mousemove', e => { mouseTarget = e.clientX / innerWidth; });\nlet t = 0;\nfunction wave(yBase, amp, freq, speed, color, phase, mouseAmp){\n  ctx.beginPath();\n  for (let x = 0; x <= W; x += 4){\n    const pull = (mx - 0.5) * mouseAmp * Math.sin(x / W * Math.PI);\n    const y = yBase + Math.sin(x * freq + t * speed + phase) * amp + pull;\n    x === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);\n  }\n  ctx.strokeStyle = color; ctx.lineWidth = 2.2; ctx.stroke();\n}\nfunction loop(){\n  t += 0.016;\n  mx += (mouseTarget - mx) * 0.04;\n  ctx.clearRect(0, 0, W, H);\n  const base = H * 0.62;\n  // filled translucent bands\n  const bands = [[base+30, 46, .012, .7, 'rgba(29,107,94,.08)', 0],\n                 [base+70, 38, .016, .9, 'rgba(29,107,94,.11)', 2],\n                 [base+110, 30, .011, .6, 'rgba(228,87,46,.07)', 4]];\n  bands.forEach(([yb, amp, f, sp, c, ph]) => {\n    ctx.beginPath(); ctx.moveTo(0, H);\n    for (let x = 0; x <= W; x += 4){\n      const pull = (mx - 0.5) * 60 * Math.sin(x / W * Math.PI);\n      ctx.lineTo(x, yb + Math.sin(x * f + t * sp + ph) * amp + pull);\n    }\n    ctx.lineTo(W, H); ctx.closePath(); ctx.fillStyle = c; ctx.fill();\n  });\n  // crisp stroke lines\n  wave(base - 10, 42, .012, .8, 'rgba(29,107,94,.45)', 1, 90);\n  wave(base + 40, 34, .015, 1.05, 'rgba(14,47,44,.3)', 3, 130);\n  wave(base + 90, 26, .013, .7, 'rgba(228,87,46,.4)', 5, 160);\n  requestAnimationFrame(loop);\n}\nloop();\n\n/* ---------- Scroll reveals ---------- */\nconst io = new IntersectionObserver(es => es.forEach(e => {\n  if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }\n}), {threshold:.15});\ndocument.querySelectorAll('.reveal').forEach(el => io.observe(el));\n\n/* ---------- Chat bubbles animation ---------- */\nconst chatEl = document.getElementById('chatViz');\nconst chatIO = new IntersectionObserver(es => es.forEach(e => {\n  if (e.isIntersecting){\n    chatEl.querySelectorAll('.bubble').forEach((b, i) => setTimeout(() => b.classList.add('show'), 400 + i * 900));\n    chatIO.unobserve(chatEl);\n  }\n}), {threshold:.5});\nchatIO.observe(chatEl);\n\n/* ---------- Demo board: drag & drop ---------- */\nconst week = document.getElementById('week');\nconst pool = document.getElementById('pool');\n\ndocument.querySelectorAll('.chip').forEach(chip => {\n  chip.addEventListener('dragstart', e => {\n    e.dataTransfer.setData('text/plain', JSON.stringify({\n      name: chip.dataset.name, who: chip.dataset.who, coral: chip.dataset.coral || '', id: Math.random()\n    }));\n    chip.classList.add('dragging');\n  });\n  chip.addEventListener('dragend', () => chip.classList.remove('dragging'));\n});\n\ndocument.querySelectorAll('.day').forEach(day => {\n  day.addEventListener('dragover', e => { e.preventDefault(); day.classList.add('over'); });\n  day.addEventListener('dragleave', () => day.classList.remove('over'));\n  day.addEventListener('drop', e => {\n    e.preventDefault(); day.classList.remove('over');\n    const data = JSON.parse(e.dataTransfer.getData('text/plain'));\n    placeTask(day, data);\n    const chip = pool.querySelector(`[data-name=\"${data.name}\"]`);\n    if (chip) chip.classList.add('placed');\n  });\n});\n\nfunction placeTask(day, data){\n  const slot = day.querySelector('.slot');\n  const empty = slot.querySelector('.day-empty');\n  if (empty) empty.remove();\n  const task = document.createElement('div');\n  task.className = 'task' + (data.coral ? ' coral' : '');\n  task.innerHTML = `${data.name}<small>${data.who}</small>`;\n  task.title = 'Click to return to the pool';\n  task.addEventListener('click', () => {\n    task.remove();\n    const chip = pool.querySelector(`[data-name=\"${data.name}\"]`);\n    if (chip) chip.classList.remove('placed');\n    if (!slot.children.length) slot.innerHTML = '<p class=\"day-empty\">calm waters\u2026</p>';\n  });\n  slot.appendChild(task);\n  const rip = document.createElement('div');\n  rip.className = 'ripple';\n  task.appendChild(rip);\n  setTimeout(() => rip.remove(), 750);\n  // update count badge\n  updateCounts();\n}\nfunction updateCounts(){\n  document.querySelectorAll('.day').forEach(d => {\n    const n = d.querySelectorAll('.task').length;\n    let badge = d.querySelector('h4 .count');\n    if (!badge){ badge = document.createElement('span'); badge.className = 'count'; d.querySelector('h4').appendChild(badge); }\n    badge.textContent = n ? n : '';\n  });\n}\n</script>\n</body>\n</html>\n"}