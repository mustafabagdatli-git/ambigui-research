{"arm": "vs", "model": "openai/gpt-6-luna", "i": 8, "finish": "stop", "dirs": [{"direction": "Quiet editorial: warm paper tones, confident typography, and spacious layouts that make weekly planning feel calm and considered.", "probability": 0.28}, {"direction": "Playful tide charts: bright coastal colors, flowing shapes, and friendly illustrations that turn team plans into a shared current.", "probability": 0.24}, {"direction": "Practical team dashboard: crisp grid, compact product previews, and clear feature-led messaging for teams that value efficiency.", "probability": 0.2}, {"direction": "Human-centered studio: candid team moments, warm colors, and conversational copy focused on collaboration and less meeting stress.", "probability": 0.16}, {"direction": "Bold typographic statement: oversized headlines, high contrast, and minimal decoration for a distinctive, modern productivity brand.", "probability": 0.12}], "pick": {"direction": "Quiet editorial: warm paper tones, confident typography, and spacious layouts that make weekly planning feel calm and considered.", "probability": 0.28}, "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#f5f3ed\">\n  <title>Tidepool \u2014 Make room for a week that works</title>\n  <style>\n    :root {\n      --paper: #f5f3ed;\n      --paper-deep: #eeece4;\n      --ink: #243b34;\n      --muted: #72796f;\n      --line: #dcd9cf;\n      --green: #506b5b;\n      --green-pale: #e4e9df;\n      --coral: #c8775b;\n      --yellow: #eee3bd;\n      --white: #fbfaf6;\n      --serif: Georgia, \"Times New Roman\", serif;\n      --sans: -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n    }\n\n    * { box-sizing: border-box; }\n\n    html { scroll-behavior: smooth; }\n\n    body {\n      margin: 0;\n      color: var(--ink);\n      background: var(--paper);\n      font-family: var(--sans);\n      -webkit-font-smoothing: antialiased;\n    }\n\n    a { color: inherit; text-decoration: none; }\n\n    .shell {\n      width: min(1180px, calc(100% - 64px));\n      margin: 0 auto;\n    }\n\n    .eyebrow {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      color: var(--green);\n      font-size: 11px;\n      font-weight: 700;\n      letter-spacing: .14em;\n      text-transform: uppercase;\n    }\n\n    .eyebrow::before {\n      content: \"\";\n      width: 24px;\n      height: 1px;\n      background: var(--coral);\n    }\n\n    .site-header {\n      height: 88px;\n      display: flex;\n      align-items: center;\n      border-bottom: 1px solid rgba(36, 59, 52, .12);\n    }\n\n    .nav {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      width: 100%;\n    }\n\n    .brand {\n      display: inline-flex;\n      align-items: center;\n      gap: 11px;\n      font-family: var(--serif);\n      font-size: 25px;\n      font-weight: 700;\n      letter-spacing: -.05em;\n    }\n\n    .brand-mark {\n      width: 31px;\n      height: 31px;\n      display: grid;\n      place-items: center;\n      border-radius: 50%;\n      background: var(--green);\n    }\n\n    .brand-mark svg { display: block; }\n\n    .nav-links {\n      display: flex;\n      align-items: center;\n      gap: 34px;\n      margin-left: auto;\n      margin-right: 38px;\n      color: #566259;\n      font-size: 13px;\n    }\n\n    .nav-links a:hover { color: var(--coral); }\n\n    .button {\n      min-height: 46px;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: 10px;\n      padding: 0 20px;\n      border: 1px solid var(--ink);\n      border-radius: 3px;\n      background: var(--ink);\n      color: #fffdf7;\n      font-size: 12px;\n      font-weight: 650;\n      letter-spacing: .01em;\n      transition: background .2s, transform .2s;\n    }\n\n    .button:hover {\n      background: #385448;\n      transform: translateY(-1px);\n    }\n\n    .button svg { width: 14px; height: 14px; }\n\n    .button-quiet {\n      color: var(--ink);\n      background: transparent;\n      border-color: var(--line);\n    }\n\n    .button-quiet:hover {\n      color: var(--ink);\n      background: var(--white);\n    }\n\n    .hero {\n      position: relative;\n      display: grid;\n      grid-template-columns: .92fr 1.08fr;\n      align-items: center;\n      gap: 50px;\n      min-height: 650px;\n      padding: 76px 0 86px;\n    }\n\n    .hero-copy { padding-bottom: 14px; }\n\n    h1, h2, h3, p { margin-top: 0; }\n\n    h1 {\n      max-width: 550px;\n      margin: 23px 0 23px;\n      font-family: var(--serif);\n      font-size: clamp(54px, 6.1vw, 78px);\n      font-weight: 400;\n      line-height: .99;\n      letter-spacing: -.065em;\n    }\n\n    h1 em {\n      color: var(--green);\n      font-weight: 400;\n    }\n\n    .hero-copy > p {\n      max-width: 420px;\n      margin-bottom: 28px;\n      color: #667168;\n      font-size: 16px;\n      line-height: 1.75;\n    }\n\n    .hero-actions {\n      display: flex;\n      flex-wrap: wrap;\n      align-items: center;\n      gap: 12px;\n    }\n\n    .micro-proof {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      margin-top: 35px;\n      color: var(--muted);\n      font-size: 11px;\n      letter-spacing: .01em;\n    }\n\n    .avatar-stack { display: flex; padding-left: 3px; }\n\n    .avatar {\n      width: 27px;\n      height: 27px;\n      display: grid;\n      place-items: center;\n      margin-left: -4px;\n      border: 2px solid var(--paper);\n      border-radius: 50%;\n      color: #35463e;\n      background: #d9c5a8;\n      font-size: 8px;\n      font-weight: 700;\n    }\n\n    .avatar:nth-child(2) { background: #d8a991; }\n    .avatar:nth-child(3) { background: #b9c8b4; }\n    .avatar:nth-child(4) { background: #e6d89e; }\n\n    .hero-visual {\n      position: relative;\n      padding: 25px 0 20px 14px;\n    }\n\n    .hero-visual::before {\n      content: \"\";\n      position: absolute;\n      z-index: -1;\n      width: 78%;\n      height: 78%;\n      right: -34px;\n      top: 8%;\n      border-radius: 48% 52% 43% 57% / 55% 43% 57% 45%;\n      background: #e8ebe1;\n      transform: rotate(-7deg);\n    }\n\n    .week-card {\n      overflow: hidden;\n      border: 1px solid #e0ddd3;\n      border-radius: 6px;\n      background: var(--white);\n      box-shadow: 0 24px 60px rgba(48, 59, 49, .11);\n      transform: rotate(.7deg);\n    }\n\n    .week-top {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 21px 24px 18px;\n      border-bottom: 1px solid #ebe8df;\n    }\n\n    .week-title {\n      font-family: var(--serif);\n      font-size: 21px;\n      letter-spacing: -.04em;\n    }\n\n    .week-date {\n      display: block;\n      margin-top: 4px;\n      color: #8b8d82;\n      font-size: 10px;\n    }\n\n    .week-controls {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      color: #8c9087;\n      font-size: 10px;\n    }\n\n    .circle-control {\n      width: 25px;\n      height: 25px;\n      display: grid;\n      place-items: center;\n      border: 1px solid #e8e5dc;\n      border-radius: 50%;\n      font-size: 14px;\n    }\n\n    .week-body {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 0;\n    }\n\n    .day-column {\n      min-height: 303px;\n      padding: 18px 20px 20px;\n      border-right: 1px solid #eeeae2;\n    }\n\n    .day-column:nth-child(2) { border-right: 0; }\n\n    .day-label {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      margin-bottom: 12px;\n      color: #81867d;\n      font-size: 9px;\n      font-weight: 700;\n      letter-spacing: .12em;\n      text-transform: uppercase;\n    }\n\n    .day-label strong {\n      color: var(--ink);\n      font-size: 11px;\n      letter-spacing: 0;\n    }\n\n    .task {\n      position: relative;\n      margin: 0 0 8px;\n      padding: 10px 10px 10px 12px;\n      border-left: 2px solid var(--green);\n      border-radius: 2px;\n      background: #f0f2ec;\n    }\n\n    .task.coral {\n      border-left-color: var(--coral);\n      background: #f5eee8;\n    }\n\n    .task.yellow {\n      border-left-color: #c5a64e;\n      background: #f5f1e3;\n    }\n\n    .task-title {\n      margin-bottom: 5px;\n      color: #35463e;\n      font-size: 10px;\n      font-weight: 650;\n    }\n\n    .task-meta {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      color: #899087;\n      font-size: 8px;\n    }\n\n    .mini-avatars { display: flex; }\n    .mini-avatars span {\n      width: 15px;\n      height: 15px;\n      display: grid;\n      place-items: center;\n      margin-left: -3px;\n      border: 1px solid var(--white);\n      border-radius: 50%;\n      background: #c9d5c5;\n      color: #526356;\n      font-size: 6px;\n      font-weight: 700;\n    }\n    .mini-avatars span:nth-child(2) { background: #e6c8b7; }\n\n    .add-task {\n      display: block;\n      padding: 8px 0;\n      color: #969990;\n      font-size: 9px;\n    }\n\n    .week-footer {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 14px 22px;\n      border-top: 1px solid #ebe8df;\n      color: #778078;\n      font-size: 9px;\n    }\n\n    .week-footer strong {\n      display: flex;\n      align-items: center;\n      gap: 6px;\n      color: var(--green);\n      font-weight: 600;\n    }\n\n    .status-dot {\n      width: 6px;\n      height: 6px;\n      border-radius: 50%;\n      background: #82a17e;\n    }\n\n    .float-note {\n      position: absolute;\n      right: -19px;\n      bottom: 0;\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      padding: 13px 16px;\n      border: 1px solid #e2dfd5;\n      border-radius: 4px;\n      background: var(--white);\n      box-shadow: 0 10px 28px rgba(48, 59, 49, .08);\n      color: #667168;\n      font-size: 10px;\n    }\n\n    .note-icon {\n      width: 27px;\n      height: 27px;\n      display: grid;\n      place-items: center;\n      border-radius: 50%;\n      background: var(--yellow);\n      color: #796a3b;\n      font-size: 13px;\n    }\n\n    .trust-strip {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 24px;\n      padding: 26px 0 29px;\n      border-top: 1px solid var(--line);\n      border-bottom: 1px solid var(--line);\n      color: #7e8279;\n      font-size: 10px;\n    }\n\n    .trust-intro {\n      max-width: 180px;\n      line-height: 1.5;\n    }\n\n    .trust-name {\n      color: #667068;\n      font-family: var(--serif);\n      font-size: 18px;\n      letter-spacing: -.04em;\n      opacity: .83;\n      white-space: nowrap;\n    }\n\n    .section {\n      padding: 112px 0;\n    }\n\n    .section-heading {\n      display: flex;\n      align-items: end;\n      justify-content: space-between;\n      gap: 40px;\n      margin-bottom: 48px;\n    }\n\n    .section-heading h2,\n    .detail-copy h2,\n    .quote-section h2,\n    .closing h2 {\n      max-width: 580px;\n      margin: 15px 0 0;\n      font-family: var(--serif);\n      font-size: clamp(38px, 4.3vw, 56px);\n      font-weight: 400;\n      line-height: 1.05;\n      letter-spacing: -.06em;\n    }\n\n    .section-heading > p {\n      max-width: 300px;\n      margin: 0 0 5px;\n      color: var(--muted);\n      font-size: 13px;\n      line-height: 1.75;\n    }\n\n    .feature-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      border-top: 1px solid var(--line);\n      border-bottom: 1px solid var(--line);\n    }\n\n    .feature {\n      min-height: 240px;\n      padding: 29px 29px 31px 0;\n    }\n\n    .feature + .feature {\n      padding-left: 29px;\n      border-left: 1px solid var(--line);\n    }\n\n    .feature-number {\n      color: var(--coral);\n      font-family: var(--serif);\n      font-size: 16px;\n      font-style: italic;\n    }\n\n    .feature-icon {\n      width: 43px;\n      height: 43px;\n      display: grid;\n      place-items: center;\n      margin: 20px 0 16px;\n      border-radius: 50%;\n      background: var(--green-pale);\n      color: var(--green);\n    }\n\n    .feature-icon svg {\n      width: 19px;\n      height: 19px;\n      fill: none;\n      stroke: currentColor;\n      stroke-width: 1.5;\n      stroke-linecap: round;\n      stroke-linejoin: round;\n    }\n\n    .feature h3 {\n      margin-bottom: 9px;\n      font-family: var(--serif);\n      font-size: 21px;\n      font-weight: 400;\n      letter-spacing: -.035em;\n    }\n\n    .feature p {\n      max-width: 280px;\n      margin-bottom: 0;\n      color: var(--muted);\n      font-size: 12px;\n      line-height: 1.75;\n    }\n\n    .detail-section {\n      padding: 96px 0;\n      background: var(--paper-deep);\n    }\n\n    .detail-grid {\n      display: grid;\n      grid-template-columns: .92fr 1.08fr;\n      align-items: center;\n      gap: 90px;\n    }\n\n    .detail-copy h2 { margin-bottom: 20px; }\n\n    .detail-copy > p {\n      max-width: 395px;\n      margin-bottom: 26px;\n      color: #6c756c;\n      font-size: 14px;\n      line-height: 1.8;\n    }\n\n    .text-link {\n      display: inline-flex;\n      align-items: center;\n      gap: 9px;\n      padding-bottom: 5px;\n      border-bottom: 1px solid #aeb7aa;\n      color: var(--green);\n      font-size: 12px;\n      font-weight: 650;\n    }\n\n    .text-link span { font-size: 17px; line-height: 10px; }\n\n    .rhythm-card {\n      position: relative;\n      padding: 24px;\n      border: 1px solid #dddbd0;\n      border-radius: 4px;\n      background: var(--white);\n      box-shadow: 0 17px 42px rgba(48, 59, 49, .07);\n    }\n\n    .rhythm-header {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      margin-bottom: 24px;\n    }\n\n    .rhythm-header h3 {\n      margin: 0;\n      font-family: var(--serif);\n      font-size: 20px;\n      font-weight: 400;\n      letter-spacing: -.04em;\n    }\n\n    .rhythm-header span {\n      color: #96988e;\n      font-size: 9px;\n    }\n\n    .rhythm-row {\n      display: grid;\n      grid-template-columns: 65px 1fr;\n      align-items: center;\n      gap: 17px;\n      margin-top: 12px;\n    }\n\n    .rhythm-day {\n      color: #777e74;\n      font-size: 10px;\n    }\n\n    .rhythm-bar {\n      position: relative;\n      min-height: 46px;\n      display: flex;\n      align-items: center;\n      padding: 0 14px;\n      border-radius: 3px;\n      background: #f0f2ec;\n      color: #44574a;\n      font-size: 10px;\n    }\n\n    .rhythm-bar::after {\n      content: \"\";\n      position: absolute;\n      left: 0;\n      top: 0;\n      bottom: 0;\n      width: 3px;\n      border-radius: 3px 0 0 3px;\n      background: #829780;\n    }\n\n    .rhythm-row:nth-of-type(3) .rhythm-bar { background: #f5eee8; }\n    .rhythm-row:nth-of-type(3) .rhythm-bar::after { background: var(--coral); }\n    .rhythm-row:nth-of-type(4) .rhythm-bar { background: #f5f1e3; }\n    .rhythm-row:nth-of-type(4) .rhythm-bar::after { background: #c5a64e; }\n\n    .rhythm-tag {\n      margin-left: auto;\n      color: #989b91;\n      font-size: 8px;\n    }\n\n    .quote-section {\n      padding: 105px 0 110px;\n      text-align: center;\n    }\n\n    .quote-section .eyebrow { justify-content: center; }\n\n    .quote-section h2 {\n      max-width: 750px;\n      margin: 18px auto 32px;\n      font-size: clamp(34px, 4vw, 49px);\n      line-height: 1.15;\n    }\n\n    .quote-section h2 em {\n      color: var(--green);\n      font-weight: 400;\n    }\n\n    .quote-byline {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      gap: 5px;\n      color: #737a71;\n      font-size: 10px;\n    }\n\n    .quote-byline strong {\n      color: var(--ink);\n      font-size: 11px;\n      font-weight: 650;\n    }\n\n    .closing {\n      position: relative;\n      overflow: hidden;\n      padding: 76px 40px;\n      border-radius: 5px;\n      background: var(--green);\n      color: #f8f5ec;\n      text-align: center;\n    }\n\n    .closing::before,\n    .closing::after {\n      content: \"\";\n      position: absolute;\n      width: 230px;\n      height: 230px;\n      border: 1px solid rgba(246, 244, 234, .14);\n      border-radius: 50%;\n    }\n\n    .closing::before { left: -78px; top: -124px; }\n    .closing::after { right: -80px; bottom: -145px; }\n\n    .closing .eyebrow {\n      justify-content: center;\n      color: #d7dfd2;\n    }\n\n    .closing .eyebrow::before { background: #d58c70; }\n\n    .closing h2 {\n      max-width: 590px;\n      margin: 17px auto 15px;\n      color: #fbf8ee;\n      font-size: clamp(38px, 4.3vw, 54px);\n    }\n\n    .closing p {\n      margin-bottom: 24px;\n      color: #d1d9cf;\n      font-size: 13px;\n      line-height: 1.7;\n    }\n\n    .closing .button {\n      border-color: #f8f5ec;\n      background: #f8f5ec;\n      color: var(--green);\n    }\n\n    .closing .button:hover { background: #e9e7dc; }\n\n    .site-footer {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 34px 0;\n      color: #85887e;\n      font-size: 10px;\n    }\n\n    .footer-links {\n      display: flex;\n      gap: 22px;\n    }\n\n    .footer-links a:hover { color: var(--ink); }\n\n    @media (max-width: 850px) {\n      .shell { width: min(100% - 42px, 680px); }\n      .nav-links { gap: 18px; margin-right: 20px; }\n      .hero {\n        grid-template-columns: 1fr;\n        gap: 32px;\n        padding: 66px 0 76px;\n      }\n      .hero-copy { max-width: 590px; }\n      .hero-visual { width: min(100%, 620px); margin: 0 auto; }\n      .detail-grid { grid-template-columns: 1fr; gap: 44px; }\n      .detail-copy { max-width: 550px; }\n      .trust-strip { flex-wrap: wrap; justify-content: center; }\n      .trust-intro { flex-basis: 100%; max-width: none; text-align: center; }\n    }\n\n    @media (max-width: 560px) {\n      .shell { width: calc(100% - 36px); }\n      .site-header { height: 72px; }\n      .brand { font-size: 23px; }\n      .nav-links { display: none; }\n      .nav > .button { min-height: 40px; padding: 0 13px; font-size: 10px; }\n      h1 { font-size: clamp(49px, 14vw, 68px); }\n      .hero { min-height: 0; padding: 55px 0 59px; }\n      .hero-copy > p { font-size: 14px; }\n      .hero-actions .button { min-height: 43px; padding: 0 14px; font-size: 11px; }\n      .hero-visual { padding: 13px 0 21px; }\n      .week-top { padding: 17px 15px 14px; }\n      .week-title { font-size: 18px; }\n      .day-column { min-height: 270px; padding: 15px 12px; }\n      .task { padding: 9px 7px 9px 9px; }\n      .task-title { font-size: 9px; }\n      .float-note { right: -4px; bottom: -8px; padding: 10px 12px; }\n      .trust-strip { padding: 22px 0; gap: 18px 24px; }\n      .trust-name { font-size: 16px; }\n      .section { padding: 76px 0; }\n      .section-heading { display: block; margin-bottom: 31px; }\n      .section-heading > p { margin-top: 17px; }\n      .feature-grid { grid-template-columns: 1fr; }\n      .feature, .feature + .feature {\n        min-height: 0;\n        padding: 23px 0;\n        border-left: 0;\n        border-bottom: 1px solid var(--line);\n      }\n      .feature:last-child { border-bottom: 0; }\n      .feature-icon { margin: 15px 0 12px; }\n      .detail-section { padding: 74px 0; }\n      .rhythm-card { padding: 18px 13px; }\n      .rhythm-row { grid-template-columns: 52px 1fr; gap: 10px; }\n      .rhythm-bar { padding: 0 10px; font-size: 9px; }\n      .rhythm-tag { display: none; }\n      .quote-section { padding: 75px 0; }\n      .closing { padding: 62px 20px; }\n      .site-footer { align-items: flex-start; gap: 20px; flex-direction: column; }\n      .footer-links { flex-wrap: wrap; }\n    }\n  </style>\n</head>\n<body>\n  <header class=\"site-header\">\n    <div class=\"shell nav\">\n      <a class=\"brand\" href=\"#\" aria-label=\"Tidepool home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M3 9.5c2.3 0 2.3-2 4.6-2s2.3 2 4.6 2 2.3-2 4.6-2 2.3 2 4.6 2\" stroke=\"#F5F3ED\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>\n            <path d=\"M3 14.5c2.3 0 2.3-2 4.6-2s2.3 2 4.6 2 2.3-2 4.6-2 2.3 2 4.6 2\" stroke=\"#F5F3ED\" stroke-width=\"1.6\" stroke-linecap=\"round\" opacity=\".72\"/>\n          </svg>\n        </span>\n        tidepool\n      </a>\n      <nav class=\"nav-links\" aria-label=\"Main navigation\">\n        <a href=\"#how-it-works\">How it works</a>\n        <a href=\"#for-your-team\">For your team</a>\n        <a href=\"#stories\">Stories</a>\n      </nav>\n      <a class=\"button\" href=\"#get-started\">\n        Get started\n        <svg viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\">\n          <path d=\"M3 8h9M8 4l4 4-4 4\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </svg>\n      </a>\n    </div>\n  </header>\n\n  <main>\n    <section class=\"shell hero\">\n      <div class=\"hero-copy\">\n        <div class=\"eyebrow\">A gentler way to plan</div>\n        <h1>Make room for a week that <em>works.</em></h1>\n        <p>Tidepool brings your small team\u2019s plans into one calm, shared space\u2014so everyone knows what matters, and what can wait.</p>\n        <div class=\"hero-actions\">\n          <a class=\"button\" href=\"#get-started\">\n            Plan your first week\n            <svg viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\">\n              <path d=\"M3 8h9M8 4l4 4-4 4\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            </svg>\n          </a>\n          <a class=\"button button-quiet\" href=\"#how-it-works\">See how it works</a>\n        </div>\n        <div class=\"micro-proof\">\n          <div class=\"avatar-stack\" aria-hidden=\"true\">\n            <span class=\"avatar\">AM</span>\n            <span class=\"avatar\">JL</span>\n            <span class=\"avatar\">SK</span>\n            <span class=\"avatar\">+</span>\n          </div>\n          <span>Made for the people you work best with.</span>\n        </div>\n      </div>\n\n      <div class=\"hero-visual\" aria-label=\"Preview of a shared weekly plan\">\n        <div class=\"week-card\">\n          <div class=\"week-top\">\n            <div>\n              <div class=\"week-title\">The week ahead</div>\n              <span class=\"week-date\">May 13 \u2013 17 \u00b7 Small Hours Studio</span>\n            </div>\n            <div class=\"week-controls\">\n              <span>Week view</span>\n              <span class=\"circle-control\" aria-hidden=\"true\">\u2304</span>\n            </div>\n          </div>\n          <div class=\"week-body\">\n            <div class=\"day-column\">\n              <div class=\"day-label\"><span>Monday</span><strong>13</strong></div>\n              <div class=\"task\">\n                <div class=\"task-title\">Set the week\u2019s priorities</div>\n                <div class=\"task-meta\"><span>9:30 am \u00b7 30 min</span><div class=\"mini-avatars\"><span>A</span><span>J</span></div></div>\n              </div>\n              <div class=\"task coral\">\n                <div class=\"task-title\">Draft spring launch notes</div>\n                <div class=\"task-meta\"><span>Focus time</span><div class=\"mini-avatars\"><span>S</span></div></div>\n              </div>\n              <div class=\"day-label\" style=\"margin-top:20px\"><span>Tuesday</span><strong>14</strong></div>\n              <div class=\"task yellow\">\n                <div class=\"task-title\">Creative check-in</div>\n                <div class=\"task-meta\"><span>11:00 am \u00b7 45 min</span><div class=\"mini-avatars\"><span>A</span><span>S</span></div></div>\n              </div>\n            </div>\n            <div class=\"day-column\">\n              <div class=\"day-label\"><span>Wednesday</span><strong>15</strong></div>\n              <div class=\"task coral\">\n                <div class=\"task-title\">Studio work session</div>\n                <div class=\"task-meta\"><span>Focus time</span><div class=\"mini-avatars\"><span>J</span><span>S</span></div></div>\n              </div>\n              <a class=\"add-task\" href=\"#get-started\">\uff0b Add a plan</a>\n              <div class=\"day-label\" style=\"margin-top:28px\"><span>Thursday</span><strong>16</strong></div>\n              <div class=\"task\">\n                <div class=\"task-title\">Share first-round concepts</div>\n                <div class=\"task-meta\"><span>2:00 pm \u00b7 30 min</span><div class=\"mini-avatars\"><span>A</span><span>J</span></div></div>\n              </div>\n              <div class=\"day-label\" style=\"margin-top:17px\"><span>Friday</span><strong>17</strong></div>\n              <div class=\"task yellow\">\n                <div class=\"task-title\">Wrap up & reflect</div>\n                <div class=\"task-meta\"><span>3:30 pm \u00b7 20 min</span><div class=\"mini-avatars\"><span>A</span><span>J</span><span>S</span></div></div>\n              </div>\n            </div>\n          </div>\n          <div class=\"week-footer\">\n            <span>3 people \u00b7 5 plans</span>\n            <strong><i class=\"status-dot\"></i> Looking good</strong>\n          </div>\n        </div>\n        <div class=\"float-note\">\n          <span class=\"note-icon\" aria-hidden=\"true\">\u2733</span>\n          <span>Room to focus, built right in.</span>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"shell trust-strip\" aria-label=\"Tidepool is for thoughtful teams\">\n      <div class=\"trust-intro\">A little more clarity, for teams doing good work.</div>\n      <span class=\"trust-name\">Goodside</span>\n      <span class=\"trust-name\">Fieldwork</span>\n      <span class=\"trust-name\">Morrow</span>\n      <span class=\"trust-name\">Common Ground</span>\n      <span class=\"trust-name\">Studio North</span>\n    </section>\n\n    <section class=\"shell section\" id=\"how-it-works\">\n      <div class=\"section-heading\">\n        <div>\n          <div class=\"eyebrow\">A week, in good shape</div>\n          <h2>Less keeping track.<br>More moving forward.</h2>\n        </div>\n        <p>A shared plan doesn\u2019t need to be complicated. Tidepool gives your team just enough structure to make the week feel lighter.</p>\n      </div>\n\n      <div class=\"feature-grid\">\n        <article class=\"feature\">\n          <span class=\"feature-number\">01</span>\n          <div class=\"feature-icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\"><rect x=\"4\" y=\"5\" width=\"16\" height=\"15\" rx=\"2\"/><path d=\"M8 3v4M16 3v4M4 10h16M8 14h3M8 17h6\"/></svg>\n          </div>\n          <h3>Start with the week</h3>\n          <p>Bring everyone\u2019s priorities together in one simple view. No more piecing the plan together from a dozen places.</p>\n        </article>\n        <article class=\"feature\">\n          <span class=\"feature-number\">02</span>\n          <div class=\"feature-icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\"><circle cx=\"9\" cy=\"8\" r=\"3\"/><path d=\"M3.5 19c.5-3 2.3-4.5 5.5-4.5s5 1.5 5.5 4.5M16 5.5a3 3 0 0 1 0 5.8M17 14.5c2.1.5 3.2 2 3.5 4.5\"/></svg>\n          </div>\n          <h3>Make it a team thing</h3>\n          <p>See who\u2019s working on what, share the little updates, and make sure the important things have a person behind them.</p>\n        </article>\n        <article class=\"feature\">\n          <span class=\"feature-number\">03</span>\n          <div class=\"feature-icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\"><path d=\"M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6 7 7M17 17l1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4\"/><circle cx=\"12\" cy=\"12\" r=\"5\"/></svg>\n          </div>\n          <h3>Leave space to think</h3>\n          <p>Protect focus time, notice a too-full week, and make room for the work that doesn\u2019t fit neatly on a checklist.</p>\n        </article>\n      </div>\n    </section>\n\n    <section class=\"detail-section\" id=\"for-your-team\">\n      <div class=\"shell detail-grid\">\n        <div class=\"detail-copy\">\n          <div class=\"eyebrow\">See the shape of things</div>\n          <h2>Good weeks have a rhythm.</h2>\n          <p>Not every day needs to be packed. Tidepool helps your team find a thoughtful balance between heads-down work, time together, and the small things that keep a week on course.</p>\n          <a class=\"text-link\" href=\"#get-started\">Find your team\u2019s rhythm <span>\u2192</span></a>\n        </div>\n\n        <div class=\"rhythm-card\" aria-label=\"Example of a balanced weekly rhythm\">\n          <div class=\"rhythm-header\">\n            <h3>A little breathing room</h3>\n            <span>YOUR TEAM\u2019S WEEK</span>\n          </div>\n          <div class=\"rhythm-row\">\n            <div class=\"rhythm-day\">Monday</div>\n            <div class=\"rhythm-bar\">Set priorities <span class=\"rhythm-tag\">together</span></div>\n          </div>\n          <div class=\"rhythm-row\">\n            <div class=\"rhythm-day\">Tuesday</div>\n            <div class=\"rhythm-bar\">Make something good <span class=\"rhythm-tag\">focus time</span></div>\n          </div>\n          <div class=\"rhythm-row\">\n            <div class=\"rhythm-day\">Wednesday</div>\n            <div class=\"rhythm-bar\">Check in & share <span class=\"rhythm-tag\">45 minutes</span></div>\n          </div>\n          <div class=\"rhythm-row\">\n            <div class=\"rhythm-day\">Thursday</div>\n            <div class=\"rhythm-bar\">Room for the unexpected <span class=\"rhythm-tag\">open</span></div>\n          </div>\n          <div class=\"rhythm-row\">\n            <div class=\"rhythm-day\">Friday</div>\n            <div class=\"rhythm-bar\">Wrap up, then log off <span class=\"rhythm-tag\">together</span></div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"shell quote-section\" id=\"stories\">\n      <div class=\"eyebrow\">A note from the team</div>\n      <h2>\u201cWe spend less time asking what\u2019s happening, and more time doing the <em>work we love.</em>\u201d</h2>\n      <div class=\"quote-byline\">\n        <strong>Jamie Lee</strong>\n        <span>Co-founder, Small Hours Studio</span>\n      </div>\n    </section>\n\n    <section class=\"shell closing\" id=\"get-started\">\n      <div class=\"eyebrow\">A calmer Monday starts here</div>\n      <h2>Make a little space for a better week.</h2>\n      <p>Bring your team together and make your first shared plan. It takes about five minutes.</p>\n      <a class=\"button\" href=\"mailto:hello@tidepool.team\">\n        Get started with Tidepool\n        <svg viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\">\n          <path d=\"M3 8h9M8 4l4 4-4 4\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </svg>\n      </a>\n    </section>\n  </main>\n\n  <footer class=\"shell site-footer\">\n    <a class=\"brand\" href=\"#\" aria-label=\"Tidepool home\">\n      <span class=\"brand-mark\" aria-hidden=\"true\">\n        <svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\">\n          <path d=\"M3 9.5c2.3 0 2.3-2 4.6-2s2.3 2 4.6 2 2.3-2 4.6-2 2.3 2 4.6 2M3 14.5c2.3 0 2.3-2 4.6-2s2.3 2 4.6 2 2.3-2 4.6-2 2.3 2 4.6 2\" stroke=\"#F5F3ED\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>\n        </svg>\n      </span>\n      tidepool\n    </a>\n    <span>\u00a9 2024 Tidepool. A little more room to do good work.</span>\n    <nav class=\"footer-links\" aria-label=\"Footer navigation\">\n      <a href=\"mailto:hello@tidepool.team\">Contact</a>\n      <a href=\"#get-started\">Privacy</a>\n      <a href=\"#get-started\">Terms</a>\n    </nav>\n  </footer>\n</body>\n</html>\n"}