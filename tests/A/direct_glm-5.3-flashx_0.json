{"arm": "direct", "model": "z-ai/glm-5.3-flashx", "i": 0, "finish": "stop", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tidepool \u2014 Plan the week, together</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Space+Grotesk:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --ink:#0e2a2b;\n    --ink-soft:#3d5a58;\n    --paper:#f6f3ec;\n    --paper-deep:#efe9dd;\n    --tide:#0e6b63;\n    --tide-deep:#0a4f49;\n    --coral:#e4593c;\n    --sand:#e8dfcc;\n    --line:#d8d0bf;\n    --radius:14px;\n  }\n  *{margin:0;padding:0;box-sizing:border-box}\n  html{scroll-behavior:smooth}\n  body{\n    font-family:'Space Grotesk',sans-serif;\n    background:var(--paper);\n    color:var(--ink);\n    line-height:1.6;\n    -webkit-font-smoothing:antialiased;\n  }\n  h1,h2,h3,.serif{font-family:'Fraunces',serif;font-weight:500;line-height:1.08;letter-spacing:-.02em}\n  a{color:inherit}\n  ::selection{background:var(--tide);color:var(--paper)}\n\n  .wrap{max-width:1120px;margin:0 auto;padding:0 24px}\n\n  /* ---------- nav ---------- */\n  header{\n    position:sticky;top:0;z-index:50;\n    background:rgba(246,243,236,.88);\n    backdrop-filter:blur(10px);\n    border-bottom:1px solid var(--line);\n  }\n  nav{display:flex;align-items:center;justify-content:space-between;height:68px}\n  .logo{display:flex;align-items:center;gap:10px;font-family:'Fraunces',serif;font-size:22px;font-weight:600;letter-spacing:-.02em}\n  .logo svg{display:block}\n  .nav-links{display:flex;gap:32px;font-size:15px;color:var(--ink-soft)}\n  .nav-links a{text-decoration:none;transition:color .2s}\n  .nav-links a:hover{color:var(--ink)}\n  .btn{\n    display:inline-flex;align-items:center;gap:8px;\n    padding:11px 22px;border-radius:999px;\n    font-size:15px;font-weight:600;text-decoration:none;\n    transition:transform .2s ease, box-shadow .2s ease, background .2s;\n    cursor:pointer;border:none;font-family:inherit;\n  }\n  .btn-primary{background:var(--ink);color:var(--paper)}\n  .btn-primary:hover{background:var(--tide-deep);transform:translateY(-2px);box-shadow:0 8px 20px rgba(14,42,43,.22)}\n  .btn-coral{background:var(--coral);color:#fff}\n  .btn-coral:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(228,89,60,.3)}\n  .btn-ghost{background:transparent;color:var(--ink);border:1.5px solid var(--ink)}\n  .btn-ghost:hover{background:var(--ink);color:var(--paper)}\n  @media(max-width:760px){.nav-links{display:none}}\n\n  /* ---------- hero ---------- */\n  .hero{padding:88px 0 40px;position:relative;overflow:hidden}\n  .hero-grid{display:grid;grid-template-columns:1fr;gap:48px}\n  @media(min-width:960px){.hero-grid{grid-template-columns:1.05fr .95fr;align-items:center}}\n  .eyebrow{\n    display:inline-flex;align-items:center;gap:8px;\n    font-size:13px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;\n    color:var(--tide-deep);margin-bottom:22px;\n  }\n  .eyebrow::before{content:\"\";width:28px;height:2px;background:var(--coral)}\n  .hero h1{font-size:clamp(44px,6.4vw,76px);margin-bottom:24px}\n  .hero h1 em{font-style:italic;color:var(--tide-deep)}\n  .hero p.lede{font-size:19px;color:var(--ink-soft);max-width:520px;margin-bottom:36px}\n  .hero-cta{display:flex;gap:14px;flex-wrap:wrap;align-items:center}\n  .hero-note{font-size:13px;color:var(--ink-soft);margin-top:14px}\n\n  /* ---------- board mock (signature) ---------- */\n  .board{\n    background:#fff;border:1px solid var(--line);border-radius:20px;\n    box-shadow:0 30px 60px -20px rgba(14,42,43,.25), 0 4px 12px rgba(14,42,43,.06);\n    padding:22px;position:relative;\n  }\n  .board-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}\n  .board-title{font-size:15px;font-weight:600}\n  .board-avatars{display:flex}\n  .board-avatars span{\n    width:28px;height:28px;border-radius:50%;border:2px solid #fff;\n    display:grid;place-items:center;font-size:11px;font-weight:600;color:#fff;margin-left:-8px;\n  }\n  .board-avatars span:first-child{margin-left:0}\n  .week{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}\n  @media(max-width:520px){.week{grid-template-columns:repeat(3,1fr)}}\n  .day{\n    background:var(--paper);border-radius:12px;padding:10px 8px 12px;min-height:190px;\n    border:1px dashed transparent;transition:border-color .25s, background .25s;\n  }\n  .day.over{border-color:var(--tide);background:#e7f0ec}\n  .day h4{font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:10px;padding-left:4px}\n  .chip{\n    background:#fff;border:1px solid var(--line);border-radius:8px;\n    padding:7px 9px;font-size:12.5px;margin-bottom:7px;cursor:grab;\n    display:flex;align-items:center;gap:7px;line-height:1.3;\n    transition:transform .15s, box-shadow .15s;user-select:none;\n  }\n  .chip:hover{transform:translateY(-1px);box-shadow:0 4px 10px rgba(14,42,43,.12)}\n  .chip.dragging{opacity:.4;cursor:grabbing}\n  .chip .dot{width:7px;height:7px;border-radius:50%;flex-shrink:0}\n  .chip small{display:block;font-size:10.5px;color:var(--ink-soft)}\n  .chip.dropped{border-color:var(--tide);background:#f0f7f4;animation:settle .4s ease}\n  @keyframes settle{0%{transform:scale(1.06)}100%{transform:scale(1)}}\n  .pool{\n    margin-top:14px;background:var(--sand);border-radius:12px;padding:12px;\n  }\n  .pool h4{font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:9px}\n  .pool-chips{display:flex;flex-wrap:wrap;gap:8px}\n  .pool-chips .chip{margin-bottom:0}\n  .board-hint{font-size:12px;color:var(--ink-soft);margin-top:12px;text-align:center}\n  .float-badge{\n    position:absolute;top:-18px;right:-14px;background:var(--coral);color:#fff;\n    font-size:12px;font-weight:600;padding:8px 14px;border-radius:999px;\n    box-shadow:0 8px 18px rgba(228,89,60,.35);transform:rotate(3deg);\n  }\n\n  /* ---------- tide divider ---------- */\n  .tide-div{display:block;width:100%;height:60px;color:var(--paper-deep)}\n\n  /* ---------- sections ---------- */\n  section{padding:90px 0}\n  .sec-head{max-width:640px;margin-bottom:56px}\n  .sec-head h2{font-size:clamp(32px,4vw,48px);margin-bottom:16px}\n  .sec-head p{font-size:18px;color:var(--ink-soft)}\n\n  /* ritual steps */\n  .steps{display:grid;grid-template-columns:1fr;gap:0;counter-reset:step}\n  @media(min-width:820px){.steps{grid-template-columns:repeat(3,1fr)}}\n  .step{\n    padding:36px 32px;border-top:1px solid var(--line);position:relative;\n  }\n  @media(min-width:820px){\n    .step{border-left:1px solid var(--line)}\n    .step:first-child{border-left:none;padding-left:0}\n  }\n  .step::before{\n    counter-increment:step;content:\"0\" counter(step);\n    font-family:'Fraunces',serif;font-size:15px;color:var(--coral);font-weight:600;\n    display:block;margin-bottom:18px;letter-spacing:.08em;\n  }\n  .step h3{font-size:24px;margin-bottom:10px}\n  .step p{font-size:15px;color:var(--ink-soft)}\n  .step svg{margin-bottom:16px}\n\n  /* features editorial */\n  .dark{\n    background:var(--tide-deep);color:var(--paper);\n  }\n  .dark .sec-head p{color:#bcd8d2}\n  .feat-list{display:flex;flex-direction:column}\n  .feat{\n    display:grid;grid-template-columns:64px 1fr;gap:24px;\n    padding:30px 0;border-top:1px solid rgba(246,243,236,.16);\n    align-items:start;\n  }\n  .feat .icon{\n    width:52px;height:52px;border-radius:14px;background:rgba(246,243,236,.1);\n    display:grid;place-items:center;\n  }\n  .feat h3{font-size:23px;margin-bottom:6px;color:var(--paper)}\n  .feat p{color:#bcd8d2;font-size:15.5px;max-width:620px}\n\n  /* quote */\n  .quote-band{background:var(--paper-deep)}\n  blockquote{\n    font-family:'Fraunces',serif;font-size:clamp(26px,3.6vw,40px);\n    line-height:1.25;letter-spacing:-.01em;max-width:840px;\n  }\n  blockquote em{color:var(--tide-deep);font-style:italic}\n  .attrib{margin-top:28px;display:flex;align-items:center;gap:14px;font-size:15px;color:var(--ink-soft)}\n  .attrib .av{width:44px;height:44px;border-radius:50%;background:var(--tide);color:#fff;display:grid;place-items:center;font-weight:600;font-family:'Fraunces',serif;font-size:17px}\n\n  /* pricing-ish CTA */\n  .cta-panel{\n    background:var(--ink);color:var(--paper);border-radius:24px;\n    padding:64px 48px;text-align:center;position:relative;overflow:hidden;\n  }\n  .cta-panel h2{font-size:clamp(32px,4.4vw,52px);margin-bottom:16px}\n  .cta-panel p{color:#a9c4bd;font-size:17px;max-width:520px;margin:0 auto 32px}\n  .cta-panel .btn-coral{font-size:16px;padding:15px 32px}\n  .ring{position:absolute;border:1px solid rgba(246,243,236,.12);border-radius:50%}\n  .r1{width:340px;height:340px;top:-160px;left:-120px}\n  .r2{width:220px;height:220px;bottom:-90px;right:-60px}\n\n  footer{padding:44px 0;border-top:1px solid var(--line);font-size:14px;color:var(--ink-soft)}\n  .foot{display:flex;justify-content:space-between;flex-wrap:wrap;gap:16px;align-items:center}\n  .foot a{text-decoration:none;margin-left:24px;transition:color .2s}\n  .foot a:hover{color:var(--ink)}\n\n  .reveal{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease}\n  .reveal.in{opacity:1;transform:none}\n</style>\n</head>\n<body>\n\n<header>\n  <div class=\"wrap nav\">\n    <a class=\"logo\" href=\"#\" style=\"text-decoration:none\">\n      <svg width=\"30\" height=\"30\" viewBox=\"0 0 30 30\" fill=\"none\">\n        <circle cx=\"15\" cy=\"15\" r=\"13.5\" stroke=\"#0e6b63\" stroke-width=\"2\"/>\n        <path d=\"M4 17c3-3.5 6-3.5 9 0s6 3.5 9 0\" stroke=\"#e4593c\" stroke-width=\"2.2\" stroke-linecap=\"round\"/>\n        <path d=\"M6 11.5c2.4-2.6 4.6-2.6 7 0s4.6 2.6 7 0\" stroke=\"#0e6b63\" stroke-width=\"2\" stroke-linecap=\"round\" opacity=\".45\"/>\n      </svg>\n      Tidepool\n    </a>\n    <div class=\"nav-links\">\n      <a href=\"#ritual\">The ritual</a>\n      <a href=\"#features\">Features</a>\n      <a href=\"#stories\">Stories</a>\n    </div>\n    <a class=\"btn btn-primary\" href=\"#start\">Start free</a>\n  </div>\n</header>\n\n<!-- HERO -->\n<section class=\"hero\">\n  <div class=\"wrap hero-grid\">\n    <div>\n      <span class=\"eyebrow\">For teams of 2\u201312 people</span>\n      <h1>Mondays shouldn't feel like <em>unclear water.</em></h1>\n      <p class=\"lede\">Tidepool is a 20-minute weekly ritual where your whole team shapes the week together \u2014 who's on what, what can wait, and what actually matters.</p>\n      <div class=\"hero-cta\">\n        <a class=\"btn btn-coral\" href=\"#start\">Plan your first week</a>\n        <a class=\"btn btn-ghost\" href=\"#ritual\">See how it works</a>\n      </div>\n      <p class=\"hero-note\">Free for teams up to 5 \u00b7 No credit card \u00b7 Setup in 4 minutes</p>\n    </div>\n\n    <!-- interactive board -->\n    <div style=\"position:relative\">\n      <div class=\"board\" id=\"board\">\n        <span class=\"float-badge\">Try it \u2014 drag a card \u2193</span>\n        <div class=\"board-head\">\n          <span class=\"board-title\">Week of Mar 10 \u00b7 The Coastline Crew</span>\n          <div class=\"board-avatars\">\n            <span style=\"background:#0e6b63\">MA</span>\n            <span style=\"background:#e4593c\">JK</span>\n            <span style=\"background:#0e2a2b\">RS</span>\n          </div>\n        </div>\n        <div class=\"week\">\n          <div class=\"day\" data-day><h4>Mon</h4></div>\n          <div class=\"day\" data-day><h4>Tue</h4></div>\n          <div class=\"day\" data-day><h4>Wed</h4>\n            <div class=\"chip\"><span class=\"dot\" style=\"background:#e4593c\"></span><span>Design review<small>MA \u00b7 1h</small></span></div>\n          </div>\n          <div class=\"day\" data-day><h4>Thu</h4>\n            <div class=\"chip\"><span class=\"dot\" style=\"background:#0e6b63\"></span><span>Ship landing page<small>RS \u00b7 3h</small></span></div>\n          </div>\n          <div class=\"day\" data-day><h4>Fri</h4>\n            <div class=\"chip\"><span class=\"dot\" style=\"background:#c99a2e\"></span><span>Retro &amp; demos<small>All \u00b7 45m</small></span></div>\n          </div>\n        </div>\n        <div class=\"pool\">\n          <h4>Team backlog \u2014 the pool</h4>\n          <div class=\"pool-chips\">\n            <div class=\"chip\" draggable=\"true\"><span class=\"dot\" style=\"background:#0e6b63\"></span><span>Draft Q2 roadmap<small>JK \u00b7 2h</small></span></div>\n            <div class=\"chip\" draggable=\"true\"><span class=\"dot\" style=\"background:#e4593c\"></span><span>Fix onboarding emails<small>MA \u00b7 1h</small></span></div>\n            <div class=\"chip\" draggable=\"true\"><span class=\"dot\" style=\"background:#0e2a2b\"></span><span>Interview 3 candidates<small>RS \u00b7 4h</small></span></div>\n          </div>\n        </div>\n        <p class=\"board-hint\">Drag cards from the pool onto any day. That's the whole product, basically.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<svg class=\"tide-div\" viewBox=\"0 0 1440 60\" preserveAspectRatio=\"none\" aria-hidden=\"true\">\n  <path d=\"M0 30 C240 60 480 0 720 30 S1200 60 1440 30 V60 H0 Z\" fill=\"currentColor\"/>\n</svg>\n\n<!-- RITUAL -->\n<section id=\"ritual\" style=\"padding-top:70px\">\n  <div class=\"wrap\">\n    <div class=\"sec-head reveal\">\n      <span class=\"eyebrow\">The ritual</span>\n      <h2>One shared moment, then get out of the way.</h2>\n      <p>Tidepool isn't another dashboard to babysit. It's a short, structured rhythm your team actually keeps.</p>\n    </div>\n    <div class=\"steps\">\n      <div class=\"step reveal\">\n        <svg width=\"36\" height=\"36\" viewBox=\"0 0 36 36\" fill=\"none\"><rect x=\"4\" y=\"7\" width=\"28\" height=\"25\" rx=\"4\" stroke=\"#0e6b63\" stroke-width=\"2\"/><path d=\"M4 14h28\" stroke=\"#0e6b63\" stroke-width=\"2\"/><path d=\"M12 4v6M24 4v6\" stroke=\"#e4593c\" stroke-width=\"2\" stroke-linecap=\"round\"/><circle cx=\"13\" cy=\"21\" r=\"2\" fill=\"#e4593c\"/><circle cx=\"19\" cy=\"21\" r=\"2\" fill=\"#0e6b63\"/></svg>\n        <h3>Monday: gather</h3>\n        <p>A 20-minute guided session. Everyone drops their week into the pool \u2014 no status theater, just honest capacity.</p>\n      </div>\n      <div class=\"step reveal\">\n        <svg width=\"36\" height=\"36\" viewBox=\"0 0 36 36\" fill=\"none\"><path d=\"M6 24c4-5 8-5 12 0s8 5 12 0\" stroke=\"#0e6b63\" stroke-width=\"2\" stroke-linecap=\"round\"/><path d=\"M6 14c4-5 8-5 12 0s8 5 12 0\" stroke=\"#e4593c\" stroke-width=\"2\" stroke-linecap=\"round\" opacity=\".5\"/></svg>\n        <h3>Midweek: ebb &amp; flow</h3>\n        <p>Plans shift \u2014 Tidepool rebalances gently. If someone's overloaded, it surfaces it before Wednesday implodes.</p>\n      </div>\n      <div class=\"step reveal\">\n        <svg width=\"36\" height=\"36\" viewBox=\"0 0 36 36\" fill=\"none\"><path d=\"M6 19l8 8L30 11\" stroke=\"#e4593c\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"30\" cy=\"27\" r=\"3\" stroke=\"#0e6b63\" stroke-width=\"2\"/></svg>\n        <h3>Friday: close the tide</h3>\n        <p>A five-minute wrap. What landed, what drifts to next week, one thing to celebrate. Then the board clears itself.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- FEATURES -->\n<section class=\"dark\" id=\"features\">\n  <div class=\"wrap\">\n    <div class=\"sec-head reveal\">\n      <span class=\"eyebrow\" style=\"color:#f0b3a3\">Built small, on purpose</span>\n      <h2 style=\"color:var(--paper)\">Everything a small team needs. Nothing it doesn't.</h2>\n      <p>We count features before we ship them. These four earned their place.</p>\n    </div>\n    <div class=\"feat-list\">\n      <div class=\"feat reveal\">\n        <div class=\"icon\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 26 26\" fill=\"none\"><circle cx=\"9\" cy=\"8\" r=\"3.5\" stroke=\"#f6f3ec\" stroke-width=\"2\"/><circle cx=\"18\" cy=\"9.5\" r=\"2.5\" stroke=\"#e4593c\" stroke-width=\"2\"/><path d=\"M3 21c1-3.5 3.5-5 6-5s5 1.5 6 5\" stroke=\"#f6f3ec\" stroke-width=\"2\" stroke-linecap=\"round\"/><path d=\"M16 18.5c1.5-1.5 3-2 4.5-2\" stroke=\"#e4593c\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg></div>\n        <div><h3>Capacity you can see</h3><p>Every card carries an estimate, so overloads glow before they happen. No spreadsheet archaeology required.</p></div>\n      </div>\n      <div class=\"feat reveal\">\n        <div class=\"icon\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 26 26\" fill=\"none\"><path d=\"M3 16c3-4 6-4 9.5 0s6.5 4 9.5 0\" stroke=\"#e4593c\" stroke-width=\"2\" stroke-linecap=\"round\"/><path d=\"M3 9c3-4 6-4 9.5 0s6.5 4 9.5 0\" stroke=\"#f6f3ec\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg></div>\n        <div><h3>Gentle rebalancing</h3><p>When reality shifts midweek, Tidepool suggests what drifts \u2014 and asks before it moves anything.</p></div>\n      </div>\n      <div class=\"feat reveal\">\n        <div class=\"icon\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 26 26\" fill=\"none\"><rect x=\"4\" y=\"4\" width=\"18\" height=\"18\" rx=\"4\" stroke=\"#f6f3ec\" stroke-width=\"2\"/><path d=\"M8 13.5l3 3 7-7\" stroke=\"#e4593c\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></div>\n        <div><h3>The weekly wrap</h3><p>Friday auto-generates a summary in Slack: wins, drifts, and one number \u2014 how the week compared to plan.</p></div>\n      </div>\n      <div class=\"feat reveal\">\n        <div class=\"icon\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 26 26\" fill=\"none\"><path d=\"M13 3l2.5 6 6.5.5-5 4.2 1.6 6.3L13 16.5 7.4 20l1.6-6.3-5-4.2L10.5 9 13 3z\" stroke=\"#f6f3ec\" stroke-width=\"2\" stroke-linejoin=\"round\"/></svg></div>\n        <div><h3>No admin, ever</h3><p>No project hierarchies, no custom fields, no \"workspace admin.\" If it takes longer than 30 seconds to change, we cut it.</p></div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- QUOTE -->\n<section class=\"quote-band\" id=\"stories\">\n  <div class=\"wrap\">\n    <blockquote class=\"reveal\">\"We tried three project tools last year. Tidepool is the first one our team of six still uses on week twelve \u2014 because it asks for <em>twenty minutes on Monday</em>, not a second job.\"</blockquote>\n    <div class=\"attrib reveal\">\n      <span class=\"av\">MA</span>\n      <span><strong style=\"color:var(--ink)\">Maya Anand</strong> \u00b7 Co-founder, Driftline Studio</span>\n    </div>\n  </div>\n</section>\n\n<!-- CTA -->\n<section id=\"start\">\n  <div class=\"wrap\">\n    <div class=\"cta-panel reveal\">\n      <span class=\"ring r1\"></span><span class=\"ring r2\"></span>\n      <h2>The tide comes in every Monday.</h2>\n      <p>Bring your team, bring your backlog, and see what a week planned together feels like. Free while you're under six people.</p>\n      <a class=\"btn btn-coral\" href=\"#\" onclick=\"event.preventDefault();this.textContent='Nice \u2014 check your inbox \u2193';\">Plan week one \u2192</a>\n    </div>\n  </div>\n</section>\n\n<footer>\n  <div class=\"wrap foot\">\n    <span>\u00a9 2025 Tidepool \u00b7 Made slowly, in Porto</span>\n    <span>\n      <a href=\"#\">Manifesto</a><a href=\"#\">Pricing</a><a href=\"#\">hello@tidepool.team</a>\n    </span>\n  </div>\n</footer>\n\n<script>\n  // drag & drop for the hero board\n  const days=[...document.querySelectorAll('[data-day]')];\n  let dragged=null;\n  document.querySelectorAll('.chip[draggable]').forEach(chip=>{\n    chip.addEventListener('dragstart',()=>{dragged=chip;chip.classList.add('dragging')});\n    chip.addEventListener('dragend',()=>{chip.classList.remove('dragging');days.forEach(d=>d.classList.remove('over'))});\n  });\n  days.forEach(day=>{\n    day.addEventListener('dragover',e=>{e.preventDefault();day.classList.add('over')});\n    day.addEventListener('dragleave',()=>day.classList.remove('over'));\n    day.addEventListener('drop',e=>{\n      e.preventDefault();day.classList.remove('over');\n      if(!dragged)return;\n      dragged.removeAttribute('draggable');\n      dragged.classList.add('dropped');\n      day.appendChild(dragged);\n      const hint=document.querySelector('.board-hint');\n      hint.textContent='Placed. Now imagine your whole team doing this together on Monday at 10am.';\n      dragged=null;\n    });\n  });\n\n  // scroll reveal\n  const io=new IntersectionObserver(es=>es.forEach(e=>{\n    if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}\n  }),{threshold:.15});\n  document.querySelectorAll('.reveal').forEach(el=>io.observe(el));\n</script>\n</body>\n</html>\n"}