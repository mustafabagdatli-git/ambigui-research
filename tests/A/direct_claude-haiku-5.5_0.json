{"arm": "direct", "model": "anthropic/claude-haiku-5.5", "i": 0, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Tidepool: Plan your week together</title>\n  <meta name=\"description\" content=\"Tidepool helps small teams plan their week together, with one shared view, lightweight check-ins, and no meeting marathons.\">\n  <style>\n    :root {\n      --ink: #0f2a33;\n      --ink-soft: #3d5b64;\n      --muted: #6b8790;\n      --sea: #0e7c86;\n      --sea-deep: #095c64;\n      --sea-tint: #d9f0f1;\n      --foam: #f5fbfb;\n      --sand: #f7f0e5;\n      --sand-deep: #ead9bf;\n      --coral: #ff7a59;\n      --kelp: #2f6f4f;\n      --white: #ffffff;\n      --line: #dbe7e9;\n      --radius: 16px;\n      --shadow: 0 1px 2px rgba(15,42,51,.06), 0 12px 32px -12px rgba(15,42,51,.18);\n      --max: 1160px;\n    }\n\n    *, *::before, *::after { box-sizing: border-box; }\n    html { scroll-behavior: smooth; }\n    body {\n      margin: 0;\n      font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n      color: var(--ink);\n      background: var(--white);\n      line-height: 1.6;\n      -webkit-font-smoothing: antialiased;\n    }\n    img, svg { display: block; max-width: 100%; }\n    a { color: inherit; }\n    h1, h2, h3 { line-height: 1.15; margin: 0 0 .5em; letter-spacing: -0.02em; }\n    h1 { font-size: clamp(2.5rem, 5.5vw, 4.25rem); font-weight: 800; }\n    h2 { font-size: clamp(2rem, 3.6vw, 2.75rem); font-weight: 800; }\n    h3 { font-size: 1.2rem; font-weight: 700; letter-spacing: -0.01em; }\n    p { margin: 0 0 1em; }\n    .wrap { width: min(var(--max), 92%); margin-inline: auto; }\n    .eyebrow {\n      display: inline-block;\n      font-size: .78rem;\n      font-weight: 700;\n      letter-spacing: .12em;\n      text-transform: uppercase;\n      color: var(--sea-deep);\n      background: var(--sea-tint);\n      padding: .4rem .75rem;\n      border-radius: 999px;\n      margin-bottom: 1.25rem;\n    }\n    .lead { font-size: clamp(1.05rem, 1.6vw, 1.25rem); color: var(--ink-soft); max-width: 36rem; }\n    section { padding: clamp(4rem, 9vw, 7rem) 0; }\n    .center { text-align: center; }\n    .center .lead { margin-inline: auto; }\n    .section-head { max-width: 40rem; margin: 0 auto 3.5rem; text-align: center; }\n\n    /* Buttons */\n    .btn {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: .5rem;\n      font: inherit;\n      font-weight: 700;\n      text-decoration: none;\n      border: 2px solid transparent;\n      border-radius: 12px;\n      padding: .85rem 1.4rem;\n      cursor: pointer;\n      transition: transform .15s ease, background .15s ease, box-shadow .15s ease, color .15s ease;\n      white-space: nowrap;\n    }\n    .btn:hover { transform: translateY(-1px); }\n    .btn:focus-visible, a:focus-visible, summary:focus-visible {\n      outline: 3px solid var(--coral);\n      outline-offset: 3px;\n    }\n    .btn-primary { background: var(--sea); color: var(--white); box-shadow: 0 8px 20px -8px rgba(14,124,134,.6); }\n    .btn-primary:hover { background: var(--sea-deep); }\n    .btn-ghost { background: transparent; color: var(--ink); border-color: var(--line); }\n    .btn-ghost:hover { border-color: var(--sea); color: var(--sea-deep); }\n    .btn-light { background: var(--white); color: var(--sea-deep); }\n    .btn-light:hover { background: var(--sand); }\n    .btn-sm { padding: .6rem 1rem; font-size: .92rem; border-radius: 10px; }\n\n    /* Nav */\n    .nav {\n      position: sticky;\n      top: 0;\n      z-index: 50;\n      background: rgba(255,255,255,.85);\n      backdrop-filter: saturate(1.4) blur(10px);\n      border-bottom: 1px solid transparent;\n    }\n    .nav.scrolled { border-bottom-color: var(--line); }\n    .nav-inner {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      height: 72px;\n    }\n    .logo {\n      display: inline-flex;\n      align-items: center;\n      gap: .6rem;\n      font-weight: 800;\n      font-size: 1.25rem;\n      text-decoration: none;\n      letter-spacing: -0.02em;\n    }\n    .nav-links {\n      display: flex;\n      gap: 2rem;\n      list-style: none;\n      margin: 0;\n      padding: 0;\n      font-weight: 600;\n      font-size: .95rem;\n      color: var(--ink-soft);\n    }\n    .nav-links a { text-decoration: none; }\n    .nav-links a:hover { color: var(--sea-deep); }\n    .nav-actions { display: flex; align-items: center; gap: .75rem; }\n    .signin { font-weight: 600; text-decoration: none; color: var(--ink-soft); padding: .5rem .75rem; }\n    .signin:hover { color: var(--sea-deep); }\n\n    /* Hero */\n    .hero {\n      position: relative;\n      overflow: hidden;\n      padding: clamp(3.5rem, 7vw, 6rem) 0 clamp(4rem, 8vw, 6.5rem);\n      background:\n        radial-gradient(900px 500px at 85% -10%, rgba(14,124,134,.14), transparent 60%),\n        radial-gradient(700px 450px at -10% 110%, rgba(255,122,89,.12), transparent 60%),\n        var(--foam);\n    }\n    .hero-grid {\n      display: grid;\n      grid-template-columns: 1.05fr 1fr;\n      gap: clamp(2.5rem, 5vw, 4rem);\n      align-items: center;\n    }\n    .hero h1 { margin-bottom: .6em; }\n    .hero h1 em {\n      font-style: normal;\n      color: var(--sea);\n      position: relative;\n      white-space: nowrap;\n    }\n    .hero h1 em::after {\n      content: \"\";\n      position: absolute;\n      left: 0; right: 0; bottom: .08em;\n      height: .22em;\n      background: var(--sand-deep);\n      z-index: -1;\n      border-radius: 4px;\n      opacity: .8;\n    }\n    .hero-ctas { display: flex; flex-wrap: wrap; gap: .75rem; margin: 2rem 0 1.25rem; }\n    .hero-note { font-size: .9rem; color: var(--muted); }\n\n    /* Mock board */\n    .board {\n      background: var(--white);\n      border: 1px solid var(--line);\n      border-radius: 20px;\n      box-shadow: var(--shadow);\n      overflow: hidden;\n      transform: rotate(.6deg);\n    }\n    .board-top {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 1rem 1.25rem;\n      border-bottom: 1px solid var(--line);\n      background: var(--white);\n    }\n    .board-title { font-weight: 700; font-size: .95rem; }\n    .board-title span { color: var(--muted); font-weight: 500; }\n    .dots { display: flex; gap: 6px; }\n    .dots i { width: 10px; height: 10px; border-radius: 50%; background: var(--line); display: block; }\n    .dots i:first-child { background: var(--coral); }\n    .board-days {\n      display: grid;\n      grid-template-columns: repeat(5, 1fr);\n      gap: 0;\n    }\n    .day {\n      padding: .9rem .6rem 1rem;\n      border-right: 1px solid var(--line);\n      min-height: 300px;\n      background: var(--foam);\n    }\n    .day:last-child { border-right: 0; }\n    .day.today { background: var(--sea-tint); }\n    .day-name { font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }\n    .day.today .day-name { color: var(--sea-deep); }\n    .day-num { font-size: 1.1rem; font-weight: 800; margin-bottom: .75rem; }\n    .chip {\n      font-size: .75rem;\n      line-height: 1.35;\n      padding: .5rem .55rem;\n      border-radius: 10px;\n      background: var(--white);\n      border: 1px solid var(--line);\n      margin-bottom: .5rem;\n      box-shadow: 0 1px 0 rgba(15,42,51,.04);\n    }\n    .chip b { display: block; font-weight: 700; color: var(--ink); }\n    .chip small { color: var(--muted); }\n    .chip.focus { background: var(--sea); border-color: var(--sea); color: var(--white); }\n    .chip.focus small { color: rgba(255,255,255,.8); }\n    .chip.sand { background: var(--sand); border-color: var(--sand-deep); }\n    .chip.coral { border-left: 3px solid var(--coral); }\n    .avatars { display: inline-flex; }\n    .av {\n      width: 22px; height: 22px; border-radius: 50%;\n      display: inline-grid; place-items: center;\n      font-size: .6rem; font-weight: 800; color: var(--white);\n      border: 2px solid var(--white);\n      margin-left: -6px;\n    }\n    .av:first-child { margin-left: 0; }\n    .av.a { background: var(--sea); }\n    .av.b { background: var(--coral); }\n    .av.c { background: var(--kelp); }\n    .av.d { background: #7a5ab8; }\n    .board-foot {\n      display: flex; justify-content: space-between; align-items: center;\n      padding: .9rem 1.25rem;\n      border-top: 1px solid var(--line);\n      font-size: .85rem;\n      color: var(--ink-soft);\n      background: var(--white);\n    }\n    .pill {\n      font-size: .75rem; font-weight: 700; padding: .3rem .6rem; border-radius: 999px;\n      background: #e3f2e9; color: var(--kelp);\n    }\n\n    /* Logos / proof strip */\n    .strip {\n      border-block: 1px solid var(--line);\n      padding: 1.5rem 0;\n      background: var(--white);\n    }\n    .strip-inner {\n      display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem 2.5rem;\n      font-size: .95rem; color: var(--muted); font-weight: 600;\n    }\n    .strip-inner span { display: inline-flex; align-items: center; gap: .5rem; }\n    .strip-inner svg { width: 18px; height: 18px; color: var(--sea); }\n\n    /* Problem */\n    .problem { background: var(--sand); }\n    .problem-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 1.25rem;\n    }\n    .problem-card {\n      background: var(--white);\n      border-radius: var(--radius);\n      padding: 2rem 1.75rem;\n      border: 1px solid rgba(15,42,51,.06);\n    }\n    .problem-card .num {\n      font-size: 2.6rem; font-weight: 800; color: var(--coral); line-height: 1; margin-bottom: .75rem;\n    }\n    .problem-card p { color: var(--ink-soft); margin: 0; }\n\n    /* Features */\n    .features-grid {\n      display: grid;\n      grid-template-columns: repeat(2, 1fr);\n      gap: 1.25rem;\n    }\n    .feature {\n      padding: 2rem;\n      border-radius: var(--radius);\n      border: 1px solid var(--line);\n      background: var(--white);\n      transition: box-shadow .2s ease, transform .2s ease;\n    }\n    .feature:hover { box-shadow: var(--shadow); transform: translateY(-2px); }\n    .icon {\n      width: 48px; height: 48px;\n      border-radius: 14px;\n      display: grid; place-items: center;\n      background: var(--sea-tint);\n      color: var(--sea-deep);\n      margin-bottom: 1.25rem;\n    }\n    .icon svg { width: 24px; height: 24px; }\n    .feature p { color: var(--ink-soft); margin: 0; }\n    .feature.wide { grid-column: span 2; display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: center; background: var(--foam); }\n    .mini-list { list-style: none; margin: 0; padding: 0; display: grid; gap: .6rem; }\n    .mini-list li {\n      display: flex; gap: .6rem; align-items: flex-start; color: var(--ink-soft); font-size: .95rem;\n    }\n    .mini-list li::before {\n      content: \"\";\n      width: 18px; height: 18px; flex: 0 0 18px; margin-top: 3px;\n      border-radius: 50%;\n      background: var(--sea-tint);\n      box-shadow: inset 0 0 0 5px var(--sea);\n    }\n    .checkin {\n      background: var(--white);\n      border: 1px solid var(--line);\n      border-radius: 14px;\n      padding: 1.1rem;\n      box-shadow: var(--shadow);\n      font-size: .9rem;\n    }\n    .checkin-row { display: flex; align-items: center; gap: .6rem; margin-bottom: .6rem; }\n    .checkin-row:last-child { margin-bottom: 0; }\n    .checkin-row .who { font-weight: 700; min-width: 3.5rem; }\n    .status { margin-left: auto; font-size: .75rem; font-weight: 700; padding: .2rem .5rem; border-radius: 999px; }\n    .status.on { background: #e3f2e9; color: var(--kelp); }\n    .status.wait { background: #fff0e9; color: #b9482a; }\n    .checkin-q { font-weight: 700; margin-bottom: .75rem; color: var(--ink); }\n\n    /* How it works */\n    .steps {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 2rem;\n      counter-reset: step;\n      position: relative;\n    }\n    .step { position: relative; padding-top: 1rem; }\n    .step::before {\n      counter-increment: step;\n      content: counter(step);\n      display: grid; place-items: center;\n      width: 44px; height: 44px;\n      border-radius: 50%;\n      background: var(--ink);\n      color: var(--white);\n      font-weight: 800;\n      margin-bottom: 1.25rem;\n    }\n    .step p { color: var(--ink-soft); margin: 0; }\n    .how { background: var(--ink); color: var(--white); }\n    .how .eyebrow { background: rgba(255,255,255,.1); color: #9fe0e4; }\n    .how .lead, .how .step p { color: #b9d2d7; }\n    .how .step::before { background: var(--coral); color: var(--ink); }\n\n    /* Testimonial */\n    .quote-wrap { max-width: 52rem; margin: 0 auto; text-align: center; }\n    .quote {\n      font-size: clamp(1.35rem, 2.6vw, 1.9rem);\n      font-weight: 700;\n      letter-spacing: -0.01em;\n      line-height: 1.35;\n      margin: 0 0 1.5rem;\n    }\n    .quote-by { color: var(--muted); font-size: .95rem; }\n    .quote-by strong { color: var(--ink); }\n\n    /* Pricing */\n    .pricing-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 1.25rem;\n      align-items: stretch;\n    }\n    .plan {\n      border: 1px solid var(--line);\n      border-radius: 20px;\n      padding: 2rem 1.75rem;\n      display: flex;\n      flex-direction: column;\n      background: var(--white);\n    }\n    .plan.featured {\n      border: 2px solid var(--sea);\n      box-shadow: var(--shadow);\n      position: relative;\n    }\n    .plan-badge {\n      position: absolute; top: -13px; left: 50%; transform: translateX(-50%);\n      background: var(--coral); color: var(--ink);\n      font-size: .75rem; font-weight: 800; padding: .3rem .8rem; border-radius: 999px;\n      white-space: nowrap;\n    }\n    .plan-name { font-weight: 800; font-size: 1.1rem; margin-bottom: .25rem; }\n    .plan-desc { color: var(--muted); font-size: .95rem; min-height: 2.8em; }\n    .price { font-size: 2.6rem; font-weight: 800; letter-spacing: -0.03em; margin: 1rem 0 0; }\n    .price small { font-size: .95rem; font-weight: 600; color: var(--muted); letter-spacing: 0; }\n    .plan ul { list-style: none; padding: 0; margin: 1.5rem 0 2rem; display: grid; gap: .65rem; color: var(--ink-soft); font-size: .95rem; }\n    .plan li::before { content: \"\u2713\"; color: var(--sea); font-weight: 800; margin-right: .6rem; }\n    .plan .btn { margin-top: auto; }\n\n    /* FAQ */\n    .faq { max-width: 46rem; margin: 0 auto; }\n    details {\n      border-bottom: 1px solid var(--line);\n      padding: 1.25rem 0;\n    }\n    details:first-child { border-top: 1px solid var(--line); }\n    summary {\n      cursor: pointer;\n      list-style: none;\n      font-weight: 700;\n      font-size: 1.08rem;\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      gap: 1rem;\n    }\n    summary::-webkit-details-marker { display: none; }\n    summary::after {\n      content: \"+\";\n      font-size: 1.5rem;\n      line-height: 1;\n      color: var(--sea);\n      transition: transform .2s ease;\n    }\n    details[open] summary::after { transform: rotate(45deg); }\n    details p { color: var(--ink-soft); margin: .9rem 0 0; }\n\n    /* Final CTA */\n    .cta {\n      padding: 0 0 clamp(4rem, 8vw, 6rem);\n    }\n    .cta-box {\n      background:\n        radial-gradient(600px 300px at 90% 0%, rgba(255,122,89,.35), transparent 60%),\n        linear-gradient(135deg, var(--sea) 0%, var(--sea-deep) 100%);\n      color: var(--white);\n      border-radius: 28px;\n      padding: clamp(2.5rem, 6vw, 4.5rem);\n      text-align: center;\n      box-shadow: 0 30px 60px -30px rgba(9,92,100,.7);\n    }\n    .cta-box h2 { color: var(--white); }\n    .cta-box p { color: rgba(255,255,255,.85); max-width: 34rem; margin: 0 auto 2rem; font-size: 1.1rem; }\n    .cta-box .btn-row { display: flex; gap: .75rem; justify-content: center; flex-wrap: wrap; }\n    .cta-box .btn-ghost { color: var(--white); border-color: rgba(255,255,255,.4); }\n    .cta-box .btn-ghost:hover { border-color: var(--white); color: var(--white); }\n\n    /* Footer */\n    footer {\n      border-top: 1px solid var(--line);\n      padding: 3rem 0 2.5rem;\n      font-size: .92rem;\n      color: var(--muted);\n    }\n    .footer-grid {\n      display: grid;\n      grid-template-columns: 2fr 1fr 1fr 1fr;\n      gap: 2rem;\n    }\n    .footer-grid h4 { color: var(--ink); font-size: .9rem; margin: 0 0 .9rem; }\n    .footer-grid ul { list-style: none; padding: 0; margin: 0; display: grid; gap: .5rem; }\n    .footer-grid a { text-decoration: none; }\n    .footer-grid a:hover { color: var(--sea-deep); }\n    .footer-brand p { max-width: 18rem; margin-top: .9rem; }\n    .fine {\n      margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line);\n      display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem;\n    }\n\n    /* Responsive */\n    @media (max-width: 960px) {\n      .hero-grid { grid-template-columns: 1fr; }\n      .board { transform: none; }\n      .problem-grid, .pricing-grid, .steps { grid-template-columns: 1fr; }\n      .features-grid { grid-template-columns: 1fr; }\n      .feature.wide { grid-column: auto; grid-template-columns: 1fr; }\n      .nav-links { display: none; }\n      .footer-grid { grid-template-columns: 1fr 1fr; }\n    }\n    @media (max-width: 640px) {\n      .board-days { grid-template-columns: 1fr; }\n      .day { min-height: 0; border-right: 0; border-bottom: 1px solid var(--line); display: grid; grid-template-columns: 90px 1fr; gap: .5rem; align-items: start; }\n      .day-num { margin: 0; }\n      .day > .chip { grid-column: 2; }\n      .day > .day-name, .day > .day-num { grid-row: auto; }\n      .signin { display: none; }\n      .hero-ctas .btn { width: 100%; }\n      .plan.featured { order: -1; }\n    }\n    @media (prefers-reduced-motion: reduce) {\n      html { scroll-behavior: auto; }\n      * { transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n\n  <!-- Navigation -->\n  <header class=\"nav\" id=\"top\">\n    <div class=\"wrap nav-inner\">\n      <a href=\"#top\" class=\"logo\" aria-label=\"Tidepool home\">\n        <svg width=\"30\" height=\"30\" viewBox=\"0 0 32 32\" aria-hidden=\"true\">\n          <circle cx=\"16\" cy=\"16\" r=\"15\" fill=\"#0e7c86\"/>\n          <path d=\"M5 17c3-3 5-3 8 0s5 3 8 0 4-2.5 6-1\" fill=\"none\" stroke=\"#f7f0e5\" stroke-width=\"2.4\" stroke-linecap=\"round\"/>\n          <path d=\"M5 22c3-3 5-3 8 0s5 3 8 0 4-2.5 6-1\" fill=\"none\" stroke=\"#ff7a59\" stroke-width=\"2.4\" stroke-linecap=\"round\" opacity=\".9\"/>\n          <circle cx=\"12\" cy=\"10\" r=\"2.2\" fill=\"#f7f0e5\"/>\n        </svg>\n        Tidepool\n      </a>\n      <ul class=\"nav-links\">\n        <li><a href=\"#features\">Features</a></li>\n        <li><a href=\"#how\">How it works</a></li>\n        <li><a href=\"#pricing\">Pricing</a></li>\n        <li><a href=\"#faq\">FAQ</a></li>\n      </ul>\n      <div class=\"nav-actions\">\n        <a href=\"#login\" class=\"signin\">Sign in</a>\n        <a href=\"#signup\" class=\"btn btn-primary btn-sm\">Start free</a>\n      </div>\n    </div>\n  </header>\n\n  <main>\n\n    <!-- Hero -->\n    <section class=\"hero\">\n      <div class=\"wrap hero-grid\">\n        <div>\n          <span class=\"eyebrow\">For teams of 2 to 20</span>\n          <h1>Plan your week <em>together</em>, in ten minutes.</h1>\n          <p class=\"lead\">Tidepool gives your small team one shared view of the week. See who is doing what, protect focus time, and sort out blockers before Monday turns into a meeting marathon.</p>\n          <div class=\"hero-ctas\">\n            <a href=\"#signup\" class=\"btn btn-primary\">Start planning free</a>\n            <a href=\"#how\" class=\"btn btn-ghost\">See how it works</a>\n          </div>\n          <p class=\"hero-note\">Free for teams up to 5 people. No credit card required.</p>\n        </div>\n\n        <!-- Product mock -->\n        <div class=\"board\" role=\"img\" aria-label=\"Illustration of the Tidepool weekly board showing tasks across Monday through Friday\">\n          <div class=\"board-top\">\n            <div class=\"dots\" aria-hidden=\"true\"><i></i><i></i><i></i></div>\n            <div class=\"board-title\">Week of Mar 10 <span>\u00b7 Product team</span></div>\n            <div class=\"avatars\" aria-hidden=\"true\">\n              <span class=\"av a\">AR</span><span class=\"av b\">JK</span><span class=\"av c\">MO</span><span class=\"av d\">SL</span>\n            </div>\n          </div>\n          <div class=\"board-days\">\n            <div class=\"day\">\n              <div class=\"day-name\">Mon</div>\n              <div class=\"day-num\">10</div>\n              <div class=\"chip\"><b>Kickoff sync</b><small>15 min \u00b7 everyone</small></div>\n              <div class=\"chip sand\"><b>Pricing draft</b><small>JK \u00b7 in progress</small></div>\n            </div>\n            <div class=\"day\">\n              <div class=\"day-name\">Tue</div>\n              <div class=\"day-num\">11</div>\n              <div class=\"chip focus\"><b>Focus block</b><small>AR \u00b7 no meetings</small></div>\n              <div class=\"chip coral\"><b>Blocked: API keys</b><small>MO needs access</small></div>\n            </div>\n            <div class=\"day today\">\n              <div class=\"day-name\">Wed</div>\n              <div class=\"day-num\">12</div>\n              <div class=\"chip\"><b>Design review</b><small>2:00 \u00b7 SL, AR</small></div>\n              <div class=\"chip focus\"><b>Focus block</b><small>JK \u00b7 writing</small></div>\n            </div>\n            <div class=\"day\">\n              <div class=\"day-name\">Thu</div>\n              <div class=\"day-num\">13</div>\n              <div class=\"chip sand\"><b>Launch checklist</b><small>MO \u00b7 3 of 7 done</small></div>\n            </div>\n            <div class=\"day\">\n              <div class=\"day-name\">Fri</div>\n              <div class=\"day-num\">14</div>\n              <div class=\"chip\"><b>Weekly wins</b><small>Async, 5 min</small></div>\n              <div class=\"chip\"><b>Plan next week</b><small>Team</small></div>\n            </div>\n          </div>\n          <div class=\"board-foot\">\n            <span>12 of 16 tasks on track</span>\n            <span class=\"pill\">Everyone checked in</span>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Proof strip -->\n    <div class=\"strip\">\n      <div class=\"wrap strip-inner\">\n        <span><svg viewBox=\"0 0 20 20\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M10 1l2.6 5.6 6.1.7-4.5 4.2 1.2 6L10 14.5 4.6 17.5l1.2-6L1.3 7.3l6.1-.7z\"/></svg>Set up in under 5 minutes</span>\n        <span><svg viewBox=\"0 0 20 20\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M10 2a8 8 0 100 16 8 8 0 000-16zm-1 11l-3-3 1.4-1.4L9 10.2l3.6-3.6L14 8l-5 5z\"/></svg>Works with Slack and Google Calendar</span>\n        <span><svg viewBox=\"0 0 20 20\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M4 3h12v2H4zm0 4h12v10H4z\"/></svg>Your data stays in your region</span>\n        <span><svg viewBox=\"0 0 20 20\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M5 2h10v4l-3 3 3 3v6H5v-6l3-3-3-3z\"/></svg>No more recurring status meetings</span>\n      </div>\n    </div>\n\n    <!-- Problem -->\n    <section class=\"problem\">\n      <div class=\"wrap\">\n        <div class=\"section-head\">\n          <span class=\"eyebrow\">The problem</span>\n          <h2>Small teams don't need more meetings. They need a shared picture.</h2>\n          <p class=\"lead\">Most week planning happens in scattered threads, half-remembered standups, and a calendar nobody trusts.</p>\n        </div>\n        <div class=\"problem-grid\">\n          <article class=\"problem-card\">\n            <div class=\"num\">4\u00d7</div>\n            <h3>Status meetings eat the week</h3>\n            <p>Teams of five often spend hours each week just asking \"where are we on this?\" Tidepool replaces most of those calls with a board everyone can read in a minute.</p>\n          </article>\n          <article class=\"problem-card\">\n            <div class=\"num\">?</div>\n            <h3>Nobody knows who's blocked</h3>\n            <p>Blockers hide in DMs until Thursday. Flag them on the day they happen so the right person sees them before it costs you a deadline.</p>\n          </article>\n          <article class=\"problem-card\">\n            <div class=\"num\">0</div>\n            <h3>Focus time gets bulldozed</h3>\n            <p>Deep work disappears when calendars fill up unchecked. Focus blocks are visible to the whole team, so they are respected rather than quietly booked over.</p>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <!-- Features -->\n    <section id=\"features\">\n      <div class=\"wrap\">\n        <div class=\"section-head\">\n          <span class=\"eyebrow\">Features</span>\n          <h2>Everything your week needs, nothing it doesn't.</h2>\n          <p class=\"lead\">Tidepool is deliberately small. It does a few planning jobs well and then gets out of your way.</p>\n        </div>\n\n        <div class=\"features-grid\">\n          <article class=\"feature\">\n            <div class=\"icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"17\" rx=\"3\"/><path d=\"M3 9h18M8 2v4M16 2v4M8 14h3M13 14h3M8 18h3\"/></svg>\n            </div>\n            <h3>One shared week</h3>\n            <p>A single board for the whole team, laid out Monday to Friday. Drag tasks, meetings, and focus blocks onto the days they'll actually happen.</p>\n          </article>\n\n          <article class=\"feature\">\n            <div class=\"icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/></svg>\n            </div>\n            <h3>Focus blocks that stick</h3>\n            <p>Mark time as heads-down and the whole team can see it. Calendar invites that conflict with focus time get a gentle nudge, not a silent overwrite.</p>\n          </article>\n\n          <article class=\"feature wide\">\n            <div>\n              <div class=\"icon\" aria-hidden=\"true\">\n                <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 12a8 8 0 01-11.6 7.1L4 20l1-4.6A8 8 0 1121 12z\"/></svg>\n              </div>\n              <h3>Async check-ins, not standups</h3>\n              <p>Each person answers two quick questions on Monday morning. Tidepool summarizes them into a single view, so the team can skip the call and still stay aligned.</p>\n            </div>\n            <ul class=\"mini-list\">\n              <li>Three-question check-in that takes under a minute</li>\n              <li>Summary posted to your team channel automatically</li>\n              <li>Late responders are gently reminded, not chased</li>\n            </ul>\n          </article>\n\n          <article class=\"feature\">\n            <div class=\"icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 9v4M12 17h.01\"/><path d=\"M10.3 3.9L1.8 18a2 2 0 001.7 3h17a2 2 0 001.7-3L13.7 3.9a2 2 0 00-3.4 0z\"/></svg>\n            </div>\n            <h3>Blockers, surfaced early</h3>\n            <p>Flag anything stuck with one tap. Tidepool names the person who can unblock it and keeps the flag on the board until it's cleared.</p>\n          </article>\n\n          <article class=\"feature\">\n            <div class=\"icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\"/></svg>\n            </div>\n            <h3>Friday wins, Monday plan</h3>\n            <p>Close the week with a quick recap of what shipped. Carry unfinished work into next week's plan with one click, instead of losing it in the shuffle.</p>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <!-- How it works -->\n    <section id=\"how\" class=\"how\">\n      <div class=\"wrap\">\n        <div class=\"section-head\">\n          <span class=\"eyebrow\">How it works</span>\n          <h2 style=\"color:#fff\">A better Monday in three steps.</h2>\n          <p class=\"lead\">No training, no admin role, no setup project. Start with the week you're in.</p>\n        </div>\n        <div class=\"steps\">\n          <div class=\"step\">\n            <h3>Invite your team</h3>\n            <p>Add the people you plan with. Connect Slack and your calendar so tasks and meetings show up where you already work.</p>\n          </div>\n          <div class=\"step\">\n            <h3>Plan the week in ten minutes</h3>\n            <p>Each person drops in their priorities, claims focus blocks, and flags anything they need help with. The board fills in as you go.</p>\n          </div>\n          <div class=\"step\">\n            <h3>Check in, then get back to work</h3>\n            <p>A short async check-in each morning keeps the plan honest. Anyone can see what changed without asking.</p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Testimonial -->\n    <section>\n      <div class=\"wrap quote-wrap\">\n        <p class=\"quote\">\"We used to lose Monday morning to planning calls. Now we open Tidepool, see the week, and start working. It's the calmest part of our team's routine.\"</p>\n        <p class=\"quote-by\"><strong>Priya N.</strong>, Head of Operations at a six-person studio</p>\n      </div>\n    </section>\n\n    <!-- Pricing -->\n    <section id=\"pricing\" style=\"padding-top:0\">\n      <div class=\"wrap\">\n        <div class=\"section-head\">\n          <span class=\"eyebrow\">Pricing</span>\n          <h2>Start free. Pay only when you grow.</h2>\n          <p class=\"lead\">Simple per-seat pricing with no tiers that hide features behind a sales call.</p>\n        </div>\n\n        <div class=\"pricing-grid\">\n          <div class=\"plan\">\n            <div class=\"plan-name\">Starter</div>\n            <p class=\"plan-desc\">For small crews getting into the habit of planning together.</p>\n            <div class=\"price\">$0 <small>forever</small></div>\n            <ul>\n              <li>Up to 5 people</li>\n              <li>Shared weekly board</li>\n              <li>Focus blocks and blockers</li>\n              <li>Weekly async check-in</li>\n            </ul>\n            <a href=\"#signup\" class=\"btn btn-ghost\">Start free</a>\n          </div>\n\n          <div class=\"plan featured\">\n            <span class=\"plan-badge\">Most popular</span>\n            <div class=\"plan-name\">Team</div>\n            <p class=\"plan-desc\">For growing teams that want planning to run smoothly every week.</p>\n            <div class=\"price\">$6 <small>per person / month</small></div>\n            <ul>\n              <li>Unlimited people</li>\n              <li>Slack and calendar sync</li>\n              <li>Automated check-in summaries</li>\n              <li>Week-over-week history</li>\n              <li>Priority email support</li>\n            </ul>\n            <a href=\"#signup\" class=\"btn btn-primary\">Start 14-day trial</a>\n          </div>\n\n          <div class=\"plan\">\n            <div class=\"plan-name\">Studio</div>\n            <p class=\"plan-desc\">For multi-team organizations that need shared visibility across groups.</p>\n            <div class=\"price\">$11 <small>per person / month</small></div>\n            <ul>\n              <li>Everything in Team</li>\n              <li>Multiple teams and roll-up views</li>\n              <li>Admin controls and SSO</li>\n              <li>Data export and audit log</li>\n            </ul>\n            <a href=\"#contact\" class=\"btn btn-ghost\">Talk to us</a>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- FAQ -->\n    <section id=\"faq\" style=\"padding-top:0\">\n      <div class=\"wrap\">\n        <div class=\"section-head\">\n          <span class=\"eyebrow\">FAQ</span>\n          <h2>Good questions, plain answers.</h2>\n        </div>\n        <div class=\"faq\">\n          <details open>\n            <summary>Who is Tidepool built for?</summary>\n            <p>Teams of roughly two to twenty people who plan work together every week, such as product squads, agencies, studios, and small operations groups. If you have one person who runs the week alone, Tidepool still helps, but it shines when everyone contributes.</p>\n          </details>\n          <details>\n            <summary>Will this add another meeting to our week?</summary>\n            <p>No. The point is to reduce meetings. Planning happens asynchronously in about ten minutes, and the weekly check-in replaces the status call rather than adding to it.</p>\n          </details>\n          <details>\n            <summary>How does Tidepool connect to our calendar and Slack?</summary>\n            <p>You can connect Google Calendar and Slack from settings. Meetings appear on the board automatically, and check-in summaries and blocker alerts can be posted to a channel you choose. You can disconnect either at any time.</p>\n          </details>\n          <details>\n            <summary>Can I cancel or downgrade later?</summary>\n            <p>Yes. Plans are monthly with no long-term commitment. If you move back to Starter, your board and history stay intact; you'll only lose access to features that are limited to paid plans.</p>\n          </details>\n          <details>\n            <summary>Where is our data stored?</summary>\n            <p>Your workspace data is encrypted in transit and at rest. You can choose your data region during setup on Team and Studio plans, and you can export everything at any time.</p>\n          </details>\n        </div>\n      </div>\n    </section>\n\n    <!-- Final CTA -->\n    <section class=\"cta\" id=\"signup\">\n      <div class=\"wrap\">\n        <div class=\"cta-box\">\n          <h2>Your next week deserves a better start.</h2>\n          <p>Create a free workspace in under five minutes, invite your team, and plan this week together.</p>\n          <div class=\"btn-row\">\n            <a href=\"#signup\" class=\"btn btn-light\">Start planning free</a>\n            <a href=\"#contact\" class=\"btn btn-ghost\">Book a 15-minute walkthrough</a>\n          </div>\n        </div>\n      </div>\n    </section>\n\n  </main>\n\n  <!-- Footer -->\n  <footer>\n    <div class=\"wrap\">\n      <div class=\"footer-grid\">\n        <div class=\"footer-brand\">\n          <a href=\"#top\" class=\"logo\" style=\"color:var(--ink)\">\n            <svg width=\"26\" height=\"26\" viewBox=\"0 0 32 32\" aria-hidden=\"true\">\n              <circle cx=\"16\" cy=\"16\" r=\"15\" fill=\"#0e7c86\"/>\n              <path d=\"M5 17c3-3 5-3 8 0s5 3 8 0 4-2.5 6-1\" fill=\"none\" stroke=\"#f7f0e5\" stroke-width=\"2.4\" stroke-linecap=\"round\"/>\n              <path d=\"M5 22c3-3 5-3 8 0s5 3 8 0 4-2.5 6-1\" fill=\"none\" stroke=\"#ff7a59\" stroke-width=\"2.4\" stroke-linecap=\"round\" opacity=\".9\"/>\n              <circle cx=\"12\" cy=\"10\" r=\"2.2\" fill=\"#f7f0e5\"/>\n            </svg>\n            Tidepool\n          </a>\n          <p>A calmer way for small teams to plan the week together.</p>\n        </div>\n        <div>\n          <h4>Product</h4>\n          <ul>\n            <li><a href=\"#features\">Features</a></li>\n            <li><a href=\"#pricing\">Pricing</a></li>\n            <li><a href=\"#how\">How it works</a></li>\n            <li><a href=\"#faq\">FAQ</a></li>\n          </ul>\n        </div>\n        <div>\n          <h4>Company</h4>\n          <ul>\n            <li><a href=\"#about\">About</a></li>\n            <li><a href=\"#contact\">Contact</a></li>\n            <li><a href=\"#careers\">Careers</a></li>\n          </ul>\n        </div>\n        <div>\n          <h4>Resources</h4>\n          <ul>\n            <li><a href=\"#guides\">Planning guides</a></li>\n            <li><a href=\"#changelog\">Changelog</a></li>\n            <li><a href=\"#privacy\">Privacy</a></li>\n            <li><a href=\"#terms\">Terms</a></li>\n          </ul>\n        </div>\n      </div>\n      <div class=\"fine\">\n        <span>\u00a9 2025 Tidepool. All rights reserved.</span>\n        <span>Made for teams who would rather be building.</span>\n      </div>\n    </div>\n  </footer>\n\n  <script>\n    // Subtle nav border once the page scrolls.\n    (function () {\n      var nav = document.querySelector('.nav');\n      var onScroll = function () {\n        nav.classList.toggle('scrolled', window.scrollY > 8);\n      };\n      window.addEventListener('scroll', onScroll, { passive: true });\n      onScroll();\n    })();\n  </script>\n</body>\n</html>\n"}