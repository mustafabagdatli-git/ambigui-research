{"arm": "direct", "model": "openai/gpt-6-luna", "i": 1, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#f4f8f4\">\n  <meta name=\"description\" content=\"Tidepool helps small teams plan the week together, share priorities, and make room for good work.\">\n  <title>Tidepool \u2014 Make a little room for good work</title>\n  <style>\n    :root {\n      color-scheme: light;\n      --ink: #183a37;\n      --muted: #687c76;\n      --green: #236b5e;\n      --green-dark: #194f47;\n      --mint: #e4f0e8;\n      --paper: #fbfcf8;\n      --line: #e5ebe5;\n      --coral: #e9795d;\n      --shadow: 0 22px 65px rgba(34, 72, 62, .13);\n      --radius: 20px;\n    }\n\n    * { box-sizing: border-box; }\n\n    html { scroll-behavior: smooth; }\n\n    body {\n      margin: 0;\n      background: var(--paper);\n      color: var(--ink);\n      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      -webkit-font-smoothing: antialiased;\n    }\n\n    a { color: inherit; text-decoration: none; }\n\n    .wrap {\n      width: min(1160px, calc(100% - 48px));\n      margin: 0 auto;\n    }\n\n    .site-header {\n      height: 82px;\n      display: flex;\n      align-items: center;\n      position: relative;\n      z-index: 2;\n    }\n\n    .nav {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      width: 100%;\n    }\n\n    .brand {\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      color: var(--ink);\n      font-size: 20px;\n      font-weight: 750;\n      letter-spacing: -.7px;\n    }\n\n    .brand-mark {\n      width: 34px;\n      height: 34px;\n      display: grid;\n      place-items: center;\n      border-radius: 12px;\n      background: var(--green);\n      color: white;\n    }\n\n    .nav-links {\n      display: flex;\n      align-items: center;\n      gap: 34px;\n      color: #536a63;\n      font-size: 14px;\n      font-weight: 550;\n    }\n\n    .nav-links a:hover { color: var(--green); }\n\n    .button {\n      display: inline-flex;\n      justify-content: center;\n      align-items: center;\n      gap: 9px;\n      min-height: 46px;\n      padding: 0 20px;\n      border: 1px solid transparent;\n      border-radius: 12px;\n      background: var(--green);\n      color: white;\n      font-size: 14px;\n      font-weight: 680;\n      box-shadow: 0 5px 12px rgba(35, 107, 94, .12);\n      transition: transform .2s ease, background .2s ease, box-shadow .2s ease;\n    }\n\n    .button:hover {\n      background: var(--green-dark);\n      box-shadow: 0 8px 18px rgba(35, 107, 94, .18);\n      transform: translateY(-1px);\n    }\n\n    .button svg { width: 16px; height: 16px; }\n\n    .button.small {\n      min-height: 40px;\n      padding: 0 16px;\n      font-size: 13px;\n    }\n\n    .hero {\n      position: relative;\n      overflow: hidden;\n      padding: 66px 0 84px;\n      background:\n        radial-gradient(ellipse at 82% 37%, rgba(201, 226, 211, .56), transparent 39%),\n        linear-gradient(180deg, #f2f7f1 0%, #f7f9f4 100%);\n    }\n\n    .hero::before,\n    .hero::after {\n      content: \"\";\n      position: absolute;\n      pointer-events: none;\n      border: 1px solid rgba(65, 128, 105, .08);\n      border-radius: 50%;\n    }\n\n    .hero::before {\n      width: 580px;\n      height: 580px;\n      right: -160px;\n      top: -190px;\n    }\n\n    .hero::after {\n      width: 760px;\n      height: 760px;\n      right: -250px;\n      top: -280px;\n    }\n\n    .hero-grid {\n      display: grid;\n      grid-template-columns: .88fr 1.12fr;\n      align-items: center;\n      gap: 62px;\n      position: relative;\n      z-index: 1;\n    }\n\n    .eyebrow {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      margin-bottom: 22px;\n      color: var(--green);\n      font-size: 12px;\n      font-weight: 750;\n      letter-spacing: 1.1px;\n      text-transform: uppercase;\n    }\n\n    .eyebrow-dot {\n      width: 7px;\n      height: 7px;\n      border-radius: 50%;\n      background: var(--coral);\n      box-shadow: 0 0 0 4px rgba(233, 121, 93, .12);\n    }\n\n    h1 {\n      max-width: 520px;\n      margin: 0;\n      font-size: clamp(44px, 5.2vw, 66px);\n      line-height: 1.04;\n      letter-spacing: -3.4px;\n      font-weight: 720;\n    }\n\n    h1 span {\n      color: var(--green);\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-weight: 500;\n      font-style: italic;\n      letter-spacing: -3px;\n    }\n\n    .hero-copy {\n      max-width: 435px;\n      margin: 22px 0 27px;\n      color: #5e746d;\n      font-size: 17px;\n      line-height: 1.7;\n    }\n\n    .hero-actions {\n      display: flex;\n      align-items: center;\n      flex-wrap: wrap;\n      gap: 17px;\n    }\n\n    .text-link {\n      display: inline-flex;\n      align-items: center;\n      gap: 7px;\n      color: #49645b;\n      font-size: 14px;\n      font-weight: 650;\n    }\n\n    .text-link:hover { color: var(--green); }\n    .text-link svg { width: 15px; height: 15px; }\n\n    .social-proof {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      margin-top: 35px;\n      color: #74857f;\n      font-size: 12px;\n    }\n\n    .avatar-stack { display: flex; padding-left: 4px; }\n\n    .avatar {\n      width: 27px;\n      height: 27px;\n      margin-left: -5px;\n      display: grid;\n      place-items: center;\n      border: 2px solid #f3f7f2;\n      border-radius: 50%;\n      color: #fff;\n      font-size: 9px;\n      font-weight: 750;\n      letter-spacing: -.3px;\n    }\n\n    .avatar:nth-child(1) { background: #cf8c70; }\n    .avatar:nth-child(2) { background: #668b77; }\n    .avatar:nth-child(3) { background: #b98f57; }\n    .avatar:nth-child(4) { background: #687b9c; }\n\n    .social-proof strong { color: #405d53; }\n\n    /* Product preview */\n    .product-stage {\n      position: relative;\n      min-width: 0;\n      padding: 12px 0 12px 8px;\n    }\n\n    .product-window {\n      overflow: hidden;\n      border: 1px solid rgba(48, 89, 75, .12);\n      border-radius: 18px;\n      background: #fff;\n      box-shadow: var(--shadow);\n      transform: rotate(-1.25deg);\n    }\n\n    .window-bar {\n      height: 43px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 0 17px;\n      border-bottom: 1px solid #edf0ec;\n      background: #fcfdfb;\n    }\n\n    .window-dots { display: flex; gap: 5px; }\n    .window-dots i {\n      width: 7px;\n      height: 7px;\n      display: block;\n      border-radius: 50%;\n      background: #e4e9e4;\n    }\n\n    .window-title {\n      color: #80918b;\n      font-size: 10px;\n      font-weight: 600;\n    }\n\n    .window-menu {\n      color: #94a39d;\n      font-size: 17px;\n      line-height: 1;\n    }\n\n    .board {\n      padding: 21px 20px 22px;\n    }\n\n    .board-top {\n      display: flex;\n      justify-content: space-between;\n      align-items: flex-start;\n      margin-bottom: 19px;\n    }\n\n    .board-kicker {\n      margin-bottom: 5px;\n      color: #8b9a94;\n      font-size: 9px;\n      font-weight: 700;\n      letter-spacing: .9px;\n      text-transform: uppercase;\n    }\n\n    .board-heading {\n      color: #24443d;\n      font-size: 20px;\n      font-weight: 720;\n      letter-spacing: -.7px;\n    }\n\n    .board-date {\n      margin-top: 4px;\n      color: #8b9a94;\n      font-size: 10px;\n    }\n\n    .week-pill {\n      padding: 7px 9px;\n      border: 1px solid #e9eee9;\n      border-radius: 8px;\n      color: #567068;\n      font-size: 9px;\n      font-weight: 650;\n    }\n\n    .team-row {\n      display: flex;\n      align-items: center;\n      gap: 6px;\n      margin-bottom: 16px;\n    }\n\n    .team-row .avatar {\n      width: 23px;\n      height: 23px;\n      margin: 0 0 0 -2px;\n      border-color: #fff;\n      font-size: 8px;\n    }\n\n    .team-caption {\n      margin-left: 3px;\n      color: #83928c;\n      font-size: 9px;\n    }\n\n    .week-grid {\n      display: grid;\n      grid-template-columns: repeat(5, minmax(0, 1fr));\n      border-top: 1px solid #edf0ec;\n      border-left: 1px solid #edf0ec;\n    }\n\n    .day {\n      min-height: 205px;\n      padding: 10px 7px 8px;\n      border-right: 1px solid #edf0ec;\n      border-bottom: 1px solid #edf0ec;\n      background: #fff;\n    }\n\n    .day.today { background: #f8fbf7; }\n\n    .day-name {\n      display: flex;\n      justify-content: space-between;\n      margin-bottom: 12px;\n      color: #83918b;\n      font-size: 9px;\n      font-weight: 700;\n      text-transform: uppercase;\n    }\n\n    .day-name b {\n      color: #3c6558;\n      font-size: 10px;\n    }\n\n    .task {\n      margin-bottom: 7px;\n      padding: 8px 7px 7px;\n      border-radius: 7px;\n      background: #eaf3ed;\n      color: #416456;\n      font-size: 8px;\n      line-height: 1.35;\n      font-weight: 650;\n    }\n\n    .task.peach { background: #fbede7; color: #9a6452; }\n    .task.blue { background: #edf1f7; color: #5b6d88; }\n    .task.yellow { background: #f7f2df; color: #88764a; }\n\n    .task small {\n      display: block;\n      margin-top: 5px;\n      color: inherit;\n      opacity: .72;\n      font-size: 7px;\n      font-weight: 550;\n    }\n\n    .mini-person {\n      display: inline-grid;\n      width: 14px;\n      height: 14px;\n      margin-right: 3px;\n      place-items: center;\n      border-radius: 50%;\n      background: rgba(66, 102, 83, .17);\n      color: inherit;\n      font-size: 6px;\n      vertical-align: -3px;\n    }\n\n    .empty-note {\n      margin-top: 17px;\n      color: #b0bbb5;\n      font-size: 8px;\n      text-align: center;\n    }\n\n    .float-note {\n      position: absolute;\n      right: -18px;\n      bottom: 2px;\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      padding: 12px 16px;\n      border: 1px solid rgba(48, 89, 75, .09);\n      border-radius: 13px;\n      background: white;\n      box-shadow: 0 12px 30px rgba(34, 72, 62, .12);\n      color: #557068;\n      font-size: 11px;\n      font-weight: 620;\n      transform: rotate(2deg);\n    }\n\n    .float-check {\n      width: 23px;\n      height: 23px;\n      display: grid;\n      place-items: center;\n      border-radius: 50%;\n      background: #e4f2e8;\n      color: #3a8064;\n    }\n\n    .float-check svg { width: 13px; height: 13px; }\n\n    .trust {\n      padding: 31px 0 37px;\n      border-bottom: 1px solid #ebefea;\n      text-align: center;\n    }\n\n    .trust-label {\n      margin-bottom: 18px;\n      color: #95a19b;\n      font-size: 10px;\n      font-weight: 700;\n      letter-spacing: 1.05px;\n      text-transform: uppercase;\n    }\n\n    .trust-list {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      flex-wrap: wrap;\n      gap: clamp(28px, 6vw, 74px);\n      color: #71847b;\n    }\n\n    .trust-name {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      font-size: 15px;\n      font-weight: 730;\n      letter-spacing: -.5px;\n    }\n\n    .trust-name span {\n      width: 19px;\n      height: 19px;\n      display: inline-grid;\n      place-items: center;\n      border: 2px solid currentColor;\n      border-radius: 6px 6px 6px 2px;\n      font-size: 10px;\n    }\n\n    .section {\n      padding: 94px 0;\n    }\n\n    .section-heading {\n      max-width: 620px;\n      margin: 0 auto 48px;\n      text-align: center;\n    }\n\n    .section-heading .eyebrow { margin-bottom: 15px; }\n\n    h2 {\n      margin: 0;\n      font-size: clamp(32px, 4vw, 45px);\n      line-height: 1.13;\n      letter-spacing: -2px;\n      font-weight: 700;\n    }\n\n    .section-heading p {\n      max-width: 470px;\n      margin: 15px auto 0;\n      color: var(--muted);\n      font-size: 15px;\n      line-height: 1.7;\n    }\n\n    .feature-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 18px;\n    }\n\n    .feature-card {\n      min-height: 226px;\n      padding: 25px;\n      border: 1px solid #e8ede7;\n      border-radius: 16px;\n      background: #fff;\n    }\n\n    .feature-icon {\n      width: 42px;\n      height: 42px;\n      display: grid;\n      place-items: center;\n      margin-bottom: 28px;\n      border-radius: 13px;\n      background: #eaf3ec;\n      color: var(--green);\n    }\n\n    .feature-card:nth-child(2) .feature-icon { background: #fbede7; color: #bf6a50; }\n    .feature-card:nth-child(3) .feature-icon { background: #eef0f7; color: #63749a; }\n\n    .feature-icon svg { width: 21px; height: 21px; }\n\n    .feature-card h3 {\n      margin: 0 0 9px;\n      font-size: 16px;\n      letter-spacing: -.35px;\n    }\n\n    .feature-card p {\n      margin: 0;\n      color: #71817a;\n      font-size: 13px;\n      line-height: 1.65;\n    }\n\n    .quote-section {\n      padding: 0 0 94px;\n    }\n\n    .quote-card {\n      position: relative;\n      overflow: hidden;\n      padding: 49px 30px;\n      border-radius: 20px;\n      background: #eaf3eb;\n      text-align: center;\n    }\n\n    .quote-card::before,\n    .quote-card::after {\n      content: \"\";\n      position: absolute;\n      width: 210px;\n      height: 210px;\n      border: 1px solid rgba(54, 117, 88, .1);\n      border-radius: 50%;\n    }\n\n    .quote-card::before { left: -85px; top: -110px; }\n    .quote-card::after { right: -90px; bottom: -130px; }\n\n    .quote-mark {\n      margin-bottom: 7px;\n      color: #7caa8e;\n      font-family: Georgia, serif;\n      font-size: 48px;\n      line-height: .7;\n    }\n\n    blockquote {\n      max-width: 690px;\n      margin: 0 auto 19px;\n      color: #31564b;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: clamp(21px, 3vw, 29px);\n      line-height: 1.4;\n      letter-spacing: -.35px;\n    }\n\n    .quote-credit {\n      color: #71887d;\n      font-size: 12px;\n      font-weight: 600;\n    }\n\n    .cta {\n      padding: 77px 0 82px;\n      background: #214f46;\n      color: #fff;\n      text-align: center;\n    }\n\n    .cta h2 {\n      max-width: 580px;\n      margin: 0 auto;\n      font-size: clamp(34px, 4.3vw, 49px);\n      letter-spacing: -2.3px;\n    }\n\n    .cta p {\n      margin: 15px auto 25px;\n      color: #c3d7cc;\n      font-size: 15px;\n    }\n\n    .button.light {\n      background: #fff;\n      color: var(--green-dark);\n      box-shadow: none;\n    }\n\n    .button.light:hover { background: #eef5ef; }\n\n    .cta-note {\n      margin-top: 13px;\n      color: #a4c2b3;\n      font-size: 11px;\n    }\n\n    .site-footer {\n      padding: 25px 0;\n      background: #214f46;\n      color: #b8cec3;\n    }\n\n    .footer-inner {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 18px;\n      padding-top: 20px;\n      border-top: 1px solid rgba(255, 255, 255, .13);\n      font-size: 11px;\n    }\n\n    .footer-brand { color: #fff; font-size: 15px; }\n    .footer-links { display: flex; gap: 22px; }\n    .footer-links a:hover { color: #fff; }\n\n    @media (max-width: 900px) {\n      .hero-grid { gap: 36px; grid-template-columns: .85fr 1.15fr; }\n      .product-stage { padding-right: 4px; }\n      .float-note { right: -4px; }\n      .board { padding: 17px 14px; }\n      .day { padding-inline: 5px; }\n    }\n\n    @media (max-width: 720px) {\n      .wrap { width: min(100% - 36px, 540px); }\n      .site-header { height: 70px; }\n      .nav-links { display: none; }\n      .hero { padding: 48px 0 62px; }\n      .hero-grid { grid-template-columns: 1fr; gap: 39px; }\n      .hero-copy { font-size: 16px; }\n      h1 { max-width: 500px; font-size: clamp(44px, 12vw, 61px); }\n      .product-stage { padding: 0 5px 20px; }\n      .product-window { transform: rotate(-.5deg); }\n      .float-note { right: -5px; bottom: -1px; }\n      .trust-list { gap: 18px 28px; }\n      .trust-name { font-size: 13px; }\n      .section { padding: 70px 0; }\n      .feature-grid { grid-template-columns: 1fr; gap: 12px; }\n      .feature-card { min-height: auto; padding: 22px; }\n      .feature-icon { margin-bottom: 20px; }\n      .quote-section { padding-bottom: 70px; }\n      .quote-card { padding: 40px 22px; }\n      .footer-inner { align-items: flex-start; flex-direction: column; }\n    }\n\n    @media (max-width: 430px) {\n      .wrap { width: calc(100% - 30px); }\n      .button.small { min-height: 38px; padding: 0 12px; font-size: 12px; }\n      .hero-actions { gap: 14px; }\n      .social-proof { font-size: 11px; }\n      .board { padding: 15px 10px; }\n      .board-heading { font-size: 18px; }\n      .week-grid { grid-template-columns: repeat(5, minmax(58px, 1fr)); }\n      .product-window { overflow-x: auto; }\n      .week-grid { min-width: 350px; }\n      .day { min-height: 190px; }\n      .float-note { right: -2px; font-size: 10px; }\n      .trust-list { gap: 16px 20px; }\n      .trust-name { font-size: 12px; }\n      .footer-links { gap: 15px; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      html { scroll-behavior: auto; }\n      *, *::before, *::after { transition-duration: .01ms !important; }\n    }\n  </style>\n</head>\n<body>\n  <header class=\"site-header\">\n    <div class=\"wrap nav\">\n      <a class=\"brand\" href=\"#\" aria-label=\"Tidepool home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\">\n            <path d=\"M3 9.5c2.2 0 2.2-2 4.4-2s2.2 2 4.4 2 2.2-2 4.4-2 2.2 2 4.4 2\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n            <path d=\"M3 14.5c2.2 0 2.2-2 4.4-2s2.2 2 4.4 2 2.2-2 4.4-2 2.2 2 4.4 2\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n            <path d=\"M5 18.5c1.2 0 1.8-.5 2.4-1\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n          </svg>\n        </span>\n        Tidepool\n      </a>\n\n      <nav class=\"nav-links\" aria-label=\"Main navigation\">\n        <a href=\"#how-it-works\">How it works</a>\n        <a href=\"#features\">Why Tidepool</a>\n        <a href=\"#stories\">Our teams</a>\n      </nav>\n\n      <a class=\"button small\" href=\"#get-started\">\n        Get started\n        <svg viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\">\n          <path d=\"M4 10h11m-4-4 4 4-4 4\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </svg>\n      </a>\n    </div>\n  </header>\n\n  <main>\n    <section class=\"hero\" id=\"how-it-works\">\n      <div class=\"wrap hero-grid\">\n        <div class=\"hero-content\">\n          <div class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> A better week starts together</div>\n          <h1>Make a little room for <span>good work.</span></h1>\n          <p class=\"hero-copy\">\n            Tidepool brings your team's plans, priorities, and people into one calm place. Get on the same page, then get on with your week.\n          </p>\n          <div class=\"hero-actions\">\n            <a class=\"button\" href=\"#get-started\">\n              Plan your first week\n              <svg viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\">\n                <path d=\"M4 10h11m-4-4 4 4-4 4\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n            </a>\n            <a class=\"text-link\" href=\"#features\">\n              Take a look around\n              <svg viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\">\n                <path d=\"M5 10h10m-4-4 4 4-4 4\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n            </a>\n          </div>\n          <div class=\"social-proof\">\n            <div class=\"avatar-stack\" aria-hidden=\"true\">\n              <span class=\"avatar\">JM</span>\n              <span class=\"avatar\">AL</span>\n              <span class=\"avatar\">RK</span>\n              <span class=\"avatar\">TS</span>\n            </div>\n            <span>Made for small teams who <strong>care how work feels.</strong></span>\n          </div>\n        </div>\n\n        <div class=\"product-stage\" aria-label=\"Preview of a Tidepool team weekly plan\">\n          <div class=\"product-window\">\n            <div class=\"window-bar\">\n              <div class=\"window-dots\" aria-hidden=\"true\"><i></i><i></i><i></i></div>\n              <span class=\"window-title\">Tidepool \u00b7 Studio Fern</span>\n              <span class=\"window-menu\" aria-hidden=\"true\">\u00b7\u00b7\u00b7</span>\n            </div>\n            <div class=\"board\">\n              <div class=\"board-top\">\n                <div>\n                  <div class=\"board-kicker\">Your team plan</div>\n                  <div class=\"board-heading\">A good week, together.</div>\n                  <div class=\"board-date\">September 16 \u2013 20</div>\n                </div>\n                <div class=\"week-pill\">This week\u2304</div>\n              </div>\n\n              <div class=\"team-row\" aria-label=\"Team members\">\n                <span class=\"avatar\">JM</span>\n                <span class=\"avatar\">AL</span>\n                <span class=\"avatar\">RK</span>\n                <span class=\"avatar\">TS</span>\n                <span class=\"team-caption\">4 people \u00b7 one shared plan</span>\n              </div>\n\n              <div class=\"week-grid\">\n                <div class=\"day today\">\n                  <div class=\"day-name\"><span>Mon</span><b>16</b></div>\n                  <div class=\"task\">Kickoff &amp; coffee<small><span class=\"mini-person\">JM</span> 9:30 AM</small></div>\n                  <div class=\"task peach\">Map the launch<small><span class=\"mini-person\">AL</span> Focus time</small></div>\n                </div>\n                <div class=\"day\">\n                  <div class=\"day-name\"><span>Tue</span><b>17</b></div>\n                  <div class=\"task blue\">Customer chats<small><span class=\"mini-person\">RK</span> 3 calls</small></div>\n                  <div class=\"task\">Draft new flow<small><span class=\"mini-person\">TS</span> In progress</small></div>\n                </div>\n                <div class=\"day\">\n                  <div class=\"day-name\"><span>Wed</span><b>18</b></div>\n                  <div class=\"task yellow\">Midweek check-in<small>Team \u00b7 10:00 AM</small></div>\n                  <div class=\"task peach\">Share first pass<small><span class=\"mini-person\">AL</span> For feedback</small></div>\n                </div>\n                <div class=\"day\">\n                  <div class=\"day-name\"><span>Thu</span><b>19</b></div>\n                  <div class=\"task\">Build &amp; refine<small><span class=\"mini-person\">JM</span> Focus time</small></div>\n                  <div class=\"empty-note\">A little breathing room</div>\n                </div>\n                <div class=\"day\">\n                  <div class=\"day-name\"><span>Fri</span><b>20</b></div>\n                  <div class=\"task blue\">Show &amp; tell<small>Team \u00b7 2:00 PM</small></div>\n                  <div class=\"task yellow\">Wrap the week<small>What went well?</small></div>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div class=\"float-note\">\n            <span class=\"float-check\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 20 20\" fill=\"none\"><path d=\"m4 10 4 4 8-8\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            </span>\n            Everyone knows what matters\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"trust\" aria-label=\"Teams using Tidepool\">\n      <div class=\"wrap\">\n        <div class=\"trust-label\">A little more in sync, every week</div>\n        <div class=\"trust-list\">\n          <div class=\"trust-name\"><span>f</span> fieldnotes</div>\n          <div class=\"trust-name\"><span>\u2733</span> goodfolk</div>\n          <div class=\"trust-name\"><span>m</span> monday studio</div>\n          <div class=\"trust-name\"><span>\u2301</span> little by little</div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section\" id=\"features\">\n      <div class=\"wrap\">\n        <div class=\"section-heading\">\n          <div class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> Less chasing, more making</div>\n          <h2>Small rituals. Better weeks.</h2>\n          <p>Skip the scattered updates and endless status meetings. Make a plan that works for actual humans.</p>\n        </div>\n\n        <div class=\"feature-grid\">\n          <article class=\"feature-card\">\n            <div class=\"feature-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\">\n                <rect x=\"3.5\" y=\"5\" width=\"17\" height=\"15.5\" rx=\"3\" stroke=\"currentColor\" stroke-width=\"1.6\"/>\n                <path d=\"M8 3.5v3M16 3.5v3M4 9.5h16M8 13h3m-3 3h6\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>\n              </svg>\n            </div>\n            <h3>See the week at a glance</h3>\n            <p>Bring tasks, meetings, and focus time into one shared view. No more piecing the plan together from five places.</p>\n          </article>\n\n          <article class=\"feature-card\">\n            <div class=\"feature-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\">\n                <path d=\"M12 20.2s-7.8-4.5-7.8-10.3a4.4 4.4 0 0 1 7.8-2.8 4.4 4.4 0 0 1 7.8 2.8c0 5.8-7.8 10.3-7.8 10.3Z\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"/>\n                <path d=\"m8.5 12.1 2.2 2.2 4.8-4.8\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n            </div>\n            <h3>Make space for real life</h3>\n            <p>Share capacity, not just to-dos. Plan with the time and energy your team actually has this week.</p>\n          </article>\n\n          <article class=\"feature-card\">\n            <div class=\"feature-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\">\n                <path d=\"M7.5 11.5a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM16.5 11.5a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM2.8 19c.4-3 2-4.5 4.7-4.5s4.3 1.5 4.7 4.5m.3 0c.4-2.5 1.8-3.8 4-3.8s3.8 1.3 4.2 3.8\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>\n              </svg>\n            </div>\n            <h3>Keep everyone in the loop</h3>\n            <p>Make ownership clear and progress easy to find, so the right people can help without another meeting.</p>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"quote-section\" id=\"stories\">\n      <div class=\"wrap\">\n        <div class=\"quote-card\">\n          <div class=\"quote-mark\" aria-hidden=\"true\">\u201c</div>\n          <blockquote>We stopped ending Monday with a pile of questions. Now everyone knows where to start\u2014and when to take a breath.</blockquote>\n          <div class=\"quote-credit\">Mara Chen \u00b7 Co-founder, Studio Fern</div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"cta\" id=\"get-started\">\n      <div class=\"wrap\">\n        <h2>Let\u2019s make next week a good one.</h2>\n        <p>Bring your people. We\u2019ll bring a little calm.</p>\n        <a class=\"button light\" href=\"mailto:hello@tidepool.team\">\n          Get started for free\n          <svg viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\">\n            <path d=\"M4 10h11m-4-4 4 4-4 4\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          </svg>\n        </a>\n        <div class=\"cta-note\">No credit card needed \u00b7 Set up in a few minutes</div>\n      </div>\n    </section>\n  </main>\n\n  <footer class=\"site-footer\">\n    <div class=\"wrap footer-inner\">\n      <a class=\"brand footer-brand\" href=\"#\" aria-label=\"Tidepool home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\">\n            <path d=\"M3 9.5c2.2 0 2.2-2 4.4-2s2.2 2 4.4 2 2.2-2 4.4-2 2.2 2 4.4 2M3 14.5c2.2 0 2.2-2 4.4-2s2.2 2 4.4 2 2.2-2 4.4-2 2.2 2 4.4 2\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n          </svg>\n        </span>\n        Tidepool\n      </a>\n      <div>\u00a9 2024 Tidepool. Made for work that matters.</div>\n      <nav class=\"footer-links\" aria-label=\"Footer navigation\">\n        <a href=\"mailto:hello@tidepool.team\">Contact</a>\n        <a href=\"#features\">About</a>\n        <a href=\"#get-started\">Get started</a>\n      </nav>\n    </div>\n  </footer>\n</body>\n</html>\n"}