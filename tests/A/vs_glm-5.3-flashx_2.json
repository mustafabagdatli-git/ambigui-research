32px;\n    border:4px solid var(--ink);\n    background:var(--yellow);\n    color:var(--ink);\n    text-decoration:none;\n    box-shadow:8px 8px 0 var(--ink);\n    transition:transform .1s, box-shadow .1s;\n  }\n  .btn:hover{transform:translate(4px,4px);box-shadow:4px 4px 0 var(--ink);}\n  .btn.blue{background:var(--blue);color:#fff;}\n  .tag{\n    display:inline-block;\n    background:var(--ink);\n    color:var(--paper);\n    font-family:Arial Black,Arial,sans-serif;\n    text-transform:uppercase;\n    font-size:13px;\n    padding:6px 14px;\n    letter-spacing:.1em;\n  }\n\n  /* ---------- nav ---------- */\n  nav{\n    border-bottom:4px solid var(--ink);\n    background:var(--paper);\n    position:sticky;top:0;z-index:50;\n  }\n  nav .wrap{display:flex;align-items:center;justify-content:space-between;padding:16px 24px;}\n  .logo{font-family:Arial Black,Arial,sans-serif;font-size:26px;text-transform:uppercase;display:flex;align-items:center;gap:10px;}\n  .logo-mark{width:34px;height:34px;border:4px solid var(--ink);background:var(--blue);position:relative;overflow:hidden;}\n  .logo-mark::before,.logo-mark::after{\n    content:\"\";position:absolute;left:0;right:0;height:6px;background:var(--paper);\n  }\n  .logo-mark::before{top:8px;}\n  .logo-mark::after{top:20px;}\n  nav a.nav-link{\n    font-weight:bold;text-transform:uppercase;font-size:14px;\n    color:var(--ink);text-decoration:none;margin:0 14px;\n  }\n  nav a.nav-link:hover{text-decoration:underline;text-decoration-thickness:3px;}\n\n  /* ---------- hero ---------- */\n  header{padding:64px 0 40px;}\n  .hero-grid{display:grid;grid-template-columns:1fr 1.2fr;gap:48px;align-items:start;}\n  .hero-copy h1{\n    font-size:clamp(48px,7vw,88px);\n    line-height:.95;\n    margin:20px 0 24px;\n  }\n  .hero-copy h1 .hl{background:var(--yellow);padding:0 8px;box-decoration-break:clone;}\n  .hero-copy p{font-size:19px;margin-bottom:32px;max-width:44ch;}\n  .ticker{\n    border:4px solid var(--ink);\n    background:var(--ink);color:var(--paper);\n    overflow:hidden;white-space:nowrap;\n    font-family:Arial Black,Arial,sans-serif;text-transform:uppercase;\n    padding:10px 0;margin:56px 0 0;\n  }\n  .ticker span{display:inline-block;animation:tick 18s linear infinite;}\n  @keyframes tick{from{transform:translateX(0);}to{transform:translateX(-50%);}}\n\n  /* ---------- annotated mockup ---------- */\n  .mockup-area{position:relative;}\n  .mockup{\n    background:#fff;\n    border:5px solid var(--ink);\n    box-shadow:14px 14px 0 var(--ink);\n  }\n  .mockup-bar{\n    border-bottom:5px solid var(--ink);\n    background:var(--blue);color:#fff;\n    font-family:Arial Black,Arial,sans-serif;text-transform:uppercase;\n    font-size:14px;padding:10px 16px;display:flex;justify-content:space-between;\n  }\n  .mockup-bar .dots span{display:inline-block;width:12px;height:12px;border:3px solid var(--ink);background:var(--yellow);margin-right:5px;}\n  .mockup-body{display:grid;grid-template-columns:110px 1fr;}\n  .mockup-side{border-right:5px solid var(--ink);background:var(--paper);}\n  .mockup-side div{\n    padding:12px 10px;border-bottom:3px solid var(--ink);\n    font-size:12px;font-weight:bold;text-transform:uppercase;\n  }\n  .mockup-side div.on{background:var(--pink);}\n  .week{padding:14px;display:grid;grid-template-columns:repeat(5,1fr);gap:10px;}\n  .day{border:3px solid var(--ink);background:var(--paper);min-height:180px;}\n  .day h4{\n    font-family:Arial Black,Arial,sans-serif;text-transform:uppercase;font-size:12px;\n    border-bottom:3px solid var(--ink);padding:6px 8px;background:#fff;\n  }\n  .task{\n    margin:8px;padding:6px;font-size:10px;font-weight:bold;\n    border:2px solid var(--ink);background:#fff;\n  }\n  .task.y{background:var(--yellow);}\n  .task.p{background:var(--pink);color:#fff;}\n  .task.g{background:var(--green);}\n  .task .who{\n    display:inline-block;margin-top:4px;font-size:8px;\n    background:var(--ink);color:var(--paper);padding:1px 5px;\n  }\n  .callout{\n    position:absolute;\n    background:var(--ink);color:var(--paper);\n    font-family:Arial Black,Arial,sans-serif;text-transform:uppercase;\n    font-size:12px;padding:8px 12px;box-shadow:5px 5px 0 var(--blue);\n  }\n  .callout::after{\n    content:\"\";position:absolute;width:0;height:0;\n    border:8px solid transparent;\n  }\n  .c1{top:-14px;right:-16px;transform:rotate(3deg);}\n  .c2{bottom:60px;left:-40px;transform:rotate(-2deg);background:var(--blue);box-shadow:5px 5px 0 var(--ink);}\n  .c3{top:120px;right:-30px;background:var(--yellow);color:var(--ink);box-shadow:5px 5px 0 var(--ink);transform:rotate(2deg);}\n\n  /* ---------- features ---------- */\n  .features{padding:72px 0;}\n  .section-title{font-size:clamp(32px,4vw,52px);margin-bottom:12px;}\n  .section-sub{font-size:18px;margin-bottom:36px;max-width:60ch;}\n  .feat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border:5px solid var(--ink);background:var(--ink);grid-gap:5px;}\n  .feat{background:var(--paper);padding:32px 24px;}\n  .feat:nth-child(2){background:var(--yellow);}\n  .feat:nth-child(4){background:var(--pink);}\n  .feat:nth-child(6){background:var(--blue);color:#fff;}\n  .feat-num{font-family:Arial Black,Arial,sans-serif;font-size:14px;border:3px solid currentColor;display:inline-block;padding:2px 10px;margin-bottom:16px;}\n  .feat h3{font-size:22px;margin-bottom:10px;}\n  .feat p{font-size:15px;}\n\n  /* ---------- how ---------- */\n  .how{border-top:5px solid var(--ink);border-bottom:5px solid var(--ink);background:var(--ink);color:var(--paper);padding:72px 0;}\n  .how .section-title{color:var(--yellow);}\n  .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:32px;}\n  .step h3{font-size:20px;color:var(--yellow);margin-bottom:8px;}\n  .step p{font-size:15px;color:#ddd;}\n\n  /* ---------- cta ---------- */\n  .cta{padding:96px 0;text-align:center;}\n  .cta h2{font-size:clamp(40px,6vw,72px);line-height:1;margin-bottom:16px;}\n  .cta p{font-size:19px;margin-bottom:36px;}\n  .email-box{\n    display:inline-flex;border:4px solid var(--ink);box-shadow:8px 8px 0 var(--ink);\n    background:#fff;\n  }\n  .email-box input{\n    font-family:inherit;font-size:17px;padding:16px 20px;border:none;outline:none;width:300px;\n  }\n  .email-box button{\n    font-family:Arial Black,Arial,sans-serif;font-size:16px;text-transform:uppercase;\n    border:none;border-left:4px solid var(--ink);background:var(--blue);color:#fff;\n    padding:0 26px;cursor:pointer;\n  }\n  .email-box button:hover{background:var(--ink);}\n\n  /* ---------- footer ---------- */\n  footer{border-top:5px solid var(--ink);background:var(--blue);color:#fff;padding:32px 0;}\n  footer .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:16px;}\n  footer a{color:var(--yellow);font-weight:bold;text-decoration:none;margin-left:20px;}\n  footer a:hover{text-decoration:underline;}\n\n  @media(max-width:900px){\n    .hero-grid{grid-template-columns:1fr;}\n    .feat-grid,.steps{grid-template-columns:1fr;}\n    .mockup-body{grid-template-columns:1fr;}\n    .mockup-side{display:none;}\n    .c2,.c3{display:none;}\n  }\n</style>\n</head>\n<body>\n\n<nav>\n  <div class=\"wrap\">\n    <div class=\"logo\"><span class=\"logo-mark\"></span>Tidepool</div>\n    <div>\n      <a class=\"nav-link\" href=\"#features\">Features</a>\n      <a class=\"nav-link\" href=\"#how\">How it works</a>\n      <a class=\"nav-link btn\" href=\"#cta\" style=\"font-size:14px;padding:10px 20px;box-shadow:5px 5px 0 var(--ink);\">Get started</a>\n    </div>\n  </div>\n</nav>\n\n<header class=\"wrap\">\n  <div class=\"hero-grid\">\n    <div class=\"hero-copy\">\n      <span class=\"tag\">For small teams of 2\u201312</span>\n      <h1>Plan your week <span class=\"hl\">together</span> \u2014 in one loud, honest board.</h1>\n      <p>Tidepool replaces the Monday standup scramble. Everyone drops what they're doing, what's blocked, and what can wait. Fifteen minutes. Zero surprises.</p>\n      <a class=\"btn blue\" href=\"#cta\">Start planning free</a>\n      <a class=\"btn\" href=\"#how\" style=\"margin-left:16px;\">See how it works</a>\n    </div>\n\n    <div class=\"mockup-area\">\n      <div class=\"callout c1\">\u2190 Everyone's week, one view</div>\n      <div class=\"callout c2\">Blocked? It turns pink. Fix it fast \u2192</div>\n      <div class=\"callout c3\">Drag to rebalance</div>\n      <div class=\"mockup\">\n        <div class=\"mockup-bar\">\n          <span>Team: Crustaceans \u00b7 Week 12</span>\n          <span class=\"dots\"><span></span><span></span><span></span></span>\n        </div>\n        <div class=\"mockup-body\">\n          <div class=\"mockup-side\">\n            <div class=\"on\">Week</div>\n            <div>People</div>\n            <div>Retro</div>\n            <div>Blocks</div>\n          </div>\n          <div class=\"week\">\n            <div class=\"day\"><h4>Mon</h4>\n              <div class=\"task y\">Ship landing page<span class=\"who\">MIRA</span></div>\n            </div>\n            <div class=\"day\"><h4>Tue</h4>\n              <div class=\"task\">API review<span class=\"who\">DEV + J</span></div>\n              <div class=\"task y\">User interviews<span class=\"who\">SAM</span></div>\n            </div>\n            <div class=\"day\"><h4>Wed</h4>\n              <div class=\"task p\">BLOCKED: staging down<span class=\"who\">DEV</span></div>\n            </div>\n            <div class=\"day\"><h4>Thu</h4>\n              <div class=\"task g\">DONE: pricing v2<span class=\"who\">MIRA</span></div>\n              <div class=\"task y\">Q3 draft<span class=\"who\">J</span></div>\n            </div>\n            <div class=\"day\"><h4>Fri</h4>\n              <div class=\"task\">Demo day<span class=\"who\">ALL</span></div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"ticker\"><span>15-minute weekly ritual \u2726 no more status meetings \u2726 blockers visible instantly \u2726 built for teams of 2\u201312 \u2726 15-minute weekly ritual \u2726 no more status meetings \u2726 blockers visible instantly \u2726 built for teams of 2\u201312 \u2726&nbsp;</span></div>\n</header>\n\n<section class=\"features wrap\" id=\"features\">\n  <h2 class=\"section-title\">Why teams switch to Tidepool</h2>\n  <p class=\"section-sub\">Project tools assume you'll maintain them. Tidepool asks for fifteen minutes a week and gives the whole picture back.</p>\n  <div class=\"feat-grid\">\n    <div class=\"feat\"><span class=\"feat-num\">01</span><h3>One shared board</h3><p>Every person's week, side by side. No digging through six tools to know what's happening.</p></div>\n    <div class=\"feat\"><span class=\"feat-num\">02</span><h3>Blockers turn pink</h3><p>Anything stuck lights up immediately \u2014 the whole team sees it before it becomes a Friday fire.</p></div>\n    <div class=\"feat\"><span class=\"feat-num\">03</span><h3>Friday retro in-app</h3><p>What shipped, what slipped, what to drop. Logged automatically, argued about optionally.</p></div>\n    <div class=\"feat\"><span class=\"feat-num\">04</span><h3>Drag to rebalance</h3><p>Overloaded? Drag a card to a teammate or next week. Capacity checks happen live.</p></div>\n    <div class=\"feat\"><span class=\"feat-num\">05</span><h3>Zero setup</h3><p>Invite your team, name your week, done. No templates, no admins, no onboarding webinar.</p></div>\n    <div class=\"feat\"><span class=\"feat-num\">06</span><h3>Free under 5 people</h3><p>Small teams shouldn't pay small fortunes. Free forever up to five seats. That's the deal.</p></div>\n  </div>\n</section>\n\n<section class=\"how\" id=\"how\">\n  <div class=\"wrap\">\n    <h2 class=\"section-title\">The 15-minute Monday ritual</h2>\n    <div class=\"steps\">\n      <div class=\"step\"><h3>Step 1 \u2014 Dump</h3><p>Everyone adds what they're doing this week. Rough is fine. Honest is required.</p></div>\n      <div class=\"step\"><h3>Step 2 \u2014 Flag</h3><p>Mark anything blocked, risky, or dropable. Tidepool surfaces conflicts and overloads.</p></div>\n      <div class=\"step\"><h3>Step 3 \u2014 Done</h3><p>Rebalance in one pass. Close the tab. Your week is planned and visible to everyone.</p></div>\n    </div>\n  </div>\n</section>\n\n<section class=\"cta wrap\" id=\"cta\">\n  <h2>Stop guessing. Start swimming.</h2>\n  <p>Join 2,400+ small teams planning their week in Tidepool.</p>\n  <div class=\"email-box\">\n    <input type=\"email\" placeholder=\"you@yourteam.com\">\n    <button>Get early access</button>\n  </div>\n</section>\n\n<footer>\n  <div class=\"wrap\">\n    <div class=\"logo\" style=\"color:#fff;font-size:20px;\"><span class=\"logo-mark\" style=\"border-color:#fff;background:var(--yellow);\"></span>Tidepool</div>\n    <div>\n      <a href=\"#features\">Features</a>\n      <a href=\"#how\">How it works</a>\n      <a href=\"#cta\">Pricing</a>\n    </div>\n  </div>\n</footer>\n\n</body>\n</html>\n"}