{"arm": "vs", "model": "z-ai/glm-5.3-flashx", "i": 3, "finish": "stop", "dirs": [{"direction": "Calm coastal minimalism \u2014 soft sand/ocean palette, generous whitespace, a live interactive week-planner demo as the hero", "probability": 0.4}, {"direction": "Bold brutalist editorial \u2014 huge type, hard black borders, high-contrast color blocks, marquee ticker", "probability": 0.15}, {"direction": "Dark-mode developer aesthetic \u2014 terminal vibes, monospace accents, glowing gradient accents, code-like animations", "probability": 0.1}, {"direction": "Playful illustrated SaaS \u2014 blobby shapes, hand-drawn feel, mascot waves, bright candy colors", "probability": 0.2}, {"direction": "Swiss grid / data-driven \u2014 strict typographic grid, kanban-style live diagrams, muted greys with one accent", "probability": 0.15}], "pick": {"direction": "Playful illustrated SaaS \u2014 blobby shapes, hand-drawn feel, mascot waves, bright candy colors", "probability": 0.2}, "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Tidepool \u2014 Plan your week together</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Patrick+Hand&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --ink:#2b2233;\n    --cream:#fff8ec;\n    --coral:#ff6b6b;\n    --aqua:#4ecdc4;\n    --sun:#ffd93d;\n    --mint:#a8e6cf;\n    --sky:#cdeef7;\n    --paper:#fffdf6;\n  }\n  *{margin:0;padding:0;box-sizing:border-box}\n  html{scroll-behavior:smooth}\n  body{\n    font-family:'Fredoka',sans-serif;\n    background:var(--cream);\n    color:var(--ink);\n    overflow-x:hidden;\n    line-height:1.5;\n  }\n  .hand{font-family:'Patrick Hand',cursive}\n  .wrap{max-width:1120px;margin:0 auto;padding:0 24px;position:relative}\n\n  /* sticker-style components */\n  .btn{\n    display:inline-block;font-family:'Fredoka',sans-serif;font-weight:600;\n    font-size:17px;padding:13px 26px;border-radius:255px 25px 225px 25px/25px 225px 25px 255px;\n    border:3px solid var(--ink);cursor:pointer;text-decoration:none;color:var(--ink);\n    background:var(--sun);box-shadow:4px 4px 0 var(--ink);\n    transition:transform .15s ease,box-shadow .15s ease;\n  }\n  .btn:hover{transform:translate(-2px,-2px) rotate(-1deg);box-shadow:7px 7px 0 var(--ink)}\n  .btn:active{transform:translate(2px,2px);box-shadow:1px 1px 0 var(--ink)}\n  .btn.coral{background:var(--coral);color:#fff}\n  .btn.big{font-size:20px;padding:16px 34px}\n\n  /* ============ NAV ============ */\n  nav{\n    position:sticky;top:0;z-index:50;\n    background:rgba(255,248,236,.92);backdrop-filter:blur(6px);\n    border-bottom:3px solid var(--ink);\n  }\n  .nav-in{display:flex;align-items:center;justify-content:space-between;padding:14px 24px;max-width:1120px;margin:0 auto}\n  .logo{display:flex;align-items:center;gap:10px;font-weight:700;font-size:24px;text-decoration:none;color:var(--ink)}\n  .logo svg{display:block}\n  .nav-links{display:flex;gap:28px;align-items:center}\n  .nav-links a{color:var(--ink);text-decoration:none;font-weight:500;font-size:16px;position:relative}\n  .nav-links a:not(.btn)::after{\n    content:\"\";position:absolute;left:0;right:100%;bottom:-4px;height:3px;\n    background:var(--coral);border-radius:3px;transition:right .25s ease;\n  }\n  .nav-links a:not(.btn):hover::after{right:0}\n  @media(max-width:760px){.nav-links a:not(.btn){display:none}}\n\n  /* ============ HERO ============ */\n  .hero{padding:70px 0 90px;position:relative}\n  .hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:40px;align-items:center}\n  @media(max-width:880px){.hero-grid{grid-template-columns:1fr}}\n  .badge{\n    display:inline-flex;align-items:center;gap:8px;\n    background:var(--mint);border:3px solid var(--ink);\n    border-radius:225px 15px 255px 15px/15px 255px 15px 225px;\n    padding:6px 16px;font-weight:600;font-size:14px;box-shadow:3px 3px 0 var(--ink);\n    transform:rotate(-2deg);margin-bottom:22px;\n  }\n  h1{\n    font-size:clamp(40px,5.4vw,62px);line-height:1.06;font-weight:700;\n    letter-spacing:-1px;margin-bottom:22px;\n  }\n  .squiggled{position:relative;display:inline-block}\n  .squiggled svg{position:absolute;left:-2%;bottom:-10px;width:104%;height:16px}\n  .hero p.lede{font-size:19px;max-width:460px;margin-bottom:30px;color:#544a5e}\n  .signup{display:flex;gap:12px;flex-wrap:wrap;align-items:center}\n  .signup input{\n    font-family:'Fredoka',sans-serif;font-size:16px;padding:13px 18px;\n    border:3px solid var(--ink);border-radius:25px 255px 25px 225px/255px 25px 225px 25px;\n    background:var(--paper);width:min(280px,100%);outline:none;box-shadow:inset 3px 3px 0 #eee2cb;\n  }\n  .signup input:focus{background:#fff}\n  .handnote{\n    font-family:'Patrick Hand',cursive;font-size:19px;color:var(--coral);\n    transform:rotate(-3deg);margin-top:22px;display:inline-block;\n  }\n  .hero-art{position:relative}\n  .hero-art svg.scene{width:100%;height:auto;display:block}\n  .float{animation:floaty 5s ease-in-out infinite}\n  .float.d1{animation-delay:-1.6s}.float.d2{animation-delay:-3.2s}\n  @keyframes floaty{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}\n\n  /* mascot eye + wave */\n  .pupil{transition:transform .08s linear}\n  .wave-arm{transform-origin:212px 205px;animation:wave 2.6s ease-in-out infinite}\n  @keyframes wave{\n    0%,60%,100%{transform:rotate(0deg)}\n    10%{transform:rotate(-16deg)}20%{transform:rotate(8deg)}\n    30%{transform:rotate(-16deg)}40%{transform:rotate(8deg)}\n    50%{transform:rotate(-10deg)}\n  }\n  .sparkle{animation:twinkle 2.2s ease-in-out infinite}\n  .sparkle.s2{animation-delay:-.8s}.sparkle.s3{animation-delay:-1.5s}\n  @keyframes twinkle{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.35;transform:scale(.75) rotate(20deg)}}\n\n  /* ============ MARQUEE ============ */\n  .marquee{\n    background:var(--coral);border-top:3px solid var(--ink);border-bottom:3px solid var(--ink);\n    overflow:hidden;padding:14px 0;transform:rotate(-1deg) scale(1.02);margin:10px -10px 0;\n  }\n  .marquee-track{display:flex;gap:0;white-space:nowrap;animation:scroll 26s linear infinite;width:max-content}\n  .marquee span{\n    color:#fff;font-weight:600;font-size:18px;letter-spacing:.5px;\n    display:inline-flex;align-items:center;gap:22px;padding-right:22px;\n  }\n  @keyframes scroll{to{transform:translateX(-50%)}}\n\n  /* ============ SECTION HEADS ============ */\n  section{padding:90px 0}\n  .sec-head{text-align:center;max-width:620px;margin:0 auto 60px}\n  .sec-kicker{\n    font-family:'Patrick Hand',cursive;font-size:20px;color:var(--aqua);\n    background:var(--ink);display:inline-block;padding:3px 18px;\n    border-radius:225px 15px 255px 15px/15px 255px 15px 225px;\n    transform:rotate(-1.5deg);margin-bottom:16px;\n  }\n  h2{font-size:clamp(30px,3.6vw,42px);font-weight:700;letter-spacing:-.5px}\n\n  /* ============ HOW IT WORKS ============ */\n  .how{position:relative}\n  .how-path{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}\n  @media(max-width:880px){.how-path{display:none}}\n  .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:44px;position:relative}\n  @media(max-width:880px){.steps{grid-template-columns:1fr;max-width:420px;margin:0 auto}}\n  .step{position:relative}\n  .step:nth-child(1){transform:rotate(-1.5deg) translateY(24px)}\n  .step:nth-child(2){transform:rotate(1deg) translateY(-14px)}\n  .step:nth-child(3){transform:rotate(-1deg) translateY(30px)}\n  .step-num{\n    width:58px;height:58px;display:grid;place-items:center;\n    font-weight:700;font-size:24px;color:var(--ink);\n    border:3px solid var(--ink);box-shadow:4px 4px 0 var(--ink);margin-bottom:18px;\n    border-radius:60% 40% 55% 45%/45% 55% 40% 60%;\n  }\n  .step:nth-child(1) .step-num{background:var(--sun);transform:rotate(-6deg)}\n  .step:nth-child(2) .step-num{background:var(--coral);transform:rotate(4deg)}\n  .step:nth-child(3) .step-num{background:var(--mint);transform:rotate(-3deg)}\n  .step h3{font-size:24px;margin-bottom:10px;font-weight:600}\n  .step p{color:#544a5e;font-size:16.5px}\n  .step .doodle{margin-bottom:16px;display:block}\n\n  /* ============ FEATURES ============ */\n  .features{background:var(--sky);border-top:3px solid var(--ink);border-bottom:3px solid var(--ink);\n    background-image:radial-gradient(#b3e2ef 2.5px,transparent 2.5px);background-size:34px 34px}\n  .feat-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:36px;align-items:start}\n  @media(max-width:880px){.feat-grid{grid-template-columns:1fr}}\n  .panel{\n    background:var(--paper);border:3px solid var(--ink);box-shadow:7px 7px 0 var(--ink);\n    border-radius:35px 18px 30px 20px/20px 30px 18px 35px;padding:30px;\n  }\n  .panel h3{font-size:24px;font-weight:600;margin:14px 0 8px}\n  .panel p{color:#544a5e;font-size:16px}\n  .panel.main{transform:rotate(-1deg)}\n  .panel .board-doodle{width:100%;height:auto;display:block;margin-top:8px}\n  .panel.side-a{transform:rotate(1.6deg);margin-bottom:36px}\n  .panel.side-b{transform:rotate(-1.2deg) translateX(14px)}\n  .panel .chip{\n    display:inline-block;font-family:'Patrick Hand',cursive;font-size:17px;\n    padding:2px 14px;border:2.5px solid var(--ink);border-radius:255px 15px 225px 15px/15px 225px 15px 255px;\n    transform:rotate(-2deg);\n  }\n\n  /* ============ QUOTE ============ */\n  .quote-sec{position:relative;padding:110px 0}\n  .quote-blob{\n    background:var(--sun);border:3px solid var(--ink);box-shadow:8px 8px 0 var(--ink);\n    border-radius:48% 52% 44% 56%/56% 44% 56% 44%;\n    padding:64px 70px;max-width:760px;margin:0 auto;text-align:center;position:relative;\n  }\n  .quote-blob blockquote{font-size:clamp(20px,2.4vw,27px);font-weight:500;line-height:1.4}\n  .quote-blob cite{\n    display:block;margin-top:18px;font-family:'Patrick Hand',cursive;\n    font-style:normal;font-size:19px;\n  }\n  .quote-tape{\n    position:absolute;top:-16px;left:50%;transform:translateX(-50%) rotate(-3deg);\n    background:var(--mint);border:3px solid var(--ink);padding:4px 26px;\n    font-family:'Patrick Hand',cursive;font-size:18px;\n    border-radius:255px 15px 225px 15px/15px 225px 15px 255px;\n  }\n\n  /* ============ CTA ============ */\n  .cta-blob{\n    background:var(--aqua);border:3px solid var(--ink);box-shadow:9px 9px 0 var(--ink);\n    border-radius:44px 22px 50px 26px/26px 50px 22px 44px;\n    padding:70px 50px 120px;text-align:center;position:relative;overflow:hidden;\n  }\n  .cta-blob h2{margin-bottom:14px}\n  .cta-blob p{max-width:440px;margin:0 auto 30px;font-size:18px;color:#123c39}\n  .peek{position:absolute;bottom:-6px;left:50%;transform:translateX(-50%);width:200px}\n\n  /* ============ FOOTER ============ */\n  footer{background:var(--ink);color:var(--cream);margin-top:100px;position:relative}\n  .wave-top{display:block;width:100%;height:44px;margin-bottom:-3px;fill:var(--cream);transform:translateY(1px)}\n  .foot-in{display:flex;justify-content:space-between;gap:40px;flex-wrap:wrap;padding:30px 24px 50px;max-width:1120px;margin:0 auto}\n  .foot-in .logo{color:var(--cream)}\n  .foot-links{display:flex;gap:60px;flex-wrap:wrap}\n  .foot-links h4{font-family:'Patrick Hand',cursive;font-size:18px;color:var(--aqua);margin-bottom:12px;font-weight:400}\n  .foot-links a{display:block;color:#c9bfd4;text-decoration:none;font-size:15px;margin-bottom:8px}\n  .foot-links a:hover{color:var(--sun)}\n  .foot-bottom{text-align:center;padding:18px;border-top:1px solid #4a3f56;font-size:14px;color:#9a8fa8}\n\n  /* reveal on scroll */\n  .reveal{opacity:0;transform:translateY(26px);transition:opacity .6s ease,transform .6s ease}\n  .reveal.in{opacity:1;transform:translateY(0)}\n</style>\n</head>\n<body>\n\n<!-- NAV -->\n<nav>\n  <div class=\"nav-in\">\n    <a class=\"logo\" href=\"#\">\n      <svg width=\"34\" height=\"34\" viewBox=\"0 0 34 34\"><path d=\"M4 20 Q4 6 17 6 Q30 6 30 20 Q30 30 17 30 Q4 30 4 20Z\" fill=\"#4ecdc4\" stroke=\"#2b2233\" stroke-width=\"2.6\"/><path d=\"M9 19 q3 -3.5 6 0 q3 3.5 6 0\" fill=\"none\" stroke=\"#fff8ec\" stroke-width=\"2.6\" stroke-linecap=\"round\"/><circle cx=\"13.5\" cy=\"13.5\" r=\"1.6\" fill=\"#2b2233\"/><circle cx=\"21\" cy=\"13.5\" r=\"1.6\" fill=\"#2b2233\"/></svg>\n      Tidepool\n    </a>\n    <div class=\"nav-links\">\n      <a href=\"#how\">How it works</a>\n      <a href=\"#features\">Features</a>\n      <a href=\"#story\">Stories</a>\n      <a class=\"btn\" href=\"#cta\" style=\"font-size:15px;padding:9px 20px\">Dive in</a>\n    </div>\n  </div>\n</nav>\n\n<!-- HERO -->\n<header class=\"hero\">\n  <div class=\"wrap hero-grid\">\n    <div>\n      <span class=\"badge\">\n        <svg width=\"15\" height=\"15\" viewBox=\"0 0 15 15\"><path d=\"M7.5 1 L9 5.5 L14 7.5 L9 9.5 L7.5 14 L6 9.5 L1 7.5 L6 5.5 Z\" fill=\"#2b2233\"/></svg>\n        For small teams of 2\u201312\n      </span>\n      <h1>Plan your <span class=\"squiggled\">week<svg viewBox=\"0 0 120 14\" preserveAspectRatio=\"none\"><path d=\"M2 8 q10 -8 20 0 t20 0 t20 0 t20 0 t20 0 t16 0\" fill=\"none\" stroke=\"#ff6b6b\" stroke-width=\"4.5\" stroke-linecap=\"round\"/></svg></span> like a pod,<br>not a pile of pings.</h1>\n      <p class=\"lede\">Tidepool turns Monday chaos into one shared, wobbly-friendly board. Everyone sees the week's tides \u2014 who's shipping what, who's heads-down, and where the slack pools up.</p>\n      <form class=\"signup\" onsubmit=\"event.preventDefault();this.querySelector('input').value='';this.querySelector('.btn').textContent='Splashed! \u2713'.replace(' \u2713','');\">\n        <input type=\"email\" placeholder=\"you@yourteam.com\" required>\n        <button class=\"btn coral\" type=\"submit\">Start floating</button>\n      </form>\n      <span class=\"handnote\">free for teams up to 5 \u2014 no card, no catch\n        <svg width=\"26\" height=\"30\" viewBox=\"0 0 26 30\" style=\"vertical-align:-10px\"><path d=\"M6 2 q10 4 8 22\" fill=\"none\" stroke=\"#ff6b6b\" stroke-width=\"2.5\" stroke-linecap=\"round\"/><path d=\"M9 20 l5 6 l6 -5\" fill=\"none\" stroke=\"#ff6b6b\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n      </span>\n    </div>\n\n    <!-- Hero scene: mascot + sticker card -->\n    <div class=\"hero-art\">\n      <svg class=\"scene\" viewBox=\"0 0 440 400\">\n        <!-- background blobs -->\n        <g class=\"float d1\">\n          <path d=\"M300 60 q60 -25 90 15 q28 38 -8 66 q-40 30 -82 6 q-40 -24 -22 -55 q10 -18 22 -32Z\" fill=\"#ffd93d\" stroke=\"#2b2233\" stroke-width=\"3\"/>\n        </g>\n        <g class=\"float d2\">\n          <path d=\"M40 250 q-20 -45 25 -60 q48 -16 66 22 q17 36 -20 55 q-45 22 -71 -17Z\" fill=\"#ff6b6b\" stroke=\"#2b2233\" stroke-width=\"3\"/>\n        </g>\n        <!-- sparkles -->\n        <g class=\"sparkle\"><path d=\"M330 210 l4 12 l12 4 l-12 4 l-4 12 l-4 -12 l-12 -4 l12 -4 Z\" fill=\"#4ecdc4\" stroke=\"#2b2233\" stroke-width=\"2\"/></g>\n        <g class=\"sparkle s2\"><path d=\"M85 90 l3.5 10 l10 3.5 l-10 3.5 l-3.5 10 l-3.5 -10 l-10 -3.5 l10 -3.5 Z\" fill=\"#ff6b6b\" stroke=\"#2b2233\" stroke-width=\"2\"/></g>\n        <g class=\"sparkle s3\"><path d=\"M395 330 l3 9 l9 3 l-9 3 l-3 9 l-3 -9 l-9 -3 l9 -3 Z\" fill=\"#ffd93d\" stroke=\"#2b2233\" stroke-width=\"2\"/></g>\n\n        <!-- floating week-card sticker -->\n        <g class=\"float\">\n          <g transform=\"rotate(-7 340 290)\">\n            <rect x=\"292\" y=\"248\" width=\"104\" height=\"88\" rx=\"12\" fill=\"#fffdf6\" stroke=\"#2b2233\" stroke-width=\"3\"/>\n            <rect x=\"292\" y=\"248\" width=\"104\" height=\"28\" rx=\"12\" fill=\"#a8e6cf\" stroke=\"#2b2233\" stroke-width=\"3\"/>\n            <text x=\"344\" y=\"268\" text-anchor=\"middle\" font-family=\"Patrick Hand\" font-size=\"16\" fill=\"#2b2233\">MON</text>\n            <path d=\"M304 292 h56\" stroke=\"#c9bfd4\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n            <path d=\"M304 306 h72\" stroke=\"#c9bfd4\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n            <path d=\"M304 320 h44\" stroke=\"#c9bfd4\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n            <circle cx=\"384\" cy=\"322\" r=\"13\" fill=\"#4ecdc4\" stroke=\"#2b2233\" stroke-width=\"2.5\"/>\n            <path d=\"M378 322 l4.5 4.5 l8 -9\" fill=\"none\" stroke=\"#fff8ec\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          </g>\n        </g>\n\n        <!-- MASCOT -->\n        <g>\n          <!-- body -->\n          <path d=\"M110 330 q-18 -110 55 -128 q60 -14 82 40 q10 26 8 88 q-1 22 -24 22 l-98 0 q-21 0 -23 -22Z\" fill=\"#4ecdc4\" stroke=\"#2b2233\" stroke-width=\"4\"/>\n          <!-- wavy puddle base -->\n          <path d=\"M78 352 q14 -14 30 0 q14 14 30 0 q14 -14 30 0 q14 14 30 0 q14 -14 30 0 q14 14 28 0 q6 -6 2 -14 l-180 0 q-4 8 0 14Z\" fill=\"#4ecdc4\" stroke=\"#2b2233\" stroke-width=\"4\" stroke-linejoin=\"round\"/>\n          <!-- left arm resting -->\n          <path d=\"M128 268 q-26 8 -30 34\" fill=\"none\" stroke=\"#2b2233\" stroke-width=\"16\" stroke-linecap=\"round\"/>\n          <path d=\"M128 268 q-26 8 -30 34\" fill=\"none\" stroke=\"#4ecdc4\" stroke-width=\"10\" stroke-linecap=\"round\"/>\n          <!-- waving arm -->\n          <g class=\"wave-arm\">\n            <path d=\"M212 212 q26 -22 22 -52\" fill=\"none\" stroke=\"#2b2233\" stroke-width=\"16\" stroke-linecap=\"round\"/>\n            <path d=\"M212 212 q26 -22 22 -52\" fill=\"none\" stroke=\"#4ecdc4\" stroke-width=\"10\" stroke-linecap=\"round\"/>\n            <circle cx=\"233\" cy=\"152\" r=\"13\" fill=\"#4ecdc4\" stroke=\"#2b2233\" stroke-width=\"3.5\"/>\n          </g>\n          <!-- eyes -->\n          <circle cx=\"172\" cy=\"240\" r=\"20\" fill=\"#fff\" stroke=\"#2b2233\" stroke-width=\"3.5\"/>\n          <circle cx=\"226\" cy=\"240\" r=\"20\" fill=\"#fff\" stroke=\"#2b2233\" stroke-width=\"3.5\"/>\n          <circle class=\"pupil\" data-eye=\"172,240\" cx=\"172\" cy=\"242\" r=\"8\" fill=\"#2b2233\"/>\n          <circle class=\"pupil\" data-eye=\"226,240\" cx=\"226\" cy=\"242\" r=\"8\" fill=\"#2b2233\"/>\n          <!-- blush -->\n          <ellipse cx=\"148\" cy=\"266\" rx=\"10\" ry=\"6\" fill=\"#ff6b6b\" opacity=\".55\"/>\n          <ellipse cx=\"250\" cy=\"266\" rx=\"10\" ry=\"6\" fill=\"#ff6b6b\" opacity=\".55\"/>\n          <!-- smile -->\n          <path d=\"M182 272 q17 16 34 0\" fill=\"none\" stroke=\"#2b2233\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n          <!-- little flag on head -->\n          <path d=\"M196 200 v-32\" stroke=\"#2b2233\" stroke-width=\"3.5\" stroke-linecap=\"round\"/>\n          <path d=\"M196 168 l26 8 l-26 8 Z\" fill=\"#ffd93d\" stroke=\"#2b2233\" stroke-width=\"3\" stroke-linejoin=\"round\"/>\n        </g>\n      </svg>\n    </div>\n  </div>\n</header>\n\n<!-- MARQUEE -->\n<div class=\"marquee\" aria-hidden=\"true\">\n  <div class=\"marquee-track\" id=\"mtrack\">\n    <span>monday syncs that take 4 minutes\n      <svg width=\"16\" height=\"16\" viewBox=\"0 0 15 15\"><path d=\"M7.5 1 L9 5.5 L14 7.5 L9 9.5 L7.5 14 L6 9.5 L1 7.5 L6 5.5 Z\" fill=\"#ffd93d\"/></svg></span>\n    <span>fewer meetings, more making\n      <svg width=\"16\" height=\"16\" viewBox=\"0 0 15 15\"><path d=\"M7.5 1 L9 5.5 L14 7.5 L9 9.5 L7.5 14 L6 9.5 L1 7.5 L6 5.5 Z\" fill=\"#a8e6cf\"/></svg></span>\n    <span>shared focus, zero guilt\n      <svg width=\"16\" height=\"16\" viewBox=\"0 0 15 15\"><path d=\"M7.5 1 L9 5.5 L14 7.5 L9 9.5 L7.5 14 L6 9.5 L1 7.5 L6 5.5 Z\" fill=\"#fff8ec\"/></svg></span>\n    <span>trades &amp; nudges, not nagging\n      <svg width=\"16\" height=\"16\" viewBox=\"0 0 15 15\"><path d=\"M7.5 1 L9 5.5 L14 7.5 L9 9.5 L7.5 14 L6 9.5 L1 7.5 L6 5.5 Z\" fill=\"#ffd93d\"/></svg></span>\n    <span>friday, but calm\n      <svg width=\"16\" height=\"16\" viewBox=\"0 0 15 15\"><path d=\"M7.5 1 L9 5.5 L14 7.5 L9 9.5 L7.5 14 L6 9.5 L1 7.5 L6 5.5 Z\" fill=\"#a8e6cf\"/></svg></span>\n  </div>\n</div>\n\n<!-- HOW IT WORKS -->\n<section id=\"how\" class=\"how\">\n  <div class=\"wrap\">\n    <div class=\"sec-head reveal\">\n      <span class=\"sec-kicker\">how it works</span>\n      <h2>Three little ripples to a calmer week</h2>\n    </div>\n\n    <!-- winding dashed path -->\n    <svg class=\"how-path\" viewBox=\"0 0 1120 480\" preserveAspectRatio=\"none\">\n      <path d=\"M120 130 Q340 40 540 150 T1020 160 Q1080 200 990 300 Q860 430 560 360 Q300 300 150 400\"\n        fill=\"none\" stroke=\"#2b2233\" stroke-width=\"3.5\" stroke-dasharray=\"2 14\" stroke-linecap=\"round\" opacity=\".5\"/>\n    </svg>\n\n    <div class=\"steps\">\n      <div class=\"step reveal\">\n        <svg class=\"doodle\" width=\"64\" height=\"64\" viewBox=\"0 0 64 64\"><rect x=\"10\" y=\"8\" width=\"44\" height=\"48\" rx=\"8\" fill=\"#fffdf6\" stroke=\"#2b2233\" stroke-width=\"3\"/><path d=\"M10 22 h44\" stroke=\"#2b2233\" stroke-width=\"3\"/><path d=\"M22 4 v8 M42 4 v8\" stroke=\"#2b2233\" stroke-width=\"3\" stroke-linecap=\"round\"/><path d=\"M20 34 h16 M20 44 h24\" stroke=\"#ff6b6b\" stroke-width=\"4\" stroke-linecap=\"round\"/></svg>\n        <div class=\"step-num\">1</div>\n        <h3>Drop in your week</h3>\n        <p>Everyone tosses their plans onto the tide board in about three minutes. Blocks, drifts, deep-work \u2014 scribbles welcome.</p>\n      </div>\n      <div class=\"step reveal\">\n        <svg class=\"doodle\" width=\"64\" height=\"64\" viewBox=\"0 0 64 64\"><path d=\"M8 12 q24 -10 48 0 q-6 14 0 26 q-24 10 -48 0 q6 -12 0 -26Z\" fill=\"#ffd93d\" stroke=\"#2b2233\" stroke-width=\"3\" stroke-linejoin=\"round\"/><path d=\"M20 22 q12 -5 24 0 M20 32 q12 5 24 0\" fill=\"none\" stroke=\"#2b2233\" stroke-width=\"3\" stroke-linecap=\"round\"/></svg>\n        <div class=\"step-num\">2</div>\n        <h3>Nudge &amp; trade</h3>\n        <p>Clashing deadlines? Send a gentle nudge or swap a block \u2014 Tidepool keeps the whole pod in sync without a single \u201cquick call?\u201d</p>\n      </div>\n      <div class=\"step reveal\">\n        <svg class=\"doodle\" width=\"64\" height=\"64\" viewBox=\"0 0 64 64\"><path d=\"M8 44 q14 -26 28 -8 q10 12 20 -12\" fill=\"none\" stroke=\"#4ecdc4\" stroke-width=\"5\" stroke-linecap=\"round\"/><path d=\"M46 20 l10 -4 l-2 11\" fill=\"none\" stroke=\"#4ecdc4\" stroke-width=\"5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M8 54 h48\" stroke=\"#2b2233\" stroke-width=\"3\" stroke-linecap=\"round\"/></svg>\n        <div class=\"step-num\">3</div>\n        <h3>Sail into Friday</h3>\n        <p>A Friday recap shows what actually shipped and where the week pooled over. Next Monday plans itself, almost.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- FEATURES -->\n<section id=\"features\" class=\"features\">\n  <div class=\"wrap\">\n    <div class=\"sec-head reveal\">\n      <span class=\"sec-kicker\">the good stuff</span>\n      <h2>Everything a pod needs, nothing it drowns in</h2>\n    </div>\n    <div class=\"feat-grid\">\n      <div class=\"panel main reveal\">\n        <span class=\"chip\" style=\"background:#ffd93d\">the tide board</span>\n        <h3>One board for the whole week</h3>\n        <p>Days as gentle columns, work as draggable stickers. Capacity, focus time and hand-offs are visible at a squint \u2014 no configuring, no Gantt-adjacent suffering.</p>\n        <svg class=\"board-doodle\" viewBox=\"0 0 460 210\">\n          <!-- three tilted day columns with sticker tasks -->\n          <g transform=\"rotate(-2 90 105)\">\n            <rect x=\"30\" y=\"24\" width=\"118\" height=\"160\" rx=\"14\" fill=\"#cdeef7\" stroke=\"#2b2233\" stroke-width=\"3\"/>\n            <text x=\"89\" y=\"50\" text-anchor=\"middle\" font-family=\"Patrick Hand\" font-size=\"18\" fill=\"#2b2233\">Mon</text>\n            <rect x=\"44\" y=\"62\" width=\"90\" height=\"30\" rx=\"9\" fill=\"#ff6b6b\" stroke=\"#2b2233\" stroke-width=\"2.5\"/>\n            <rect x=\"44\" y=\"100\" width=\"90\" height=\"30\" rx=\"9\" fill=\"#ffd93d\" stroke=\"#2b2233\" stroke-width=\"2.5\" transform=\"rotate(2 89 115)\"/>\n            <rect x=\"44\" y=\"140\" width=\"70\" height=\"30\" rx=\"9\" fill=\"#a8e6cf\" stroke=\"#2b2233\" stroke-width=\"2.5\" transform=\"rotate(-2 79 155)\"/>\n          </g>\n          <g transform=\"rotate(1.5 240 105)\">\n            <rect x=\"180\" y=\"30\" width=\"118\" height=\"160\" rx=\"14\" fill=\"#cdeef7\" stroke=\"#2b2233\" stroke-width=\"3\"/>\n            <text x=\"239\" y=\"56\" text-anchor=\"middle\" font-family=\"Patrick Hand\" font-size=\"18\" fill=\"#2b2233\">Wed</text>\n            <rect x=\"194\" y=\"70\" width=\"90\" height=\"30\" rx=\"9\" fill=\"#a8e6cf\" stroke=\"#2b2233\" stroke-width=\"2.5\" transform=\"rotate(-2 239 85)\"/>\n            <rect x=\"194\" y=\"112\" width=\"90\" height=\"30\" rx=\"9\" fill=\"#4ecdc4\" stroke=\"#2b2233\" stroke-width=\"2.5\" transform=\"rotate(2 239 127)\"/>\n            <path d=\"M204 162 q30 -8 66 0\" stroke=\"#c9bfd4\" stroke-width=\"5\" stroke-linecap=\"round\" fill=\"none\" stroke-dasharray=\"1 10\"/>\n          </g>\n          <g transform=\"rotate(-1.5 390 105)\">\n            <rect x=\"330\" y=\"24\" width=\"118\" height=\"160\" rx=\"14\" fill=\"#cdeef7\" stroke=\"#2b2233\" stroke-width=\"3\"/>\n            <text x=\"389\" y=\"50\" text-anchor=\"middle\" font-family=\"Patrick Hand\" font-size=\"18\" fill=\"#2b2233\">Fri</text>\n            <rect x=\"344\" y=\"64\" width=\"90\" height=\"30\" rx=\"9\" fill=\"#ffd93d\" stroke=\"#2b2233\" stroke-width=\"2.5\" transform=\"rotate(2 389 79)\"/>\n            <circle cx=\"428\" cy=\"148\" r=\"14\" fill=\"#4ecdc4\" stroke=\"#2b2233\" stroke-width=\"2.5\"/>\n            <path d=\"M421 148 l5 5 l9 -10\" fill=\"none\" stroke=\"#fff8ec\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            <path d=\"M350 116 h56\" stroke=\"#ff6b6b\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n          </g>\n        </svg>\n      </div>\n      <div>\n        <div class=\"panel side-a reveal\">\n          <span class=\"chip\" style=\"background:#a8e6cf\">focus tides</span>\n          <h3>See the week's rhythm</h3>\n          <p>A soft wave chart shows when the pod is deep in work and when it's pooled with slack \u2014 so you schedule the demo at high tide, not mid-crustacean.</p>\n        </div>\n        <div class=\"panel side-b reveal\">\n          <span class=\"chip\" style=\"background:#ff6b6b;color:#fff\">ship-shape</span>\n          <h3>Check-ins that write themselves</h3>\n          <p>Your board quietly becomes the Friday update. What moved, what stalled, who's swimming with room to help.</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- QUOTE -->\n<section id=\"story\" class=\"quote-sec\">\n  <div class=\"wrap\">\n    <div class=\"quote-blob reveal\">\n      <span class=\"quote-tape\">field notes from a calmer team</span>\n      <blockquote>\u201cWe went from four standups a week to one, and somehow we know <em>more</em> about what everyone's doing. The board is honest in a way our meetings never were.\u201d</blockquote>\n      <cite>\u2014 Priya, co-founder of a 6-person design studio</cite>\n    </div>\n  </div>\n</section>\n\n<!-- CTA -->\n<section id=\"cta\" style=\"padding-top:0\">\n  <div class=\"wrap\">\n    <div class=\"cta-blob reveal\">\n      <h2>Ready to float into next week?</h2>\n      <p>Set up your pod in under five minutes. Your first tide board is waiting \u2014 and so is someone waving at you.</p>\n      <a class=\"btn big\" href=\"#\">Start floating \u2014 it's free</a>\n      <!-- peeking mascot -->\n      <svg class=\"peek\" viewBox=\"0 0 200 90\">\n        <path d=\"M30 90 q-6 -55 70 -55 q76 0 70 55Z\" fill=\"#4ecdc4\" stroke=\"#2b2233\" stroke-width=\"4\"/>\n        <circle cx=\"75\" cy=\"58\" r=\"13\" fill=\"#fff\" stroke=\"#2b2233\" stroke-width=\"3\"/>\n        <circle cx=\"125\" cy=\"58\" r=\"13\" fill=\"#fff\" stroke=\"#2b2233\" stroke-width=\"3\"/>\n        <circle class=\"pupil\" data-eye=\"75,58\" cx=\"75\" cy=\"60\" r=\"5.5\" fill=\"#2b2233\"/>\n        <circle class=\"pupil\" data-eye=\"125,58\" cx=\"125\" cy=\"60\" r=\"5.5\" fill=\"#2b2233\"/>\n        <path d=\"M88 74 q12 10 24 0\" fill=\"none\" stroke=\"#2b2233\" stroke-width=\"3.5\" stroke-linecap=\"round\"/>\n        <ellipse cx=\"58\" cy=\"72\" rx=\"7\" ry=\"4\" fill=\"#ff6b6b\" opacity=\".55\"/>\n        <ellipse cx=\"142\" cy=\"72\" rx=\"7\" ry=\"4\" fill=\"#ff6b6b\" opacity=\".55\"/>\n      </svg>\n    </div>\n  </div>\n</section>\n\n<!-- FOOTER -->\n<footer>\n  <svg class=\"wave-top\" viewBox=\"0 0 1200 44\" preserveAspectRatio=\"none\">\n    <path d=\"M0 44 L0 22 q75 -20 150 0 t150 0 t150 0 t150 0 t150 0 t150 0 t150 0 t150 0 L1200 44 Z\"/>\n  </svg>\n  <div class=\"foot-in\">\n    <div>\n      <a class=\"logo\" href=\"#\" style=\"margin-bottom:12px\">\n        <svg width=\"30\" height=\"30\" viewBox=\"0 0 34 34\"><path d=\"M4 20 Q4 6 17 6 Q30 6 30 20 Q30 30 17 30 Q4 30 4 20Z\" fill=\"#4ecdc4\" stroke=\"#fff8ec\" stroke-width=\"2.6\"/><path d=\"M9 19 q3 -3.5 6 0 q3 3.5 6 0\" fill=\"none\" stroke=\"#2b2233\" stroke-width=\"2.6\" stroke-linecap=\"round\"/><circle cx=\"13.5\" cy=\"13.5\" r=\"1.6\" fill=\"#2b2233\"/><circle cx=\"21\" cy=\"13.5\" r=\"1.6\" fill=\"#2b2233\"/></svg>\n        Tidepool\n      </a>\n      <p class=\"hand\" style=\"color:#9a8fa8;font-size:17px;max-width:240px\">weekly planning for small teams who'd rather build than brief.</p>\n    </div>\n    <div class=\"foot-links\">\n      <div>\n        <h4>swim around</h4>\n        <a href=\"#how\">How it works</a>\n        <a href=\"#features\">Features</a>\n        <a href=\"#story\">Stories</a>\n      </div>\n      <div>\n        <h4>the pod</h4>\n        <a href=\"#\">About</a>\n        <a href=\"#\">Blog</a>\n        <a href=\"#\">Say hello</a>\n      </div>\n    </div>\n  </div>\n  <div class=\"foot-bottom\">\u00a9 2025 Tidepool \u2014 made with too much candy.</div>\n</footer>\n\n<script>\n  // pupils follow the cursor\n  const pupils = document.querySelectorAll('.pupil');\n  document.addEventListener('mousemove', e => {\n    pupils.forEach(p => {\n      const [ex, ey] = p.dataset.eye.split(',').map(Number);\n      const r = p.parentNode.closest('svg').getBoundingClientRect();\n      const scale = r.width / p.closest('svg').viewBox.baseVal.width;\n      const cx = r.left + ex * scale, cy = r.top + ey * scale;\n      const dx = e.clientX - cx, dy = e.clientY - cy;\n      const d = Math.hypot(dx, dy) || 1, m = Math.min(d, 90) / 90 * 5;\n      p.style.transform = `translate(${dx / d * m}px, ${dy / d * m}px)`;\n    });\n  });\n\n  // reveal on scroll\n  const io = new IntersectionObserver(es => es.forEach(en => {\n    if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); }\n  }), { threshold: .15 });\n  document.querySelectorAll('.reveal').forEach(el => io.observe(el));\n\n  // duplicate marquee content for a seamless loop\n  const t = document.getElementById('mtrack');\n  t.innerHTML += t.innerHTML;\n</script>\n</body>\n</html>\n"}