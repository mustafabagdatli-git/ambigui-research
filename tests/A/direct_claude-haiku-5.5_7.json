{"arm": "direct", "model": "anthropic/claude-haiku-5.5", "i": 7, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Tidepool: Plan your week together</title>\n  <meta name=\"description\" content=\"Tidepool helps small teams plan their week together in about fifteen minutes. Shared weekly boards, low-noise check-ins, and a Friday recap that writes itself.\">\n  <style>\n    :root {\n      --ink: #0e2629;\n      --deep: #123f46;\n      --teal: #1d7a78;\n      --teal-soft: #d7ede9;\n      --foam: #eef8f5;\n      --sand: #f8f3ea;\n      --sand-deep: #efe5d3;\n      --coral: #f06f4f;\n      --coral-soft: #fde3da;\n      --gold: #e8b33a;\n      --muted: #55706f;\n      --line: #d6e5e0;\n      --white: #ffffff;\n      --radius: 16px;\n      --radius-sm: 10px;\n      --shadow: 0 1px 2px rgba(14, 38, 41, .06), 0 12px 32px rgba(14, 38, 41, .08);\n      --font: ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n      --serif: ui-serif, Georgia, Cambria, \"Times New Roman\", serif;\n    }\n\n    *, *::before, *::after { box-sizing: border-box; }\n    html { scroll-behavior: smooth; }\n    body {\n      margin: 0;\n      font-family: var(--font);\n      color: var(--ink);\n      background: var(--white);\n      line-height: 1.6;\n      -webkit-font-smoothing: antialiased;\n    }\n    img, svg { display: block; max-width: 100%; }\n    a { color: var(--teal); text-decoration-thickness: 1px; text-underline-offset: 3px; }\n    a:focus-visible, button:focus-visible, summary:focus-visible {\n      outline: 3px solid var(--coral);\n      outline-offset: 3px;\n      border-radius: 6px;\n    }\n    h1, h2, h3 { line-height: 1.15; margin: 0; letter-spacing: -0.02em; }\n    p { margin: 0; }\n\n    .skip {\n      position: absolute; left: -9999px; top: 8px;\n      background: var(--ink); color: #fff; padding: 8px 14px; border-radius: 8px; z-index: 100;\n    }\n    .skip:focus { left: 8px; }\n\n    .container { width: min(1120px, calc(100% - 48px)); margin: 0 auto; }\n\n    .eyebrow {\n      display: inline-flex; align-items: center; gap: 8px;\n      font-size: 13px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase;\n      color: var(--teal);\n    }\n    .eyebrow::before {\n      content: \"\"; width: 18px; height: 2px; background: currentColor; border-radius: 2px;\n    }\n\n    /* Buttons */\n    .btn {\n      display: inline-flex; align-items: center; justify-content: center; gap: 8px;\n      font: inherit; font-weight: 600; font-size: 16px;\n      padding: 14px 22px; border-radius: 999px; border: 2px solid transparent;\n      text-decoration: none; cursor: pointer;\n      transition: transform .15s ease, background-color .15s ease, box-shadow .15s ease;\n    }\n    .btn:hover { transform: translateY(-1px); }\n    .btn-primary { background: var(--coral); color: #fff; box-shadow: 0 8px 20px rgba(240, 111, 79, .35); }\n    .btn-primary:hover { background: #e4603f; }\n    .btn-ghost { background: transparent; color: var(--deep); border-color: var(--deep); }\n    .btn-ghost:hover { background: var(--teal-soft); }\n    .btn-small { font-size: 14px; padding: 9px 16px; }\n    .btn-light { background: #fff; color: var(--deep); }\n    .btn-light:hover { background: var(--sand); }\n\n    /* Nav */\n    .site-header {\n      position: sticky; top: 0; z-index: 50;\n      background: rgba(255, 255, 255, .88);\n      backdrop-filter: saturate(160%) blur(10px);\n      border-bottom: 1px solid var(--line);\n    }\n    .nav {\n      display: flex; align-items: center; justify-content: space-between;\n      height: 72px; gap: 24px;\n    }\n    .brand {\n      display: flex; align-items: center; gap: 10px;\n      font-weight: 700; font-size: 20px; color: var(--deep); text-decoration: none;\n    }\n    .nav-links { display: flex; gap: 28px; list-style: none; margin: 0; padding: 0; }\n    .nav-links a {\n      color: var(--ink); text-decoration: none; font-weight: 500; font-size: 15px;\n    }\n    .nav-links a:hover { color: var(--teal); }\n    .nav-cta { display: flex; align-items: center; gap: 18px; }\n    .nav-signin { color: var(--ink); text-decoration: none; font-weight: 500; font-size: 15px; }\n\n    /* Hero */\n    .hero {\n      position: relative;\n      padding: 72px 0 0;\n      background:\n        radial-gradient(900px 500px at 85% -10%, var(--teal-soft), transparent 60%),\n        radial-gradient(700px 400px at -10% 10%, var(--sand-deep), transparent 60%),\n        var(--sand);\n      overflow: hidden;\n    }\n    .hero-grid {\n      display: grid; grid-template-columns: 1.02fr 1fr; gap: 56px; align-items: center;\n    }\n    .hero h1 {\n      font-family: var(--serif);\n      font-size: clamp(40px, 5.2vw, 64px);\n      font-weight: 600;\n      color: var(--deep);\n      margin: 18px 0 20px;\n    }\n    .hero h1 em { font-style: italic; color: var(--coral); }\n    .lede { font-size: 19px; color: var(--muted); max-width: 34em; }\n    .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; }\n    .hero-note { margin-top: 18px; font-size: 14px; color: var(--muted); }\n\n    /* Board mock */\n    .board {\n      background: var(--white);\n      border-radius: 22px;\n      box-shadow: 0 30px 60px rgba(18, 63, 70, .18), 0 2px 6px rgba(18, 63, 70, .06);\n      border: 1px solid var(--line);\n      padding: 18px;\n      transform: rotate(1.2deg);\n    }\n    .board-head {\n      display: flex; justify-content: space-between; align-items: center;\n      padding: 4px 4px 14px;\n    }\n    .board-head strong { font-size: 15px; color: var(--deep); }\n    .avatars { display: flex; }\n    .avatar {\n      width: 28px; height: 28px; border-radius: 50%;\n      display: grid; place-items: center;\n      font-size: 11px; font-weight: 700; color: #fff;\n      border: 2px solid #fff; margin-left: -8px;\n    }\n    .avatars .avatar:first-child { margin-left: 0; }\n    .a1 { background: #1d7a78; }\n    .a2 { background: #f06f4f; }\n    .a3 { background: #7a5bd6; }\n    .a4 { background: #d19a1c; }\n    .board-cols {\n      display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px;\n    }\n    .col { background: var(--foam); border-radius: var(--radius-sm); padding: 8px; min-height: 230px; }\n    .col-day {\n      font-size: 12px; font-weight: 700; color: var(--muted);\n      text-transform: uppercase; letter-spacing: .06em; padding: 2px 4px 8px;\n    }\n    .col-day.today { color: var(--coral); }\n    .task {\n      background: #fff; border-radius: 8px; padding: 8px 9px; margin-bottom: 7px;\n      font-size: 12px; line-height: 1.35; color: var(--ink);\n      border-left: 3px solid var(--teal);\n      box-shadow: 0 1px 2px rgba(14,38,41,.06);\n    }\n    .task.coral { border-color: var(--coral); }\n    .task.gold { border-color: var(--gold); }\n    .task.violet { border-color: #7a5bd6; }\n    .task small { display: block; margin-top: 4px; color: var(--muted); font-size: 11px; }\n    .task.done { opacity: .55; text-decoration: line-through; }\n    .board-foot {\n      display: flex; justify-content: space-between; align-items: center;\n      margin-top: 14px; padding: 12px 6px 2px; border-top: 1px dashed var(--line);\n      font-size: 13px; color: var(--muted);\n    }\n    .meter { width: 120px; height: 8px; background: var(--teal-soft); border-radius: 999px; overflow: hidden; }\n    .meter span { display: block; height: 100%; width: 68%; background: var(--teal); border-radius: 999px; }\n\n    .wave { display: block; width: 100%; height: 90px; margin-top: 64px; }\n\n    /* Sections */\n    section { padding: 96px 0; }\n    .section-head { max-width: 640px; margin-bottom: 56px; }\n    .section-head h2 {\n      font-family: var(--serif); font-size: clamp(32px, 4vw, 46px); color: var(--deep); margin: 14px 0 14px; font-weight: 600;\n    }\n    .section-head p { font-size: 18px; color: var(--muted); }\n\n    /* Problem strip */\n    .problem { background: var(--white); padding: 88px 0 40px; }\n    .problem-grid {\n      display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;\n    }\n    .quote-card {\n      border-top: 1px solid var(--line); padding-top: 24px;\n    }\n    .quote-card .big {\n      font-family: var(--serif); font-size: 26px; color: var(--deep); line-height: 1.3; margin-bottom: 10px;\n    }\n    .quote-card p { color: var(--muted); font-size: 15px; }\n\n    /* Features */\n    .features { background: var(--foam); }\n    .feature-grid {\n      display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;\n    }\n    .feature {\n      background: #fff; border-radius: var(--radius); padding: 28px;\n      border: 1px solid var(--line); box-shadow: var(--shadow);\n    }\n    .icon {\n      width: 48px; height: 48px; border-radius: 14px;\n      display: grid; place-items: center; margin-bottom: 18px;\n      background: var(--teal-soft); color: var(--teal);\n    }\n    .icon.coral { background: var(--coral-soft); color: #c94a2c; }\n    .icon.gold { background: #fbf0cf; color: #9a7010; }\n    .feature h3 { font-size: 19px; color: var(--deep); margin-bottom: 8px; }\n    .feature p { color: var(--muted); font-size: 15px; }\n\n    /* How it works */\n    .rhythm { background: var(--deep); color: #e6f2ef; }\n    .rhythm .eyebrow { color: #7fd1c6; }\n    .rhythm .section-head h2 { color: #fff; }\n    .rhythm .section-head p { color: #b5d3cd; }\n    .steps {\n      display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; position: relative; counter-reset: step;\n    }\n    .step {\n      background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12);\n      border-radius: var(--radius); padding: 30px 28px;\n    }\n    .step-tag {\n      display: inline-block; font-size: 13px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;\n      color: #0e2629; background: #7fd1c6; padding: 4px 10px; border-radius: 999px; margin-bottom: 18px;\n    }\n    .step:nth-child(2) .step-tag { background: var(--gold); }\n    .step:nth-child(3) .step-tag { background: var(--coral); color: #fff; }\n    .step h3 { color: #fff; font-size: 22px; margin-bottom: 10px; }\n    .step p { color: #b5d3cd; font-size: 15px; }\n    .step ul { margin: 16px 0 0; padding-left: 18px; color: #d6e9e5; font-size: 15px; }\n    .step li + li { margin-top: 6px; }\n\n    /* Split feature */\n    .split {\n      display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center;\n    }\n    .split h2 {\n      font-family: var(--serif); font-size: clamp(30px, 3.6vw, 42px); color: var(--deep); margin: 14px 0 18px; font-weight: 600;\n    }\n    .split p.body { color: var(--muted); font-size: 17px; margin-bottom: 14px; }\n    .checks { list-style: none; padding: 0; margin: 22px 0 0; display: grid; gap: 12px; }\n    .checks li { display: flex; gap: 12px; align-items: flex-start; font-size: 16px; }\n    .checks svg { flex: 0 0 22px; margin-top: 2px; color: var(--teal); }\n\n    .recap {\n      background: var(--sand); border-radius: 22px; padding: 30px;\n      border: 1px solid var(--sand-deep);\n    }\n    .recap-title { font-weight: 700; color: var(--deep); font-size: 16px; margin-bottom: 4px; }\n    .recap-sub { font-size: 13px; color: var(--muted); margin-bottom: 18px; }\n    .recap-item {\n      display: flex; gap: 12px; align-items: flex-start; background: #fff;\n      border-radius: 12px; padding: 14px 16px; margin-bottom: 10px; font-size: 14px;\n      box-shadow: 0 1px 2px rgba(14,38,41,.05);\n    }\n    .recap-item .dot { width: 10px; height: 10px; border-radius: 50%; margin-top: 6px; flex: 0 0 10px; }\n    .recap-item b { color: var(--deep); }\n    .recap-item span { color: var(--muted); }\n\n    /* Pricing */\n    .pricing { background: var(--sand); }\n    .pricing .section-head { margin-left: auto; margin-right: auto; text-align: center; }\n    .pricing .section-head p { margin: 0 auto; }\n    .price-grid {\n      display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; max-width: 840px; margin: 0 auto;\n    }\n    .plan {\n      background: #fff; border-radius: 22px; padding: 36px; border: 1px solid var(--line);\n      display: flex; flex-direction: column;\n    }\n    .plan.featured { border: 2px solid var(--teal); box-shadow: 0 20px 40px rgba(29,122,120,.15); position: relative; }\n    .badge {\n      position: absolute; top: -14px; left: 36px;\n      background: var(--teal); color: #fff; font-size: 12px; font-weight: 700;\n      padding: 5px 12px; border-radius: 999px; letter-spacing: .04em; text-transform: uppercase;\n    }\n    .plan h3 { font-size: 22px; color: var(--deep); }\n    .plan .desc { color: var(--muted); font-size: 15px; margin-top: 6px; min-height: 48px; }\n    .price { display: flex; align-items: baseline; gap: 6px; margin: 22px 0 24px; }\n    .price .amount { font-size: 48px; font-weight: 700; color: var(--ink); letter-spacing: -0.03em; }\n    .price .per { color: var(--muted); font-size: 15px; }\n    .plan ul { list-style: none; padding: 0; margin: 0 0 28px; display: grid; gap: 10px; font-size: 15px; }\n    .plan li { display: flex; gap: 10px; }\n    .plan li::before {\n      content: \"\"; flex: 0 0 16px; height: 16px; margin-top: 4px;\n      background: radial-gradient(circle, var(--teal) 4px, transparent 5px);\n    }\n    .plan .btn { margin-top: auto; }\n    .pricing-note { text-align: center; color: var(--muted); font-size: 14px; margin-top: 28px; }\n\n    /* FAQ */\n    .faq-wrap { display: grid; grid-template-columns: 1fr 1.4fr; gap: 64px; }\n    .faq-wrap h2 { font-family: var(--serif); font-size: clamp(30px, 3.6vw, 42px); color: var(--deep); margin: 14px 0 14px; font-weight: 600; }\n    .faq-wrap .intro { color: var(--muted); font-size: 17px; }\n    details {\n      border-bottom: 1px solid var(--line); padding: 20px 0;\n    }\n    details:first-child { border-top: 1px solid var(--line); }\n    summary {\n      list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px;\n      font-weight: 600; font-size: 17px; color: var(--deep);\n    }\n    summary::-webkit-details-marker { display: none; }\n    summary::after {\n      content: \"+\"; font-size: 24px; line-height: 1; color: var(--teal); flex: 0 0 auto; transition: transform .2s ease;\n    }\n    details[open] summary::after { transform: rotate(45deg); }\n    details p { margin-top: 12px; color: var(--muted); font-size: 16px; max-width: 58ch; }\n\n    /* Final CTA */\n    .final {\n      background: linear-gradient(160deg, var(--deep), #0b2e33);\n      color: #fff; text-align: center; padding: 0 0 96px; position: relative; overflow: hidden;\n    }\n    .final-wave { display: block; width: 100%; height: 80px; margin-bottom: -1px; }\n    .final h2 {\n      font-family: var(--serif); font-size: clamp(34px, 4.6vw, 54px); font-weight: 600; margin: 8px auto 18px; max-width: 16em;\n    }\n    .final p { color: #b5d3cd; font-size: 18px; max-width: 36em; margin: 0 auto 34px; }\n    .final .hero-actions { justify-content: center; }\n    .final .btn-ghost { color: #fff; border-color: rgba(255,255,255,.5); }\n    .final .btn-ghost:hover { background: rgba(255,255,255,.1); }\n\n    /* Footer */\n    footer { background: #0b2024; color: #9fbcb7; padding: 56px 0 36px; font-size: 14px; }\n    .foot-grid { display: grid; grid-template-columns: 2fr repeat(3, 1fr); gap: 40px; }\n    footer .brand { color: #fff; }\n    footer h4 { margin: 0 0 14px; color: #fff; font-size: 14px; letter-spacing: .04em; text-transform: uppercase; }\n    footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }\n    footer a { color: #9fbcb7; text-decoration: none; }\n    footer a:hover { color: #fff; }\n    .foot-base {\n      margin-top: 48px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,.08);\n      display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px;\n    }\n\n    /* Responsive */\n    @media (max-width: 960px) {\n      .hero-grid, .split, .faq-wrap { grid-template-columns: 1fr; gap: 48px; }\n      .board { transform: none; }\n      .feature-grid, .steps, .problem-grid { grid-template-columns: 1fr 1fr; }\n      .foot-grid { grid-template-columns: 1fr 1fr; }\n      .nav-links { display: none; }\n    }\n    @media (max-width: 640px) {\n      section { padding: 72px 0; }\n      .hero { padding-top: 48px; }\n      .feature-grid, .steps, .problem-grid, .price-grid { grid-template-columns: 1fr; }\n      .board-cols { grid-template-columns: 1fr; }\n      .col { min-height: 0; }\n      .col-day { display: flex; justify-content: space-between; }\n      .foot-grid { grid-template-columns: 1fr; }\n      .nav-signin { display: none; }\n      .plan.featured { margin-top: 10px; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      html { scroll-behavior: auto; }\n      * { transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n\n  <a class=\"skip\" href=\"#main\">Skip to content</a>\n\n  <header class=\"site-header\">\n    <div class=\"container nav\">\n      <a class=\"brand\" href=\"#top\" aria-label=\"Tidepool home\">\n        <svg width=\"30\" height=\"30\" viewBox=\"0 0 32 32\" aria-hidden=\"true\">\n          <circle cx=\"16\" cy=\"16\" r=\"15\" fill=\"#1d7a78\"/>\n          <path d=\"M6 17c3-3 5-3 8 0s5 3 8 0 4-2 4-2\" fill=\"none\" stroke=\"#eef8f5\" stroke-width=\"2.6\" stroke-linecap=\"round\"/>\n          <path d=\"M6 22c3-3 5-3 8 0s5 3 8 0 4-2 4-2\" fill=\"none\" stroke=\"#f06f4f\" stroke-width=\"2.6\" stroke-linecap=\"round\" opacity=\".9\"/>\n          <circle cx=\"16\" cy=\"10\" r=\"2.6\" fill=\"#e8b33a\"/>\n        </svg>\n        Tidepool\n      </a>\n      <nav aria-label=\"Primary\">\n        <ul class=\"nav-links\">\n          <li><a href=\"#features\">Features</a></li>\n          <li><a href=\"#rhythm\">How it works</a></li>\n          <li><a href=\"#pricing\">Pricing</a></li>\n          <li><a href=\"#faq\">FAQ</a></li>\n        </ul>\n      </nav>\n      <div class=\"nav-cta\">\n        <a class=\"nav-signin\" href=\"#\">Sign in</a>\n        <a class=\"btn btn-primary btn-small\" href=\"#start\">Start free</a>\n      </div>\n    </div>\n  </header>\n\n  <main id=\"main\">\n\n    <!-- HERO -->\n    <div class=\"hero\" id=\"top\">\n      <div class=\"container hero-grid\">\n        <div>\n          <span class=\"eyebrow\">Weekly planning for small teams</span>\n          <h1>Plan your week together, <em>in fifteen minutes.</em></h1>\n          <p class=\"lede\">Tidepool gives a team of two to twenty one shared week. Everyone drops in their priorities, the tide of the week shows what's moving, and the meeting that used to eat Monday morning becomes a quick look at the board.</p>\n          <div class=\"hero-actions\">\n            <a class=\"btn btn-primary\" href=\"#start\">Start planning free</a>\n            <a class=\"btn btn-ghost\" href=\"#rhythm\">See the weekly rhythm</a>\n          </div>\n          <p class=\"hero-note\">Free for teams up to five. No card required.</p>\n        </div>\n\n        <div aria-label=\"Preview of a Tidepool week board\">\n          <div class=\"board\">\n            <div class=\"board-head\">\n              <strong>Week of March 10</strong>\n              <div class=\"avatars\" aria-hidden=\"true\">\n                <span class=\"avatar a1\">JM</span>\n                <span class=\"avatar a2\">SK</span>\n                <span class=\"avatar a3\">AR</span>\n                <span class=\"avatar a4\">DL</span>\n              </div>\n            </div>\n            <div class=\"board-cols\">\n              <div class=\"col\">\n                <div class=\"col-day\">Mon</div>\n                <div class=\"task\">Ship onboarding copy<small>JM</small></div>\n                <div class=\"task coral\">Customer call: Harbor Co.<small>SK</small></div>\n                <div class=\"task done\">Weekly metrics pull<small>AR</small></div>\n              </div>\n              <div class=\"col\">\n                <div class=\"col-day\">Tue</div>\n                <div class=\"task gold\">Pricing page draft<small>DL</small></div>\n                <div class=\"task\">Review support backlog<small>JM</small></div>\n              </div>\n              <div class=\"col\">\n                <div class=\"col-day today\">Wed</div>\n                <div class=\"task violet\">Design critique, 45 min<small>SK</small></div>\n                <div class=\"task\">Fix export bug<small>AR</small></div>\n                <div class=\"task coral\">Finalize hiring brief<small>DL</small></div>\n              </div>\n              <div class=\"col\">\n                <div class=\"col-day\">Thu</div>\n                <div class=\"task\">Launch changelog<small>JM</small></div>\n              </div>\n              <div class=\"col\">\n                <div class=\"col-day\">Fri</div>\n                <div class=\"task done\">Friday recap<small>Everyone</small></div>\n                <div class=\"task\">Plan next week<small>Everyone</small></div>\n              </div>\n            </div>\n            <div class=\"board-foot\">\n              <span>11 of 16 commitments on track</span>\n              <span class=\"meter\" role=\"img\" aria-label=\"68 percent complete\"><span></span></span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <svg class=\"wave\" viewBox=\"0 0 1440 90\" preserveAspectRatio=\"none\" aria-hidden=\"true\">\n        <path fill=\"#ffffff\" d=\"M0,40 C240,90 480,0 720,40 C960,80 1200,10 1440,50 L1440,90 L0,90 Z\"/>\n      </svg>\n    </div>\n\n    <!-- PROBLEM -->\n    <section class=\"problem\" aria-labelledby=\"problem-title\">\n      <div class=\"container\">\n        <div class=\"section-head\">\n          <span class=\"eyebrow\">The problem</span>\n          <h2 id=\"problem-title\">Small teams don't need more tools. They need less drift.</h2>\n          <p>Most weeks start with good intentions and end with three people asking what everyone was working on. Tidepool closes that gap without a heavy process.</p>\n        </div>\n        <div class=\"problem-grid\">\n          <div class=\"quote-card\">\n            <div class=\"big\">\"Where did we write that down?\"</div>\n            <p>Plans live in chat threads, docs, and someone's head. Tidepool keeps one board the whole team can see.</p>\n          </div>\n          <div class=\"quote-card\">\n            <div class=\"big\">\"I thought you had that.\"</div>\n            <p>Every commitment has one owner and one day. Handoffs are visible before they become surprises.</p>\n          </div>\n          <div class=\"quote-card\">\n            <div class=\"big\">\"Can this be an email?\"</div>\n            <p>Check-ins are asynchronous by default. The meeting happens only when the board says it should.</p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- FEATURES -->\n    <section class=\"features\" id=\"features\" aria-labelledby=\"features-title\">\n      <div class=\"container\">\n        <div class=\"section-head\">\n          <span class=\"eyebrow\">What's inside</span>\n          <h2 id=\"features-title\">Everything a week needs. Nothing it doesn't.</h2>\n          <p>Six focused pieces that work together, built for teams small enough to know each other's calendars.</p>\n        </div>\n\n        <div class=\"feature-grid\">\n          <article class=\"feature\">\n            <div class=\"icon\" aria-hidden=\"true\">\n              <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"3\"/><path d=\"M3 9h18M9 4v16\"/></svg>\n            </div>\n            <h3>A shared week board</h3>\n            <p>Five columns, one per working day, plus a parking lot for anything not yet scheduled. Drag, drop, done.</p>\n          </article>\n\n          <article class=\"feature\">\n            <div class=\"icon coral\" aria-hidden=\"true\">\n              <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"9\" cy=\"8\" r=\"3.5\"/><path d=\"M2.5 20c.8-3.3 3.4-5 6.5-5s5.7 1.7 6.5 5\"/><path d=\"M16 4.5a3.5 3.5 0 0 1 0 7M18.5 15c1.4.8 2.2 2.3 2.5 5\"/></svg>\n            </div>\n            <h3>One owner per item</h3>\n            <p>Every task has a single name attached. Shared work is split into pieces so nothing sits in limbo.</p>\n          </article>\n\n          <article class=\"feature\">\n            <div class=\"icon gold\" aria-hidden=\"true\">\n              <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 12c2.5-3 4.5-3 7 0s4.5 3 7 0 3-2.5 4-2.5\"/><path d=\"M3 17c2.5-3 4.5-3 7 0s4.5 3 7 0 3-2.5 4-2.5\"/></svg>\n            </div>\n            <h3>The tide view</h3>\n            <p>A single glance shows what's rising (new work landing), what's receding (finished), and what's stuck on the rocks.</p>\n          </article>\n\n          <article class=\"feature\">\n            <div class=\"icon\" aria-hidden=\"true\">\n              <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 5h16v11H9l-5 4z\"/></svg>\n            </div>\n            <h3>Async check-ins</h3>\n            <p>Each person posts a three-line update on Wednesday. Replies stay threaded to the item, not lost in a channel.</p>\n          </article>\n\n          <article class=\"feature\">\n            <div class=\"icon coral\" aria-hidden=\"true\">\n              <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3v4M12 17v4M3 12h4M17 12h4\"/><circle cx=\"12\" cy=\"12\" r=\"4\"/></svg>\n            </div>\n            <h3>Focus blocks</h3>\n            <p>Protect deep work by marking time as a block. Tidepool warns you when a day is too full to be honest about.</p>\n          </article>\n\n          <article class=\"feature\">\n            <div class=\"icon gold\" aria-hidden=\"true\">\n              <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12l4 4 10-10\"/></svg>\n            </div>\n            <h3>Friday recap</h3>\n            <p>Done items roll into a plain-language summary you can paste into a newsletter, a Slack post, or your own notes.</p>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <!-- RHYTHM -->\n    <section class=\"rhythm\" id=\"rhythm\" aria-labelledby=\"rhythm-title\">\n      <div class=\"container\">\n        <div class=\"section-head\">\n          <span class=\"eyebrow\">The weekly rhythm</span>\n          <h2 id=\"rhythm-title\">Three moments. About fifteen minutes total.</h2>\n          <p>Tidepool is built around a simple cadence, so planning stops being a project and becomes a habit.</p>\n        </div>\n\n        <div class=\"steps\">\n          <div class=\"step\">\n            <span class=\"step-tag\">Monday \u00b7 10 min</span>\n            <h3>Set the tide</h3>\n            <p>Everyone places their commitments for the week and names one thing they will not compromise on.</p>\n            <ul>\n              <li>Drop items into days</li>\n              <li>Pick one anchor per person</li>\n            </ul>\n          </div>\n          <div class=\"step\">\n            <span class=\"step-tag\">Wednesday \u00b7 3 min</span>\n            <h3>Check the water</h3>\n            <p>A quick async pass. Flag what's slipping and reassign anything that needs a second pair of hands.</p>\n            <ul>\n              <li>Three-line updates</li>\n              <li>Surface blockers early</li>\n            </ul>\n          </div>\n          <div class=\"step\">\n            <span class=\"step-tag\">Friday \u00b7 5 min</span>\n            <h3>Read the recap</h3>\n            <p>Tidepool drafts a summary of what shipped and what moved. Edit it, share it, and roll the rest forward.</p>\n            <ul>\n              <li>Automatic recap draft</li>\n              <li>Carry unfinished work forward</li>\n            </ul>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- SPLIT FEATURE -->\n    <section aria-labelledby=\"split-title\">\n      <div class=\"container split\">\n        <div>\n          <span class=\"eyebrow\">Built for small teams</span>\n          <h2 id=\"split-title\">Enough structure to stay aligned. Light enough to actually use.</h2>\n          <p class=\"body\">Large planning suites assume a dedicated operations person. Tidepool assumes you're busy building things and would rather spend your attention on the work itself.</p>\n          <ul class=\"checks\">\n            <li>\n              <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12l4 4 10-10\"/></svg>\n              <span>No setup beyond inviting your team. Your first board is ready in under a minute.</span>\n            </li>\n            <li>\n              <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12l4 4 10-10\"/></svg>\n              <span>Connects to the calendar you already use, so focus blocks and meetings stay in sync.</span>\n            </li>\n            <li>\n              <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12l4 4 10-10\"/></svg>\n              <span>Your data exports as plain CSV or Markdown at any time. No lock-in.</span>\n            </li>\n          </ul>\n        </div>\n\n        <div class=\"recap\" aria-label=\"Example Friday recap\">\n          <div class=\"recap-title\">Friday recap \u00b7 Week of March 10</div>\n          <div class=\"recap-sub\">Drafted by Tidepool from this week's board. Edit freely.</div>\n          <div class=\"recap-item\">\n            <span class=\"dot\" style=\"background:#1d7a78\"></span>\n            <div><b>Shipped:</b> <span>Onboarding copy and the changelog launch.</span></div>\n          </div>\n          <div class=\"recap-item\">\n            <span class=\"dot\" style=\"background:#f06f4f\"></span>\n            <div><b>Customer:</b> <span>Harbor Co. call completed, with two follow-ups booked.</span></div>\n          </div>\n          <div class=\"recap-item\">\n            <span class=\"dot\" style=\"background:#e8b33a\"></span>\n            <div><b>Moved to next week:</b> <span>Pricing page draft, pending legal review.</span></div>\n          </div>\n          <div class=\"recap-item\">\n            <span class=\"dot\" style=\"background:#7a5bd6\"></span>\n            <div><b>Focus:</b> <span>Design critique held. Two decisions recorded.</span></div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- PRICING -->\n    <section class=\"pricing\" id=\"pricing\" aria-labelledby=\"pricing-title\">\n      <div class=\"container\">\n        <div class=\"section-head\">\n          <span class=\"eyebrow\">Pricing</span>\n          <h2 id=\"pricing-title\">Start free. Pay only when your team grows.</h2>\n          <p>Simple plans, no seat minimums, no surprise add-ons.</p>\n        </div>\n\n        <div class=\"price-grid\">\n          <div class=\"plan\">\n            <h3>Starter</h3>\n            <p class=\"desc\">For teams of up to five who want a shared week without the overhead.</p>\n            <div class=\"price\"><span class=\"amount\">$0</span><span class=\"per\">forever</span></div>\n            <ul>\n              <li>Up to 5 people</li>\n              <li>Shared week board and tide view</li>\n              <li>Async check-ins</li>\n              <li>Friday recap drafts</li>\n            </ul>\n            <a class=\"btn btn-ghost\" href=\"#start\">Start free</a>\n          </div>\n\n          <div class=\"plan featured\">\n            <span class=\"badge\">Most popular</span>\n            <h3>Team</h3>\n            <p class=\"desc\">For growing teams that need calendar sync, history, and admin controls.</p>\n            <div class=\"price\"><span class=\"amount\">$6</span><span class=\"per\">per person / month, billed annually</span></div>\n            <ul>\n              <li>Unlimited teammates</li>\n              <li>Calendar sync and focus blocks</li>\n              <li>Searchable week history</li>\n              <li>Workload warnings and admin controls</li>\n              <li>CSV and Markdown export</li>\n            </ul>\n            <a class=\"btn btn-primary\" href=\"#start\">Try Team free for 14 days</a>\n          </div>\n        </div>\n        <p class=\"pricing-note\">Prices in USD. Monthly billing is available at $8 per person.</p>\n      </div>\n    </section>\n\n    <!-- FAQ -->\n    <section id=\"faq\" aria-labelledby=\"faq-title\">\n      <div class=\"container faq-wrap\">\n        <div>\n          <span class=\"eyebrow\">Questions</span>\n          <h2 id=\"faq-title\">Good questions, plainly answered.</h2>\n          <p class=\"intro\">Still wondering something? Write to us and a real person will reply within a working day.</p>\n        </div>\n        <div>\n          <details>\n            <summary>How is this different from a project management tool?</summary>\n            <p>Project tools are built around long-running work and backlogs. Tidepool is built around the week. It answers \"what are we doing this Tuesday, and who is doing it?\" and stays out of the way the rest of the time.</p>\n          </details>\n          <details>\n            <summary>Does everyone need to be on the same schedule?</summary>\n            <p>No. Teammates in different time zones can post Monday plans and Wednesday updates whenever suits them. The board always shows the latest state for everyone.</p>\n          </details>\n          <details>\n            <summary>What happens to unfinished work on Friday?</summary>\n            <p>Anything not marked done can roll forward to the next week with one click, keeping its owner and history. Nothing quietly disappears.</p>\n          </details>\n          <details>\n            <summary>Can we bring our existing tasks in?</summary>\n            <p>Yes. Paste a list or import a CSV and Tidepool will place items on days according to their due dates. You can rearrange everything afterward.</p>\n          </details>\n          <details>\n            <summary>Who can see our board?</summary>\n            <p>Only people you invite to your workspace. Admins can control visibility per board, and you can remove a teammate at any time with their history intact for your team.</p>\n          </details>\n        </div>\n      </div>\n    </section>\n\n    <!-- FINAL CTA -->\n    <section class=\"final\" id=\"start\" aria-labelledby=\"final-title\">\n      <svg class=\"final-wave\" viewBox=\"0 0 1440 80\" preserveAspectRatio=\"none\" aria-hidden=\"true\">\n        <path fill=\"#ffffff\" d=\"M0,0 L1440,0 L1440,20 C1200,80 960,0 720,30 C480,60 240,10 0,40 Z\"/>\n      </svg>\n      <div class=\"container\" style=\"padding-top: 72px;\">\n        <span class=\"eyebrow\" style=\"color:#7fd1c6\">Ready when you are</span>\n        <h2 id=\"final-title\">Make Monday the easiest day of the week.</h2>\n        <p>Set up your first shared week in a few minutes. Invite your team when you're ready, or try it alone first.</p>\n        <div class=\"hero-actions\">\n          <a class=\"btn btn-primary\" href=\"#start\">Start planning free</a>\n          <a class=\"btn btn-ghost\" href=\"#pricing\">Compare plans</a>\n        </div>\n      </div>\n    </section>\n\n  </main>\n\n  <footer>\n    <div class=\"container\">\n      <div class=\"foot-grid\">\n        <div>\n          <a class=\"brand\" href=\"#top\">\n            <svg width=\"26\" height=\"26\" viewBox=\"0 0 32 32\" aria-hidden=\"true\">\n              <circle cx=\"16\" cy=\"16\" r=\"15\" fill=\"#1d7a78\"/>\n              <path d=\"M6 17c3-3 5-3 8 0s5 3 8 0 4-2 4-2\" fill=\"none\" stroke=\"#eef8f5\" stroke-width=\"2.6\" stroke-linecap=\"round\"/>\n              <path d=\"M6 22c3-3 5-3 8 0s5 3 8 0 4-2 4-2\" fill=\"none\" stroke=\"#f06f4f\" stroke-width=\"2.6\" stroke-linecap=\"round\"/>\n            </svg>\n            Tidepool\n          </a>\n          <p style=\"margin-top: 14px; max-width: 26em;\">A shared week for small teams. Plan together, check the tide, and close the loop on Friday.</p>\n        </div>\n        <div>\n          <h4>Product</h4>\n          <ul>\n            <li><a href=\"#features\">Features</a></li>\n            <li><a href=\"#rhythm\">How it works</a></li>\n            <li><a href=\"#pricing\">Pricing</a></li>\n          </ul>\n        </div>\n        <div>\n          <h4>Company</h4>\n          <ul>\n            <li><a href=\"#\">About</a></li>\n            <li><a href=\"#\">Careers</a></li>\n            <li><a href=\"#\">Contact</a></li>\n          </ul>\n        </div>\n        <div>\n          <h4>Resources</h4>\n          <ul>\n            <li><a href=\"#faq\">FAQ</a></li>\n            <li><a href=\"#\">Changelog</a></li>\n            <li><a href=\"#\">Privacy</a></li>\n          </ul>\n        </div>\n      </div>\n      <div class=\"foot-base\">\n        <span>\u00a9 2025 Tidepool. All rights reserved.</span>\n        <span>Made for teams who would rather be building.</span>\n      </div>\n    </div>\n  </footer>\n\n</body>\n</html>\n"}