{"arm": "vs", "model": "anthropic/claude-haiku-5.5", "i": 2, "finish": "stop", "dirs": [{"direction": "Tidewater editorial: warm paper background, serif headlines, muted teal and sand, generous whitespace, calm and unhurried", "probability": 0.3}, {"direction": "Neo-brutalist utility: thick black borders, hard offset shadows, saturated yellow and blue, chunky grotesque type, playful and loud", "probability": 0.15}, {"direction": "Dark product showcase: deep navy canvas, soft gradient glows, monospace labels, a large interface screenshot built in CSS as the hero", "probability": 0.2}, {"direction": "Friendly illustrated: rounded pastel shapes, bubbly sans-serif, cartoon-like CSS illustrations of team members, approachable and warm", "probability": 0.15}, {"direction": "Swiss typographic minimalism: strict modular grid, black and one red accent, large numerals and hairline rules, no decorative elements", "probability": 0.2}], "pick": {"direction": "Swiss typographic minimalism: strict modular grid, black and one red accent, large numerals and hairline rules, no decorative elements", "probability": 0.2}, "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tidepool \u2014 Plan your week together</title>\n<style>\n  /* ---------- Tokens ---------- */\n  :root {\n    --ink: #0A0A0A;\n    --paper: #FFFFFF;\n    --red: #E3120B;\n    --rule: 1px solid var(--ink);\n    --hair: 1px solid rgba(10,10,10,.18);\n    --gutter: 24px;\n    --margin: 32px;\n    --sans: \"Helvetica Neue\", Helvetica, Arial, \"Liberation Sans\", sans-serif;\n    --mono: ui-monospace, \"SFMono-Regular\", Menlo, Consolas, monospace;\n  }\n\n  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n\n  html { -webkit-text-size-adjust: 100%; }\n\n  body {\n    background: var(--paper);\n    color: var(--ink);\n    font-family: var(--sans);\n    font-size: 17px;\n    line-height: 1.5;\n    font-feature-settings: \"kern\", \"liga\";\n    -webkit-font-smoothing: antialiased;\n  }\n\n  a { color: inherit; text-decoration: none; }\n  a:focus-visible, button:focus-visible { outline: 2px solid var(--red); outline-offset: 3px; }\n\n  /* ---------- Grid system: 12 columns, strict ---------- */\n  .wrap {\n    width: 100%;\n    max-width: 1280px;\n    margin: 0 auto;\n    padding: 0 var(--margin);\n  }\n  .grid {\n    display: grid;\n    grid-template-columns: repeat(12, minmax(0, 1fr));\n    column-gap: var(--gutter);\n  }\n\n  /* Column spans */\n  .c-1-4  { grid-column: 1 / span 4; }\n  .c-1-5  { grid-column: 1 / span 5; }\n  .c-1-6  { grid-column: 1 / span 6; }\n  .c-1-10 { grid-column: 1 / span 10; }\n  .c-1-12 { grid-column: 1 / -1; }\n  .c-5-12 { grid-column: 5 / -1; }\n  .c-7-12 { grid-column: 7 / -1; }\n  .c-7-10 { grid-column: 7 / span 4; }\n  .c-5-8  { grid-column: 5 / span 4; }\n  .c-9-12 { grid-column: 9 / -1; }\n  .c-1-3  { grid-column: 1 / span 3; }\n  .c-4-6  { grid-column: 4 / span 3; }\n\n  /* ---------- Type ---------- */\n  .label {\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n  }\n  .label--red { color: var(--red); }\n\n  .display {\n    font-weight: 700;\n    letter-spacing: -.045em;\n    line-height: .9;\n  }\n  h2.section-title {\n    font-size: clamp(36px, 4.6vw, 64px);\n    font-weight: 700;\n    letter-spacing: -.035em;\n    line-height: .98;\n  }\n  h3 {\n    font-size: 22px;\n    font-weight: 700;\n    letter-spacing: -.015em;\n    line-height: 1.15;\n  }\n  p { max-width: 46ch; }\n  .lede { font-size: 22px; line-height: 1.35; letter-spacing: -.01em; max-width: 36ch; }\n  .muted { color: rgba(10,10,10,.62); }\n  .num {\n    font-weight: 700;\n    font-variant-numeric: tabular-nums;\n    letter-spacing: -.06em;\n    line-height: .85;\n  }\n\n  /* ---------- Rules ---------- */\n  .rule-top    { border-top: var(--rule); }\n  .hair-top    { border-top: var(--hair); }\n  .hair-bottom { border-bottom: var(--hair); }\n\n  section { padding: 96px 0 0; }\n  .section-head { padding-bottom: 32px; }\n\n  /* ---------- Header ---------- */\n  header.site {\n    border-bottom: var(--rule);\n    position: sticky;\n    top: 0;\n    background: var(--paper);\n    z-index: 10;\n  }\n  .nav {\n    height: 72px;\n    align-items: center;\n  }\n  .brand {\n    grid-column: 1 / span 3;\n    font-size: 20px;\n    font-weight: 700;\n    letter-spacing: -.03em;\n  }\n  .brand span { color: var(--red); }\n  .nav-links {\n    grid-column: 4 / span 6;\n    display: flex;\n    gap: 32px;\n    list-style: none;\n    font-size: 15px;\n  }\n  .nav-links a:hover { color: var(--red); }\n  .nav-cta {\n    grid-column: 10 / span 3;\n    justify-self: end;\n    display: inline-flex;\n    align-items: center;\n    height: 40px;\n    padding: 0 18px;\n    background: var(--ink);\n    color: var(--paper);\n    font-size: 14px;\n    font-weight: 700;\n    letter-spacing: .01em;\n  }\n  .nav-cta:hover { background: var(--red); }\n\n  /* ---------- Hero ---------- */\n  .hero { padding: 72px 0 0; }\n  .hero-meta {\n    display: flex;\n    justify-content: space-between;\n    padding-bottom: 20px;\n    margin-bottom: 56px;\n    border-bottom: var(--hair);\n  }\n  .hero h1 {\n    grid-column: 1 / -1;\n    font-size: clamp(60px, 10.4vw, 156px);\n    margin-bottom: 72px;\n  }\n  .hero h1 em {\n    font-style: normal;\n    color: var(--red);\n  }\n  .hero-foot {\n    padding: 28px 0 96px;\n    border-top: var(--rule);\n    row-gap: 32px;\n  }\n  .hero-foot .lede { margin-top: 0; }\n  .btn-row {\n    display: flex;\n    gap: 16px;\n    margin-top: 40px;\n    flex-wrap: wrap;\n  }\n  .btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 40px;\n    height: 56px;\n    padding: 0 22px;\n    font-size: 16px;\n    font-weight: 700;\n    border: var(--rule);\n    min-width: 220px;\n  }\n  .btn-primary { background: var(--red); border-color: var(--red); color: #fff; }\n  .btn-primary:hover { background: var(--ink); border-color: var(--ink); }\n  .btn-ghost { background: transparent; color: var(--ink); }\n  .btn-ghost:hover { background: var(--ink); color: var(--paper); }\n  .arrow { font-family: var(--mono); font-weight: 400; }\n  .fine { margin-top: 16px; font-size: 13px; }\n\n  /* ---------- Week board (typographic schedule) ---------- */\n  .board { border-top: var(--rule); border-bottom: var(--rule); }\n  .board-row {\n    display: grid;\n    grid-template-columns: 200px repeat(7, minmax(0, 1fr));\n    border-bottom: var(--hair);\n    min-height: 64px;\n  }\n  .board-row:last-child { border-bottom: 0; }\n  .board-row > div {\n    padding: 14px 12px 14px 0;\n    font-size: 15px;\n    border-left: var(--hair);\n    padding-left: 12px;\n    line-height: 1.3;\n  }\n  .board-row > div:first-child {\n    border-left: 0;\n    padding-left: 0;\n    font-weight: 700;\n  }\n  .board-head > div {\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n    padding-top: 12px;\n    padding-bottom: 12px;\n  }\n  .board-head > div.today { color: var(--red); }\n  .board-row .sub {\n    display: block;\n    font-size: 13px;\n    color: rgba(10,10,10,.6);\n    font-weight: 400;\n    margin-top: 2px;\n  }\n  .board-row .mark { color: var(--red); font-weight: 700; }\n  .board-caption {\n    display: flex;\n    justify-content: space-between;\n    padding-top: 14px;\n    font-size: 13px;\n  }\n\n  /* ---------- Stats ---------- */\n  .stat {\n    border-top: var(--rule);\n    padding-top: 20px;\n  }\n  .stat .num { font-size: clamp(80px, 11vw, 170px); margin-bottom: 20px; }\n  .stat .num.red { color: var(--red); }\n  .stat p { font-size: 16px; max-width: 24ch; }\n\n  /* ---------- Principles / features ---------- */\n  .feature {\n    border-top: var(--rule);\n    padding: 20px 0 48px;\n  }\n  .feature .num {\n    font-size: 64px;\n    margin-bottom: 40px;\n    display: block;\n  }\n  .feature .num.red { color: var(--red); }\n  .feature h3 { margin-bottom: 14px; }\n  .feature p { color: rgba(10,10,10,.75); font-size: 16px; }\n\n  /* ---------- Steps ---------- */\n  .step {\n    display: grid;\n    grid-template-columns: subgrid;\n    grid-column: 1 / -1;\n    border-top: var(--hair);\n    padding: 28px 0 40px;\n    align-items: start;\n  }\n  .step:last-child { border-bottom: var(--hair); }\n  .step .num { font-size: 96px; grid-column: 1 / span 3; }\n  .step .body { grid-column: 4 / span 4; }\n  .step .body h3 { font-size: 30px; letter-spacing: -.025em; margin-bottom: 12px; }\n  .step .body p { font-size: 16px; color: rgba(10,10,10,.75); }\n  .step .detail {\n    grid-column: 9 / -1;\n    font-family: var(--mono);\n    font-size: 13px;\n    line-height: 1.7;\n    padding-top: 10px;\n  }\n  .steps { row-gap: 0; }\n\n  /* ---------- Pricing ---------- */\n  .tier {\n    border-top: var(--rule);\n    padding-top: 20px;\n    display: flex;\n    flex-direction: column;\n    min-height: 460px;\n  }\n  .tier .price {\n    font-size: clamp(64px, 7vw, 104px);\n    margin: 28px 0 8px;\n  }\n  .tier .price small {\n    font-size: 16px;\n    letter-spacing: 0;\n    font-weight: 400;\n    margin-left: 6px;\n  }\n  .tier ul {\n    list-style: none;\n    margin: 28px 0 40px;\n    border-top: var(--hair);\n  }\n  .tier li {\n    padding: 12px 0;\n    border-bottom: var(--hair);\n    font-size: 15px;\n  }\n  .tier .btn { margin-top: auto; min-width: 0; width: 100%; }\n  .tier.featured .price { color: var(--red); }\n\n  /* ---------- Closing CTA ---------- */\n  .closing {\n    padding: 120px 0 120px;\n    border-top: var(--rule);\n  }\n  .closing h2 {\n    font-size: clamp(64px, 9vw, 136px);\n    letter-spacing: -.05em;\n    line-height: .9;\n    font-weight: 700;\n    grid-column: 1 / -1;\n    margin-bottom: 56px;\n  }\n  .closing h2 span { color: var(--red); }\n\n  /* ---------- Footer ---------- */\n  footer.site-foot {\n    border-top: var(--rule);\n    padding: 28px 0 40px;\n    font-size: 13px;\n  }\n  footer .foot-col ul { list-style: none; }\n  footer .foot-col li { margin-bottom: 8px; }\n  footer .foot-col a:hover { color: var(--red); }\n  footer .wordmark {\n    font-size: clamp(48px, 9vw, 130px);\n    font-weight: 700;\n    letter-spacing: -.055em;\n    line-height: .8;\n    grid-column: 1 / -1;\n    margin-top: 48px;\n  }\n\n  /* ---------- Responsive ---------- */\n  @media (max-width: 960px) {\n    :root { --margin: 24px; --gutter: 16px; }\n    section { padding-top: 72px; }\n    .nav-links { display: none; }\n    .brand { grid-column: 1 / span 6; }\n    .nav-cta { grid-column: 7 / -1; }\n    .c-1-4, .c-1-5, .c-1-6, .c-5-12, .c-7-12, .c-7-10, .c-5-8, .c-9-12, .c-1-3, .c-4-6 {\n      grid-column: 1 / -1;\n    }\n    .c-1-6.half { grid-column: span 6; }\n    .feature { grid-column: span 6; }\n    .stat { grid-column: span 6; }\n    .step { display: block; }\n    .step .num { font-size: 72px; display: block; margin-bottom: 20px; }\n    .tier { min-height: 0; margin-bottom: 48px; }\n    .board { overflow-x: auto; }\n    .board-row { min-width: 760px; }\n    .hero-meta span:nth-child(2) { display: none; }\n    .fine { margin-bottom: 0; }\n  }\n\n  @media (max-width: 600px) {\n    .brand { grid-column: 1 / -1; }\n    .nav { height: auto; padding: 16px 0; row-gap: 12px; }\n    .nav-cta { grid-column: 1 / -1; justify-self: stretch; justify-content: center; }\n    .feature, .stat { grid-column: 1 / -1; }\n    .btn { width: 100%; }\n    .hero-foot { padding-bottom: 72px; }\n  }\n</style>\n</head>\n<body>\n\n<header class=\"site\">\n  <div class=\"wrap\">\n    <nav class=\"grid nav\" aria-label=\"Primary\">\n      <a href=\"#\" class=\"brand\">Tidepool<span>.</span></a>\n      <ul class=\"nav-links\">\n        <li><a href=\"#method\">Method</a></li>\n        <li><a href=\"#board\">The board</a></li>\n        <li><a href=\"#principles\">Principles</a></li>\n        <li><a href=\"#pricing\">Pricing</a></li>\n      </ul>\n      <a href=\"#pricing\" class=\"nav-cta\">Start planning \u2192</a>\n    </nav>\n  </div>\n</header>\n\n<main>\n\n  <!-- HERO -->\n  <section class=\"hero\" style=\"padding-top:72px;\">\n    <div class=\"wrap\">\n      <div class=\"hero-meta label\">\n        <span>Weekly planning for small teams</span>\n        <span>Vol. 01 \u2014 2\u201312 people</span>\n        <span class=\"label--red\">Week 24</span>\n      </div>\n\n      <div class=\"grid\">\n        <h1 class=\"display\">\n          Plan the week.<br>\n          <em>Together.</em>\n        </h1>\n      </div>\n\n      <div class=\"grid hero-foot\">\n        <div class=\"c-1-5\">\n          <p class=\"lede\">Tidepool gives small teams one shared week. Everyone sees what matters, what's blocked, and who owns what \u2014 before Monday starts.</p>\n        </div>\n        <div class=\"c-7-12\">\n          <div class=\"btn-row\">\n            <a href=\"#pricing\" class=\"btn btn-primary\">Start free <span class=\"arrow\">\u2192</span></a>\n            <a href=\"#board\" class=\"btn btn-ghost\">See the board <span class=\"arrow\">\u2193</span></a>\n          </div>\n          <p class=\"fine muted\">No credit card. Set up in under four minutes.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- STATS -->\n  <section id=\"stats\" style=\"padding-top:0;\">\n    <div class=\"wrap\">\n      <div class=\"grid\">\n        <div class=\"c-1-4 stat\">\n          <div class=\"num red\">04</div>\n          <p>Minutes to run a full weekly plan with a team of six.</p>\n        </div>\n        <div class=\"c-5-8 stat\">\n          <div class=\"num\">12</div>\n          <p>Maximum people per workspace before we suggest splitting teams.</p>\n        </div>\n        <div class=\"c-9-12 stat\">\n          <div class=\"num\">0</div>\n          <p>Status meetings required. The plan replaces the standup.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- THE BOARD -->\n  <section id=\"board\">\n    <div class=\"wrap\">\n      <div class=\"grid section-head\">\n        <div class=\"c-1-4\"><span class=\"label\">01 \u2014 The board</span></div>\n        <div class=\"c-5-12\"><h2 class=\"section-title\">One grid for<br>everyone's week.</h2></div>\n      </div>\n\n      <div class=\"board\" role=\"table\" aria-label=\"Example weekly board\">\n        <div class=\"board-row board-head\" role=\"row\">\n          <div role=\"columnheader\">Owner</div>\n          <div role=\"columnheader\">Mon</div>\n          <div role=\"columnheader\" class=\"today\">Tue</div>\n          <div role=\"columnheader\">Wed</div>\n          <div role=\"columnheader\">Thu</div>\n          <div role=\"columnheader\">Fri</div>\n          <div role=\"columnheader\">Sat</div>\n          <div role=\"columnheader\">Sun</div>\n        </div>\n        <div class=\"board-row\" role=\"row\">\n          <div role=\"rowheader\">Ana<span class=\"sub\">Design lead</span></div>\n          <div role=\"cell\">Onboarding flow<span class=\"sub\">Figma review</span></div>\n          <div role=\"cell\"><span class=\"mark\">Ship v2.3</span><span class=\"sub\">Ready by 14:00</span></div>\n          <div role=\"cell\">Usability sessions</div>\n          <div role=\"cell\">\u2014</div>\n          <div role=\"cell\">Write-up<span class=\"sub\">Share Friday</span></div>\n          <div role=\"cell\">\u2014</div>\n          <div role=\"cell\">\u2014</div>\n        </div>\n        <div class=\"board-row\" role=\"row\">\n          <div role=\"rowheader\">Ben<span class=\"sub\">Engineering</span></div>\n          <div role=\"cell\">Billing migration</div>\n          <div role=\"cell\">Billing migration<span class=\"sub\">Staging only</span></div>\n          <div role=\"cell\"><span class=\"mark\">Freeze</span><span class=\"sub\">No deploys</span></div>\n          <div role=\"cell\">Incident review</div>\n          <div role=\"cell\">Billing migration</div>\n          <div role=\"cell\">\u2014</div>\n          <div role=\"cell\">\u2014</div>\n        </div>\n        <div class=\"board-row\" role=\"row\">\n          <div role=\"rowheader\">Chloe<span class=\"sub\">Operations</span></div>\n          <div role=\"cell\">Vendor calls</div>\n          <div role=\"cell\">Q3 budget<span class=\"sub\">Draft to finance</span></div>\n          <div role=\"cell\">Vendor calls</div>\n          <div role=\"cell\">Hiring loop</div>\n          <div role=\"cell\"><span class=\"mark\">Close week</span></div>\n          <div role=\"cell\">\u2014</div>\n          <div role=\"cell\">\u2014</div>\n        </div>\n      </div>\n      <div class=\"board-caption muted\">\n        <span>Illustrative board. Shared, editable, and visible to the whole team.</span>\n        <span>Updated live</span>\n      </div>\n    </div>\n  </section>\n\n  <!-- METHOD -->\n  <section id=\"method\">\n    <div class=\"wrap\">\n      <div class=\"grid section-head\">\n        <div class=\"c-1-4\"><span class=\"label\">02 \u2014 Method</span></div>\n        <div class=\"c-5-12\"><h2 class=\"section-title\">Three steps.<br>No meeting.</h2></div>\n      </div>\n\n      <div class=\"grid steps\">\n        <div class=\"step\">\n          <div class=\"num\">01</div>\n          <div class=\"body\">\n            <h3>Collect</h3>\n            <p>Each person adds their commitments, blockers, and time off in under two minutes, before the week opens.</p>\n          </div>\n          <div class=\"detail\">INPUT: 2 min / person<br>DEADLINE: Friday 16:00</div>\n        </div>\n        <div class=\"step\">\n          <div class=\"num red\">02</div>\n          <div class=\"body\">\n            <h3>Resolve</h3>\n            <p>Tidepool flags conflicts, double-booked owners, and overloaded days. Resolve them in place, not in a thread.</p>\n          </div>\n          <div class=\"detail\">CONFLICTS: auto-detected<br>OWNERS: one per item</div>\n        </div>\n        <div class=\"step\">\n          <div class=\"num\">03</div>\n          <div class=\"body\">\n            <h3>Commit</h3>\n            <p>Lock the week with one click. The plan goes out as a single page, and changes after lock are logged.</p>\n          </div>\n          <div class=\"detail\">LOCK: one action<br>AUDIT: every change</div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- PRINCIPLES -->\n  <section id=\"principles\">\n    <div class=\"wrap\">\n      <div class=\"grid section-head\">\n        <div class=\"c-1-4\"><span class=\"label\">03 \u2014 Principles</span></div>\n        <div class=\"c-5-12\"><h2 class=\"section-title\">Built to stay<br>out of the way.</h2></div>\n      </div>\n\n      <div class=\"grid\">\n        <div class=\"feature c-1-6 half\">\n          <span class=\"num\">01</span>\n          <h3>One week, one page</h3>\n          <p>Every plan fits on a single screen. If it doesn't fit, it's too big for one week.</p>\n        </div>\n        <div class=\"feature c-7-12 half\">\n          <span class=\"num red\">02</span>\n          <h3>Owners, not assignees</h3>\n          <p>Each item has exactly one owner. Helpers are listed separately so responsibility never blurs.</p>\n        </div>\n        <div class=\"feature c-1-6 half\">\n          <span class=\"num\">03</span>\n          <h3>Capacity is visible</h3>\n          <p>Hours, leave, and focus blocks are shown beside the work, so over-commitment is obvious early.</p>\n        </div>\n        <div class=\"feature c-7-12 half\">\n          <span class=\"num\">04</span>\n          <h3>Quiet by default</h3>\n          <p>Tidepool sends one summary per week, plus alerts only when a commitment changes. No feed to scroll.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- PRICING -->\n  <section id=\"pricing\">\n    <div class=\"wrap\">\n      <div class=\"grid section-head\">\n        <div class=\"c-1-4\"><span class=\"label\">04 \u2014 Pricing</span></div>\n        <div class=\"c-5-12\"><h2 class=\"section-title\">Priced per team,<br>not per seat.</h2></div>\n      </div>\n\n      <div class=\"grid\">\n        <div class=\"tier c-1-4\">\n          <span class=\"label\">Starter</span>\n          <div class=\"price num\">\u20ac0</div>\n          <p class=\"muted\">For teams of up to four getting started with a shared week.</p>\n          <ul>\n            <li>Up to 4 people</li>\n            <li>One active board</li>\n            <li>Weekly summary</li>\n          </ul>\n          <a href=\"#\" class=\"btn btn-ghost\">Start free <span class=\"arrow\">\u2192</span></a>\n        </div>\n\n        <div class=\"tier featured c-5-8\">\n          <span class=\"label label--red\">Team \u2014 Most chosen</span>\n          <div class=\"price num\">\u20ac24<small>/ month</small></div>\n          <p class=\"muted\">For teams of five to twelve who plan every week.</p>\n          <ul>\n            <li>Up to 12 people</li>\n            <li>Unlimited boards and history</li>\n            <li>Capacity and leave tracking</li>\n            <li>Conflict detection</li>\n          </ul>\n          <a href=\"#\" class=\"btn btn-primary\">Start 14-day trial <span class=\"arrow\">\u2192</span></a>\n        </div>\n\n        <div class=\"tier c-9-12\">\n          <span class=\"label\">Studio</span>\n          <div class=\"price num\">Custom</div>\n          <p class=\"muted\">For multiple small teams sharing one account and audit trail.</p>\n          <ul>\n            <li>Multiple workspaces</li>\n            <li>Single sign-on</li>\n            <li>Export and API access</li>\n          </ul>\n          <a href=\"#\" class=\"btn btn-ghost\">Talk to us <span class=\"arrow\">\u2192</span></a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- CLOSING -->\n  <section class=\"closing\">\n    <div class=\"wrap\">\n      <div class=\"grid\">\n        <h2>Monday starts<br><span>planned.</span></h2>\n      </div>\n      <div class=\"grid\">\n        <div class=\"c-1-5\">\n          <p class=\"lede\">Set up your first team in four minutes. Lock your first week before the weekend.</p>\n        </div>\n        <div class=\"c-7-12\">\n          <div class=\"btn-row\" style=\"margin-top:0;\">\n            <a href=\"#\" class=\"btn btn-primary\">Create your workspace <span class=\"arrow\">\u2192</span></a>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer class=\"site-foot\">\n  <div class=\"wrap\">\n    <div class=\"grid\">\n      <div class=\"foot-col c-1-3\">\n        <span class=\"label\">Tidepool</span>\n        <p class=\"muted\" style=\"margin-top:8px;\">A weekly planning tool for small teams.</p>\n      </div>\n      <div class=\"foot-col c-4-6\">\n        <ul>\n          <li><a href=\"#method\">Method</a></li>\n          <li><a href=\"#board\">The board</a></li>\n          <li><a href=\"#pricing\">Pricing</a></li>\n        </ul>\n      </div>\n      <div class=\"foot-col c-7-9\">\n        <ul>\n          <li><a href=\"#\">Privacy</a></li>\n          <li><a href=\"#\">Terms</a></li>\n          <li><a href=\"#\">Security</a></li>\n        </ul>\n      </div>\n      <div class=\"foot-col c-9-12\" style=\"text-align:right;\">\n        <span class=\"muted\">\u00a9 2025 Tidepool</span>\n      </div>\n      <div class=\"wordmark\">Tidepool<span style=\"color:var(--red)\">.</span></div>\n    </div>\n  </div>\n</footer>\n\n</body>\n</html>\n"}