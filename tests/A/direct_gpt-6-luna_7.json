{"arm": "direct", "model": "openai/gpt-6-luna", "i": 7, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#f5f4ef\">\n  <title>Tidepool \u2014 Make a little room for good work</title>\n  <style>\n    :root {\n      color-scheme: light;\n      --ink: #173331;\n      --muted: #687b75;\n      --paper: #f5f4ef;\n      --white: #fffefa;\n      --green: #1f6457;\n      --mint: #dcebe2;\n      --coral: #f1a184;\n      --line: #e6e7df;\n      --shadow: 0 24px 70px rgba(31, 57, 49, .12);\n      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n    }\n\n    * { box-sizing: border-box; }\n\n    body {\n      margin: 0;\n      color: var(--ink);\n      background: var(--paper);\n      -webkit-font-smoothing: antialiased;\n    }\n\n    a { color: inherit; text-decoration: none; }\n\n    .shell {\n      width: min(1160px, calc(100% - 48px));\n      margin: 0 auto;\n    }\n\n    header {\n      height: 84px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n    }\n\n    .brand {\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      font-size: 21px;\n      font-weight: 760;\n      letter-spacing: -.06em;\n    }\n\n    .brand-mark {\n      width: 34px;\n      height: 34px;\n      display: grid;\n      place-items: center;\n      color: var(--green);\n      background: #e2ede4;\n      border-radius: 50% 50% 46% 54%;\n    }\n\n    .brand-mark svg { width: 23px; height: 23px; }\n\n    nav {\n      display: flex;\n      align-items: center;\n      gap: 34px;\n      color: #526a63;\n      font-size: 13px;\n      font-weight: 560;\n    }\n\n    nav a:hover, .text-link:hover { color: var(--green); }\n\n    .nav-cta {\n      padding: 11px 17px;\n      border: 1px solid #cbd8d0;\n      border-radius: 999px;\n      color: var(--ink);\n      transition: .2s ease;\n    }\n\n    .nav-cta:hover { background: var(--white); }\n\n    .hero {\n      min-height: 650px;\n      display: grid;\n      grid-template-columns: .88fr 1.12fr;\n      align-items: center;\n      gap: 44px;\n      padding: 50px 0 82px;\n    }\n\n    .hero-copy { padding: 10px 0 18px; }\n\n    .eyebrow {\n      display: inline-flex;\n      align-items: center;\n      gap: 9px;\n      color: var(--green);\n      font-size: 11px;\n      font-weight: 750;\n      letter-spacing: .12em;\n      text-transform: uppercase;\n    }\n\n    .eyebrow-dot {\n      width: 8px;\n      height: 8px;\n      background: var(--coral);\n      border-radius: 50%;\n      box-shadow: 0 0 0 4px #f5e2d8;\n    }\n\n    h1 {\n      max-width: 540px;\n      margin: 23px 0 19px;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: clamp(52px, 6.2vw, 77px);\n      font-weight: 500;\n      line-height: .99;\n      letter-spacing: -.065em;\n    }\n\n    h1 em {\n      color: var(--green);\n      font-weight: 500;\n    }\n\n    .hero-copy > p {\n      max-width: 440px;\n      margin: 0;\n      color: #60736d;\n      font-size: 16px;\n      line-height: 1.75;\n    }\n\n    .hero-actions {\n      display: flex;\n      align-items: center;\n      gap: 19px;\n      margin-top: 29px;\n    }\n\n    .button {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: 10px;\n      min-height: 48px;\n      padding: 0 20px;\n      border-radius: 999px;\n      font-size: 13px;\n      font-weight: 680;\n      transition: transform .2s ease, background .2s ease;\n    }\n\n    .button:hover { transform: translateY(-2px); }\n\n    .button-primary {\n      color: white;\n      background: var(--green);\n      box-shadow: 0 8px 20px rgba(31, 100, 87, .17);\n    }\n\n    .button-primary:hover { background: #174f45; }\n\n    .text-link {\n      color: #49615a;\n      font-size: 13px;\n      font-weight: 650;\n    }\n\n    .text-link span { margin-left: 5px; }\n\n    .micro-proof {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      margin-top: 31px;\n      color: #73827d;\n      font-size: 11px;\n    }\n\n    .avatars { display: flex; padding-left: 3px; }\n    .avatar {\n      width: 26px;\n      height: 26px;\n      display: grid;\n      place-items: center;\n      margin-left: -4px;\n      border: 2px solid var(--paper);\n      border-radius: 50%;\n      color: #284f46;\n      background: #d2e1d4;\n      font-size: 9px;\n      font-weight: 750;\n    }\n    .avatar:nth-child(2) { background: #f3c3a9; color: #744e3d; }\n    .avatar:nth-child(3) { background: #d8d1e5; color: #54486b; }\n    .avatar:nth-child(4) { background: #e9d98d; color: #665a27; }\n\n    .hero-visual {\n      position: relative;\n      min-width: 0;\n      padding: 30px 0 24px 10px;\n    }\n\n    .visual-blob {\n      position: absolute;\n      inset: 3% -8% 0 7%;\n      z-index: -1;\n      border-radius: 47% 53% 50% 50% / 52% 42% 58% 48%;\n      background: #e3eee5;\n      transform: rotate(-5deg);\n    }\n\n    .spark {\n      position: absolute;\n      color: #d78c6f;\n      font-size: 29px;\n      line-height: 1;\n    }\n    .spark.one { top: 0; right: 7%; transform: rotate(12deg); }\n    .spark.two { bottom: 0; left: 1%; font-size: 22px; }\n\n    .app-window {\n      position: relative;\n      overflow: hidden;\n      width: 100%;\n      min-height: 444px;\n      border: 1px solid rgba(37, 70, 60, .11);\n      border-radius: 15px;\n      background: var(--white);\n      box-shadow: var(--shadow);\n      transform: rotate(-1.2deg);\n    }\n\n    .app-top {\n      height: 50px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 0 19px;\n      border-bottom: 1px solid #eff0e9;\n      color: #74817a;\n      font-size: 10px;\n    }\n\n    .window-dots { display: flex; gap: 5px; }\n    .window-dots i {\n      width: 6px; height: 6px; border-radius: 50%; background: #e2e5df;\n    }\n    .window-dots i:first-child { background: #e6a48b; }\n    .app-top-label { font-weight: 650; color: #587068; }\n    .week-label { color: #73837c; }\n\n    .app-body {\n      display: grid;\n      grid-template-columns: 150px 1fr;\n      min-height: 394px;\n    }\n\n    .sidebar {\n      padding: 22px 13px;\n      border-right: 1px solid #eff0e9;\n      background: #fbfbf7;\n    }\n\n    .workspace {\n      margin: 0 0 20px 7px;\n      color: #9aa59e;\n      font-size: 8px;\n      font-weight: 750;\n      letter-spacing: .12em;\n      text-transform: uppercase;\n    }\n\n    .side-item {\n      display: flex;\n      align-items: center;\n      gap: 9px;\n      margin-bottom: 5px;\n      padding: 9px 8px;\n      border-radius: 7px;\n      color: #78857e;\n      font-size: 10px;\n    }\n\n    .side-item.active {\n      color: var(--green);\n      background: #e9f1e9;\n      font-weight: 700;\n    }\n\n    .side-icon {\n      width: 14px;\n      text-align: center;\n      font-size: 12px;\n    }\n\n    .side-count {\n      margin-left: auto;\n      color: #84938c;\n      font-size: 9px;\n    }\n\n    .team-label {\n      display: flex;\n      align-items: center;\n      gap: 7px;\n      margin: 26px 0 10px 7px;\n      color: #9aa59e;\n      font-size: 8px;\n      font-weight: 750;\n      letter-spacing: .12em;\n      text-transform: uppercase;\n    }\n\n    .tiny-avatars { display: flex; }\n    .tiny-avatars b {\n      width: 17px; height: 17px; display: grid; place-items: center;\n      margin-left: -3px; border: 1px solid white; border-radius: 50%;\n      color: #465b53; background: #dce5d5; font-size: 7px;\n    }\n    .tiny-avatars b:nth-child(2) { background: #f0c3a9; }\n    .tiny-avatars b:nth-child(3) { background: #d9d0e5; }\n    .tiny-avatars b:nth-child(4) { background: #e9dc9a; }\n\n    .planner { padding: 24px 24px 22px; }\n\n    .planner-heading {\n      display: flex;\n      align-items: flex-start;\n      justify-content: space-between;\n      margin-bottom: 19px;\n    }\n\n    .planner-heading h2 {\n      margin: 0 0 5px;\n      font-size: 17px;\n      letter-spacing: -.04em;\n    }\n\n    .planner-heading p {\n      margin: 0;\n      color: #98a29b;\n      font-size: 9px;\n    }\n\n    .share {\n      padding: 7px 10px;\n      border: 1px solid #e3e8df;\n      border-radius: 6px;\n      color: #547168;\n      font-size: 9px;\n      font-weight: 650;\n    }\n\n    .week-strip {\n      display: grid;\n      grid-template-columns: repeat(5, 1fr);\n      gap: 6px;\n      margin-bottom: 16px;\n    }\n\n    .day {\n      padding: 8px 4px;\n      border: 1px solid #eff0e9;\n      border-radius: 7px;\n      color: #84928b;\n      text-align: center;\n      font-size: 8px;\n    }\n\n    .day b {\n      display: block;\n      margin-top: 5px;\n      color: #334f47;\n      font-size: 11px;\n    }\n\n    .day.current {\n      border-color: #2e725f;\n      color: white;\n      background: #2e725f;\n    }\n    .day.current b { color: white; }\n\n    .section-label {\n      display: flex;\n      justify-content: space-between;\n      margin: 16px 0 8px;\n      color: #8d9992;\n      font-size: 8px;\n      font-weight: 750;\n      letter-spacing: .1em;\n      text-transform: uppercase;\n    }\n\n    .task {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      min-height: 44px;\n      margin-bottom: 7px;\n      padding: 7px 9px;\n      border: 1px solid #eff0e9;\n      border-radius: 8px;\n      background: #fff;\n    }\n\n    .task-check {\n      width: 13px; height: 13px; flex: 0 0 13px;\n      border: 1px solid #cbd8ce; border-radius: 4px;\n    }\n    .task-check.done {\n      display: grid; place-items: center;\n      border-color: #60917b; color: white; background: #60917b;\n      font-size: 8px;\n    }\n\n    .task-copy { min-width: 0; flex: 1; }\n    .task-copy strong {\n      display: block;\n      overflow: hidden;\n      color: #40554d;\n      font-size: 9px;\n      font-weight: 650;\n      text-overflow: ellipsis;\n      white-space: nowrap;\n    }\n    .task-copy span { color: #a1aaa3; font-size: 8px; }\n\n    .task-tag {\n      padding: 4px 6px;\n      border-radius: 5px;\n      color: #577a67;\n      background: #edf4eb;\n      font-size: 7px;\n      font-weight: 700;\n      white-space: nowrap;\n    }\n    .task-tag.coral { color: #a76c51; background: #fbefe8; }\n    .task-tag.lilac { color: #76688a; background: #f0edf5; }\n\n    .note-card {\n      position: absolute;\n      right: -12px;\n      bottom: 10px;\n      display: flex;\n      align-items: center;\n      gap: 9px;\n      padding: 12px 15px;\n      border: 1px solid rgba(31, 57, 49, .07);\n      border-radius: 10px;\n      background: #fffefa;\n      box-shadow: 0 10px 30px rgba(31, 57, 49, .12);\n      color: #526a61;\n      font-size: 9px;\n      transform: rotate(2deg);\n    }\n    .note-check {\n      width: 22px; height: 22px; display: grid; place-items: center;\n      border-radius: 50%; color: #fff; background: #6a9a7a; font-size: 11px;\n    }\n    .note-card strong { display: block; margin-bottom: 2px; color: var(--ink); font-size: 10px; }\n\n    .trust {\n      padding: 28px 0 44px;\n      border-top: 1px solid #e5e6df;\n      border-bottom: 1px solid #e5e6df;\n      text-align: center;\n    }\n    .trust p {\n      margin: 0 0 22px;\n      color: #8a958f;\n      font-size: 10px;\n      font-weight: 700;\n      letter-spacing: .11em;\n      text-transform: uppercase;\n    }\n    .trust-list {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: clamp(28px, 6vw, 76px);\n      color: #78847d;\n      font-family: Georgia, serif;\n      font-size: 17px;\n      font-weight: 700;\n      letter-spacing: -.04em;\n    }\n    .trust-list span:nth-child(2) { font-family: inherit; font-size: 13px; letter-spacing: .06em; }\n    .trust-list span:nth-child(3) { font-style: italic; }\n    .trust-list span:nth-child(4) { font-family: inherit; font-size: 12px; letter-spacing: .13em; }\n\n    .features {\n      padding: 92px 0 96px;\n    }\n\n    .section-intro {\n      max-width: 580px;\n      margin: 0 auto 43px;\n      text-align: center;\n    }\n    .section-intro .eyebrow { justify-content: center; }\n    .section-intro h2 {\n      margin: 16px 0 12px;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: clamp(34px, 4vw, 48px);\n      font-weight: 500;\n      line-height: 1.08;\n      letter-spacing: -.055em;\n    }\n    .section-intro p {\n      margin: 0;\n      color: var(--muted);\n      font-size: 14px;\n      line-height: 1.7;\n    }\n\n    .feature-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 16px;\n    }\n    .feature-card {\n      min-height: 222px;\n      padding: 24px;\n      border: 1px solid #e6e7df;\n      border-radius: 13px;\n      background: rgba(255, 254, 250, .62);\n    }\n    .feature-icon {\n      width: 38px; height: 38px;\n      display: grid; place-items: center;\n      margin-bottom: 25px;\n      border-radius: 11px;\n      color: var(--green);\n      background: #e5eee5;\n      font-size: 17px;\n    }\n    .feature-card:nth-child(2) .feature-icon { color: #a66b50; background: #f8e8de; }\n    .feature-card:nth-child(3) .feature-icon { color: #71698a; background: #eeebf4; }\n    .feature-card h3 {\n      margin: 0 0 8px;\n      font-size: 15px;\n      letter-spacing: -.03em;\n    }\n    .feature-card p {\n      max-width: 285px;\n      margin: 0;\n      color: #718079;\n      font-size: 12px;\n      line-height: 1.7;\n    }\n\n    .closing {\n      position: relative;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 28px;\n      margin-bottom: 38px;\n      padding: 42px 48px;\n      border-radius: 17px;\n      color: white;\n      background: #1e564c;\n    }\n    .closing::after {\n      content: \"\";\n      position: absolute;\n      width: 290px;\n      height: 290px;\n      right: 13%;\n      top: -185px;\n      border: 1px solid rgba(255,255,255,.15);\n      border-radius: 50%;\n      box-shadow: 0 0 0 28px rgba(255,255,255,.035), 0 0 0 57px rgba(255,255,255,.025);\n    }\n    .closing-copy { position: relative; z-index: 1; }\n    .closing h2 {\n      margin: 0 0 8px;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: clamp(28px, 4vw, 39px);\n      font-weight: 500;\n      letter-spacing: -.05em;\n    }\n    .closing p { margin: 0; color: #c3d9ce; font-size: 12px; }\n    .closing .button {\n      position: relative;\n      z-index: 1;\n      flex-shrink: 0;\n      color: var(--ink);\n      background: #f4d2bd;\n    }\n    .closing .button:hover { background: #f7dfd0; }\n\n    footer {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      padding: 0 0 27px;\n      color: #87938c;\n      font-size: 10px;\n    }\n    .footer-links { display: flex; gap: 22px; }\n    .footer-links a:hover { color: var(--green); }\n\n    @media (max-width: 850px) {\n      .hero { grid-template-columns: 1fr; gap: 25px; padding-top: 40px; }\n      .hero-copy { max-width: 620px; }\n      .hero-visual { max-width: 660px; margin: 0 auto; width: 100%; }\n      .app-window { transform: rotate(-.6deg); }\n      .feature-grid { gap: 10px; }\n      .feature-card { padding: 20px; }\n    }\n\n    @media (max-width: 600px) {\n      .shell { width: min(100% - 34px, 460px); }\n      header { height: 70px; }\n      nav { gap: 14px; }\n      nav > a:not(.nav-cta) { display: none; }\n      .nav-cta { padding: 9px 13px; font-size: 11px; }\n      .hero { padding: 34px 0 62px; }\n      h1 { font-size: clamp(49px, 14vw, 66px); }\n      .hero-copy > p { font-size: 14px; }\n      .hero-actions { gap: 14px; }\n      .button { min-height: 45px; padding: 0 16px; font-size: 12px; }\n      .hero-visual { padding: 21px 0 28px; }\n      .app-window { min-height: 384px; }\n      .app-body { grid-template-columns: 112px 1fr; min-height: 334px; }\n      .sidebar { padding: 17px 8px; }\n      .planner { padding: 18px 12px; }\n      .side-item { gap: 6px; padding: 8px 5px; font-size: 8px; }\n      .workspace { margin-left: 5px; font-size: 7px; }\n      .planner-heading h2 { font-size: 14px; }\n      .planner-heading p { font-size: 8px; }\n      .share { padding: 6px; font-size: 8px; }\n      .week-strip { gap: 3px; }\n      .day { font-size: 7px; }\n      .task { gap: 6px; padding: 6px; }\n      .task-copy strong { font-size: 8px; }\n      .task-tag { padding: 4px; font-size: 6px; }\n      .note-card { right: -4px; bottom: -1px; }\n      .trust { padding: 25px 0 34px; }\n      .trust-list { flex-wrap: wrap; gap: 15px 27px; font-size: 15px; }\n      .features { padding: 70px 0; }\n      .feature-grid { grid-template-columns: 1fr; }\n      .feature-card { min-height: 0; padding: 21px; }\n      .feature-icon { margin-bottom: 16px; }\n      .closing { align-items: flex-start; flex-direction: column; padding: 31px 25px; }\n      footer { align-items: flex-start; flex-direction: column; gap: 15px; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"shell\">\n    <header>\n      <a class=\"brand\" href=\"#\" aria-label=\"Tidepool home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M3.5 9.2c2.4-2.2 4.7-2.2 7.1 0s4.7 2.2 7.1 0c1-.9 1.9-1.4 2.8-1.6M3.5 14c2.4-2.2 4.7-2.2 7.1 0s4.7 2.2 7.1 0c1-.9 1.9-1.4 2.8-1.6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n          </svg>\n        </span>\n        tidepool\n      </a>\n      <nav aria-label=\"Main navigation\">\n        <a href=\"#how-it-works\">How it works</a>\n        <a href=\"#why-tidepool\">Why Tidepool</a>\n        <a class=\"nav-cta\" href=\"#get-started\">Get started <span aria-hidden=\"true\">\u2197</span></a>\n      </nav>\n    </header>\n\n    <main>\n      <section class=\"hero\" aria-labelledby=\"hero-title\">\n        <div class=\"hero-copy\">\n          <div class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> A better week starts together</div>\n          <h1 id=\"hero-title\">Make a little room for <em>good work.</em></h1>\n          <p>Tidepool gives your team one calm place to plan the week, share priorities, and see what\u2019s moving\u2014without another meeting about it.</p>\n          <div class=\"hero-actions\">\n            <a class=\"button button-primary\" href=\"#get-started\">Plan your first week <span aria-hidden=\"true\">\u2192</span></a>\n            <a class=\"text-link\" href=\"#how-it-works\">See how it works <span aria-hidden=\"true\">\u2193</span></a>\n          </div>\n          <div class=\"micro-proof\">\n            <div class=\"avatars\" aria-hidden=\"true\">\n              <span class=\"avatar\">M</span><span class=\"avatar\">J</span><span class=\"avatar\">A</span><span class=\"avatar\">R</span>\n            </div>\n            <span>Made for small teams doing thoughtful work</span>\n          </div>\n        </div>\n\n        <div class=\"hero-visual\" aria-label=\"Preview of the Tidepool weekly planning app\">\n          <div class=\"visual-blob\"></div>\n          <span class=\"spark one\" aria-hidden=\"true\">\u2733</span>\n          <span class=\"spark two\" aria-hidden=\"true\">\u2733</span>\n          <div class=\"app-window\">\n            <div class=\"app-top\">\n              <div class=\"window-dots\" aria-hidden=\"true\"><i></i><i></i><i></i></div>\n              <span class=\"app-top-label\">tidepool / studio team</span>\n              <span class=\"week-label\">\u2318 K</span>\n            </div>\n            <div class=\"app-body\">\n              <aside class=\"sidebar\" aria-label=\"App sidebar preview\">\n                <div class=\"workspace\">Workspace</div>\n                <div class=\"side-item active\"><span class=\"side-icon\">\u25f7</span> This week <span class=\"side-count\">5</span></div>\n                <div class=\"side-item\"><span class=\"side-icon\">\u25a4</span> All plans</div>\n                <div class=\"side-item\"><span class=\"side-icon\">\u2727</span> Notes</div>\n                <div class=\"team-label\">Your team <span class=\"tiny-avatars\" aria-hidden=\"true\"><b>M</b><b>J</b><b>A</b><b>R</b></span></div>\n                <div class=\"side-item\"><span class=\"side-icon\">\u25cf</span> Maya Chen</div>\n                <div class=\"side-item\"><span class=\"side-icon\">\u25cf</span> Jordan Lee</div>\n                <div class=\"side-item\"><span class=\"side-icon\">\u25cf</span> Alex Rivera</div>\n              </aside>\n\n              <div class=\"planner\">\n                <div class=\"planner-heading\">\n                  <div>\n                    <h2>Our week</h2>\n                    <p>Monday, October 14 \u00b7 4 people</p>\n                  </div>\n                  <span class=\"share\">\uff0b Invite</span>\n                </div>\n\n                <div class=\"week-strip\" aria-label=\"Week overview\">\n                  <div class=\"day current\">MON<b>14</b></div>\n                  <div class=\"day\">TUE<b>15</b></div>\n                  <div class=\"day\">WED<b>16</b></div>\n                  <div class=\"day\">THU<b>17</b></div>\n                  <div class=\"day\">FRI<b>18</b></div>\n                </div>\n\n                <div class=\"section-label\"><span>Team priorities</span><span>3 of 5</span></div>\n                <div class=\"task\">\n                  <span class=\"task-check done\">\u2713</span>\n                  <div class=\"task-copy\"><strong>Share the new brand direction</strong><span>Maya \u00b7 Today</span></div>\n                  <span class=\"task-tag coral\">Design</span>\n                </div>\n                <div class=\"task\">\n                  <span class=\"task-check\"></span>\n                  <div class=\"task-copy\"><strong>Prep Friday customer sessions</strong><span>Jordan \u00b7 Thu</span></div>\n                  <span class=\"task-tag\">Research</span>\n                </div>\n                <div class=\"task\">\n                  <span class=\"task-check\"></span>\n                  <div class=\"task-copy\"><strong>Ship the little things list</strong><span>Alex \u00b7 Wed</span></div>\n                  <span class=\"task-tag lilac\">Product</span>\n                </div>\n\n                <div class=\"section-label\"><span>Team note</span><span>\u2022\u2022\u2022</span></div>\n                <div class=\"task\">\n                  <div class=\"task-copy\"><strong>\u201cLet\u2019s keep Wednesday meeting-free \ud83c\udf31\u201d</strong><span>Maya added a note \u00b7 9:14 am</span></div>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div class=\"note-card\">\n            <span class=\"note-check\">\u2713</span>\n            <span><strong>Everyone\u2019s on the same page</strong>That\u2019s the good stuff.</span>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"trust\" aria-label=\"Teams that use Tidepool\">\n        <p>Good company for your next good idea</p>\n        <div class=\"trust-list\">\n          <span>littlefield</span>\n          <span>northstar\u00ae</span>\n          <span>kindred studio</span>\n          <span>COMMON GROUND</span>\n        </div>\n      </section>\n\n      <section class=\"features\" id=\"how-it-works\">\n        <div class=\"section-intro\">\n          <div class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> Less chasing, more making</div>\n          <h2>Small rituals. A much better rhythm.</h2>\n          <p>Bring the useful bits of a weekly planning meeting into a shared space your team can actually keep up with.</p>\n        </div>\n        <div class=\"feature-grid\" id=\"why-tidepool\">\n          <article class=\"feature-card\">\n            <div class=\"feature-icon\" aria-hidden=\"true\">\u2197</div>\n            <h3>Start with what matters</h3>\n            <p>Agree on a few real priorities for the week, so everyone knows what deserves their best energy.</p>\n          </article>\n          <article class=\"feature-card\">\n            <div class=\"feature-icon\" aria-hidden=\"true\">\u25cc</div>\n            <h3>Make room for each other</h3>\n            <p>Share plans, blockers, and meeting-free time before the week gets away from you.</p>\n          </article>\n          <article class=\"feature-card\">\n            <div class=\"feature-icon\" aria-hidden=\"true\">\u2733</div>\n            <h3>Keep the good things visible</h3>\n            <p>Leave small updates and notes where the whole team can find them\u2014no status-chasing required.</p>\n          </article>\n        </div>\n      </section>\n\n      <section class=\"closing\" id=\"get-started\">\n        <div class=\"closing-copy\">\n          <h2>Your next week could feel lighter.</h2>\n          <p>Get your team together in Tidepool. It takes about two minutes to begin.</p>\n        </div>\n        <a class=\"button\" href=\"mailto:hello@tidepool.team\">Start planning for free <span aria-hidden=\"true\">\u2192</span></a>\n      </section>\n    </main>\n\n    <footer>\n      <a class=\"brand\" href=\"#\" aria-label=\"Tidepool home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M3.5 9.2c2.4-2.2 4.7-2.2 7.1 0s4.7 2.2 7.1 0c1-.9 1.9-1.4 2.8-1.6M3.5 14c2.4-2.2 4.7-2.2 7.1 0s4.7 2.2 7.1 0c1-.9 1.9-1.4 2.8-1.6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n          </svg>\n        </span>\n        tidepool\n      </a>\n      <span>\u00a9 2024 Tidepool. Made for good work.</span>\n      