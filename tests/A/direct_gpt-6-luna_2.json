{"arm": "direct", "model": "openai/gpt-6-luna", "i": 2, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <meta name=\"theme-color\" content=\"#f7f7f1\" />\n  <title>Tidepool \u2014 Make room for a better week</title>\n  <style>\n    :root {\n      --ink: #183333;\n      --muted: #667573;\n      --paper: #f7f7f1;\n      --white: #fffefa;\n      --green: #c9e9d9;\n      --green-dark: #245b4d;\n      --coral: #ff826c;\n      --line: #e4e8df;\n      --shadow: 0 24px 70px rgba(24, 51, 51, 0.12);\n      --radius: 22px;\n    }\n\n    * { box-sizing: border-box; }\n\n    html { scroll-behavior: smooth; }\n\n    body {\n      margin: 0;\n      color: var(--ink);\n      background: var(--paper);\n      font-family: ui-rounded, \"SF Pro Rounded\", \"Segoe UI\", system-ui, -apple-system, sans-serif;\n      -webkit-font-smoothing: antialiased;\n    }\n\n    a { color: inherit; text-decoration: none; }\n\n    .shell {\n      width: min(1160px, calc(100% - 48px));\n      margin: 0 auto;\n    }\n\n    .site-header {\n      height: 82px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n    }\n\n    .brand {\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      font-size: 21px;\n      font-weight: 760;\n      letter-spacing: -0.8px;\n    }\n\n    .brand-mark {\n      width: 31px;\n      height: 31px;\n      display: grid;\n      place-items: center;\n      border-radius: 11px;\n      background: var(--green-dark);\n      color: white;\n    }\n\n    .brand-mark svg { width: 19px; height: 19px; }\n\n    .nav-links {\n      display: flex;\n      align-items: center;\n      gap: 34px;\n      color: #536663;\n      font-size: 14px;\n      font-weight: 560;\n    }\n\n    .nav-links a:hover { color: var(--green-dark); }\n\n    .nav-cta {\n      padding: 11px 18px;\n      border: 1px solid #cbd5ce;\n      border-radius: 999px;\n      color: var(--ink);\n      background: transparent;\n      font-size: 13px;\n      font-weight: 700;\n      transition: .2s ease;\n    }\n\n    .nav-cta:hover {\n      background: var(--ink);\n      border-color: var(--ink);\n      color: white;\n    }\n\n    .hero {\n      position: relative;\n      display: grid;\n      grid-template-columns: 0.92fr 1.08fr;\n      align-items: center;\n      gap: 56px;\n      min-height: 600px;\n      padding: 51px 0 82px;\n    }\n\n    .hero-copy { position: relative; z-index: 2; }\n\n    .eyebrow {\n      display: inline-flex;\n      align-items: center;\n      gap: 9px;\n      padding: 8px 12px;\n      border: 1px solid #d8e5dc;\n      border-radius: 999px;\n      color: #386b59;\n      background: #edf5ed;\n      font-size: 11px;\n      font-weight: 750;\n      letter-spacing: 1.15px;\n      text-transform: uppercase;\n    }\n\n    .eyebrow-dot {\n      width: 7px;\n      height: 7px;\n      border-radius: 50%;\n      background: #65a783;\n      box-shadow: 0 0 0 4px rgba(101, 167, 131, .14);\n    }\n\n    h1 {\n      max-width: 510px;\n      margin: 25px 0 19px;\n      font-size: clamp(50px, 6vw, 76px);\n      line-height: .99;\n      letter-spacing: -5.2px;\n      font-weight: 740;\n    }\n\n    h1 em {\n      color: #518b70;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-weight: 500;\n      letter-spacing: -4px;\n    }\n\n    .hero-copy > p {\n      max-width: 435px;\n      margin: 0;\n      color: #60716d;\n      font-size: 17px;\n      line-height: 1.7;\n    }\n\n    .hero-actions {\n      display: flex;\n      align-items: center;\n      gap: 18px;\n      margin-top: 30px;\n    }\n\n    .button-primary {\n      display: inline-flex;\n      align-items: center;\n      gap: 11px;\n      padding: 15px 21px;\n      border-radius: 999px;\n      color: white;\n      background: var(--green-dark);\n      box-shadow: 0 8px 18px rgba(36, 91, 77, .16);\n      font-size: 14px;\n      font-weight: 700;\n      transition: transform .2s, box-shadow .2s;\n    }\n\n    .button-primary:hover {\n      transform: translateY(-2px);\n      box-shadow: 0 12px 23px rgba(36, 91, 77, .22);\n    }\n\n    .button-primary svg { width: 16px; height: 16px; }\n\n    .microcopy {\n      color: #81908b;\n      font-size: 12px;\n    }\n\n    .hero-proof {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      margin-top: 38px;\n    }\n\n    .avatar-stack { display: flex; padding-left: 3px; }\n\n    .avatar {\n      width: 29px;\n      height: 29px;\n      display: grid;\n      place-items: center;\n      margin-left: -4px;\n      border: 2px solid var(--paper);\n      border-radius: 50%;\n      color: #26473e;\n      background: #e6b89e;\n      font-size: 9px;\n      font-weight: 800;\n    }\n\n    .avatar:nth-child(2) { background: #d1a8c5; color: #543b51; }\n    .avatar:nth-child(3) { background: #a9c5a6; }\n    .avatar:nth-child(4) { background: #edcf87; }\n\n    .proof-text {\n      color: #63726e;\n      font-size: 12px;\n    }\n\n    .proof-text strong { color: var(--ink); }\n\n    .hero-visual {\n      position: relative;\n      min-height: 462px;\n      display: grid;\n      place-items: center;\n    }\n\n    .visual-blob {\n      position: absolute;\n      width: 530px;\n      height: 440px;\n      right: -24px;\n      top: 5px;\n      border-radius: 48% 52% 58% 42% / 44% 43% 57% 56%;\n      background: #dcefe4;\n      transform: rotate(-7deg);\n    }\n\n    .visual-blob::before,\n    .visual-blob::after {\n      content: \"\";\n      position: absolute;\n      border-radius: 50%;\n      border: 1px solid rgba(56, 115, 89, .16);\n    }\n\n    .visual-blob::before {\n      width: 455px;\n      height: 365px;\n      top: 39px;\n      left: 38px;\n    }\n\n    .visual-blob::after {\n      width: 385px;\n      height: 300px;\n      top: 74px;\n      left: 74px;\n    }\n\n    .planner {\n      position: relative;\n      z-index: 1;\n      width: min(100%, 485px);\n      padding: 23px;\n      border: 1px solid rgba(255, 255, 255, .85);\n      border-radius: 19px;\n      background: var(--white);\n      box-shadow: var(--shadow);\n      transform: rotate(1.2deg);\n    }\n\n    .planner-top {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding-bottom: 17px;\n      border-bottom: 1px solid #edf0e9;\n    }\n\n    .workspace-name {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n    }\n\n    .workspace-icon {\n      width: 34px;\n      height: 34px;\n      display: grid;\n      place-items: center;\n      border-radius: 11px;\n      color: #37745a;\n      background: #e5f2e8;\n      font-size: 15px;\n    }\n\n    .workspace-name strong {\n      display: block;\n      font-size: 13px;\n      letter-spacing: -.2px;\n    }\n\n    .workspace-name span {\n      display: block;\n      margin-top: 3px;\n      color: #8a9691;\n      font-size: 10px;\n    }\n\n    .week-label {\n      padding: 7px 10px;\n      border: 1px solid #e8ece5;\n      border-radius: 8px;\n      color: #53635e;\n      font-size: 10px;\n      font-weight: 650;\n    }\n\n    .planner-heading {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      margin: 20px 0 15px;\n    }\n\n    .planner-heading h2 {\n      margin: 0;\n      font-size: 17px;\n      letter-spacing: -.6px;\n    }\n\n    .members { display: flex; }\n\n    .members .avatar {\n      width: 25px;\n      height: 25px;\n      font-size: 8px;\n      border-color: var(--white);\n    }\n\n    .week-grid {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 10px;\n    }\n\n    .day-card {\n      min-height: 89px;\n      padding: 12px;\n      border: 1px solid #ebeee8;\n      border-radius: 12px;\n      background: #fff;\n    }\n\n    .day-card.highlight {\n      border-color: #d4e8da;\n      background: #f2f8f1;\n    }\n\n    .day-top {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      margin-bottom: 10px;\n      color: #83908a;\n      font-size: 9px;\n      font-weight: 750;\n      letter-spacing: .7px;\n      text-transform: uppercase;\n    }\n\n    .day-top b {\n      color: #9ba69f;\n      font-size: 9px;\n      font-weight: 600;\n      letter-spacing: 0;\n      text-transform: none;\n    }\n\n    .task {\n      display: flex;\n      align-items: center;\n      gap: 7px;\n      color: #40534d;\n      font-size: 10px;\n      line-height: 1.4;\n    }\n\n    .task + .task { margin-top: 7px; }\n\n    .task-mark {\n      flex: 0 0 auto;\n      width: 12px;\n      height: 12px;\n      display: grid;\n      place-items: center;\n      border: 1px solid #b7c8bb;\n      border-radius: 4px;\n      color: white;\n      background: #6c9f7e;\n      font-size: 8px;\n    }\n\n    .task-mark.open { background: transparent; }\n\n    .planner-footer {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      margin-top: 16px;\n      padding-top: 13px;\n      border-top: 1px solid #edf0e9;\n      color: #85918b;\n      font-size: 10px;\n    }\n\n    .progress {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n    }\n\n    .progress-track {\n      width: 75px;\n      height: 5px;\n      overflow: hidden;\n      border-radius: 8px;\n      background: #e9eee7;\n    }\n\n    .progress-track span {\n      display: block;\n      width: 68%;\n      height: 100%;\n      border-radius: inherit;\n      background: #76a886;\n    }\n\n    .floating-note {\n      position: absolute;\n      z-index: 2;\n      right: -15px;\n      bottom: 24px;\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      padding: 12px 15px;\n      border: 1px solid #edf0e9;\n      border-radius: 13px;\n      background: white;\n      box-shadow: 0 12px 32px rgba(24, 51, 51, .11);\n      transform: rotate(-2deg);\n    }\n\n    .note-icon {\n      width: 29px;\n      height: 29px;\n      display: grid;\n      place-items: center;\n      border-radius: 9px;\n      background: #fff0e8;\n      color: #d27756;\n      font-size: 14px;\n    }\n\n    .floating-note strong {\n      display: block;\n      font-size: 10px;\n    }\n\n    .floating-note span {\n      display: block;\n      margin-top: 3px;\n      color: #89938e;\n      font-size: 9px;\n    }\n\n    .trust-row {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 37px;\n      padding: 22px 0 39px;\n      border-top: 1px solid var(--line);\n      color: #8b9790;\n      font-size: 11px;\n    }\n\n    .trust-row > span:first-child {\n      color: #697772;\n      font-size: 10px;\n      font-weight: 700;\n      letter-spacing: 1px;\n      text-transform: uppercase;\n    }\n\n    .trust-name {\n      color: #73807a;\n      font-size: 15px;\n      font-weight: 750;\n      letter-spacing: -.7px;\n    }\n\n    .trust-name.serif { font-family: Georgia, serif; font-weight: 600; }\n    .trust-name.spaced { font-size: 12px; letter-spacing: 1.8px; }\n\n    .features {\n      padding: 81px 0 93px;\n      border-top: 1px solid var(--line);\n      background: #fffefa;\n    }\n\n    .section-intro {\n      display: flex;\n      align-items: end;\n      justify-content: space-between;\n      gap: 30px;\n      margin-bottom: 42px;\n    }\n\n    .section-kicker {\n      color: #668a73;\n      font-size: 11px;\n      font-weight: 750;\n      letter-spacing: 1.3px;\n      text-transform: uppercase;\n    }\n\n    .section-intro h2 {\n      max-width: 540px;\n      margin: 12px 0 0;\n      font-size: clamp(32px, 4vw, 46px);\n      line-height: 1.08;\n      letter-spacing: -2.5px;\n    }\n\n    .section-intro p {\n      max-width: 315px;\n      margin: 0 0 4px;\n      color: var(--muted);\n      font-size: 14px;\n      line-height: 1.7;\n    }\n\n    .feature-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 16px;\n    }\n\n    .feature-card {\n      min-height: 205px;\n      padding: 24px;\n      border: 1px solid #e8ebe4;\n      border-radius: 17px;\n      background: #fff;\n    }\n\n    .feature-icon {\n      width: 38px;\n      height: 38px;\n      display: grid;\n      place-items: center;\n      margin-bottom: 22px;\n      border-radius: 12px;\n      color: #3c765e;\n      background: #e9f3e9;\n    }\n\n    .feature-icon svg { width: 19px; height: 19px; }\n\n    .feature-card:nth-child(2) .feature-icon {\n      color: #bd6954;\n      background: #fff0e9;\n    }\n\n    .feature-card:nth-child(3) .feature-icon {\n      color: #77729b;\n      background: #efedf8;\n    }\n\n    .feature-card h3 {\n      margin: 0 0 9px;\n      font-size: 16px;\n      letter-spacing: -.45px;\n    }\n\n    .feature-card p {\n      margin: 0;\n      color: #74817c;\n      font-size: 13px;\n      line-height: 1.65;\n    }\n\n    .closing {\n      padding: 70px 0 75px;\n      color: white;\n      background: #214e43;\n    }\n\n    .closing-inner {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 30px;\n    }\n\n    .closing .section-kicker { color: #a8d2b6; }\n\n    .closing h2 {\n      max-width: 600px;\n      margin: 11px 0 0;\n      font-size: clamp(32px, 4vw, 45px);\n      line-height: 1.1;\n      letter-spacing: -2px;\n    }\n\n    .closing .button-primary {\n      flex: 0 0 auto;\n      color: var(--ink);\n      background: #d7eddb;\n      box-shadow: none;\n    }\n\n    .closing .button-primary:hover { background: white; }\n\n    footer {\n      padding: 20px 0;\n      color: #9aa8a1;\n      background: #214e43;\n      border-top: 1px solid rgba(255,255,255,.12);\n      font-size: 11px;\n    }\n\n    .footer-inner {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n    }\n\n    .footer-brand { color: white; font-weight: 750; font-size: 13px; }\n    .footer-links { display: flex; gap: 22px; }\n\n    @media (max-width: 900px) {\n      .hero { gap: 24px; grid-template-columns: .9fr 1.1fr; }\n      .visual-blob { width: 460px; right: -32px; }\n      .planner { padding: 18px; }\n      .floating-note { right: -5px; }\n      h1 { font-size: 61px; letter-spacing: -4px; }\n    }\n\n    @media (max-width: 700px) {\n      .shell { width: min(100% - 36px, 520px); }\n      .site-header { height: 70px; }\n      .nav-links { gap: 14px; }\n      .nav-links a:not(.nav-cta) { display: none; }\n      .nav-cta { padding: 10px 14px; }\n      .hero {\n        display: flex;\n        flex-direction: column;\n        align-items: stretch;\n        gap: 7px;\n        padding: 43px 0 53px;\n      }\n      h1 {\n        max-width: 450px;\n        margin-top: 22px;\n        font-size: clamp(51px, 13vw, 69px);\n        letter-spacing: -4.4px;\n      }\n      .hero-copy > p { font-size: 15px; }\n      .hero-actions { flex-wrap: wrap; gap: 12px; }\n      .hero-proof { margin-top: 26px; }\n      .hero-visual { min-height: 395px; margin: 17px -5px 0; }\n      .visual-blob { width: 110%; height: 360px; right: -5%; top: 13px; }\n      .visual-blob::before { width: 85%; height: 290px; }\n      .visual-blob::after { width: 72%; height: 235px; }\n      .planner { width: 100%; max-width: 460px; }\n      .floating-note { right: 0; bottom: 0; }\n      .trust-row {\n        flex-wrap: wrap;\n        gap: 17px 25px;\n        padding: 22px 0 30px;\n      }\n      .trust-row > span:first-child { width: 100%; text-align: center; }\n      .features { padding: 59px 0 65px; }\n      .section-intro { display: block; margin-bottom: 28px; }\n      .section-intro p { margin-top: 15px; }\n      .feature-grid { grid-template-columns: 1fr; gap: 11px; }\n      .feature-card { min-height: 0; padding: 20px; }\n      .feature-icon { margin-bottom: 15px; }\n      .closing { padding: 56px 0; }\n      .closing-inner { align-items: flex-start; flex-direction: column; }\n      .footer-inner { align-items: flex-start; flex-direction: column; gap: 13px; }\n    }\n\n    @media (max-width: 390px) {\n      .shell { width: calc(100% - 28px); }\n      .planner { padding: 14px; }\n      .day-card { padding: 9px; }\n      .task { font-size: 9px; }\n      .week-label { font-size: 9px; }\n      .floating-note { right: -2px; }\n      .microcopy { font-size: 11px; }\n    }\n  </style>\n</head>\n<body>\n  <header class=\"site-header shell\">\n    <a class=\"brand\" href=\"#\" aria-label=\"Tidepool home\">\n      <span class=\"brand-mark\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\">\n          <path d=\"M4 9.5c2.4 0 2.4-2 4.8-2s2.4 2 4.8 2 2.4-2 4.8-2\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n          <path d=\"M4 14.5c2.4 0 2.4-2 4.8-2s2.4 2 4.8 2 2.4-2 4.8-2\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n          <path d=\"M4 19c2.4 0 2.4-2 4.8-2s2.4 2 4.8 2 2.4-2 4.8-2\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n        </svg>\n      </span>\n      Tidepool\n    </a>\n\n    <nav class=\"nav-links\" aria-label=\"Main navigation\">\n      <a href=\"#how-it-works\">How it works</a>\n      <a href=\"#why-tidepool\">Why Tidepool</a>\n      <a class=\"nav-cta\" href=\"#get-started\">Get started</a>\n    </nav>\n  </header>\n\n  <main>\n    <section class=\"hero shell\">\n      <div class=\"hero-copy\">\n        <div class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> A calmer way to work together</div>\n        <h1>Make room for a <em>better</em> week.</h1>\n        <p>Tidepool helps small teams get on the same page, pick what matters, and make a plan that actually feels doable.</p>\n\n        <div class=\"hero-actions\">\n          <a class=\"button-primary\" href=\"#get-started\">\n            Plan your week\n            <svg viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\">\n              <path d=\"M4 10h12M10 4l6 6-6 6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            </svg>\n          </a>\n          <span class=\"microcopy\">Free for your first 5 people</span>\n        </div>\n\n        <div class=\"hero-proof\">\n          <div class=\"avatar-stack\" aria-hidden=\"true\">\n            <span class=\"avatar\">AL</span>\n            <span class=\"avatar\">MK</span>\n            <span class=\"avatar\">JR</span>\n            <span class=\"avatar\">TS</span>\n          </div>\n          <div class=\"proof-text\"><strong>Less \u201cwhat\u2019s the plan?\u201d</strong> More good work.</div>\n        </div>\n      </div>\n\n      <div class=\"hero-visual\" aria-label=\"A preview of the Tidepool weekly planner\">\n        <div class=\"visual-blob\" aria-hidden=\"true\"></div>\n\n        <div class=\"planner\">\n          <div class=\"planner-top\">\n            <div class=\"workspace-name\">\n              <div class=\"workspace-icon\" aria-hidden=\"true\">\u2733</div>\n              <div>\n                <strong>Little Field Studio</strong>\n                <span>Your team workspace</span>\n              </div>\n            </div>\n            <div class=\"week-label\">Mar 18 \u2013 22 &nbsp;\u2304</div>\n          </div>\n\n          <div class=\"planner-heading\">\n            <h2>Our week, at a glance</h2>\n            <div class=\"members\" aria-label=\"Four team members\">\n              <span class=\"avatar\">AL</span>\n              <span class=\"avatar\">MK</span>\n              <span class=\"avatar\">JR</span>\n              <span class=\"avatar\">+1</span>\n            </div>\n          </div>\n\n          <div class=\"week-grid\">\n            <div class=\"day-card highlight\">\n              <div class=\"day-top\">Monday <b>2 plans</b></div>\n              <div class=\"task\"><span class=\"task-mark\">\u2713</span> Pick this week\u2019s focus</div>\n              <div class=\"task\"><span class=\"task-mark open\"></span> Share project updates</div>\n            </div>\n            <div class=\"day-card\">\n              <div class=\"day-top\">Tuesday <b>1 plan</b></div>\n              <div class=\"task\"><span class=\"task-mark open\"></span> Customer interviews</div>\n            </div>\n            <div class=\"day-card\">\n              <div class=\"day-top\">Wednesday <b>2 plans</b></div>\n              <div class=\"task\"><span class=\"task-mark open\"></span> Sketch new landing page</div>\n              <div class=\"task\"><span class=\"task-mark open\"></span> Team check-in</div>\n            </div>\n            <div class=\"day-card\">\n              <div class=\"day-top\">Thursday <b>1 plan</b></div>\n              <div class=\"task\"><span class=\"task-mark open\"></span> Send it for feedback</div>\n            </div>\n          </div>\n\n          <div class=\"planner-footer\">\n            <span>Friday is for tying up loose ends \ud83c\udf31</span>\n            <div class=\"progress\"><span>On track</span><span class=\"progress-track\"><span></span></span></div>\n          </div>\n        </div>\n\n        <div class=\"floating-note\">\n          <div class=\"note-icon\" aria-hidden=\"true\">\u2726</div>\n          <div>\n            <strong>Everyone\u2019s in the loop</strong>\n            <span>One shared plan. No extra meetings.</span>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <div class=\"trust-row shell\" aria-label=\"Made for teams like\">\n      <span>Good company for</span>\n      <span class=\"trust-name\">small teams</span>\n      <span class=\"trust-name serif\">independent studios</span>\n      <span class=\"trust-name spaced\">STARTUPS</span>\n      <span class=\"trust-name\">people-first orgs</span>\n    </div>\n\n    <section class=\"features\" id=\"how-it-works\">\n      <div class=\"shell\">\n        <div class=\"section-intro\">\n          <div>\n            <div class=\"section-kicker\">A little more flow</div>\n            <h2>Get aligned. Then get on with it.</h2>\n          </div>\n          <p>Planning together shouldn\u2019t take longer than the work itself. Tidepool keeps your team\u2019s week simple, visible, and flexible.</p>\n        </div>\n\n        <div class=\"feature-grid\" id=\"why-tidepool\">\n          <article class=\"feature-card\">\n            <div class=\"feature-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\">\n                <path d=\"M5 6.5h14M5 12h9M5 17.5h6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n                <circle cx=\"17.5\" cy=\"16.5\" r=\"3.5\" stroke=\"currentColor\" stroke-width=\"1.8\"/>\n                <path d=\"M17.5 14.8v1.9l1.2.7\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\n              </svg>\n            </div>\n            <h3>Start with what matters</h3>\n            <p>Bring your priorities into focus before the week fills up with everything else.</p>\n          </article>\n\n          <article class=\"feature-card\">\n            <div class=\"feature-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\">\n                <path d=\"M7.5 12.5 10.5 15.5 17 8.5\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n                <circle cx=\"12\" cy=\"12\" r=\"9\" stroke=\"currentColor\" stroke-width=\"1.7\"/>\n              </svg>\n            </div>\n            <h3>Make a plan that can bend</h3>\n            <p>See who\u2019s doing what, leave room for real life, and adjust together as things change.</p>\n          </article>\n\n          <article class=\"feature-card\">\n            <div class=\"feature-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\">\n                <path d=\"M7 18.5 4 20v-4.2a8 8 0 1 1 3 2.7Z\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linejoin=\"round\"/>\n                <path d=\"M8 10h8M8 13.5h5\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/>\n              </svg>\n            </div>\n            <h3>Keep the chatter in context</h3>\n            <p>Share updates right alongside the plan, so good conversations don\u2019t get lost in the scroll.</p>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"closing\" id=\"get-started\">\n      <div class=\"closing-inner shell\">\n        <div>\n          <div class=\"section-kicker\">Your next week can feel different</div>\n          <h2>Less scrambling. More making things happen.</h2>\n        </div>\n        <a class=\"button-primary\" href=\"mailto:hello@tidepool.team\">\n          Get started for free\n          <svg viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\">\n            <path d=\"M4 10h12M10 4l6 6-6 6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          </svg>\n        </a>\n      </div>\n    </section>\n  </main>\n\n  <footer>\n    <div class=\"footer-inner shell\">\n      <a class=\"footer-brand\" href=\"#\">Tidepool</a>\n      <span>Thoughtful weeks, together.</span>\n      <div class=\"footer-links\">\n        <a href=\"#how-it-works\">How it works</a>\n        <a href=\"mailto:hello@tidepool.team\">Say hello</a>\n      </div>\n    </div>\n  </footer>\n</body>\n</html>\n"}