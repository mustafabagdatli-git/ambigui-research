{"arm": "vs", "model": "anthropic/claude-haiku-5.5", "i": 0, "finish": "stop", "dirs": [{"direction": "Calm editorial: warm paper tones, serif headlines, and a quiet tidal motif built from CSS gradients", "probability": 0.3}, {"direction": "Neo-brutalist: hard black borders, flat saturated blocks, and monospace type that feels like a planning spreadsheet", "probability": 0.1}, {"direction": "Soft daylight consumer: pastel gradients, rounded cards, and friendly rounded sans-serif type", "probability": 0.2}, {"direction": "Dark tool-first: a dense, dark, keyboard-style interface that previews the product's week view directly", "probability": 0.15}, {"direction": "Swiss modernist: a strict grid, bold sans-serif type, and a timeline rendered as the main graphic element", "probability": 0.25}], "pick": {"direction": "Calm editorial: warm paper tones, serif headlines, and a quiet tidal motif built from CSS gradients", "probability": 0.3}, "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Tidepool: Plan your week together</title>\n<meta name=\"description\" content=\"Tidepool helps small teams plan their week together, calmly and on one page.\">\n<style>\n  :root {\n    --paper: #f6f0e4;\n    --paper-deep: #efe6d4;\n    --card: #fbf7ef;\n    --ink: #2a2823;\n    --ink-soft: #5d574d;\n    --ink-faint: #8f877a;\n    --rule: #d9cdb6;\n    --sea: #3c5b5d;\n    --sea-mid: #6f9092;\n    --sea-light: #b9cbc8;\n    --sand: #d8c39b;\n    --clay: #b06a4c;\n    --serif: \"Iowan Old Style\", \"Palatino Linotype\", Palatino, \"Book Antiqua\", Georgia, serif;\n    --sans: system-ui, -apple-system, \"Segoe UI\", Helvetica, Arial, sans-serif;\n    --measure: 36rem;\n    --wrap: 72rem;\n  }\n\n  *, *::before, *::after { box-sizing: border-box; }\n\n  html { scroll-behavior: smooth; }\n\n  body {\n    margin: 0;\n    background: var(--paper);\n    color: var(--ink);\n    font-family: var(--serif);\n    font-size: 1.1rem;\n    line-height: 1.65;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  /* Subtle paper grain using a gradient, no image */\n  body::before {\n    content: \"\";\n    position: fixed;\n    inset: 0;\n    pointer-events: none;\n    z-index: -1;\n    background:\n      radial-gradient(ellipse at 15% 10%, rgba(255, 252, 244, 0.7), transparent 55%),\n      radial-gradient(ellipse at 85% 90%, rgba(214, 196, 160, 0.25), transparent 60%);\n  }\n\n  img, svg { display: block; max-width: 100%; }\n  a { color: inherit; }\n  h1, h2, h3 { font-weight: 400; margin: 0; letter-spacing: -0.01em; }\n  p { margin: 0; }\n\n  .wrap {\n    width: min(var(--wrap), calc(100% - 3rem));\n    margin-inline: auto;\n  }\n\n  .eyebrow {\n    font-family: var(--sans);\n    font-size: 0.72rem;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n    color: var(--ink-faint);\n  }\n\n  /* ---------- Navigation ---------- */\n  .nav {\n    padding: 1.6rem 0;\n  }\n  .nav .wrap {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 1.5rem;\n  }\n  .brand {\n    display: inline-flex;\n    align-items: center;\n    gap: 0.6rem;\n    text-decoration: none;\n    font-size: 1.35rem;\n    font-style: italic;\n  }\n  .brand-mark {\n    width: 1.5rem;\n    height: 1.5rem;\n    border-radius: 50%;\n    background:\n      radial-gradient(circle at 50% 30%, var(--sea-light) 0 28%, transparent 29%),\n      linear-gradient(180deg, var(--sea-mid), var(--sea));\n    box-shadow: inset 0 -6px 0 rgba(42, 40, 35, 0.12);\n  }\n  .nav-links {\n    display: flex;\n    align-items: center;\n    gap: 1.75rem;\n    font-family: var(--sans);\n    font-size: 0.9rem;\n  }\n  .nav-links a { text-decoration: none; color: var(--ink-soft); }\n  .nav-links a:hover { color: var(--ink); }\n  .nav-links .btn-small {\n    color: var(--paper);\n    background: var(--ink);\n    padding: 0.55rem 1.05rem;\n    border-radius: 999px;\n  }\n  .nav-links .btn-small:hover { background: var(--sea); }\n\n  /* ---------- Buttons ---------- */\n  .btn {\n    display: inline-flex;\n    align-items: center;\n    gap: 0.5rem;\n    font-family: var(--sans);\n    font-size: 0.95rem;\n    text-decoration: none;\n    padding: 0.85rem 1.4rem;\n    border-radius: 999px;\n    border: 1px solid var(--ink);\n    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease;\n  }\n  .btn-primary {\n    background: var(--ink);\n    color: var(--paper);\n  }\n  .btn-primary:hover { background: var(--sea); border-color: var(--sea); }\n  .btn-ghost {\n    background: transparent;\n    color: var(--ink);\n  }\n  .btn-ghost:hover { background: var(--ink); color: var(--paper); }\n\n  /* ---------- Hero ---------- */\n  .hero {\n    padding: clamp(3rem, 8vw, 6.5rem) 0 clamp(4rem, 9vw, 7rem);\n  }\n  .hero-grid {\n    display: grid;\n    grid-template-columns: 1.05fr 0.95fr;\n    gap: clamp(2.5rem, 5vw, 4.5rem);\n    align-items: center;\n  }\n  .hero h1 {\n    font-size: clamp(2.6rem, 5.6vw, 4.4rem);\n    line-height: 1.04;\n    margin-top: 1.2rem;\n  }\n  .hero h1 em {\n    color: var(--sea);\n    font-style: italic;\n  }\n  .lede {\n    margin-top: 1.6rem;\n    max-width: var(--measure);\n    font-size: 1.2rem;\n    color: var(--ink-soft);\n  }\n  .cta-row {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 0.9rem;\n    margin-top: 2.2rem;\n  }\n  .fine-print {\n    margin-top: 1.2rem;\n    font-family: var(--sans);\n    font-size: 0.82rem;\n    color: var(--ink-faint);\n  }\n\n  /* Week board mockup */\n  .board {\n    position: relative;\n    background: var(--card);\n    border: 1px solid var(--rule);\n    border-radius: 14px;\n    padding: 1.25rem 1.2rem 1.4rem;\n    box-shadow:\n      0 1px 0 rgba(255, 255, 255, 0.6) inset,\n      0 30px 60px -30px rgba(60, 50, 30, 0.25),\n      0 8px 18px -10px rgba(60, 50, 30, 0.18);\n    transform: rotate(-0.6deg);\n  }\n  .board-head {\n    display: flex;\n    justify-content: space-between;\n    align-items: baseline;\n    padding-bottom: 0.9rem;\n    margin-bottom: 1rem;\n    border-bottom: 1px solid var(--rule);\n  }\n  .board-head h3 {\n    font-size: 1.35rem;\n    font-style: italic;\n  }\n  .days {\n    display: grid;\n    grid-template-columns: repeat(5, 1fr);\n    gap: 0.5rem;\n  }\n  .day {\n    display: flex;\n    flex-direction: column;\n    gap: 0.5rem;\n    min-height: 16rem;\n  }\n  .day-name {\n    font-family: var(--sans);\n    font-size: 0.7rem;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    color: var(--ink-faint);\n    padding-bottom: 0.35rem;\n    border-bottom: 1px dotted var(--rule);\n  }\n  .day.today .day-name { color: var(--sea); }\n  .task {\n    background: var(--paper);\n    border: 1px solid var(--rule);\n    border-radius: 8px;\n    padding: 0.55rem 0.6rem 0.6rem;\n    font-family: var(--sans);\n    font-size: 0.74rem;\n    line-height: 1.35;\n    color: var(--ink);\n  }\n  .task .bar {\n    display: block;\n    height: 3px;\n    width: 2.2rem;\n    border-radius: 3px;\n    margin-bottom: 0.45rem;\n    background: var(--sea-mid);\n  }\n  .task.clay .bar { background: var(--clay); }\n  .task.sand .bar { background: var(--sand); }\n  .task.light .bar { background: var(--sea-light); }\n  .task .who {\n    display: flex;\n    align-items: center;\n    gap: 0.3rem;\n    margin-top: 0.45rem;\n    color: var(--ink-faint);\n    font-size: 0.68rem;\n  }\n  .chip {\n    display: inline-grid;\n    place-items: center;\n    width: 1.1rem;\n    height: 1.1rem;\n    border-radius: 50%;\n    background: var(--paper-deep);\n    border: 1px solid var(--rule);\n    font-size: 0.56rem;\n    font-weight: 600;\n    color: var(--ink-soft);\n  }\n  .task.ghost {\n    background: transparent;\n    border-style: dashed;\n    color: var(--ink-faint);\n    text-align: center;\n  }\n  .board-foot {\n    margin-top: 1.1rem;\n    padding-top: 0.9rem;\n    border-top: 1px solid var(--rule);\n    display: flex;\n    justify-content: space-between;\n    font-family: var(--sans);\n    font-size: 0.75rem;\n    color: var(--ink-soft);\n  }\n\n  /* ---------- Tidal motif ---------- */\n  .tide {\n    position: relative;\n    height: clamp(90px, 14vw, 150px);\n    overflow: hidden;\n    margin-top: -1px;\n  }\n  .tide .layer {\n    position: absolute;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    height: 100%;\n    /* Scalloped ripple edge built from a radial mask repeated along x */\n    -webkit-mask: radial-gradient(circle at 50% 0%, transparent 0 58%, #000 59.5%) 0 100% / 150px 46px repeat-x;\n            mask: radial-gradient(circle at 50% 0%, transparent 0 58%, #000 59.5%) 0 100% / 150px 46px repeat-x;\n    animation: drift 42s linear infinite;\n  }\n  .tide .layer-1 {\n    background: linear-gradient(180deg, var(--sea-light), #d4dbd2);\n    height: 88%;\n    opacity: 0.55;\n    animation-duration: 58s;\n  }\n  .tide .layer-2 {\n    background: linear-gradient(180deg, var(--sea-mid), var(--sea-light));\n    height: 70%;\n    opacity: 0.7;\n    animation-duration: 40s;\n    animation-direction: reverse;\n  }\n  .tide .layer-3 {\n    background: linear-gradient(180deg, var(--sea), #2f4a4c);\n    height: 40%;\n    animation-duration: 30s;\n  }\n  .tide .shore {\n    position: absolute;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    height: 14%;\n    background: var(--sand);\n    opacity: 0.6;\n  }\n  @keyframes drift {\n    from { background-position: 0 100%, 0 0; }\n    to   { background-position: 1500px 100%, 0 0; }\n  }\n  .tide.flip { transform: scaleY(-1); }\n\n  /* Quiet horizontal tide-line divider */\n  .tideline {\n    height: 1px;\n    background: linear-gradient(90deg, transparent, var(--rule) 15%, var(--rule) 85%, transparent);\n    margin: 0;\n    border: 0;\n  }\n\n  /* ---------- Sections ---------- */\n  section { position: relative; }\n  .section {\n    padding: clamp(4rem, 9vw, 7rem) 0;\n  }\n  .section-head {\n    display: grid;\n    grid-template-columns: 1fr 2fr;\n    gap: 2rem;\n    margin-bottom: clamp(2.5rem, 5vw, 4rem);\n  }\n  .section-head h2 {\n    font-size: clamp(2rem, 3.6vw, 2.8rem);\n    line-height: 1.12;\n    margin-top: 0.8rem;\n  }\n\n  /* Editorial essay */\n  .essay {\n    display: grid;\n    grid-template-columns: 1fr 2fr;\n    gap: 2rem;\n  }\n  .essay .pull {\n    font-size: clamp(1.6rem, 2.8vw, 2.2rem);\n    line-height: 1.3;\n    font-style: italic;\n    color: var(--sea);\n  }\n  .essay .body p + p { margin-top: 1.2rem; }\n  .essay .body p:first-child::first-letter {\n    float: left;\n    font-size: 4.2rem;\n    line-height: 0.9;\n    padding: 0.35rem 0.6rem 0 0;\n    color: var(--ink);\n  }\n  .essay .body {\n    max-width: var(--measure);\n    color: var(--ink-soft);\n  }\n\n  /* Steps */\n  .steps {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    border-top: 1px solid var(--ink);\n  }\n  .step {\n    padding: 2rem 2rem 0 0;\n  }\n  .step + .step {\n    padding-left: 2rem;\n    border-left: 1px solid var(--rule);\n  }\n  .step .num {\n    font-family: var(--sans);\n    font-size: 0.8rem;\n    color: var(--clay);\n    letter-spacing: 0.1em;\n  }\n  .step h3 {\n    font-size: 1.75rem;\n    font-style: italic;\n    margin: 0.7rem 0 0.8rem;\n  }\n  .step p { color: var(--ink-soft); font-size: 1.02rem; }\n\n  /* Features */\n  .features {\n    background: var(--paper-deep);\n    position: relative;\n  }\n  .feature-list {\n    list-style: none;\n    padding: 0;\n    margin: 0;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 0;\n    border-top: 1px solid var(--rule);\n  }\n  .feature-list li {\n    padding: 1.8rem 2rem 1.8rem 0;\n    border-bottom: 1px solid var(--rule);\n  }\n  .feature-list li:nth-child(odd) { padding-right: 2.5rem; border-right: 1px solid var(--rule); }\n  .feature-list li:nth-child(even) { padding-left: 2.5rem; }\n  .feature-list h3 {\n    font-size: 1.3rem;\n    margin-bottom: 0.4rem;\n  }\n  .feature-list p {\n    color: var(--ink-soft);\n    font-size: 1rem;\n  }\n  .feature-list .glyph {\n    display: block;\n    width: 2.2rem;\n    height: 0.9rem;\n    margin-bottom: 0.9rem;\n    border-radius: 0 0 50% 50% / 0 0 100% 100%;\n    background: linear-gradient(180deg, var(--sea-mid), var(--sea));\n    opacity: 0.85;\n  }\n  .feature-list li:nth-child(2) .glyph { background: linear-gradient(180deg, var(--sand), #c4a873); }\n  .feature-list li:nth-child(3) .glyph { background: linear-gradient(180deg, var(--sea-light), var(--sea-mid)); }\n  .feature-list li:nth-child(4) .glyph { background: linear-gradient(180deg, #d9a184, var(--clay)); }\n\n  /* Quote */\n  .quote {\n    max-width: 52rem;\n    margin: 0 auto;\n    text-align: center;\n  }\n  .quote blockquote {\n    margin: 1.2rem 0 0;\n    font-size: clamp(1.7rem, 3.2vw, 2.5rem);\n    line-height: 1.25;\n    font-style: italic;\n  }\n  .quote cite {\n    display: block;\n    margin-top: 1.6rem;\n    font-style: normal;\n    font-family: var(--sans);\n    font-size: 0.85rem;\n    color: var(--ink-faint);\n    letter-spacing: 0.04em;\n  }\n\n  /* Pricing */\n  .pricing {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 1.25rem;\n    max-width: 52rem;\n    margin: 0 auto;\n  }\n  .plan {\n    background: var(--card);\n    border: 1px solid var(--rule);\n    border-radius: 14px;\n    padding: 2.2rem 2.2rem 2.4rem;\n  }\n  .plan.featured {\n    background: var(--ink);\n    color: var(--paper);\n    border-color: var(--ink);\n  }\n  .plan h3 { font-size: 1.6rem; font-style: italic; }\n  .plan .price {\n    margin: 1rem 0 0.3rem;\n    font-size: 2.8rem;\n    line-height: 1;\n  }\n  .plan .price small {\n    font-family: var(--sans);\n    font-size: 0.85rem;\n    color: var(--ink-faint);\n  }\n  .plan.featured .price small { color: var(--sea-light); }\n  .plan ul {\n    list-style: none;\n    padding: 0;\n    margin: 1.4rem 0 1.8rem;\n    font-family: var(--sans);\n    font-size: 0.92rem;\n  }\n  .plan li {\n    padding: 0.5rem 0;\n    border-top: 1px solid var(--rule);\n    color: var(--ink-soft);\n  }\n  .plan.featured li { border-color: rgba(246, 240, 228, 0.15); color: var(--sea-light); }\n  .plan .btn { width: 100%; justify-content: center; }\n  .plan.featured .btn-primary { background: var(--paper); color: var(--ink); border-color: var(--paper); }\n  .plan.featured .btn-primary:hover { background: var(--sand); border-color: var(--sand); }\n\n  /* Closing CTA */\n  .closing {\n    background:\n      linear-gradient(180deg, var(--paper) 0%, #e9e1cf 45%, #d7d9ca 75%, var(--sea-light) 100%);\n    padding: clamp(5rem, 12vw, 9rem) 0 0;\n    overflow: hidden;\n  }\n  .closing .wrap { text-align: center; position: relative; z-index: 1; }\n  .closing h2 {\n    font-size: clamp(2.3rem, 5vw, 3.8rem);\n    line-height: 1.08;\n    max-width: 16ch;\n    margin: 1rem auto 0;\n  }\n  .closing p {\n    margin: 1.4rem auto 0;\n    max-width: 30rem;\n    color: var(--ink-soft);\n  }\n  .closing .cta-row { justify-content: center; }\n  .closing .tide { margin-top: 4.5rem; }\n\n  /* Footer */\n  footer {\n    background: var(--sea);\n    color: var(--sea-light);\n    font-family: var(--sans);\n    font-size: 0.88rem;\n    padding: 2.2rem 0 2.6rem;\n  }\n  footer .wrap {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: space-between;\n    align-items: center;\n    gap: 1rem 2rem;\n  }\n  footer .brand { color: var(--paper); font-size: 1.15rem; }\n  footer .brand-mark { background: radial-gradient(circle at 50% 30%, var(--sea) 0 28%, transparent 29%), linear-gradient(180deg, var(--paper), var(--sand)); }\n  footer nav { display: flex; gap: 1.5rem; flex-wrap: wrap; }\n  footer a { color: var(--sea-light); text-decoration: none; }\n  footer a:hover { color: var(--paper); }\n\n  /* ---------- Responsive ---------- */\n  @media (max-width: 960px) {\n    .hero-grid { grid-template-columns: 1fr; }\n    .board { transform: none; }\n    .section-head, .essay { grid-template-columns: 1fr; }\n    .steps { grid-template-columns: 1fr; }\n    .step, .step + .step {\n      padding: 1.8rem 0;\n      padding-left: 0;\n      border-left: 0;\n      border-bottom: 1px solid var(--rule);\n    }\n  }\n\n  @media (max-width: 720px) {\n    .nav-links a:not(.btn-small) { display: none; }\n    .days { grid-template-columns: 1fr; }\n    .day { min-height: 0; }\n    .day-name { border-bottom: 0; padding-bottom: 0; }\n    .feature-list { grid-template-columns: 1fr; }\n    .feature-list li,\n    .feature-list li:nth-child(odd),\n    .feature-list li:nth-child(even) {\n      padding: 1.6rem 0;\n      border-right: 0;\n    }\n    .pricing { grid-template-columns: 1fr; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    html { scroll-behavior: auto; }\n    .tide .layer { animation: none; }\n  }\n</style>\n</head>\n<body>\n\n<header class=\"nav\">\n  <div class=\"wrap\">\n    <a class=\"brand\" href=\"#top\" aria-label=\"Tidepool home\">\n      <span class=\"brand-mark\" aria-hidden=\"true\"></span>\n      Tidepool\n    </a>\n    <nav class=\"nav-links\" aria-label=\"Primary\">\n      <a href=\"#how\">How it works</a>\n      <a href=\"#features\">Features</a>\n      <a href=\"#pricing\">Pricing</a>\n      <a class=\"btn-small\" href=\"#start\">Start a week</a>\n    </nav>\n  </div>\n</header>\n\n<main id=\"top\">\n\n  <!-- Hero -->\n  <section class=\"hero\">\n    <div class=\"wrap hero-grid\">\n      <div>\n        <p class=\"eyebrow\">For teams of two to twelve</p>\n        <h1>Plan the week <em>together</em>, then let it go gently.</h1>\n        <p class=\"lede\">Tidepool gives small teams one calm page for the week ahead. Gather what matters, shape the days around it, and settle into work that already knows where it belongs.</p>\n        <div class=\"cta-row\">\n          <a class=\"btn btn-primary\" href=\"#start\">Start a free week</a>\n          <a class=\"btn btn-ghost\" href=\"#how\">See how it works</a>\n        </div>\n        <p class=\"fine-print\">Free for teams of three. No card required.</p>\n      </div>\n\n      <div aria-label=\"Example week board\">\n        <div class=\"board\">\n          <div class=\"board-head\">\n            <h3>Week of March 9</h3>\n            <span class=\"eyebrow\">4 of 6 settled</span>\n          </div>\n          <div class=\"days\">\n            <div class=\"day\">\n              <span class=\"day-name\">Mon</span>\n              <div class=\"task clay\">\n                <span class=\"bar\"></span>\n                Kickoff, agree on the two priorities\n                <div class=\"who\"><span class=\"chip\">AN</span> Ana</div>\n              </div>\n              <div class=\"task light\">\n                <span class=\"bar\"></span>\n                Draft pricing notes\n                <div class=\"who\"><span class=\"chip\">JR</span> Jun</div>\n              </div>\n            </div>\n            <div class=\"day\">\n              <span class=\"day-name\">Tue</span>\n              <div class=\"task\">\n                <span class=\"bar\"></span>\n                Client review, 30 min\n                <div class=\"who\"><span class=\"chip\">MK</span> Mira</div>\n              </div>\n              <div class=\"task sand\">\n                <span class=\"bar\"></span>\n                Write onboarding copy\n                <div class=\"who\"><span class=\"chip\">AN</span> Ana</div>\n              </div>\n            </div>\n            <div class=\"day today\">\n              <span class=\"day-name\">Wed</span>\n              <div class=\"task light\">\n                <span class=\"bar\"></span>\n                Ship the beta to three accounts\n                <div class=\"who\"><span class=\"chip\">JR</span> Jun</div>\n              </div>\n              <div class=\"task ghost\">Open slot</div>\n            </div>\n            <div class=\"day\">\n              <span class=\"day-name\">Thu</span>\n              <div class=\"task clay\">\n                <span class=\"bar\"></span>\n                Quiet focus block\n                <div class=\"who\"><span class=\"chip\">MK</span> Mira</div>\n              </div>\n            </div>\n            <div class=\"day\">\n              <span class=\"day-name\">Fri</span>\n              <div class=\"task sand\">\n                <span class=\"bar\"></span>\n                Retro and next week's shape\n                <div class=\"who\"><span class=\"chip\">AN</span> Ana</div>\n              </div>\n            </div>\n          </div>\n          <div class=\"board-foot\">\n            <span>Everyone has seen this page.</span>\n            <span>Last touched 9:14 am</span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"wrap\" style=\"margin-top: clamp(3rem, 7vw, 5rem);\">\n      <div class=\"tide\" aria-hidden=\"true\">\n        <div class=\"layer layer-1\"></div>\n        <div class=\"layer layer-2\"></div>\n        <div class=\"layer layer-3\"></div>\n        <div class=\"shore\"></div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Editorial essay -->\n  <section class=\"section\" style=\"padding-top: 0;\">\n    <div class=\"wrap essay\">\n      <p class=\"pull\">Most weekly plans fail in the gap between a meeting and a Monday morning.</p>\n      <div class=\"body\">\n        <p>Small teams rarely lack ideas. They lack a shared place where the week takes a visible shape, so that every person can see what is theirs, what is open, and what can wait. Planning happens in threads, in half-remembered calls, in a sticky note that drifts off the desk.</p>\n        <p>Tidepool is built around one quiet premise: a week should be decided once, together, and then held lightly. Each morning the tide comes in and the plan is still there, with room to shift when the work does.</p>\n      </div>\n    </div>\n  </section>\n\n  <hr class=\"tideline\">\n\n  <!-- How it works -->\n  <section class=\"section\" id=\"how\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <div>\n          <p class=\"eyebrow\">How it works</p>\n        </div>\n        <div>\n          <h2>Three unhurried steps, about twenty minutes on Monday.</h2>\n        </div>\n      </div>\n\n      <div class=\"steps\">\n        <article class=\"step\">\n          <span class=\"num\">01 \u00b7 Gather</span>\n          <h3>Bring in what's pending</h3>\n          <p>Everyone drops their open tasks and commitments onto a shared sheet. Nothing needs to be tidy yet. Tidepool keeps a running list so nothing is lost between weeks.</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"num\">02 \u00b7 Shape</span>\n          <h3>Arrange the days</h3>\n          <p>Drag work onto the days it belongs to. The board shows each person's load at a glance, so a heavy Wednesday is visible before it arrives rather than after.</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"num\">03 \u00b7 Settle</span>\n          <h3>Agree and step away</h3>\n          <p>Confirm the plan with one tap. Tidepool sends a short summary, then keeps the page quiet until the next review. Changes are visible, never urgent.</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <!-- Features -->\n  <section class=\"section features\" id=\"features\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <div>\n          <p class=\"eyebrow\">What's inside</p>\n        </div>\n        <div>\n          <h2>Only the things a small team actually needs.</h2>\n        </div>\n      </div>\n\n      <ul class=\"feature-list\">\n        <li>\n          <span class=\"glyph\" aria-hidden=\"true\"></span>\n          <h3>One page for the whole week</h3>\n          <p>A single view of Monday through Friday, with the team's priorities pinned at the top where nobody can miss them.</p>\n        </li>\n        <li>\n          <span class=\"glyph\" aria-hidden=\"true\"></span>\n          <h3>Load you can see</h3>\n          <p>Gentle indicators show who has room and who is carrying too much, so work gets balanced before anyone burns out.</p>\n        </li>\n        <li>\n          <span class=\"glyph\" aria-hidden=\"true\"></span>\n          <h3>Weekly review, built in</h3>\n          <p>A short prompt on Friday captures what moved, what stalled, and what to carry forward into the next plan.</p>\n        </li>\n        <li>\n          <span class=\"glyph\" aria-hidden=\"true\"></span>\n          <h3>Quiet notifications</h3>\n          <p>One digest a day instead of a stream of pings. Tidepool speaks when the plan changes, and otherwise stays out of the way.</p>\n        </li>\n      </ul>\n    </div>\n  </section>\n\n  <!-- Testimonial -->\n  <section class=\"section\">\n    <div class=\"wrap quote\">\n      <p class=\"eyebrow\">From a team of four</p>\n      <blockquote>&ldquo;We used to start every Monday by hunting for the plan. Now it is already on the table, and the first hour is simply work.&rdquo;</blockquote>\n      <cite>Mira Okafor, operations lead at a six-person design studio</cite>\n    </div>\n  </section>\n\n  <!-- Pricing -->\n  <section class=\"section\" id=\"pricing\" style=\"padding-top: 0;\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <div>\n          <p class=\"eyebrow\">Pricing</p>\n        </div>\n        <div>\n          <h2>Simple plans, no seat anxiety.</h2>\n        </div>\n      </div>\n\n      <div class=\"pricing\">\n        <article class=\"plan\">\n          <h3>Small Shore</h3>\n          <p class=\"eyebrow\">For teams of up to three</p>\n          <p class=\"price\">Free</p>\n          <ul>\n            <li>One active week at a time</li>\n            <li>Unlimited tasks and notes</li>\n            <li>Friday review prompts</li>\n          </ul>\n          <a class=\"btn btn-ghost\" href=\"#start\">Begin free</a>\n        </article>\n\n        <article class=\"plan featured\">\n          <h3>Full Tide</h3>\n          <p class=\"eyebrow\" style=\"color: var(--sea-light);\">For teams of four to twelve</p>\n          <p class=\"price\">$8 <small>per person, per month</small></p>\n          <ul>\n            <li>Unlimited weeks and history</li>\n            <li>Load indicators and balancing</li>\n            <li>Daily digest and summaries</li>\n          </ul>\n          <a class=\"btn btn-primary\" href=\"#start\">Start a trial</a>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <!-- Closing -->\n  <section class=\"closing\" id=\"start\">\n    <div class=\"wrap\">\n      <p class=\"eyebrow\">Your first week is waiting</p>\n      <h2>Settle the week together, before it starts moving.</h2>\n      <p>Set up a shared week in a few minutes. Invite your team when you are ready, and let the tide do the rest.</p>\n      <div class=\"cta-row\">\n        <a class=\"btn btn-primary\" href=\"#top\">Create your week</a>\n        <a class=\"btn btn-ghost\" href=\"#how\">Read the walkthrough</a>\n      </div>\n    </div>\n    <div class=\"tide\" aria-hidden=\"true\">\n      <div class=\"layer layer-1\"></div>\n      <div class=\"layer layer-2\"></div>\n      <div class=\"layer layer-3\"></div>\n      <div class=\"shore\"></div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <a class=\"brand\" href=\"#top\">\n      <span class=\"brand-mark\" aria-hidden=\"true\"></span>\n      Tidepool\n    </a>\n    <nav aria-label=\"Footer\">\n      <a href=\"#features\">Features</a>\n      <a href=\"#pricing\">Pricing</a>\n      <a href=\"#how\">How it works</a>\n      <a href=\"#top\">Privacy</a>\n      <a href=\"#top\">Contact</a>\n    </nav>\n    <span>&copy; 2025 Tidepool. Made slowly.</span>\n  </div>\n</footer>\n\n</body>\n</html>\n"}