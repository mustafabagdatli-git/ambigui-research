{"arm": "vs", "model": "z-ai/glm-5.3-flashx", "i": 0, "finish": "stop", "dirs": [{"direction": "Editorial calm \u2014 warm paper tones, large serif display type, generous whitespace, a hand-drawn-feel weekly grid as hero", "probability": 0.35}, {"direction": "Playful product demo \u2014 an interactive draggable mock week planner front and center, bold rounded UI, coral/teal palette", "probability": 0.3}, {"direction": "Minimal SaaS standard \u2014 dark hero, gradient accents, feature cards with icons, testimonial strip", "probability": 0.15}, {"direction": "Narrative scroll \u2014 a long storytelling page where a team's week unfolds section by section as you scroll", "probability": 0.12}, {"direction": "Brutalist retro \u2014 stark grid lines, monospace type, high-contrast black on cream, calendar-as-diagram aesthetic", "probability": 0.08}], "pick": {"direction": "Playful product demo \u2014 an interactive draggable mock week planner front and center, bold rounded UI, coral/teal palette", "probability": 0.3}, "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Tidepool \u2014 Plan your week together</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,600;0,9..144,900;1,9..144,600;1,9..144,900&family=Outfit:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --cream:#FAF3E7; --paper:#FFFDF8;\n    --ink:#173B36; --ink-soft:rgba(23,59,54,.62);\n    --coral:#FF6B57; --coral-d:#E4503C; --coral-t:#FFE4DD;\n    --teal:#12897C; --teal-d:#0C6B60; --teal-t:#D8F0E9;\n    --amber:#FFC24B; --amber-t:#FFF0D2;\n    --r-lg:24px; --r-md:16px; --r-sm:12px;\n    --shadow-pop:6px 6px 0 var(--ink);\n    --font-display:\"Fraunces\",serif;\n    --font-body:\"Outfit\",sans-serif;\n  }\n  *{margin:0;padding:0;box-sizing:border-box}\n  html{scroll-behavior:smooth}\n  body{\n    background:var(--cream);\n    color:var(--ink);\n    font-family:var(--font-body);\n    font-size:17px; line-height:1.6;\n    overflow-x:hidden;\n  }\n  ::selection{background:var(--amber);color:var(--ink)}\n  h1,h2,h3{font-family:var(--font-display);line-height:1.08;letter-spacing:-.02em}\n  button{font-family:var(--font-body);cursor:pointer}\n  svg{display:block}\n  .wrap{max-width:1180px;margin:0 auto;padding:0 24px}\n\n  /* ---------- buttons ---------- */\n  .btn{\n    display:inline-flex;align-items:center;gap:10px;\n    font-weight:700;font-size:16px;\n    padding:14px 26px;border-radius:999px;\n    border:2px solid var(--ink);\n    transition:transform .15s ease, box-shadow .15s ease, background .15s ease;\n    text-decoration:none;\n  }\n  .btn-coral{background:var(--coral);color:#fff;box-shadow:0 5px 0 var(--ink)}\n  .btn-coral:hover{background:var(--coral-d);transform:translateY(-2px);box-shadow:0 7px 0 var(--ink)}\n  .btn-coral:active{transform:translateY(3px);box-shadow:0 1px 0 var(--ink)}\n  .btn-ghost{background:transparent;color:var(--ink);box-shadow:none}\n  .btn-ghost:hover{background:var(--teal-t);transform:translateY(-2px)}\n  .btn-sm{padding:9px 18px;font-size:14px;box-shadow:0 4px 0 var(--ink)}\n  .btn-sm:active{transform:translateY(3px);box-shadow:0 1px 0 var(--ink)}\n  .btn-ink{background:var(--ink);color:var(--cream);box-shadow:0 5px 0 rgba(23,59,54,.35)}\n  .btn-ink:hover{transform:translateY(-2px);box-shadow:0 7px 0 rgba(23,59,54,.35)}\n  .btn-ink:active{transform:translateY(3px);box-shadow:0 1px 0 rgba(23,59,54,.35)}\n  .btn:focus-visible,.card:focus-visible{outline:3px solid var(--coral);outline-offset:3px}\n\n  /* ---------- nav ---------- */\n  nav{\n    position:sticky;top:0;z-index:50;\n    background:rgba(250,243,231,.92);backdrop-filter:blur(8px);\n    border-bottom:2px solid rgba(23,59,54,.1);\n  }\n  .nav-inner{display:flex;align-items:center;justify-content:space-between;height:72px}\n  .logo{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--ink)}\n  .logo-word{font-family:var(--font-display);font-weight:900;font-size:24px;letter-spacing:-.02em}\n  .nav-links{display:flex;align-items:center;gap:32px;list-style:none}\n  .nav-links a{color:var(--ink);text-decoration:none;font-weight:600;font-size:15px}\n  .nav-links a:not(.btn):hover{color:var(--coral-d)}\n  @media(max-width:760px){.nav-links li.hide-m{display:none}}\n\n  /* ---------- hero ---------- */\n  .hero{padding:76px 0 44px;text-align:center}\n  .eyebrow{\n    display:inline-flex;align-items:center;gap:8px;\n    background:var(--teal-t);border:2px solid var(--ink);border-radius:999px;\n    padding:7px 18px;font-weight:700;font-size:13px;letter-spacing:.08em;text-transform:uppercase;\n    margin-bottom:28px;\n  }\n  .eyebrow i{width:8px;height:8px;border-radius:50%;background:var(--coral);animation:pulse 1.8s infinite}\n  @keyframes pulse{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(1.5);opacity:.5}}\n  .hero h1{font-size:clamp(2.6rem,5.6vw,4.4rem);font-weight:900;max-width:840px;margin:0 auto 22px}\n  .hl{\n    position:relative;display:inline-block;\n    background:var(--amber);border-radius:8px;padding:0 .18em;\n    box-shadow:2px 3px 0 rgba(23,59,54,.9);\n    transform:rotate(-1.2deg);white-space:nowrap;\n  }\n  .hero p{max-width:560px;margin:0 auto 34px;font-size:19px;color:var(--ink-soft)}\n  .hero-ctas{display:flex;gap:16px;justify-content:center;flex-wrap:wrap}\n  .rise{animation:rise .7s cubic-bezier(.2,.8,.3,1) both}\n  .d1{animation-delay:.08s}.d2{animation-delay:.16s}.d3{animation-delay:.24s}\n  @keyframes rise{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}\n\n  /* ---------- board ---------- */\n  .board-zone{padding:14px 0 90px;position:relative}\n  .board-toolbar{\n    display:flex;align-items:center;justify-content:space-between;\n    flex-wrap:wrap;gap:14px;margin-bottom:18px;\n  }\n  .toolbar-label{display:flex;align-items:center;gap:10px;font-weight:700;font-size:15px}\n  .toolbar-label i{width:10px;height:10px;border-radius:50%;background:var(--teal);animation:pulse 2s infinite}\n  .toolbar-btns{display:flex;gap:10px}\n  .board{\n    background:var(--paper);\n    border:2px solid var(--ink);border-radius:var(--r-lg);\n    box-shadow:var(--shadow-pop);\n    display:flex;gap:0;padding:18px;\n    overflow-x:auto;\n  }\n  .col{display:flex;flex-direction:column;min-width:0}\n  .col.pool{width:230px;flex:0 0 230px;padding-right:16px;border-right:2px dashed rgba(23,59,54,.25)}\n  .col.day{flex:1 1 0;padding:0 8px;min-width:150px}\n  .col-head{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:4px 6px 10px;flex-wrap:wrap}\n  .col-title{font-weight:700;font-size:14px;letter-spacing:.04em;text-transform:uppercase}\n  .col-date{font-size:12px;color:var(--ink-soft);font-weight:600}\n  .today-chip{\n    background:var(--coral);color:#fff;border:2px solid var(--ink);border-radius:999px;\n    font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:2px 9px;\n  }\n  .count{\n    background:var(--ink);color:var(--cream);border-radius:999px;\n    min-width:26px;text-align:center;font-size:12px;font-weight:700;padding:2px 8px;\n  }\n  .caps{display:flex;gap:5px;padding:0 6px 10px}\n  .caps i{width:9px;height:9px;border-radius:50%;border:2px solid var(--ink);background:transparent;transition:background .2s}\n  .caps i.on{background:var(--teal)}\n  .col.over .caps i{background:var(--amber);border-color:var(--ink)}\n  .col.over .count{background:var(--coral-d)}\n  .cards{\n    display:flex;flex-direction:column;gap:10px;flex:1;\n    min-height:280px;padding:8px;border-radius:var(--r-md);\n    transition:background .15s, outline-color .15s;\n    outline:2px dashed transparent;outline-offset:-4px;\n  }\n  .cards.drag-over{background:var(--teal-t);outline-color:var(--teal)}\n  .col.pool .cards.drag-over{background:var(--coral-t);outline-color:var(--coral)}\n  .pool-empty{\n    margin:8px;padding:18px 12px;text-align:center;\n    font-family:var(--font-display);font-style:italic;font-size:16px;color:var(--teal-d);\n    border:2px dashed var(--teal);border-radius:var(--r-md);background:var(--teal-t);\n  }\n\n  /* cards */\n  .card{\n    position:relative;\n    background:var(--paper);\n    border:2px solid var(--ink);border-radius:14px;\n    padding:10px 12px 9px;\n    box-shadow:0 3px 0 var(--ink);\n    cursor:grab;user-select:none;-webkit-user-select:none;touch-action:none;\n    transition:transform .12s ease, box-shadow .12s ease;\n  }\n  .card:hover{transform:translateY(-2px);box-shadow:0 5px 0 var(--ink)}\n  .card:active{cursor:grabbing}\n  .card.t-focus{background:var(--teal-t)}\n  .card.t-team{background:var(--coral-t)}\n  .card.t-ritual{background:var(--amber-t)}\n  .card.dragging{opacity:.35;box-shadow:none;transform:none;outline:2px dashed var(--ink);outline-offset:2px}\n  .card.settle{animation:settle .3s cubic-bezier(.3,1.6,.5,1)}\n  @keyframes settle{0%{transform:scale(.92)}60%{transform:scale(1.05)}100%{transform:scale(1)}}\n  .card.lift{\n    position:fixed;z-index:999;pointer-events:none;margin:0;\n    transform:rotate(-2.5deg) scale(1.06);\n    box-shadow:0 20px 32px rgba(23,59,54,.3);\n    transition:none;cursor:grabbing;\n  }\n  .card-top{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:5px}\n  .tag{\n    font-size:10px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;\n    padding:2px 9px;border-radius:999px;border:1.5px solid var(--ink);color:var(--ink);\n  }\n  .tag.t-focus{background:var(--teal)}\n  .tag.t-team{background:var(--coral);color:#fff}\n  .tag.t-ritual{background:var(--amber)}\n  .card-time{font-size:12px;font-weight:700;color:var(--ink-soft)}\n  .card-title{font-weight:600;font-size:14.5px;line-height:1.3}\n  .card-foot{display:flex;align-items:center;justify-content:space-between;margin-top:8px}\n  .avatars{display:flex}\n  .avatar{\n    width:22px;height:22px;border-radius:50%;border:2px solid var(--ink);\n    display:flex;align-items:center;justify-content:center;\n    font-size:9px;font-weight:700;color:#fff;margin-left:-7px;\n  }\n  .avatar:first-child{margin-left:0}\n  .a0{background:var(--teal)}.a1{background:var(--coral)}.a2{background:var(--amber);color:var(--ink)}.a3{background:var(--ink)}\n  .everyone{font-size:11.5px;font-weight:700;color:var(--ink-soft)}\n\n  /* hint arrow */\n  .hint{\n    position:absolute;left:44px;top:-14px;z-index:5;\n    display:flex;align-items:flex-end;gap:4px;pointer-events:none;\n    animation:bob 2.2s ease-in-out infinite;transition:opacity .4s;\n  }\n  .hint span{\n    font-family:var(--font-display);font-style:italic;font-weight:600;font-size:16px;\n    color:var(--coral-d);transform:rotate(-4deg);white-space:nowrap;\n  }\n  @keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(7px)}}\n  body.has-dragged .hint{opacity:0}\n  @media(max-width:900px){.hint{display:none}}\n\n  /* ---------- marquee ---------- */\n  .marquee{\n    background:var(--coral);border-top:2px solid var(--ink);border-bottom:2px solid var(--ink);\n    transform:rotate(-1.1deg) scale(1.02);\n    overflow:hidden;padding:13px 0;margin:10px 0 30px;\n  }\n  .marquee-track{display:flex;width:max-content;animation:scroll 26s linear infinite}\n  .marquee-group{display:flex;align-items:center;gap:34px;padding-right:34px}\n  .marquee-group span{\n    font-family:var(--font-display);font-weight:900;font-size:19px;color:var(--cream);\n    white-space:nowrap;letter-spacing:.01em;\n  }\n  @keyframes scroll{to{transform:translateX(-50%)}}\n\n  /* ---------- features ---------- */\n  .features{padding:70px 0 40px}\n  .features-head{max-width:640px;margin-bottom:64px}\n  .kicker{\n    font-size:13px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;\n    color:var(--teal-d);margin-bottom:14px;display:flex;align-items:center;gap:10px;\n  }\n  .kicker::before{content:\"\";width:34px;height:3px;background:var(--coral);border-radius:2px}\n  .features-head h2{font-size:clamp(1.9rem,3.6vw,2.8rem);font-weight:900}\n  .feature{\n    display:flex;align-items:center;gap:70px;\n    padding:44px 0;\n  }\n  .feature + .feature{border-top:2px dashed rgba(23,59,54,.18)}\n  .feature.flip{flex-direction:row-reverse}\n  .f-text{flex:1 1 0;min-width:0}\n  .f-num{\n    font-family:var(--font-display);font-weight:900;font-size:64px;color:transparent;\n    -webkit-text-stroke:2px var(--coral);line-height:1;display:block;margin-bottom:10px;\n  }\n  .feature:nth-child(odd) .f-num{-webkit-text-stroke-color:var(--teal)}\n  .f-text h3{font-size:clamp(1.4rem,2.4vw,1.9rem);font-weight:900;margin-bottom:14px}\n  .f-text p{color:var(--ink-soft);max-width:440px}\n  .f-visual{flex:1 1 0;min-width:0;display:flex;justify-content:center}\n  .tilt-l{transform:rotate(-1.6deg)}\n  .tilt-r{transform:rotate(1.4deg)}\n  .visual-card{\n    background:var(--paper);border:2px solid var(--ink);border-radius:var(--r-lg);\n    box-shadow:var(--shadow-pop);padding:22px;width:100%;max-width:380px;\n  }\n  .visual-head{font-weight:700;font-size:13px;letter-spacing:.06em;text-transform:uppercase;\n    display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}\n  .visual-head em{font-style:normal;color:var(--ink-soft);text-transform:none;letter-spacing:0;font-weight:600}\n  .wk-row{display:flex;align-items:center;gap:10px;margin-bottom:12px}\n  .wk-name{font-size:13px;font-weight:700;width:52px}\n  .wk-track{flex:1;display:flex;gap:5px}\n  .wk-cell{flex:1;height:26px;border:2px solid rgba(23,59,54,.18);border-radius:8px}\n  .wk-cell.b-teal{background:var(--teal-t);border-color:var(--ink)}\n  .wk-cell.b-coral{background:var(--coral-t);border-color:var(--ink)}\n  .wk-cell.b-amber{background:var(--amber-t);border-color:var(--ink)}\n  .wk-cell.b-pto{background:repeating-linear-gradient(45deg,var(--teal-t) 0 5px,var(--paper) 5px 10px);border-color:var(--ink)}\n  .badge-save{\n    display:inline-flex;align-items:center;gap:8px;margin-top:14px;\n    background:var(--teal);color:#fff;border:2px solid var(--ink);border-radius:999px;\n    padding:7px 15px;font-size:13px;font-weight:700;box-shadow:0 3px 0 var(--ink);\n  }\n  .cap-col{border:2px solid var(--ink);border-radius:var(--r-md);background:var(--amber-t);padding:14px;margin-bottom:14px}\n  .cap-col .col-head{padding:0 0 8px}\n  .cap-col .caps i{background:var(--amber)}\n  .cap-col .caps i:last-child{background:var(--paper)}\n  .stub{border:2px solid var(--ink);border-radius:10px;background:var(--paper);\n    padding:7px 11px;font-size:13px;font-weight:600;margin-bottom:8px;box-shadow:0 2px 0 var(--ink)}\n  .stub.moved{opacity:.45;text-decoration:line-through}\n  .suggest{\n    display:flex;gap:10px;align-items:flex-start;\n    background:var(--paper);border:2px solid var(--ink);border-radius:var(--r-md);\n    padding:12px 14px;box-shadow:0 3px 0 var(--ink);font-size:14px;font-weight:600;\n  }\n  .suggest svg{flex:none;margin-top:2px}\n  .ritual{display:flex;align-items:center;justify-content:space-between;gap:10px;\n    border:2px solid var(--ink);border-radius:999px;background:var(--teal-t);\n    padding:9px 16px;margin-bottom:10px;font-size:14px;font-weight:700;box-shadow:0 3px 0 var(--ink)}\n  .ritual:nth-child(3){background:var(--coral-t)}\n  .ritual:nth-child(4){background:var(--amber-t)}\n  .ritual-left{display:flex;align-items:center;gap:9px}\n  .switch{\n    width:40px;height:22px;border-radius:999px;border:2px solid var(--ink);\n    background:var(--paper);position:relative;cursor:pointer;transition:background .2s;flex:none;\n  }\n  .switch::after{\n    content:\"\";position:absolute;top:1px;left:2px;width:14px;height:14px;border-radius:50%;\n    background:var(--ink);transition:transform .2s;\n  }\n  .switch.on{background:var(--teal)}\n  .switch.on::after{transform:translateX(17px)}\n  @media(max-width:860px){\n    .feature,.feature.flip{flex-direction:column;gap:34px;align-items:flex-start}\n  }\n\n  /* ---------- quote ---------- */\n  .quote{padding:70px 0 90px;text-align:center}\n  .quote blockquote{\n    font-family:var(--font-display);font-style:italic;font-weight:600;\n    font-size:clamp(1.5rem,3vw,2.3rem);line-height:1.35;max-width:780px;margin:0 auto 28px;\n  }\n  .quote blockquote em{font-style:italic;color:var(--coral-d)}\n  .quote-by{display:flex;align-items:center;justify-content:center;gap:12px;font-weight:600}\n  .quote-by .avatar{width:38px;height:38px;font-size:13px;margin:0}\n  .quote-by small{color:var(--ink-soft);font-weight:500}\n\n  /* ---------- CTA ---------- */\n  .cta{background:var(--coral);position:relative;padding:30px 0 96px;text-align:center}\n  .cta-wave{position:absolute;top:-2px;left:0;width:100%;transform:translateY(-99%)}\n  .cta h2{color:#fff;font-size:clamp(2rem,4.4vw,3.2rem);font-weight:900;\n    text-shadow:3px 3px 0 var(--ink);margin-bottom:14px}\n  .cta p{color:#FFE9E4;font-weight:500;font-size:18px;margin-bottom:32px}\n  .cta-form{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}\n  .cta-form input{\n    font-family:var(--font-body);font-size:16px;font-weight:500;\n    border:2px solid var(--ink);border-radius:999px;padding:14px 24px;\n    width:min(340px,90vw);background:var(--paper);color:var(--ink);\n  }\n  .cta-form input::placeholder{color:var(--ink-soft)}\n  .cta-form input:focus-visible{outline:3px solid var(--ink);outline-offset:2px}\n  .cta-success{\n    display:none;font-family:var(--font-display);font-style:italic;font-weight:600;\n    font-size:22px;color:#fff;background:var(--ink);border-radius:999px;\n    padding:16px 34px;width:max-content;max-width:90vw;margin:0 auto;\n  }\n\n  /* ---------- footer ---------- */\n  footer{background:var(--ink);color:var(--cream);padding:52px 0 40px}\n  .foot-inner{display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap}\n  .foot-links{display:flex;gap:26px;list-style:none}\n  .foot-links a{color:var(--cream);opacity:.75;text-decoration:none;font-weight:500;font-size:14px}\n  .foot-links a:hover{opacity:1;color:var(--amber)}\n  .foot-note{width:100%;margin-top:26px;padding-top:22px;border-top:1px solid rgba(250,243,231,.18);\n    font-size:13px;opacity:.6}\n\n  /* ---------- toast & confetti ---------- */\n  .toast{\n    position:fixed;left:50%;bottom:28px;z-index:1000;\n    transform:translate(-50%,140%);\n    display:flex;align-items:center;gap:12px;\n    background:var(--ink);color:var(--cream);\n    border-radius:999px;padding:14px 26px;font-weight:600;font-size:15px;\n    box-shadow:0 10px 30px rgba(23,59,54,.35);\n    transition:transform .4s cubic-bezier(.3,1.4,.5,1);\n    max-width:92vw;\n  }\n  .toast.show{transform:translate(-50%,0)}\n  .confetti{position:fixed;z-index:1001;pointer-events:none;border:1.5px solid var(--ink);\n    animation:fall 1.4s cubic-bezier(.25,.6,.6,1) forwards}\n  @keyframes fall{to{transform:translate(var(--dx),95vh) rotate(var(--rot));opacity:0}}\n\n  @media(prefers-reduced-motion:reduce){\n    *,*::before,*::after{animation-duration:.01ms !important;transition-duration:.01ms !important}\n    .marquee-track{animation:none}\n  }\n</style>\n</head>\n<body>\n\n<!-- ============ NAV ============ -->\n<nav>\n  <div class=\"wrap nav-inner\">\n    <a class=\"logo\" href=\"#\">\n      <svg width=\"34\" height=\"34\" viewBox=\"0 0 34 34\" aria-hidden=\"true\">\n        <circle cx=\"17\" cy=\"17\" r=\"16\" fill=\"#12897C\" stroke=\"#173B36\" stroke-width=\"2\"/>\n        <path d=\"M6 20c3-4 6-4 9 0s6 4 9 0\" fill=\"none\" stroke=\"#FAF3E7\" stroke-width=\"2.6\" stroke-linecap=\"round\"/>\n        <path d=\"M8 13c2.5-3 5-3 7.5 0s5 3 7.5 0\" fill=\"none\" stroke=\"#FF6B57\" stroke-width=\"2.6\" stroke-linecap=\"round\"/>\n      </svg>\n      <span class=\"logo-word\">Tidepool</span>\n    </a>\n    <ul class=\"nav-links\">\n      <li class=\"hide-m\"><a href=\"#how\">How it works</a></li>\n      <li class=\"hide-m\"><a href=\"#why\">Why teams switch</a></li>\n      <li><a class=\"btn btn-coral btn-sm\" href=\"#start\">Start free</a></li>\n    </ul>\n  </div>\n</nav>\n\n<!-- ============ HERO ============ -->\n<header class=\"hero\">\n  <div class=\"wrap\">\n    <div class=\"eyebrow rise\"><i></i>Weekly planning for teams of 2\u201312</div>\n    <h1 class=\"rise d1\">Plan the week <span class=\"hl\">together</span>. Then actually live it.</h1>\n    <p class=\"rise d2\">Tidepool turns Monday-morning chaos into one shared plan your whole team can see, drag, and stick to. The board below is real \u2014 go ahead and use it.</p>\n    <div class=\"hero-ctas rise d3\">\n      <a class=\"btn btn-coral\" href=\"#start\">Start your first tide</a>\n      <a class=\"btn btn-ghost\" href=\"#how\">See how it works</a>\n    </div>\n  </div>\n</header>\n\n<!-- ============ BOARD ============ -->\n<section class=\"board-zone\">\n  <div class=\"wrap\" style=\"position:relative\">\n    <div class=\"hint\" aria-hidden=\"true\">\n      <svg width=\"46\" height=\"40\" viewBox=\"0 0 46 40\" fill=\"none\">\n        <path d=\"M42 6C30 4 14 8 7 26\" stroke=\"#E4503C\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n        <path d=\"M2 18l5 9 10-4\" stroke=\"#E4503C\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" fill=\"none\"/>\n      </svg>\n      <span>go on \u2014 drag one</span>\n    </div>\n\n    <div class=\"board-toolbar\">\n      <div class=\"toolbar-label\"><i></i>This week is live \u2014 drag cards anywhere</div>\n      <div class=\"toolbar-btns\">\n        <button class=\"btn btn-ghost btn-sm\" id=\"shuffleBtn\" type=\"button\">\n          <svg width=\"15\" height=\"15\" viewBox=\"0 0 15 15\" fill=\"none\"><path d=\"M1 3h3l7 9h3M14 12l-2-2m2 2-2 2M1 12h3l2-2.6M14 3l-2-2m2 2-2 2m2-2h-3l-2.2 2.8\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          Shuffle week\n        </button>\n        <button class=\"btn btn-ghost btn-sm\" id=\"resetBtn\" type=\"button\">\n          <svg width=\"15\" height=\"15\" viewBox=\"0 0 15 15\" fill=\"none\"><path d=\"M2.5 7.5a5 5 0 1 1 1.5 3.6M2.5 7.5v-4m0 4h4\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          Reset\n        </button>\n      </div>\n    </div>\n\n    <div class=\"board\" id=\"board\" aria-label=\"Interactive week planner demo\">\n      <div class=\"col pool\">\n        <div class=\"col-head\">\n          <span class=\"col-title\">Idea pool</span>\n          <span class=\"count\" data-count>0</span>\n        </div>\n        <div class=\"cards\" data-col=\"pool\"></div>\n        <div class=\"pool-empty\" hidden>All planned \u2014 nice.</div>\n      </div>\n      <!-- day columns injected by JS -->\n    </div>\n  </div>\n</section>\n\n<!-- ============ MARQUEE ============ -->\n<div class=\"marquee\" aria-hidden=\"true\">\n  <div class=\"marquee-track\" id=\"marqueeTrack\"></div>\n</div>\n\n<!-- ============ FEATURES ============ -->\n<section class=\"features\" id=\"how\">\n  <div class=\"wrap\">\n    <div class=\"features-head\">\n      <div class=\"kicker\">How Tidepool works</div>\n      <h2>A planning ritual that takes ten minutes, not a meeting that takes an hour.</h2>\n    </div>\n\n    <div class=\"feature\">\n      <div class=\"f-text\">\n        <span class=\"f-num\">01</span>\n        <h3>One board, zero status meetings</h3>\n        <p>Everyone drags their week into the same view. No \u201cquick syncs\u201d to find out what people are doing \u2014 you can just look. You just did it yourself up there.</p>\n      </div>\n      <div class=\"f-visual tilt-l\">\n        <div class=\"visual-card\">\n          <div class=\"visual-head\">Week of May 12 <em>4 teammates</em></div>\n          <div class=\"wk-row\"><span class=\"wk-name\">Maya</span><div class=\"wk-track\"><i class=\"wk-cell b-teal\"></i><i class=\"wk-cell b-teal\"></i><i class=\"wk-cell b-coral\"></i><i class=\"wk-cell\"></i><i class=\"wk-cell b-teal\"></i></div></div>\n          <div class=\"wk-row\"><span class=\"wk-name\">Jonas</span><div class=\"wk-track\"><i class=\"wk-cell b-amber\"></i><i class=\"wk-cell b-coral\"></i><i class=\"wk-cell b-coral\"></i><i class=\"wk-cell b-teal\"></i><i class=\"wk-cell b-amber\"></i></div></div>\n          <div class=\"wk-row\"><span class=\"wk-name\">Sam</span><div class=\"wk-track\"><i class=\"wk-cell\"></i><i class=\"wk-cell b-teal\"></i><i class=\"wk-cell b-teal\"></i><i class=\"wk-cell b-pto\"></i><i class=\"wk-cell b-pto\"></i></div></div>\n          <div class=\"wk-row\"><span class=\"wk-name\">Noor</span><div class=\"wk-track\"><i class=\"wk-cell b-coral\"></i><i class=\"wk-cell b-amber\"></i><i class=\"wk-cell\"></i><i class=\"wk-cell b-coral\"></i><i class=\"wk-cell b-teal\"></i></div></div>\n          <div class=\"badge-save\">\n            <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\"><path d=\"M2 7.5 5.5 11 12 3.5\" stroke=\"#fff\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            3h 40m of meetings skipped this week\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"feature flip\" id=\"why\">\n      <div class=\"f-text\">\n        <span class=\"f-num\">02</span>\n        <h3>Capacity you can actually see</h3>\n        <p>Every day has a visible capacity. Overbook someone and the day turns amber before the week turns miserable \u2014 with a friendly suggestion to move things around.</p>\n      </div>\n      <div class=\"f-visual tilt-r\">\n        <div class=\"visual-card\">\n          <div class=\"visual-head\">Tuesday <em style=\"color:#E4503C\">over capacity</em></div>\n          <div class=\"cap-col\">\n            <div class=\"col-head\">\n              <span class=\"col-title\" style=\"font-size:12px\">Tue \u00b7 5 of 4 slots</span>\n              <div class=\"caps\"><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i></div>\n            </div>\n            <div class=\"stub\">Focus: pricing page</div>\n            <div class=\"stub moved\">QA sweep</div>\n          </div>\n          <div class=\"suggest\">\n            <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M2 8h11m0 0-4-4m4 4-4 4\" stroke=\"#E4503C\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            Over by one. Move \u201cQA sweep\u201d to Wednesday? Jonas has room.\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"feature\">\n      <div class=\"f-text\">\n        <span class=\"f-num\">03</span>\n        <h3>Rituals that place themselves</h3>\n        <p>Standups, demos, retros \u2014 set them once and Tidepool drops them into every new week automatically. Your team\u2019s rhythm keeps beating, even when you\u2019re off.</p>\n      </div>\n      <div class=\"f-visual tilt-l\">\n        <div class=\"visual-card\">\n          <div class=\"visual-head\">Team rituals <em>repeats weekly</em></div>\n          <div class=\"ritual\">\n            <span class=\"ritual-left\">\n              <svg width=\"15\" height=\"15\" viewBox=\"0 0 15 15\" fill=\"none\"><path d=\"M2.5 7.5a5 5 0 1 1 1.5 3.6M2.5 7.5v-4m0 4h4\" stroke=\"#173B36\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n              Standup \u00b7 9:30\n            </span>\n            <span class=\"switch on\" role=\"switch\" aria-checked=\"true\" aria-label=\"Auto-place standup\" tabindex=\"0\"></span>\n          </div>\n          <div class=\"ritual\">\n            <span class=\"ritual-left\">\n              <svg width=\"15\" height=\"15\" viewBox=\"0 0 15 15\" fill=\"none\"><path d=\"M2.5 7.5a5 5 0 1 1 1.5 3.6M2.5 7.5v-4m0 4h4\" stroke=\"#173B36\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n              Demo Friday \u00b7 15:00\n            </span>\n            <span class=\"switch on\" role=\"switch\" aria-checked=\"true\" aria-label=\"Auto-place demo\" tabindex=\"0\"></span>\n          </div>\n          <div class=\"ritual\">\n            <span class=\"ritual-left\">\n              <svg width=\"15\" height=\"15\" viewBox=\"0 0 15 15\" fill=\"none\"><path d=\"M2.5 7.5a5 5 0 1 1 1.5 3.6M2.5 7.5v-4m0 4h4\" stroke=\"#173B36\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n              Retro \u00b7 Thu\n            </span>\n            <span class=\"switch\" role=\"switch\" aria-checked=\"false\" aria-label=\"Auto-place retro\" tabindex=\"0\"></span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ QUOTE ============ -->\n<section class=\"quote\">\n  <div class=\"wrap\">\n    <blockquote>\u201cWe killed our Monday planning meeting three weeks in. The plan just&nbsp;<em>exists</em> now \u2014 everyone dragged their week in over coffee.\u201d</blockquote>\n    <div class=\"quote-by\">\n      <span class=\"avatar a1\">PK</span>\n      <span>Priya K. <small>\u00b7 co-founder, Fieldnote Studio (6 people)</small></span>\n    </div>\n  </div>\n</section>\n\n<!-- ============ CTA ============ -->\n<section class=\"cta\" id=\"start\">\n  <svg class=\"cta-wave\" viewBox=\"0 0 1440 60\" preserveAspectRatio=\"none\" aria-hidden=\"true\" style=\"height:52px\">\n    <path d=\"M0,34 C220,66 460,2 720,26 C980,50 1220,8 1440,32 L1440,60 L0,60 Z\" fill=\"#FAF3E7\"/>\n  </svg>\n  <div class=\"wrap\">\n    <h2>Make Monday the easy part.</h2>\n    <p>Free for teams up to five. Your first tide takes about ten minutes.</p>\n    <form class=\"cta-form\" id=\"ctaForm\">\n      <input type=\"email\" id=\"ctaEmail\" placeholder=\"you@yourteam.com\" required aria-label=\"Work email\">\n      <button class=\"btn btn-ink\" type=\"submit\">Start free</button>\n    </form>\n    <div class=\"cta-success\" id=\"ctaSuccess\">You\u2019re in \u2014 check your inbox for the tide chart.</div>\n  </div>\n</section>\n\n<!-- ============ FOOTER ============ -->\n<footer>\n  <div class=\"wrap foot-inner\">\n    <a class=\"logo\" href=\"#\" style=\"color:var(--cream)\">\n      <svg width=\"30\" height=\"30\" viewBox=\"0 0 34 34\" aria-hidden=\"true\">\n        <circle cx=\"17\" cy=\"17\" r=\"16\" fill=\"#FF6B57\" stroke=\"#FAF3E7\" stroke-width=\"2\"/>\n        <path d=\"M6 20c3-4 6-4 9 0s6 4 9 0\" fill=\"none\" stroke=\"#FAF3E7\" stroke-width=\"2.6\" stroke-linecap=\"round\"/>\n      </svg>\n      <span class=\"logo-word\">Tidepool</span>\n    </a>\n    <ul class=\"foot-links\">\n      <li><a href=\"#how\">How it works</a></li>\n      <li><a href=\"#why\">Why teams switch</a></li>\n      <li><a href=\"#start\">Start free</a></li>\n    </ul>\n    <div class=\"foot-note\">\u00a9 2025 Tidepool \u00b7 Built for small teams with big weeks \u00b7 No card required, ever</div>\n  </div>\n</footer>\n\n<!-- ============ TOAST ============ -->\n<div class=\"toast\" id=\"toast\" role=\"status\" aria-live=\"polite\">\n  <svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\">\n    <circle cx=\"10\" cy=\"10\" r=\"9\" fill=\"#FFC24B\" stroke=\"#FAF3E7\" stroke-width=\"1.5\"/>\n    <path d=\"M6 10.5 8.8 13 14 7\" stroke=\"#173B36\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n  </svg>\n  <span id=\"toastMsg\">Week\u2019s planned. Go take Friday afternoon off.</span>\n</div>\n\n<script>\n/* ================================================================\n   Tidepool interactive board\n   ================================================================ */\nconst DAYS = [\"Mon\",\"Tue\",\"Wed\",\"Thu\",\"Fri\"];\nconst DATES = [\"12\",\"13\",\"14\",\"15\",\"16\"];\nconst CAP = 4;\nconst TODAY = 1; // Tuesday\n\nconst PEOPLE = {M:[\"M\",0],J:[\"J\",1],S:[\"S\",3],N:[\"N\",2]};\n\n/* title, type(focus/team/ritual), time, people[], start column (null = pool) */\nconst CARD_DATA = [\n  {t:\"Week kick-off\",        ty:\"ritual\", tm:\"9:30\",  p:[\"M\",\"J\",\"S\",\"N\"], col:0},\n  {t:\"Focus: pricing page\",  ty:\"focus\",  tm:\"2h\",    p:[\"M\"],             col:0},\n  {t:\"Design review\",        ty:\"team\",   tm:\"11:00\", p:[\"M\",\"J\"],         col:1},\n  {t:\"1:1 \u00b7 Maya \u00d7 Noor\",    ty:\"ritual\", tm:\"14:00\", p:[\"M\",\"N\"],         col:1},\n  {t:\"Pair on onboarding\",   ty:\"team\",   tm:\"10:00\", p:[\"J\",\"S\"],         col:3},\n  {t:\"Demo Friday\",          ty:\"ritual\", tm:\"15:00\", p:[\"M\",\"J\",\"S\",\"N\"], col:4},\n  {t:\"Sketch onboarding flow\",ty:\"focus\", tm:\"2h\",    p:[\"N\"],             col:null},\n  {t:\"User interviews \u00d73\",   ty:\"team\",   tm:\"3h\",    p:[\"J\"],             col:null},\n  {t:\"Draft changelog\",      ty:\"focus\",  tm:\"1h\",    p:[\"S\"],             col:null},\n  {t:\"Bug bash: payments\",   ty:\"focus\",  tm:\"90m\",   p:[\"S\",\"N\"],         col:null},\n  {t:\"Prep retro board\",     ty:\"ritual\", tm:\"30m\",   p:[\"M\"],             col:null},\n  {t:\"Write the announcement\",ty:\"focus\", tm:\"1h\",    p:[\"M\"],             col:null},\n];\n\nconst board = document.getElementById(\"board\");\nconst poolCol = board.querySelector(\".col.pool\");\nconst poolCards = poolCol.querySelector(\".cards\");\nconst poolEmpty = poolCol.querySelector(\".pool-empty\");\nlet cardLists = [poolCards];\n\n/* ---- build day columns ---- */\nDAYS.forEach((d,i)=>{\n  const col = document.createElement(\"div\");\n  col.className = \"col day\";\n  col.innerHTML = `\n    <div class=\"col-head\">\n      <span class=\"col-title\">${d} ${DATES[i]}</span>\n      ${i===TODAY ? '<span class=\"today-chip\">Today</span>' : \"\"}\n      <span class=\"count\" data-count>0</span>\n    </div>\n    <div class=\"caps\">${'<i></i>'.repeat(CAP)}</div>\n    <div class=\"cards\" data-col=\"${i}\"></div>`;\n  board.appendChild(col);\n  cardLists.push(col.querySelector(\".cards\"));\n});\n\n/* ---- render cards ---- */\nconst AVA = [\"a0\",\"a1\",\"a2\",\"a3\"];\nconst TAG_LABEL = {focus:\"Deep work\", team:\"Team\", ritual:\"Ritual\"};\nconst TYPE_CLASS = {focus:\"t-focus\", team:\"t-team\", ritual:\"t-ritual\"};\n\nfunction makeCard(data){\n  const c = document.createElement(\"div\");\n  c.className = `card ${TYPE_CLASS[data.ty]}`;\n  c.tabIndex = 0;\n  c.dataset.ty = data.ty;\n  c.innerHTML = `\n    <div class=\"card-top\"><span class=\"tag ${data.ty}\">${TAG_LABEL[data.ty]}</span><span class=\"card-time\">${data.tm}</span></div>\n    <div class=\"card-title\">${data.t}</div>\n    <div class=\"card-foot\">\n      <div class=\"avatars\">${data.p.map((k,i)=>`<span class=\"avatar ${AVA[PEOPLE[k][1]]}\">${PEOPLE[k][0]}</span>`).join(\"\")}</div>\n      ${data.p.length>=4 ? '<span class=\"everyone\">everyone</span>' : \"\"}\n    </div>`;\n  return c;\n}\n\nfunction layoutAll(animate=false){\n  const byCol = [...cardLists.map(()=>[])];\n  CARD_DATA.forEach((d,i)=>byCol[d.col===null?0:d.col+1].push(i));\n  cardLists.forEach((list,ci)=>{\n    list.innerHTML=\"\";\n    byCol[ci].forEach((idx,k)=>{\n      const el = makeCard(CARD_DATA[idx]);\n      el.dataset.idx = idx;\n      if(animate){el.style.animation=`rise .45s ${k*0.035}s cubic-bezier(.2,.8,.3,1) both`;}\n      list.appendChild(el);\n    });\n  });\n  update();\n}\nlayoutAll();\n\n/* ---- counts & capacity ---- */\nlet celebrated = false;\nfunction update(){\n  cardLists.forEach((list,ci)=>{\n    const col = list.closest(\".col\");\n    const n = list.querySelectorAll(\".card\").length;\n    col.querySelector(\"[data-count]\").textContent = n;\n    if(ci>0){\n      col.classList.toggle(\"over\", n>CAP);\n      col.querySelectorAll(\".caps i\").forEach((dot,i)=>dot.classList.toggle(\"on\", i<Math.min(n,CAP)));\n    }\n  });\n  const poolN = poolCards.querySelectorAll(\".card\").length;\n  poolEmpty.hidden = poolN>0;\n  if(poolN===0 && !celebrated){celebrated=true; celebrate();}\n  if(poolN>0) celebrated=false;\n}\n\n/* ---- toast ---- */\nconst toast = document.getElementById(\"toast\");\nlet toastTimer;\nfunction showToast(msg){\n  document.getElementById(\"toastMsg\").textContent = msg;\n  toast.classList.add(\"show\");\n  clearTimeout(toastTimer);\n  toastTimer = setTimeout(()=>toast.classList.remove(\"show\"), 3400);\n}\n\n/* ---- confetti ---- */\nconst CONFETTI_COLORS = [\"#FF6B57\",\"#12897C\",\"#FFC24B\",\"#173B36\",\"#FFE4DD\"];\nfunction celebrate(){\n  const r = board.getBoundingClientRect();\n  for(let i=0;i<38;i++){\n    const p = document.createElement(\"div\");\n    p.className = \"confetti\";\n    const round = Math.random()>.5;\n    const w = 7+Math.random()*7;\n    p.style.cssText = `\n      left:${r.left + r.width*(0.15+Math.random()*0.7)}px; top:${r.top+20}px;\n      width:${w}px; height:${round?w:w*1.5}px; border-radius:${round?\"50%\":\"3px\"};\n      background:${CONFETTI_COLORS[i%CONFETTI_COLORS.length]};\n      --dx:${(Math.random()*260-130).toFixed(0)}px; --rot:${(Math.random()*720-360).toFixed(0)}deg;\n      animation-delay:${Math.random()*0.15}s;`;\n    document.body.appendChild(p);\n    setTimeout(()=>p.remove(),1700);\n  }\n  showToast(\"Week\u2019s planned. Go take Friday afternoon off.\");\n}\n\n/* ---- drag & drop (pointer events, works on touch) ---- */\nlet dragEl=null, clone=null, offX=0, offY=0;\n\nfunction positionClone(e){\n  clone.style.left = (e.clientX-offX)+\"px\";\n  clone.style.top  = (e.clientY-offY)+\"px\";\n}\n\nfunction onMove(e){\n  if(!dragEl) return;\n  positionClone(e);\n  const x=e.clientX, y=e.clientY;\n  let target=null;\n  for(const list of cardLists){\n    const r=list.getBoundingClientRect();\n    if(x>=r.left-10 && x<=r.right+10 && y>=r.top-10 && y<=r.bottom+10){target=list;break;}\n  }\n  cardLists.forEach(l=>l.classList.toggle(\"drag-over\", l===target));\n  if(target){\n    const siblings=[...target.querySelectorAll(\".card\")].filter(el=>el!==dragEl);\n    let ref=null;\n    for(const s of siblings){\n      const r=s.getBoundingClientRect();\n      if(y < r.top + r.height/2){ref=s;break;}\n    }\n    ref ? target.insertBefore(dragEl,ref) : target.appendChild(dragEl);\n  }\n}\n\nfunction onUp(){\n  if(!dragEl) return;\n  cardLists.forEach(l=>l.classList.remove(\"drag-over\"));\n  clone.remove(); clone=null;\n  dragEl.classList.remove(\"dragging\");\n  dragEl.classList.add(\"settle\");\n  dragEl.addEventListener(\"animationend\",()=>dragEl && dragEl.classList.remove(\"settle\"),{once:true});\n  dragEl=null;\n  update();\n}\n\ndocument.addEventListener(\"pointerdown\", e=>{\n  const card = e.target.closest(\".card\");\n  if(!card || !board.contains(card)) return;\n  if(e.button!==undefined && e.button!==0) return;\n  document.body.classList.add(\"has-dragged\");\n  dragEl = card;\n  const r = card.getBoundingClientRect();\n  offX = e.clientX - r.left; offY = e.clientY - r.top;\n  clone = card.cloneNode(true);\n  clone.classList.add(\"lift\");\n  clone.style.width = r.width+\"px\";\n  clone.style.left = r.left+\"px\"; clone.style.top = r.top+\"px\";\n  document.body.appendChild(clone);\n  card.classList.add(\"dragging\");\n  window.addEventListener(\"pointermove\", onMove);\n  window.addEventListener(\"pointerup\", onUp, {once:true});\n  window.addEventListener(\"pointercancel\", onUp, {once:true});\n  e.preventDefault();\n});\n\n/* ---- keyboard: arrows move cards (a11y bonus) ---- */\ndocument.addEventListener(\"keydown\", e=>{\n  const card = e.target.closest(\".card\");\n  if(!card || !board.contains(card)) return;\n  const list = card.parentElement;\n  const ci = cardLists.indexOf(list);\n  let handled = true;\n  if(e.key===\"ArrowRight\" && ci<cardLists.length-1){\n    cardLists[ci+1].appendChild(card);\n  } else if(e.key===\"ArrowLeft\" && ci>0){\n    cardLists[ci-1].appendChild(card);\n  } else if(e.key===\"ArrowDown\" && card.nextElementSibling){\n    list.insertBefore(card.nextElementSibling, card);\n  } else if(e.key===\"ArrowUp\" && card.previousElementSibling){\n    list.insertBefore(card, card.previousElementSibling);\n  } else handled=false;\n  if(handled){\n    e.preventDefault();\n    card.classList.add(\"settle\");\n    card.addEventListener(\"animationend\",()=>card.classList.remove(\"settle\"),{once:true});\n    card.focus(); update();\n  }\n});\n\n/* ---- shuffle & reset ---- */\nfunction collectAll(){\n  const cards=[...board.querySelectorAll(\".card\")];\n  return cards.map(c=>CARD_DATA[+c.dataset.idx]);\n}\ndocument.getElementById(\"shuffleBtn\").addEventListener(\"click\", ()=>{\n  document.body.classList.add(\"has-dragged\");\n  const all = collectAll();\n  for(let i=all.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[all[i],all[j]]=[all[j],all[i]];}\n  all.forEach(c=>c.col = Math.floor(Math.random()*DAYS.length));\n  layoutAll(true);\n  showToast(\"Shuffled. Maybe a little chaotic \u2014 that\u2019s what editing is for.\");\n});\ndocument.getElementById(\"resetBtn\").addEventListener(\"click\", ()=>{\n  document.body.classList.add(\"has-dragged\");\n  collectAll().forEach(c=>c.col=null);\n  layoutAll(true);\n  showToast(\"Back to the pool. Plan it your way.\");\n});\n\n/* ---- ritual toggles ---- */\ndocument.querySelectorAll(\".switch\").forEach(sw=>{\n  const flip=()=>{sw.classList.toggle(\"on\");sw.setAttribute(\"aria-checked\",sw.classList.contains(\"on\"));};\n  sw.addEventListener(\"click\",flip);\n  sw.addEventListener(\"keydown\",e=>{if(e.key===\" \"||e.key===\"Enter\"){e.preventDefault();flip();}});\n});\n\n/* ---- marquee (generated, so the loop stays seamless) ---- */\nconst PHRASES=[\"plan together\",\"no more Sunday-night scramble\",\"make Monday the easy part\",\"Fridays should feel like Fridays\",\"one board, zero status meetings\",\"less meetings, more momentum\"];\nconst wave = `<svg width=\"16\" height=\"10\" viewBox=\"0 0 16 10\" fill=\"none\"><path d=\"M1 5c2.3-3.5 4.7-3.5 7 0s4.7 3.5 7 0\" stroke=\"#FAF3E7\" stroke-width=\"2.2\" stroke-linecap=\"round\"/></svg>`;\nconst groupHTML = PHRASES.map(p=>`<span>${p}</span>${wave}`).join(\"\");\ndocument.getElementById(\"marqueeTrack\").innerHTML =\n  `<div class=\"marquee-group\">${groupHTML}</div><div class=\"marquee-group\">${groupHTML}</div>`;\n\n/* ---- CTA form ---- */\ndocument.getElementById(\"ctaForm\").addEventListener(\"submit\", e=>{\n  e.preventDefault();\n  const email = document.getElementById(\"ctaEmail\").value.trim();\n  if(!email) return;\n  e.target.style.display=\"none\";\n  document.getElementById(\"ctaSuccess\").style.display=\"block\";\n});\n</script>\n</body>\n</html>\n"}