{"arm": "direct", "model": "anthropic/claude-haiku-5.5", "i": 5, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Tidepool: Plan your week together</title>\n<meta name=\"description\" content=\"Tidepool helps small teams plan their week together in fifteen minutes on Monday, then stay in sync all week.\">\n<style>\n  :root {\n    --deep: #0b3440;\n    --ocean: #135e6b;\n    --teal: #1f8a86;\n    --foam: #f6f3ec;\n    --paper: #ffffff;\n    --sand: #ece2cf;\n    --sand-deep: #d9c7a3;\n    --coral: #ff7a59;\n    --coral-deep: #e8613f;\n    --ink: #13242b;\n    --muted: #5b6f75;\n    --line: rgba(11, 52, 64, 0.12);\n    --radius: 16px;\n    --shadow: 0 1px 2px rgba(11,52,64,.06), 0 12px 32px -12px rgba(11,52,64,.22);\n    --serif: Georgia, \"Iowan Old Style\", \"Palatino Linotype\", Palatino, serif;\n    --sans: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n  }\n\n  *, *::before, *::after { box-sizing: border-box; }\n  html { scroll-behavior: smooth; }\n  body {\n    margin: 0;\n    font-family: var(--sans);\n    color: var(--ink);\n    background: var(--foam);\n    line-height: 1.6;\n    -webkit-font-smoothing: antialiased;\n  }\n  img, svg { display: block; max-width: 100%; }\n  a { color: inherit; }\n  h1, h2, h3 { line-height: 1.12; margin: 0; font-weight: 700; letter-spacing: -0.01em; }\n  p { margin: 0; }\n\n  .container { width: min(1140px, 92%); margin: 0 auto; }\n\n  /* ---------- Buttons ---------- */\n  .btn {\n    display: inline-flex; align-items: center; justify-content: center; gap: .5rem;\n    padding: .85rem 1.35rem; border-radius: 999px; font-weight: 600; font-size: 1rem;\n    text-decoration: none; border: 1.5px solid transparent; cursor: pointer;\n    transition: transform .15s ease, background .15s ease, box-shadow .15s ease;\n    white-space: nowrap;\n  }\n  .btn:hover { transform: translateY(-1px); }\n  .btn:focus-visible, a:focus-visible, summary:focus-visible { outline: 3px solid var(--teal); outline-offset: 3px; }\n  .btn-primary { background: var(--coral); color: #fff; box-shadow: 0 8px 20px -8px rgba(255,122,89,.8); }\n  .btn-primary:hover { background: var(--coral-deep); }\n  .btn-ghost { background: transparent; color: var(--deep); border-color: var(--line); }\n  .btn-ghost:hover { border-color: var(--deep); }\n  .btn-light { background: var(--paper); color: var(--deep); }\n  .btn-light:hover { background: var(--sand); }\n  .btn-sm { padding: .55rem 1rem; font-size: .92rem; }\n\n  /* ---------- Header ---------- */\n  header.site {\n    position: sticky; top: 0; z-index: 50;\n    background: rgba(246,243,236,.85);\n    backdrop-filter: saturate(1.4) blur(10px);\n    border-bottom: 1px solid transparent;\n  }\n  header.site.scrolled { border-bottom-color: var(--line); }\n  .nav { display: flex; align-items: center; justify-content: space-between; height: 72px; }\n  .brand { display: flex; align-items: center; gap: .6rem; text-decoration: none; font-weight: 700; font-size: 1.2rem; color: var(--deep); }\n  .nav-links { display: flex; gap: 2rem; align-items: center; }\n  .nav-links a { text-decoration: none; color: var(--muted); font-weight: 500; font-size: .95rem; }\n  .nav-links a:hover { color: var(--deep); }\n  .nav-cta { display: flex; gap: .75rem; align-items: center; }\n\n  /* ---------- Hero ---------- */\n  .hero {\n    position: relative; overflow: hidden;\n    padding: 72px 0 96px;\n    background:\n      radial-gradient(900px 500px at 85% -10%, rgba(31,138,134,.18), transparent 60%),\n      radial-gradient(700px 400px at -10% 110%, rgba(255,122,89,.14), transparent 60%),\n      var(--foam);\n  }\n  .hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 64px; align-items: center; }\n  .eyebrow {\n    display: inline-flex; align-items: center; gap: .5rem;\n    padding: .35rem .8rem; border-radius: 999px;\n    background: var(--paper); border: 1px solid var(--line);\n    font-size: .85rem; font-weight: 600; color: var(--ocean);\n  }\n  .eyebrow .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--teal); box-shadow: 0 0 0 4px rgba(31,138,134,.18); }\n  .hero h1 {\n    font-family: var(--serif); font-weight: 400;\n    font-size: clamp(2.6rem, 5.2vw, 4.1rem);\n    color: var(--deep); margin: 22px 0 20px;\n    letter-spacing: -0.02em;\n  }\n  .hero h1 em { font-style: italic; color: var(--coral-deep); }\n  .lede { font-size: 1.2rem; color: var(--muted); max-width: 34rem; }\n  .hero-actions { display: flex; flex-wrap: wrap; gap: .9rem; margin-top: 32px; }\n  .hero-note { margin-top: 18px; font-size: .9rem; color: var(--muted); display: flex; gap: .5rem; align-items: center; }\n  .check { width: 16px; height: 16px; flex: none; color: var(--teal); }\n\n  /* Product mockup */\n  .mock-wrap { position: relative; }\n  .mock {\n    background: var(--paper); border-radius: 20px; box-shadow: var(--shadow);\n    border: 1px solid var(--line); overflow: hidden;\n    transform: rotate(-1deg);\n  }\n  .mock-bar {\n    display: flex; align-items: center; justify-content: space-between;\n    padding: 14px 18px; border-bottom: 1px solid var(--line); background: #fbfaf6;\n  }\n  .mock-title { font-weight: 700; color: var(--deep); font-size: .95rem; }\n  .mock-title small { display: block; font-weight: 500; color: var(--muted); font-size: .78rem; }\n  .avatars { display: flex; }\n  .avatar {\n    width: 30px; height: 30px; border-radius: 50%; border: 2px solid #fff;\n    display: grid; place-items: center; font-size: .7rem; font-weight: 700; color: #fff;\n    margin-left: -8px;\n  }\n  .avatars .avatar:first-child { margin-left: 0; }\n  .mock-days { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; padding: 16px; }\n  .day { background: #f7f5ef; border-radius: 12px; padding: 10px; min-height: 260px; }\n  .day-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 10px; }\n  .day-head b { font-size: .8rem; color: var(--deep); }\n  .day-head span { font-size: .72rem; color: var(--muted); }\n  .day.today { background: #e6f2f1; outline: 2px solid var(--teal); outline-offset: -2px; }\n  .card-task {\n    background: #fff; border-radius: 10px; padding: 9px 10px; margin-bottom: 8px;\n    font-size: .76rem; color: var(--ink); box-shadow: 0 1px 2px rgba(0,0,0,.05);\n    border-left: 3px solid var(--teal);\n  }\n  .card-task.c { border-left-color: var(--coral); }\n  .card-task.s { border-left-color: #e0b44c; }\n  .card-task.d { border-left-color: #7b6fc4; }\n  .card-task .meta { display: flex; justify-content: space-between; align-items: center; margin-top: 6px; color: var(--muted); font-size: .68rem; }\n  .capacity { height: 5px; background: #e4e0d4; border-radius: 99px; overflow: hidden; margin-top: 8px; }\n  .capacity i { display: block; height: 100%; background: var(--teal); border-radius: 99px; }\n  .capacity.over i { background: var(--coral); }\n  .mock-foot {\n    display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;\n    padding: 14px 18px; background: #fbfaf6; border-top: 1px solid var(--line); font-size: .82rem; color: var(--muted);\n  }\n  .pill { padding: .25rem .6rem; border-radius: 999px; background: var(--sand); color: var(--deep); font-weight: 600; font-size: .75rem; }\n  .float-card {\n    position: absolute; right: -18px; bottom: -26px;\n    background: var(--deep); color: #fff; border-radius: 16px; padding: 14px 16px;\n    box-shadow: var(--shadow); font-size: .85rem; max-width: 230px;\n  }\n  .float-card b { display: block; font-size: 1.4rem; font-family: var(--serif); font-weight: 400; color: #ffd3c6; }\n  .float-card span { color: #cfe3e4; }\n\n  /* ---------- Trust strip ---------- */\n  .stats {\n    border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);\n    background: var(--paper);\n  }\n  .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); }\n  .stat { padding: 28px 20px; text-align: center; border-left: 1px solid var(--line); }\n  .stat:first-child { border-left: 0; }\n  .stat strong { display: block; font-family: var(--serif); font-weight: 400; font-size: 2rem; color: var(--deep); }\n  .stat span { font-size: .9rem; color: var(--muted); }\n\n  /* ---------- Sections ---------- */\n  section { padding: 104px 0; }\n  .section-head { max-width: 640px; margin-bottom: 56px; }\n  .kicker { font-size: .8rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--teal); }\n  .section-head h2 { font-family: var(--serif); font-weight: 400; font-size: clamp(2rem, 3.6vw, 2.8rem); color: var(--deep); margin: 12px 0 16px; }\n  .section-head p { color: var(--muted); font-size: 1.1rem; }\n\n  /* Problem */\n  .problem { background: var(--deep); color: #dbe9ea; }\n  .problem .kicker { color: #7fd1cb; }\n  .problem .section-head h2 { color: #fff; }\n  .problem .section-head p { color: #a9c3c7; }\n  .problem-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }\n  .problem-card { background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1); border-radius: var(--radius); padding: 30px; }\n  .problem-card .num { font-family: var(--serif); font-size: 2.4rem; color: var(--coral); line-height: 1; }\n  .problem-card h3 { color: #fff; font-size: 1.15rem; margin: 16px 0 10px; }\n  .problem-card p { color: #a9c3c7; font-size: .97rem; }\n\n  /* Features */\n  .features-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }\n  .feature {\n    background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius);\n    padding: 34px; box-shadow: 0 1px 2px rgba(0,0,0,.03); transition: transform .2s ease, box-shadow .2s ease;\n  }\n  .feature:hover { transform: translateY(-3px); box-shadow: var(--shadow); }\n  .icon {\n    width: 48px; height: 48px; border-radius: 14px; display: grid; place-items: center;\n    background: var(--sand); color: var(--deep); margin-bottom: 22px;\n  }\n  .icon svg { width: 24px; height: 24px; }\n  .feature h3 { font-size: 1.3rem; color: var(--deep); margin-bottom: 10px; }\n  .feature p { color: var(--muted); }\n  .feature ul { margin: 18px 0 0; padding: 0; list-style: none; display: grid; gap: 8px; }\n  .feature li { display: flex; gap: .55rem; font-size: .95rem; color: var(--ink); }\n\n  /* How it works */\n  .how { background: var(--sand); }\n  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; position: relative; counter-reset: step; }\n  .step { position: relative; padding: 8px 0 0; }\n  .step-num {\n    width: 56px; height: 56px; border-radius: 50%; background: var(--deep); color: #fff;\n    display: grid; place-items: center; font-family: var(--serif); font-size: 1.5rem; margin-bottom: 22px;\n    box-shadow: 0 0 0 8px rgba(11,52,64,.08);\n  }\n  .step h3 { font-size: 1.3rem; color: var(--deep); margin-bottom: 10px; }\n  .step p { color: #4d5f64; }\n  .step .time { display: inline-block; margin-top: 16px; font-size: .82rem; font-weight: 600; color: var(--coral-deep); }\n\n  /* Testimonial */\n  .quote-wrap { background: var(--paper); }\n  .quote {\n    max-width: 860px; margin: 0 auto; text-align: center;\n  }\n  .quote blockquote {\n    margin: 0; font-family: var(--serif); font-size: clamp(1.45rem, 2.6vw, 2.0rem);\n    line-height: 1.35; color: var(--deep); font-style: italic;\n  }\n  .quote-by { margin-top: 28px; display: flex; justify-content: center; align-items: center; gap: 14px; text-align: left; }\n  .quote-by .avatar { width: 48px; height: 48px; font-size: .95rem; margin: 0; }\n  .quote-by b { display: block; color: var(--deep); }\n  .quote-by span { color: var(--muted); font-size: .93rem; }\n\n  /* Pricing */\n  .pricing-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; align-items: stretch; }\n  .plan { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); padding: 36px 30px; display: flex; flex-direction: column; }\n  .plan.featured { background: var(--deep); color: #e4f0f1; border-color: var(--deep); box-shadow: var(--shadow); transform: translateY(-10px); position: relative; }\n  .plan .badge {\n    position: absolute; top: -13px; left: 50%; transform: translateX(-50%);\n    background: var(--coral); color: #fff; font-size: .75rem; font-weight: 700; padding: .3rem .8rem; border-radius: 999px; white-space: nowrap;\n  }\n  .plan h3 { font-size: 1.25rem; color: var(--deep); }\n  .plan.featured h3 { color: #fff; }\n  .plan .desc { color: var(--muted); font-size: .95rem; margin-top: 6px; min-height: 2.8em; }\n  .plan.featured .desc { color: #a9c3c7; }\n  .price { margin: 22px 0 24px; display: flex; align-items: baseline; gap: 6px; }\n  .price strong { font-family: var(--serif); font-weight: 400; font-size: 3rem; color: var(--deep); line-height: 1; }\n  .plan.featured .price strong { color: #fff; }\n  .price span { color: var(--muted); font-size: .95rem; }\n  .plan.featured .price span { color: #a9c3c7; }\n  .plan ul { list-style: none; padding: 0; margin: 0 0 30px; display: grid; gap: 11px; flex: 1; }\n  .plan li { display: flex; gap: .6rem; font-size: .96rem; }\n  .plan.featured .check { color: #7fd1cb; }\n  .plan .btn { width: 100%; }\n  .plan.featured .btn-primary { background: var(--coral); }\n\n  /* FAQ */\n  .faq-wrap { display: grid; grid-template-columns: .8fr 1.2fr; gap: 64px; align-items: start; }\n  .faq-wrap .section-head { margin-bottom: 0; }\n  details {\n    background: var(--paper); border: 1px solid var(--line); border-radius: 14px;\n    padding: 20px 24px; margin-bottom: 12px;\n  }\n  details[open] { box-shadow: var(--shadow); }\n  summary {\n    cursor: pointer; list-style: none; font-weight: 600; color: var(--deep);\n    display: flex; justify-content: space-between; align-items: center; gap: 16px;\n  }\n  summary::-webkit-details-marker { display: none; }\n  summary::after {\n    content: \"+\"; font-size: 1.4rem; line-height: 1; color: var(--teal); transition: transform .2s ease;\n  }\n  details[open] summary::after { transform: rotate(45deg); }\n  details p { color: var(--muted); margin-top: 12px; font-size: .98rem; }\n\n  /* Final CTA */\n  .final {\n    padding: 0 0 104px;\n    background: var(--foam);\n  }\n  .final-box {\n    position: relative; overflow: hidden; border-radius: 28px; padding: 80px 48px; text-align: center;\n    background:\n      radial-gradient(600px 300px at 90% 0%, rgba(255,122,89,.35), transparent 60%),\n      radial-gradient(500px 300px at 0% 100%, rgba(127,209,203,.25), transparent 60%),\n      linear-gradient(135deg, var(--ocean), var(--deep));\n    color: #fff;\n  }\n  .final-box h2 { font-family: var(--serif); font-weight: 400; font-size: clamp(2.1rem, 4vw, 3.2rem); max-width: 18ch; margin: 0 auto 18px; }\n  .final-box p { color: #cfe3e4; font-size: 1.1rem; max-width: 36rem; margin: 0 auto 34px; }\n  .final-actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }\n  .final-box .btn-ghost { color: #fff; border-color: rgba(255,255,255,.35); }\n  .final-box .btn-ghost:hover { border-color: #fff; }\n\n  /* Footer */\n  footer { border-top: 1px solid var(--line); padding: 56px 0 40px; background: var(--paper); }\n  .foot-grid { display: grid; grid-template-columns: 2fr repeat(3, 1fr); gap: 40px; }\n  .foot-grid p { color: var(--muted); font-size: .95rem; margin-top: 14px; max-width: 22rem; }\n  .foot-grid h4 { margin: 0 0 14px; font-size: .85rem; text-transform: uppercase; letter-spacing: .1em; color: var(--deep); }\n  .foot-grid ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }\n  .foot-grid a { color: var(--muted); text-decoration: none; font-size: .95rem; }\n  .foot-grid a:hover { color: var(--deep); text-decoration: underline; }\n  .foot-bottom { margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; color: var(--muted); font-size: .88rem; }\n\n  /* ---------- Responsive ---------- */\n  @media (max-width: 1024px) {\n    .hero-grid { grid-template-columns: 1fr; gap: 56px; }\n    .lede { max-width: 40rem; }\n    .problem-grid, .steps { grid-template-columns: 1fr; }\n    .steps { gap: 40px; }\n    .pricing-grid { grid-template-columns: 1fr; max-width: 460px; margin: 0 auto; }\n    .plan.featured { transform: none; }\n    .faq-wrap { grid-template-columns: 1fr; gap: 40px; }\n    .foot-grid { grid-template-columns: 1fr 1fr; }\n    .foot-grid > div:first-child { grid-column: 1 / -1; }\n  }\n  @media (max-width: 860px) {\n    .nav-links { display: none; }\n    .features-grid { grid-template-columns: 1fr; }\n    .stats-grid { grid-template-columns: repeat(2, 1fr); }\n    .stat:nth-child(3) { border-left: 0; }\n    .stat:nth-child(n+3) { border-top: 1px solid var(--line); }\n    .mock { transform: none; }\n    .float-card { position: static; margin-top: 16px; max-width: none; }\n  }\n  @media (max-width: 640px) {\n    section { padding: 72px 0; }\n    .hero { padding: 48px 0 72px; }\n    .mock-days { grid-template-columns: 1fr; }\n    .day { min-height: 0; }\n    .day .card-task { display: none; }\n    .day:first-child .card-task, .day.today .card-task { display: block; }\n    .final-box { padding: 56px 24px; }\n    .foot-grid { grid-template-columns: 1fr; }\n    .nav-cta .btn-ghost { display: none; }\n    .stat { padding: 22px 12px; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    *, *::before, *::after { transition: none !important; scroll-behavior: auto !important; }\n  }\n</style>\n</head>\n<body>\n\n<header class=\"site\" id=\"top\">\n  <div class=\"container nav\">\n    <a href=\"#top\" class=\"brand\" aria-label=\"Tidepool home\">\n      <svg width=\"30\" height=\"30\" viewBox=\"0 0 32 32\" aria-hidden=\"true\">\n        <circle cx=\"16\" cy=\"16\" r=\"15\" fill=\"#0b3440\"/>\n        <path d=\"M6 17c3-3 5-3 7 0s4 3 7 0 4-3 6 0\" stroke=\"#7fd1cb\" stroke-width=\"2.4\" fill=\"none\" stroke-linecap=\"round\"/>\n        <path d=\"M6 22c3-3 5-3 7 0s4 3 7 0 4-3 6 0\" stroke=\"#ff7a59\" stroke-width=\"2.4\" fill=\"none\" stroke-linecap=\"round\" opacity=\".9\"/>\n        <circle cx=\"16\" cy=\"10\" r=\"2.6\" fill=\"#f6f3ec\"/>\n      </svg>\n      Tidepool\n    </a>\n    <nav class=\"nav-links\" aria-label=\"Primary\">\n      <a href=\"#features\">Features</a>\n      <a href=\"#how\">How it works</a>\n      <a href=\"#pricing\">Pricing</a>\n      <a href=\"#faq\">FAQ</a>\n    </nav>\n    <div class=\"nav-cta\">\n      <a href=\"#\" class=\"btn btn-ghost btn-sm\">Log in</a>\n      <a href=\"#signup\" class=\"btn btn-primary btn-sm\">Start free</a>\n    </div>\n  </div>\n</header>\n\n<main>\n\n  <!-- Hero -->\n  <section class=\"hero\" style=\"padding-bottom: 96px;\">\n    <div class=\"container hero-grid\">\n      <div>\n        <span class=\"eyebrow\"><span class=\"dot\"></span> Weekly planning for teams of 2 to 12</span>\n        <h1>Plan the week <em>together</em>, then let it flow.</h1>\n        <p class=\"lede\">Tidepool turns a scattered week into one shared plan. Your team spends fifteen minutes on Monday agreeing on priorities, sees what everyone can realistically take on, and stays in step all week without another status meeting.</p>\n        <div class=\"hero-actions\">\n          <a href=\"#signup\" class=\"btn btn-primary\">Start planning free</a>\n          <a href=\"#how\" class=\"btn btn-ghost\">See how it works</a>\n        </div>\n        <p class=\"hero-note\">\n          <svg class=\"check\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          Free for teams of up to five. No credit card required.\n        </p>\n      </div>\n\n      <div class=\"mock-wrap\" aria-label=\"Preview of the Tidepool weekly board\">\n        <div class=\"mock\">\n          <div class=\"mock-bar\">\n            <div class=\"mock-title\">Week of March 9<small>Product & Design \u00b7 5 people</small></div>\n            <div class=\"avatars\">\n              <div class=\"avatar\" style=\"background:#1f8a86\">AM</div>\n              <div class=\"avatar\" style=\"background:#ff7a59\">JK</div>\n              <div class=\"avatar\" style=\"background:#7b6fc4\">RO</div>\n              <div class=\"avatar\" style=\"background:#e0b44c; color:#13242b\">SL</div>\n            </div>\n          </div>\n          <div class=\"mock-days\">\n            <div class=\"day\">\n              <div class=\"day-head\"><b>Mon</b><span>9</span></div>\n              <div class=\"card-task\">Kickoff &amp; priorities<div class=\"meta\"><span>All</span><span>1h</span></div></div>\n              <div class=\"card-task c\">Pricing copy review<div class=\"meta\"><span>JK</span><span>2h</span></div></div>\n            </div>\n            <div class=\"day today\">\n              <div class=\"day-head\"><b>Tue</b><span>10 \u00b7 today</span></div>\n              <div class=\"card-task\">Onboarding flow v2<div class=\"meta\"><span>AM</span><span>4h</span></div></div>\n              <div class=\"card-task d\">Usability sessions<div class=\"meta\"><span>RO</span><span>3h</span></div></div>\n              <div class=\"capacity\"><i style=\"width:72%\"></i></div>\n            </div>\n            <div class=\"day\">\n              <div class=\"day-head\"><b>Wed</b><span>11</span></div>\n              <div class=\"card-task s\">Design review<div class=\"meta\"><span>SL</span><span>1h</span></div></div>\n              <div class=\"card-task\">Ship billing fix<div class=\"meta\"><span>AM</span><span>3h</span></div></div>\n              <div class=\"capacity over\"><i style=\"width:104%\"></i></div>\n            </div>\n            <div class=\"day\">\n              <div class=\"day-head\"><b>Thu</b><span>12</span></div>\n              <div class=\"card-task c\">Launch notes draft<div class=\"meta\"><span>JK</span><span>2h</span></div></div>\n              <div class=\"capacity\"><i style=\"width:40%\"></i></div>\n            </div>\n            <div class=\"day\">\n              <div class=\"day-head\"><b>Fri</b><span>13</span></div>\n              <div class=\"card-task\">Weekly retro<div class=\"meta\"><span>All</span><span>45m</span></div></div>\n              <div class=\"capacity\"><i style=\"width:22%\"></i></div>\n            </div>\n          </div>\n          <div class=\"mock-foot\">\n            <span><span class=\"pill\">Capacity check</span> &nbsp;Wed is overbooked by 1h</span>\n            <span>Committed 4 of 5 days</span>\n          </div>\n        </div>\n        <div class=\"float-card\" role=\"note\">\n          <b>14 min</b>\n          <span>average Monday planning session across Tidepool teams</span>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Stats -->\n  <div class=\"stats\">\n    <div class=\"container stats-grid\">\n      <div class=\"stat\"><strong>15 min</strong><span>to plan a full week</span></div>\n      <div class=\"stat\"><strong>0</strong><span>status meetings required</span></div>\n      <div class=\"stat\"><strong>2\u201312</strong><span>people per team, by design</span></div>\n      <div class=\"stat\"><strong>1 view</strong><span>for everyone's commitments</span></div>\n    </div>\n  </div>\n\n  <!-- Problem -->\n  <section class=\"problem\">\n    <div class=\"container\">\n      <div class=\"section-head\">\n        <div class=\"kicker\">The problem</div>\n        <h2>Small teams don't lack effort. They lack a shared picture of the week.</h2>\n        <p>Plans live in five places, priorities shift in hallway conversations, and nobody knows who is actually free until Thursday.</p>\n      </div>\n      <div class=\"problem-grid\">\n        <div class=\"problem-card\">\n          <div class=\"num\">01</div>\n          <h3>Plans scatter across tools</h3>\n          <p>Tasks in one app, decisions in chat, and the real priorities in someone's head. Nobody has the full week in one place.</p>\n        </div>\n        <div class=\"problem-card\">\n          <div class=\"num\">02</div>\n          <h3>Overload hides in plain sight</h3>\n          <p>Everyone says yes to reasonable requests. Only when Wednesday arrives does it become clear that three people are double-booked.</p>\n        </div>\n        <div class=\"problem-card\">\n          <div class=\"num\">03</div>\n          <h3>Status meetings eat the week</h3>\n          <p>Teams of six spend an hour a day catching each other up. Tidepool replaces the update with a view that is always current.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Features -->\n  <section id=\"features\">\n    <div class=\"container\">\n      <div class=\"section-head\">\n        <div class=\"kicker\">Features</div>\n        <h2>Everything a week needs. Nothing it doesn't.</h2>\n        <p>Tidepool is deliberately small. It does four things well and keeps the rest of your tools where they belong.</p>\n      </div>\n      <div class=\"features-grid\">\n        <article class=\"feature\">\n          <div class=\"icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"3\"/><path d=\"M3 9h18M8 4v4M16 4v4\"/></svg>\n          </div>\n          <h3>A shared week, on one board</h3>\n          <p>Every commitment lands on a day, with an owner and an estimate. The whole team sees the same board, in the same order.</p>\n          <ul>\n            <li><svg class=\"check\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Drag items between days in one motion</li>\n            <li><svg class=\"check\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Filter by person, project, or priority</li>\n          </ul>\n        </article>\n\n        <article class=\"feature\">\n          <div class=\"icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M4 20V10M10 20V4M16 20v-7M22 20H2\"/></svg>\n          </div>\n          <h3>Capacity you can see before Wednesday</h3>\n          <p>Each person's time is shown against their real hours. When a day or a week tips over, Tidepool flags it while there is still time to move things.</p>\n          <ul>\n            <li><svg class=\"check\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Respects holidays, time off, and focus blocks</li>\n            <li><svg class=\"check\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Gentle warnings, never hard blocks</li>\n          </ul>\n        </article>\n\n        <article class=\"feature\">\n          <div class=\"icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z\"/></svg>\n          </div>\n          <h3>Async check-ins, no meetings</h3>\n          <p>Each morning, people answer three quick prompts: what's done, what's next, what's blocked. The board updates itself and the team reads it in under a minute.</p>\n          <ul>\n            <li><svg class=\"check\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Blockers surface to the whole team</li>\n            <li><svg class=\"check\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Summaries land in Slack or email</li>\n          </ul>\n        </article>\n\n        <article class=\"feature\">\n          <div class=\"icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/></svg>\n          </div>\n          <h3>A weekly ritual that sticks</h3>\n          <p>A guided Monday flow walks the team through goals, commitments, and the one thing that would make the week a success. Friday closes with a short, honest retro.</p>\n          <ul>\n            <li><svg class=\"check\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Goals carry over automatically</li>\n            <li><svg class=\"check\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>A history of what actually got done</li>\n          </ul>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <!-- How it works -->\n  <section class=\"how\" id=\"how\">\n    <div class=\"container\">\n      <div class=\"section-head\">\n        <div class=\"kicker\">How it works</div>\n        <h2>One calm ritual, every week.</h2>\n        <p>Tidepool is built around a single fifteen-minute conversation. The rest of the week runs on the plan you already agreed to.</p>\n      </div>\n      <div class=\"steps\">\n        <div class=\"step\">\n          <div class=\"step-num\">1</div>\n          <h3>Gather the week</h3>\n          <p>Pull in what's already on the table from your tasks and calendar. Anything new gets a name, an owner, and a rough size.</p>\n          <span class=\"time\">Monday \u00b7 about 5 minutes</span>\n        </div>\n        <div class=\"step\">\n          <div class=\"step-num\">2</div>\n          <h3>Sequence and commit</h3>\n          <p>Drop items onto days while the capacity view shows who has room. Each person confirms their list out loud or in the app.</p>\n          <span class=\"time\">Monday \u00b7 about 7 minutes</span>\n        </div>\n        <div class=\"step\">\n          <div class=\"step-num\">3</div>\n          <h3>Stay in tide</h3>\n          <p>Mornings take a minute of check-ins. When plans shift, the board re-balances and the team sees the change at once.</p>\n          <span class=\"time\">Tue to Fri \u00b7 1 minute a day</span>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Testimonial -->\n  <section class=\"quote-wrap\">\n    <div class=\"container quote\">\n      <blockquote>\n        &ldquo;We cancelled our Monday status meeting the week after we started. The board told us more in ten minutes than the meeting ever did.&rdquo;\n      </blockquote>\n      <div class=\"quote-by\">\n        <div class=\"avatar\" style=\"background:#135e6b\">PN</div>\n        <div>\n          <b>Priya N.</b>\n          <span>Head of Operations, six-person design studio</span>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Pricing -->\n  <section id=\"pricing\" style=\"background: var(--foam);\">\n    <div class=\"container\">\n      <div class=\"section-head\" style=\"margin-left:auto; margin-right:auto; text-align:center;\">\n        <div class=\"kicker\">Pricing</div>\n        <h2>Start free. Pay only when your team grows.</h2>\n        <p>Every plan includes the weekly board, capacity view, and async check-ins.</p>\n      </div>\n      <div class=\"pricing-grid\">\n        <div class=\"plan\">\n          <h3>Starter</h3>\n          <p class=\"desc\">For a small crew finding its rhythm.</p>\n          <div class=\"price\"><strong>$0</strong><span>forever</span></div>\n          <ul>\n            <li><svg class=\"check\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Up to 5 people</li>\n            <li><svg class=\"check\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>One shared week board</li>\n            <li><svg class=\"check\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Basic capacity view</li>\n            <li><svg class=\"check\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Four weeks of history</li>\n          </ul>\n          <a href=\"#signup\" class=\"btn btn-ghost\">Start free</a>\n        </div>\n\n        <div class=\"plan featured\">\n          <span class=\"badge\">Most popular</span>\n          <h3>Team</h3>\n          <p class=\"desc\">For teams that plan together every week.</p>\n          <div class=\"price\"><strong>$6</strong><span>per person / month</span></div>\n          <ul>\n            <li><svg class=\"check\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Up to 12 people</li>\n            <li><svg class=\"check\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Full capacity planning with time off</li>\n            <li><svg class=\"check\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Guided Monday and Friday rituals</li>\n            <li><svg class=\"check\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Slack and calendar sync</li>\n            <li><svg class=\"check\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Unlimited history</li>\n          </ul>\n          <a href=\"#signup\" class=\"btn btn-primary\">Try Team free for 14 days</a>\n        </div>\n\n        <div class=\"plan\">\n          <h3>Studio</h3>\n          <p class=\"desc\">For groups of teams that need shared visibility.</p>\n          <div class=\"price\"><strong>Custom</strong></div>\n          <ul>\n            <li><svg class=\"check\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Multiple teams in one workspace</li>\n            <li><svg class=\"check\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Cross-team roll-up view</li>\n            <li><svg class=\"check\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>SSO and admin controls</li>\n            <li><svg class=\"check\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Onboarding session for your lead</li>\n          </ul>\n          <a href=\"#signup\" class=\"btn btn-ghost\">Talk to us</a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- FAQ -->\n  <section id=\"faq\">\n    <div class=\"container faq-wrap\">\n      <div class=\"section-head\">\n        <div class=\"kicker\">FAQ</div>\n        <h2>Questions, answered plainly.</h2>\n        <p style=\"margin-top:16px; color:var(--muted);\">Can't find what you need? Email <a href=\"#\" style=\"color:var(--teal); font-weight:600;\">hello@tidepool.app</a> and a real person will reply.</p>\n      </div>\n      <div>\n        <details open>\n          <summary>How is this different from a project management tool?</summary>\n          <p>Project tools track long-running work. Tidepool is about the week: what each person commits to, when, and whether it fits. It sits beside your existing tools and pulls from them rather than replacing them.</p>\n        </details>\n        <details>\n          <summary>Does everyone need to be on Tidepool?</summary>\n          <p>Only the people planning the week. Anyone can view the shared board with a link, and check-ins can be answered by reply email if someone prefers not to sign in.</p>\n        </details>\n        <details>\n          <summary>How does the capacity view work?</summary>\n          <p>Each person sets their working hours, and Tidepool subtracts time off, holidays, and calendar commitments. It then compares planned work to available hours and shows a gentle warning when a day or week is overbooked.</p>\n        </details>\n        <details>\n          <summary>Will this turn into another meeting?</summary>\n          <p>No. The Monday session is designed to run in about fifteen minutes, and the daily check-in takes one minute. Most teams end up with fewer meetings than before.</p>\n        </details>\n        <details>\n          <summary>Can I bring my own calendar and task tool?</summary>\n          <p>Yes. Tidepool connects to common calendar and task apps. Connections are read-only by default, and you can disconnect any service at any time.</p>\n        </details>\n      </div>\n    </div>\n  </section>\n\n  <!-- Final CTA -->\n  <section class=\"final\" id=\"signup\" style=\"padding-top: 0;\">\n    <div class=\"container\">\n      <div class=\"final-box\">\n        <h2>Your next week can start with a shared plan.</h2>\n        <p>Set up your team in about two minutes, then run your first Monday session together.</p>\n        <div class=\"final-actions\">\n          <a href=\"#\" class=\"btn btn-light\">Start planning free</a>\n          <a href=\"#\" class=\"btn btn-ghost\">Book a 20-minute demo</a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"container\">\n    <div class=\"foot-grid\">\n      <div>\n        <a href=\"#top\" class=\"brand\" aria-label=\"Tidepool home\">\n          <svg width=\"26\" height=\"26\" viewBox=\"0 0 32 32\" aria-hidden=\"true\">\n            <circle cx=\"16\" cy=\"16\" r=\"15\" fill=\"#0b3440\"/>\n            <path d=\"M6 17c3-3 5-3 7 0s4 3 7 0 4-3 6 0\" stroke=\"#7fd1cb\" stroke-width=\"2.4\" fill=\"none\" stroke-linecap=\"round\"/>\n            <path d=\"M6 22c3-3 5-3 7 0s4 3 7 0 4-3 6 0\" stroke=\"#ff7a59\" stroke-width=\"2.4\" fill=\"none\" stroke-linecap=\"round\" opacity=\".9\"/>\n            <circle cx=\"16\" cy=\"10\" r=\"2.6\" fill=\"#f6f3ec\"/>\n          </svg>\n          Tidepool\n        </a>\n        <p>A calmer way for small teams to plan the week, and keep it.</p>\n      </div>\n      <div>\n        <h4>Product</h4>\n        <ul>\n          <li><a href=\"#features\">Features</a></li>\n          <li><a href=\"#how\">How it works</a></li>\n          <li><a href=\"#pricing\">Pricing</a></li>\n          <li><a href=\"#\">Changelog</a></li>\n        </ul>\n      </div>\n      <div>\n        <h4>Company</h4>\n        <ul>\n          <li><a href=\"#\">About</a></li>\n          <li><a href=\"#\">Customers</a></li>\n          <li><a href=\"#\">Careers</a></li>\n          <li><a href=\"#\">Contact</a></li>\n        </ul>\n      </div>\n      <div>\n        <h4>Resources</h4>\n        <ul>\n          <li><a href=\"#\">Weekly planning guide</a></li>\n          <li><a href=\"#faq\">FAQ</a></li>\n          <li><a href=\"#\">Privacy</a></li>\n          <li><a href=\"#\">Terms</a></li>\n        </ul>\n      </div>\n    </div>\n    <div class=\"foot-bottom\">\n      <span>&copy; 2025 Tidepool. All rights reserved.</span>\n      <span>Made for teams who would rather be doing the work.</span>\n    </div>\n  </div>\n</footer>\n\n<script>\n  // Subtle header border once the page is scrolled.\n  (function () {\n    var header = document.querySelector('header.site');\n    function onScroll() {\n      header.classList.toggle('scrolled', window.scrollY > 8);\n    }\n    window.addEventListener('scroll', onScroll, { passive: true });\n    onScroll();\n  })();\n</script>\n</body>\n</html>\n"}