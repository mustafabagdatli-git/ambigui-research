{"brief": "B5", "model": "openai/gpt-6-luna", "i": 1, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#f7f5ef\">\n  <title>Open Door \u2014 Sexual Health, Without the Stress</title>\n  <style>\n    :root {\n      --ink: #183b36;\n      --ink-soft: #49645d;\n      --paper: #f7f5ef;\n      --white: #fffefa;\n      --mint: #dcece2;\n      --mint-dark: #a8cfb8;\n      --coral: #ed8067;\n      --coral-pale: #f7d8ca;\n      --line: #dedfd6;\n      --serif: Georgia, \"Times New Roman\", serif;\n      --sans: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      --radius: 24px;\n    }\n\n    * { box-sizing: border-box; }\n\n    html { scroll-behavior: smooth; }\n\n    body {\n      margin: 0;\n      color: var(--ink);\n      background: var(--paper);\n      font-family: var(--sans);\n      line-height: 1.6;\n      -webkit-font-smoothing: antialiased;\n    }\n\n    a { color: inherit; }\n\n    a:focus-visible,\n    summary:focus-visible {\n      outline: 3px solid var(--coral);\n      outline-offset: 4px;\n      border-radius: 4px;\n    }\n\n    .wrap {\n      width: min(1160px, calc(100% - 48px));\n      margin-inline: auto;\n    }\n\n    .site-header {\n      position: relative;\n      z-index: 2;\n      padding: 22px 0;\n    }\n\n    .nav {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 28px;\n    }\n\n    .brand {\n      display: inline-flex;\n      align-items: center;\n      gap: 11px;\n      color: var(--ink);\n      text-decoration: none;\n      font-weight: 750;\n      letter-spacing: -0.04em;\n      font-size: 1.2rem;\n    }\n\n    .brand-mark {\n      width: 38px;\n      height: 38px;\n      display: grid;\n      place-items: center;\n      color: var(--white);\n      background: var(--ink);\n      border-radius: 50% 50% 50% 12px;\n      transform: rotate(-8deg);\n    }\n\n    .brand-mark svg { transform: rotate(8deg); }\n\n    .nav-links {\n      display: flex;\n      align-items: center;\n      gap: 30px;\n    }\n\n    .nav-links a {\n      text-decoration: none;\n      color: var(--ink-soft);\n      font-size: .92rem;\n      font-weight: 600;\n    }\n\n    .nav-links a:hover { color: var(--ink); }\n\n    .button {\n      display: inline-flex;\n      min-height: 48px;\n      align-items: center;\n      justify-content: center;\n      gap: 9px;\n      padding: 0 21px;\n      border: 1px solid transparent;\n      border-radius: 999px;\n      background: var(--ink);\n      color: var(--white);\n      font-weight: 700;\n      font-size: .92rem;\n      text-decoration: none;\n      transition: transform .2s ease, background .2s ease;\n    }\n\n    .button:hover {\n      background: #28564e;\n      transform: translateY(-2px);\n    }\n\n    .button-light {\n      color: var(--ink);\n      background: var(--white);\n      border-color: var(--line);\n    }\n\n    .button-light:hover {\n      color: var(--ink);\n      background: #f1eee6;\n    }\n\n    .hero {\n      padding: 70px 0 82px;\n      overflow: hidden;\n    }\n\n    .hero-grid {\n      display: grid;\n      grid-template-columns: 1.03fr .97fr;\n      align-items: center;\n      gap: clamp(40px, 7vw, 96px);\n    }\n\n    .eyebrow {\n      display: inline-flex;\n      align-items: center;\n      gap: 9px;\n      margin: 0 0 19px;\n      color: #507266;\n      font-size: .76rem;\n      font-weight: 800;\n      letter-spacing: .13em;\n      text-transform: uppercase;\n    }\n\n    .eyebrow::before {\n      content: \"\";\n      width: 23px;\n      height: 2px;\n      background: var(--coral);\n    }\n\n    h1, h2, h3, p { margin-top: 0; }\n\n    h1 {\n      max-width: 660px;\n      margin-bottom: 22px;\n      font-family: var(--serif);\n      font-size: clamp(3.35rem, 7vw, 6.35rem);\n      font-weight: 400;\n      letter-spacing: -.065em;\n      line-height: .98;\n    }\n\n    h1 em {\n      color: #6b927c;\n      font-weight: 400;\n    }\n\n    .hero-copy {\n      max-width: 490px;\n      margin-bottom: 30px;\n      color: var(--ink-soft);\n      font-size: 1.1rem;\n      line-height: 1.75;\n    }\n\n    .hero-actions {\n      display: flex;\n      flex-wrap: wrap;\n      align-items: center;\n      gap: 12px;\n    }\n\n    .reassurance {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      margin-top: 24px;\n      color: var(--ink-soft);\n      font-size: .88rem;\n    }\n\n    .check {\n      display: inline-grid;\n      width: 22px;\n      height: 22px;\n      flex: 0 0 22px;\n      place-items: center;\n      border-radius: 50%;\n      background: var(--mint);\n      color: var(--ink);\n      font-size: .8rem;\n      font-weight: 900;\n    }\n\n    .hero-art {\n      position: relative;\n      min-height: 455px;\n      display: grid;\n      place-items: center;\n      isolation: isolate;\n    }\n\n    .hero-art::before {\n      content: \"\";\n      position: absolute;\n      z-index: -1;\n      width: min(410px, 90%);\n      aspect-ratio: 1;\n      border-radius: 48% 52% 58% 42% / 44% 45% 55% 56%;\n      background: var(--mint);\n      transform: rotate(-12deg);\n    }\n\n    .hero-art::after {\n      content: \"\";\n      position: absolute;\n      z-index: -1;\n      top: 14%;\n      right: 6%;\n      width: 95px;\n      height: 95px;\n      border-radius: 50%;\n      background: var(--coral-pale);\n    }\n\n    .orbit {\n      position: absolute;\n      width: min(470px, 100%);\n      aspect-ratio: 1;\n      border: 1px solid rgba(24, 59, 54, .14);\n      border-radius: 50%;\n      transform: rotate(26deg) scaleY(.74);\n    }\n\n    .orbit::after {\n      content: \"\";\n      position: absolute;\n      top: 14%;\n      left: 12%;\n      width: 11px;\n      height: 11px;\n      border-radius: 50%;\n      background: var(--coral);\n    }\n\n    .care-card {\n      width: min(330px, 82%);\n      padding: 27px;\n      border: 1px solid rgba(24, 59, 54, .08);\n      border-radius: 22px;\n      background: var(--white);\n      box-shadow: 0 20px 60px rgba(35, 61, 51, .11);\n      transform: rotate(2deg);\n    }\n\n    .card-top {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      margin-bottom: 25px;\n    }\n\n    .card-label {\n      color: #648171;\n      font-size: .72rem;\n      font-weight: 800;\n      letter-spacing: .12em;\n      text-transform: uppercase;\n    }\n\n    .sun-mark {\n      display: grid;\n      width: 39px;\n      height: 39px;\n      place-items: center;\n      border-radius: 50%;\n      background: var(--coral-pale);\n      color: #7f5142;\n    }\n\n    .care-card h2 {\n      margin-bottom: 8px;\n      font-family: var(--serif);\n      font-size: 2rem;\n      font-weight: 400;\n      letter-spacing: -.04em;\n      line-height: 1.1;\n    }\n\n    .care-card p {\n      margin-bottom: 22px;\n      color: var(--ink-soft);\n      font-size: .92rem;\n    }\n\n    .card-rule {\n      height: 1px;\n      margin: 0 0 17px;\n      background: var(--line);\n    }\n\n    .walk-in-note {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      font-size: .87rem;\n      font-weight: 700;\n    }\n\n    .status-dot {\n      width: 9px;\n      height: 9px;\n      border-radius: 50%;\n      background: #6ba782;\n      box-shadow: 0 0 0 4px #e3f0e6;\n    }\n\n    .flower {\n      position: absolute;\n      left: 4%;\n      bottom: 10%;\n      width: 72px;\n      height: 72px;\n      color: #6b927c;\n      transform: rotate(-12deg);\n    }\n\n    .trust-strip {\n      border-top: 1px solid var(--line);\n      border-bottom: 1px solid var(--line);\n      background: rgba(255, 254, 250, .48);\n    }\n\n    .trust-inner {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 20px;\n      padding: 22px 0;\n    }\n\n    .trust-item {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 11px;\n      color: var(--ink-soft);\n      font-size: .9rem;\n      font-weight: 650;\n      text-align: center;\n    }\n\n    .trust-item svg { flex: 0 0 auto; color: #6b927c; }\n\n    .section {\n      padding: 100px 0;\n    }\n\n    .section-heading {\n      max-width: 630px;\n      margin: 0 auto 46px;\n      text-align: center;\n    }\n\n    .section-heading .eyebrow { justify-content: center; }\n\n    h2.section-title {\n      margin-bottom: 14px;\n      font-family: var(--serif);\n      font-size: clamp(2.5rem, 4.5vw, 4rem);\n      font-weight: 400;\n      letter-spacing: -.055em;\n      line-height: 1.05;\n    }\n\n    .section-heading > p:last-child {\n      margin: 0;\n      color: var(--ink-soft);\n      font-size: 1.02rem;\n    }\n\n    .service-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 17px;\n    }\n\n    .service-card {\n      min-height: 230px;\n      padding: 27px;\n      border: 1px solid var(--line);\n      border-radius: var(--radius);\n      background: var(--white);\n    }\n\n    .service-icon {\n      display: grid;\n      width: 45px;\n      height: 45px;\n      margin-bottom: 26px;\n      place-items: center;\n      border-radius: 14px;\n      background: var(--mint);\n      color: var(--ink);\n    }\n\n    .service-card:nth-child(2) .service-icon,\n    .service-card:nth-child(5) .service-icon {\n      background: var(--coral-pale);\n    }\n\n    .service-card h3 {\n      margin-bottom: 8px;\n      font-size: 1.08rem;\n      letter-spacing: -.02em;\n    }\n\n    .service-card p {\n      margin: 0;\n      color: var(--ink-soft);\n      font-size: .92rem;\n    }\n\n    .service-note {\n      margin: 23px 0 0;\n      color: var(--ink-soft);\n      font-size: .88rem;\n      text-align: center;\n    }\n\n    .visit-section {\n      padding: 80px 0;\n      background: var(--ink);\n      color: var(--white);\n    }\n\n    .visit-grid {\n      display: grid;\n      grid-template-columns: .9fr 1.1fr;\n      align-items: center;\n      gap: 70px;\n    }\n\n    .visit-section .eyebrow { color: #b9d8c4; }\n\n    .visit-section h2 {\n      margin-bottom: 18px;\n      font-family: var(--serif);\n      font-size: clamp(2.6rem, 4.7vw, 4.2rem);\n      font-weight: 400;\n      letter-spacing: -.055em;\n      line-height: 1.03;\n    }\n\n    .visit-intro {\n      max-width: 410px;\n      margin-bottom: 0;\n      color: #c7d8d0;\n      font-size: 1rem;\n    }\n\n    .steps {\n      display: grid;\n      gap: 12px;\n    }\n\n    .step {\n      display: grid;\n      grid-template-columns: 44px 1fr;\n      gap: 15px;\n      align-items: start;\n      padding: 18px 20px;\n      border: 1px solid rgba(255, 255, 255, .16);\n      border-radius: 17px;\n      background: rgba(255, 255, 255, .055);\n    }\n\n    .step-number {\n      display: grid;\n      width: 38px;\n      height: 38px;\n      place-items: center;\n      border-radius: 50%;\n      background: var(--mint-dark);\n      color: var(--ink);\n      font-size: .85rem;\n      font-weight: 800;\n    }\n\n    .step h3 {\n      margin: 2px 0 4px;\n      font-size: 1rem;\n    }\n\n    .step p {\n      margin: 0;\n      color: #c7d8d0;\n      font-size: .9rem;\n    }\n\n    .privacy-section {\n      padding: 86px 0;\n    }\n\n    .privacy-card {\n      display: grid;\n      grid-template-columns: 75px 1fr auto;\n      align-items: center;\n      gap: 24px;\n      padding: 34px 38px;\n      border-radius: var(--radius);\n      background: #e8eee3;\n    }\n\n    .privacy-icon {\n      display: grid;\n      width: 66px;\n      height: 66px;\n      place-items: center;\n      border-radius: 20px;\n      background: var(--white);\n      color: var(--ink);\n    }\n\n    .privacy-card h2 {\n      margin-bottom: 6px;\n      font-family: var(--serif);\n      font-size: 1.8rem;\n      font-weight: 400;\n      letter-spacing: -.035em;\n    }\n\n    .privacy-card p {\n      max-width: 610px;\n      margin: 0;\n      color: var(--ink-soft);\n      font-size: .94rem;\n    }\n\n    .faq-section {\n      padding: 15px 0 100px;\n    }\n\n    .faq-layout {\n      display: grid;\n      grid-template-columns: .8fr 1.2fr;\n      gap: 80px;\n    }\n\n    .faq-title h2 {\n      margin-bottom: 15px;\n      font-family: var(--serif);\n      font-size: clamp(2.6rem, 4.5vw, 4rem);\n      font-weight: 400;\n      letter-spacing: -.055em;\n      line-height: 1.05;\n    }\n\n    .faq-title p {\n      max-width: 320px;\n      color: var(--ink-soft);\n    }\n\n    .faq-list { border-top: 1px solid var(--line); }\n\n    details {\n      border-bottom: 1px solid var(--line);\n    }\n\n    summary {\n      position: relative;\n      padding: 20px 36px 20px 0;\n      cursor: pointer;\n      list-style: none;\n      font-weight: 700;\n    }\n\n    summary::-webkit-details-marker { display: none; }\n\n    summary::after {\n      content: \"+\";\n      position: absolute;\n      top: 16px;\n      right: 2px;\n      color: #648171;\n      font-size: 1.5rem;\n      font-weight: 400;\n    }\n\n    details[open] summary::after { content: \"\u2212\"; }\n\n    details p {\n      max-width: 650px;\n      margin: -4px 30px 20px 0;\n      color: var(--ink-soft);\n      font-size: .94rem;\n    }\n\n    .site-footer {\n      padding: 30px 0;\n      border-top: 1px solid var(--line);\n    }\n\n    .footer-inner {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 24px;\n    }\n\n    .footer-inner p {\n      margin: 0;\n      color: var(--ink-soft);\n      font-size: .82rem;\n    }\n\n    .footer-links {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 20px;\n    }\n\n    .footer-links a {\n      color: var(--ink-soft);\n      font-size: .82rem;\n      text-decoration: none;\n    }\n\n    .footer-links a:hover { text-decoration: underline; }\n\n    .sr-only {\n      position: absolute;\n      width: 1px;\n      height: 1px;\n      padding: 0;\n      margin: -1px;\n      overflow: hidden;\n      clip: rect(0, 0, 0, 0);\n      white-space: nowrap;\n      border: 0;\n    }\n\n    @media (max-width: 820px) {\n      .nav-links { gap: 17px; }\n      .nav-links a:not(.button) { display: none; }\n      .hero { padding: 55px 0 66px; }\n      .hero-grid { grid-template-columns: 1fr 0.8fr; gap: 20px; }\n      .hero-art { min-height: 365px; }\n      .service-grid { grid-template-columns: repeat(2, 1fr); }\n      .visit-grid { gap: 38px; }\n      .privacy-card { grid-template-columns: 62px 1fr; }\n      .privacy-card .button { grid-column: 2; justify-self: start; }\n      .faq-layout { gap: 40px; }\n    }\n\n    @media (max-width: 600px) {\n      .wrap { width: min(100% - 36px, 480px); }\n      .site-header { padding: 16px 0; }\n      .brand { font-size: 1.08rem; }\n      .brand-mark { width: 34px; height: 34px; }\n      .nav .button { min-height: 42px; padding: 0 14px; font-size: .82rem; }\n      .hero { padding: 42px 0 48px; }\n      .hero-grid { grid-template-columns: 1fr; gap: 28px; }\n      h1 { max-width: 500px; font-size: clamp(3.25rem, 16vw, 5rem); }\n      .hero-copy { font-size: 1rem; }\n      .hero-art { min-height: 315px; }\n      .hero-art::before { width: 285px; }\n      .orbit { width: 325px; }\n      .care-card { width: min(300px, 84%); padding: 22px; }\n      .flower { left: 1%; bottom: 7%; width: 54px; }\n      .trust-inner { grid-template-columns: 1fr; gap: 13px; padding: 20px 0; }\n      .trust-item { justify-content: flex-start; text-align: left; }\n      .section { padding: 72px 0; }\n      .section-heading { margin-bottom: 32px; }\n      .service-grid { grid-template-columns: 1fr; gap: 12px; }\n      .service-card { min-height: auto; padding: 23px; }\n      .service-icon { margin-bottom: 19px; }\n      .visit-section { padding: 66px 0; }\n      .visit-grid { grid-template-columns: 1fr; gap: 30px; }\n      .step { padding: 16px; }\n      .privacy-section { padding: 62px 0; }\n      .privacy-card { grid-template-columns: 1fr; gap: 16px; padding: 25px; }\n      .privacy-card .button { grid-column: 1; }\n      .faq-section { padding: 5px 0 70px; }\n      .faq-layout { grid-template-columns: 1fr; gap: 24px; }\n      .faq-title h2 { font-size: 2.8rem; }\n      .footer-inner { align-items: flex-start; flex-direction: column; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      html { scroll-behavior: auto; }\n      *, *::before, *::after { transition-duration: .01ms !important; }\n    }\n  </style>\n</head>\n<body>\n  <header class=\"site-header\">\n    <nav class=\"nav wrap\" aria-label=\"Main navigation\">\n      <a class=\"brand\" href=\"#\" aria-label=\"Open Door home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M12 3v18M3 12h18\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"/>\n            <circle cx=\"12\" cy=\"12\" r=\"8.2\" stroke=\"currentColor\" stroke-width=\"1.6\"/>\n          </svg>\n        </span>\n        Open Door\n      </a>\n      <div class=\"nav-links\">\n        <a href=\"#services\">Care we offer</a>\n        <a href=\"#visit\">Your visit</a>\n        <a href=\"#faq\">FAQs</a>\n        <a class=\"button\" href=\"#visit\">Plan a visit <span aria-hidden=\"true\">\u2197</span></a>\n      </div>\n    </nav>\n  </header>\n\n  <main>\n    <section class=\"hero\">\n      <div class=\"hero-grid wrap\">\n        <div>\n          <p class=\"eyebrow\">Sexual health, without the stress</p>\n          <h1>Care that meets you <em>where you are.</em></h1>\n          <p class=\"hero-copy\">\n            Questions, checkups, or just a place to start. Find respectful sexual-health care, at your pace and without judgment.\n          </p>\n          <div class=\"hero-actions\">\n            <a class=\"button\" href=\"#visit\">What to expect <span aria-hidden=\"true\">\u2192</span></a>\n            <a class=\"button button-light\" href=\"#services\">Explore services</a>\n          </div>\n          <p class=\"reassurance\"><span class=\"check\" aria-hidden=\"true\">\u2713</span> Walk-ins welcome. No appointment needed.</p>\n        </div>\n\n        <div class=\"hero-art\" aria-hidden=\"true\">\n          <div class=\"orbit\"></div>\n          <svg class=\"flower\" viewBox=\"0 0 100 100\" fill=\"none\">\n            <path d=\"M50 13c9 0 13 13 8 22 10-5 22-1 22 8s-12 13-22 8c5 10 1 22-8 22s-13-12-8-22c-10 5-22 1-22-8s12-13 22-8c-5-9-1-22 8-22Z\" stroke=\"currentColor\" stroke-width=\"2\"/>\n            <circle cx=\"50\" cy=\"47\" r=\"6\" fill=\"currentColor\"/>\n            <path d=\"M50 73v18m0-8c-7-9-15-9-21-8m21 4c7-8 13-9 20-8\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n          </svg>\n          <div class=\"care-card\">\n            <div class=\"card-top\">\n              <span class=\"card-label\">A softer place to land</span>\n              <span class=\"sun-mark\">\n                <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\">\n                  <circle cx=\"12\" cy=\"12\" r=\"4\" stroke=\"currentColor\" stroke-width=\"1.7\"/>\n                  <path d=\"M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/>\n                </svg>\n              </span>\n            </div>\n            <h2>You belong here.</h2>\n            <p>Come as you are. Our team is here to listen, answer questions, and help you understand your options.</p>\n            <div class=\"card-rule\"></div>\n            <div class=\"walk-in-note\"><span class=\"status-dot\"></span> Walk-ins welcome</div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"trust-strip\" aria-label=\"Our approach\">\n      <div class=\"trust-inner wrap\">\n        <div class=\"trust-item\">\n          <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n            <path d=\"M12 21s8-4 8-10V5l-8-3-8 3v6c0 6 8 10 8 10Z\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linejoin=\"round\"/>\n            <path d=\"m9 12 2 2 4-4\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          </svg>\n          Care without judgment\n        </div>\n        <div class=\"trust-item\">\n          <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n            <path d=\"M4 12h16M12 4v16\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n            <circle cx=\"12\" cy=\"12\" r=\"9\" stroke=\"currentColor\" stroke-width=\"1.5\"/>\n          </svg>\n          Walk in when it works for you\n        </div>\n        <div class=\"trust-item\">\n          <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n            <path d=\"M12 21s-8-4.35-8-11a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 20 10c0 6.65-8 11-8 11Z\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"/>\n          </svg>\n          Your questions are welcome\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section\" id=\"services\">\n      <div class=\"wrap\">\n        <div class=\"section-heading\">\n          <p class=\"eyebrow\">Care, on your terms</p>\n          <h2 class=\"section-title\">A good place to start.</h2>\n          <p>Whether you know what you need or aren\u2019t sure yet, we\u2019ll help you find the next step that feels right for you.</p>\n        </div>\n\n        <div class=\"service-grid\">\n          <article class=\"service-card\">\n            <div class=\"service-icon\" aria-hidden=\"true\">\n              <svg width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\">\n                <path d=\"M4 5h16v14H4zM8 9h8m-8 4h5\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n            </div>\n            <h3>STI testing &amp; treatment</h3>\n            <p>Talk through testing options, results, and possible next steps with our care team.</p>\n          </article>\n\n          <article class=\"service-card\">\n            <div class=\"service-icon\" aria-hidden=\"true\">\n              <svg width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\">\n                <circle cx=\"12\" cy=\"12\" r=\"8.5\" stroke=\"currentColor\" stroke-width=\"1.7\"/>\n                <path d=\"M12 7v10m-5-5h10\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/>\n              </svg>\n            </div>\n            <h3>Birth control</h3>\n            <p>Explore methods and get support choosing an option that suits your needs.</p>\n          </article>\n\n          <article class=\"service-card\">\n            <div class=\"service-icon\" aria-hidden=\"true\">\n              <svg width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\">\n                <path d=\"M12 21s7-3.5 7-9V5l-7-3-7 3v7c0 5.5 7 9 7 9Z\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linejoin=\"round\"/>\n                <path d=\"M9 12h6\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/>\n              </svg>\n            </div>\n            <h3>PrEP &amp; PEP information</h3>\n            <p>Get information about HIV prevention and discuss whether these options may be right for you.</p>\n          </article>\n\n          <article class=\"service-card\">\n            <div class=\"service-icon\" aria-hidden=\"true\">\n              <svg width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\">\n                <path d=\"M12 21s-7-4-7-11a7 7 0 0 1 14 0c0 7-7 11-7 11Z\" stroke=\"currentColor\" stroke-width=\"1.7\"/>\n                <circle cx=\"12\" cy=\"10\" r=\"2.5\" stroke=\"currentColor\" stroke-width=\"1.7\"/>\n              </svg>\n            </div>\n            <h3>Pregnancy options</h3>\n            <p>Talk through questions and available options in a supportive, nonjudgmental space.</p>\n          </article>\n\n          <article class=\"service-card\">\n            <div class=\"service-icon\" aria-hidden=\"true\">\n              <svg width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\">\n                <path d=\"M5 5h14v11H9l-4 4V5Z\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linejoin=\"round\"/>\n                <path d=\"M9 9h6m-6 3h4\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/>\n              </svg>\n            </div>\n            <h3>Questions &amp; conversations</h3>\n            <p>Bring what\u2019s on your mind. You don\u2019t need to have the perfect words or a plan.</p>\n          </article>\n\n          <article class=\"service-card\">\n            <div class=\"service-icon\" aria-hidden=\"true\">\n              <svg width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\">\n                <path d=\"M12 3v18M5 7h14M7 7l-3 6h6L7 7Zm10 0-3 6h6l-3-6ZM8 21h8\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n            </div>\n            <h3>Sexual-health guidance</h3>\n            <p>Get clear information and support for making decisions about your wellbeing.</p>\n          </article>\n        </div>\n        <p class=\"service-note\">Services vary by clinic and location. Ask the care team what\u2019s available when you visit.</p>\n      </div>\n    </section>\n\n    <section class=\"visit-section\" id=\"visit\">\n      <div class=\"visit-grid wrap\">\n        <div>\n          <p class=\"eyebrow\">No appointment needed</p>\n          <h2>Just come as you are.</h2>\n          <p class=\"visit-intro\">A walk-in visit can be simple. Here\u2019s a little of what to expect when you arrive.</p>\n        </div>\n        <div class=\"steps\">\n          <article class=\"step\">\n            <span class=\"step-number\">01</span>\n            <div>\n              <h3>Say hello</h3>\n              <p>Let the front desk know you\u2019re here for sexual-health care. You can share only what you\u2019re comfortable sharing.</p>\n            </div>\n          </article>\n          <article class=\"step\">\n            <span class=\"step-number\">02</span>\n            <div>\n              <h3>Talk it through</h3>\n              <p>A member of the care team will listen, answer questions, and explain what options may be available.</p>\n            </div>\n          </article>\n          <article class=\"step\">\n            <span class=\"step-number\">03</span>\n            <div>\n              <h3>Choose your next step</h3>\n              <p>You\u2019ll have a chance to ask questions and decide what feels right for you.</p>\n            </div>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"privacy-section\">\n      <div class=\"privacy-card wrap\">\n        <div class=\"privacy-icon\" aria-hidden=\"true\">\n          <svg width=\"30\" height=\"30\" viewBox=\"0 0 24 24\" fill=\"none\">\n            <rect x=\"4\" y=\"10\" width=\"16\" height=\"11\" rx=\"2\" stroke=\"currentColor\" stroke-width=\"1.7\"/>\n            <path d=\"M8 10V7a4 4 0 1 1 8 0v3m-4 4v3\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/>\n          </svg>\n        </div>\n        <div>\n          <h2>Your privacy matters.</h2>\n          <p>We handle your information with care. Privacy rules can have limits depending on your situation and location\u2014our team can explain what to expect before you share.</p>\n        </div>\n        <a class=\"button button-light\" href=\"#faq\">Read the FAQs</a>\n      </div>\n    </section>\n\n    <section class=\"faq-section\" id=\"faq\">\n      <div class=\"faq-layout wrap\">\n        <div class=\"faq-title\">\n          <p class=\"eyebrow\">A few helpful answers</p>\n          <h2>Good to know.</h2>\n          <p>It\u2019s okay to have questions before you come in. Here are a few common ones.</p>\n        </div>\n        <div class=\"faq-list\">\n          <details>\n            <summary>Do I need an appointment?</summary>\n            <p>No appointment is needed. Open Door is a walk-in clinic. Hours and services can vary by location, so check your local clinic\u2019s details before visiting.</p>\n          </details>\n          <details>\n            <summary>What should I bring?</summary>\n            <p>What you need can depend on the care you\u2019re looking for. The clinic team can explain what may be helpful and discuss costs or coverage before your visit.</p>\n          </details>\n          <details>\n            <summary>Will everything be confidential?</summary>\n            <p>We take your privacy seriously. Rules about privacy and confidentiality can vary by location and situation, so please ask the care team to explain any limits that may apply.</p>\n          </details>\n          <details>\n            <summary>What if I\u2019m not sure what kind of care I need?</summary>\n            <p>That\u2019s okay. You can start with a conversation, ask questions, and learn about options. You don\u2019t need to arrive with a diagnosis or a decision.</p>\n          </details>\n        </div>\n      </div>\n    </section>\n  </main>\n\n  <footer class=\"site-footer\">\n    <div class=\"footer-inner wrap\">\n      <p>\u00a9 2025 Open Door. Sexual health care, with care.</p>\n      <div class=\"footer-links\">\n        <a href=\"#services\">Services</a>\n        <a href=\"#visit\">Your visit</a>\n        <a href=\"#faq\">FAQs</a>\n      </div>\n    </div>\n  </footer>\n</body>\n</html>\n"}