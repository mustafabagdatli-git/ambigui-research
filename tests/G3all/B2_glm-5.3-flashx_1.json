{"brief": "B2", "model": "z-ai/glm-5.3-flashx", "i": 1, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>WonderLab \u2014 Children's Science Museum</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;700&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --paper:#FFF6E9; --ink:#232534; --coral:#FF5A4E; --teal:#0FA6A6;\n    --sun:#FFC531; --sky:#BFE3F0; --leaf:#7CC24B; --plum:#7B5EA7;\n    --shadow: 6px 6px 0 var(--ink);\n  }\n  *{margin:0;padding:0;box-sizing:border-box;}\n  html{scroll-behavior:smooth;}\n  body{background:var(--paper);color:var(--ink);font-family:'Space Grotesk',sans-serif;overflow-x:hidden;}\n  h1,h2,h3,.fredoka{font-family:'Fredoka',sans-serif;}\n  ::selection{background:var(--sun);}\n\n  /* ---------- NAV ---------- */\n  nav{position:sticky;top:0;z-index:50;background:var(--paper);border-bottom:3px solid var(--ink);display:flex;align-items:center;justify-content:space-between;padding:.7rem 4vw;}\n  .logo{display:flex;align-items:center;gap:.6rem;font-family:'Fredoka';font-weight:700;font-size:1.5rem;text-decoration:none;color:var(--ink);}\n  .logo-badge{width:42px;height:42px;background:var(--coral);border:3px solid var(--ink);border-radius:50% 50% 50% 12%;display:grid;place-items:center;color:#fff;font-size:1.2rem;box-shadow:3px 3px 0 var(--ink);transform:rotate(-6deg);}\n  .nav-links{display:flex;gap:1.8rem;align-items:center;list-style:none;}\n  .nav-links a{text-decoration:none;color:var(--ink);font-weight:600;font-size:.95rem;position:relative;padding:2px 0;}\n  .nav-links a::after{content:\"\";position:absolute;left:0;bottom:-3px;width:0;height:4px;background:var(--teal);border-radius:4px;transition:width .25s;}\n  .nav-links a:hover::after{width:100%;}\n  .btn{display:inline-block;font-family:'Fredoka';font-weight:600;text-decoration:none;color:var(--ink);background:#fff;border:3px solid var(--ink);border-radius:14px;padding:.6rem 1.4rem;box-shadow:var(--shadow);transition:transform .15s, box-shadow .15s;cursor:pointer;font-size:1rem;}\n  .btn:hover{transform:translate(3px,3px);box-shadow:2px 2px 0 var(--ink);}\n  .btn:active{transform:translate(6px,6px);box-shadow:0 0 0 var(--ink);}\n  .btn-coral{background:var(--coral);color:#fff;}\n  .btn-sun{background:var(--sun);}\n  .btn-teal{background:var(--teal);color:#fff;}\n  @media(max-width:760px){.nav-links{display:none;}}\n\n  /* ---------- HERO ---------- */\n  .hero{position:relative;padding:4.5rem 4vw 5.5rem;overflow:hidden;border-bottom:3px solid var(--ink);}\n  .hero-grid{position:relative;z-index:2;max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1.15fr .85fr;gap:3rem;align-items:center;}\n  .kicker{display:inline-block;font-family:'Fredoka';font-weight:600;font-size:.9rem;background:var(--sun);border:3px solid var(--ink);border-radius:999px;padding:.35rem 1rem;box-shadow:3px 3px 0 var(--ink);transform:rotate(-2deg);margin-bottom:1.4rem;}\n  .hero h1{font-size:clamp(2.6rem,6vw,4.6rem);line-height:1.02;font-weight:700;letter-spacing:-.5px;}\n  .hero h1 .squig{color:var(--coral);position:relative;white-space:nowrap;}\n  .hero h1 .squig svg{position:absolute;left:0;bottom:-14px;width:100%;height:16px;}\n  .hero p{margin:1.6rem 0 2rem;font-size:1.15rem;max-width:32rem;line-height:1.6;}\n  .hero-ctas{display:flex;gap:1rem;flex-wrap:wrap;}\n  .hero-visual{position:relative;height:420px;}\n  .doodle{position:absolute;border:3px solid var(--ink);box-shadow:var(--shadow);transition:transform .3s cubic-bezier(.34,1.56,.64,1);}\n  .doodle:hover{transform:rotate(0deg) scale(1.06)!important;z-index:5;}\n  .d-rocket{width:120px;height:120px;border-radius:28px;background:var(--sky);transform:rotate(6deg);top:0;right:40px;display:grid;place-items:center;}\n  .d-magnet{width:110px;height:110px;border-radius:50%;background:var(--teal);transform:rotate(-8deg);bottom:30px;left:0;display:grid;place-items:center;}\n  .d-flask{width:130px;height:96px;border-radius:20px;background:var(--leaf);transform:rotate(4deg);bottom:0;right:110px;display:grid;place-items:center;}\n  .d-star{width:78px;height:78px;background:var(--sun);transform:rotate(12deg);top:60px;left:30px;clip-path:polygon(50% 0%,61% 35%,98% 35%,68% 57%,79% 91%,50% 70%,21% 91%,32% 57%,2% 35%,39% 35%);border:none;filter:drop-shadow(4px 4px 0 var(--ink));}\n  .hint{position:absolute;bottom:-2.6rem;right:0;font-size:.85rem;font-weight:600;opacity:.65;transform:rotate(-2deg);}\n  #stage{position:absolute;inset:0;z-index:3;cursor:grab;}\n  @media(max-width:900px){.hero-grid{grid-template-columns:1fr;}.hero-visual{height:340px;max-width:480px;}}\n\n  /* ---------- MARQUEE ---------- */\n  .marquee{background:var(--ink);color:var(--paper);border-bottom:3px solid var(--ink);overflow:hidden;white-space:nowrap;padding:.85rem 0;}\n  .marquee-track{display:inline-block;animation:scroll 22s linear infinite;font-family:'Fredoka';font-weight:600;font-size:1.1rem;letter-spacing:2px;}\n  .marquee-track span{margin:0 1.5rem;}\n  .marquee-track .dot{color:var(--sun);}\n  @keyframes scroll{from{transform:translateX(0);}to{transform:translateX(-50%);}}\n\n  /* ---------- EXHIBITS ---------- */\n  section{padding:5.5rem 4vw;}\n  .sec-head{max-width:1200px;margin:0 auto 3rem;display:flex;align-items:flex-end;justify-content:space-between;gap:2rem;flex-wrap:wrap;}\n  .sec-head h2{font-size:clamp(2rem,4vw,3rem);font-weight:700;}\n  .sec-head .num{font-family:'Fredoka';font-weight:700;color:var(--coral);font-size:1.1rem;display:block;margin-bottom:.4rem;}\n  .exhibits{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:repeat(12,1fr);gap:1.6rem;}\n  .card{border:3px solid var(--ink);border-radius:22px;box-shadow:var(--shadow);padding:1.8rem;background:#fff;display:flex;flex-direction:column;transition:transform .2s, box-shadow .2s;}\n  .card:hover{transform:translate(-3px,-3px);box-shadow:9px 9px 0 var(--ink);}\n  .card h3{font-size:1.5rem;font-weight:600;margin-bottom:.5rem;}\n  .card p{line-height:1.55;font-size:.98rem;}\n  .card .age{align-self:flex-start;font-family:'Fredoka';font-weight:600;font-size:.8rem;background:var(--paper);border:2px solid var(--ink);border-radius:999px;padding:.2rem .8rem;margin-bottom:1rem;}\n  .card .art{height:130px;display:grid;place-items:center;margin-bottom:1.2rem;}\n  .c1{grid-column:span 7;background:var(--sky);}\n  .c1 .art{height:180px;}\n  .c2{grid-column:span 5;background:#fff;}\n  .c3{grid-column:span 4;background:var(--sun);}\n  .c4{grid-column:span 4;background:#fff;}\n  .c5{grid-column:span 4;background:var(--leaf);}\n  @media(max-width:900px){.exhibits{grid-template-columns:1fr;}.c1,.c2,.c3,.c4,.c5{grid-column:span 1;}}\n  .wob{animation:wob 5s ease-in-out infinite;transform-origin:center;}\n  @keyframes wob{0%,100%{transform:rotate(-3deg);}50%{transform:rotate(3deg);}}\n\n  /* ---------- SCHEDULE ---------- */\n  .schedule{background:var(--sky);border-top:3px solid var(--ink);border-bottom:3px solid var(--ink);}\n  .timeline{max-width:900px;margin:0 auto;position:relative;padding-left:2.2rem;}\n  .timeline::before{content:\"\";position:absolute;left:9px;top:8px;bottom:8px;width:4px;background:var(--ink);border-radius:4px;}\n  .slot{position:relative;margin-bottom:1.6rem;background:#fff;border:3px solid var(--ink);border-radius:16px;padding:1.1rem 1.5rem;box-shadow:5px 5px 0 var(--ink);display:flex;gap:1.4rem;align-items:baseline;flex-wrap:wrap;transition:transform .2s;}\n  .slot:hover{transform:translateX(6px);}\n  .slot::before{content:\"\";position:absolute;left:-2.2rem;top:1.4rem;width:18px;height:18px;background:var(--coral);border:3px solid var(--ink);border-radius:50%;}\n  .slot time{font-family:'Fredoka';font-weight:700;color:var(--teal);min-width:5.5rem;font-size:1.05rem;}\n  .slot strong{font-size:1.1rem;font-family:'Fredoka';font-weight:600;}\n  .slot small{display:block;color:#5a5d6e;margin-top:.15rem;}\n\n  /* ---------- TICKETS ---------- */\n  .tickets{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:repeat(3,1fr);gap:1.8rem;}\n  .ticket{position:relative;border:3px solid var(--ink);border-radius:22px;background:#fff;box-shadow:var(--shadow);overflow:hidden;transition:transform .2s;}\n  .ticket:hover{transform:rotate(-1.5deg) translateY(-4px);}\n  .ticket-head{padding:1.3rem 1.6rem;border-bottom:3px dashed var(--ink);font-family:'Fredoka';font-weight:700;font-size:1.3rem;color:#fff;}\n  .t1 .ticket-head{background:var(--coral);} .t2 .ticket-head{background:var(--plum);} .t3 .ticket-head{background:var(--teal);}\n  .ticket-body{padding:1.4rem 1.6rem 1.6rem;}\n  .price{font-family:'Fredoka';font-weight:700;font-size:2.6rem;}\n  .price sup{font-size:1.2rem;}\n  .ticket ul{list-style:none;margin:1rem 0 1.4rem;line-height:2;font-size:.95rem;}\n  .ticket li::before{content:\"\u2726\";margin-right:.6rem;color:var(--coral);font-weight:700;}\n  .t2 li::before{color:var(--plum);} .t3 li::before{color:var(--teal);}\n  .t2{transform:scale(1.04);z-index:2;}\n  .t2:hover{transform:scale(1.04) rotate(-1.5deg) translateY(-4px);}\n  .badge-pop{position:absolute;top:-14px;right:-10px;background:var(--sun);border:3px solid var(--ink);border-radius:999px;font-family:'Fredoka';font-weight:700;font-size:.8rem;padding:.35rem .9rem;transform:rotate(6deg);box-shadow:3px 3px 0 var(--ink);}\n  @media(max-width:900px){.tickets{grid-template-columns:1fr;}.t2{transform:none;}}\n\n  /* ---------- VISIT ---------- */\n  .visit{background:var(--ink);color:var(--paper);}\n  .visit-grid{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1.2fr 1fr;gap:3.5rem;}\n  .visit h2{color:var(--sun);font-size:clamp(2rem,4vw,3rem);margin-bottom:1.4rem;}\n  .visit p{line-height:1.7;opacity:.9;}\n  .hours{border:3px solid var(--paper);border-radius:20px;padding:1.8rem;box-shadow:6px 6px 0 var(--coral);}\n  .hours h3{color:var(--sun);margin-bottom:1rem;font-size:1.4rem;}\n  .hours dl{display:grid;grid-template-columns:1fr auto;row-gap:.55rem;font-size:1rem;}\n  .hours dt{opacity:.85;} .hours dd{font-weight:700;color:var(--sun);}\n  @media(max-width:820px){.visit-grid{grid-template-columns:1fr;}}\n\n  footer{background:var(--ink);color:var(--paper);border-top:3px solid var(--paper);padding:1.6rem 4vw;display:flex;justify-content:space-between;flex-wrap:wrap;gap:1rem;font-size:.9rem;}\n  footer a{color:var(--sun);text-decoration:none;font-weight:600;}\n  footer a:hover{text-decoration:underline;}\n\n  /* toast */\n  #toast{position:fixed;left:50%;bottom:28px;transform:translate(-50%,80px);background:var(--ink);color:var(--paper);border:3px solid var(--paper);border-radius:14px;padding:.8rem 1.5rem;font-family:'Fredoka';font-weight:600;box-shadow:5px 5px 0 var(--coral);opacity:0;transition:.35s cubic-bezier(.34,1.56,.64,1);z-index:99;pointer-events:none;}\n  #toast.show{transform:translate(-50%,0);opacity:1;}\n</style>\n</head>\n<body>\n\n<nav>\n  <a class=\"logo\" href=\"#top\"><span class=\"logo-badge\">\u2697</span>WonderLab</a>\n  <ul class=\"nav-links\">\n    <li><a href=\"#exhibits\">Exhibits</a></li>\n    <li><a href=\"#today\">Today</a></li>\n    <li><a href=\"#tickets\">Tickets</a></li>\n    <li><a href=\"#visit\">Visit</a></li>\n  </ul>\n  <a class=\"btn btn-coral\" href=\"#tickets\">Book Tickets</a>\n</nav>\n\n<!-- HERO -->\n<header class=\"hero\" id=\"top\">\n  <div class=\"hero-grid\">\n    <div>\n      <span class=\"kicker\">Now open \u00b7 Ages 2\u201312 (and curious grown-ups)</span>\n      <h1>Science you can <span class=\"squig\">touch, poke\n        <svg viewBox=\"0 0 200 16\" preserveAspectRatio=\"none\"><path d=\"M2 10 Q 25 2 50 9 T 100 9 T 150 9 T 198 8\" fill=\"none\" stroke=\"#FFC531\" stroke-width=\"6\" stroke-linecap=\"round\"/></svg></span>\n        &amp; splash.</h1>\n      <p>WonderLab is a hands-on science museum where every exhibit has a \"please touch\" sign. Build a rollercoaster, launch an air rocket, and make a glorious mess \u2014 we'll handle the cleanup.</p>\n      <div class=\"hero-ctas\">\n        <a class=\"btn btn-coral\" href=\"#tickets\">Plan Your Visit</a>\n        <a class=\"btn\" href=\"#exhibits\">See the Exhibits \u2193</a>\n      </div>\n    </div>\n    <div class=\"hero-visual\">\n      <canvas id=\"stage\"></canvas>\n      <div class=\"doodle d-rocket\">\n        <svg viewBox=\"0 0 64 64\" width=\"72\" height=\"72\"><g class=\"wob\"><path d=\"M32 6 C42 16 44 30 40 42 L24 42 C20 30 22 16 32 6Z\" fill=\"#FF5A4E\" stroke=\"#232534\" stroke-width=\"3\"/><circle cx=\"32\" cy=\"26\" r=\"6\" fill=\"#BFE3F0\" stroke=\"#232534\" stroke-width=\"3\"/><path d=\"M24 42 L16 52 L24 48 Z\" fill=\"#FFC531\" stroke=\"#232534\" stroke-width=\"3\"/><path d=\"M40 42 L48 52 L40 48 Z\" fill=\"#FFC531\" stroke=\"#232534\" stroke-width=\"3\"/><path d=\"M28 42 L32 56 L36 42 Z\" fill=\"#FFC531\" stroke=\"#232534\" stroke-width=\"3\"/></g></svg>\n      </div>\n      <div class=\"doodle d-magnet\">\n        <svg viewBox=\"0 0 64 64\" width=\"64\" height=\"64\"><path d=\"M18 40 V28 a14 14 0 0 1 28 0 v12 h-10 V28 a4 4 0 0 0 -8 0 v12 Z\" fill=\"#FFC531\" stroke=\"#232534\" stroke-width=\"3\"/><rect x=\"18\" y=\"38\" width=\"10\" height=\"8\" fill=\"#FF5A4E\" stroke=\"#232534\" stroke-width=\"3\"/><rect x=\"36\" y=\"38\" width=\"10\" height=\"8\" fill=\"#FF5A4E\" stroke=\"#232534\" stroke-width=\"3\"/></svg>\n      </div>\n      <div class=\"doodle d-flask\">\n        <svg viewBox=\"0 0 64 64\" width=\"56\" height=\"56\"><path d=\"M26 8 h12 v14 l12 24 a6 6 0 0 1 -5 10 H19 a6 6 0 0 1 -5 -10 l12 -24 Z\" fill=\"#FFF6E9\" stroke=\"#232534\" stroke-width=\"3\"/><path d=\"M20 40 h24 l6 8 a4 4 0 0 1 -3 6 H17 a4 4 0 0 1 -3 -6 Z\" fill=\"#0FA6A6\"/><circle cx=\"27\" cy=\"46\" r=\"2.5\" fill=\"#FFF6E9\"/><circle cx=\"37\" cy=\"49\" r=\"2\" fill=\"#FFF6E9\"/></svg>\n      </div>\n      <div class=\"d-star\"></div>\n      <span class=\"hint\">\u2190 drag the balls, click to add more!</span>\n    </div>\n  </div>\n</header>\n\n<!-- MARQUEE -->\n<div class=\"marquee\"><div class=\"marquee-track\" id=\"mq\"></div></div>\n\n<!-- EXHIBITS -->\n<section id=\"exhibits\">\n  <div class=\"sec-head\">\n    <h2><span class=\"num\">01 \u2014 THE HALLS</span>Five floors of \"whoa!\"</h2>\n    <a class=\"btn btn-sun\" href=\"#tickets\">Reserve a slot</a>\n  </div>\n  <div class=\"exhibits\">\n    <div class=\"card c1\">\n      <span class=\"age\">Ages 5+</span>\n      <div class=\"art\">\n        <svg viewBox=\"0 0 260 110\" width=\"90%\">\n          <path d=\"M20 90 C 70 10, 110 110, 160 30 C 185 -5, 225 60, 245 45\" fill=\"none\" stroke=\"#232534\" stroke-width=\"6\" stroke-linecap=\"round\"/>\n          <circle cx=\"20\" cy=\"90\" r=\"12\" fill=\"#FF5A4E\" stroke=\"#232534\" stroke-width=\"4\"><animateMotion dur=\"4s\" repeatCount=\"indefinite\" path=\"M20 90 C 70 10, 110 110, 160 30 C 185 -5, 225 60, 245 45\"/></circle>\n          <text x=\"200\" y=\"100\" font-family=\"Fredoka\" font-size=\"14\" fill=\"#232534\" font-weight=\"600\">wheee!</text>\n        </svg>\n      </div>\n      <h3>The Great Marble Run</h3>\n      <p>A two-story wall of tracks, loops and levers. Crank the elevator, pick your lane, and race a stranger's marble to the bottom. Loser buys the snacks.</p>\n    </div>\n    <div class=\"card c2\">\n      <span class=\"age\">Ages 3+</span>\n      <div class=\"art\">\n        <svg viewBox=\"0 0 120 90\" width=\"130\"><g class=\"wob\"><rect x=\"30\" y=\"20\" width=\"60\" height=\"48\" rx=\"12\" fill=\"#7B5EA7\" stroke=\"#232534\" stroke-width=\"3.5\"/><circle cx=\"50\" cy=\"42\" r=\"7\" fill=\"#fff\" stroke=\"#232534\" stroke-width=\"3\"/><circle cx=\"70\" cy=\"42\" r=\"7\" fill=\"#fff\" stroke=\"#232534\" stroke-width=\"3\"/><circle cx=\"51\" cy=\"43\" r=\"2.5\" fill=\"#232534\"/><circle cx=\"71\" cy=\"43\" r=\"2.5\" fill=\"#232534\"/><path d=\"M50 58 q10 8 20 0\" fill=\"none\" stroke=\"#232534\" stroke-width=\"3\" stroke-linecap=\"round\"/><line x1=\"20\" y1=\"34\" x2=\"30\" y2=\"34\" stroke=\"#232534\" stroke-width=\"3.5\"/><line x1=\"90\" y1=\"34\" x2=\"100\" y2=\"34\" stroke=\"#232534\" stroke-width=\"3.5\"/><line x1=\"52\" y1=\"20\" x2=\"46\" y2=\"8\" stroke=\"#232534\" stroke-width=\"3.5\" stroke-linecap=\"round\"/><circle cx=\"45\" cy=\"6\" r=\"3.5\" fill=\"#FFC531\" stroke=\"#232534\" stroke-width=\"2.5\"/></g></svg>\n      </div>\n      <h3>Robot Petting Zoo</h3>\n      <p>Meet Beeper, our shy robot who only dances when 10 people clap in rhythm. Feed him square \"batteries\" and watch his mood lights change.</p>\n    </div>\n    <div class=\"card c3\">\n      <span class=\"age\">Ages 4+</span>\n      <div class=\"art\">\n        <svg viewBox=\"0 0 120 80\" width=\"120\"><path d=\"M30 30 q10 -14 30 -10 q20 -18 40 4 q14 4 8 18 h-78 q-8 -8 0 -12Z\" fill=\"#fff\" stroke=\"#232534\" stroke-width=\"3.5\" stroke-linejoin=\"round\"/><line x1=\"34\" y1=\"56\" x2=\"28\" y2=\"68\" stroke=\"#0FA6A6\" stroke-width=\"4\" stroke-linecap=\"round\"/><line x1=\"52\" y1=\"58\" x2=\"46\" y2=\"72\" stroke=\"#0FA6A6\" stroke-width=\"4\" stroke-linecap=\"round\"/><line x1=\"70\" y1=\"57\" x2=\"64\" y2=\"70\" stroke=\"#0FA6A6\" stroke-width=\"4\" stroke-linecap=\"round\"/><line x1=\"88\" y1=\"56\" x2=\"82\" y2=\"68\" stroke=\"#0FA6A6\" stroke-width=\"4\" stroke-linecap=\"round\"/></svg>\n      </div>\n      <h3>Weather Works</h3>\n      <p>Spin up a real tornado you can put your hand through, then make it rain indoors over the flood table. Umbrellas provided. Squealing encouraged.</p>\n    </div>\n    <div class=\"card c4\">\n      <span class=\"age\">Ages 6+</span>\n      <div class=\"art\">\n        <svg viewBox=\"0 0 120 80\" width=\"120\"><rect x=\"22\" y=\"14\" width=\"76\" height=\"50\" rx=\"8\" fill=\"#BFE3F0\" stroke=\"#232534\" stroke-width=\"3.5\"/><line x1=\"32\" y1=\"28\" x2=\"70\" y2=\"28\" stroke=\"#232534\" stroke-width=\"3\" stroke-linecap=\"round\"/><line x1=\"32\" y1=\"40\" x2=\"88\" y2=\"40\" stroke=\"#232534\" stroke-width=\"3\" stroke-linecap=\"round\"/><line x1=\"32\" y1=\"52\" x2=\"58\" y2=\"52\" stroke=\"#232534\" stroke-width=\"3\" stroke-linecap=\"round\"/><circle cx=\"86\" cy=\"52\" r=\"5\" fill=\"#FFC531\" stroke=\"#232534\" stroke-width=\"3\"/><line x1=\"44\" y1=\"64\" x2=\"36\" y2=\"74\" stroke=\"#232534\" stroke-width=\"3.5\" stroke-linecap=\"round\"/><line x1=\"76\" y1=\"64\" x2=\"84\" y2=\"74\" stroke=\"#232534\" stroke-width=\"3.5\" stroke-linecap=\"round\"/></svg>\n      </div>\n      <h3>Code &amp; Candy Studio</h3>\n      <p>Drag blocks, steer a tiny rover \u2014 and if your program completes the maze, the machine dispenses one (1) gummy atom. No refunds on eaten electrons.</p>\n    </div>\n    <div class=\"card c5\">\n      <span class=\"age\">All ages</span>\n      <div class=\"art\">\n        <svg viewBox=\"0 0 120 80\" width=\"120\"><path d=\"M20 64 Q 34 20 60 44 Q 86 68 100 24\" fill=\"none\" stroke=\"#232534\" stroke-width=\"4\" stroke-linecap=\"round\"/><path d=\"M20 64 Q 34 20 60 44 Q 86 68 100 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.5\" stroke-dasharray=\"2 8\" stroke-linecap=\"round\"/><circle cx=\"20\" cy=\"64\" r=\"6\" fill=\"#FF5A4E\" stroke=\"#232534\" stroke-width=\"3\"/><circle cx=\"60\" cy=\"44\" r=\"6\" fill=\"#FFC531\" stroke=\"#232534\" stroke-width=\"3\"/><circle cx=\"100\" cy=\"24\" r=\"6\" fill=\"#0FA6A6\" stroke=\"#232534\" stroke-width=\"3\"/></svg>\n      </div>\n      <h3>Splash Lab</h3>\n      <p>Locks, waterwheels, pipes and pumps. Yes, you will get a little wet \u2014 that's the point. Aprons are free, wonder is complimentary too.</p>\n    </div>\n  </div>\n</section>\n\n<!-- SCHEDULE -->\n<section class=\"schedule\" id=\"today\">\n  <div class=\"sec-head\">\n    <h2><span class=\"num\" style=\"color:var(--plum)\">02 \u2014 TODAY'S LINEUP</span>Shows &amp; demos</h2>\n  </div>\n  <div class=\"timeline\">\n    <div class=\"slot\"><time>10:30</time><div><strong>Cryogenics Breakfast Show</strong><small>Frozen bananas, shattering flowers, and one very chilly volunteer.</small></div></div>\n    <div class=\"slot\"><time>12:00</time><div><strong>Meet a Scientist: Volcano Week</strong><small>Dr. Ruiz answers \"but what if Yellowstone?\" for the 400th time. Lovingly.</small></div></div>\n    <div class=\"slot\"><time>14:00</time><div><strong>Elephant Toothpaste Finale</strong><small>The biggest foam eruption of the week, in the Atrium. Front rows get ponchos.</small></div></div>\n    <div class=\"slot\"><time>15:30</time><div><strong>Toddler Tinker Time</strong><small>Soft blocks, giant bubbles and zero screens, for ages 2\u20134.</small></div></div>\n    <div class=\"slot\"><time>16:45</time><div><strong>Close-out Quiz Show</strong><small>Kids vs. grown-ups. The grown-ups have never won. Ever.</small></div></div>\n  </div>\n</section>\n\n<!-- TICKETS -->\n<section id=\"tickets\">\n  <div class=\"sec-head\">\n    <h2><span class=\"num\">03 \u2014 ADMISSION</span>Pick your pass</h2>\n  </div>\n  <div class=\"tickets\">\n    <div class=\"ticket t1\">\n      <div class=\"ticket-head\">Day Explorer</div>\n      <div class=\"ticket-body\">\n        <div class=\"price\"><sup>$</sup>14</div>\n        <ul><li>Full-day access, all halls</li><li>2 live shows included</li><li>Apron for the Splash Lab</li></ul>\n        <button class=\"btn btn-coral\" onclick=\"book('Day Explorer')\">Book this pass</button>\n      </div>\n    </div>\n    <div class=\"ticket t2\">\n      <div class=\"badge-pop\">BEST VALUE</div>\n      <div class=\"ticket-head\">Family Pack</div>\n      <div class=\"ticket-body\">\n        <div class=\"price\"><sup>$</sup>44</div>\n        <ul><li>2 grown-ups + 3 kids</li><li>Unlimited shows all day</li><li>Gummy atom voucher \u00d75</li></ul>\n        <button class=\"btn btn-teal\" onclick=\"book('Family Pack')\">Book this pass</button>\n      </div>\n    </div>\n    <div class=\"ticket t3\">\n      <div class=\"ticket-head\">Lab Member</div>\n      <div class=\"ticket-body\">\n        <div class=\"price\"><sup>$</sup>89<sup style=\"font-size:1rem;color:#5a5d6e\">/yr</sup></div>\n        <ul><li>Unlimited visits for 1 year</li><li>Members-only tinkering nights</li><li>10% off the gift shop</li></ul>\n        <button class=\"btn btn-sun\" onclick=\"book('Lab Member')\">Become a member</button>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- VISIT -->\n<section class=\"visit\" id=\"visit\">\n  <div class=\"visit-grid\">\n    <div>\n      <h2>Come make a mess with us.</h2>\n      <p>We're in the old tram power station by the river \u2014 the big brick one with the giant orange gear bolted to the wall. You can't miss it. Bikes, strollers and excited squealing all welcome; coat check and quiet room are free.</p>\n      <p style=\"margin-top:1rem;\">Under-2s always enter free. Every Thursday from 4pm, pay-what-you-can.</p>\n      <a class=\"btn btn-sun\" style=\"margin-top:1.6rem;\" href=\"#tickets\">Get tickets \u2192</a>\n    </div>\n    <div class=\"hours\">\n      <h3>Opening hours</h3>\n      <dl>\n        <dt>Tuesday \u2013 Friday</dt><dd>9:00 \u2013 17:00</dd>\n        <dt>Saturday</dt><dd>9:00 \u2013 19:00</dd>\n        <dt>Sunday</dt><dd>10:00 \u2013 17:00</dd>\n        <dt>Monday</dt><dd>Closed (robots rest)</dd>\n      </dl>\n    </div>\n  </div>\n</section>\n\n<footer>\n  <span>\u00a9 2025 WonderLab Children's Science Museum \u00b7 42 Dynamo Quay</span>\n  <span><a href=\"#top\">Back to top \u2191</a></span>\n</footer>\n\n<div id=\"toast\"></div>\n\n<script>\n  // ---------- marquee ----------\n  const words = ['EXPLORE','TINKER','ASK WHY','GET MESSY','DISCOVER','PLAY'];\n  const mq = document.getElementById('mq');\n  mq.innerHTML = Array(4).fill(words.map(w=>`<span>${w}</span><span class=\"dot\">\u2733</span>`).join('')).join('');\n\n  // ---------- hero physics playground ----------\n  const cv = document.getElementById('stage'), ctx = cv.getContext('2d');\n  const colors = ['#FF5A4E','#0FA6A6','#FFC531','#7B5EA7','#7CC24B','#BFE3F0'];\n  let balls = [], W, H, dpr = Math.min(devicePixelRatio||1, 2);\n\n  function resize(){\n    const r = cv.parentElement.getBoundingClientRect();\n    W = r.width; H = r.height;\n    cv.width = W*dpr; cv.height = H*dpr; cv.style.width = W+'px'; cv.style.height = H+'px';\n    ctx.setTransform(dpr,0,0,dpr,0,0);\n  }\n  resize(); addEventListener('resize', resize);\n\n  function addBall(x, y, vx, vy, r){\n    balls.push({x, y, vx: vx||0, vy: vy||0, r: r||14+Math.random()*16,\n      c: colors[Math.random()*colors.length|0]});\n  }\n  function seed(){\n    for(let i=0;i<10;i++) addBall(30+Math.random()*(W-60), 30+Math.random()*H*.5,\n      (Math.random()-.5)*4, Math.random()*2);\n  }\n  seed();\n\n  let drag = null, px = 0, py = 0;\n  const pos = e => { const t = e.touches ? e.touches[0] : e;\n    const r = cv.getBoundingClientRect(); return [t.clientX-r.left, t.clientY-r.top]; };\n\n  function down(e){\n    const [x,y] = pos(e);\n    for(let i=balls.length-1;i>=0;i--){\n      const b = balls[i];\n      if((x-b.x)**2+(y-b.y)**2 < b.r*b.r){ drag = b; px=x; py=y; e.preventDefault(); return; }\n    }\n    // empty click \u2192 pop nearest, else add\n    if(balls.length > 6){ balls.splice(Math.random()*balls.length|0,1); }\n    else addBall(x,y);\n    e.preventDefault();\n  }\n  cv.addEventListener('mousedown', down); cv.addEventListener('touchstart', down, {passive:false});\n\n  function move(e){\n    if(!drag) return;\n    const [x,y] = pos(e);\n    drag.vx = (x - px) * .9; drag.vy = (y - py) * .9;\n    drag.x = x; drag.y = y; px = x; py = y; e.preventDefault();\n  }\n  cv.addEventListener('mousemove', move); cv.addEventListener('touchmove', move, {passive:false});\n  const up = () => drag = null;\n  cv.addEventListener('mouseup', up); cv.addEventListener('touchend', up);\n\n  function step(){\n    ctx.clearRect(0,0,W,H);\n    for(const b of balls){\n      if(!drag || drag!==b){\n        b.vy += .32; b.x += b.vx; b.y += b.vy;\n        if(b.x<b.r){b.x=b.r;b.vx*=-.78;} if(b.x>W-b.r){b.x=W-b.r;b.vx*=-.78;}\n        if(b.y<b.r){b.y=b.r;b.vy*=-.78;} if(b.y>H-b.r){b.y=H-b.r;b.vy*=-.78;b.vx*=.985;}\n        b.vx*=.999;\n      }\n      // ball-ball collisions (simple)\n      for(const o of balls){\n        if(o===b) continue;\n        const dx=o.x-b.x, dy=o.y-b.y, d=Math.hypot(dx,dy), min=b.r+o.r;\n        if(d>0 && d<min){\n          const nx=dx/d, ny=dy/d, push=(min-d)/2;\n          b.x-=nx*push; b.y-=ny*push; o.x+=nx*push; o.y+=ny*push;\n          const rel=(b.vx-o.vx)*nx+(b.vy-o.vy)*ny;\n          if(rel>0){ b.vx-=rel*nx*.9; b.vy-=rel*ny*.9; o.vx+=rel*nx*.9; o.vy+=rel*ny*.9; }\n        }\n      }\n      // face\n      const sq = 1 + Math.min(.35, Math.abs(b.vy)*.02);\n      ctx.save(); ctx.translate(b.x,b.y); ctx.scale(1/sq, sq);\n      ctx.beginPath(); ctx.arc(0,0,b.r,0,7); ctx.fillStyle=b.c; ctx.fill();\n      ctx.lineWidth=3; ctx.strokeStyle='#232534'; ctx.stroke();\n      ctx.fillStyle='#232534';\n      ctx.beginPath(); ctx.arc(-b.r*.3,-b.r*.15,b.r*.11,0,7); ctx.fill();\n      ctx.beginPath(); ctx.arc(b.r*.3,-b.r*.15,b.r*.11,0,7); ctx.fill();\n      ctx.beginPath(); ctx.arc(0,b.r*.22,b.r*.3,.25,Math.PI-.25);\n      ctx.lineWidth=2.4; ctx.stroke();\n      ctx.restore();\n    }\n    requestAnimationFrame(step);\n  }\n  step();\n\n  // ---------- toast ----------\n  let tt;\n  function book(name){\n    const t = document.getElementById('toast');\n    t.textContent = `${name} added \u2014 see you at WonderLab! \ud83c\udf89`.replace(' \ud83c\udf89','');\n    t.textContent = `${name} added \u2014 see you at WonderLab!`;\n    t.classList.add('show'); clearTimeout(tt);\n    tt = setTimeout(()=>t.classList.remove('show'), 2600);\n  }\n</script>\n</body>\n</html>\n"}