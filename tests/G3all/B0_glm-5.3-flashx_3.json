{"arm": "direct", "model": "z-ai/glm-5.3-flashx", "i": 3, "finish": "stop", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tidepool \u2014 Plan your week together</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n:root{\n  --ink:#122a2e;\n  --ink-soft:#3d5a5f;\n  --teal:#0e7c7b;\n  --teal-deep:#0a5c5b;\n  --foam:#eef7f5;\n  --sand:#fdf8f1;\n  --coral:#f2745f;\n  --gold:#e8b04b;\n  --line:#d7e6e2;\n  --radius:18px;\n}\n*{margin:0;padding:0;box-sizing:border-box}\nhtml{scroll-behavior:smooth}\nbody{\n  font-family:'Inter',sans-serif;\n  color:var(--ink);\n  background:var(--sand);\n  line-height:1.6;\n  -webkit-font-smoothing:antialiased;\n}\nh1,h2,h3,.serif{font-family:'Fraunces',serif}\n.wrap{max-width:1120px;margin:0 auto;padding:0 24px}\n\n/* ---------- nav ---------- */\nheader{\n  position:sticky;top:0;z-index:50;\n  background:rgba(253,248,241,.88);\n  backdrop-filter:blur(10px);\n  border-bottom:1px solid var(--line);\n}\nnav{display:flex;align-items:center;justify-content:space-between;height:68px}\n.logo{display:flex;align-items:center;gap:10px;font-family:'Fraunces',serif;font-weight:700;font-size:1.3rem;color:var(--ink);text-decoration:none}\n.logo svg{display:block}\n.nav-links{display:flex;align-items:center;gap:28px;list-style:none}\n.nav-links a{color:var(--ink-soft);text-decoration:none;font-size:.92rem;font-weight:500}\n.nav-links a:hover{color:var(--teal)}\n.btn{\n  display:inline-block;padding:11px 22px;border-radius:999px;\n  font-weight:600;font-size:.92rem;text-decoration:none;\n  transition:transform .18s ease, box-shadow .18s ease, background .18s ease;\n}\n.btn-primary{background:var(--teal);color:#fff;box-shadow:0 2px 0 var(--teal-deep)}\n.btn-primary:hover{background:var(--teal-deep);transform:translateY(-2px);box-shadow:0 6px 16px rgba(14,124,123,.28)}\n.btn-ghost{border:1.5px solid var(--line);color:var(--ink)}\n.btn-ghost:hover{border-color:var(--teal);color:var(--teal);transform:translateY(-2px)}\n\n/* ---------- hero ---------- */\n.hero{position:relative;overflow:hidden;padding:88px 0 0;background:linear-gradient(180deg,var(--foam) 0%,var(--sand) 100%)}\n.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center;padding-bottom:72px}\n.eyebrow{\n  display:inline-flex;align-items:center;gap:8px;\n  background:#fff;border:1px solid var(--line);border-radius:999px;\n  padding:6px 14px;font-size:.8rem;font-weight:600;color:var(--teal);\n  margin-bottom:22px;\n}\n.eyebrow .dot{width:7px;height:7px;border-radius:50%;background:var(--coral);animation:pulse 2s infinite}\n@keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}\n.hero h1{font-size:clamp(2.4rem,4.6vw,3.7rem);line-height:1.08;font-weight:600;letter-spacing:-.01em}\n.hero h1 em{font-style:italic;color:var(--teal)}\n.hero p.lede{margin:22px 0 30px;font-size:1.13rem;color:var(--ink-soft);max-width:34rem}\n.hero-cta{display:flex;gap:14px;flex-wrap:wrap;align-items:center}\n.hero-note{font-size:.82rem;color:var(--ink-soft);margin-top:16px}\n\n/* mock app card */\n.mock{\n  background:#fff;border:1px solid var(--line);border-radius:22px;\n  box-shadow:0 24px 60px -20px rgba(10,92,91,.25), 0 2px 8px rgba(18,42,46,.06);\n  overflow:hidden;transform:rotate(1.2deg);\n  transition:transform .3s ease;\n}\n.mock:hover{transform:rotate(0deg) translateY(-4px)}\n.mock-bar{display:flex;align-items:center;gap:6px;padding:13px 16px;border-bottom:1px solid var(--line);background:var(--foam)}\n.mock-bar i{width:10px;height:10px;border-radius:50%;display:block}\n.mock-bar .r{background:#f5b5aa}.mock-bar .y{background:var(--gold)}.mock-bar .g{background:#8fd0b8}\n.mock-bar span{margin-left:auto;font-size:.72rem;color:var(--ink-soft);font-weight:500}\n.mock-body{padding:18px 20px 22px}\n.mock-head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:14px}\n.mock-head h4{font-size:1rem;font-weight:600}\n.mock-head small{font-size:.72rem;color:var(--ink-soft)}\n.day{display:grid;grid-template-columns:44px 1fr;gap:12px;padding:9px 0;border-bottom:1px dashed var(--line);align-items:start}\n.day:last-child{border-bottom:0}\n.day .d{font-size:.72rem;font-weight:600;color:var(--teal);padding-top:3px;text-align:center}\n.chip{\n  font-size:.74rem;font-weight:500;border-radius:9px;padding:6px 10px;\n  display:flex;align-items:center;gap:8px;margin-bottom:5px;\n}\n.chip b{font-weight:600}\n.chip .who{margin-left:auto;font-size:.66rem;opacity:.75}\n.c-teal{background:#e2f2f0;color:var(--teal-deep)}\n.c-coral{background:#fdeae5;color:#b4472f}\n.c-gold{background:#fbf1da;color:#8a6420}\n.c-grey{background:#eef1f0;color:#4a5a58}\n\n/* wave divider */\n.wave{display:block;width:100%;height:70px}\n\n/* ---------- logos strip ---------- */\n.logos{background:#fff;padding:34px 0}\n.logos p{text-align:center;font-size:.78rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-soft);font-weight:600;margin-bottom:22px}\n.logos ul{display:flex;justify-content:center;gap:48px;list-style:none;flex-wrap:wrap}\n.logos li{font-family:'Fraunces',serif;font-weight:600;font-size:1.15rem;color:#9ab3ae}\n\n/* ---------- sections ---------- */\nsection{padding:88px 0}\n.sec-label{font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;font-weight:600;color:var(--coral);margin-bottom:14px}\nh2{font-size:clamp(1.8rem,3vw,2.5rem);line-height:1.15;font-weight:600;max-width:22ch}\n.sec-sub{color:var(--ink-soft);max-width:44rem;margin-top:14px;font-size:1.05rem}\n\n/* how it works */\n.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:26px;margin-top:52px}\n.step{\n  background:#fff;border:1px solid var(--line);border-radius:var(--radius);\n  padding:30px 26px;position:relative;\n  transition:transform .22s ease, box-shadow .22s ease;\n}\n.step:hover{transform:translateY(-6px);box-shadow:0 18px 40px -18px rgba(10,92,91,.28)}\n.step .num{\n  font-family:'Fraunces',serif;font-size:.95rem;font-weight:700;color:#fff;\n  width:34px;height:34px;border-radius:50%;background:var(--teal);\n  display:flex;align-items:center;justify-content:center;margin-bottom:18px;\n}\n.step h3{font-size:1.2rem;margin-bottom:10px}\n.step p{font-size:.93rem;color:var(--ink-soft)}\n.step::after{\n  content:\"\";position:absolute;top:46px;right:-27px;width:26px;height:2px;\n  background:repeating-linear-gradient(90deg,var(--teal) 0 6px,transparent 6px 12px);\n}\n.step:last-child::after{display:none}\n\n/* features */\n.features{background:#fff}\n.feat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px;margin-top:52px}\n.feat{\n  border:1px solid var(--line);border-radius:var(--radius);padding:28px 24px;\n  background:linear-gradient(180deg,#fff, #fbfdfc);\n  transition:border-color .2s ease, transform .2s ease;\n}\n.feat:hover{border-color:var(--teal);transform:translateY(-4px)}\n.feat .icon{\n  width:44px;height:44px;border-radius:12px;background:var(--foam);\n  display:flex;align-items:center;justify-content:center;margin-bottom:18px;color:var(--teal);\n}\n.feat h3{font-size:1.1rem;margin-bottom:8px}\n.feat p{font-size:.92rem;color:var(--ink-soft)}\n\n/* quote */\n.quote{background:var(--foam)}\n.quote blockquote{\n  font-family:'Fraunces',serif;font-size:clamp(1.4rem,2.6vw,2rem);line-height:1.35;\n  max-width:32ch;margin:0 auto;text-align:center;font-weight:600;\n}\n.quote blockquote em{color:var(--teal);font-style:italic}\n.quote cite{display:block;margin-top:24px;text-align:center;font-style:normal;font-size:.9rem;color:var(--ink-soft)}\n.avatar{\n  width:44px;height:44px;border-radius:50%;margin:0 auto 12px;\n  background:radial-gradient(circle at 30% 30%,var(--gold),var(--coral));\n  display:flex;align-items:center;justify-content:center;color:#fff;font-weight:600;font-size:.85rem;\n}\n\n/* cta */\n.cta{\n  background:var(--teal-deep);color:#fff;text-align:center;\n  position:relative;overflow:hidden;\n}\n.cta h2{color:#fff;margin:0 auto;max-width:24ch}\n.cta p{color:#bfe3df;margin:16px auto 32px;max-width:36rem}\n.cta .btn-primary{background:#fff;color:var(--teal-deep);box-shadow:0 2px 0 rgba(0,0,0,.15)}\n.cta .btn-primary:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,0,0,.25)}\n.cta-bubbles{position:absolute;inset:0;pointer-events:none;opacity:.12}\n.cta-bubbles circle{fill:#fff}\n\n/* footer */\nfooter{background:var(--ink);color:#9fc0bc;padding:48px 0;font-size:.88rem}\nfooter .wrap{display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap}\nfooter .logo{color:#fff}\nfooter ul{display:flex;list-style:none;gap:24px}\nfooter a{color:#9fc0bc;text-decoration:none}\nfooter a:hover{color:#fff}\n\n@media(max-width:880px){\n  .hero-grid{grid-template-columns:1fr;padding-bottom:48px}\n  .steps,.feat-grid{grid-template-columns:1fr}\n  .step::after{display:none}\n  .nav-links li:not(:last-child){display:none}\n}\n</style>\n</head>\n<body>\n\n<header>\n  <div class=\"wrap\">\n    <nav>\n      <a class=\"logo\" href=\"#\">\n        <svg width=\"28\" height=\"28\" viewBox=\"0 0 28 28\" fill=\"none\">\n          <circle cx=\"14\" cy=\"14\" r=\"12.5\" fill=\"#0e7c7b\"/>\n          <path d=\"M4 15c3-3.5 5-3.5 8 0s5 3.5 8 0\" stroke=\"#fff\" stroke-width=\"2.2\" stroke-linecap=\"round\" fill=\"none\"/>\n          <path d=\"M6 20c2.5-2.8 4.3-2.8 6.8 0s4.3 2.8 6.8 0\" stroke=\"#8fd0b8\" stroke-width=\"2\" stroke-linecap=\"round\" fill=\"none\" opacity=\".8\"/>\n        </svg>\n        Tidepool\n      </a>\n      <ul class=\"nav-links\">\n        <li><a href=\"#how\">How it works</a></li>\n        <li><a href=\"#features\">Features</a></li>\n        <li><a href=\"#pricing\">Pricing</a></li>\n        <li><a class=\"btn btn-primary\" href=\"#start\">Start free</a></li>\n      </ul>\n    </nav>\n  </div>\n</header>\n\n<main>\n  <section class=\"hero\">\n    <div class=\"wrap hero-grid\">\n      <div>\n        <span class=\"eyebrow\"><span class=\"dot\"></span> Monday planning, minus the meeting sprawl</span>\n        <h1>Plan your week together, <em>like the tide</em> \u2014 calm, shared, on rhythm.</h1>\n        <p class=\"lede\">Tidepool is a shared weekly planner for small teams. Everyone sees who's doing what, spot overload before it happens, and roll unfinished work forward \u2014 in five minutes, not a status meeting.</p>\n        <div class=\"hero-cta\">\n          <a class=\"btn btn-primary\" href=\"#start\">Start your first week \u2014 free</a>\n          <a class=\"btn btn-ghost\" href=\"#how\">See how it works</a>\n        </div>\n        <p class=\"hero-note\">Free for teams up to 5 \u00b7 No credit card required</p>\n      </div>\n\n      <div class=\"mock\" aria-hidden=\"true\">\n        <div class=\"mock-bar\"><i class=\"r\"></i><i class=\"y\"></i><i class=\"g\"></i><span>Week of Feb 10 \u00b7 3 teammates</span></div>\n        <div class=\"mock-body\">\n          <div class=\"mock-head\">\n            <h4>This week's tide</h4>\n            <small>14 tasks \u00b7 2 floating</small>\n          </div>\n          <div class=\"day\">\n            <div class=\"d\">Mon</div>\n            <div>\n              <div class=\"chip c-teal\"><b>Ship onboarding v2</b><span class=\"who\">Maya</span></div>\n              <div class=\"chip c-grey\">Team sync \u2014 10:00</div>\n            </div>\n          </div>\n          <div class=\"day\">\n            <div class=\"d\">Tue</div>\n            <div>\n              <div class=\"chip c-coral\"><b>Customer interviews (3)</b><span class=\"who\">Jonas</span></div>\n            </div>\n          </div>\n          <div class=\"day\">\n            <div class=\"d\">Wed</div>\n            <div>\n              <div class=\"chip c-gold\"><b>Draft pricing page copy</b><span class=\"who\">Priya</span></div>\n              <div class=\"chip c-teal\"><b>Review interview notes</b><span class=\"who\">Maya</span></div>\n            </div>\n          </div>\n          <div class=\"day\">\n            <div class=\"d\">Thu</div>\n            <div>\n              <div class=\"chip c-coral\"><b>Retro &amp; next week's plan</b><span class=\"who\">Everyone</span></div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n    <svg class=\"wave\" viewBox=\"0 0 1440 70\" preserveAspectRatio=\"none\">\n      <path d=\"M0,40 C240,80 480,0 720,30 C960,60 1200,10 1440,40 L1440,70 L0,70 Z\" fill=\"#ffffff\"/>\n    </svg>\n  </section>\n\n  <div class=\"logos\">\n    <div class=\"wrap\">\n      <p>Trusted by small teams at</p>\n      <ul>\n        <li>Driftwood&nbsp;Studio</li>\n        <li>Ninepin</li>\n        <li>Fern&amp;Co</li>\n        <li>Harborline</li>\n        <li>Saltmarsh&nbsp;Labs</li>\n      </ul>\n    </div>\n  </div>\n\n  <section id=\"how\">\n    <div class=\"wrap\">\n      <p class=\"sec-label\">How it works</p>\n      <h2>One shared plan. Three gentle rituals.</h2>\n      <p class=\"sec-sub\">Tidepool isn't another project tracker. It's the weekly rhythm your team actually keeps \u2014 lightweight enough to survive a busy Tuesday.</p>\n      <div class=\"steps\">\n        <div class=\"step\">\n          <div class=\"num\">1</div>\n          <h3>Pull in Monday</h3>\n          <p>Start the week with a 5-minute planning round. Each teammate drops their focus items \u2014 no meeting required, async or together.</p>\n        </div>\n        <div class=\"step\">\n          <div class=\"num\">2</div>\n          <h3>Drift through the week</h3>\n          <p>Everyone's plans live on one shared board. Tidepool flags when someone's overloaded and nudges tasks before they slip quietly away.</p>\n        </div>\n        <div class=\"step\">\n          <div class=\"num\">3</div>\n          <h3>Let the tide carry it</h3>\n          <p>Unfinished work doesn't vanish \u2014 it floats to next week automatically, with a note on why, so Fridays end with clarity instead of guilt.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"features\" id=\"features\">\n    <div class=\"wrap\">\n      <p class=\"sec-label\">Features</p>\n      <h2>Small tool. Just the right depth.</h2>\n      <p class=\"sec-sub\">Everything you need for weekly planning, and nothing that turns into a second job.</p>\n      <div class=\"feat-grid\">\n        <div class=\"feat\">\n          <div class=\"icon\">\n            <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"9\" cy=\"8\" r=\"3.2\"/><path d=\"M3 20c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5\"/><path d=\"M16 5.5a3.2 3.2 0 010 5M18.5 14.8c1.8.8 2.5 2.6 2.5 4.2\"/></svg>\n          </div>\n          <h3>Shared week view</h3>\n          <p>One page shows every teammate's focus for the week. No more \"wait, who's on this?\"</p>\n        </div>\n        <div class=\"feat\">\n          <div class=\"icon\">\n            <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M12 3c2.5 3 2.5 5-0 8s-2.5 5 0 8\"/><path d=\"M5 6c1.8 2.2 1.8 3.8 0 6M19 6c-1.8 2.2-1.8 3.8 0 6\"/></svg>\n          </div>\n          <h3>Load balancing</h3>\n          <p>Tidepool spots when one person's week is bursting and suggests who can take the drift.</p>\n        </div>\n        <div class=\"feat\">\n          <div class=\"icon\">\n            <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M3 12a9 9 0 019-9\"/><path d=\"M21 12a9 9 0 01-9 9\"/><path d=\"M12 7v5l3 2\"/></svg>\n          </div>\n          <h3>Floating tasks</h3>\n          <p>Work that doesn't get done rolls forward automatically \u2014 visible, never silently lost.</p>\n        </div>\n        <div class=\"feat\">\n          <div class=\"icon\">\n            <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M4 11a8 8 0 0114.9-4M20 13a8 8 0 01-14.9 4\"/><path d=\"M18 3v4h-4M6 21v-4h4\"/></svg>\n          </div>\n          <h3>Async check-ins</h3>\n          <p>Friday wrap-ups happen in the tool: what moved, what floated, what's next.</p>\n        </div>\n        <div class=\"feat\">\n          <div class=\"icon\">\n            <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M3 9h18M8 3v4M16 3v4\"/></svg>\n          </div>\n          <h3>Calendar harmony</h3>\n          <p>Two-way sync with Google &amp; Outlook, so meetings and focus work never collide.</p>\n        </div>\n        <div class=\"feat\">\n          <div class=\"icon\">\n            <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M12 3l2.5 5.5L20 9l-4 4 1 6-5-3-5 3 1-6-4-4 5.5-.5z\"/></svg>\n          </div>\n          <h3>Weekly rhythm report</h3>\n          <p>A gentle Monday digest of last week's flow \u2014 wins, floats, and patterns over time.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"quote\">\n    <div class=\"wrap\">\n      <div class=\"avatar\">SL</div>\n      <blockquote>\"We replaced our Monday status meeting with Tidepool in a week. Now our plans actually <em>ebb and flow</em> with reality instead of fighting it.\"</blockquote>\n      <cite>Sana Lindqvist \u00b7 Co-founder, Saltmarsh Labs (team of 7)</cite>\n    </div>\n  </section>\n\n  <section class=\"cta\" id=\"start\">\n    <svg class=\"cta-bubbles\" viewBox=\"0 0 1200 400\" preserveAspectRatio=\"xMidYMid slice\" aria-hidden=\"true\">\n      <circle cx=\"120\" cy=\"320\" r=\"90\"/><circle cx=\"1050\" cy=\"80\" r=\"120\"/>\n      <circle cx=\"620\" cy=\"380\" r=\"70\"/><circle cx=\"900\" cy=\"330\" r=\"50\"/>\n    </svg>\n    <div class=\"wrap\" style=\"position:relative\">\n      <p class=\"sec-label\" style=\"color:var(--gold)\">Get started</p>\n      <h2>Your team's calmest week starts Monday.</h2>\n      <p>Set up your first shared week in under two minutes. Free for teams up to 5, forever.</p>\n      <a class=\"btn btn-primary\" href=\"#\">Create your team's tidepool \u2192</a>\n    </div>\n  </section>\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <a class=\"logo\" href=\"#\">\n      <svg width=\"24\" height=\"24\" viewBox=\"0 0 28 28\" fill=\"none\">\n        <circle cx=\"14\" cy=\"14\" r=\"12.5\" fill=\"#0e7c7b\"/>\n        <path d=\"M4 15c3-3.5 5-3.5 8 0s5 3.5 8 0\" stroke=\"#fff\" stroke-width=\"2.2\" stroke-linecap=\"round\" fill=\"none\"/>\n      </svg>\n      Tidepool\n    </a>\n    <ul>\n      <li><a href=\"#how\">How it works</a></li>\n      <li><a href=\"#features\">Features</a></li>\n      <li><a href=\"#pricing\">Pricing</a></li>\n      <li><a href=\"#\">Privacy</a></li>\n      <li><a href=\"#\">hello@tidepool.app</a></li>\n    </ul>\n    <span>\u00a9 2025 Tidepool</span>\n  </div>\n</footer>\n\n</body>\n</html>\n"}