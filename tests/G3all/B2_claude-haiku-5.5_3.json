{"brief": "B2", "model": "anthropic/claude-haiku-5.5", "i": 3, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Sparkwell Science Museum for Kids | Where Curious Minds Explore</title>\n  <meta name=\"description\" content=\"Hands-on science galleries, a planetarium, and daily experiments for kids ages 0 to 12.\">\n  <style>\n    /* ---------- Design tokens ---------- */\n    :root {\n      --navy: #1d2a5b;\n      --navy-deep: #121a3d;\n      --sun: #ffc83d;\n      --teal: #17b8a6;\n      --coral: #ff6b5b;\n      --lilac: #9b84ee;\n      --sky: #5cc8ff;\n      --cream: #fff9ee;\n      --ink: #1f2440;\n      --muted: #5b6185;\n      --white: #ffffff;\n      --radius: 22px;\n      --shadow: 0 12px 30px -12px rgba(29, 42, 91, 0.35);\n      --font-display: \"Trebuchet MS\", \"Avenir Next\", \"Segoe UI\", system-ui, sans-serif;\n      --font-body: \"Segoe UI\", \"Helvetica Neue\", Arial, system-ui, sans-serif;\n    }\n\n    /* ---------- Base ---------- */\n    *, *::before, *::after { box-sizing: border-box; }\n    html { scroll-behavior: smooth; }\n    body {\n      margin: 0;\n      font-family: var(--font-body);\n      color: var(--ink);\n      background: var(--cream);\n      line-height: 1.6;\n      -webkit-font-smoothing: antialiased;\n    }\n    h1, h2, h3 { font-family: var(--font-display); line-height: 1.15; margin: 0 0 .5em; color: var(--navy); }\n    h1 { font-size: clamp(2.5rem, 6vw, 4.2rem); letter-spacing: -0.02em; }\n    h2 { font-size: clamp(2rem, 4vw, 2.8rem); }\n    h3 { font-size: 1.3rem; }\n    p { margin: 0 0 1em; }\n    a { color: inherit; }\n    img, svg { display: block; max-width: 100%; }\n    :focus-visible { outline: 3px solid var(--sun); outline-offset: 3px; border-radius: 6px; }\n    .container { width: min(1140px, 92%); margin: 0 auto; }\n    section { padding: clamp(64px, 9vw, 110px) 0; position: relative; }\n    .eyebrow {\n      display: inline-block;\n      font-family: var(--font-display);\n      font-weight: 700;\n      font-size: .8rem;\n      letter-spacing: .14em;\n      text-transform: uppercase;\n      color: var(--coral);\n      margin-bottom: .75rem;\n    }\n    .lead { font-size: 1.15rem; color: var(--muted); max-width: 60ch; }\n    .section-head { text-align: center; margin-bottom: 3rem; }\n    .section-head .lead { margin: 0 auto; }\n\n    /* ---------- Buttons ---------- */\n    .btn {\n      display: inline-flex; align-items: center; justify-content: center; gap: .5rem;\n      padding: .9rem 1.6rem; border-radius: 999px; border: 2px solid transparent;\n      font-family: var(--font-display); font-weight: 700; font-size: 1rem;\n      text-decoration: none; cursor: pointer; transition: transform .2s ease, box-shadow .2s ease, background .2s ease;\n      white-space: nowrap;\n    }\n    .btn:hover { transform: translateY(-3px); }\n    .btn-primary { background: var(--sun); color: var(--navy-deep); box-shadow: 0 8px 0 #e0a60f; }\n    .btn-primary:hover { box-shadow: 0 11px 0 #e0a60f; }\n    .btn-primary:active { transform: translateY(3px); box-shadow: 0 3px 0 #e0a60f; }\n    .btn-ghost { background: transparent; color: var(--white); border-color: var(--white); }\n    .btn-ghost:hover { background: rgba(255,255,255,.12); }\n    .btn-navy { background: var(--navy); color: var(--white); }\n    .btn-navy:hover { background: var(--navy-deep); }\n\n    /* ---------- Header ---------- */\n    .site-header {\n      position: sticky; top: 0; z-index: 50;\n      background: rgba(255, 249, 238, .92);\n      backdrop-filter: blur(10px);\n      border-bottom: 1px solid rgba(29,42,91,.08);\n    }\n    .nav { display: flex; align-items: center; justify-content: space-between; height: 76px; gap: 1rem; }\n    .logo { display: flex; align-items: center; gap: .6rem; text-decoration: none; font-family: var(--font-display); font-weight: 800; color: var(--navy); font-size: 1.25rem; }\n    .logo small { display: block; font-weight: 600; font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--teal); }\n    .nav-links { display: flex; gap: 1.8rem; list-style: none; margin: 0; padding: 0; }\n    .nav-links a { text-decoration: none; font-weight: 600; color: var(--navy); position: relative; }\n    .nav-links a::after { content: \"\"; position: absolute; left: 0; bottom: -6px; width: 0; height: 3px; border-radius: 3px; background: var(--coral); transition: width .25s ease; }\n    .nav-links a:hover::after { width: 100%; }\n    .nav-cta { display: flex; align-items: center; gap: .75rem; }\n    .menu-toggle { display: none; }\n    .menu-btn {\n      display: none; cursor: pointer; width: 44px; height: 44px; border-radius: 12px;\n      background: var(--navy); align-items: center; justify-content: center; flex-direction: column; gap: 5px;\n    }\n    .menu-btn span { width: 20px; height: 2.5px; background: var(--white); border-radius: 2px; }\n\n    /* ---------- Hero ---------- */\n    .hero {\n      padding: clamp(48px, 8vw, 100px) 0 clamp(72px, 10vw, 120px);\n      background:\n        radial-gradient(circle at 15% 20%, rgba(255,200,61,.35), transparent 40%),\n        radial-gradient(circle at 90% 10%, rgba(92,200,255,.35), transparent 40%),\n        radial-gradient(circle at 80% 90%, rgba(155,132,238,.3), transparent 45%),\n        var(--cream);\n      overflow: hidden;\n    }\n    .hero-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 3rem; align-items: center; }\n    .hero h1 span { color: var(--coral); }\n    .hero-actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; }\n    .hero-badges { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 2rem; }\n    .badge {\n      background: var(--white); border-radius: 999px; padding: .4rem .9rem;\n      font-size: .9rem; font-weight: 600; color: var(--navy); box-shadow: 0 4px 12px rgba(29,42,91,.08);\n    }\n    .hero-art { position: relative; aspect-ratio: 1; width: min(480px, 100%); margin: 0 auto; }\n    .orbit-core {\n      position: absolute; inset: 30%; border-radius: 50%;\n      background: radial-gradient(circle at 35% 35%, #fff, var(--sun) 45%, #f39c12);\n      box-shadow: 0 0 60px 10px rgba(255,200,61,.5), inset -10px -10px 25px rgba(0,0,0,.08);\n      animation: pulse 3.5s ease-in-out infinite;\n    }\n    .orbit {\n      position: absolute; top: 50%; left: 50%; border: 3px dashed rgba(29,42,91,.25); border-radius: 50%;\n      transform: translate(-50%, -50%);\n    }\n    .orbit.o1 { width: 62%; height: 62%; animation: spin 14s linear infinite; }\n    .orbit.o2 { width: 86%; height: 86%; animation: spin 22s linear infinite reverse; }\n    .orbit.o3 { width: 100%; height: 100%; animation: spin 30s linear infinite; border-color: rgba(23,184,166,.35); }\n    .planet {\n      position: absolute; top: -10px; left: 50%; width: 22px; height: 22px; margin-left: -11px; border-radius: 50%;\n      box-shadow: inset -4px -4px 8px rgba(0,0,0,.15);\n    }\n    .planet.p1 { background: var(--teal); }\n    .planet.p2 { background: var(--coral); width: 28px; height: 28px; margin-left: -14px; }\n    .planet.p3 { background: var(--lilac); }\n    .float-card {\n      position: absolute; background: var(--white); border-radius: 18px; padding: .8rem 1rem;\n      box-shadow: var(--shadow); font-weight: 700; color: var(--navy); font-family: var(--font-display);\n      display: flex; align-items: center; gap: .6rem; font-size: .95rem;\n      animation: bob 5s ease-in-out infinite;\n    }\n    .float-card .dot { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; font-size: 1.1rem; }\n    .fc1 { top: 6%; left: -4%; }\n    .fc2 { bottom: 10%; right: -2%; animation-delay: -2s; }\n    .fc3 { top: 58%; left: -8%; animation-delay: -1s; }\n\n    @keyframes spin { to { transform: translate(-50%, -50%) rotate(360deg); } }\n    @keyframes pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.06); } }\n    @keyframes bob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }\n\n    /* ---------- Stats strip ---------- */\n    .stats { background: var(--navy); color: var(--white); padding: 40px 0; }\n    .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; text-align: center; }\n    .stat-num { font-family: var(--font-display); font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 800; color: var(--sun); line-height: 1; }\n    .stat-label { font-size: .95rem; opacity: .85; margin-top: .4rem; }\n\n    /* ---------- Exhibits ---------- */\n    .exhibits-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.6rem; }\n    .exhibit {\n      background: var(--white); border-radius: var(--radius); padding: 1.8rem;\n      box-shadow: var(--shadow); transition: transform .3s ease, box-shadow .3s ease;\n      position: relative; overflow: hidden; border: 1px solid rgba(29,42,91,.06);\n    }\n    .exhibit:hover { transform: translateY(-6px) rotate(-.5deg); box-shadow: 0 22px 40px -16px rgba(29,42,91,.4); }\n    .exhibit .icon {\n      width: 70px; height: 70px; border-radius: 20px; display: grid; place-items: center; font-size: 2.2rem; margin-bottom: 1.2rem;\n    }\n    .exhibit .tag {\n      position: absolute; top: 1.4rem; right: 1.4rem; font-size: .75rem; font-weight: 700;\n      padding: .25rem .65rem; border-radius: 999px; background: var(--cream); color: var(--navy);\n    }\n    .exhibit .ages { font-size: .85rem; color: var(--muted); font-weight: 600; margin-bottom: .6rem; }\n    .c-sun { background: #fff1c7; } .c-teal { background: #d3f6f1; } .c-coral { background: #ffe0dc; }\n    .c-lilac { background: #ebe5ff; } .c-sky { background: #d8f0ff; } .c-lime { background: #e4f9cf; }\n\n    /* ---------- Planetarium band ---------- */\n    .cosmos {\n      background:\n        radial-gradient(1.5px 1.5px at 10% 20%, #fff, transparent),\n        radial-gradient(1px 1px at 30% 70%, #fff, transparent),\n        radial-gradient(2px 2px at 55% 15%, #ffe9a8, transparent),\n        radial-gradient(1px 1px at 75% 60%, #fff, transparent),\n        radial-gradient(1.5px 1.5px at 90% 30%, #bfe9ff, transparent),\n        radial-gradient(1px 1px at 45% 85%, #fff, transparent),\n        linear-gradient(160deg, var(--navy-deep), #2b1e5c 60%, #1a3a6b);\n      color: var(--white); overflow: hidden;\n    }\n    .cosmos h2, .cosmos h3 { color: var(--white); }\n    .cosmos .eyebrow { color: var(--sun); }\n    .cosmos-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }\n    .cosmos p { opacity: .88; font-size: 1.05rem; }\n    .checklist { list-style: none; padding: 0; margin: 1.5rem 0 2rem; }\n    .checklist li { display: flex; gap: .75rem; margin-bottom: .75rem; align-items: flex-start; }\n    .checklist li::before {\n      content: \"\u2726\"; color: var(--sun); font-size: 1.1rem; line-height: 1.5;\n    }\n    .dome {\n      position: relative; aspect-ratio: 1; width: min(440px, 100%); margin: 0 auto; border-radius: 50%;\n      background: radial-gradient(circle at 50% 30%, #2d4d9a, #111d47 70%);\n      box-shadow: inset 0 0 60px rgba(92,200,255,.25), 0 0 80px rgba(92,200,255,.2);\n      overflow: hidden;\n    }\n    .dome .star { position: absolute; background: #fff; border-radius: 50%; animation: twinkle 3s ease-in-out infinite; }\n    .dome .star:nth-child(odd) { animation-duration: 4.2s; }\n    .dome .constellation { position: absolute; inset: 0; width: 100%; height: 100%; }\n    .dome-label {\n      position: absolute; bottom: 14%; left: 50%; transform: translateX(-50%);\n      background: rgba(255,255,255,.14); backdrop-filter: blur(6px); border: 1px solid rgba(255,255,255,.25);\n      padding: .5rem 1rem; border-radius: 999px; font-weight: 700; font-size: .9rem; white-space: nowrap;\n    }\n    @keyframes twinkle { 0%,100% { opacity: .3; } 50% { opacity: 1; } }\n\n    /* ---------- Visit info ---------- */\n    .visit-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.6rem; }\n    .card {\n      background: var(--white); border-radius: var(--radius); padding: 2rem; box-shadow: var(--shadow);\n    }\n    .card .big-emoji { font-size: 2.4rem; margin-bottom: .6rem; }\n    .hours { width: 100%; border-collapse: collapse; margin-top: .5rem; font-size: .98rem; }\n    .hours td { padding: .5rem 0; border-bottom: 1px dashed rgba(29,42,91,.15); }\n    .hours td:last-child { text-align: right; font-weight: 700; color: var(--navy); }\n    .open-now {\n      display: inline-flex; align-items: center; gap: .4rem; font-size: .85rem; font-weight: 700;\n      background: #dcfaef; color: #0b7a62; padding: .3rem .7rem; border-radius: 999px; margin-bottom: .8rem;\n    }\n    .open-now::before { content: \"\"; width: 8px; height: 8px; border-radius: 50%; background: var(--teal); animation: twinkle 2s infinite; }\n    .price-list { list-style: none; padding: 0; margin: 0 0 1.4rem; }\n    .price-list li { display: flex; justify-content: space-between; padding: .6rem 0; border-bottom: 1px dashed rgba(29,42,91,.15); }\n    .price-list strong { color: var(--navy); }\n    .price-list small { color: var(--muted); display: block; }\n    .address p { margin-bottom: .4rem; }\n    .map-placeholder {\n      margin-top: 1rem; height: 130px; border-radius: 16px;\n      background:\n        linear-gradient(90deg, transparent 48%, #fff 48%, #fff 52%, transparent 52%),\n        linear-gradient(0deg, transparent 48%, #fff 48%, #fff 52%, transparent 52%),\n        linear-gradient(135deg, #d8f6ec, #cfe9ff);\n      position: relative; border: 1px solid rgba(29,42,91,.1);\n    }\n    .map-placeholder::after {\n      content: \"\ud83d\udccd\"; position: absolute; left: 50%; top: 50%; transform: translate(-50%, -80%); font-size: 1.8rem;\n    }\n\n    /* ---------- Events ---------- */\n    .events { background: linear-gradient(180deg, var(--cream), #fff1db); }\n    .events-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.6rem; }\n    .event { display: flex; gap: 1.2rem; background: var(--white); border-radius: var(--radius); padding: 1.4rem; box-shadow: var(--shadow); align-items: flex-start; }\n    .date-chip {\n      flex: 0 0 74px; text-align: center; border-radius: 16px; padding: .6rem .4rem; background: var(--navy); color: var(--white);\n    }\n    .date-chip .mon { font-size: .75rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--sun); }\n    .date-chip .day { font-family: var(--font-display); font-size: 1.9rem; font-weight: 800; line-height: 1.1; }\n    .event h3 { font-size: 1.08rem; margin-bottom: .3rem; }\n    .event p { font-size: .92rem; color: var(--muted); margin: 0; }\n    .event .time { font-size: .85rem; font-weight: 700; color: var(--coral); margin-top: .4rem; display: block; }\n\n    /* ---------- Membership ---------- */\n    .membership {\n      background: linear-gradient(120deg, var(--coral), #ff8a5c 40%, var(--sun));\n      color: var(--navy-deep); border-radius: 32px; padding: clamp(2.5rem, 5vw, 4rem);\n      display: grid; grid-template-columns: 1.3fr 1fr; gap: 2.5rem; align-items: center; position: relative; overflow: hidden;\n      box-shadow: 0 25px 50px -20px rgba(255,107,91,.6);\n    }\n    .membership::after {\n      content: \"\"; position: absolute; width: 300px; height: 300px; border-radius: 50%; right: -80px; top: -120px;\n      background: rgba(255,255,255,.18);\n    }\n    .membership h2 { color: var(--navy-deep); }\n    .membership p { font-size: 1.08rem; }\n    .tiers { display: grid; gap: .8rem; position: relative; z-index: 1; }\n    .tier {\n      background: rgba(255,255,255,.92); border-radius: 18px; padding: 1rem 1.2rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem;\n    }\n    .tier strong { font-family: var(--font-display); font-size: 1.1rem; color: var(--navy); }\n    .tier span { font-weight: 700; color: var(--coral); white-space: nowrap; }\n    .membership .btn { margin-top: 1rem; }\n\n    /* ---------- Newsletter / footer ---------- */\n    .site-footer { background: var(--navy-deep); color: rgba(255,255,255,.8); padding: 72px 0 32px; }\n    .footer-grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1.4fr; gap: 2.5rem; }\n    .site-footer h4 { font-family: var(--font-display); color: var(--white); margin: 0 0 1rem; font-size: 1rem; }\n    .site-footer ul { list-style: none; padding: 0; margin: 0; }\n    .site-footer li { margin-bottom: .55rem; }\n    .site-footer a { text-decoration: none; opacity: .85; }\n    .site-footer a:hover { opacity: 1; color: var(--sun); }\n    .site-footer .logo { color: var(--white); }\n    .site-footer .logo small { color: var(--sun); }\n    .news-form { display: flex; gap: .5rem; margin-top: .5rem; flex-wrap: wrap; }\n    .news-form input {\n      flex: 1 1 180px; padding: .8rem 1rem; border-radius: 999px; border: 2px solid rgba(255,255,255,.2);\n      background: rgba(255,255,255,.08); color: var(--white); font: inherit;\n    }\n    .news-form input::placeholder { color: rgba(255,255,255,.55); }\n    .news-form input:focus { outline: none; border-color: var(--sun); }\n    .news-form button { padding: .8rem 1.3rem; border-radius: 999px; border: none; background: var(--sun); color: var(--navy-deep); font-weight: 700; cursor: pointer; font-family: var(--font-display); }\n    .fine { border-top: 1px solid rgba(255,255,255,.12); margin-top: 3rem; padding-top: 1.5rem; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; font-size: .88rem; }\n\n    /* ---------- Responsive ---------- */\n    @media (max-width: 960px) {\n      .hero-grid, .cosmos-grid, .membership { grid-template-columns: 1fr; }\n      .hero-art { order: -1; width: min(380px, 90%); }\n      .exhibits-grid, .events-grid, .visit-grid { grid-template-columns: repeat(2, 1fr); }\n      .footer-grid { grid-template-columns: 1fr 1fr; }\n      .stats-grid { grid-template-columns: repeat(2, 1fr); }\n    }\n    @media (max-width: 760px) {\n      .menu-btn { display: flex; }\n      .nav-links {\n        position: absolute; top: 76px; left: 0; right: 0; background: var(--cream); flex-direction: column; gap: 0;\n        padding: 0 4%; max-height: 0; overflow: hidden; transition: max-height .35s ease, padding .35s ease; box-shadow: var(--shadow);\n      }\n      .nav-links li { border-bottom: 1px solid rgba(29,42,91,.08); }\n      .nav-links a { display: block; padding: 1rem 0; }\n      .nav-links a::after { display: none; }\n      .menu-toggle:checked ~ .nav-links { max-height: 360px; padding: .5rem 4% 1rem; }\n      .nav-cta .btn { display: none; }\n      .exhibits-grid, .events-grid, .visit-grid { grid-template-columns: 1fr; }\n      .float-card { font-size: .8rem; }\n      .fc1 { left: 0; } .fc3 { left: 0; }\n    }\n    @media (max-width: 480px) {\n      .footer-grid { grid-template-columns: 1fr; }\n      .stats-grid { grid-template-columns: repeat(2, 1fr); }\n      .hero-actions .btn { width: 100%; }\n    }\n    @media (prefers-reduced-motion: reduce) {\n      *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; }\n    }\n  </style>\n</head>\n<body>\n\n  <!-- ============ HEADER ============ -->\n  <header class=\"site-header\">\n    <div class=\"container nav\">\n      <a href=\"#top\" class=\"logo\" aria-label=\"Sparkwell Science Museum home\">\n        <svg width=\"42\" height=\"42\" viewBox=\"0 0 42 42\" aria-hidden=\"true\">\n          <circle cx=\"21\" cy=\"21\" r=\"8\" fill=\"#ffc83d\"/>\n          <ellipse cx=\"21\" cy=\"21\" rx=\"19\" ry=\"7\" fill=\"none\" stroke=\"#17b8a6\" stroke-width=\"2.5\" transform=\"rotate(-25 21 21)\"/>\n          <ellipse cx=\"21\" cy=\"21\" rx=\"19\" ry=\"7\" fill=\"none\" stroke=\"#ff6b5b\" stroke-width=\"2.5\" transform=\"rotate(35 21 21)\"/>\n          <circle cx=\"35\" cy=\"13\" r=\"3\" fill=\"#9b84ee\"/>\n        </svg>\n        <div>Sparkwell<small>Science Museum for Kids</small></div>\n      </a>\n\n      <input type=\"checkbox\" id=\"menu-toggle\" class=\"menu-toggle\" aria-label=\"Toggle navigation\">\n      <label for=\"menu-toggle\" class=\"menu-btn\" aria-hidden=\"true\"><span></span><span></span><span></span></label>\n\n      <nav aria-label=\"Main navigation\">\n        <ul class=\"nav-links\">\n          <li><a href=\"#exhibits\">Exhibits</a></li>\n          <li><a href=\"#planetarium\">Planetarium</a></li>\n          <li><a href=\"#visit\">Plan Your Visit</a></li>\n          <li><a href=\"#events\">Events</a></li>\n          <li><a href=\"#membership\">Membership</a></li>\n        </ul>\n      </nav>\n\n      <div class=\"nav-cta\">\n        <a href=\"#tickets\" class=\"btn btn-navy\">Get Tickets</a>\n      </div>\n    </div>\n  </header>\n\n  <main id=\"top\">\n\n    <!-- ============ HERO ============ -->\n    <section class=\"hero\">\n      <div class=\"container hero-grid\">\n        <div>\n          <span class=\"eyebrow\">Ages 0 to 12 \u00b7 Open every day</span>\n          <h1>Where little minds <span>ask big questions.</span></h1>\n          <p class=\"lead\">Build, poke, pour, and discover in more than a dozen hands-on galleries designed for curious kids. Every visit is a new experiment, and every answer leads to another question.</p>\n          <div class=\"hero-actions\">\n            <a href=\"#tickets\" class=\"btn btn-primary\">Buy Tickets</a>\n            <a href=\"#exhibits\" class=\"btn btn-navy\">Explore Exhibits</a>\n          </div>\n          <div class=\"hero-badges\">\n            <span class=\"badge\">\ud83e\uddea 300+ experiments</span>\n            <span class=\"badge\">\ud83d\udd2d Dome planetarium</span>\n            <span class=\"badge\">\ud83d\udc76 Toddler play zone</span>\n          </div>\n        </div>\n\n        <div class=\"hero-art\" aria-hidden=\"true\">\n          <div class=\"orbit o3\"><span class=\"planet p1\"></span></div>\n          <div class=\"orbit o2\"><span class=\"planet p2\"></span></div>\n          <div class=\"orbit o1\"><span class=\"planet p3\"></span></div>\n          <div class=\"orbit-core\"></div>\n          <div class=\"float-card fc1\"><span class=\"dot\" style=\"background:#d3f6f1\">\ud83e\uddf2</span>Magnets!</div>\n          <div class=\"float-card fc2\"><span class=\"dot\" style=\"background:#ffe0dc\">\ud83c\udf0b</span>Erupt a volcano</div>\n          <div class=\"float-card fc3\"><span class=\"dot\" style=\"background:#ebe5ff\">\ud83e\udd16</span>Build a robot</div>\n        </div>\n      </div>\n    </section>\n\n    <!-- ============ STATS ============ -->\n    <div class=\"stats\" role=\"region\" aria-label=\"Museum at a glance\">\n      <div class=\"container stats-grid\">\n        <div><div class=\"stat-num\">12</div><div class=\"stat-label\">Hands-on galleries</div></div>\n        <div><div class=\"stat-num\">300+</div><div class=\"stat-label\">Experiments to try</div></div>\n        <div><div class=\"stat-num\">45</div><div class=\"stat-label\">Minutes of daily shows</div></div>\n        <div><div class=\"stat-num\">1M+</div><div class=\"stat-label\">Young explorers since 1998</div></div>\n      </div>\n    </div>\n\n    <!-- ============ EXHIBITS ============ -->\n    <section id=\"exhibits\">\n      <div class=\"container\">\n        <div class=\"section-head\">\n          <span class=\"eyebrow\">The Galleries</span>\n          <h2>Pick a place to start</h2>\n          <p class=\"lead\">Every gallery invites touching, testing, and tinkering. Nothing here is a \"do not touch.\"</p>\n        </div>\n\n        <div class=\"exhibits-grid\">\n          <article class=\"exhibit\">\n            <span class=\"tag\">Ages 4\u201310</span>\n            <div class=\"icon c-sun\" aria-hidden=\"true\">\u2699\ufe0f</div>\n            <h3>Gravity Garage</h3>\n            <p>Race marbles down ramps, build bridges that hold a truck, and discover why things fall the way they do.</p>\n          </article>\n\n          <article class=\"exhibit\">\n            <span class=\"tag\">All ages</span>\n            <div class=\"icon c-teal\" aria-hidden=\"true\">\ud83e\udee7</div>\n            <h3>Bubble Lab</h3>\n            <p>Make giant bubbles, watch soap films swirl in rainbow colors, and see what makes a bubble strong enough to bounce.</p>\n          </article>\n\n          <article class=\"exhibit\">\n            <span class=\"tag\">Ages 3\u20138</span>\n            <div class=\"icon c-lime\" aria-hidden=\"true\">\ud83e\udd96</div>\n            <h3>Dino Dig Pit</h3>\n            <p>Brush away sand to uncover fossil replicas, then match each find to the dinosaur it came from.</p>\n          </article>\n\n          <article class=\"exhibit\">\n            <span class=\"tag\">Ages 6\u201312</span>\n            <div class=\"icon c-sky\" aria-hidden=\"true\">\u26c8\ufe0f</div>\n            <h3>Weather Station</h3>\n            <p>Forecast the day, create your own cloud in a jar, and step inside a working tornado simulator.</p>\n          </article>\n\n          <article class=\"exhibit\">\n            <span class=\"tag\">Ages 7\u201312</span>\n            <div class=\"icon c-lilac\" aria-hidden=\"true\">\ud83e\udd16</div>\n            <h3>Robot Workshop</h3>\n            <p>Program simple robots with colored cards, then challenge them to navigate our giant floor maze.</p>\n          </article>\n\n          <article class=\"exhibit\">\n            <span class=\"tag\">Ages 5\u201312</span>\n            <div class=\"icon c-coral\" aria-hidden=\"true\">\ud83d\udd2c</div>\n            <h3>Tiny World</h3>\n            <p>Peer through microscopes at pond water, insect wings, and crystals grown right before your eyes.</p>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <!-- ============ PLANETARIUM ============ -->\n    <section id=\"planetarium\" class=\"cosmos\">\n      <div class=\"container cosmos-grid\">\n        <div>\n          <span class=\"eyebrow\">The Dome Planetarium</span>\n          <h2>Lie back and look up</h2>\n          <p>Our 40-foot dome turns the ceiling into a night sky. Shows are narrated for young listeners and sized for short attention spans, with plenty of time to ask questions afterward.</p>\n          <ul class=\"checklist\">\n            <li>Shows run every hour, about 20 minutes each</li>\n            <li>Bean bags and floor cushions for little ones</li>\n            <li>Sensory-friendly sessions with lower lights and sound</li>\n          </ul>\n          <a href=\"#tickets\" class=\"btn btn-primary\">Reserve a Show</a>\n        </div>\n\n        <div class=\"dome\" role=\"img\" aria-label=\"Illustration of a planetarium dome with stars and a constellation\">\n          <svg class=\"constellation\" viewBox=\"0 0 400 400\" aria-hidden=\"true\">\n            <g stroke=\"rgba(255,200,61,.7)\" stroke-width=\"1.5\" fill=\"none\">\n              <polyline points=\"120,140 170,110 220,150 260,120 300,170\"/>\n              <polyline points=\"170,110 180,220 240,260 220,150\"/>\n            </g>\n            <g fill=\"#ffc83d\">\n              <circle cx=\"120\" cy=\"140\" r=\"4\"/><circle cx=\"170\" cy=\"110\" r=\"4\"/>\n              <circle cx=\"220\" cy=\"150\" r=\"4\"/><circle cx=\"260\" cy=\"120\" r=\"4\"/>\n              <circle cx=\"300\" cy=\"170\" r=\"4\"/><circle cx=\"180\" cy=\"220\" r=\"4\"/>\n              <circle cx=\"240\" cy=\"260\" r=\"4\"/>\n            </g>\n          </svg>\n          <span class=\"star\" style=\"top:12%;left:20%;width:3px;height:3px;\"></span>\n          <span class=\"star\" style=\"top:25%;left:78%;width:2px;height:2px;\"></span>\n          <span class=\"star\" style=\"top:60%;left:12%;width:2px;height:2px;\"></span>\n          <span class=\"star\" style=\"top:70%;left:85%;width:3px;height:3px;\"></span>\n          <span class=\"star\" style=\"top:40%;left:50%;width:2px;height:2px;\"></span>\n          <span class=\"star\" style=\"top:85%;left:40%;width:2px;height:2px;\"></span>\n          <span class=\"dome-label\">Tonight: Journey to Mars</span>\n        </div>\n      </div>\n    </section>\n\n    <!-- ============ VISIT ============ -->\n    <section id=\"visit\">\n      <div class=\"container\">\n        <div class=\"section-head\">\n          <span class=\"eyebrow\">Plan Your Visit</span>\n          <h2>Everything you need for a great day</h2>\n          <p class=\"lead\">Arrive early for the shortest lines, and pack a snack for the picnic lawn out back.</p>\n        </div>\n\n        <div class=\"visit-grid\">\n          <div class=\"card\" id=\"hours\">\n            <div class=\"big-emoji\" aria-hidden=\"true\">\ud83d\udd58</div>\n            <h3>Hours</h3>\n            <span class=\"open-now\">Open today until 5 PM</span>\n            <table class=\"hours\">\n              <tr><td>Monday to Friday</td><td>9 AM \u2013 5 PM</td></tr>\n              <tr><td>Saturday</td><td>9 AM \u2013 6 PM</td></tr>\n              <tr><td>Sunday</td><td>10 AM \u2013 6 PM</td></tr>\n              <tr><td>Holidays</td><td>10 AM \u2013 4 PM</td></tr>\n            </table>\n          </div>\n\n          <div class=\"card\" id=\"tickets\">\n            <div class=\"big-emoji\" aria-hidden=\"true\">\ud83c\udf9f\ufe0f</div>\n            <h3>Tickets</h3>\n            <ul class=\"price-list\">\n              <li><div><strong>Explorer (ages 2\u201312)</strong><small>Includes all galleries</small></div><strong>$18</strong></li>\n              <li><div><strong>Adult</strong><small>Accompanying adult, free with paid child ticket</small></div><strong>$14</strong></li>\n              <li><div><strong>Planetarium add-on</strong><small>Per show, reserve in advance</small></div><strong>$6</strong></li>\n              <li><div><strong>Babies (under 2)</strong><small>Lap entry</small></div><strong>Free</strong></li>\n            </ul>\n            <a href=\"#\" class=\"btn btn-primary\" style=\"width:100%\">Book Timed Entry</a>\n          </div>\n\n          <div class=\"card address\" id=\"location\">\n            <div class=\"big-emoji\" aria-hidden=\"true\">\ud83d\uddfa\ufe0f</div>\n            <h3>Find Us</h3>\n            <p>1200 Discovery Avenue<br>Riverside Park District</p>\n            <p>Free parking garage on Maple Street.<br>Stroller-friendly. Wheelchairs and sensory backpacks available at the front desk.</p>\n            <div class=\"map-placeholder\" role=\"img\" aria-label=\"Stylized map showing museum location\"></div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- ============ EVENTS ============ -->\n    <section id=\"events\" class=\"events\">\n      <div class=\"container\">\n        <div class=\"section-head\">\n          <span class=\"eyebrow\">Happening Now</span>\n          <h2>Events for every season</h2>\n          <p class=\"lead\">Drop-in workshops, family nights, and special guests, all included with admission.</p>\n        </div>\n\n        <div class=\"events-grid\">\n          <article class=\"event\">\n            <div class=\"date-chip\"><div class=\"mon\">Jun</div><div class=\"day\">14</div></div>\n            <div>\n              <h3>Junior Chemists Saturday</h3>\n              <p>Mix safe color reactions and take home your own lava lamp.</p>\n              <span class=\"time\">10:00 AM \u00b7 Workshop</span>\n            </div>\n          </article>\n\n          <article class=\"event\">\n            <div class=\"date-chip\"><div class=\"mon\">Jun</div><div class=\"day\">21</div></div>\n            <div>\n              <h3>Stargazers' Night</h3>\n              <p>Extended dome show followed by telescope viewing on the rooftop.</p>\n              <span class=\"time\">7:00 PM \u00b7 Evening program</span>\n            </div>\n          </article>\n\n          <article class=\"event\">\n            <div class=\"date-chip\"><div class=\"mon\">Jul</div><div class=\"day\">04</div></div>\n            <div>\n              <h3>Fizz &amp; Pop Fair</h3>\n              <p>Holiday-weekend science carnival with face painting and a bubble parade.</p>\n              <span class=\"time\">All day \u00b7 Family festival</span>\n            </div>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <!-- ============ MEMBERSHIP ============ -->\n    <section id=\"membership\">\n      <div class=\"container\">\n        <div class=\"membership\">\n          <div>\n            <span class=\"eyebrow\" style=\"color:var(--navy-deep)\">Become a Member</span>\n            <h2>Come back every week, for free</h2>\n            <p>Members get unlimited visits for a full year, early access to new exhibits, and guest passes for grandparents, babysitters, and best friends.</p>\n            <a href=\"#\" class=\"btn btn-navy\">Join Today</a>\n          </div>\n          <div class=\"tiers\">\n            <div class=\"tier\"><div><strong>Sprout</strong><br><small>1 adult + 2 children</small></div><span>$129/yr</span></div>\n            <div class=\"tier\"><div><strong>Explorer</strong><br><small>2 adults + 4 children</small></div><span>$189/yr</span></div>\n            <div class=\"tier\"><div><strong>Scientist</strong><br><small>Family + 4 guest passes</small></div><span>$269/yr</span></div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n  </main>\n\n  <!-- ============ FOOTER ============ -->\n  <footer class=\"site-footer\">\n    <div class=\"container\">\n      <div class=\"footer-grid\">\n        <div>\n          <a href=\"#top\" class=\"logo\">\n            <svg width=\"38\" height=\"38\" viewBox=\"0 0 42 42\" aria-hidden=\"true\">\n              <circle cx=\"21\" cy=\"21\" r=\"8\" fill=\"#ffc83d\"/>\n              <ellipse cx=\"21\" cy=\"21\" rx=\"19\" ry=\"7\" fill=\"none\" stroke=\"#17b8a6\" stroke-width=\"2.5\" transform=\"rotate(-25 21 21)\"/>\n              <ellipse cx=\"21\" cy=\"21\" rx=\"19\" ry=\"7\" fill=\"none\" stroke=\"#ff6b5b\" stroke-width=\"2.5\" transform=\"rotate(35 21 21)\"/>\n            </svg>\n            <div>Sparkwell<small>Science Museum for Kids</small></div>\n          </a>\n          <p style=\"margin-top:1rem;font-size:.95rem;\">A nonprofit making science playful since 1998.</p>\n        </div>\n\n        <div>\n          <h4>Visit</h4>\n          <ul>\n            <li><a href=\"#exhibits\">Exhibits</a></li>\n            <li><a href=\"#planetarium\">Planetarium</a></li>\n            <li><a href=\"#hours\">Hours</a></li>\n            <li><a href=\"#location\">Directions</a></li>\n          </ul>\n        </div>\n\n        <div>\n          <h4>Support</h4>\n          <ul>\n            <li><a href=\"#membership\">Membership</a></li>\n            <li><a href=\"#\">Birthday parties</a></li>\n            <li><a href=\"#\">School groups</a></li>\n            <li><a href=\"#\">Donate</a></li>\n          </ul>\n        </div>\n\n        <div>\n          <h4>Stay in the loop</h4>\n          <p style=\"font-size:.95rem;\">Weekly activity ideas for parents and teachers.</p>\n          <form class=\"news-form\" onsubmit=\"event.preventDefault(); this.querySelector('button').textContent='Thanks! \ud83c\udf89';\">\n            <label for=\"email\" class=\"sr-only\" style=\"position:absolute;left:-9999px;\">Email address</label>\n            <input id=\"email\" type=\"email\" placeholder=\"you@example.com\" required>\n            <button type=\"submit\">Subscribe</button>\n          </form>\n        </div>\n      </div>\n\n      <div class=\"fine\">\n        <span>\u00a9 2025 Sparkwell Science Museum for Kids. Nonprofit 501(c)(3).</span>\n        <span>\n          <a href=\"#\">Accessibility</a> &nbsp;\u00b7&nbsp;\n          <a href=\"#\">Privacy</a> &nbsp;\u00b7&nbsp;\n          <a href=\"#\">Accessibility &amp; Sensory Guide</a>\n        </span>\n      </div>\n    </div>\n  </footer>\n\n</body>\n</html>\n"}