{"brief": "B1", "model": "openai/gpt-6-luna", "i": 0, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en-GB\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#f7f5ef\">\n  <meta name=\"description\" content=\"Friendly, reliable plumbing for homes across Leeds. Meet North & Hearth, your local family plumbing team.\">\n  <title>North &amp; Hearth Plumbing | Leeds</title>\n  <style>\n    :root {\n      --paper: #f7f5ef;\n      --white: #fffefa;\n      --ink: #192a31;\n      --muted: #627178;\n      --green: #244f46;\n      --green-dark: #183a34;\n      --lime: #d9e5b3;\n      --orange: #e77c4d;\n      --line: #e8e5dc;\n      --serif: Georgia, \"Times New Roman\", serif;\n      --sans: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n    }\n\n    * { box-sizing: border-box; }\n    html { scroll-behavior: smooth; }\n    body {\n      margin: 0;\n      color: var(--ink);\n      background: var(--paper);\n      font-family: var(--sans);\n      line-height: 1.6;\n    }\n    a { color: inherit; }\n    .wrap { width: min(1160px, calc(100% - 48px)); margin-inline: auto; }\n\n    .topline {\n      padding: 9px 0;\n      background: var(--green-dark);\n      color: #f5f4ec;\n      font-size: .78rem;\n      letter-spacing: .04em;\n    }\n    .topline-inner {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      gap: 16px;\n    }\n    .topline p { margin: 0; }\n    .topline a { text-decoration: none; font-weight: 700; }\n    .topline a:hover { text-decoration: underline; }\n\n    header {\n      position: relative;\n      z-index: 2;\n      border-bottom: 1px solid var(--line);\n      background: rgba(247, 245, 239, .94);\n    }\n    .nav {\n      min-height: 83px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 24px;\n    }\n    .brand {\n      display: inline-flex;\n      align-items: center;\n      gap: 12px;\n      text-decoration: none;\n      flex-shrink: 0;\n    }\n    .brand-mark {\n      width: 43px;\n      height: 43px;\n      display: grid;\n      place-items: center;\n      border-radius: 14px 14px 14px 4px;\n      color: var(--white);\n      background: var(--green);\n    }\n    .brand-name {\n      display: block;\n      font-size: 1.05rem;\n      font-weight: 800;\n      letter-spacing: -.04em;\n      line-height: 1.1;\n    }\n    .brand-sub {\n      display: block;\n      margin-top: 4px;\n      color: var(--muted);\n      font-size: .65rem;\n      font-weight: 700;\n      letter-spacing: .14em;\n      text-transform: uppercase;\n    }\n    .nav-links {\n      display: flex;\n      align-items: center;\n      gap: clamp(18px, 3vw, 36px);\n      font-size: .88rem;\n      font-weight: 650;\n    }\n    .nav-links a { text-decoration: none; }\n    .nav-links a:hover { color: var(--green); }\n    .nav-call {\n      display: inline-flex;\n      align-items: center;\n      gap: 9px;\n      padding: 12px 17px;\n      border-radius: 999px;\n      color: white;\n      background: var(--green);\n      font-size: .85rem;\n      font-weight: 750;\n      text-decoration: none;\n      white-space: nowrap;\n      transition: background .2s, transform .2s;\n    }\n    .nav-call:hover { background: var(--green-dark); transform: translateY(-1px); }\n\n    .hero {\n      position: relative;\n      overflow: hidden;\n      padding: 76px 0 82px;\n    }\n    .hero::before {\n      content: \"\";\n      position: absolute;\n      width: 560px;\n      height: 560px;\n      top: -220px;\n      right: -120px;\n      border: 1px solid #e7e4da;\n      border-radius: 50%;\n      pointer-events: none;\n    }\n    .hero-grid {\n      position: relative;\n      display: grid;\n      grid-template-columns: 1.03fr .97fr;\n      align-items: center;\n      gap: clamp(38px, 7vw, 90px);\n    }\n    .eyebrow {\n      display: inline-flex;\n      align-items: center;\n      gap: 9px;\n      margin: 0 0 20px;\n      color: var(--green);\n      font-size: .76rem;\n      font-weight: 800;\n      letter-spacing: .14em;\n      text-transform: uppercase;\n    }\n    .eyebrow::before {\n      content: \"\";\n      width: 25px;\n      height: 2px;\n      background: var(--orange);\n    }\n    h1, h2, h3, p { margin-top: 0; }\n    h1 {\n      max-width: 620px;\n      margin-bottom: 22px;\n      font-family: var(--serif);\n      font-size: clamp(3.2rem, 6vw, 5.35rem);\n      font-weight: 500;\n      letter-spacing: -.065em;\n      line-height: .99;\n    }\n    h1 em { color: var(--green); font-weight: 500; }\n    .hero-copy {\n      max-width: 490px;\n      margin-bottom: 29px;\n      color: var(--muted);\n      font-size: 1.06rem;\n    }\n    .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }\n    .button {\n      display: inline-flex;\n      min-height: 51px;\n      align-items: center;\n      justify-content: center;\n      gap: 10px;\n      padding: 0 21px;\n      border: 1px solid transparent;\n      border-radius: 999px;\n      background: var(--green);\n      color: white;\n      font-size: .9rem;\n      font-weight: 750;\n      text-decoration: none;\n      transition: transform .2s, background .2s;\n    }\n    .button:hover { background: var(--green-dark); transform: translateY(-2px); }\n    .button-secondary {\n      border-color: #d7d7ca;\n      color: var(--ink);\n      background: transparent;\n    }\n    .button-secondary:hover { color: white; }\n    .hero-note {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      margin-top: 25px;\n      color: var(--muted);\n      font-size: .8rem;\n    }\n    .note-dot {\n      width: 8px;\n      height: 8px;\n      border-radius: 50%;\n      background: var(--orange);\n      box-shadow: 0 0 0 4px #f2dfd3;\n    }\n\n    .hero-art {\n      position: relative;\n      min-height: 440px;\n      display: grid;\n      place-items: center;\n    }\n    .art-halo {\n      position: absolute;\n      width: min(100%, 455px);\n      aspect-ratio: 1;\n      border-radius: 50%;\n      background: #e9eddb;\n    }\n    .art-card {\n      position: absolute;\n      z-index: 1;\n      right: 0;\n      bottom: 23px;\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      padding: 15px 19px;\n      border: 1px solid rgba(25, 42, 49, .06);\n      border-radius: 16px;\n      background: var(--white);\n      box-shadow: 0 12px 35px rgba(31, 48, 41, .1);\n      font-size: .82rem;\n      font-weight: 750;\n    }\n    .art-card-icon {\n      width: 35px;\n      height: 35px;\n      display: grid;\n      place-items: center;\n      border-radius: 50%;\n      color: var(--green);\n      background: var(--lime);\n    }\n    .art-card small {\n      display: block;\n      color: var(--muted);\n      font-size: .7rem;\n      font-weight: 500;\n    }\n    .art-spark {\n      position: absolute;\n      z-index: 1;\n      top: 56px;\n      right: 28px;\n      color: var(--orange);\n      font-size: 2rem;\n    }\n    .illustration { position: relative; z-index: 1; width: min(100%, 470px); height: auto; }\n\n    .trust-bar {\n      border-block: 1px solid var(--line);\n      background: rgba(255, 254, 250, .62);\n    }\n    .trust-inner {\n      min-height: 81px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 20px;\n    }\n    .trust-intro {\n      color: var(--muted);\n      font-size: .78rem;\n      font-weight: 700;\n    }\n    .trust-item {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      font-size: .85rem;\n      font-weight: 750;\n    }\n    .trust-check {\n      width: 24px;\n      height: 24px;\n      display: grid;\n      place-items: center;\n      border-radius: 50%;\n      color: var(--green);\n      background: var(--lime);\n      font-size: .8rem;\n    }\n\n    section { scroll-margin-top: 24px; }\n    .services { padding: 96px 0 102px; }\n    .section-heading {\n      display: flex;\n      align-items: end;\n      justify-content: space-between;\n      gap: 30px;\n      margin-bottom: 38px;\n    }\n    .section-heading h2 {\n      max-width: 560px;\n      margin: 0;\n      font-family: var(--serif);\n      font-size: clamp(2.3rem, 4vw, 3.5rem);\n      font-weight: 500;\n      letter-spacing: -.055em;\n      line-height: 1.08;\n    }\n    .section-heading p {\n      max-width: 330px;\n      margin: 0 0 4px;\n      color: var(--muted);\n      font-size: .93rem;\n    }\n    .service-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 17px;\n    }\n    .service-card {\n      min-height: 235px;\n      padding: 27px 27px 25px;\n      border: 1px solid var(--line);\n      border-radius: 18px;\n      background: var(--white);\n      transition: transform .2s, box-shadow .2s;\n    }\n    .service-card:hover {\n      transform: translateY(-4px);\n      box-shadow: 0 14px 35px rgba(31, 48, 41, .07);\n    }\n    .service-icon {\n      width: 46px;\n      height: 46px;\n      display: grid;\n      place-items: center;\n      margin-bottom: 24px;\n      border-radius: 14px;\n      color: var(--green);\n      background: #edf0e2;\n    }\n    .service-card h3 { margin-bottom: 8px; font-size: 1.08rem; letter-spacing: -.025em; }\n    .service-card p { margin: 0; color: var(--muted); font-size: .88rem; }\n\n    .story {\n      overflow: hidden;\n      padding: 78px 0;\n      color: #f8f6ee;\n      background: var(--green-dark);\n    }\n    .story-grid {\n      display: grid;\n      grid-template-columns: .9fr 1.1fr;\n      align-items: center;\n      gap: clamp(38px, 8vw, 100px);\n    }\n    .story-art {\n      min-height: 310px;\n      display: grid;\n      place-items: center;\n      border-radius: 24px;\n      background: #244c42;\n    }\n    .story-art svg { width: min(83%, 360px); height: auto; }\n    .story .eyebrow { color: var(--lime); }\n    .story h2 {\n      max-width: 530px;\n      margin-bottom: 18px;\n      font-family: var(--serif);\n      font-size: clamp(2.4rem, 4vw, 3.65rem);\n      font-weight: 500;\n      letter-spacing: -.055em;\n      line-height: 1.05;\n    }\n    .story-copy { max-width: 510px; color: #d0dbd3; font-size: .96rem; }\n    .story-points { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 18px; margin: 25px 0 0; padding: 0; list-style: none; }\n    .story-points li { display: flex; align-items: center; gap: 9px; font-size: .84rem; font-weight: 650; }\n    .story-points li::before { content: \"\u2713\"; color: var(--lime); font-weight: 900; }\n\n    .areas { padding: 82px 0 88px; }\n    .areas-inner {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 32px;\n      padding: 31px 35px;\n      border: 1px solid var(--line);\n      border-radius: 20px;\n      background: #efeee5;\n    }\n    .areas h2 {\n      margin: 0 0 6px;\n      font-family: var(--serif);\n      font-size: 2rem;\n      font-weight: 500;\n      letter-spacing: -.04em;\n    }\n    .areas p { max-width: 600px; margin: 0; color: var(--muted); font-size: .9rem; }\n    .area-list {\n      flex: 0 0 auto;\n      max-width: 340px;\n      color: var(--green);\n      font-size: .82rem;\n      font-weight: 750;\n      text-align: right;\n    }\n\n    .contact {\n      padding: 0 0 88px;\n    }\n    .contact-panel {\n      position: relative;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 30px;\n      padding: 43px 48px;\n      border-radius: 24px;\n      color: white;\n      background: var(--green);\n    }\n    .contact-panel::after {\n      content: \"\";\n      position: absolute;\n      right: 16%;\n      top: -140px;\n      width: 320px;\n      height: 320px;\n      border: 1px solid rgba(255,255,255,.12);\n      border-radius: 50%;\n      box-shadow: 0 0 0 35px rgba(255,255,255,.035), 0 0 0 70px rgba(255,255,255,.025);\n    }\n    .contact-content { position: relative; z-index: 1; }\n    .contact-content .eyebrow { color: var(--lime); margin-bottom: 12px; }\n    .contact h2 {\n      max-width: 600px;\n      margin: 0 0 9px;\n      font-family: var(--serif);\n      font-size: clamp(2.2rem, 4vw, 3.3rem);\n      font-weight: 500;\n      letter-spacing: -.05em;\n      line-height: 1.05;\n    }\n    .contact-content p { margin: 0; color: #d6e0d9; font-size: .9rem; }\n    .contact .button {\n      position: relative;\n      z-index: 1;\n      flex-shrink: 0;\n      color: var(--green-dark);\n      background: var(--lime);\n    }\n    .contact .button:hover { background: white; }\n\n    footer {\n      padding: 27px 0;\n      border-top: 1px solid var(--line);\n      color: var(--muted);\n      font-size: .78rem;\n    }\n    .footer-inner { display: flex; justify-content: space-between; align-items: center; gap: 18px; }\n    .footer-inner p { margin: 0; }\n    .footer-links { display: flex; gap: 20px; }\n    .footer-links a { text-decoration: none; }\n    .footer-links a:hover { color: var(--green); }\n\n    @media (max-width: 850px) {\n      .nav-links { gap: 16px; }\n      .hero { padding: 55px 0 65px; }\n      .hero-grid { gap: 25px; }\n      .hero-art { min-height: 360px; }\n      .trust-inner { flex-wrap: wrap; justify-content: flex-start; padding-block: 18px; }\n      .trust-intro { width: 100%; }\n      .service-grid { grid-template-columns: repeat(2, 1fr); }\n      .story-grid { gap: 38px; }\n      .areas-inner { align-items: flex-start; flex-direction: column; }\n      .area-list { max-width: none; text-align: left; }\n    }\n    @media (max-width: 620px) {\n      .wrap { width: min(100% - 34px, 1160px); }\n      .topline-inner { justify-content: center; }\n      .topline-inner p:first-child { display: none; }\n      .nav { min-height: 72px; }\n      .brand-mark { width: 39px; height: 39px; }\n      .brand-name { font-size: .94rem; }\n      .brand-sub { font-size: .57rem; }\n      .nav-links { display: none; }\n      .nav-call { padding: 10px 13px; font-size: .78rem; }\n      .hero { padding: 51px 0 43px; }\n      .hero-grid { grid-template-columns: 1fr; gap: 12px; }\n      h1 { font-size: clamp(3.1rem, 15vw, 4.5rem); }\n      .hero-copy { font-size: .98rem; }\n      .hero-art { min-height: 320px; margin-top: 8px; }\n      .art-halo { width: min(88%, 350px); }\n      .art-card { right: 0; bottom: 3px; }\n      .art-spark { top: 26px; right: 13px; }\n      .trust-inner { gap: 14px 20px; }\n      .trust-item { font-size: .77rem; }\n      .services { padding: 69px 0; }\n      .section-heading { display: block; margin-bottom: 27px; }\n      .section-heading p { margin-top: 13px; }\n      .service-grid { grid-template-columns: 1fr; gap: 12px; }\n      .service-card { min-height: auto; padding: 23px; }\n      .service-icon { margin-bottom: 17px; }\n      .story { padding: 55px 0; }\n      .story-grid { grid-template-columns: 1fr; }\n      .story-art { min-height: 230px; order: 2; }\n      .story-points { grid-template-columns: 1fr; }\n      .areas { padding: 58px 0; }\n      .areas-inner { padding: 25px; }\n      .contact { padding-bottom: 60px; }\n      .contact-panel { align-items: flex-start; flex-direction: column; padding: 31px 25px; }\n      .contact-panel::after { right: -155px; }\n      .footer-inner { align-items: flex-start; flex-direction: column; }\n    }\n    @media (prefers-reduced-motion: reduce) {\n      html { scroll-behavior: auto; }\n      *, *::before, *::after { transition-duration: .01ms !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"topline\">\n    <div class=\"wrap topline-inner\">\n      <p>Your friendly local plumbing team</p>\n      <p>Based in Leeds &nbsp;\u00b7&nbsp; <a href=\"tel:+441132450187\">0113 245 0187</a></p>\n    </div>\n  </div>\n\n  <header>\n    <div class=\"wrap nav\">\n      <a class=\"brand\" href=\"#home\" aria-label=\"North and Hearth Plumbing home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg width=\"25\" height=\"25\" viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M4 11.2 12 4l8 7.2v8.3a.5.5 0 0 1-.5.5H4.5a.5.5 0 0 1-.5-.5v-8.3Z\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linejoin=\"round\"/>\n            <path d=\"M9 20v-5.4a3 3 0 0 1 6 0V20M12 8.5v2.2\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/>\n          </svg>\n        </span>\n        <span>\n          <span class=\"brand-name\">North &amp; Hearth</span>\n          <span class=\"brand-sub\">Plumbing \u00b7 Leeds</span>\n        </span>\n      </a>\n\n      <nav class=\"nav-links\" aria-label=\"Main navigation\">\n        <a href=\"#services\">Our services</a>\n        <a href=\"#about\">About us</a>\n        <a href=\"#areas\">Areas we cover</a>\n      </nav>\n\n      <a class=\"nav-call\" href=\"tel:+441132450187\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n          <path d=\"M5 4h3l2 5-2 1.5a14 14 0 0 0 5.5 5.5L15 14l5 2v3c0 1.1-.9 2-2 2C10.3 21 3 13.7 3 5c0-.6.4-1 1-1h1Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </svg>\n        Call the team\n      </a>\n    </div>\n  </header>\n\n  <main>\n    <section class=\"hero\" id=\"home\">\n      <div class=\"wrap hero-grid\">\n        <div>\n          <p class=\"eyebrow\">Local people. Proper plumbing.</p>\n          <h1>Good hands for your <em>home.</em></h1>\n          <p class=\"hero-copy\">From a dripping tap to a new bathroom, we bring friendly advice and careful plumbing to homes across Leeds.</p>\n          <div class=\"hero-actions\">\n            <a class=\"button\" href=\"tel:+441132450187\">\n              Talk to a plumber\n              <svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n                <path d=\"M5 12h14m-6-6