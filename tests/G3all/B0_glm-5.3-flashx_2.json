{"arm": "direct", "model": "z-ai/glm-5.3-flashx", "i": 2, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Tidepool \u2014 Plan your week, together</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&family=Karla:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --paper:#F7F3EA;\n    --paper-deep:#EFE9DC;\n    --ink:#12333A;\n    --ink-soft:#3D5A60;\n    --sea:#2E7D6E;\n    --sea-bright:#4FB39B;\n    --coral:#E2603F;\n    --line:#D8D0BF;\n    --serif:\"Fraunces\",Georgia,serif;\n    --sans:\"Karla\",sans-serif;\n  }\n  *{margin:0;padding:0;box-sizing:border-box}\n  html{scroll-behavior:smooth}\n  body{\n    background:var(--paper);\n    color:var(--ink);\n    font-family:var(--sans);\n    font-size:17px;\n    line-height:1.6;\n    -webkit-font-smoothing:antialiased;\n    overflow-x:hidden;\n  }\n  ::selection{background:var(--sea-bright);color:var(--paper)}\n\n  /* ---------- NAV ---------- */\n  nav{\n    position:fixed;top:0;left:0;right:0;z-index:50;\n    display:flex;align-items:center;justify-content:space-between;\n    padding:20px 5vw;\n    transition:background .3s, box-shadow .3s;\n  }\n  nav.scrolled{background:rgba(247,243,234,.92);backdrop-filter:blur(10px);box-shadow:0 1px 0 var(--line)}\n  .logo{display:flex;align-items:center;gap:10px;font-family:var(--serif);font-weight:600;font-size:22px;letter-spacing:-.01em}\n  .logo svg{display:block}\n  .nav-links{display:flex;gap:34px;align-items:center}\n  .nav-links a{color:var(--ink-soft);text-decoration:none;font-weight:500;font-size:15px;position:relative}\n  .nav-links a:not(.btn)::after{content:\"\";position:absolute;left:0;bottom:-4px;width:0;height:2px;background:var(--coral);transition:width .25s}\n  .nav-links a:not(.btn):hover::after{width:100%}\n  .btn{\n    display:inline-block;background:var(--ink);color:var(--paper);\n    padding:11px 24px;border-radius:999px;text-decoration:none;\n    font-weight:600;font-size:15px;border:none;cursor:pointer;\n    transition:transform .2s, background .2s;\n  }\n  .btn:hover{background:var(--sea);transform:translateY(-2px)}\n  .btn.sea{background:var(--sea)}\n  .btn.sea:hover{background:var(--ink)}\n  .btn.ghost{background:transparent;color:var(--ink);border:1.5px solid var(--ink)}\n  .btn.ghost:hover{background:var(--ink);color:var(--paper)}\n\n  /* ---------- HERO ---------- */\n  .hero{\n    position:relative;\n    padding:170px 5vw 90px;\n    min-height:100vh;\n    display:flex;flex-direction:column;justify-content:center;\n  }\n  .tide-wrap{position:absolute;inset:0;overflow:hidden;pointer-events:none;z-index:0}\n  .tide-wrap svg{position:absolute;bottom:-2px;left:0;width:100%;height:46%}\n  .hero-inner{position:relative;z-index:1;max-width:1200px;margin:0 auto;width:100%}\n  .eyebrow{\n    display:inline-flex;align-items:center;gap:10px;\n    font-size:13px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;\n    color:var(--sea);margin-bottom:26px;\n  }\n  .eyebrow::before{content:\"\";width:34px;height:2px;background:var(--sea)}\n  h1{\n    font-family:var(--serif);font-weight:400;\n    font-size:clamp(44px,7vw,88px);\n    line-height:1.04;letter-spacing:-.02em;\n    max-width:13ch;\n  }\n  h1 em{font-style:italic;font-weight:300;color:var(--sea)}\n  .hero-sub{\n    margin-top:28px;max-width:46ch;\n    font-size:19px;color:var(--ink-soft);\n  }\n  .hero-cta{margin-top:38px;display:flex;gap:16px;flex-wrap:wrap;align-items:center}\n  .hero-note{font-size:14px;color:var(--ink-soft)}\n\n  /* week board mock */\n  .board{\n    position:relative;z-index:1;\n    margin:70px auto 0;max-width:1080px;width:100%;\n    background:#FFFDF8;border:1px solid var(--line);border-radius:16px;\n    box-shadow:0 24px 60px -18px rgba(18,51,58,.22);\n    padding:22px 26px 26px;\n  }\n  .board-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;flex-wrap:wrap;gap:10px}\n  .board-title{font-family:var(--serif);font-size:20px;font-weight:500}\n  .board-title span{color:var(--ink-soft);font-family:var(--sans);font-size:14px;margin-left:10px}\n  .avatars{display:flex}\n  .avatars i{\n    width:30px;height:30px;border-radius:50%;border:2px solid #FFFDF8;\n    display:flex;align-items:center;justify-content:center;\n    font-style:normal;font-size:11px;font-weight:700;color:var(--paper);\n    margin-left:-8px;\n  }\n  .avatars i:first-child{margin-left:0}\n  .week{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}\n  .day-head{font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft);padding:4px 2px 8px;border-bottom:2px solid var(--ink);margin-bottom:10px}\n  .day.today .day-head{color:var(--coral);border-color:var(--coral)}\n  .card{\n    background:var(--paper);border:1px solid var(--line);border-radius:9px;\n    padding:9px 11px;margin-bottom:9px;\n    font-size:13.5px;line-height:1.35;\n    opacity:0;transform:translateY(10px);\n    animation:rise .6s ease forwards;\n  }\n  .card small{display:block;color:var(--ink-soft);font-size:11.5px;margin-top:3px}\n  .card .dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;vertical-align:1px}\n  .card.focus{background:#E8F3EF;border-color:#BFDCD3}\n  .card.shared{border-left:3px solid var(--coral)}\n  .card.q{background:var(--ink);color:var(--paper);border-color:var(--ink)}\n  .card.q small{color:#A8C0C4}\n  @keyframes rise{to{opacity:1;transform:none}}\n  .d1{animation-delay:.5s}.d2{animation-delay:.62s}.d3{animation-delay:.74s}\n  .d4{animation-delay:.86s}.d5{animation-delay:.98s}.d6{animation-delay:1.1s}\n  .d7{animation-delay:1.22s}.d8{animation-delay:1.34s}.d9{animation-delay:1.46s}\n  .d10{animation-delay:1.58s}.d11{animation-delay:1.7s}\n  .hint{margin-top:14px;font-size:12.5px;color:var(--ink-soft);display:flex;align-items:center;gap:8px}\n  .hint .dot{width:7px;height:7px;border-radius:50%;background:var(--coral);display:inline-block}\n  @media(max-width:760px){\n    .week{grid-template-columns:repeat(2,1fr)}\n    .week .day:nth-child(5){grid-column:span 2}\n    .nav-links a:not(.btn){display:none}\n  }\n\n  /* ---------- MARQUEE ---------- */\n  .strip{\n    border-top:1px solid var(--line);border-bottom:1px solid var(--line);\n    background:var(--paper-deep);overflow:hidden;padding:16px 0;\n  }\n  .strip-track{\n    display:flex;gap:60px;width:max-content;\n    animation:drift 30s linear infinite;\n    font-family:var(--serif);font-size:16px;color:var(--ink-soft);\n    white-space:nowrap;\n  }\n  .strip-track b{color:var(--sea);font-weight:500}\n  @keyframes drift{to{transform:translateX(-50%)}}\n\n  /* ---------- SECTIONS ---------- */\n  section{padding:110px 5vw}\n  .wrap{max-width:1160px;margin:0 auto}\n  .sec-label{font-size:13px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--coral);margin-bottom:18px}\n\n  /* how it works \u2014 asymmetric, numbered editorial */\n  .rhythm-head{display:flex;justify-content:space-between;align-items:flex-end;gap:40px;flex-wrap:wrap;margin-bottom:70px}\n  h2{font-family:var(--serif);font-weight:400;font-size:clamp(32px,4.5vw,52px);line-height:1.12;letter-spacing:-.015em;max-width:22ch}\n  h2 em{font-style:italic;color:var(--sea);font-weight:300}\n  .rhythm-head p{max-width:38ch;color:var(--ink-soft)}\n  .steps{display:grid;grid-template-columns:1fr 1fr;gap:0 80px}\n  .step{\n    padding:38px 0;border-top:1px solid var(--ink);\n    display:grid;grid-template-columns:auto 1fr;gap:26px;\n  }\n  .step:nth-child(3){grid-column:1;grid-row:2}\n  .step:nth-child(4){grid-column:2;grid-row:2;margin-top:56px}\n  .step-num{font-family:var(--serif);font-size:15px;font-style:italic;color:var(--coral);padding-top:5px}\n  .step h3{font-family:var(--serif);font-size:25px;font-weight:500;margin-bottom:10px;letter-spacing:-.01em}\n  .step p{color:var(--ink-soft);font-size:16px;max-width:44ch}\n  @media(max-width:820px){.steps{grid-template-columns:1fr}.step:nth-child(4){margin-top:0}}\n\n  /* values \u2014 big type moment */\n  .deep{\n    background:var(--ink);color:var(--paper);\n  }\n  .deep .wrap{display:grid;grid-template-columns:1.1fr 1fr;gap:80px;align-items:center}\n  .deep h2{color:var(--paper)}\n  .deep h2 em{color:var(--sea-bright)}\n  .tidefact{list-style:none;margin-top:34px}\n  .tidefact li{\n    display:flex;gap:16px;align-items:baseline;\n    padding:16px 0;border-bottom:1px solid rgba(247,243,234,.15);\n  }\n  .tidefact li b{font-family:var(--serif);font-weight:500;font-size:30px;min-width:110px;color:var(--sea-bright)}\n  .tidefact li span{color:#B9C9CB;font-size:15.5px}\n  .deep-visual{position:relative;min-height:340px}\n  .deep-visual svg{position:absolute;inset:0;width:100%;height:100%}\n  @media(max-width:880px){.deep .wrap{grid-template-columns:1fr;gap:50px}}\n\n  /* pull quote */\n  .quote-sec{text-align:center}\n  blockquote{\n    font-family:var(--serif);font-weight:300;font-style:italic;\n    font-size:clamp(26px,3.6vw,40px);line-height:1.35;\n    max-width:26ch;margin:0 auto;\n  }\n  blockquote strong{font-weight:500;color:var(--sea)}\n  .quote-by{margin-top:30px;font-size:14.5px;color:var(--ink-soft)}\n  .quote-by b{color:var(--ink)}\n  .quote-mark{font-family:var(--serif);font-size:80px;line-height:0;color:var(--coral);display:block;margin-bottom:34px}\n\n  /* CTA */\n  .cta{text-align:center;padding-bottom:130px}\n  .cta h2{margin:0 auto 24px}\n  .cta p{color:var(--ink-soft);max-width:44ch;margin:0 auto 36px}\n  .cta form{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}\n  .cta input{\n    font-family:var(--sans);font-size:15px;\n    padding:13px 20px;border-radius:999px;\n    border:1.5px solid var(--line);background:#FFFDF8;\n    min-width:280px;outline:none;transition:border .2s;\n  }\n  .cta input:focus{border-color:var(--sea)}\n  .cta .done{color:var(--sea);font-weight:600;margin-top:16px;display:none}\n\n  footer{\n    border-top:1px solid var(--line);background:var(--paper-deep);\n    padding:44px 5vw;display:flex;justify-content:space-between;\n    align-items:center;flex-wrap:wrap;gap:20px;\n  }\n  footer .foot-links{display:flex;gap:28px}\n  footer a{color:var(--ink-soft);text-decoration:none;font-size:14.5px}\n  footer a:hover{color:var(--coral)}\n  footer .fine{font-size:13px;color:var(--ink-soft)}\n\n  .reveal{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s ease}\n  .reveal.in{opacity:1;transform:none}\n</style>\n</head>\n<body>\n\n<nav id=\"nav\">\n  <div class=\"logo\">\n    <svg width=\"26\" height=\"26\" viewBox=\"0 0 26 26\" fill=\"none\">\n      <circle cx=\"13\" cy=\"13\" r=\"11.5\" stroke=\"#12333A\" stroke-width=\"2\"/>\n      <path d=\"M4 15c2.5-2.5 5-2.5 7.5 0s5 2.5 7.5 0 3-2 3-2\" stroke=\"#2E7D6E\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n    </svg>\n    Tidepool\n  </div>\n  <div class=\"nav-links\">\n    <a href=\"#rhythm\">How it works</a>\n    <a href=\"#why\">Why tides</a>\n    <a href=\"#voices\">Teams</a>\n    <a href=\"#start\" class=\"btn\">Start free</a>\n  </div>\n</nav>\n\n<!-- ================= HERO ================= -->\n<header class=\"hero\">\n  <div class=\"tide-wrap\" id=\"tideWrap\">\n    <svg id=\"tide\" viewBox=\"0 0 1440 420\" preserveAspectRatio=\"none\">\n      <path id=\"tidePath\" fill=\"#2E7D6E\" fill-opacity=\"0.13\"/>\n      <path id=\"tideLine\" fill=\"none\" stroke=\"#2E7D6E\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n    </svg>\n  </div>\n\n  <div class=\"hero-inner\">\n    <div class=\"eyebrow\">Weekly planning for small teams</div>\n    <h1>Let your week find its <em>natural rhythm.</em></h1>\n    <p class=\"hero-sub\">Tidepool is a calm, fifteen-minute Monday ritual. Your team surfaces what matters, claims the work, and sees the whole week at a glance \u2014 no status meetings required.</p>\n    <div class=\"hero-cta\">\n      <a href=\"#start\" class=\"btn sea\">Start your first week</a>\n      <a href=\"#rhythm\" class=\"btn ghost\">See how it works</a>\n      <span class=\"hero-note\">Free for teams up to 5 \u00b7 no card required</span>\n    </div>\n\n    <!-- week board mock -->\n    <div class=\"board\" aria-hidden=\"true\">\n      <div class=\"board-head\">\n        <div class=\"board-title\">Week of Mar 3 <span>\u00b7 Planning done in 14 min \u2713</span></div>\n        <div class=\"avatars\">\n          <i style=\"background:#2E7D6E\">MK</i><i style=\"background:#E2603F\">JT</i>\n          <i style=\"background:#12333A\">AR</i><i style=\"background:#4FB39B\">+2</i>\n        </div>\n      </div>\n      <div class=\"week\">\n        <div class=\"day today\">\n          <div class=\"day-head\">Mon \u00b7 Today</div>\n          <div class=\"card shared d1\"><span class=\"dot\" style=\"background:#E2603F\"></span>Ship onboarding emails<small>Maya \u00b7 shared goal</small></div>\n          <div class=\"card d2\"><span class=\"dot\" style=\"background:#2E7D6E\"></span>Weekly ritual, 9:30<small>Everyone \u00b7 15 min</small></div>\n        </div>\n        <div class=\"day\">\n          <div class=\"day-head\">Tue</div>\n          <div class=\"card focus d3\"><span class=\"dot\" style=\"background:#4FB39B\"></span>Pricing page rewrite<small>Jonas \u00b7 deep work</small></div>\n          <div class=\"card d4\"><span class=\"dot\" style=\"background:#12333A\"></span>Customer calls \u00d73<small>Ana</small></div>\n        </div>\n        <div class=\"day\">\n          <div class=\"day-head\">Wed</div>\n          <div class=\"card d5\"><span class=\"dot\" style=\"background:#2E7D6E\"></span>Q1 retro draft<small>Ana</small></div>\n          <div class=\"card focus d6\"><span class=\"dot\" style=\"background:#4FB39B\"></span>API v2 spike<small>Maya \u00b7 deep work</small></div>\n        </div>\n        <div class=\"day\">\n          <div class=\"day-head\">Thu</div>\n          <div class=\"card d7\"><span class=\"dot\" style=\"background:#E2603F\"></span>Review pricing copy<small>All \u00b7 async</small></div>\n          <div class=\"card d8\"><span class=\"dot\" style=\"background:#12333A\"></span>Demo to Northwind<small>Jonas</small></div>\n        </div>\n        <div class=\"day\">\n          <div class=\"day-head\">Fri</div>\n          <div class=\"card q d9\">What went well?<small>Friday reflection</small></div>\n          <div class=\"card d10\"><span class=\"dot\" style=\"background:#2E7D6E\"></span>Carry-over sweep<small>Auto-suggested</small></div>\n        </div>\n      </div>\n      <div class=\"hint\"><span class=\"dot\"></span>2 goals are shared \u2014 everyone can see who's carrying what</div>\n    </div>\n  </div>\n</header>\n\n<!-- ================= STRIP ================= -->\n<div class=\"strip\">\n  <div class=\"strip-track\" id=\"stripTrack\">\n    <span>Plan on <b>Monday</b>, 15 minutes</span><span>\u00b7</span>\n    <span>Reflect on <b>Friday</b>, 5 minutes</span><span>\u00b7</span>\n    <span><b>Zero</b> status meetings</span><span>\u00b7</span>\n    <span><b>Async</b> by default</span><span>\u00b7</span>\n    <span>Plan on <b>Monday</b>, 15 minutes</span><span>\u00b7</span>\n    <span>Reflect on <b>Friday</b>, 5 minutes</span><span>\u00b7</span>\n    <span><b>Zero</b> status meetings</span><span>\u00b7</span>\n    <span><b>Async</b> by default</span><span>\u00b7</span>\n  </div>\n</div>\n\n<!-- ================= HOW IT WORKS ================= -->\n<section id=\"rhythm\">\n  <div class=\"wrap\">\n    <div class=\"rhythm-head reveal\">\n      <h2>A week has a rhythm. We just help you <em>keep it.</em></h2>\n      <p>Tidepool replaces scattered to-do lists and the Monday standup with one lightweight ritual that repeats \u2014 like the tide.</p>\n    </div>\n    <div class=\"steps\">\n      <div class=\"step reveal\">\n        <div class=\"step-num\">\u2116 1</div>\n        <div>\n          <h3>Surface, don't assign</h3>\n          <p>Everyone drops in what they're tackling this week \u2014 from their own backlog, inbox, or head. Nothing gets assigned top-down; people claim their own work.</p>\n        </div>\n      </div>\n      <div class=\"step reveal\">\n        <div class=\"step-num\">\u2116 2</div>\n        <div>\n          <h3>Mark the deep water</h3>\n          <p>Flag the two or three items that need real focus. Tidepool protects those blocks on your calendar and nudges anything that would crash into them.</p>\n        </div>\n      </div>\n      <div class=\"step reveal\">\n        <div class=\"step-num\">\u2116 3</div>\n        <div>\n          <h3>See the whole pool</h3>\n          <p>One shared board shows the full week for the whole team. Spot overloads, gaps, and dependencies before they become Friday surprises.</p>\n        </div>\n      </div>\n      <div class=\"step reveal\">\n        <div class=\"step-num\">\u2116 4</div>\n        <div>\n          <h3>Friday, gently close</h3>\n          <p>A five-minute reflection: what moved, what didn't, what's worth carrying over. unfinished work doesn't vanish \u2014 it flows into next week automatically.</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ================= WHY / DEEP SECTION ================= -->\n<section class=\"deep\" id=\"why\">\n  <div class=\"wrap\">\n    <div class=\"reveal\">\n      <div class=\"sec-label\" style=\"color:var(--sea-bright)\">Why tides</div>\n      <h2>Plans shouldn't be dams. They should be <em>tides.</em></h2>\n      <ul class=\"tidefact\">\n        <li><b>15 min</b><span>the entire weekly ritual \u2014 shorter than one status meeting</span></li>\n        <li><b>2\u20138</b><span>people per team, the size where weekly planning actually works</span></li>\n        <li><b>0</b><span>recurring check-in meetings you'll need to keep</span></li>\n      </ul>\n    </div>\n    <div class=\"deep-visual reveal\">\n      <svg viewBox=\"0 0 400 340\" fill=\"none\" aria-hidden=\"true\">\n        <g id=\"moonGroup\">\n          <circle cx=\"320\" cy=\"70\" r=\"34\" stroke=\"#4FB39B\" stroke-width=\"2\"/>\n          <path d=\"M306 58a20 20 0 0 0 0 24 26 26 0 1 1 0-24Z\" fill=\"#4FB39B\"/>\n        </g>\n        <path id=\"waveA\" d=\"M0 150 Q 50 130 100 150 T 200 150 T 300 150 T 400 150\" stroke=\"#4FB39B\" stroke-width=\"2\" stroke-linecap=\"round\" opacity=\".9\"/>\n        <path id=\"waveB\" d=\"M0 200 Q 50 182 100 200 T 200 200 T 300 200 T 400 200\" stroke=\"#4FB39B\" stroke-width=\"1.5\" stroke-linecap=\"round\" opacity=\".55\"/>\n        <path id=\"waveC\" d=\"M0 250 Q 50 236 100 250 T 200 250 T 300 250 T 400 250\" stroke=\"#4FB39B\" stroke-width=\"1\" stroke-linecap=\"round\" opacity=\".3\"/>\n        <text x=\"0\" y=\"315\" fill=\"#B9C9CB\" font-family=\"Karla,sans-serif\" font-size=\"13\" font-style=\"italic\">high tide \u2014 plan lightly, focus deeply</text>\n      </svg>\n    </div>\n  </div>\n</section>\n\n<!-- ================= QUOTE ================= -->\n<section class=\"quote-sec\" id=\"voices\">\n  <div class=\"wrap reveal\">\n    <span class=\"quote-mark\">\u201c</span>\n    <blockquote>We deleted our Monday standup three weeks in. Now the whole week lives on one board, and nobody has to <strong>ask what anyone is doing.</strong></blockquote>\n    <p class=\"quote-by\"><b>Priya Nair</b> \u00b7 co-founder, Driftwood Studio (team of 6)</p>\n  </div>\n</section>\n\n<!-- ================= CTA ================= -->\n<section class=\"cta\" id=\"start\">\n  <div class=\"wrap reveal\">\n    <h2>Try one week. <em style=\"color:var(--sea);font-weight:300;font-style:italic\">That's all it takes.</em></h2>\n    <p>Free for teams up to five, forever. Set up your first board in under two minutes.</p>\n    <form id=\"ctaForm\">\n      <input type=\"email\" placeholder=\"you@yourteam.com\" required aria-label=\"Work email\">\n      <button type=\"submit\" class=\"btn sea\">Start free</button>\n    </form>\n    <p class=\"done\" id=\"ctaDone\">Welcome aboard \u2014 check your inbox for your first tide. \ud83c\udf0a</p>\n  </div>\n</section>\n\n<footer>\n  <div class=\"logo\" style=\"font-size:18px\">\n    <svg width=\"22\" height=\"22\" viewBox=\"0 0 26 26\" fill=\"none\">\n      <circle cx=\"13\" cy=\"13\" r=\"11.5\" stroke=\"#12333A\" stroke-width=\"2\"/>\n      <path d=\"M4 15c2.5-2.5 5-2.5 7.5 0s5 2.5 7.5 0 3-2 3-2\" stroke=\"#2E7D6E\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n    </svg>\n    Tidepool\n  </div>\n  <div class=\"foot-links\">\n    <a href=\"#rhythm\">How it works</a><a href=\"#why\">Why tides</a>\n    <a href=\"#start\">Pricing</a><a href=\"#\">Changelog</a>\n  </div>\n  <div class=\"fine\">\u00a9 2025 Tidepool \u00b7 Made slowly, by a small team</div>\n</footer>\n\n<script>\n  // nav background on scroll\n  const nav = document.getElementById('nav');\n  addEventListener('scroll', () => nav.classList.toggle('scrolled', scrollY > 40), {passive:true});\n\n  // signature moment: breathing tide that follows the cursor\n  const tidePath = document.getElementById('tidePath');\n  const tideLine = document.getElementById('tideLine');\n  let mx = 0.5, target = 0.5, t = 0;\n\n  addEventListener('pointermove', e => { target = e.clientX / innerWidth; });\n\n  function buildTide(){\n    mx += (target - mx) * 0.04;\n    t += 0.012;\n    const W = 1440, base = 240;\n    let top = [];\n    const N = 24;\n    for (let i = 0; i <= N; i++){\n      const x = (W / N) * i;\n      const pull = Math.exp(-Math.pow((x - mx * W) / 320, 2)); // cursor influence\n      const y = base\n        + Math.sin(i * 0.7 + t * 1.6) * 26       // long swell\n        + Math.sin(i * 1.9 - t * 2.4) * 10       // chop\n        - pull * 60;                              // rise toward cursor\n      top.push([x, y]);\n    }\n    let d = 'M0 420 L0 ' + top[0][1].toFixed(1);\n    for (let i = 1; i <= N; i++){\n      const p = top[i-1], c = top[i];\n      d += ` Q${((p[0]+c[0])/2).toFixed(1)} ${p[1].toFixed(1)} ${c[0].toFixed(1)} ${c[1].toFixed(1)}`;\n    }\n    d += ` L${W} 420 Z`;\n    tidePath.setAttribute('d', d);\n    tideLine.setAttribute('d', d.replace(/L0 | L1440 420 Z/,'').replace(/^M0 420/,'M0 '+top[0][1].toFixed(1)));\n    requestAnimationFrame(buildTide);\n  }\n  buildTide();\n\n  // gentle phase-shifting waves in deep section\n  const wA = document.getElementById('waveA'), wB = document.getElementById('waveB'), wC = document.getElementById('waveC');\n  function buildWaves(){\n    const tt = performance.now() / 1000;\n    const mk = (y, amp, sp, ph) => {\n      let d = 'M0 ' + y;\n      for (let x = 0; x <= 400; x += 50){\n        d += ` Q${x+25} ${(y + Math.sin(x/70 + tt*sp + ph)*amp).toFixed(1)} ${x+50} ${(y + Math.sin((x+50)/70 + tt*sp + ph)*amp).toFixed(1)}`;\n      }\n      return d;\n    };\n    wA.setAttribute('d', mk(150, 16, 1.1, 0));\n    wB.setAttribute('d', mk(200, 12, 1.4, 2));\n    wC.setAttribute('d', mk(250, 9, 1.8, 4));\n    requestAnimationFrame(buildWaves);\n  }\n  buildWaves();\n\n  // moon drifts slowly\n  const moon = document.getElementById('moonGroup');\n  (function driftMoon(){\n    const tt = performance.now()/1000;\n    moon.setAttribute('transform', `translate(${Math.sin(tt*0.4)*10} ${Math.cos(tt*0.3)*6})`);\n    requestAnimationFrame(driftMoon);\n  })();\n\n  // reveal on scroll\n  const io = new IntersectionObserver(es => es.forEach(e => {\n    if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }\n  }), {threshold: .15});\n  document.querySelectorAll('.reveal').forEach(el => io.observe(el));\n\n  // fake signup\n  document.getElementById('ctaForm').addEventListener('submit', e => {\n    e.preventDefault();\n    document.getElementById('ctaDone').style.display = 'block';\n    e.target.reset();\n  });\n</script>\n</body>\n</html>\n"}