{"arm": "direct", "model": "openai/gpt-6-luna", "i": 6, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <meta name=\"theme-color\" content=\"#f7f8f4\">\n  <title>Tidepool \u2014 Make a week that works</title>\n  <style>\n    :root {\n      color-scheme: light;\n      --ink: #173b3b;\n      --muted: #627676;\n      --teal: #167c73;\n      --teal-dark: #0d625b;\n      --mint: #dff1e9;\n      --paper: #f7f8f4;\n      --line: #e6ebe5;\n      --coral: #f2a88f;\n      --shadow: 0 24px 70px rgba(24, 62, 58, .13);\n    }\n\n    * { box-sizing: border-box; }\n\n    html { scroll-behavior: smooth; }\n\n    body {\n      margin: 0;\n      background: var(--paper);\n      color: var(--ink);\n      font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      -webkit-font-smoothing: antialiased;\n    }\n\n    a { color: inherit; text-decoration: none; }\n\n    .page-shell {\n      position: relative;\n      overflow: hidden;\n    }\n\n    .container {\n      width: min(1160px, calc(100% - 48px));\n      margin: 0 auto;\n    }\n\n    .topbar {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      height: 88px;\n    }\n\n    .brand {\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      color: var(--ink);\n      font-size: 21px;\n      font-weight: 750;\n      letter-spacing: -1px;\n    }\n\n    .brand-mark {\n      position: relative;\n      display: grid;\n      width: 33px;\n      height: 33px;\n      place-items: center;\n      border-radius: 50%;\n      background: #cfe9de;\n    }\n\n    .brand-mark::before,\n    .brand-mark::after {\n      position: absolute;\n      content: \"\";\n      width: 17px;\n      height: 8px;\n      border: 2px solid var(--teal);\n      border-radius: 50%;\n      transform: rotate(-24deg);\n    }\n\n    .brand-mark::before { top: 9px; left: 8px; }\n    .brand-mark::after {\n      top: 15px;\n      left: 8px;\n      width: 13px;\n      border-color: #5bb6a1;\n    }\n\n    .nav-links {\n      display: flex;\n      align-items: center;\n      gap: 34px;\n      color: #526b69;\n      font-size: 13px;\n      font-weight: 600;\n    }\n\n    .nav-links a:hover { color: var(--teal); }\n\n    .nav-cta {\n      padding: 11px 18px;\n      border-radius: 9px;\n      background: var(--ink);\n      color: white !important;\n      transition: transform .2s ease, background .2s ease;\n    }\n\n    .nav-cta:hover {\n      background: var(--teal-dark);\n      transform: translateY(-1px);\n    }\n\n    .hero {\n      position: relative;\n      display: grid;\n      grid-template-columns: .91fr 1.09fr;\n      align-items: center;\n      gap: 52px;\n      min-height: 610px;\n      padding: 55px 0 84px;\n    }\n\n    .hero::before {\n      position: absolute;\n      z-index: -1;\n      top: -95px;\n      right: -250px;\n      width: 780px;\n      height: 780px;\n      content: \"\";\n      border-radius: 50%;\n      background: radial-gradient(circle at 48% 46%, #e2f1e7 0, #e9f3e9 37%, rgba(247, 248, 244, 0) 70%);\n    }\n\n    .eyebrow {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      margin-bottom: 23px;\n      color: var(--teal);\n      font-size: 11px;\n      font-weight: 800;\n      letter-spacing: 1.7px;\n      text-transform: uppercase;\n    }\n\n    .eyebrow-dot {\n      width: 7px;\n      height: 7px;\n      border-radius: 50%;\n      background: #f2a88f;\n      box-shadow: 0 0 0 4px rgba(242, 168, 143, .17);\n    }\n\n    h1 {\n      max-width: 520px;\n      margin: 0;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: clamp(50px, 6vw, 76px);\n      font-weight: 500;\n      letter-spacing: -4.5px;\n      line-height: .99;\n    }\n\n    h1 em {\n      color: var(--teal);\n      font-weight: 500;\n    }\n\n    .hero-copy {\n      max-width: 430px;\n      margin: 24px 0 29px;\n      color: #647775;\n      font-size: 16px;\n      line-height: 1.75;\n    }\n\n    .hero-actions {\n      display: flex;\n      align-items: center;\n      gap: 20px;\n    }\n\n    .button {\n      display: inline-flex;\n      min-height: 48px;\n      align-items: center;\n      justify-content: center;\n      gap: 10px;\n      padding: 0 20px;\n      border: 1px solid transparent;\n      border-radius: 9px;\n      background: var(--teal);\n      color: white;\n      font-size: 13px;\n      font-weight: 700;\n      box-shadow: 0 8px 18px rgba(22, 124, 115, .16);\n      transition: transform .2s ease, background .2s ease, box-shadow .2s ease;\n    }\n\n    .button:hover {\n      transform: translateY(-2px);\n      background: var(--teal-dark);\n      box-shadow: 0 12px 22px rgba(22, 124, 115, .2);\n    }\n\n    .button svg { width: 15px; height: 15px; }\n\n    .text-link {\n      color: #45615e;\n      font-size: 13px;\n      font-weight: 700;\n    }\n\n    .text-link span {\n      margin-left: 5px;\n      color: var(--teal);\n    }\n\n    .social-proof {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      margin-top: 39px;\n    }\n\n    .avatar-stack { display: flex; padding-left: 3px; }\n\n    .avatar {\n      display: grid;\n      width: 29px;\n      height: 29px;\n      margin-left: -4px;\n      place-items: center;\n      border: 2px solid var(--paper);\n      border-radius: 50%;\n      color: #335552;\n      font-size: 9px;\n      font-weight: 800;\n    }\n\n    .avatar:nth-child(1) { background: #f2c7ad; }\n    .avatar:nth-child(2) { background: #c8d9c4; }\n    .avatar:nth-child(3) { background: #e8c6d2; }\n    .avatar:nth-child(4) { background: #b7d9d3; }\n\n    .proof-copy { color: #71817e; font-size: 11px; line-height: 1.5; }\n    .proof-copy strong { display: block; color: var(--ink); font-size: 12px; }\n\n    .product-wrap {\n      position: relative;\n      padding: 18px 0 30px 15px;\n    }\n\n    .product-wrap::before {\n      position: absolute;\n      top: 2px;\n      right: 35px;\n      width: 100px;\n      height: 100px;\n      content: \"\";\n      border: 1px solid rgba(22, 124, 115, .11);\n      border-radius: 50%;\n    }\n\n    .product-window {\n      position: relative;\n      z-index: 1;\n      overflow: hidden;\n      border: 1px solid rgba(27, 68, 64, .1);\n      border-radius: 14px;\n      background: #fff;\n      box-shadow: var(--shadow);\n      transform: rotate(1.1deg);\n    }\n\n    .window-top {\n      display: flex;\n      height: 42px;\n      align-items: center;\n      justify-content: space-between;\n      padding: 0 15px;\n      border-bottom: 1px solid #edf0ec;\n      background: #fcfdfb;\n    }\n\n    .window-dots { display: flex; gap: 5px; }\n    .window-dots i { width: 6px; height: 6px; border-radius: 50%; background: #d7dfda; }\n    .window-title { color: #85938e; font-size: 9px; font-weight: 700; letter-spacing: .4px; }\n    .window-utility { color: #9aa8a2; font-size: 10px; }\n\n    .app-layout {\n      display: grid;\n      min-height: 390px;\n      grid-template-columns: 125px 1fr;\n    }\n\n    .app-sidebar {\n      padding: 18px 12px;\n      border-right: 1px solid #edf0ec;\n      background: #fbfcfa;\n    }\n\n    .workspace-label {\n      margin: 0 0 17px 6px;\n      color: #a0aaa5;\n      font-size: 8px;\n      font-weight: 800;\n      letter-spacing: 1px;\n      text-transform: uppercase;\n    }\n\n    .side-item {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      margin-bottom: 5px;\n      padding: 8px 7px;\n      border-radius: 6px;\n      color: #7a8984;\n      font-size: 9px;\n      font-weight: 600;\n    }\n\n    .side-item.active { background: #eaf5ef; color: var(--teal-dark); }\n    .side-icon { width: 12px; height: 12px; opacity: .8; }\n\n    .team-box {\n      margin-top: 32px;\n      padding: 10px 8px;\n      border: 1px solid #edf0ec;\n      border-radius: 7px;\n      color: #81908b;\n      font-size: 8px;\n      line-height: 1.6;\n    }\n\n    .team-box strong {\n      display: block;\n      margin-bottom: 4px;\n      color: #3d5853;\n      font-size: 9px;\n    }\n\n    .app-main { padding: 21px 22px 20px; }\n\n    .app-heading {\n      display: flex;\n      align-items: flex-start;\n      justify-content: space-between;\n      margin-bottom: 17px;\n    }\n\n    .app-heading h2 {\n      margin: 0;\n      color: #244442;\n      font-family: Georgia, serif;\n      font-size: 21px;\n      font-weight: 500;\n      letter-spacing: -.5px;\n    }\n\n    .app-heading p { margin: 5px 0 0; color: #9aa7a1; font-size: 8px; }\n\n    .week-switch {\n      padding: 6px 9px;\n      border: 1px solid #e9eeea;\n      border-radius: 5px;\n      color: #6c807a;\n      font-size: 8px;\n      font-weight: 700;\n    }\n\n    .week-grid {\n      display: grid;\n      grid-template-columns: 55px repeat(5, 1fr);\n      border: 1px solid #edf0ec;\n      border-radius: 7px;\n      overflow: hidden;\n    }\n\n    .day-head {\n      padding: 9px 3px;\n      border-bottom: 1px solid #edf0ec;\n      background: #fbfcfa;\n      color: #84938c;\n      text-align: center;\n      font-size: 8px;\n      font-weight: 700;\n    }\n\n    .day-head:first-child { background: #fbfcfa; }\n    .day-head.today { color: var(--teal); background: #eff8f3; }\n    .day-head b { display: block; margin-top: 4px; color: #385551; font-size: 11px; }\n\n    .time-cell {\n      min-height: 67px;\n      padding: 8px 5px;\n      border-right: 1px solid #edf0ec;\n      border-bottom: 1px solid #edf0ec;\n      color: #a1aca6;\n      font-size: 7px;\n    }\n\n    .task-cell {\n      min-height: 67px;\n      padding: 5px 4px;\n      border-right: 1px solid #edf0ec;\n      border-bottom: 1px solid #edf0ec;\n    }\n\n    .task {\n      min-height: 33px;\n      padding: 6px 5px;\n      border-left: 2px solid #65ae91;\n      border-radius: 3px;\n      background: #eaf5ed;\n      color: #476e5e;\n      font-size: 7px;\n      font-weight: 700;\n      line-height: 1.35;\n    }\n\n    .task.coral { border-color: #e49b7e; background: #fff1e9; color: #91614f; }\n    .task.blue { border-color: #83b5c0; background: #edf6f7; color: #53757c; }\n    .task.lilac { border-color: #b4a1c8; background: #f4eff8; color: #79678e; }\n    .task + .task { margin-top: 4px; }\n\n    .focus-row {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      margin-top: 13px;\n      padding: 10px 11px;\n      border-radius: 6px;\n      background: #f8faf7;\n    }\n\n    .focus-copy { color: #83918b; font-size: 8px; }\n    .focus-copy strong { display: block; margin-bottom: 3px; color: #3c5752; font-size: 9px; }\n    .mini-avatars { display: flex; }\n    .mini-avatars span {\n      display: grid;\n      width: 20px;\n      height: 20px;\n      margin-left: -4px;\n      place-items: center;\n      border: 1px solid white;\n      border-radius: 50%;\n      background: #d7e8dc;\n      color: #537266;\n      font-size: 7px;\n      font-weight: 800;\n    }\n    .mini-avatars span:nth-child(2) { background: #f2d6c7; }\n    .mini-avatars span:nth-child(3) { background: #d7d0e5; }\n\n    .floating-note {\n      position: absolute;\n      z-index: 2;\n      right: -9px;\n      bottom: 7px;\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      padding: 12px 15px;\n      border: 1px solid rgba(35, 77, 69, .08);\n      border-radius: 9px;\n      background: white;\n      box-shadow: 0 12px 30px rgba(24, 62, 58, .12);\n      transform: rotate(-2deg);\n    }\n\n    .note-check {\n      display: grid;\n      width: 25px;\n      height: 25px;\n      place-items: center;\n      border-radius: 50%;\n      background: #e2f2e9;\n      color: var(--teal);\n      font-size: 12px;\n      font-weight: 900;\n    }\n\n    .floating-note strong { display: block; color: #355450; font-size: 10px; }\n    .floating-note small { color: #91a09a; font-size: 8px; }\n\n    .trust {\n      padding: 29px 0 35px;\n      border-top: 1px solid #e9ede7;\n      border-bottom: 1px solid #e9ede7;\n      text-align: center;\n    }\n\n    .trust-label {\n      margin: 0 0 20px;\n      color: #87958e;\n      font-size: 10px;\n      font-weight: 700;\n      letter-spacing: 1.4px;\n      text-transform: uppercase;\n    }\n\n    .trust-list {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: clamp(24px, 6vw, 76px);\n      color: #7d9089;\n      font-family: Georgia, serif;\n      font-size: 17px;\n      font-weight: 700;\n      letter-spacing: -.4px;\n    }\n\n    .trust-list span:nth-child(2) { font-family: ui-sans-serif, system-ui, sans-serif; font-size: 14px; letter-spacing: 1px; }\n    .trust-list span:nth-child(3) { font-style: italic; }\n    .trust-list span:nth-child(4) { font-family: ui-sans-serif, system-ui, sans-serif; font-size: 15px; font-weight: 800; letter-spacing: 2px; }\n\n    .section {\n      padding: 102px 0;\n    }\n\n    .section-heading {\n      max-width: 620px;\n      margin: 0 auto 49px;\n      text-align: center;\n    }\n\n    .section-heading .eyebrow { margin-bottom: 15px; }\n\n    h2.section-title {\n      margin: 0;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: clamp(35px, 4vw, 49px);\n      font-weight: 500;\n      letter-spacing: -2px;\n      line-height: 1.1;\n    }\n\n    .section-intro {\n      max-width: 470px;\n      margin: 15px auto 0;\n      color: var(--muted);\n      font-size: 14px;\n      line-height: 1.75;\n    }\n\n    .feature-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 18px;\n    }\n\n    .feature-card {\n      min-height: 228px;\n      padding: 27px 27px 25px;\n      border: 1px solid #e6ebe5;\n      border-radius: 12px;\n      background: rgba(255, 255, 255, .68);\n      transition: transform .2s ease, box-shadow .2s ease;\n    }\n\n    .feature-card:hover {\n      transform: translateY(-4px);\n      box-shadow: 0 15px 35px rgba(24, 62, 58, .07);\n    }\n\n    .feature-icon {\n      display: grid;\n      width: 40px;\n      height: 40px;\n      margin-bottom: 24px;\n      place-items: center;\n      border-radius: 11px;\n      background: #e5f2e9;\n      color: var(--teal);\n    }\n\n    .feature-card:nth-child(2) .feature-icon { background: #fff0e9; color: #c2785b; }\n    .feature-card:nth-child(3) .feature-icon { background: #edf0f8; color: #767eae; }\n\n    .feature-icon svg { width: 20px; height: 20px; }\n\n    .feature-card h3 {\n      margin: 0 0 9px;\n      color: #234542;\n      font-family: Georgia, serif;\n      font-size: 19px;\n      font-weight: 500;\n    }\n\n    .feature-card p {\n      margin: 0;\n      color: #71817b;\n      font-size: 12px;\n      line-height: 1.75;\n    }\n\n    .quote-band {\n      position: relative;\n      overflow: hidden;\n      padding: 67px 35px;\n      border-radius: 16px;\n      background: #e5f0e7;\n      text-align: center;\n    }\n\n    .quote-band::before,\n    .quote-band::after {\n      position: absolute;\n      content: \"\";\n      border: 1px solid rgba(22, 124, 115, .11);\n      border-radius: 50%;\n    }\n\n    .quote-band::before { width: 270px; height: 270px; top: -176px; left: -66px; }\n    .quote-band::after { width: 330px; height: 330px; right: -100px; bottom: -252px; }\n\n    .quote-mark {\n      margin-bottom: 12px;\n      color: #74aa91;\n      font-family: Georgia, serif;\n      font-size: 42px;\n      line-height: .7;\n    }\n\n    blockquote {\n      max-width: 700px;\n      margin: 0 auto 20px;\n      color: #264b45;\n      font-family: Georgia, serif;\n      font-size: clamp(22px, 3vw, 31px);\n      line-height: 1.38;\n      letter-spacing: -.5px;\n    }\n\n    .quote-attribution { color: #71867e; font-size: 11px; }\n    .quote-attribution strong { color: #355c52; }\n\n    .bottom-cta {\n      padding: 92px 0 95px;\n      text-align: center;\n    }\n\n    .bottom-cta h2 {\n      margin: 0;\n      font-family: Georgia, serif;\n      font-size: clamp(39px, 5vw, 56px);\n      font-weight: 500;\n      letter-spacing: -2.5px;\n    }\n\n    .bottom-cta p {\n      margin: 13px auto 24px;\n      color: var(--muted);\n      font-size: 14px;\n    }\n\n    .footer {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 23px 0 28px;\n      border-top: 1px solid #e6ebe5;\n      color: #86948e;\n      font-size: 10px;\n    }\n\n    .footer .brand { font-size: 16px; }\n    .footer .brand-mark { width: 27px; height: 27px; }\n    .footer-links { display: flex; gap: 22px; }\n    .footer-links a:hover { color: var(--teal); }\n\n    @media (max-width: 900px) {\n      .hero { grid-template-columns: 1fr; gap: 25px; padding-top: 38px; }\n      .hero-content { max-width: 600px; }\n      .product-wrap { width: min(650px, 100%); margin: 0 auto; padding-left: 0; }\n      .hero::before { top: 150px; right: -350px; }\n      .product-window { transform: rotate(.5deg); }\n      .feature-grid { gap: 12px; }\n      .feature-card { padding: 22px 19px; }\n    }\n\n    @media (max-width: 640px) {\n      .container { width: min(100% - 36px, 520px); }\n      .topbar { height: 72px; }\n      .nav-links { gap: 14px; }\n      .nav-links a:not(.nav-cta) { display: none; }\n      .nav-cta { padding: 10px 13px; font-size: 11px; }\n      .hero { min-height: auto; padding: 42px 0 58px; gap: 22px; }\n      h1 { font-size: clamp(48px, 14vw, 68px); letter-spacing: -3.5px; }\n      .hero-copy { margin: 18px 0 22px; font-size: 14px; }\n      .hero-actions { gap: 15px; }\n      .button { min-height: 45px; padding: 0 15px; font-size: 12px; }\n      .social-proof { margin-top: 27px; }\n      .product-wrap { padding: 4px 0 26px; }\n      .product-window { transform: none; }\n      .app-layout { grid-template-columns: 78px 1fr; min-height: 330px; }\n      .app-sidebar { padding: 15px 7px; }\n      .side-item { gap: 5px; padding: 7px 4px; font-size: 7px; }\n      .workspace-label { margin-left: 4px; font-size: 6px; }\n      .team-box { padding: 7px 5px; font-size: 7px; }\n      .app-main { padding: 16px 9px; }\n      .app-heading h2 { font-size: 17px; }\n      .week-switch { padding: 5px; font-size: 7px; }\n      .week-grid { grid-template-columns: 35px repeat(5, 1fr); }\n      .day-head { font-size: 6px; }\n      .day-head b { font-size: 9px; }\n      .time-cell { min-height: 62px; padding: 7px 2px; font-size: 6px; }\n      .task-cell { min-height: 62px; padding: 4px 2px; }\n      .task { padding: 5px 3px; font-size: 6px; }\n      .focus-row { padding: 8px; }\n      .floating-note { right: -2px; bottom: 0; padding: 9px 11px; }\n      .trust { padding: 25px 0; }\n      .trust-list { flex-wrap: wrap; gap: 16px 28px; font-size: 14px; }\n      .trust-list span:nth-child(2) { font-size: 12px; }\n      .trust-list span:nth-child(4) { font-size: 12px; }\n      .section { padding: 73px 0; }\n      .section-heading { margin-bottom: 30px; }\n      .feature-grid { grid-template-columns: 1fr; }\n      .feature-card { min-height: 0; padding: 22px; }\n      .feature-icon { margin-bottom: 17px; }\n      .quote-band { padding: 52px 20px; }\n      .bottom-cta { padding: 70px 0; }\n      .footer { align-items: flex-start; gap: 18px; flex-direction: column; }\n      .footer-links { flex-wrap: wrap; gap: 16px; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      html { scroll-behavior: auto; }\n      *, *::before, *::after { transition-duration: .01ms !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"page-shell\">\n    <header class=\"container topbar\">\n      <a class=\"brand\" href=\"#\" aria-label=\"Tidepool home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\"></span>\n        <span>tidepool</span>\n      </a>\n      <nav class=\"nav-links\" aria-label=\"Main navigation\">\n        <a href=\"#how-it-works\">How it works</a>\n        <a href=\"#teams\">For teams</a>\n        <a href=\"#about\">About</a>\n        <a class=\"nav-cta\" href=\"#get-started\">Get started <span aria-hidden=\"true\">\u2197</span></a>\n      </nav>\n    </header>\n\n    <main>\n      <section class=\"container hero\">\n        <div class=\"hero-content\">\n          <div class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> A calmer way to work together</div>\n          <h1>Make a week<br>that works for <em>everyone.</em></h1>\n          <p class=\"hero-copy\">\n            Tidepool gives your team one easy place to set priorities, make space for deep work, and find your rhythm together.\n          </p>\n          <div class=\"hero-actions\">\n            <a class=\"button\" href=\"#get-started\">\n              Plan your first week\n              <svg viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 10h11M10 5l5 5-5 5\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            </a>\n            <a class=\"text-link\" href=\"#how-it-works\">See how it works <span>\u2192</span></a>\n          </div>\n          <div class=\"social-proof\">\n            <div class=\"avatar-stack\" aria-hidden=\"true\">\n              <span class=\"avatar\">AM</span><span class=\"avatar\">JL</span><span class=\"avatar\">SK</span><span class=\"avatar\">RD</span>\n            </div>\n            <div class=\"proof-copy\"><strong>Good weeks, shared.</strong> Loved by thoughtful teams everywhere</div>\n          </div>\n        </div>\n\n        <div class=\"product-wrap\" aria-label=\"Preview of the Tidepool weekly planning app\">\n          <div class=\"product-window\">\n            <div class=\"window-top\">\n              <div class=\"window-dots\" aria-hidden=\"true\"><i></i><i></i><i></i></div>\n              <span class=\"window-title\">TIDEPOOL / STUDIO NORTH</span>\n              <span class=\"window-utility\">\u2022\u2022\u2022</span>\n            </div>\n            <div class=\"app-layout\">\n              <aside class=\"app-sidebar\">\n                <p class=\"workspace-label\">Workspace</p>\n                <div class=\"side-item active\">\n                  <svg class=\"side-icon\" viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\"><rect x=\"2\" y=\"3\" width=\"12\" height=\"11\" rx=\"2\" stroke=\"currentColor\" stroke-width=\"1.4\"/><path d=\"M5 1.8v3M11 1.8v3M2 6.5h12\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\"/></svg>\n                  This week\n                </div>\n                <div class=\"side-item\">\n                  <svg class=\"side-icon\" viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\"><path d=\"M3 4h10M3 8h10M3 12h6\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg>\n                  Priorities\n                </div>\n                <div class=\"side-item\">\n                  <svg class=\"side-icon\" viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\"><circle cx=\"8\" cy=\"8\" r=\"5.5\" stroke=\"currentColor\" stroke-width=\"1.4\"/><path d=\"M8 5v3l2 1\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\"/></svg>\n                  Focus time\n                </div>\n                <div class=\"team-box\"><strong>Studio North</strong>6 teammates<br>Weekly check-in \u00b7 Mon</div>\n              </aside>\n\n              <div class=\"app-main\">\n                <div class=\"app-heading\">\n                  <div>\n                    <h2>Your week, in sync.</h2>\n                    <p>September 16 \u2013 20 \u00b7 A little room to do your best work.</p>\n                  </div>\n                  <div class=\"week-switch\">\u2039 &nbsp; This week &nbsp; \u203a</div>\n                </div>\n\n                <div class=\"week-grid\" role=\"presentation\">\n                  <div class=\"day-head\"></div>\n                  <div class=\"day-head today\">MON<b>16</b></div>\n                  <div class=\"day-head\">TUE<b>17</b></div>\n                  <div class=\"day-head\">WED<b>18</b></div>\n                  <div class=\"day-head\">THU<b>19</b></div>\n                  <div class=\"day-head\">FRI<b>20</b></div>\n\n                  <div class=\"time-cell\">9:00</div>\n                  <div class=\"task-cell\"><div class=\"task\">Team<br>kickoff</div></div>\n                  <div class=\"task-cell\"><div class=\"task coral\">Design<br>review</div></div>\n                  <div class=\"task-cell\"><div class=\"task blue\">Deep work</div></div>\n                  <div class=\"task-cell\"><div class=\"task\">Team<br>sync</div></div>\n                  <div class=\"task-cell\"><div class=\"task lilac\">Weekly<br>wrap-up</div></div>\n\n                  <div class=\"time-cell\">11:00</div>\n                  <div class=\"task-cell\"><div class=\"task coral\">Website<br>launch</div></div>\n                  <div class=\"task-cell\"><div class=\"task blue\">Focus time</div></div>\n                  <div class=\"task-cell\"><div class=\"task\">Research<br>notes</div></div>\n                  <div class=\"task-cell\"><div class=\"task lilac\">Planning</div></div>\n                  <div class=\"task-cell\"><div class=\"task coral\">Ship it!</div></div>\n\n                  <div class=\"time-cell\">1:00</div>\n                  <div class=\"task-cell\"><div class=\"task blue\">Focus time</div></div>\n                  <div class=\"task-cell\"><div class=\"task\">Pairing</div></div>\n                  <div class=\"task-cell\"><div class=\"task coral\">Lunch &<br>learn</div></div>\n                  <div class=\"task-cell\"><div class=\"task blue\">Focus time</div></div>\n                  <div class=\"task-cell\"><div class=\"task\">Open<br>afternoon</div></div>\n\n                  <div class=\"time-cell\">3:00</div>\n                  <div class=\"task-cell\"><div class=\"task lilac\">1:1 with<br>Sam</div></div>\n                  <div class=\"task-cell\"><div class=\"task\">Project<br>check-in</div></div>\n                  <div class=\"task-cell\"><div class=\"task blue\">Focus time</div></div>\n                  <div class=\"task-cell\"><div class=\"task coral\">Show & tell</div></div>\n                  <div class=\"task-cell\"><div class=\"task\"></div></div>\n                </div>\n\n                <div class=\"focus-row\">\n                  <div class=\"focus-copy\"><strong>Team focus this week</strong>Website refresh \u00b7 3 shared priorities</div>\n                  <div class=\"mini-avatars\" aria-label=\"Three teammates\">\n                    <span>J</span><span>A</span><span>M</span>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div class=\"floating-note\">\n            <span class=\"note-check\">\u2713</span>\n            <span><strong>Everyone\u2019s on the same page</strong><small>Weekly plan just came together</small></span>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"trust\" id=\"teams\">\n        <div class=\"container\">\n          <p class=\"trust-label\">A little more in sync, at teams like</p>\n          <div class=\"trust-list\" aria-label=\"Teams using Tidepool\">\n            <span>goodkind</span>\n            <span>COMMONPLACE</span>\n            <span>Fieldnotes</span>\n            <span>FOLK STUDIO</span>\n            <span>\u25cf northstar</span>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"container section\" id=\"how-it-works\">\n        <div class=\"section-heading\">\n          <div class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> Less juggling, more together</div>\n          <h2 class=\"section-title\">A good week starts<br>with a shared picture.</h2>\n          <p class=\"section-intro\">Bring the moving pieces into the open. Make a plan that feels possible, then leave room for the unexpected.</p>\n        </div>\n\n        <div class=\"feature-grid\">\n          <article class=\"feature-card\">\n            <div class=\"feature-icon\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 5.5h16M4 12h10M4 18.5h13\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/><circle cx=\"18\" cy=\"12\" r=\"2\" stroke=\"currentColor\" stroke-width=\"1.7\"/></svg>\n            </div>\n            <h3>Choose what matters</h3>\n            <p>Agree on the few priorities worth your attention, so the whole team knows what a good week looks like.</p>\n          </article>\n\n          <article class=\"feature-card\">\n            <div class=\"feature-icon\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><rect x=\"4\" y=\"5\" width=\"16\" height=\"15\" rx=\"2.5\" stroke=\"currentColor\" stroke-width=\"1.7\"/><path d=\"M8 3v4M16 3v4M4 9.5h16M8 13h3M8 16.5h6\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/></svg>\n            </div>\n            <h3>Make space for focus</h3>\n            <p>See how everyone\u2019s week is shaping up and protect the time people need to do their best work.</p>\n          </article>\n\n          <article class=\"feature-card\">\n            <div class=\"feature-icon\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M7 12.5l3.2 3.2L17.5 8\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"12\" cy=\"12\" r=\"9\" stroke=\"currentColor\" stroke-width=\"1.7\"/></svg>\n            </div>\n            <h3>Finish the week feeling good</h3>\n            <p>Notice what moved forward, learn what got in the way, and carry the right things into next week.</p>\n          </article>\n        </div>\n      </section>\n\n      <section class=\"container\" id=\"about\">\n        <div class=\"quote-band\">\n          <div class=\"quote-mark\" aria-hidden=\"true\">\u201c</div>\n          <blockquote>We stopped spending Monday figuring out what we were doing. Now we spend it actually doing the work.</blockquote>\n          <div class=\"quote-attribution\"><strong>Jamie Lee</strong> \u00b7 Co-founder, Goodkind Studio</div>\n        </div>\n      </section>\n\n      <section class=\"container bottom-cta\" id=\"get-started\">\n        <div class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> Your next good week starts here</div>\n        <h2>Find your team\u2019s flow.</h2>\n        <p>Plan together. Make room. See what happens.</p>\n        <a class=\"button\" href=\"mailto:hello@tidepool.team\">\n          Get started for free\n          <svg viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 10h11M10 5l5 5-5 5\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n        </a>\n      </section>\n    </main>\n\n    <footer class=\"container footer\">\n      <a class=\"brand\" href=\"#\" aria-label=\"Tidepool home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\"></span>\n        <span>tidepool</span>\n      </a>\n      <span>\u00a9 2024 Tidepool. Make work feel a little more human.</span>\n      <nav class=\"footer-links\" aria-label=\"Footer navigation\">\n        <a href=\"#about\">About</a>\n        <a href=\"mailto:hello@tidepool.team\">Contact</a>\n        <a href=\"#get-started\">Privacy</a>\n      </nav>\n    </footer>\n  </div>\n</body>\n</html>\n"}