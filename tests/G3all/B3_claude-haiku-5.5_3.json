{"brief": "B3", "model": "anthropic/claude-haiku-5.5", "i": 3, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Strata: The open-source database for data engineers</title>\n<meta name=\"description\" content=\"Strata is an open-source, columnar database built for data engineers. Native Parquet and Iceberg, streaming ingest, branchable tables, and built-in data quality checks.\">\n<style>\n  :root {\n    --bg: #0b0d12;\n    --bg-elev: #12151d;\n    --bg-card: #161a24;\n    --border: #232938;\n    --border-strong: #2f3649;\n    --text: #e6e9f2;\n    --text-dim: #9aa3b8;\n    --text-faint: #6b7389;\n    --accent: #5eead4;\n    --accent-2: #818cf8;\n    --accent-3: #f472b6;\n    --accent-grad: linear-gradient(135deg, #5eead4 0%, #818cf8 60%, #f472b6 100%);\n    --radius: 14px;\n    --radius-sm: 8px;\n    --max: 1180px;\n    --mono: ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace;\n    --sans: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n  }\n\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n\n  html { scroll-behavior: smooth; }\n\n  body {\n    background: var(--bg);\n    color: var(--text);\n    font-family: var(--sans);\n    line-height: 1.6;\n    -webkit-font-smoothing: antialiased;\n    overflow-x: hidden;\n  }\n\n  a { color: inherit; text-decoration: none; }\n\n  .container {\n    width: min(100% - 48px, var(--max));\n    margin-inline: auto;\n  }\n\n  /* ---------- Background glow ---------- */\n  .glow {\n    position: absolute;\n    inset: 0 0 auto 0;\n    height: 900px;\n    background:\n      radial-gradient(900px 500px at 15% -10%, rgba(94,234,212,0.13), transparent 60%),\n      radial-gradient(800px 500px at 85% 0%, rgba(129,140,248,0.14), transparent 60%);\n    pointer-events: none;\n    z-index: 0;\n  }\n\n  .section { position: relative; z-index: 1; padding: 104px 0; }\n\n  .eyebrow {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    font-family: var(--mono);\n    font-size: 12px;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    color: var(--accent);\n    margin-bottom: 16px;\n  }\n\n  .section-title {\n    font-size: clamp(30px, 4vw, 44px);\n    line-height: 1.15;\n    letter-spacing: -0.02em;\n    font-weight: 700;\n    max-width: 680px;\n  }\n\n  .section-sub {\n    margin-top: 16px;\n    color: var(--text-dim);\n    font-size: 18px;\n    max-width: 620px;\n  }\n\n  .grad-text {\n    background: var(--accent-grad);\n    -webkit-background-clip: text;\n    background-clip: text;\n    color: transparent;\n  }\n\n  /* ---------- Buttons ---------- */\n  .btn {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    padding: 12px 20px;\n    border-radius: 10px;\n    font-weight: 600;\n    font-size: 15px;\n    border: 1px solid transparent;\n    cursor: pointer;\n    transition: transform .15s ease, background .15s ease, border-color .15s ease, box-shadow .15s ease;\n    white-space: nowrap;\n  }\n  .btn:hover { transform: translateY(-1px); }\n\n  .btn-primary {\n    background: var(--text);\n    color: #0b0d12;\n  }\n  .btn-primary:hover { box-shadow: 0 8px 30px rgba(94,234,212,0.25); }\n\n  .btn-ghost {\n    background: rgba(255,255,255,0.03);\n    border-color: var(--border-strong);\n    color: var(--text);\n  }\n  .btn-ghost:hover { background: rgba(255,255,255,0.07); }\n\n  .btn svg { width: 16px; height: 16px; }\n\n  /* ---------- Nav ---------- */\n  header.nav {\n    position: sticky;\n    top: 0;\n    z-index: 50;\n    backdrop-filter: saturate(160%) blur(12px);\n    -webkit-backdrop-filter: saturate(160%) blur(12px);\n    background: rgba(11,13,18,0.7);\n    border-bottom: 1px solid var(--border);\n  }\n\n  .nav-inner {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    height: 68px;\n  }\n\n  .logo {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    font-weight: 700;\n    font-size: 18px;\n    letter-spacing: -0.01em;\n  }\n\n  .logo-mark { width: 26px; height: 26px; }\n\n  .nav-links {\n    display: flex;\n    align-items: center;\n    gap: 28px;\n    list-style: none;\n    font-size: 14px;\n    color: var(--text-dim);\n  }\n  .nav-links a:hover { color: var(--text); }\n\n  .nav-cta { display: flex; gap: 10px; align-items: center; }\n\n  .badge-version {\n    font-family: var(--mono);\n    font-size: 12px;\n    padding: 4px 8px;\n    border-radius: 6px;\n    border: 1px solid var(--border-strong);\n    color: var(--text-dim);\n  }\n\n  /* ---------- Hero ---------- */\n  .hero { padding: 96px 0 72px; position: relative; z-index: 1; }\n\n  .hero-grid {\n    display: grid;\n    grid-template-columns: 1.05fr 1fr;\n    gap: 64px;\n    align-items: center;\n  }\n\n  .announce {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    padding: 6px 12px 6px 6px;\n    border-radius: 999px;\n    background: var(--bg-card);\n    border: 1px solid var(--border-strong);\n    font-size: 13px;\n    color: var(--text-dim);\n    margin-bottom: 28px;\n  }\n  .announce .pill {\n    background: var(--accent);\n    color: #04201c;\n    font-weight: 700;\n    font-size: 11px;\n    padding: 3px 8px;\n    border-radius: 999px;\n    letter-spacing: 0.02em;\n  }\n\n  h1.hero-title {\n    font-size: clamp(42px, 6vw, 72px);\n    line-height: 1.02;\n    letter-spacing: -0.035em;\n    font-weight: 800;\n  }\n\n  .hero-lede {\n    margin-top: 24px;\n    font-size: 19px;\n    color: var(--text-dim);\n    max-width: 560px;\n  }\n\n  .hero-actions {\n    display: flex;\n    gap: 12px;\n    flex-wrap: wrap;\n    margin-top: 36px;\n  }\n\n  .install {\n    margin-top: 40px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n    max-width: 520px;\n    padding: 12px 12px 12px 18px;\n    background: var(--bg-elev);\n    border: 1px solid var(--border-strong);\n    border-radius: var(--radius-sm);\n    font-family: var(--mono);\n    font-size: 14px;\n  }\n  .install code { color: var(--text); overflow-x: auto; white-space: nowrap; }\n  .install .prompt { color: var(--accent); margin-right: 8px; user-select: none; }\n\n  .copy-btn {\n    flex-shrink: 0;\n    font-family: var(--sans);\n    font-size: 13px;\n    font-weight: 600;\n    color: var(--text-dim);\n    background: var(--bg-card);\n    border: 1px solid var(--border-strong);\n    border-radius: 6px;\n    padding: 6px 12px;\n    cursor: pointer;\n    transition: color .15s, border-color .15s;\n  }\n  .copy-btn:hover { color: var(--text); border-color: var(--accent); }\n  .copy-btn.copied { color: var(--accent); border-color: var(--accent); }\n\n  .hero-meta {\n    margin-top: 28px;\n    display: flex;\n    gap: 22px;\n    flex-wrap: wrap;\n    color: var(--text-faint);\n    font-size: 13px;\n    font-family: var(--mono);\n  }\n  .hero-meta span { display: inline-flex; align-items: center; gap: 6px; }\n  .dot { width: 7px; height: 7px; border-radius: 50%; background: #34d399; box-shadow: 0 0 10px #34d399; }\n\n  /* ---------- Code window ---------- */\n  .window {\n    background: var(--bg-elev);\n    border: 1px solid var(--border-strong);\n    border-radius: 16px;\n    overflow: hidden;\n    box-shadow: 0 30px 80px -20px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.02) inset;\n  }\n\n  .window-bar {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: 0 14px;\n    height: 46px;\n    background: #0e1119;\n    border-bottom: 1px solid var(--border);\n  }\n\n  .traffic { display: flex; gap: 7px; }\n  .traffic i { width: 11px; height: 11px; border-radius: 50%; background: #2a3040; display: block; }\n  .traffic i:nth-child(1) { background: #ff5f57; }\n  .traffic i:nth-child(2) { background: #febc2e; }\n  .traffic i:nth-child(3) { background: #28c840; }\n\n  .tabs { display: flex; gap: 4px; }\n  .tab {\n    font-family: var(--mono);\n    font-size: 12px;\n    color: var(--text-faint);\n    background: none;\n    border: 0;\n    padding: 6px 10px;\n    border-radius: 6px;\n    cursor: pointer;\n  }\n  .tab:hover { color: var(--text-dim); }\n  .tab[aria-selected=\"true\"] { color: var(--text); background: var(--bg-card); }\n\n  .code-panel { display: none; padding: 22px 24px; font-family: var(--mono); font-size: 13.5px; line-height: 1.75; overflow-x: auto; }\n  .code-panel.active { display: block; }\n\n  .tk-k { color: #c084fc; }\n  .tk-f { color: #60a5fa; }\n  .tk-s { color: #86efac; }\n  .tk-n { color: #fbbf24; }\n  .tk-c { color: #5b6378; font-style: italic; }\n  .tk-p { color: var(--text-dim); }\n  .tk-t { color: #5eead4; }\n\n  .window-footer {\n    display: flex;\n    justify-content: space-between;\n    padding: 10px 16px;\n    border-top: 1px solid var(--border);\n    font-family: var(--mono);\n    font-size: 12px;\n    color: var(--text-faint);\n    background: #0e1119;\n  }\n  .result-ok { color: #34d399; }\n\n  /* ---------- Logos / stats strip ---------- */\n  .stats {\n    border-top: 1px solid var(--border);\n    border-bottom: 1px solid var(--border);\n    background: rgba(18,21,29,0.5);\n    position: relative;\n    z-index: 1;\n  }\n  .stats-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n  }\n  .stat {\n    padding: 34px 24px;\n    border-right: 1px solid var(--border);\n  }\n  .stat:last-child { border-right: 0; }\n  .stat-value {\n    font-size: 34px;\n    font-weight: 800;\n    letter-spacing: -0.02em;\n  }\n  .stat-label { color: var(--text-dim); font-size: 14px; margin-top: 4px; }\n\n  /* ---------- Features ---------- */\n  .features-head { display: flex; flex-direction: column; align-items: flex-start; margin-bottom: 56px; }\n\n  .features-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 16px;\n  }\n\n  .feature {\n    background: var(--bg-card);\n    border: 1px solid var(--border);\n    border-radius: var(--radius);\n    padding: 28px;\n    transition: border-color .2s, transform .2s;\n    position: relative;\n    overflow: hidden;\n  }\n  .feature::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background: radial-gradient(400px 200px at var(--mx, 50%) -20%, rgba(94,234,212,0.08), transparent 70%);\n    opacity: 0;\n    transition: opacity .3s;\n  }\n  .feature:hover { border-color: var(--border-strong); transform: translateY(-2px); }\n  .feature:hover::before { opacity: 1; }\n\n  .feature-icon {\n    width: 44px;\n    height: 44px;\n    border-radius: 10px;\n    display: grid;\n    place-items: center;\n    background: rgba(94,234,212,0.08);\n    border: 1px solid rgba(94,234,212,0.2);\n    margin-bottom: 20px;\n  }\n  .feature-icon svg { width: 22px; height: 22px; stroke: var(--accent); fill: none; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }\n\n  .feature:nth-child(2) .feature-icon { background: rgba(129,140,248,0.08); border-color: rgba(129,140,248,0.25); }\n  .feature:nth-child(2) .feature-icon svg { stroke: var(--accent-2); }\n  .feature:nth-child(3) .feature-icon { background: rgba(244,114,182,0.08); border-color: rgba(244,114,182,0.25); }\n  .feature:nth-child(3) .feature-icon svg { stroke: var(--accent-3); }\n  .feature:nth-child(4) .feature-icon { background: rgba(251,191,36,0.08); border-color: rgba(251,191,36,0.25); }\n  .feature:nth-child(4) .feature-icon svg { stroke: #fbbf24; }\n  .feature:nth-child(5) .feature-icon { background: rgba(52,211,153,0.08); border-color: rgba(52,211,153,0.25); }\n  .feature:nth-child(5) .feature-icon svg { stroke: #34d399; }\n  .feature:nth-child(6) .feature-icon { background: rgba(96,165,250,0.08); border-color: rgba(96,165,250,0.25); }\n  .feature:nth-child(6) .feature-icon svg { stroke: #60a5fa; }\n\n  .feature h3 { font-size: 18px; font-weight: 650; letter-spacing: -0.01em; margin-bottom: 8px; }\n  .feature p { color: var(--text-dim); font-size: 15px; }\n\n  .feature code {\n    font-family: var(--mono);\n    font-size: 12.5px;\n    color: var(--text);\n    background: rgba(255,255,255,0.05);\n    padding: 2px 6px;\n    border-radius: 4px;\n  }\n\n  /* ---------- Architecture ---------- */\n  .arch {\n    background: var(--bg-elev);\n    border-block: 1px solid var(--border);\n  }\n\n  .arch-grid {\n    display: grid;\n    grid-template-columns: 1fr 1.2fr;\n    gap: 64px;\n    align-items: center;\n  }\n\n  .checklist { list-style: none; margin-top: 32px; display: grid; gap: 18px; }\n  .checklist li { display: flex; gap: 14px; }\n  .checklist .tick {\n    flex-shrink: 0;\n    width: 22px; height: 22px;\n    border-radius: 6px;\n    background: rgba(94,234,212,0.12);\n    color: var(--accent);\n    display: grid; place-items: center;\n    font-size: 13px; font-weight: 700;\n    margin-top: 2px;\n  }\n  .checklist strong { display: block; font-weight: 600; margin-bottom: 2px; }\n  .checklist span { color: var(--text-dim); font-size: 15px; }\n\n  .diagram {\n    background: var(--bg-card);\n    border: 1px solid var(--border-strong);\n    border-radius: 16px;\n    padding: 28px;\n  }\n  .diagram svg { width: 100%; height: auto; display: block; }\n\n  /* ---------- Benchmarks ---------- */\n  .bench-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 16px;\n    margin-top: 56px;\n  }\n  .bench-card {\n    background: var(--bg-card);\n    border: 1px solid var(--border);\n    border-radius: var(--radius);\n    padding: 28px;\n  }\n  .bench-card h3 { font-size: 16px; font-weight: 650; }\n  .bench-card .note { color: var(--text-faint); font-size: 13px; font-family: var(--mono); margin-top: 4px; }\n\n  .bar-row { margin-top: 20px; }\n  .bar-meta { display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 8px; color: var(--text-dim); }\n  .bar-meta b { color: var(--text); font-family: var(--mono); font-weight: 600; }\n  .bar-track { height: 10px; border-radius: 999px; background: rgba(255,255,255,0.05); overflow: hidden; }\n  .bar-fill {\n    height: 100%;\n    border-radius: 999px;\n    width: 0;\n    background: var(--accent-grad);\n    transition: width 1.2s cubic-bezier(.2,.8,.2,1);\n  }\n  .bar-fill.muted { background: #343b4f; }\n  .bench-card.in-view .bar-fill { width: var(--w); }\n\n  /* ---------- Quickstart ---------- */\n  .steps {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 16px;\n    margin-top: 56px;\n  }\n  .step {\n    position: relative;\n    background: var(--bg-card);\n    border: 1px solid var(--border);\n    border-radius: var(--radius);\n    padding: 28px;\n  }\n  .step-num {\n    font-family: var(--mono);\n    font-size: 13px;\n    color: var(--accent-2);\n    margin-bottom: 18px;\n    display: block;\n  }\n  .step h3 { font-size: 18px; font-weight: 650; margin-bottom: 8px; }\n  .step p { color: var(--text-dim); font-size: 15px; margin-bottom: 16px; }\n  .step pre {\n    font-family: var(--mono);\n    font-size: 13px;\n    background: #0e1119;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-sm);\n    padding: 12px 14px;\n    overflow-x: auto;\n    color: var(--text);\n  }\n  .step pre .p { color: var(--accent); user-select: none; }\n\n  /* ---------- Community / OSS ---------- */\n  .oss-card {\n    margin-top: 56px;\n    display: grid;\n    grid-template-columns: 1.3fr 1fr;\n    gap: 0;\n    border-radius: 20px;\n    border: 1px solid var(--border-strong);\n    overflow: hidden;\n    background:\n      linear-gradient(var(--bg-card), var(--bg-card)) padding-box,\n      var(--accent-grad) border-box;\n    border: 1px solid transparent;\n  }\n  .oss-left { padding: 48px; }\n  .oss-left h3 { font-size: 30px; letter-spacing: -0.02em; line-height: 1.2; font-weight: 750; }\n  .oss-left p { color: var(--text-dim); margin-top: 14px; max-width: 480px; }\n  .oss-actions { display: flex; gap: 12px; margin-top: 28px; flex-wrap: wrap; }\n\n  .oss-right {\n    padding: 48px;\n    border-left: 1px solid var(--border);\n    display: grid;\n    gap: 22px;\n    align-content: center;\n  }\n  .oss-row { display: flex; justify-content: space-between; align-items: center; gap: 16px; }\n  .oss-row .k { color: var(--text-dim); font-size: 14px; }\n  .oss-row .v { font-family: var(--mono); font-weight: 600; font-size: 15px; }\n\n  /* ---------- Final CTA ---------- */\n  .cta {\n    text-align: center;\n    padding: 120px 0;\n    position: relative;\n    z-index: 1;\n  }\n  .cta h2 { font-size: clamp(36px, 5vw, 56px); letter-spacing: -0.03em; line-height: 1.08; font-weight: 800; }\n  .cta p { color: var(--text-dim); margin: 18px auto 36px; max-width: 520px; font-size: 18px; }\n  .cta .hero-actions { justify-content: center; }\n\n  /* ---------- Footer ---------- */\n  footer {\n    border-top: 1px solid var(--border);\n    padding: 56px 0 40px;\n    position: relative;\n    z-index: 1;\n    color: var(--text-dim);\n    font-size: 14px;\n  }\n  .foot-grid {\n    display: grid;\n    grid-template-columns: 2fr repeat(3, 1fr);\n    gap: 40px;\n  }\n  .foot-grid p { margin-top: 14px; max-width: 280px; color: var(--text-faint); }\n  .foot-grid h4 { color: var(--text); font-size: 14px; font-weight: 600; margin-bottom: 14px; }\n  .foot-grid ul { list-style: none; display: grid; gap: 10px; }\n  .foot-grid a:hover { color: var(--text); }\n  .foot-bottom {\n    margin-top: 48px;\n    padding-top: 24px;\n    border-top: 1px solid var(--border);\n    display: flex;\n    justify-content: space-between;\n    color: var(--text-faint);\n    font-size: 13px;\n    font-family: var(--mono);\n    flex-wrap: wrap;\n    gap: 12px;\n  }\n\n  /* ---------- Responsive ---------- */\n  @media (max-width: 1024px) {\n    .hero-grid, .arch-grid, .oss-card { grid-template-columns: 1fr; }\n    .features-grid { grid-template-columns: repeat(2, 1fr); }\n    .steps { grid-template-columns: 1fr; }\n    .oss-right { border-left: 0; border-top: 1px solid var(--border); }\n    .stats-grid { grid-template-columns: repeat(2, 1fr); }\n    .stat:nth-child(2) { border-right: 0; }\n    .stat:nth-child(-n+2) { border-bottom: 1px solid var(--border); }\n  }\n\n  @media (max-width: 760px) {\n    .nav-links { display: none; }\n    .section { padding: 72px 0; }\n    .hero { padding-top: 56px; }\n    .features-grid, .bench-grid { grid-template-columns: 1fr; }\n    .foot-grid { grid-template-columns: 1fr 1fr; }\n    .oss-left, .oss-right { padding: 32px; }\n    .install code { font-size: 12.5px; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    * { transition: none !important; scroll-behavior: auto !important; }\n  }\n</style>\n</head>\n<body>\n\n<div class=\"glow\" aria-hidden=\"true\"></div>\n\n<!-- ============ NAV ============ -->\n<header class=\"nav\">\n  <div class=\"container nav-inner\">\n    <a href=\"#\" class=\"logo\" aria-label=\"Strata home\">\n      <svg class=\"logo-mark\" viewBox=\"0 0 32 32\" aria-hidden=\"true\">\n        <defs>\n          <linearGradient id=\"lg\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n            <stop offset=\"0\" stop-color=\"#5eead4\"/>\n            <stop offset=\"0.6\" stop-color=\"#818cf8\"/>\n            <stop offset=\"1\" stop-color=\"#f472b6\"/>\n          </linearGradient>\n        </defs>\n        <rect x=\"2\" y=\"4\" width=\"28\" height=\"6\" rx=\"3\" fill=\"url(#lg)\"/>\n        <rect x=\"2\" y=\"13\" width=\"28\" height=\"6\" rx=\"3\" fill=\"url(#lg)\" opacity=\"0.75\"/>\n        <rect x=\"2\" y=\"22\" width=\"28\" height=\"6\" rx=\"3\" fill=\"url(#lg)\" opacity=\"0.5\"/>\n      </svg>\n      Strata\n    </a>\n\n    <ul class=\"nav-links\">\n      <li><a href=\"#features\">Features</a></li>\n      <li><a href=\"#architecture\">Architecture</a></li>\n      <li><a href=\"#benchmarks\">Benchmarks</a></li>\n      <li><a href=\"#quickstart\">Quickstart</a></li>\n      <li><a href=\"#\">Docs</a></li>\n    </ul>\n\n    <div class=\"nav-cta\">\n      <span class=\"badge-version\">v2.4</span>\n      <a href=\"#\" class=\"btn btn-ghost\" style=\"padding:8px 14px;font-size:14px;\">\n        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.27 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z\"/></svg>\n        GitHub\n      </a>\n      <a href=\"#quickstart\" class=\"btn btn-primary\" style=\"padding:8px 14px;font-size:14px;\">Get started</a>\n    </div>\n  </div>\n</header>\n\n<main>\n\n<!-- ============ HERO ============ -->\n<section class=\"hero\">\n  <div class=\"container hero-grid\">\n    <div>\n      <div class=\"announce\">\n        <span class=\"pill\">NEW</span>\n        Streaming CDC ingest is now generally available\n      </div>\n\n      <h1 class=\"hero-title\">\n        The database that<br>\n        <span class=\"grad-text\">speaks pipeline.</span>\n      </h1>\n\n      <p class=\"hero-lede\">\n        Strata is an open-source, columnar database built for data engineers. Query Parquet and Iceberg in place, branch your tables like code, and enforce data contracts before bad rows ever land.\n      </p>\n\n      <div class=\"hero-actions\">\n        <a href=\"#quickstart\" class=\"btn btn-primary\">\n          Get started free\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n        </a>\n        <a href=\"#\" class=\"btn btn-ghost\">Read the docs</a>\n      </div>\n\n      <div class=\"install\">\n        <code><span class=\"prompt\">$</span>curl -fsSL https://strata.dev/install | sh</code>\n        <button class=\"copy-btn\" data-copy=\"curl -fsSL https://strata.dev/install | sh\">Copy</button>\n      </div>\n\n      <div class=\"hero-meta\">\n        <span><i class=\"dot\"></i> All systems operational</span>\n        <span>Apache-2.0</span>\n        <span>Linux \u00b7 macOS \u00b7 Windows (WSL)</span>\n      </div>\n    </div>\n\n    <!-- Code window -->\n    <div class=\"window\" role=\"region\" aria-label=\"Code example\">\n      <div class=\"window-bar\">\n        <div class=\"traffic\"><i></i><i></i><i></i></div>\n        <div class=\"tabs\" role=\"tablist\">\n          <button class=\"tab\" role=\"tab\" aria-selected=\"true\" data-tab=\"sql\">query.sql</button>\n          <button class=\"tab\" role=\"tab\" aria-selected=\"false\" data-tab=\"py\">pipeline.py</button>\n          <button class=\"tab\" role=\"tab\" aria-selected=\"false\" data-tab=\"cli\">cli</button>\n        </div>\n      </div>\n\n      <div class=\"code-panel active\" id=\"panel-sql\" role=\"tabpanel\">\n<span class=\"tk-c\">-- Read raw events straight from S3 as Parquet, no load step</span>\n<span class=\"tk-k\">CREATE TABLE</span> <span class=\"tk-t\">events_clean</span> <span class=\"tk-k\">AS</span>\n<span class=\"tk-k\">SELECT</span>\n    user_id,\n    <span class=\"tk-f\">date_trunc</span>(<span class=\"tk-s\">'hour'</span>, ts) <span class=\"tk-k\">AS</span> hour,\n    <span class=\"tk-f\">count</span>(*)              <span class=\"tk-k\">AS</span> events,\n    <span class=\"tk-f\">approx_distinct</span>(session_id) <span class=\"tk-k\">AS</span> sessions\n<span class=\"tk-k\">FROM</span> <span class=\"tk-f\">read_parquet</span>(<span class=\"tk-s\">'s3://lake/raw/events/**/*.parquet'</span>)\n<span class=\"tk-k\">WHERE</span> ts <span class=\"tk-k\">&gt;=</span> <span class=\"tk-n\">now()</span> - <span class=\"tk-n\">INTERVAL 7 DAYS</span>\n<span class=\"tk-k\">GROUP BY</span> <span class=\"tk-n\">1, 2</span>\n<span class=\"tk-k\">CONTRACT</span> <span class=\"tk-s\">'events.v3'</span>;  <span class=\"tk-c\">-- fails the write if the schema drifts</span>\n      </div>\n\n      <div class=\"code-panel\" id=\"panel-py\" role=\"tabpanel\">\n<span class=\"tk-k\">import</span> strata\n\ndb = strata.connect(<span class=\"tk-s\">\"s3://lake/warehouse\"</span>)\n\n<span class=\"tk-c\"># Branch the table, like a git feature branch</span>\nbranch = db.branch(<span class=\"tk-s\">\"events\"</span>, name=<span class=\"tk-s\">\"backfill-may\"</span>)\n\n<span class=\"tk-k\">with</span> branch.transaction() <span class=\"tk-k\">as</span> tx:\n    tx.ingest(<span class=\"tk-s\">\"kafka://orders.cdc\"</span>, mode=<span class=\"tk-s\">\"upsert\"</span>, key=[<span class=\"tk-s\">\"order_id\"</span>])\n    tx.expect(<span class=\"tk-s\">\"amount\"</span>, <span class=\"tk-s\">\"> 0\"</span>, on_fail=<span class=\"tk-s\">\"quarantine\"</span>)\n\n<span class=\"tk-c\"># Merge only when checks pass</span>\nbranch.merge(into=<span class=\"tk-s\">\"main\"</span>)\n      </div>\n\n      <div class=\"code-panel\" id=\"panel-cli\" role=\"tabpanel\">\n<span class=\"tk-p\">$</span> strata init ./analytics\n<span class=\"tk-p\">$</span> strata run models/ --target prod\n<span class=\"tk-p\">$</span> strata branch create fix-dedupe\n<span class=\"tk-p\">$</span> strata test --contracts\n<span class=\"tk-p\">$</span> strata merge fix-dedupe --into main\n      </div>\n\n      <div class=\"window-footer\">\n        <span>Query finished in <span class=\"result-ok\">0.42s</span></span>\n        <span>scanned 2.1 GB \u00b7 18 files</span>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ STATS ============ -->\n<section class=\"stats\" aria-label=\"Project statistics\">\n  <div class=\"container stats-grid\">\n    <div class=\"stat\">\n      <div class=\"stat-value grad-text\">38k+</div>\n      <div class=\"stat-label\">GitHub stars</div>\n    </div>\n    <div class=\"stat\">\n      <div class=\"stat-value\">1,200+</div>\n      <div class=\"stat-label\">Production deployments</div>\n    </div>\n    <div class=\"stat\">\n      <div class=\"stat-value\">340</div>\n      <div class=\"stat-label\">Contributors worldwide</div>\n    </div>\n    <div class=\"stat\">\n      <div class=\"stat-value\">14 PB</div>\n      <div class=\"stat-label\">Queried every day</div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ FEATURES ============ -->\n<section class=\"section\" id=\"features\">\n  <div class=\"container\">\n    <div class=\"features-head\">\n      <span class=\"eyebrow\">// Features</span>\n      <h2 class=\"section-title\">Everything a pipeline needs.<br>Nothing it doesn't.</h2>\n      <p class=\"section-sub\">Strata replaces the stack of loaders, orchestrators glue, and validators you maintain today with one engine that understands tables, not just queries.</p>\n    </div>\n\n    <div class=\"features-grid\">\n      <article class=\"feature\">\n        <div class=\"feature-icon\">\n          <svg viewBox=\"0 0 24 24\"><ellipse cx=\"12\" cy=\"5\" rx=\"8\" ry=\"3\"/><path d=\"M4 5v6c0 1.66 3.58 3 8 3s8-1.34 8-3V5\"/><path d=\"M4 11v6c0 1.66 3.58 3 8 3s8-1.34 8-3v-6\"/></svg>\n        </div>\n        <h3>Query data where it lives</h3>\n        <p>Read Parquet, Iceberg, Delta, and CSV on S3, GCS, or local disk. Zero-copy scans with predicate and projection pushdown.</p>\n      </article>\n\n      <article class=\"feature\">\n        <div class=\"feature-icon\">\n          <svg viewBox=\"0 0 24 24\"><circle cx=\"6\" cy=\"6\" r=\"2.5\"/><circle cx=\"6\" cy=\"18\" r=\"2.5\"/><circle cx=\"18\" cy=\"12\" r=\"2.5\"/><path d=\"M6 8.5v7M8.5 6h4a3 3 0 0 1 3 3v1\"/></svg>\n        </div>\n        <h3>Git-style table branches</h3>\n        <p>Branch, experiment, and merge tables atomically. Time travel to any commit, and roll back a bad backfill in one command.</p>\n      </article>\n\n      <article class=\"feature\">\n        <div class=\"feature-icon\">\n          <svg viewBox=\"0 0 24 24\"><path d=\"M3 12h4l3-8 4 16 3-8h4\"/></svg>\n        </div>\n        <h3>Streaming and CDC ingest</h3>\n        <p>Consume Kafka, Debezium, and Kinesis directly. Exactly-once upserts with late-arriving data handled by watermarks.</p>\n      </article>\n\n      <article class=\"feature\">\n        <div class=\"feature-icon\">\n          <svg viewBox=\"0 0 24 24\"><path d=\"M12 3l8 4v5c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V7l8-4z\"/><path d=\"M9 12l2 2 4-4\"/></svg>\n        </div>\n        <h3>Data contracts, enforced</h3>\n        <p>Declare schemas, freshness SLAs, and row-level expectations in SQL. Bad batches get quarantined, not silently merged.</p>\n      </article>\n\n      <article class=\"feature\">\n        <div class=\"feature-icon\">\n          <svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M3 9h18M9 9v11\"/></svg>\n        </div>\n        <h3>Vectorized columnar engine</h3>\n        <p>SIMD-optimized execution in Rust with late materialization. Joins and window functions run on billions of rows on one node.</p>\n      </article>\n\n      <article class=\"feature\">\n        <div class=\"feature-icon\">\n          <svg viewBox=\"0 0 24 24\"><path d=\"M16 18l6-6-6-6M8 6l-6 6 6 6\"/></svg>\n        </div>\n        <h3>dbt and Python native</h3>\n        <p>Drop-in dbt adapter, a Python client with Arrow and Polars output, and a stable SQL dialect that ports from Postgres and Spark.</p>\n      </article>\n    </div>\n  </div>\n</section>\n\n<!-- ============ ARCHITECTURE ============ -->\n<section class=\"section arch\" id=\"architecture\">\n  <div class=\"container arch-grid\">\n    <div>\n      <span class=\"eyebrow\">// Architecture</span>\n      <h2 class=\"section-title\">One engine.<br>Your storage. Your rules.</h2>\n      <p class=\"section-sub\">Strata stores data in open formats on infrastructure you already own. Compute scales independently, and nothing is locked behind a proprietary file format.</p>\n\n      <ul class=\"checklist\">\n        <li>\n          <span class=\"tick\">\u2713</span>\n          <div>\n            <strong>Open formats end to end</strong>\n            <span>Tables are Iceberg underneath. Any engine can read them tomorrow.</span>\n          </div>\n        </li>\n        <li>\n          <span class=\"tick\">\u2713</span>\n          <div>\n            <strong>Separate compute from storage</strong>\n            <span>Run a laptop, a single VM, or a fleet of workers against the same catalog.</span>\n          </div>\n        </li>\n        <li>\n          <span class=\"tick\">\u2713</span>\n          <div>\n            <strong>Self-host or use managed cloud</strong>\n            <span>Same binary, same APIs. Migrate between them with a single command.</span>\n          </div>\n        </li>\n      </ul>\n    </div>\n\n    <div class=\"diagram\" aria-label=\"Architecture diagram\">\n      <svg viewBox=\"0 0 560 420\" role=\"img\" aria-describedby=\"arch-desc\">\n        <title>Strata architecture</title>\n        <desc id=\"arch-desc\">Sources such as Kafka, Postgres and APIs flow into the Strata engine, which writes to object storage and serves SQL, Python and dbt clients.</desc>\n        <defs>\n          <linearGradient id=\"gA\" x1=\"0\" x2=\"1\">\n            <stop offset=\"0\" stop-color=\"#5eead4\" stop-opacity=\"0.9\"/>\n            <stop offset=\"1\" stop-color=\"#818cf8\" stop-opacity=\"0.9\"/>\n          </linearGradient>\n          <marker id=\"arr\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto\">\n            <path d=\"M0 0 L10 5 L0 10 z\" fill=\"#6b7389\"/>\n          </marker>\n        </defs>\n\n        <!-- Sources -->\n        <g font-family=\"ui-monospace, Menlo, monospace\" font-size=\"12\">\n          <rect x=\"20\" y=\"30\" width=\"130\" height=\"50\" rx=\"10\" fill=\"#1d2230\" stroke=\"#2f3649\"/>\n          <text x=\"85\" y=\"60\" text-anchor=\"middle\" fill=\"#e6e9f2\">Kafka / CDC</text>\n          <rect x=\"20\" y=\"105\" width=\"130\" height=\"50\" rx=\"10\" fill=\"#1d2230\" stroke=\"#2f3649\"/>\n          <text x=\"85\" y=\"135\" text-anchor=\"middle\" fill=\"#e6e9f2\">Postgres</text>\n          <rect x=\"20\" y=\"180\" width=\"130\" height=\"50\" rx=\"10\" fill=\"#1d2230\" stroke=\"#2f3649\"/>\n          <text x=\"85\" y=\"210\" text-anchor=\"middle\" fill=\"#e6e9f2\">REST / APIs</text>\n          <rect x=\"20\" y=\"255\" width=\"130\" height=\"50\" rx=\"10\" fill=\"#1d2230\" stroke=\"#2f3649\"/>\n          <text x=\"85\" y=\"285\" text-anchor=\"middle\" fill=\"#e6e9f2\">Files / SaaS</text>\n        </g>\n\n        <!-- Engine -->\n        <rect x=\"210\" y=\"90\" width=\"150\" height=\"200\" rx=\"16\" fill=\"rgba(94,234,212,0.06)\" stroke=\"url(#gA)\" stroke-width=\"1.5\"/>\n        <text x=\"285\" y=\"124\" text-anchor=\"middle\" font-family=\"ui-sans-serif, system-ui\" font-size=\"16\" font-weight=\"700\" fill=\"#e6e9f2\">Strata</text>\n        <text x=\"285\" y=\"142\" text-anchor=\"middle\" font-family=\"ui-monospace, Menlo, monospace\" font-size=\"11\" fill=\"#9aa3b8\">engine</text>\n        <g font-family=\"ui-monospace, Menlo, monospace\" font-size=\"11\" fill=\"#9aa3b8\" text-anchor=\"middle\">\n          <text x=\"285\" y=\"182\">planner</text>\n          <text x=\"285\" y=\"210\">contracts</text>\n          <text x=\"285\" y=\"238\">branches</text>\n          <text x=\"285\" y=\"266\">vector exec</text>\n        </g>\n\n        <!-- Storage -->\n        <rect x=\"410\" y=\"60\" width=\"130\" height=\"90\" rx=\"12\" fill=\"#1d2230\" stroke=\"#2f3649\"/>\n        <text x=\"475\" y=\"98\" text-anchor=\"middle\" font-family=\"ui-monospace, Menlo, monospace\" font-size=\"12\" fill=\"#e6e9f2\">Object storage</text>\n        <text x=\"475\" y=\"120\" text-anchor=\"middle\" font-family=\"ui-monospace, Menlo, monospace\" font-size=\"11\" fill=\"#6b7389\">S3 \u00b7 GCS \u00b7 ABFS</text>\n\n        <rect x=\"410\" y=\"230\" width=\"130\" height=\"70\" rx=\"12\" fill=\"#1d2230\" stroke=\"#2f3649\"/>\n        <text x=\"475\" y=\"262\" text-anchor=\"middle\" font-family=\"ui-monospace, Menlo, monospace\" font-size=\"12\" fill=\"#e6e9f2\">Iceberg catalog</text>\n        <text x=\"475\" y=\"282\" text-anchor=\"middle\" font-family=\"ui-monospace, Menlo, monospace\" font-size=\"11\" fill=\"#6b7389\">open format</text>\n\n        <!-- Arrows in -->\n        <g stroke=\"#6b7389\" stroke-width=\"1.5\" fill=\"none\" marker-end=\"url(#arr)\">\n          <path d=\"M152 55 C 180 55, 180 120, 210 130\"/>\n          <path d=\"M152 130 L 210 150\"/>\n          <path d=\"M152 205 L 210 200\"/>\n          <path d=\"M152 280 C 180 280, 180 250, 210 245\"/>\n        </g>\n        <!-- Arrows out -->\n        <g stroke=\"#6b7389\" stroke-width=\"1.5\" fill=\"none\" marker-end=\"url(#arr)\">\n          <path d=\"M362 150 L 408 110\"/>\n          <path d=\"M362 230 L 408 260\"/>\n        </g>\n\n        <!-- Clients -->\n        <g font-family=\"ui-monospace, Menlo, monospace\" font-size=\"12\">\n          <rect x=\"200\" y=\"350\" width=\"170\" height=\"40\" rx=\"10\" fill=\"#1d2230\" stroke=\"#2f3649\"/>\n          <text x=\"285\" y=\"375\" text-anchor=\"middle\" fill=\"#e6e9f2\">SQL \u00b7 Python \u00b7 dbt</text>\n        </g>\n        <line x1=\"285\" y1=\"290\" x2=\"285\" y2=\"348\" stroke=\"#6b7389\" stroke-width=\"1.5\" marker-end=\"url(#arr)\"/>\n      </svg>\n    </div>\n  </div>\n</section>\n\n<!-- ============ BENCHMARKS ============ -->\n<section class=\"section\" id=\"benchmarks\">\n  <div class=\"container\">\n    <span class=\"eyebrow\">// Benchmarks</span>\n    <h2 class=\"section-title\">Fast where it matters.<br>Reproducible by design.</h2>\n    <p class=\"section-sub\">TPC-H SF100 on a single c6i.8xlarge. Full scripts, raw results, and methodology live in the repo.</p>\n\n    <div class=\"bench-grid\">\n      <div class=\"bench-card\" data-bench>\n        <h3>TPC-H query runtime</h3>\n        <div class=\"note\">lower is better \u00b7 seconds \u00b7 SF100</div>\n\n        <div class=\"bar-row\">\n          <div class=\"bar-meta\"><span>Strata</span><b>41s</b></div>\n          <div class=\"bar-track\"><div class=\"bar-fill\" style=\"--w:100%\"></div></div>\n        </div>\n        <div class=\"bar-row\">\n          <div class=\"bar-meta\"><span>DuckDB</span><b>58s</b></div>\n          <div class=\"bar-track\"><div class=\"bar-fill muted\" style=\"--w:71%\"></div></div>\n        </div>\n        <div class=\"bar-row\">\n          <div class=\"bar-meta\"><span>Spark (local)</span><b>212s</b></div>\n          <div class=\"bar-track\"><div class=\"bar-fill muted\" style=\"--w:19%\"></div></div>\n        </div>\n        <div class=\"bar-row\">\n          <div class=\"bar-meta\"><span>Postgres 16</span><b>1,140s</b></div>\n          <div class=\"bar-track\"><div class=\"bar-fill muted\" style=\"--w:4%\"></div></div>\n        </div>\n      </div>\n\n      <div class=\"bench-card\" data-bench>\n        <h3>Streaming upsert throughput</h3>\n        <div class=\"note\">higher is better \u00b7 rows/sec \u00b7 8 vCPU</div>\n\n        <div class=\"bar-row\">\n          <div class=\"bar-meta\"><span>Strata</span><b>1.9M</b></div>\n          <div class=\"bar-track\"><div class=\"bar-fill\" style=\"--w:100%\"></div></div>\n        </div>\n        <div class=\"bar-row\">\n          <div class=\"bar-meta\"><span>Flink + Iceberg</span><b>780k</b></div>\n          <div class=\"bar-track\"><div class=\"bar-fill muted\" style=\"--w:41%\"></div></div>\n        </div>\n        <div class=\"bar-row\">\n          <div class=\"bar-meta\"><span>Kafka Connect + Snowflake</span><b>210k</b></div>\n          <div class=\"bar-track\"><div class=\"bar-fill muted\" style=\"--w:11%\"></div></div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ QUICKSTART ============ -->\n<section class=\"section\" id=\"quickstart\" style=\"padding-top:40px;\">\n  <div class=\"container\">\n    <span class=\"eyebrow\">// Quickstart</span>\n    <h2 class=\"section-title\">From zero to a query in under a minute.</h2>\n\n    <div class=\"steps\">\n      <div class=\"step\">\n        <span class=\"step-num\">01 \u2014 INSTALL</span>\n        <h3>Install the binary</h3>\n        <p>A single static binary. No JVM, no Docker required.</p>\n        <pre><span class=\"p\">$</span> curl -fsSL strata.dev/install | sh</pre>\n      </div>\n\n      <div class=\"step\">\n        <span class=\"step-num\">02 \u2014 CONNECT</span>\n        <h3>Point it at your data</h3>\n        <p>Strata discovers schemas from Parquet and Iceberg metadata automatically.</p>\n        <pre><span class=\"p\">$</span> strata attach s3://lake/raw</pre>\n      </div>\n\n      <div class=\"step\">\n        <span class=\"step-num\">03 \u2014 QUERY</span>\n        <h3>Ask your first question</h3>\n        <p>Use the shell, the Python client, or any Postgres-compatible driver.</p>\n        <pre><span class=\"p\">$</span> strata sql \"select count(*) from events\"</pre>\n      </div>\n    </div>\n\n    <div class=\"oss-card\">\n      <div class=\"oss-left\">\n        <span class=\"eyebrow\">// Open source</span>\n        <h3>Built in the open, owned by everyone who uses it.</h3>\n        <p>Strata is licensed under Apache 2.0. No open-core paywalls on core features, no usage telemetry without opt-in, and every design decision is discussed in public RFCs.</p>\n        <div class=\"oss-actions\">\n          <a href=\"#\" class=\"btn btn-primary\">\n            <svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.27 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z\"/></svg>\n            Star on GitHub\n          </a>\n          <a href=\"#\" class=\"btn btn-ghost\">Join Discord</a>\n        </div>\n      </div>\n\n      <div class=\"oss-right\">\n        <div class=\"oss-row\"><span class=\"k\">License</span><span class=\"v\">Apache-2.0</span></div>\n        <div class=\"oss-row\"><span class=\"k\">Latest release</span><span class=\"v\">v2.4.1</span></div>\n        <div class=\"oss-row\"><span class=\"k\">Open issues</span><span class=\"v\">214</span></div>\n        <div class=\"oss-row\"><span class=\"k\">Monthly contributors</span><span class=\"v\">87</span></div>\n        <div class=\"oss-row\"><span class=\"k\">Governance</span><span class=\"v\">Neutral foundation</span></div>\n      </div>\n    </div>\n  </div>\n</section>\n\n</main>\n\n<!-- ============ FINAL CTA ============ -->\n<section class=\"cta\">\n  <div class=\"container\">\n    <h2>Stop babysitting pipelines.<br><span class=\"grad-text\">Start shipping data.</span></h2>\n    <p>Install Strata in under a minute and run your first contract-checked query before your coffee cools.</p>\n    <div class=\"hero-actions\">\n      <a href=\"#quickstart\" class=\"btn btn-primary\">Install Strata</a>\n      <a href=\"#\" class=\"btn btn-ghost\">Talk to maintainers</a>\n    </div>\n  </div>\n</section>\n\n<!-- ============ FOOTER ============ -->\n<footer>\n  <div class=\"container\">\n    <div class=\"foot-grid\">\n      <div>\n        <a href=\"#\" class=\"logo\">\n          <svg class=\"logo-mark\" viewBox=\"0 0 32 32\" aria-hidden=\"true\">\n            <rect x=\"2\" y=\"4\" width=\"28\" height=\"6\" rx=\"3\" fill=\"#5eead4\"/>\n            <rect x=\"2\" y=\"13\" width=\"28\" height=\"6\" rx=\"3\" fill=\"#818cf8\" opacity=\"0.75\"/>\n            <rect x=\"2\" y=\"22\" width=\"28\" height=\"6\" rx=\"3\" fill=\"#f472b6\" opacity=\"0.5\"/>\n          </svg>\n          Strata\n        </a>\n        <p>An open-source columnar database for the people who keep the data flowing.</p>\n      </div>\n      <div>\n        <h4>Product</h4>\n        <ul>\n          <li><a href=\"#features\">Features</a></li>\n          <li><a href=\"#\">Managed cloud</a></li>\n          <li><a href=\"#\">Changelog</a></li>\n          <li><a href=\"#\">Roadmap</a></li>\n        </ul>\n      </div>\n      <div>\n        <h4>Resources</h4>\n        <ul>\n          <li><a href=\"#\">Documentation</a></li>\n          <li><a href=\"#\">dbt adapter</a></li>\n          <li><a href=\"#\">Tutorials</a></li>\n          <li><a href=\"#\">Benchmarks</a></li>\n        </ul>\n      </div>\n      <div>\n        <h4>Community</h4>\n        <ul>\n          <li><a href=\"#\">GitHub</a></li>\n          <li><a href=\"#\">Discord</a></li>\n          <li><a href=\"#\">RFCs</a></li>\n          <li><a href=\"#\">Code of conduct</a></li>\n        </ul>\n      </div>\n    </div>\n\n    <div class=\"foot-bottom\">\n      <span>\u00a9 2025 Strata contributors \u00b7 Apache-2.0</span>\n      <span>Built with Rust, Arrow, and Iceberg</span>\n    </div>\n  </div>\n</footer>\n\n<script>\n  // Tabs in the code window\n  (function () {\n    const tabs = document.querySelectorAll('.tab');\n    tabs.forEach(tab => {\n      tab.addEventListener('click', () => {\n        tabs.forEach(t => t.setAttribute('aria-selected', 'false'));\n        tab.setAttribute('aria-selected', 'true');\n        document.querySelectorAll('.code-panel').forEach(p => p.classList.remove('active'));\n        document.getElementById('panel-' + tab.dataset.tab).classList.add('active');\n      });\n    });\n  })();\n\n  // Copy-to-clipboard\n  document.querySelectorAll('.copy-btn').forEach(btn => {\n    btn.addEventListener('click', async () => {\n      const text = btn.dataset.copy;\n      try {\n        await navigator.clipboard.writeText(text);\n      } catch (e) {\n        const ta = document.createElement('textarea');\n        ta.value = text;\n        document.body.appendChild(ta);\n        ta.select();\n        document.execCommand('copy');\n        ta.remove();\n      }\n      const original = btn.textContent;\n      btn.textContent = 'Copied';\n      btn.classList.add('copied');\n      setTimeout(() => {\n        btn.textContent = original;\n        btn.classList.remove('copied');\n      }, 1600);\n    });\n  });\n\n  // Animate benchmark bars when they scroll into view\n  (function () {\n    const cards = document.querySelectorAll('[data-bench]');\n    if (!('IntersectionObserver' in window)) {\n      cards.forEach(c => c.classList.add('in-view'));\n      return;\n    }\n    const io = new IntersectionObserver(entries => {\n      entries.forEach(e => {\n        if (e.isIntersecting) {\n          e.target.classList.add('in-view');\n          io.unobserve(e.target);\n        }\n      });\n    }, { threshold: 0.3 });\n    cards.forEach(c => io.observe(c));\n  })();\n\n  // Subtle cursor-tracking glow on feature cards\n  document.querySelectorAll('.feature').forEach(card => {\n    card.addEventListener('pointermove', e => {\n      const r = card.getBoundingClientRect();\n      card.style.setProperty('--mx', (e.clientX - r.left) + 'px');\n    });\n  });\n</script>\n\n</body>\n</html>\n"}