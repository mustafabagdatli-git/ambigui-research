{"arm": "direct", "model": "anthropic/claude-haiku-5.5", "i": 2, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Tidepool: Plan your week together</title>\n<meta name=\"description\" content=\"Tidepool helps small teams plan their week together in one calm, shared view. Gather priorities, align on focus, and commit on Monday.\">\n<style>\n  :root {\n    --deep: #0b3b44;\n    --teal: #13707a;\n    --teal-soft: #d7eeef;\n    --foam: #f4fbfb;\n    --sand: #f6f0e4;\n    --sand-deep: #e9dcc3;\n    --coral: #f0715b;\n    --coral-deep: #d9553f;\n    --ink: #14272b;\n    --muted: #5b6e72;\n    --line: #d9e5e6;\n    --white: #ffffff;\n    --radius: 16px;\n    --radius-sm: 10px;\n    --shadow: 0 1px 2px rgba(11,59,68,.06), 0 12px 32px rgba(11,59,68,.10);\n    --max: 1160px;\n  }\n\n  * { box-sizing: border-box; }\n  html { scroll-behavior: smooth; }\n  body {\n    margin: 0;\n    font-family: ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n    color: var(--ink);\n    background: var(--white);\n    line-height: 1.6;\n    -webkit-font-smoothing: antialiased;\n  }\n  img, svg { display: block; max-width: 100%; }\n  a { color: var(--teal); text-decoration: none; }\n  a:hover { text-decoration: underline; }\n  h1, h2, h3 { line-height: 1.15; margin: 0; color: var(--deep); letter-spacing: -0.02em; }\n  p { margin: 0; }\n  :focus-visible { outline: 3px solid var(--coral); outline-offset: 3px; border-radius: 6px; }\n\n  .wrap { max-width: var(--max); margin: 0 auto; padding: 0 24px; }\n  section { padding: 96px 0; }\n  .eyebrow {\n    display: inline-block;\n    font-size: 13px;\n    font-weight: 650;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n    color: var(--teal);\n    margin-bottom: 14px;\n  }\n  .section-head { max-width: 640px; margin-bottom: 56px; }\n  .section-head h2 { font-size: clamp(30px, 4vw, 42px); margin-bottom: 16px; }\n  .section-head p { font-size: 18px; color: var(--muted); }\n\n  /* Buttons */\n  .btn {\n    display: inline-flex; align-items: center; justify-content: center; gap: 8px;\n    font: inherit; font-weight: 600; font-size: 16px;\n    padding: 14px 22px; border-radius: 999px;\n    border: 1px solid transparent; cursor: pointer;\n    transition: transform .15s ease, background .15s ease, box-shadow .15s ease;\n    white-space: nowrap;\n  }\n  .btn:hover { text-decoration: none; transform: translateY(-1px); }\n  .btn-primary { background: var(--coral); color: #fff; box-shadow: 0 8px 20px rgba(240,113,91,.35); }\n  .btn-primary:hover { background: var(--coral-deep); }\n  .btn-ghost { background: transparent; color: var(--deep); border-color: var(--line); }\n  .btn-ghost:hover { background: var(--foam); }\n  .btn-small { padding: 9px 16px; font-size: 14px; }\n  .btn-block { width: 100%; }\n\n  /* Header */\n  header.site {\n    position: sticky; top: 0; z-index: 50;\n    background: rgba(255,255,255,.85);\n    backdrop-filter: saturate(1.4) blur(10px);\n    border-bottom: 1px solid var(--line);\n  }\n  .nav { display: flex; align-items: center; justify-content: space-between; height: 72px; }\n  .brand { display: flex; align-items: center; gap: 10px; font-weight: 750; font-size: 20px; color: var(--deep); }\n  .brand:hover { text-decoration: none; }\n  .nav-links { display: flex; gap: 28px; align-items: center; }\n  .nav-links a { color: var(--ink); font-weight: 500; font-size: 15px; }\n  .nav-links a:hover { color: var(--teal); text-decoration: none; }\n  .nav-cta { display: flex; gap: 12px; align-items: center; }\n\n  /* Hero */\n  .hero {\n    padding: 80px 0 96px;\n    background:\n      radial-gradient(900px 500px at 85% -10%, var(--teal-soft), transparent 70%),\n      radial-gradient(700px 400px at -10% 110%, var(--sand), transparent 70%),\n      var(--white);\n    overflow: hidden;\n  }\n  .hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 64px; align-items: center; }\n  .hero h1 { font-size: clamp(40px, 5.6vw, 64px); margin-bottom: 22px; }\n  .hero h1 em { font-style: normal; color: var(--teal); }\n  .hero .lead { font-size: 19px; color: var(--muted); max-width: 520px; margin-bottom: 34px; }\n  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }\n  .hero-note { margin-top: 18px; font-size: 14px; color: var(--muted); }\n  .hero-note strong { color: var(--ink); font-weight: 600; }\n\n  /* Mock planner */\n  .planner {\n    background: var(--white);\n    border: 1px solid var(--line);\n    border-radius: 20px;\n    box-shadow: var(--shadow);\n    padding: 20px;\n    position: relative;\n  }\n  .planner-top {\n    display: flex; justify-content: space-between; align-items: center;\n    padding: 4px 4px 16px; border-bottom: 1px solid var(--line); margin-bottom: 16px;\n  }\n  .planner-top h3 { font-size: 16px; }\n  .avatars { display: flex; }\n  .avatar {\n    width: 30px; height: 30px; border-radius: 50%;\n    display: grid; place-items: center;\n    font-size: 12px; font-weight: 700; color: #fff;\n    border: 2px solid #fff; margin-left: -8px;\n  }\n  .avatar:first-child { margin-left: 0; }\n  .week { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }\n  .day { background: var(--foam); border-radius: var(--radius-sm); padding: 10px 8px; min-height: 230px; }\n  .day.today { background: var(--teal-soft); }\n  .day-name { font-size: 12px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 10px; display: flex; justify-content: space-between; }\n  .day-name span { color: var(--deep); }\n  .chip {\n    font-size: 12.5px; line-height: 1.35; font-weight: 550;\n    padding: 8px 9px; border-radius: 8px; margin-bottom: 8px;\n    background: var(--white); border: 1px solid var(--line); color: var(--ink);\n    border-left: 4px solid var(--teal);\n  }\n  .chip.coral { border-left-color: var(--coral); }\n  .chip.sand { border-left-color: #d9a441; }\n  .chip.sea { border-left-color: #3fa7a0; }\n  .chip.done { opacity: .55; text-decoration: line-through; }\n  .chip small { display: block; font-weight: 500; color: var(--muted); font-size: 11px; }\n  .float-card {\n    position: absolute; right: -18px; bottom: -22px;\n    background: var(--deep); color: #e9f7f7;\n    padding: 14px 16px; border-radius: 14px;\n    box-shadow: 0 16px 36px rgba(11,59,68,.35);\n    font-size: 13px; max-width: 230px;\n  }\n  .float-card strong { display: block; color: #fff; font-size: 14px; margin-bottom: 2px; }\n  .float-card .bar { height: 6px; background: rgba(255,255,255,.18); border-radius: 99px; margin-top: 10px; overflow: hidden; }\n  .float-card .bar i { display: block; height: 100%; width: 72%; background: var(--coral); border-radius: 99px; }\n\n  /* Trust strip */\n  .trust { padding: 28px 0; background: var(--sand); border-block: 1px solid var(--sand-deep); }\n  .trust-inner { display: flex; flex-wrap: wrap; gap: 14px 40px; justify-content: center; align-items: center; font-size: 15px; color: var(--muted); }\n  .trust-inner b { color: var(--deep); font-weight: 700; }\n\n  /* Problem */\n  .problem-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }\n  .problem {\n    padding: 32px; border-radius: var(--radius);\n    border: 1px solid var(--line); background: var(--white);\n  }\n  .problem .num { font-size: 14px; font-weight: 700; color: var(--coral); margin-bottom: 14px; }\n  .problem h3 { font-size: 20px; margin-bottom: 10px; }\n  .problem p { color: var(--muted); }\n\n  /* Features */\n  .features { background: var(--foam); }\n  .feature-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }\n  .feature {\n    background: var(--white); border-radius: var(--radius);\n    padding: 36px; border: 1px solid var(--line);\n    display: grid; grid-template-columns: 56px 1fr; gap: 20px;\n  }\n  .icon {\n    width: 56px; height: 56px; border-radius: 16px;\n    background: var(--teal-soft); color: var(--teal);\n    display: grid; place-items: center;\n  }\n  .icon svg { width: 28px; height: 28px; }\n  .feature h3 { font-size: 21px; margin-bottom: 8px; }\n  .feature p { color: var(--muted); }\n  .feature ul { margin: 14px 0 0; padding: 0; list-style: none; color: var(--ink); font-size: 15px; }\n  .feature li { padding-left: 24px; position: relative; margin-bottom: 6px; }\n  .feature li::before {\n    content: \"\"; position: absolute; left: 0; top: 9px;\n    width: 10px; height: 10px; border-radius: 50%;\n    background: var(--coral);\n  }\n\n  /* How it works */\n  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; counter-reset: step; position: relative; }\n  .step { padding-top: 8px; }\n  .step-badge {\n    width: 52px; height: 52px; border-radius: 50%;\n    background: var(--deep); color: #fff; font-weight: 700; font-size: 18px;\n    display: grid; place-items: center; margin-bottom: 20px;\n    box-shadow: 0 0 0 8px var(--teal-soft);\n  }\n  .step h3 { font-size: 22px; margin-bottom: 10px; }\n  .step p { color: var(--muted); margin-bottom: 14px; }\n  .step .time { font-size: 13px; font-weight: 600; color: var(--teal); background: var(--teal-soft); padding: 4px 10px; border-radius: 999px; display: inline-block; }\n\n  /* Ritual band */\n  .ritual {\n    background: var(--deep); color: #d8ecee; border-radius: 28px;\n    padding: 64px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center;\n    position: relative; overflow: hidden;\n  }\n  .ritual::after {\n    content: \"\"; position: absolute; width: 420px; height: 420px; right: -160px; top: -200px;\n    border-radius: 50%; background: radial-gradient(circle, rgba(63,167,160,.35), transparent 70%);\n  }\n  .ritual h2 { color: #fff; font-size: clamp(28px, 3.4vw, 38px); margin-bottom: 16px; }\n  .ritual p { color: #b9dadd; font-size: 17px; }\n  .ritual-list { position: relative; z-index: 1; list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }\n  .ritual-list li {\n    background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.12);\n    border-radius: var(--radius-sm); padding: 16px 18px; display: flex; gap: 14px; align-items: flex-start;\n  }\n  .ritual-list .tick {\n    flex: 0 0 26px; height: 26px; border-radius: 50%; background: var(--coral);\n    display: grid; place-items: center; margin-top: 1px;\n  }\n  .ritual-list .tick svg { width: 14px; height: 14px; }\n  .ritual-list strong { color: #fff; display: block; font-weight: 600; }\n  .ritual-list span { font-size: 14.5px; color: #a9cdd1; }\n\n  /* Testimonials */\n  .quotes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }\n  .quote {\n    background: var(--white); border: 1px solid var(--line); border-radius: var(--radius);\n    padding: 32px; display: flex; flex-direction: column; box-shadow: var(--shadow);\n  }\n  .quote blockquote { margin: 0 0 24px; font-size: 17px; color: var(--ink); }\n  .quote blockquote::before { content: \"\\201C\"; display: block; font-size: 48px; line-height: .6; color: var(--coral); margin-bottom: 10px; font-family: Georgia, serif; }\n  .who { margin-top: auto; display: flex; gap: 12px; align-items: center; }\n  .who .avatar { margin: 0; width: 42px; height: 42px; font-size: 14px; border: none; }\n  .who strong { display: block; color: var(--deep); font-size: 15px; }\n  .who span { font-size: 13.5px; color: var(--muted); }\n\n  /* Pricing */\n  .pricing { background: var(--sand); }\n  .toggle {\n    display: inline-flex; background: var(--white); border: 1px solid var(--sand-deep);\n    border-radius: 999px; padding: 4px; margin-bottom: 40px;\n  }\n  .toggle button {\n    font: inherit; font-size: 15px; font-weight: 600; border: 0; background: transparent;\n    padding: 10px 20px; border-radius: 999px; cursor: pointer; color: var(--muted);\n  }\n  .toggle button[aria-pressed=\"true\"] { background: var(--deep); color: #fff; }\n  .toggle .save { font-size: 12px; color: var(--coral-deep); margin-left: 6px; font-weight: 700; }\n  .toggle button[aria-pressed=\"true\"] .save { color: #ffd2c8; }\n  .price-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; align-items: stretch; }\n  .plan {\n    background: var(--white); border-radius: var(--radius); padding: 36px 32px;\n    border: 1px solid var(--sand-deep); display: flex; flex-direction: column;\n  }\n  .plan.featured { border: 2px solid var(--teal); box-shadow: 0 20px 48px rgba(19,112,122,.18); position: relative; }\n  .plan .tag {\n    position: absolute; top: -13px; left: 32px; background: var(--teal); color: #fff;\n    font-size: 12px; font-weight: 700; padding: 5px 12px; border-radius: 999px; letter-spacing: .04em;\n  }\n  .plan h3 { font-size: 22px; margin-bottom: 6px; }\n  .plan .desc { color: var(--muted); font-size: 15px; margin-bottom: 24px; min-height: 48px; }\n  .price { display: flex; align-items: baseline; gap: 6px; margin-bottom: 4px; }\n  .price .amount { font-size: 48px; font-weight: 750; color: var(--deep); letter-spacing: -0.03em; }\n  .price .per { color: var(--muted); font-size: 15px; }\n  .billed { font-size: 13.5px; color: var(--muted); min-height: 20px; margin-bottom: 24px; }\n  .plan ul { list-style: none; padding: 0; margin: 0 0 32px; display: grid; gap: 12px; font-size: 15px; }\n  .plan li { display: flex; gap: 10px; }\n  .plan li svg { flex: 0 0 18px; width: 18px; height: 18px; margin-top: 3px; color: var(--teal); }\n  .plan .btn { margin-top: auto; }\n  .pricing-foot { margin-top: 28px; text-align: center; color: var(--muted); font-size: 15px; }\n\n  /* FAQ */\n  .faq-wrap { display: grid; grid-template-columns: 1fr 1.4fr; gap: 64px; align-items: start; }\n  .faq-wrap .section-head { margin-bottom: 0; }\n  .faq details { border-bottom: 1px solid var(--line); padding: 22px 0; }\n  .faq details:first-child { border-top: 1px solid var(--line); }\n  .faq summary {\n    cursor: pointer; list-style: none; font-weight: 650; font-size: 18px; color: var(--deep);\n    display: flex; justify-content: space-between; align-items: center; gap: 20px;\n  }\n  .faq summary::-webkit-details-marker { display: none; }\n  .faq summary::after {\n    content: \"+\"; font-size: 26px; font-weight: 400; color: var(--teal); line-height: 1; transition: transform .2s ease;\n  }\n  .faq details[open] summary::after { transform: rotate(45deg); }\n  .faq details p { color: var(--muted); margin-top: 12px; padding-right: 40px; }\n\n  /* Final CTA */\n  .final {\n    background: linear-gradient(135deg, var(--teal) 0%, var(--deep) 100%);\n    color: #fff; text-align: center; padding: 96px 0;\n  }\n  .final h2 { color: #fff; font-size: clamp(32px, 4.4vw, 52px); margin-bottom: 18px; }\n  .final p { color: #cbe7ea; font-size: 19px; max-width: 580px; margin: 0 auto 36px; }\n  .final .hero-actions { justify-content: center; }\n  .final .btn-ghost { color: #fff; border-color: rgba(255,255,255,.35); }\n  .final .btn-ghost:hover { background: rgba(255,255,255,.1); }\n  .final .hero-note { color: #b5d9dd; }\n  .final .hero-note strong { color: #fff; }\n\n  /* Footer */\n  footer { background: var(--white); padding: 64px 0 40px; border-top: 1px solid var(--line); }\n  .foot-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; }\n  .foot-grid p { color: var(--muted); font-size: 15px; margin-top: 14px; max-width: 300px; }\n  .foot-grid h4 { font-size: 14px; color: var(--deep); margin: 0 0 14px; text-transform: uppercase; letter-spacing: .06em; }\n  .foot-grid ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }\n  .foot-grid a { color: var(--muted); font-size: 15px; }\n  .foot-grid a:hover { color: var(--teal); }\n  .foot-bottom { margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; font-size: 14px; color: var(--muted); }\n\n  /* Responsive */\n  @media (max-width: 1000px) {\n    .hero-grid, .ritual, .faq-wrap { grid-template-columns: 1fr; }\n    .hero-grid { gap: 56px; }\n    .float-card { right: 12px; }\n    .feature-grid, .quotes, .price-grid, .problem-grid, .steps { grid-template-columns: 1fr; }\n    .price-grid .plan { max-width: 520px; width: 100%; margin: 0 auto; }\n    .foot-grid { grid-template-columns: 1fr 1fr; }\n    .ritual { padding: 44px 32px; }\n  }\n  @media (max-width: 760px) {\n    section { padding: 72px 0; }\n    .nav-links { display: none; }\n    .week { grid-template-columns: 1fr; }\n    .day { min-height: 0; }\n    .float-card { position: static; margin-top: 16px; max-width: none; }\n    .feature { grid-template-columns: 1fr; padding: 28px; }\n    .hero { padding-top: 56px; }\n  }\n  @media (max-width: 480px) {\n    .nav-cta .btn-ghost { display: none; }\n    .foot-grid { grid-template-columns: 1fr; }\n  }\n</style>\n</head>\n<body>\n\n<header class=\"site\">\n  <div class=\"wrap nav\">\n    <a href=\"#top\" class=\"brand\" aria-label=\"Tidepool home\">\n      <svg width=\"30\" height=\"30\" viewBox=\"0 0 32 32\" aria-hidden=\"true\">\n        <circle cx=\"16\" cy=\"16\" r=\"15\" fill=\"#0b3b44\"/>\n        <path d=\"M5 14c3-3 6-3 9 0s6 3 9 0 4-2 4-2\" fill=\"none\" stroke=\"#f0715b\" stroke-width=\"2.6\" stroke-linecap=\"round\"/>\n        <path d=\"M5 20c3-3 6-3 9 0s6 3 9 0 4-2 4-2\" fill=\"none\" stroke=\"#3fa7a0\" stroke-width=\"2.6\" stroke-linecap=\"round\"/>\n      </svg>\n      Tidepool\n    </a>\n    <nav class=\"nav-links\" aria-label=\"Primary\">\n      <a href=\"#how\">How it works</a>\n      <a href=\"#features\">Features</a>\n      <a href=\"#pricing\">Pricing</a>\n      <a href=\"#faq\">FAQ</a>\n    </nav>\n    <div class=\"nav-cta\">\n      <a href=\"#\" class=\"btn btn-ghost btn-small\">Log in</a>\n      <a href=\"#start\" class=\"btn btn-primary btn-small\">Start free</a>\n    </div>\n  </div>\n</header>\n\n<main id=\"top\">\n\n  <!-- Hero -->\n  <section class=\"hero\" style=\"padding-top:80px;padding-bottom:96px;\">\n    <div class=\"wrap hero-grid\">\n      <div>\n        <span class=\"eyebrow\">Weekly planning for teams of 2 to 12</span>\n        <h1>Start every week <em>on the same tide.</em></h1>\n        <p class=\"lead\">Tidepool gives your small team one shared view of the week. Gather what matters, agree on focus, and move together without another meeting that could have been a message.</p>\n        <div class=\"hero-actions\">\n          <a href=\"#start\" class=\"btn btn-primary\">Plan your first week free</a>\n          <a href=\"#how\" class=\"btn btn-ghost\">See how it works</a>\n        </div>\n        <p class=\"hero-note\"><strong>Free for teams of up to 5.</strong> No credit card, no setup call.</p>\n      </div>\n\n      <div style=\"position:relative;\">\n        <div class=\"planner\" role=\"img\" aria-label=\"Preview of a shared weekly plan with tasks across Monday to Friday\">\n          <div class=\"planner-top\">\n            <h3>Week of 14 October</h3>\n            <div class=\"avatars\" aria-hidden=\"true\">\n              <div class=\"avatar\" style=\"background:#13707a\">AM</div>\n              <div class=\"avatar\" style=\"background:#f0715b\">JR</div>\n              <div class=\"avatar\" style=\"background:#d9a441\">SK</div>\n              <div class=\"avatar\" style=\"background:#3fa7a0\">LT</div>\n            </div>\n          </div>\n          <div class=\"week\">\n            <div class=\"day\">\n              <div class=\"day-name\">Mon <span>14</span></div>\n              <div class=\"chip coral\">Ship pricing copy<small>JR \u00b7 2 tasks</small></div>\n              <div class=\"chip done\">Standup notes<small>AM</small></div>\n            </div>\n            <div class=\"day today\">\n              <div class=\"day-name\">Tue <span>15</span></div>\n              <div class=\"chip\">Customer interviews<small>SK \u00b7 3 calls</small></div>\n              <div class=\"chip sea\">Review onboarding flow<small>LT</small></div>\n            </div>\n            <div class=\"day\">\n              <div class=\"day-name\">Wed <span>16</span></div>\n              <div class=\"chip sand\">Budget check-in<small>AM</small></div>\n            </div>\n            <div class=\"day\">\n              <div class=\"day-name\">Thu <span>17</span></div>\n              <div class=\"chip\">Prototype v2<small>LT \u00b7 shared</small></div>\n              <div class=\"chip coral\">Hiring panel<small>JR</small></div>\n            </div>\n            <div class=\"day\">\n              <div class=\"day-name\">Fri <span>18</span></div>\n              <div class=\"chip sea\">Weekly retro<small>Everyone</small></div>\n            </div>\n          </div>\n        </div>\n        <div class=\"float-card\" aria-hidden=\"true\">\n          <strong>Focus met: 8 of 11</strong>\n          Team committed Monday morning. Two items moved by mutual agreement.\n          <div class=\"bar\"><i></i></div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Trust -->\n  <div class=\"trust\">\n    <div class=\"wrap trust-inner\">\n      <span><b>1,200+</b> small teams</span>\n      <span>\u00b7</span>\n      <span><b>14 min</b> median Monday planning</span>\n      <span>\u00b7</span>\n      <span>Used by design studios, support crews, and founding teams</span>\n    </div>\n  </div>\n\n  <!-- Problem -->\n  <section>\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <span class=\"eyebrow\">The problem</span>\n        <h2>Small teams don't need more process. They need a shared picture.</h2>\n        <p>When five people each carry a private to-do list, the week fragments by Tuesday. Tidepool keeps everyone looking at the same water.</p>\n      </div>\n      <div class=\"problem-grid\">\n        <article class=\"problem\">\n          <div class=\"num\">01</div>\n          <h3>Priorities live in too many places</h3>\n          <p>Chat threads, docs, sticky notes, and someone's head. Nobody can say with confidence what the team is actually doing this week.</p>\n        </article>\n        <article class=\"problem\">\n          <div class=\"num\">02</div>\n          <h3>Planning meetings eat the morning</h3>\n          <p>A 60-minute sync to agree on three things. Tidepool turns that into a ten-minute ritual that people actually finish.</p>\n        </article>\n        <article class=\"problem\">\n          <div class=\"num\">03</div>\n          <h3>Mid-week surprises derail everyone</h3>\n          <p>Work quietly shifts and no one notices until Friday. Tidepool makes changes visible as they happen, not after they hurt.</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <!-- How it works -->\n  <section id=\"how\" style=\"background:var(--white);\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <span class=\"eyebrow\">How it works</span>\n        <h2>One ritual. Three steps. Ten minutes.</h2>\n        <p>Tidepool is built around a Monday rhythm that fits around the work, not on top of it.</p>\n      </div>\n      <div class=\"steps\">\n        <div class=\"step\">\n          <div class=\"step-badge\">1</div>\n          <h3>Gather</h3>\n          <p>Everyone drops in what they're hoping to finish this week. Add tasks, link docs, or flag what's blocked. Nothing gets lost in a thread.</p>\n          <span class=\"time\">Async \u00b7 about 3 min each</span>\n        </div>\n        <div class=\"step\">\n          <div class=\"step-badge\">2</div>\n          <h3>Align</h3>\n          <p>See the whole team's load on one board. Drag items across days, swap owners, and agree on the top three things that define a good week.</p>\n          <span class=\"time\">Together \u00b7 about 6 min</span>\n        </div>\n        <div class=\"step\">\n          <div class=\"step-badge\">3</div>\n          <h3>Commit</h3>\n          <p>Lock the plan with one click. Tidepool posts it to your channel, sends reminders on Wednesday, and gathers a short retro on Friday.</p>\n          <span class=\"time\">One click \u00b7 1 min</span>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Ritual band -->\n  <section style=\"padding-top:0;\">\n    <div class=\"wrap\">\n      <div class=\"ritual\">\n        <div>\n          <h2>Make Monday feel lighter.</h2>\n          <p>Tidepool structures the week around a shared ritual your team can run in ten minutes, with or without a call. It works for remote crews, hybrid studios, and teams that share one room.</p>\n        </div>\n        <ul class=\"ritual-list\">\n          <li>\n            <span class=\"tick\" aria-hidden=\"true\"><svg viewBox=\"0 0 16 16\"><path d=\"M3 8.5l3 3 7-7\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            <div><strong>Three focus goals, no more</strong><span>Each person names the work that would make the week a success.</span></div>\n          </li>\n          <li>\n            <span class=\"tick\" aria-hidden=\"true\"><svg viewBox=\"0 0 16 16\"><path d=\"M3 8.5l3 3 7-7\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            <div><strong>Capacity shown, not guessed</strong><span>See who has room before you add another request to someone's plate.</span></div>\n          </li>\n          <li>\n            <span class=\"tick\" aria-hidden=\"true\"><svg viewBox=\"0 0 16 16\"><path d=\"M3 8.5l3 3 7-7\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n            <div><strong>Changes leave a trail</strong><span>When a plan shifts, the reason is recorded so the next Monday starts smarter.</span></div>\n          </li>\n        </ul>\n      </div>\n    </div>\n  </section>\n\n  <!-- Features -->\n  <section id=\"features\" class=\"features\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <span class=\"eyebrow\">Features</span>\n        <h2>Everything a small team needs. Nothing it doesn't.</h2>\n        <p>Tidepool is deliberately small. Each feature exists to keep the week clear and the team in sync.</p>\n      </div>\n      <div class=\"feature-grid\">\n        <article class=\"feature\">\n          <div class=\"icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"17\" rx=\"3\"/><path d=\"M3 9h18M8 2v4M16 2v4\"/></svg>\n          </div>\n          <div>\n            <h3>A shared week board</h3>\n            <p>One view of Monday through Friday that everyone can read at a glance.</p>\n            <ul>\n              <li>Drag tasks between days and owners</li>\n              <li>Filter by person, project, or status</li>\n            </ul>\n          </div>\n        </article>\n        <article class=\"feature\">\n          <div class=\"icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><circle cx=\"12\" cy=\"12\" r=\"4\"/></svg>\n          </div>\n          <div>\n            <h3>Focus goals</h3>\n            <p>Agree on a short list of outcomes that define success before anyone starts.</p>\n            <ul>\n              <li>Cap at three goals per person</li>\n              <li>Track progress without status meetings</li>\n            </ul>\n          </div>\n        </article>\n        <article class=\"feature\">\n          <div class=\"icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 6h16M4 12h10M4 18h7\"/><circle cx=\"19\" cy=\"17\" r=\"3\"/></svg>\n          </div>\n          <div>\n            <h3>Capacity at a glance</h3>\n            <p>See how loaded each person is before you commit, so nobody over-promises by accident.</p>\n            <ul>\n              <li>Gentle warnings when a day overflows</li>\n              <li>Hours or task count, your choice</li>\n            </ul>\n          </div>\n        </article>\n        <article class=\"feature\">\n          <div class=\"icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 12a8 8 0 1 1-2.3-5.6\"/><path d=\"M21 4v5h-5\"/></svg>\n          </div>\n          <div>\n            <h3>Friday retros</h3>\n            <p>A three-question check-in that turns the week's surprises into next week's better plan.</p>\n            <ul>\n              <li>What shipped, what slipped, what we learned</li>\n              <li>Summaries saved to your history</li>\n            </ul>\n          </div>\n        </article>\n        <article class=\"feature\">\n          <div class=\"icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"/></svg>\n          </div>\n          <div>\n            <h3>Posts to where you talk</h3>\n            <p>Send the locked plan and daily nudges to your team chat. No one has to open another tab.</p>\n            <ul>\n              <li>Slack, Microsoft Teams, and email digests</li>\n              <li>Quiet hours respected automatically</li>\n            </ul>\n          </div>\n        </article>\n        <article class=\"feature\">\n          <div class=\"icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"5\" y=\"11\" width=\"14\" height=\"10\" rx=\"2\"/><path d=\"M8 11V7a4 4 0 0 1 8 0v4\"/></svg>\n          </div>\n          <div>\n            <h3>Private by default</h3>\n            <p>Personal notes stay yours. Only what you choose to share appears on the team board.</p>\n            <ul>\n              <li>Single sign-on and SOC 2 report on request</li>\n              <li>Export everything, any time</li>\n            </ul>\n          </div>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <!-- Testimonials -->\n  <section>\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <span class=\"eyebrow\">Stories</span>\n        <h2>Teams that found their Monday rhythm.</h2>\n      </div>\n      <div class=\"quotes\">\n        <figure class=\"quote\" style=\"margin:0;\">\n          <blockquote>We used to spend Monday asking what everyone was doing. Now we spend it deciding what matters. It's the most useful ten minutes of our week.</blockquote>\n          <figcaption class=\"who\">\n            <div class=\"avatar\" style=\"background:#13707a\" aria-hidden=\"true\">AM</div>\n            <div><strong>Ana Moreno</strong><span>Founder, five-person design studio</span></div>\n          </figcaption>\n        </figure>\n        <figure class=\"quote\" style=\"margin:0;\">\n          <blockquote>Our support crew covers three time zones. Tidepool is the only place where the whole team's week is visible at once, and nobody has to ask.</blockquote>\n          <figcaption class=\"who\">\n            <div class=\"avatar\" style=\"background:#f0715b\" aria-hidden=\"true\">JR</div>\n            <div><strong>Jamal Reid</strong><span>Support lead, remote team of nine</span></div>\n          </figcaption>\n        </figure>\n        <figure class=\"quote\" style=\"margin:0;\">\n          <blockquote>The capacity view stopped us from overcommitting. We finally say no on Monday instead of apologizing on Thursday.</blockquote>\n          <figcaption class=\"who\">\n            <div class=\"avatar\" style=\"background:#d9a441\" aria-hidden=\"true\">SK</div>\n            <div><strong>Sofia Kaur</strong><span>Product manager, early-stage startup</span></div>\n          </figcaption>\n        </figure>\n      </div>\n    </div>\n  </section>\n\n  <!-- Pricing -->\n  <section id=\"pricing\" class=\"pricing\">\n    <div class=\"wrap\">\n      <div class=\"section-head\" style=\"margin-left:auto;margin-right:auto;text-align:center;\">\n        <span class=\"eyebrow\">Pricing</span>\n        <h2>Free for small. Fair for growing.</h2>\n        <p>Start with the whole ritual at no cost. Upgrade when your team needs more room.</p>\n      </div>\n\n      <div style=\"text-align:center;\">\n        <div class=\"toggle\" role=\"group\" aria-label=\"Billing period\">\n          <button type=\"button\" data-billing=\"monthly\" aria-pressed=\"true\">Monthly</button>\n          <button type=\"button\" data-billing=\"annual\" aria-pressed=\"false\">Annual<span class=\"save\">Save 20%</span></button>\n        </div>\n      </div>\n\n      <div class=\"price-grid\">\n        <div class=\"plan\">\n          <h3>Starter</h3>\n          <p class=\"desc\">For tiny teams getting the Monday habit in place.</p>\n          <div class=\"price\"><span class=\"amount\">$0</span><span class=\"per\">/ forever</span></div>\n          <div class=\"billed\">Up to 5 people</div>\n          <ul>\n            <li><svg viewBox=\"0 0 18 18\"><path d=\"M3 9.5l4 4 8-8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Shared week board</li>\n            <li><svg viewBox=\"0 0 18 18\"><path d=\"M3 9.5l4 4 8-8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Focus goals and Friday retros</li>\n            <li><svg viewBox=\"0 0 18 18\"><path d=\"M3 9.5l4 4 8-8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>30-day history</li>\n          </ul>\n          <a href=\"#start\" class=\"btn btn-ghost btn-block\">Start free</a>\n        </div>\n\n        <div class=\"plan featured\">\n          <span class=\"tag\">Most popular</span>\n          <h3>Team</h3>\n          <p class=\"desc\">For small teams that plan together every single week.</p>\n          <div class=\"price\"><span class=\"amount\" data-monthly=\"$8\" data-annual=\"$6\">$8</span><span class=\"per\">/ person / month</span></div>\n          <div class=\"billed\" data-monthly-note=\"Billed monthly\" data-annual-note=\"Billed annually at $72 per person\">Billed monthly</div>\n          <ul>\n            <li><svg viewBox=\"0 0 18 18\"><path d=\"M3 9.5l4 4 8-8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Everything in Starter</li>\n            <li><svg viewBox=\"0 0 18 18\"><path d=\"M3 9.5l4 4 8-8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Capacity planning and workload view</li>\n            <li><svg viewBox=\"0 0 18 18\"><path d=\"M3 9.5l4 4 8-8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Slack and Teams posting</li>\n            <li><svg viewBox=\"0 0 18 18\"><path d=\"M3 9.5l4 4 8-8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Unlimited history and exports</li>\n          </ul>\n          <a href=\"#start\" class=\"btn btn-primary btn-block\">Start 14-day trial</a>\n        </div>\n\n        <div class=\"plan\">\n          <h3>Studio</h3>\n          <p class=\"desc\">For organizations coordinating several small teams at once.</p>\n          <div class=\"price\"><span class=\"amount\">Let's talk</span></div>\n          <div class=\"billed\">Custom pricing for 13+ people</div>\n          <ul>\n            <li><svg viewBox=\"0 0 18 18\"><path d=\"M3 9.5l4 4 8-8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Everything in Team</li>\n            <li><svg viewBox=\"0 0 18 18\"><path d=\"M3 9.5l4 4 8-8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Cross-team views</li>\n            <li><svg viewBox=\"0 0 18 18\"><path d=\"M3 9.5l4 4 8-8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>SSO and admin controls</li>\n            <li><svg viewBox=\"0 0 18 18\"><path d=\"M3 9.5l4 4 8-8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Dedicated onboarding</li>\n          </ul>\n          <a href=\"#start\" class=\"btn btn-ghost btn-block\">Contact sales</a>\n        </div>\n      </div>\n      <p class=\"pricing-foot\">Every plan includes a 14-day trial of Team features. No credit card required.</p>\n    </div>\n  </section>\n\n  <!-- FAQ -->\n  <section id=\"faq\">\n    <div class=\"wrap faq-wrap\">\n      <div class=\"section-head\">\n        <span class=\"eyebrow\">FAQ</span>\n        <h2>Questions, answered.</h2>\n        <p style=\"margin-top:16px;\">Still curious? Write to <a href=\"#\">hello@tidepool.app</a> and a real person will reply within a day.</p>\n      </div>\n      <div class=\"faq\">\n        <details open>\n          <summary>How is this different from a project management tool?</summary>\n          <p>Tidepool is about the week, not the backlog. It doesn't replace your task tracker. It gives the team a shared, short-horizon plan and a ritual for agreeing on it together.</p>\n        </details>\n        <details>\n          <summary>Does my team have to be in the same time zone?</summary>\n          <p>No. The Gather step is fully asynchronous, and the Align step takes about six minutes, so it fits into overlapping hours or can be done as a quick written review.</p>\n        </details>\n        <details>\n          <summary>Can I import tasks from our existing tools?</summary>\n          <p>Yes. You can import from common task trackers and spreadsheets, and link items back to their source so nothing gets duplicated.</p>\n        </details>\n        <details>\n          <summary>Who can see my personal notes?</summary>\n          <p>Only you. Personal notes are private by default. You choose what to promote to the shared week board, and you can unshare at any time.</p>\n        </details>\n        <details>\n          <summary>What happens when the trial ends?</summary>\n          <p>You move to the Starter plan automatically, and your data stays intact. Team features pause until you choose to upgrade. We'll remind you before the trial ends, and we never charge without asking.</p>\n        </details>\n      </div>\n    </div>\n  </section>\n\n  <!-- Final CTA -->\n  <section class=\"final\" id=\"start\">\n    <div class=\"wrap\">\n      <h2>Find the tide. Plan the week together.</h2>\n      <p>Set up your first shared week in under five minutes. Invite your team, gather this week's priorities, and commit on Monday.</p>\n      <div class=\"hero-actions\">\n        <a href=\"#\" class=\"btn btn-primary\">Start your free week</a>\n        <a href=\"#\" class=\"btn btn-ghost\">Book a 15-minute walkthrough</a>\n      </div>\n      <p class=\"hero-note\" style=\"margin-top:20px;\"><strong>Free for up to 5 people.</strong> No credit card. Cancel anytime.</p>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <div class=\"foot-grid\">\n      <div>\n        <a href=\"#top\" class=\"brand\" aria-label=\"Tidepool home\">\n          <svg width=\"28\" height=\"28\" viewBox=\"0 0 32 32\" aria-hidden=\"true\">\n            <circle cx=\"16\" cy=\"16\" r=\"15\" fill=\"#0b3b44\"/>\n            <path d=\"M5 14c3-3 6-3 9 0s6 3 9 0 4-2 4-2\" fill=\"none\" stroke=\"#f0715b\" stroke-width=\"2.6\" stroke-linecap=\"round\"/>\n            <path d=\"M5 20c3-3 6-3 9 0s6 3 9 0 4-2 4-2\" fill=\"none\" stroke=\"#3fa7a0\" stroke-width=\"2.6\" stroke-linecap=\"round\"/>\n          </svg>\n          Tidepool\n        </a>\n        <p>A calm place for small teams to plan the week together.</p>\n      </div>\n      <div>\n        <h4>Product</h4>\n        <ul>\n          <li><a href=\"#features\">Features</a></li>\n          <li><a href=\"#pricing\">Pricing</a></li>\n          <li><a href=\"#how\">How it works</a></li>\n          <li><a href=\"#\">Integrations</a></li>\n        </ul>\n      </div>\n      <div>\n        <h4>Company</h4>\n        <ul>\n          <li><a href=\"#\">About</a></li>\n          <li><a href=\"#\">Journal</a></li>\n          <li><a href=\"#\">Careers</a></li>\n          <li><a href=\"#\">Contact</a></li>\n        </ul>\n      </div>\n      <div>\n        <h4>Resources</h4>\n        <ul>\n          <li><a href=\"#faq\">FAQ</a></li>\n          <li><a href=\"#\">Weekly ritual guide</a></li>\n          <li><a href=\"#\">Security</a></li>\n          <li><a href=\"#\">Status</a></li>\n        </ul>\n      </div>\n    </div>\n    <div class=\"foot-bottom\">\n      <span>\u00a9 2025 Tidepool Labs. All rights reserved.</span>\n      <span><a href=\"#\">Privacy</a> \u00b7 <a href=\"#\">Terms</a> \u00b7 <a href=\"#\">Cookies</a></span>\n    </div>\n  </div>\n</footer>\n\n<script>\n  (function () {\n    var buttons = document.querySelectorAll('[data-billing]');\n    var amount = document.querySelector('[data-monthly][data-annual]');\n    var note = document.querySelector('[data-monthly-note]');\n    buttons.forEach(function (btn) {\n      btn.addEventListener('click', function () {\n        var mode = btn.getAttribute('data-billing');\n        buttons.forEach(function (b) { b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'); });\n        if (amount) amount.textContent = amount.getAttribute('data-' + mode);\n        if (note) note.textContent = note.getAttribute('data-' + mode + '-note');\n      });\n    });\n  })();\n</script>\n\n</body>\n</html>\n"}