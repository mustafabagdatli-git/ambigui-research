{"arm": "direct", "model": "z-ai/glm-5.3-flashx", "i": 9, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Tidepool \u2014 Plan your week together</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Space+Grotesk:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --paper:#F6F1E7;\n    --sand:#EAE0CE;\n    --ink:#0D3B3A;\n    --ink-soft:#3E615E;\n    --coral:#E4593F;\n    --teal-mid:#175B58;\n    --wave1:#CFE2DC;\n    --wave2:#8FBDB4;\n    --wave3:#2E7168;\n  }\n  *{margin:0;padding:0;box-sizing:border-box}\n  html{scroll-behavior:smooth}\n  body{\n    background:var(--paper);\n    color:var(--ink);\n    font-family:'Space Grotesk',sans-serif;\n    -webkit-font-smoothing:antialiased;\n    overflow-x:hidden;\n  }\n  ::selection{background:var(--coral);color:var(--paper)}\n\n  /* ---------- NAV ---------- */\n  nav{\n    position:fixed;top:0;left:0;right:0;z-index:50;\n    display:flex;align-items:center;justify-content:space-between;\n    padding:20px 48px;\n    transition:background .3s,box-shadow .3s;\n  }\n  nav.scrolled{background:rgba(246,241,231,.92);backdrop-filter:blur(8px);box-shadow:0 1px 0 var(--sand)}\n  .logo{display:flex;align-items:center;gap:10px;font-family:'Fraunces',serif;font-size:22px;font-weight:600;letter-spacing:-.01em;text-decoration:none;color:var(--ink)}\n  .logo svg{display:block}\n  .nav-links{display:flex;gap:36px;align-items:center}\n  .nav-links a{color:var(--ink-soft);text-decoration:none;font-size:15px;font-weight:500;position:relative}\n  .nav-links a:not(.cta)::after{content:'';position:absolute;left:0;bottom:-4px;width:0;height:2px;background:var(--coral);transition:width .25s}\n  .nav-links a:not(.cta):hover::after{width:100%}\n  .nav-links a.cta{\n    background:var(--ink);color:var(--paper);padding:10px 22px;border-radius:99px;\n    transition:background .25s,transform .25s;\n  }\n  .nav-links a.cta:hover{background:var(--coral);transform:translateY(-1px)}\n  @media(max-width:760px){.nav-links a:not(.cta){display:none}nav{padding:16px 20px}}\n\n  /* ---------- HERO ---------- */\n  .hero{\n    position:relative;\n    min-height:100vh;\n    display:flex;flex-direction:column;justify-content:center;\n    padding:140px 48px 0;\n  }\n  .hero-inner{max-width:1200px;margin:0 auto;width:100%;position:relative;z-index:3}\n  .kicker{\n    display:inline-flex;align-items:center;gap:10px;\n    font-size:13px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;\n    color:var(--teal-mid);margin-bottom:28px;\n  }\n  .kicker::before{content:'';width:34px;height:2px;background:var(--coral)}\n  h1{\n    font-family:'Fraunces',serif;font-weight:500;\n    font-size:clamp(44px,7.4vw,104px);\n    line-height:1.02;letter-spacing:-.02em;\n    max-width:12ch;\n  }\n  h1 em{font-style:italic;color:var(--coral)}\n  .hero p.lede{\n    margin-top:32px;max-width:46ch;\n    font-size:clamp(16px,1.5vw,19px);line-height:1.65;color:var(--ink-soft);\n  }\n  .hero-actions{display:flex;gap:16px;margin-top:44px;flex-wrap:wrap}\n  .btn{\n    display:inline-flex;align-items:center;gap:10px;\n    font-family:'Space Grotesk',sans-serif;font-size:16px;font-weight:600;\n    padding:16px 30px;border-radius:99px;text-decoration:none;cursor:pointer;border:none;\n    transition:transform .25s,background .25s,box-shadow .25s;\n  }\n  .btn-primary{background:var(--ink);color:var(--paper)}\n  .btn-primary:hover{background:var(--coral);transform:translateY(-2px);box-shadow:0 10px 24px rgba(228,89,63,.28)}\n  .btn-ghost{background:transparent;color:var(--ink);border:1.5px solid var(--ink)}\n  .btn-ghost:hover{background:var(--ink);color:var(--paper);transform:translateY(-2px)}\n\n  /* Waves */\n  .tide{position:absolute;left:0;right:0;bottom:0;height:44vh;min-height:300px;pointer-events:none}\n  .tide svg{position:absolute;bottom:0;width:200%;height:100%}\n  .hero-caption{\n    position:absolute;right:48px;bottom:38vh;z-index:2;\n    font-family:'Fraunces',serif;font-style:italic;font-size:15px;color:var(--teal-mid);\n    text-align:right;line-height:1.5;max-width:200px;\n  }\n  .hero-caption .hint{display:block;font-family:'Space Grotesk',sans-serif;font-style:normal;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--coral);margin-top:8px}\n  @media(max-width:760px){.hero{padding:120px 20px 0}.hero-caption{display:none}}\n\n  /* ---------- TICKER ---------- */\n  .ticker{\n    background:var(--ink);color:var(--paper);\n    padding:16px 0;overflow:hidden;white-space:nowrap;position:relative;z-index:4;\n  }\n  .ticker-track{display:inline-block;animation:slide 26s linear infinite}\n  .ticker span{\n    font-family:'Fraunces',serif;font-size:17px;margin:0 34px;\n  }\n  .ticker .dot{color:var(--coral)}\n  @keyframes slide{from{transform:translateX(0)}to{transform:translateX(-50%)}}\n\n  /* ---------- SHARED SECTION ---------- */\n  section{padding:110px 48px}\n  .wrap{max-width:1200px;margin:0 auto}\n  .sec-label{font-size:13px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--coral);margin-bottom:18px}\n  h2{font-family:'Fraunces',serif;font-weight:500;font-size:clamp(32px,4.2vw,54px);line-height:1.08;letter-spacing:-.015em;max-width:20ch}\n  @media(max-width:760px){section{padding:72px 20px}}\n\n  /* ---------- WEEK FLOW ---------- */\n  .flow-head{display:flex;justify-content:space-between;align-items:flex-end;gap:40px;flex-wrap:wrap;margin-bottom:70px}\n  .flow-head p{max-width:38ch;color:var(--ink-soft);line-height:1.65;font-size:16px}\n  .flow{display:flex;gap:0;border-top:2px solid var(--ink)}\n  .flow-day{\n    flex:1;padding:28px 24px 40px;position:relative;\n    border-left:1px solid rgba(13,59,58,.15);\n    transition:background .3s;\n  }\n  .flow-day:first-child{border-left:none}\n  .flow-day:hover{background:var(--sand)}\n  .flow-day .day{font-family:'Fraunces',serif;font-size:22px;font-weight:600}\n  .flow-day .time{font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--coral);margin:6px 0 16px;font-weight:600}\n  .flow-day p{font-size:14.5px;line-height:1.6;color:var(--ink-soft)}\n  .flow-day::after{\n    content:'';position:absolute;top:-7px;left:24px;\n    width:12px;height:12px;border-radius:50%;\n    background:var(--paper);border:2.5px solid var(--ink);transition:background .3s,transform .3s;\n  }\n  .flow-day:hover::after{background:var(--coral);transform:scale(1.25)}\n  .flow-depth{height:6px;background:var(--wave2);border-radius:3px;margin-top:20px;transform-origin:left;}\n  @media(max-width:900px){.flow{flex-direction:column}.flow-day{border-left:none;border-top:1px solid rgba(13,59,58,.15)}}\n\n  /* ---------- DEMO ---------- */\n  .demo{background:var(--ink);color:var(--paper)}\n  .demo .sec-label{color:var(--wave2)}\n  .demo h2{color:var(--paper)}\n  .demo-grid{display:grid;grid-template-columns:1fr 1.5fr;gap:70px;margin-top:60px;align-items:start}\n  @media(max-width:960px){.demo-grid{grid-template-columns:1fr;gap:44px}}\n  .demo-copy p{color:#B9D2CC;line-height:1.7;font-size:16px;margin-top:20px;max-width:42ch}\n  .demo-copy .try{\n    margin-top:34px;padding:18px 22px;border:1px dashed rgba(233,223,206,.4);border-radius:14px;\n    font-size:14px;line-height:1.6;color:#B9D2CC;\n  }\n  .demo-copy .try strong{color:var(--paper)}\n  .planner{\n    background:var(--paper);border-radius:20px;padding:26px;color:var(--ink);\n    box-shadow:0 30px 60px rgba(0,0,0,.35);\n  }\n  .planner-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}\n  .planner-head .week{font-family:'Fraunces',serif;font-size:18px;font-weight:600}\n  .planner-head .crew{font-size:12px;color:var(--ink-soft)}\n  .crew i{font-style:normal;display:inline-block;width:22px;height:22px;border-radius:50%;background:var(--wave3);color:var(--paper);text-align:center;line-height:22px;font-size:10px;font-weight:600;margin-left:-6px;border:2px solid var(--paper)}\n  .crew i:first-child{margin-left:0;background:var(--coral)}\n  .crew i:nth-child(2){background:var(--teal-mid)}\n  .board{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}\n  @media(max-width:640px){.board{grid-template-columns:repeat(2,1fr)}}\n  .col{\n    background:var(--sand);border-radius:12px;padding:10px 8px 8px;min-height:190px;\n    transition:outline .15s;outline:2px dashed transparent;outline-offset:2px;\n  }\n  .col.over{outline-color:var(--coral);background:#E2D5BC}\n  .col h4{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft);text-align:center;margin-bottom:10px;font-weight:600}\n  .task{\n    background:var(--paper);border-radius:8px;padding:9px 10px;margin-bottom:8px;\n    font-size:12.5px;line-height:1.4;cursor:grab;\n    border-left:3px solid var(--teal-mid);\n    box-shadow:0 1px 3px rgba(13,59,58,.12);\n    transition:transform .15s,box-shadow .15s;\n    user-select:none;\n  }\n  .task:hover{transform:translateY(-2px);box-shadow:0 4px 10px rgba(13,59,58,.18)}\n  .task.dragging{opacity:.4;cursor:grabbing}\n  .task .who{display:block;font-size:10px;color:var(--coral);font-weight:600;margin-top:3px;letter-spacing:.05em}\n  .task.mine{border-left-color:var(--coral)}\n  .add-task{\n    display:block;width:100%;background:transparent;border:1.5px dashed rgba(13,59,58,.3);\n    border-radius:8px;padding:7px;font-size:11px;color:var(--ink-soft);cursor:pointer;\n    font-family:'Space Grotesk',sans-serif;transition:border-color .2s,color .2s,background .2s;\n  }\n  .add-task:hover{border-color:var(--coral);color:var(--coral);background:rgba(228,89,63,.06)}\n\n  /* ---------- MANIFESTO ---------- */\n  .manifesto{padding:150px 48px;text-align:center}\n  .manifesto blockquote{\n    font-family:'Fraunces',serif;font-weight:500;\n    font-size:clamp(26px,3.6vw,46px);line-height:1.3;letter-spacing:-.01em;\n    max-width:26ch;margin:0 auto;\n  }\n  .manifesto blockquote em{font-style:italic;color:var(--coral)}\n  .manifesto cite{\n    display:block;margin-top:34px;font-style:normal;\n    font-family:'Space Grotesk',sans-serif;font-size:14px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-soft);\n  }\n  @media(max-width:760px){.manifesto{padding:100px 20px}}\n\n  /* ---------- CTA / FOOTER ---------- */\n  .cta-band{\n    background:var(--sand);\n    padding:110px 48px;text-align:center;position:relative;overflow:hidden;\n  }\n  .cta-band h2{margin:0 auto 20px}\n  .cta-band p{color:var(--ink-soft);max-width:44ch;margin:0 auto 40px;line-height:1.65}\n  .cta-band .mini-wave{position:absolute;bottom:-10px;left:0;width:100%;opacity:.5}\n  footer{\n    background:var(--ink);color:#9BB8B2;\n    padding:56px 48px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:24px;\n  }\n  footer .logo{color:var(--paper)}\n  footer a{color:#9BB8B2;text-decoration:none;font-size:14px;margin-left:28px;transition:color .2s}\n  footer a:hover{color:var(--paper)}\n  @media(max-width:760px){footer{padding:40px 20px}footer a{margin-left:0;margin-right:24px}}\n\n  /* ---------- TOAST ---------- */\n  .toast{\n    position:fixed;bottom:28px;left:50%;transform:translate(-50%,80px);\n    background:var(--ink);color:var(--paper);padding:14px 26px;border-radius:99px;\n    font-size:14px;font-weight:500;z-index:100;opacity:0;\n    transition:transform .35s cubic-bezier(.2,.9,.3,1.2),opacity .35s;\n    box-shadow:0 12px 30px rgba(13,59,58,.35);\n    border-left:4px solid var(--coral);\n  }\n  .toast.show{transform:translate(-50%,0);opacity:1}\n\n  /* reveal */\n  .reveal{opacity:0;transform:translateY(28px);transition:opacity .7s ease,transform .7s ease}\n  .reveal.in{opacity:1;transform:none}\n</style>\n</head>\n<body>\n\n<nav id=\"nav\">\n  <a class=\"logo\" href=\"#\">\n    <svg width=\"26\" height=\"26\" viewBox=\"0 0 26 26\" fill=\"none\">\n      <circle cx=\"13\" cy=\"13\" r=\"11.5\" stroke=\"#0D3B3A\" stroke-width=\"2\"/>\n      <path d=\"M4 15 Q8 11 13 15 T22 15\" stroke=\"#E4593F\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\"/>\n    </svg>\n    Tidepool\n  </a>\n  <div class=\"nav-links\">\n    <a href=\"#flow\">The rhythm</a>\n    <a href=\"#demo\">Try it</a>\n    <a href=\"#pricing\">Pricing</a>\n    <a href=\"#\" class=\"cta\" onclick=\"toast('Welcome aboard \u2014 no credit card needed.');return false;\">Start free</a>\n  </div>\n</nav>\n\n<!-- HERO -->\n<header class=\"hero\">\n  <div class=\"hero-inner\">\n    <span class=\"kicker\">Weekly planning for small teams</span>\n    <h1>Every week has a <em>rhythm.</em> Find yours together.</h1>\n    <p class=\"lede\">Tidepool is a fifteen-minute Monday ritual for teams of 2\u201312. Everyone drops in what they're working on, spots the collisions, and the week flows \u2014 instead of flooding.</p>\n    <div class=\"hero-actions\">\n      <a href=\"#demo\" class=\"btn btn-primary\">Try the live demo\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M3 8h10M9 4l4 4-4 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n      </a>\n      <a href=\"#flow\" class=\"btn btn-ghost\">How a week flows</a>\n    </div>\n  </div>\n  <div class=\"hero-caption\">\n    The tide moves when you do.\n    <span class=\"hint\">\u2014 move your cursor across the water</span>\n  </div>\n  <div class=\"tide\">\n    <svg id=\"wave1\" preserveAspectRatio=\"none\" viewBox=\"0 0 1440 320\"><path fill=\"#CFE2DC\" d=\"\"/></svg>\n    <svg id=\"wave2\" preserveAspectRatio=\"none\" viewBox=\"0 0 1440 320\"><path fill=\"#8FBDB4\" d=\"\"/></svg>\n    <svg id=\"wave3\" preserveAspectRatio=\"none\" viewBox=\"0 0 1440 320\"><path fill=\"#2E7168\" d=\"\"/></svg>\n  </div>\n</header>\n\n<!-- TICKER -->\n<div class=\"ticker\" aria-hidden=\"true\">\n  <div class=\"ticker-track\" id=\"tickerTrack\">\n    <span>Monday standup, 15 min <i class=\"dot\">\u25cf</i></span>\n    <span>No status meetings needed <i class=\"dot\">\u25cf</i></span>\n    <span>See who's underwater before they sink <i class=\"dot\">\u25cf</i></span>\n    <span>Friday retro in one glance <i class=\"dot\">\u25cf</i></span>\n    <span>Monday standup, 15 min <i class=\"dot\">\u25cf</i></span>\n    <span>No status meetings needed <i class=\"dot\">\u25cf</i></span>\n    <span>See who's underwater before they sink <i class=\"dot\">\u25cf</i></span>\n    <span>Friday retro in one glance <i class=\"dot\">\u25cf</i></span>\n  </div>\n</div>\n\n<!-- WEEK FLOW -->\n<section id=\"flow\">\n  <div class=\"wrap\">\n    <div class=\"flow-head reveal\">\n      <div>\n        <div class=\"sec-label\">The rhythm</div>\n        <h2>A week that ebbs and flows, on purpose.</h2>\n      </div>\n      <p>Tidepool doesn't ask for daily updates or another meeting. It shapes the week into four gentle movements \u2014 so momentum builds where it should, and quiets where it can.</p>\n    </div>\n    <div class=\"flow reveal\">\n      <div class=\"flow-day\">\n        <div class=\"day\">Mon</div><div class=\"time\">High tide</div>\n        <p>Everyone drops their intentions for the week. Tidepool surfaces overlaps, gaps, and who's carrying too much.</p>\n        <div class=\"flow-depth\" style=\"transform:scaleX(.85)\"></div>\n      </div>\n      <div class=\"flow-day\">\n        <div class=\"day\">Tue\u2013Wed</div><div class=\"time\">The pull</div>\n        <p>Deep work. Tidepool stays quiet, quietly tracking drift \u2014 a task slipping from Wednesday to Friday shows up as a ripple, not a surprise.</p>\n        <div class=\"flow-depth\" style=\"transform:scaleX(1)\"></div>\n      </div>\n      <div class=\"flow-day\">\n        <div class=\"day\">Thu</div><div class=\"time\">The turn</div>\n        <p>A gentle nudge: what's still realistic? Rebalance in two minutes, without a single \"quick sync.\"</p>\n        <div class=\"flow-depth\" style=\"transform:scaleX(.6)\"></div>\n      </div>\n      <div class=\"flow-day\">\n        <div class=\"day\">Fri</div><div class=\"time\">Low tide</div>\n        <p>The week settles. What washed up, what got shipped, what rolls into next week \u2014 visible to everyone, explained by no one.</p>\n        <div class=\"flow-depth\" style=\"transform:scaleX(.3)\"></div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- DEMO -->\n<section class=\"demo\" id=\"demo\">\n  <div class=\"wrap\">\n    <div class=\"sec-label reveal\">Live demo \u2014 it really works</div>\n    <h2 class=\"reveal\" style=\"color:var(--paper)\">Drag the week around. See how it feels.</h2>\n    <div class=\"demo-grid\">\n      <div class=\"demo-copy reveal\">\n        <p>This is a real, working slice of Tidepool \u2014 the Monday board for a four-person team. Each card is someone's intention for the week.</p>\n        <p>Notice what you can see at a glance: Maya has three things and Priya has one. Someone's underwater. On Friday, this same board becomes the retro.</p>\n        <div class=\"try\">\n          <strong>Try it:</strong> drag cards between days \u00b7 click <em>+ add</em> on any day to drop in your own task \u00b7 cards with a coral edge belong to you.\n        </div>\n      </div>\n      <div class=\"planner reveal\">\n        <div class=\"planner-head\">\n          <div class=\"week\">Week 12 \u00b7 The Helm Studio</div>\n          <div class=\"crew\"><i>M</i><i>P</i><i>J</i><i>T</i> crew of 4</div>\n        </div>\n        <div class=\"board\" id=\"board\"></div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- MANIFESTO -->\n<section class=\"manifesto\">\n  <blockquote class=\"reveal\">\"Planning tools fail when they demand a diary. Tidepool asks for <em>fifteen minutes</em> and gives you back the other four days.\"</blockquote>\n  <cite class=\"reveal\">\u2014 The Tidepool field notes, no. 3</cite>\n</section>\n\n<!-- CTA -->\n<section class=\"cta-band\" id=\"pricing\">\n  <div class=\"wrap\">\n    <div class=\"sec-label\" style=\"text-align:center\">Simple as water</div>\n    <h2 style=\"margin-left:auto;margin-right:auto\">Free for 30 days.<br>Then $4 per person, per month.</h2>\n    <p>No tiers, no seats math, no \"contact sales.\" If your team is small, the price is too. Cancel whenever the tide turns.</p>\n    <button class=\"btn btn-primary\" onclick=\"toast('You\\'re on the list \u2014 check your inbox for the invite.')\">Start your first week\n      <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M3 8h10M9 4l4 4-4 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n    </button>\n  </div>\n  <svg class=\"mini-wave\" viewBox=\"0 0 1440 80\" preserveAspectRatio=\"none\" height=\"60\"><path d=\"M0,50 C240,10 480,80 720,45 C960,10 1200,70 1440,35 L1440,80 L0,80 Z\" fill=\"#8FBDB4\"/></svg>\n</section>\n\n<footer>\n  <a class=\"logo\" href=\"#\">\n    <svg width=\"24\" height=\"24\" viewBox=\"0 0 26 26\" fill=\"none\">\n      <circle cx=\"13\" cy=\"13\" r=\"11.5\" stroke=\"#F6F1E7\" stroke-width=\"2\"/>\n      <path d=\"M4 15 Q8 11 13 15 T22 15\" stroke=\"#E4593F\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\"/>\n    </svg>\n    Tidepool\n  </a>\n  <div>\n    <a href=\"#flow\">The rhythm</a>\n    <a href=\"#demo\">Demo</a>\n    <a href=\"#\" onclick=\"toast('hello@tidepool.example \u2014 we read everything.');return false;\">Contact</a>\n  </div>\n</footer>\n\n<div class=\"toast\" id=\"toast\"></div>\n\n<script>\n/* ---------- Waves: mouse-reactive animated tide ---------- */\nconst waves=[\n  {el:document.getElementById('wave1'),amp:16,len:.0045,spd:.00018,base:150,ph:0},\n  {el:document.getElementById('wave2'),amp:22,len:.0032,spd:-.00025,base:190,ph:2},\n  {el:document.getElementById('wave3'),amp:28,len:.0022,spd:.00033,base:235,ph:4}\n];\nlet mouseX=null, mouseT=0;\naddEventListener('mousemove',e=>{mouseX=e.clientX});\nwaves.forEach(w=>{\n  w.path=w.el.querySelector('path');\n  w.path.setAttribute('fill',getComputedStyle(w.el).getPropertyValue('fill')||w.el.getAttribute('fill'));\n});\nfunction drawWave(w,t){\n  const W=1440,H=320;\n  // mouse influence: a bump centered at cursor x\n  const bump = mouseX===null?0:(mouseX/innerWidth*W);\n  let d='M0,'+(H);\n  let pts=[];\n  for(let x=0;x<=W;x+=20){\n    let y=w.base\n      + Math.sin(x*w.len + t*w.spd*1000 + w.ph)*w.amp\n      + Math.sin(x*w.len*1.7 + t*w.spd*1600)*w.amp*.4;\n    // gaussian bump toward mouse, pulling wave up/down\n    if(mouseX!==null){\n      const dx=x-bump;\n      y += Math.exp(-(dx*dx)/(2*90*90)) * Math.sin(t*.002+w.ph)*38;\n    }\n    pts.push([x,y]);\n  }\n  d='M'+pts.map(p=>p[0].toFixed(0)+','+p[1].toFixed(1)).join(' L');\n  d+=' L'+W+','+H+' L0,'+H+' Z';\n  w.path.setAttribute('d',d);\n}\nfunction loop(t){\n  waves.forEach(w=>drawWave(w,t));\n  requestAnimationFrame(loop);\n}\nrequestAnimationFrame(loop);\n\n/* ---------- Nav scroll state ---------- */\nconst nav=document.getElementById('nav');\naddEventListener('scroll',()=>nav.classList.toggle('scrolled',scrollY>40));\n\n/* ---------- Reveal on scroll ---------- */\nconst io=new IntersectionObserver(es=>es.forEach(e=>{\n  if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}\n}),{threshold:.15});\ndocument.querySelectorAll('.reveal').forEach(el=>io.observe(el));\n\n/* ---------- Toast ---------- */\nlet toastTimer;\nfunction toast(msg){\n  const t=document.getElementById('toast');\n  t.textContent=msg;t.classList.add('show');\n  clearTimeout(toastTimer);\n  toastTimer=setTimeout(()=>t.classList.remove('show'),3200);\n}\n\n/* ---------- Planner demo ---------- */\nconst days=['Monday','Tuesday','Wednesday','Thursday','Friday'];\nconst seed={\n  Monday:[\n    {t:'Design review \u2014 onboarding flow',w:'MAYA'},\n    {t:'Draft the launch email',w:'JON'},\n  ],\n  Tuesday:[\n    {t:'API: weekly digest endpoint',w:'PRIYA'},\n    {t:'User interviews (3 of 5)',w:'MAYA'},\n  ],\n  Wednesday:[\n    {t:'Pricing page copy v2',w:'JON'},\n    {t:'Fix drag-and-drop on Safari',w:'PRIYA'},\n    {t:'Onboarding illustration set',w:'MAYA'},\n  ],\n  Thursday:[\n    {t:'QA pass + release notes',w:'TOM'},\n  ],\n  Friday:[\n    {t:'Retro & next-week seeds',w:'TOM'},\n  ]\n};\nconst board=document.getElementById('board');\nfunction makeTask(d){\n  const el=document.createElement('div');\n  el.className='task'+(d.w==='YOU'?' mine':'');\n  el.draggable=true;\n  el.innerHTML=escape(d.t)+'<span class=\"who\">'+escape(d.w)+'</span>';\n  el.addEventListener('dragstart',()=>{\n    el.classList.add('dragging');\n    requestAnimationFrame(()=>el.remove());\n    dragPayload=el;\n  });\n  el.addEventListener('dragend',()=>{dragPayload=null});\n  return el;\n}\nfunction escape(s){const d=document.createElement('div');d.textContent=s;return d.innerHTML}\nlet dragPayload=null;\n\nObject.keys(seed).forEach((day,i)=>{\n  const col=document.createElement('div');\n  col.className='col';\n  col.innerHTML='<h4>'+day+'</h4>';\n  seed[day].forEach(d=>col.appendChild(makeTask(d)));\n  const add=document.createElement('button');\n  add.className='add-task';\n  add.textContent='+ add';\n  add.addEventListener('click',()=>{\n    const el=makeTask({t:'New intention',w:'YOU'});\n    col.insertBefore(el,add);\n    el.scrollIntoView({block:'nearest'});\n    toast('Dropped into your '+day.toLowerCase()+'. The tide accepts.');\n    setTimeout(()=>el.style.background='var(--paper)',50);\n    el.style.background='#FBE3DD';\n  });\n  col.appendChild(add);\n  col.addEventListener('dragover',e=>{e.preventDefault();col.classList.add('over')});\n  col.addEventListener('dragleave',()=>col.classList.remove('over'));\n  col.addEventListener('drop',e=>{\n    e.preventDefault();col.classList.remove('over');\n    if(dragPayload){col.insertBefore(dragPayload,col.lastElementChild)}\n  });\n  board.appendChild(col);\n});\n\n/* animate depth bars when flow section visible */\nconst depths=document.querySelectorAll('.flow-depth');\ndepths.forEach((bar,i)=>{\n  bar.style.transform='scaleX(0)';\n  const obs=new IntersectionObserver(es=>{\n    if(es[0].isIntersecting){\n      const target=[.85,1,.6,.3][i];\n      bar.style.transition='transform 1s cubic-bezier(.2,.8,.2,1) '+(i*.12)+'s';\n      bar.style.transform='scaleX('+target+')';\n      obs.disconnect();\n    }\n  },{threshold:.4});\n  obs.observe(bar);\n});\n</script>\n</body>\n</html>\n"}