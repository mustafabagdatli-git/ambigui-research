{"arm": "direct", "model": "anthropic/claude-haiku-5.5", "i": 3, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Tidepool: Plan your team's week together</title>\n  <meta name=\"description\" content=\"Tidepool helps small teams plan their week together in about ten minutes. Shared week view, async check-ins, and capacity signals.\">\n  <style>\n    :root {\n      --ink: #0f2a33;\n      --deep: #0b4f5c;\n      --tide: #1a7f8a;\n      --seafoam: #7fd1c4;\n      --foam: #e6f4f1;\n      --sand: #f6efe2;\n      --shell: #fffdf8;\n      --coral: #ff7a59;\n      --coral-dark: #e8613c;\n      --muted: #4d6670;\n      --line: #d7e6e2;\n      --radius: 16px;\n      --shadow: 0 1px 2px rgba(15,42,51,.06), 0 12px 32px rgba(15,42,51,.08);\n      --max: 1160px;\n    }\n\n    *, *::before, *::after { box-sizing: border-box; }\n    html { scroll-behavior: smooth; }\n    body {\n      margin: 0;\n      font-family: ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n      color: var(--ink);\n      background: var(--shell);\n      line-height: 1.6;\n      -webkit-font-smoothing: antialiased;\n    }\n    img, svg { display: block; max-width: 100%; }\n    a { color: var(--deep); text-decoration-thickness: 1px; text-underline-offset: 3px; }\n    a:focus-visible, button:focus-visible, summary:focus-visible {\n      outline: 3px solid var(--coral);\n      outline-offset: 3px;\n      border-radius: 6px;\n    }\n    h1, h2, h3 { line-height: 1.15; margin: 0 0 .5em; letter-spacing: -0.02em; }\n    h1 { font-size: clamp(2.5rem, 5.5vw, 4.25rem); font-weight: 800; }\n    h2 { font-size: clamp(1.9rem, 3.6vw, 2.75rem); font-weight: 800; }\n    h3 { font-size: 1.2rem; font-weight: 700; letter-spacing: -0.01em; }\n    p { margin: 0 0 1em; }\n    .wrap { width: min(var(--max), 100% - 2.5rem); margin-inline: auto; }\n    section { padding: clamp(4rem, 9vw, 7rem) 0; }\n    .eyebrow {\n      display: inline-block;\n      font-size: .8rem;\n      font-weight: 700;\n      letter-spacing: .12em;\n      text-transform: uppercase;\n      color: var(--tide);\n      margin-bottom: 1rem;\n    }\n    .lead { font-size: clamp(1.05rem, 1.6vw, 1.2rem); color: var(--muted); max-width: 40rem; }\n    .center { text-align: center; }\n    .center .lead { margin-inline: auto; }\n\n    /* Buttons */\n    .btn {\n      display: inline-flex;\n      align-items: center;\n      gap: .5rem;\n      padding: .9rem 1.4rem;\n      border-radius: 999px;\n      font: inherit;\n      font-weight: 700;\n      font-size: 1rem;\n      text-decoration: none;\n      border: 2px solid transparent;\n      cursor: pointer;\n      transition: transform .15s ease, background-color .15s ease, border-color .15s ease;\n    }\n    .btn:hover { transform: translateY(-1px); }\n    .btn-primary { background: var(--coral); color: #fff; }\n    .btn-primary:hover { background: var(--coral-dark); }\n    .btn-ghost { border-color: var(--deep); color: var(--deep); background: transparent; }\n    .btn-ghost:hover { background: var(--foam); }\n    .btn-light { background: #fff; color: var(--deep); }\n    .btn-light:hover { background: var(--foam); }\n\n    /* Nav */\n    .nav {\n      position: sticky;\n      top: 0;\n      z-index: 50;\n      background: rgba(255,253,248,.88);\n      backdrop-filter: blur(10px);\n      border-bottom: 1px solid var(--line);\n    }\n    .nav .wrap {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      height: 72px;\n    }\n    .brand {\n      display: flex;\n      align-items: center;\n      gap: .6rem;\n      font-weight: 800;\n      font-size: 1.2rem;\n      color: var(--ink);\n      text-decoration: none;\n    }\n    .nav-links { display: flex; align-items: center; gap: 2rem; list-style: none; margin: 0; padding: 0; }\n    .nav-links a { color: var(--ink); text-decoration: none; font-weight: 500; font-size: .95rem; }\n    .nav-links a:hover { color: var(--tide); }\n    .nav-cta { display: flex; align-items: center; gap: .75rem; }\n    .menu-toggle {\n      display: none;\n      background: none;\n      border: 1px solid var(--line);\n      border-radius: 10px;\n      padding: .5rem .7rem;\n      cursor: pointer;\n      color: var(--ink);\n      font: inherit;\n    }\n\n    /* Hero */\n    .hero {\n      position: relative;\n      overflow: hidden;\n      padding: clamp(3.5rem, 8vw, 6.5rem) 0 clamp(4rem, 8vw, 6rem);\n      background:\n        radial-gradient(900px 500px at 85% -10%, rgba(127,209,196,.45), transparent 60%),\n        radial-gradient(700px 500px at -10% 110%, rgba(255,122,89,.16), transparent 60%),\n        var(--shell);\n    }\n    .hero-grid {\n      display: grid;\n      grid-template-columns: 1.05fr .95fr;\n      gap: clamp(2rem, 5vw, 4rem);\n      align-items: center;\n    }\n    .hero h1 em { font-style: normal; color: var(--tide); }\n    .hero .lead { margin-bottom: 2rem; }\n    .hero-actions { display: flex; flex-wrap: wrap; gap: .85rem; align-items: center; }\n    .hero-note { margin-top: 1.25rem; font-size: .9rem; color: var(--muted); }\n    .hero-note strong { color: var(--ink); }\n\n    /* Board mockup */\n    .board {\n      background: var(--shell);\n      border: 1px solid var(--line);\n      border-radius: 20px;\n      box-shadow: var(--shadow);\n      padding: 1.1rem;\n      transform: rotate(1.2deg);\n    }\n    .board-head {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      padding: .25rem .25rem .9rem;\n      border-bottom: 1px solid var(--line);\n      margin-bottom: .9rem;\n    }\n    .board-head span { font-weight: 700; font-size: .95rem; }\n    .avatars { display: flex; }\n    .avatar {\n      width: 28px; height: 28px;\n      border-radius: 50%;\n      border: 2px solid #fff;\n      margin-left: -8px;\n      display: grid; place-items: center;\n      font-size: .7rem; font-weight: 700; color: #fff;\n    }\n    .avatar:first-child { margin-left: 0; }\n    .days {\n      display: grid;\n      grid-template-columns: repeat(5, 1fr);\n      gap: .5rem;\n    }\n    .day {\n      background: var(--sand);\n      border-radius: 12px;\n      padding: .5rem;\n      min-height: 230px;\n    }\n    .day-name {\n      font-size: .72rem;\n      font-weight: 800;\n      text-transform: uppercase;\n      letter-spacing: .08em;\n      color: var(--muted);\n      margin-bottom: .5rem;\n    }\n    .day.today { background: var(--foam); box-shadow: inset 0 0 0 2px var(--tide); }\n    .card {\n      background: #fff;\n      border-radius: 9px;\n      padding: .5rem .55rem;\n      font-size: .78rem;\n      line-height: 1.35;\n      margin-bottom: .4rem;\n      box-shadow: 0 1px 2px rgba(15,42,51,.08);\n      border-left: 3px solid var(--tide);\n    }\n    .card.coral { border-left-color: var(--coral); }\n    .card.sea { border-left-color: var(--seafoam); }\n    .card.deep { border-left-color: var(--deep); }\n    .card small { display: block; color: var(--muted); font-size: .68rem; margin-top: .15rem; }\n    .capacity {\n      margin-top: .9rem;\n      padding-top: .9rem;\n      border-top: 1px solid var(--line);\n      display: flex;\n      align-items: center;\n      gap: .75rem;\n      font-size: .82rem;\n      color: var(--muted);\n    }\n    .meter {\n      flex: 1;\n      height: 8px;\n      background: var(--foam);\n      border-radius: 99px;\n      overflow: hidden;\n    }\n    .meter span { display: block; height: 100%; width: 72%; background: linear-gradient(90deg, var(--tide), var(--seafoam)); border-radius: 99px; }\n    .float-tag {\n      position: absolute;\n      background: var(--ink);\n      color: #fff;\n      font-size: .8rem;\n      font-weight: 600;\n      padding: .5rem .8rem;\n      border-radius: 10px;\n      box-shadow: var(--shadow);\n    }\n    .hero-visual { position: relative; }\n    .float-tag.a { top: -14px; left: -12px; }\n    .float-tag.b { bottom: 20px; right: -14px; background: var(--coral); }\n\n    /* Logos / trust */\n    .trust {\n      border-block: 1px solid var(--line);\n      background: var(--sand);\n      padding: 1.5rem 0;\n    }\n    .trust p {\n      margin: 0;\n      text-align: center;\n      font-size: .9rem;\n      color: var(--muted);\n    }\n    .trust strong { color: var(--ink); }\n\n    /* Problem */\n    .problem-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 1.25rem;\n      margin-top: 3rem;\n    }\n    .problem {\n      padding: 1.75rem;\n      border-radius: var(--radius);\n      background: var(--shell);\n      border: 1px solid var(--line);\n    }\n    .problem .num {\n      font-size: 2.4rem;\n      font-weight: 800;\n      color: var(--coral);\n      line-height: 1;\n      margin-bottom: .75rem;\n    }\n    .problem p { color: var(--muted); margin: 0; }\n\n    /* How it works */\n    .how { background: var(--deep); color: #fff; }\n    .how .eyebrow { color: var(--seafoam); }\n    .how .lead { color: #bfe3dd; }\n    .steps {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 1.5rem;\n      margin-top: 3.5rem;\n      counter-reset: step;\n    }\n    .step {\n      position: relative;\n      padding: 2rem 1.75rem;\n      border-radius: var(--radius);\n      background: rgba(255,255,255,.06);\n      border: 1px solid rgba(255,255,255,.12);\n    }\n    .step::before {\n      counter-increment: step;\n      content: \"0\" counter(step);\n      display: inline-grid;\n      place-items: center;\n      width: 44px; height: 44px;\n      border-radius: 50%;\n      background: var(--seafoam);\n      color: var(--deep);\n      font-weight: 800;\n      margin-bottom: 1.25rem;\n    }\n    .step h3 { color: #fff; }\n    .step p { color: #bfe3dd; margin: 0; }\n\n    /* Features */\n    .features {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 1.25rem;\n      margin-top: 3rem;\n    }\n    .feature {\n      padding: 1.75rem;\n      border-radius: var(--radius);\n      border: 1px solid var(--line);\n      background: var(--shell);\n      transition: box-shadow .2s ease, transform .2s ease;\n    }\n    .feature:hover { box-shadow: var(--shadow); transform: translateY(-2px); }\n    .icon {\n      width: 44px; height: 44px;\n      border-radius: 12px;\n      background: var(--foam);\n      display: grid;\n      place-items: center;\n      margin-bottom: 1.1rem;\n    }\n    .icon svg { width: 22px; height: 22px; stroke: var(--deep); fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }\n    .feature p { color: var(--muted); margin: 0; font-size: .97rem; }\n\n    /* Split section (capacity) */\n    .split {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: clamp(2rem, 5vw, 4rem);\n      align-items: center;\n    }\n    .checklist { list-style: none; padding: 0; margin: 1.5rem 0 0; }\n    .checklist li {\n      position: relative;\n      padding-left: 2rem;\n      margin-bottom: .9rem;\n      color: var(--ink);\n    }\n    .checklist li::before {\n      content: \"\";\n      position: absolute;\n      left: 0; top: .35rem;\n      width: 16px; height: 16px;\n      border-radius: 50%;\n      background: var(--seafoam);\n      box-shadow: inset 0 0 0 4px var(--tide);\n    }\n    .panel {\n      background: var(--sand);\n      border-radius: 20px;\n      padding: 2rem;\n    }\n    .panel h3 { margin-bottom: 1.25rem; }\n    .person { margin-bottom: 1.1rem; }\n    .person-top {\n      display: flex;\n      justify-content: space-between;\n      font-size: .92rem;\n      font-weight: 600;\n      margin-bottom: .4rem;\n    }\n    .person-top span:last-child { color: var(--muted); font-weight: 500; }\n    .bar { height: 12px; background: #fff; border-radius: 99px; overflow: hidden; }\n    .bar i { display: block; height: 100%; border-radius: 99px; background: var(--tide); }\n    .bar i.warn { background: var(--coral); }\n    .bar i.light { background: var(--seafoam); }\n    .panel-note {\n      margin-top: 1.5rem;\n      padding: 1rem;\n      background: #fff;\n      border-radius: 12px;\n      font-size: .9rem;\n      color: var(--muted);\n    }\n\n    /* Testimonials */\n    .quotes {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 1.25rem;\n      margin-top: 3rem;\n    }\n    .quote {\n      margin: 0;\n      padding: 2rem;\n      border-radius: var(--radius);\n      background: var(--shell);\n      border: 1px solid var(--line);\n      display: flex;\n      flex-direction: column;\n      gap: 1.5rem;\n    }\n    .quote blockquote { margin: 0; font-size: 1.05rem; line-height: 1.55; }\n    .quote figcaption { font-size: .9rem; color: var(--muted); }\n    .quote figcaption strong { display: block; color: var(--ink); }\n\n    /* Pricing */\n    .pricing-toggle {\n      display: inline-flex;\n      background: var(--sand);\n      border-radius: 999px;\n      padding: 4px;\n      margin: 2rem auto 0;\n    }\n    .pricing-toggle button {\n      border: 0;\n      background: transparent;\n      padding: .55rem 1.1rem;\n      border-radius: 999px;\n      font: inherit;\n      font-weight: 600;\n      color: var(--muted);\n      cursor: pointer;\n    }\n    .pricing-toggle button[aria-pressed=\"true\"] { background: #fff; color: var(--ink); box-shadow: 0 1px 3px rgba(0,0,0,.08); }\n    .save { color: var(--coral-dark); font-size: .8rem; margin-left: .25rem; }\n    .tiers {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 1.25rem;\n      margin-top: 2.5rem;\n      align-items: stretch;\n    }\n    .tier {\n      padding: 2rem;\n      border-radius: var(--radius);\n      border: 1px solid var(--line);\n      background: var(--shell);\n      display: flex;\n      flex-direction: column;\n    }\n    .tier.featured {\n      border: 2px solid var(--tide);\n      box-shadow: var(--shadow);\n      position: relative;\n    }\n    .tier .badge {\n      position: absolute;\n      top: -13px;\n      left: 50%;\n      transform: translateX(-50%);\n      background: var(--coral);\n      color: #fff;\n      font-size: .75rem;\n      font-weight: 700;\n      padding: .3rem .8rem;\n      border-radius: 99px;\n      white-space: nowrap;\n    }\n    .tier .price { font-size: 2.6rem; font-weight: 800; letter-spacing: -0.03em; margin: .75rem 0 .25rem; }\n    .tier .price small { font-size: .95rem; font-weight: 500; color: var(--muted); letter-spacing: 0; }\n    .tier .desc { color: var(--muted); font-size: .95rem; margin-bottom: 1.5rem; }\n    .tier ul { list-style: none; padding: 0; margin: 0 0 2rem; flex: 1; }\n    .tier li { padding: .45rem 0 .45rem 1.6rem; position: relative; font-size: .95rem; }\n    .tier li::before {\n      content: \"\";\n      position: absolute;\n      left: 0; top: .9rem;\n      width: 10px; height: 6px;\n      border-left: 2px solid var(--tide);\n      border-bottom: 2px solid var(--tide);\n      transform: rotate(-45deg);\n    }\n    .tier .btn { justify-content: center; }\n\n    /* FAQ */\n    .faq { max-width: 760px; margin: 3rem auto 0; }\n    details {\n      border-bottom: 1px solid var(--line);\n      padding: 1.25rem 0;\n    }\n    details:first-child { border-top: 1px solid var(--line); }\n    summary {\n      cursor: pointer;\n      font-weight: 700;\n      list-style: none;\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      gap: 1rem;\n    }\n    summary::-webkit-details-marker { display: none; }\n    summary::after {\n      content: \"+\";\n      font-size: 1.5rem;\n      font-weight: 400;\n      color: var(--tide);\n      line-height: 1;\n    }\n    details[open] summary::after { content: \"\u2212\"; }\n    details p { color: var(--muted); margin: .9rem 0 0; }\n\n    /* Final CTA */\n    .final {\n      padding: clamp(3.5rem, 7vw, 5rem) 0;\n    }\n    .final-box {\n      border-radius: 28px;\n      padding: clamp(2.5rem, 6vw, 4.5rem);\n      background:\n        radial-gradient(600px 300px at 100% 0%, rgba(127,209,196,.5), transparent 70%),\n        linear-gradient(135deg, var(--deep), var(--tide));\n      color: #fff;\n      text-align: center;\n    }\n    .final-box h2 { color: #fff; max-width: 18ch; margin-inline: auto; }\n    .final-box p { color: #d4efea; max-width: 46ch; margin: 0 auto 2rem; font-size: 1.1rem; }\n    .final-form {\n      display: flex;\n      gap: .6rem;\n      justify-content: center;\n      flex-wrap: wrap;\n      max-width: 480px;\n      margin: 0 auto;\n    }\n    .final-form input {\n      flex: 1 1 260px;\n      padding: .9rem 1.1rem;\n      border-radius: 999px;\n      border: 2px solid transparent;\n      font: inherit;\n      color: var(--ink);\n      min-width: 0;\n    }\n    .final-form input:focus { outline: 3px solid var(--coral); outline-offset: 2px; }\n    .final-form .btn { flex: 0 0 auto; }\n    .final-small { font-size: .85rem; color: #b9e2db; margin-top: 1rem; margin-bottom: 0; }\n\n    /* Footer */\n    footer {\n      border-top: 1px solid var(--line);\n      padding: 3.5rem 0 2rem;\n      background: var(--sand);\n    }\n    .foot-grid {\n      display: grid;\n      grid-template-columns: 2fr 1fr 1fr 1fr;\n      gap: 2rem;\n    }\n    .foot-grid p { color: var(--muted); font-size: .95rem; max-width: 30ch; margin-top: .75rem; }\n    .foot-grid h4 {\n      font-size: .8rem;\n      text-transform: uppercase;\n      letter-spacing: .1em;\n      color: var(--muted);\n      margin: 0 0 1rem;\n    }\n    .foot-grid ul { list-style: none; margin: 0; padding: 0; }\n    .foot-grid li { margin-bottom: .6rem; }\n    .foot-grid a { color: var(--ink); text-decoration: none; font-size: .95rem; }\n    .foot-grid a:hover { color: var(--tide); }\n    .foot-bottom {\n      margin-top: 3rem;\n      padding-top: 1.5rem;\n      border-top: 1px solid var(--line);\n      display: flex;\n      justify-content: space-between;\n      flex-wrap: wrap;\n      gap: 1rem;\n      font-size: .85rem;\n      color: var(--muted);\n    }\n\n    /* Responsive */\n    @media (max-width: 960px) {\n      .hero-grid, .split { grid-template-columns: 1fr; }\n      .board { transform: none; }\n      .problem-grid, .features, .quotes, .tiers, .steps { grid-template-columns: 1fr; }\n      .tiers .tier.featured { order: -1; }\n      .foot-grid { grid-template-columns: 1fr 1fr; }\n      .float-tag.a { left: 8px; }\n      .float-tag.b { right: 8px; }\n    }\n    @media (min-width: 961px) and (max-width: 1100px) {\n      .problem-grid, .features, .quotes { grid-template-columns: repeat(2, 1fr); }\n    }\n    @media (max-width: 760px) {\n      .nav-links, .nav-cta .btn-ghost { display: none; }\n      .menu-toggle { display: inline-block; }\n      .nav.open .nav-links {\n        display: flex;\n        flex-direction: column;\n        position: absolute;\n        top: 72px; left: 0; right: 0;\n        background: var(--shell);\n        padding: 1.25rem 1.25rem 1.75rem;\n        border-bottom: 1px solid var(--line);\n        gap: 1.1rem;\n        align-items: flex-start;\n      }\n      .days { grid-template-columns: 1fr; }\n      .day { min-height: auto; }\n      .days .day:nth-child(n+4) { display: none; }\n      .foot-grid { grid-template-columns: 1fr; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      html { scroll-behavior: auto; }\n      *, *::before, *::after { transition: none !important; animation: none !important; }\n    }\n  </style>\n</head>\n<body>\n\n  <header class=\"nav\" id=\"nav\">\n    <div class=\"wrap\">\n      <a href=\"#top\" class=\"brand\" aria-label=\"Tidepool home\">\n        <svg width=\"28\" height=\"28\" viewBox=\"0 0 28 28\" aria-hidden=\"true\">\n          <circle cx=\"14\" cy=\"14\" r=\"13\" fill=\"#1a7f8a\"/>\n          <path d=\"M5 16c3-4 6-4 9 0s6 4 9 0\" stroke=\"#e6f4f1\" stroke-width=\"2.4\" fill=\"none\" stroke-linecap=\"round\"/>\n          <path d=\"M5 10.5c3-3 6-3 9 0s6 3 9 0\" stroke=\"#7fd1c4\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\"/>\n        </svg>\n        Tidepool\n      </a>\n      <ul class=\"nav-links\">\n        <li><a href=\"#how\">How it works</a></li>\n        <li><a href=\"#features\">Features</a></li>\n        <li><a href=\"#pricing\">Pricing</a></li>\n        <li><a href=\"#faq\">FAQ</a></li>\n      </ul>\n      <div class=\"nav-cta\">\n        <a href=\"#signup\" class=\"btn btn-ghost\" style=\"padding:.6rem 1.1rem;font-size:.95rem;\">Log in</a>\n        <a href=\"#signup\" class=\"btn btn-primary\" style=\"padding:.6rem 1.1rem;font-size:.95rem;\">Start free</a>\n        <button class=\"menu-toggle\" aria-expanded=\"false\" aria-controls=\"nav\" id=\"menuBtn\">Menu</button>\n      </div>\n    </div>\n  </header>\n\n  <main id=\"top\">\n\n    <!-- Hero -->\n    <section class=\"hero\" style=\"padding-bottom: clamp(4rem, 8vw, 6rem);\">\n      <div class=\"wrap hero-grid\">\n        <div>\n          <span class=\"eyebrow\">Weekly planning for small teams</span>\n          <h1>Plan your week <em>together</em>, in ten minutes.</h1>\n          <p class=\"lead\">Tidepool gives teams of two to twelve one shared view of the week. Everyone adds what they're doing, sees what's crowded, and starts Monday knowing what matters.</p>\n          <div class=\"hero-actions\">\n            <a href=\"#signup\" class=\"btn btn-primary\">Start planning free</a>\n            <a href=\"#how\" class=\"btn btn-ghost\">See how it works</a>\n          </div>\n          <p class=\"hero-note\"><strong>Free for teams up to five.</strong> No credit card, no setup call.</p>\n        </div>\n\n        <div class=\"hero-visual\" aria-label=\"Preview of a Tidepool weekly board\">\n          <span class=\"float-tag a\">3 people at capacity</span>\n          <div class=\"board\">\n            <div class=\"board-head\">\n              <span>Week of March 9</span>\n              <div class=\"avatars\" aria-hidden=\"true\">\n                <div class=\"avatar\" style=\"background:#0b4f5c\">JA</div>\n                <div class=\"avatar\" style=\"background:#1a7f8a\">MR</div>\n                <div class=\"avatar\" style=\"background:#ff7a59\">SK</div>\n                <div class=\"avatar\" style=\"background:#4d6670\">DL</div>\n              </div>\n            </div>\n            <div class=\"days\">\n              <div class=\"day\">\n                <div class=\"day-name\">Mon</div>\n                <div class=\"card\">Pricing page draft<small>Jordan</small></div>\n                <div class=\"card coral\">Client call prep<small>Sam</small></div>\n              </div>\n              <div class=\"day today\">\n                <div class=\"day-name\">Tue \u00b7 Today</div>\n                <div class=\"card deep\">Ship onboarding copy<small>Maya</small></div>\n                <div class=\"card sea\">Focus block (3h)<small>Dev</small></div>\n                <div class=\"card\">Review designs<small>Jordan</small></div>\n              </div>\n              <div class=\"day\">\n                <div class=\"day-name\">Wed</div>\n                <div class=\"card coral\">Launch checklist<small>Sam</small></div>\n              </div>\n              <div class=\"day\">\n                <div class=\"day-name\">Thu</div>\n                <div class=\"card\">Interview debrief<small>Maya</small></div>\n                <div class=\"card sea\">Carried from Mon<small>Dev</small></div>\n              </div>\n              <div class=\"day\">\n                <div class=\"day-name\">Fri</div>\n                <div class=\"card deep\">Weekly recap<small>Everyone</small></div>\n              </div>\n            </div>\n            <div class=\"capacity\">\n              <span>Team load</span>\n              <div class=\"meter\" role=\"img\" aria-label=\"Team load at 72 percent\"><span></span></div>\n              <span>72%</span>\n            </div>\n          </div>\n          <span class=\"float-tag b\">Plan saved in 9 min</span>\n        </div>\n      </div>\n    </section>\n\n    <!-- Trust -->\n    <div class=\"trust\">\n      <div class=\"wrap\">\n        <p>Built for teams of <strong>2 to 12 people</strong> who share work, not org charts. Used by product, design, operations, and agency crews.</p>\n      </div>\n    </div>\n\n    <!-- Problem -->\n    <section id=\"problem\">\n      <div class=\"wrap\">\n        <div class=\"center\">\n          <span class=\"eyebrow\">The problem</span>\n          <h2>Weekly planning shouldn't eat your Monday.</h2>\n          <p class=\"lead\">Small teams plan in fragments: a Slack thread here, a sticky note there, a standup that runs long. By Wednesday nobody remembers who owns what.</p>\n        </div>\n        <div class=\"problem-grid\">\n          <article class=\"problem\">\n            <div class=\"num\">3 tools</div>\n            <h3>Scattered context</h3>\n            <p>Tasks live in one app, priorities in another, and the real plan in a chat thread nobody can find on Thursday.</p>\n          </article>\n          <article class=\"problem\">\n            <div class=\"num\">2 hours</div>\n            <h3>Meetings to sync</h3>\n            <p>Planning meetings pull everyone out of deep work just to answer questions that could have been answered async.</p>\n          </article>\n          <article class=\"problem\">\n            <div class=\"num\">0 signals</div>\n            <h3>Hidden overload</h3>\n            <p>Nobody notices someone is double-booked until they miss a deadline. By then the week is already lost.</p>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <!-- How it works -->\n    <section class=\"how\" id=\"how\">\n      <div class=\"wrap\">\n        <div class=\"center\">\n          <span class=\"eyebrow\">How it works</span>\n          <h2>Three steps. Every Monday. Ten minutes.</h2>\n          <p class=\"lead\">Tidepool keeps the ritual short enough that people actually do it.</p>\n        </div>\n        <div class=\"steps\">\n          <article class=\"step\">\n            <h3>Gather</h3>\n            <p>Each person drops their commitments for the week onto the shared board. Takes a couple of minutes, no meeting required.</p>\n          </article>\n          <article class=\"step\">\n            <h3>Shape</h3>\n            <p>Drag work between days, flag what's blocked, and see the load bar update as you go. Tidepool warns you before anyone overcommits.</p>\n          </article>\n          <article class=\"step\">\n            <h3>Commit</h3>\n            <p>Lock the week with one click. Everyone gets a short summary, and unfinished items roll forward automatically on Friday.</p>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <!-- Features -->\n    <section id=\"features\">\n      <div class=\"wrap\">\n        <div class=\"center\">\n          <span class=\"eyebrow\">Features</span>\n          <h2>Everything a small team needs. Nothing it doesn't.</h2>\n          <p class=\"lead\">No Gantt charts, no story points, no twelve-tier permission matrix. Just a calm place to agree on the week.</p>\n        </div>\n        <div class=\"features\">\n          <article class=\"feature\">\n            <div class=\"icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M3 9h18M9 4v16\"/></svg>\n            </div>\n            <h3>Shared week view</h3>\n            <p>One board for the whole team, with each person's commitments visible by day. No more hunting for who's on what.</p>\n          </article>\n          <article class=\"feature\">\n            <div class=\"icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z\"/></svg>\n            </div>\n            <h3>Async check-ins</h3>\n            <p>Post a one-line update or a blocker without scheduling anything. Teammates reply when they're ready, on their own time.</p>\n          </article>\n          <article class=\"feature\">\n            <div class=\"icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M4 19V5M4 19h16M8 15v-4M12 15V8M16 15v-6\"/></svg>\n            </div>\n            <h3>Capacity signals</h3>\n            <p>See load per person and per day at a glance. Tidepool flags overbooked days before they become missed deadlines.</p>\n          </article>\n          <article class=\"feature\">\n            <div class=\"icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M3 12a9 9 0 1 0 3-6.7L3 8\"/><path d=\"M3 3v5h5\"/></svg>\n            </div>\n            <h3>Automatic carry-over</h3>\n            <p>Unfinished work rolls to the next week with its history intact, so nothing quietly disappears between Fridays.</p>\n          </article>\n          <article class=\"feature\">\n            <div class=\"icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><circle cx=\"12\" cy=\"12\" r=\"4\"/></svg>\n            </div>\n            <h3>Focus blocks</h3>\n            <p>Protect uninterrupted time on the calendar. Teammates can see when you're heads-down and plan around it.</p>\n          </article>\n          <article class=\"feature\">\n            <div class=\"icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M4 4h16v12H7l-3 3z\"/><path d=\"M8 9h8M8 12h5\"/></svg>\n            </div>\n            <h3>Friday recap</h3>\n            <p>A short written summary of what shipped, what slipped, and why, generated from the week and ready to share with stakeholders.</p>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <!-- Split: capacity -->\n    <section style=\"background: var(--shell); padding-top: 0;\">\n      <div class=\"wrap split\">\n        <div>\n          <span class=\"eyebrow\">Balance</span>\n          <h2>Know who's stretched before they tell you.</h2>\n          <p class=\"lead\">Tidepool reads the week and shows where effort is piling up. Rebalance in one drag instead of one difficult conversation.</p>\n          <ul class=\"checklist\">\n            <li>Load bars per person, updated as you plan</li>\n            <li>Warnings when a day or a teammate goes past comfortable</li>\n            <li>Suggested handoffs when someone else has room</li>\n          </ul>\n        </div>\n        <div class=\"panel\" role=\"img\" aria-label=\"Example team load: Jordan 85 percent, Maya 60 percent, Sam 95 percent, Dev 45 percent\">\n          <h3>This week's load</h3>\n          <div class=\"person\">\n            <div class=\"person-top\"><span>Jordan</span><span>85%</span></div>\n            <div class=\"bar\"><i style=\"width:85%\"></i></div>\n          </div>\n          <div class=\"person\">\n            <div class=\"person-top\"><span>Maya</span><span>60%</span></div>\n            <div class=\"bar\"><i class=\"light\" style=\"width:60%\"></i></div>\n          </div>\n          <div class=\"person\">\n            <div class=\"person-top\"><span>Sam</span><span>95% \u00b7 overloaded</span></div>\n            <div class=\"bar\"><i class=\"warn\" style=\"width:95%\"></i></div>\n          </div>\n          <div class=\"person\">\n            <div class=\"person-top\"><span>Dev</span><span>45%</span></div>\n            <div class=\"bar\"><i class=\"light\" style=\"width:45%\"></i></div>\n          </div>\n          <div class=\"panel-note\">\n            <strong style=\"color:var(--ink)\">Suggestion:</strong> Move \"Launch checklist\" from Sam to Dev. Dev has Thursday open.\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Testimonials -->\n    <section id=\"stories\" style=\"padding-top: 0;\">\n      <div class=\"wrap\">\n        <div class=\"center\">\n          <span class=\"eyebrow\">Stories</span>\n          <h2>Small teams, quieter Mondays.</h2>\n        </div>\n        <div class=\"quotes\">\n          <figure class=\"quote\">\n            <blockquote>\"We used to spend Monday morning reconstructing the week from six different threads. Now it takes ten minutes and everyone walks in knowing the plan.\"</blockquote>\n            <figcaption><strong>Priya N.</strong>Product lead, a five-person studio</figcaption>\n          </figure>\n          <figure class=\"quote\">\n            <blockquote>\"The capacity warning saved us twice last quarter. We moved work before anyone burned out, which had never happened before.\"</blockquote>\n            <figcaption><strong>Tom H.</strong>Operations manager, nine-person team</figcaption>\n          </figure>\n          <figure class=\"quote\">\n            <blockquote>\"Async check-ins replaced our Monday meeting entirely. I get three more hours of focus time, and nobody misses anything.\"</blockquote>\n            <figcaption><strong>Lena R.</strong>Design director, agency of seven</figcaption>\n          </figure>\n        </div>\n      </div>\n    </section>\n\n    <!-- Pricing -->\n    <section id=\"pricing\" style=\"background: var(--sand);\">\n      <div class=\"wrap\">\n        <div class=\"center\">\n          <span class=\"eyebrow\">Pricing</span>\n          <h2>Start free. Pay when the team grows.</h2>\n          <p class=\"lead\">Every plan includes the shared board, async check-ins, and the Friday recap.</p>\n          <div class=\"pricing-toggle\" role=\"group\" aria-label=\"Billing period\">\n            <button type=\"button\" aria-pressed=\"true\" data-billing=\"monthly\">Monthly</button>\n            <button type=\"button\" aria-pressed=\"false\" data-billing=\"annual\">Annual <span class=\"save\">save 20%</span></button>\n          </div>\n        </div>\n\n        <div class=\"tiers\">\n          <article class=\"tier\">\n            <h3>Starter</h3>\n            <p class=\"desc\">For a small crew getting into the habit.</p>\n            <div class=\"price\">Free</div>\n            <ul>\n              <li>Up to 5 people</li>\n              <li>One active team board</li>\n              <li>Async check-ins</li>\n              <li>30-day history</li>\n            </ul>\n            <a href=\"#signup\" class=\"btn btn-ghost\">Start free</a>\n          </article>\n\n          <article class=\"tier featured\">\n            <span class=\"badge\">Most popular</span>\n            <h3>Team</h3>\n            <p class=\"desc\">For growing teams that need load balancing.</p>\n            <div class=\"price\" data-price-monthly=\"$8\" data-price-annual=\"$6.50\">$8 <small>/ person / mo</small></div>\n            <ul>\n              <li>Up to 12 people</li>\n              <li>Capacity signals and suggestions</li>\n              <li>Automatic carry-over</li>\n              <li>Unlimited history</li>\n              <li>Calendar sync</li>\n            </ul>\n            <a href=\"#signup\" class=\"btn btn-primary\">Start 14-day trial</a>\n          </article>\n\n          <article class=\"tier\">\n            <h3>Studio</h3>\n            <p class=\"desc\">For multiple teams sharing one workspace.</p>\n            <div class=\"price\">Custom</div>\n            <ul>\n              <li>Unlimited teams</li>\n              <li>Admin controls and SSO</li>\n              <li>Cross-team view for leads</li>\n              <li>Priority support</li>\n            </ul>\n            <a href=\"#signup\" class=\"btn btn-ghost\">Talk to us</a>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <!-- FAQ -->\n    <section id=\"faq\">\n      <div class=\"wrap\">\n        <div class=\"center\">\n          <span class=\"eyebrow\">FAQ</span>\n          <h2>Questions, answered.</h2>\n        </div>\n        <div class=\"faq\">\n          <details>\n            <summary>How long does the weekly plan actually take?</summary>\n            <p>Most teams finish in ten minutes or less. Individual updates take about two minutes, and the shared review is quick because the load and conflicts are already flagged.</p>\n          </details>\n          <details>\n            <summary>Do we need everyone to be online at the same time?</summary>\n            <p>No. Check-ins and planning are asynchronous by default. You can still hold a short live meeting if you want one, but Tidepool doesn't require it.</p>\n          </details>\n          <details>\n            <summary>Does Tidepool replace our project management tool?</summary>\n            <p>Tidepool isn't a project tracker. It's the weekly layer on top: what each person is focused on this week. Most teams keep their existing tools and link tasks into Tidepool.</p>\n          </details>\n          <details>\n            <summary>How do capacity signals work?</summary>\n            <p>You set a comfortable weekly hour target for each person. Tidepool estimates load from the work they've committed to and shows warnings when a day or a week goes past that target. You can adjust estimates at any time.</p>\n          </details>\n          <details>\n            <summary>What happens to unfinished work on Friday?</summary>\n            <p>Anything not marked done rolls into the next week automatically, keeping its history and comments. You choose whether to carry it forward, drop it, or move it to a backlog.</p>\n          </details>\n          <details>\n            <summary>Can I export my data or cancel at any time?</summary>\n            <p>Yes. You can export every board as CSV or JSON at any point, and cancelling takes one click. Your data stays available for 30 days after you cancel.</p>\n          </details>\n        </div>\n      </div>\n    </section>\n\n    <!-- Final CTA -->\n    <section class=\"final\" id=\"signup\">\n      <div class=\"wrap\">\n        <div class=\"final-box\">\n          <h2>Make next Monday the easy one.</h2>\n          <p>Set up your team's first week in under five minutes. Free for up to five people.</p>\n          <form class=\"final-form\" action=\"#\" onsubmit=\"event.preventDefault(); this.querySelector('button').textContent='Check your inbox';\">\n            <label for=\"email\" class=\"sr-only\" style=\"position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);\">Work email</label>\n            <input id=\"email\" type=\"email\" placeholder=\"you@yourteam.com\" required autocomplete=\"email\">\n            <button type=\"submit\" class=\"btn btn-light\">Start planning free</button>\n          </form>\n          <p class=\"final-small\">No credit card required. Cancel or export anytime.</p>\n        </div>\n      </div>\n    </section>\n\n  </main>\n\n  <footer>\n    <div class=\"wrap\">\n      <div class=\"foot-grid\">\n        <div>\n          <a href=\"#top\" class=\"brand\" aria-label=\"Tidepool home\">\n            <svg width=\"24\" height=\"24\" viewBox=\"0 0 28 28\" aria-hidden=\"true\">\n              <circle cx=\"14\" cy=\"14\" r=\"13\" fill=\"#1a7f8a\"/>\n              <path d=\"M5 16c3-4 6-4 9 0s6 4 9 0\" stroke=\"#e6f4f1\" stroke-width=\"2.4\" fill=\"none\" stroke-linecap=\"round\"/>\n              <path d=\"M5 10.5c3-3 6-3 9 0s6 3 9 0\" stroke=\"#7fd1c4\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\"/>\n            </svg>\n            Tidepool\n          </a>\n          <p>A calmer way for small teams to plan the week ahead.</p>\n        </div>\n        <nav aria-label=\"Product\">\n          <h4>Product</h4>\n          <ul>\n            <li><a href=\"#features\">Features</a></li>\n            <li><a href=\"#pricing\">Pricing</a></li>\n            <li><a href=\"#how\">How it works</a></li>\n            <li><a href=\"#faq\">FAQ</a></li>\n          </ul>\n        </nav>\n        <nav aria-label=\"Company\">\n          <h4>Company</h4>\n          <ul>\n            <li><a href=\"#top\">About</a></li>\n            <li><a href=\"#top\">Blog</a></li>\n            <li><a href=\"#top\">Careers</a></li>\n            <li><a href=\"#top\">Contact</a></li>\n          </ul>\n        </nav>\n        <nav aria-label=\"Legal\">\n          <h4>Legal</h4>\n          <ul>\n            <li><a href=\"#top\">Privacy</a></li>\n            <li><a href=\"#top\">Terms</a></li>\n            <li><a href=\"#top\">Security</a></li>\n          </ul>\n        </nav>\n      </div>\n      <div class=\"foot-bottom\">\n        <span>\u00a9 2025 Tidepool. All rights reserved.</span>\n        <span>Made for teams that like Mondays a little less chaotic.</span>\n      </div>\n    </div>\n  </footer>\n\n  <script>\n    // Mobile menu toggle\n    (function () {\n      const nav = document.getElementById('nav');\n      const btn = document.getElementById('menuBtn');\n      btn.addEventListener('click', function () {\n        const open = nav.classList.toggle('open');\n        btn.setAttribute('aria-expanded', String(open));\n      });\n      nav.querySelectorAll('.nav-links a').forEach(function (link) {\n        link.addEventListener('click', function () {\n          nav.classList.remove('open');\n          btn.setAttribute('aria-expanded', 'false');\n        });\n      });\n    })();\n\n    // Monthly / annual pricing toggle\n    (function () {\n      const buttons = document.querySelectorAll('[data-billing]');\n      const prices = document.querySelectorAll('[data-price-monthly]');\n      buttons.forEach(function (b) {\n        b.addEventListener('click', function () {\n          const annual = b.dataset.billing === 'annual';\n          buttons.forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); });\n          prices.forEach(function (p) {\n            const amount = annual ? p.dataset.priceAnnual : p.dataset.priceMonthly;\n            p.innerHTML = amount + ' <small>/ person / mo</small>';\n          });\n        });\n      });\n    })();\n  </script>\n</body>\n</html>\n"}