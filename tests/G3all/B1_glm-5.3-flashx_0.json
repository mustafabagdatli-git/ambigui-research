(.78)}}\n  .art-label{font-family:'IBM Plex Mono',monospace;font-size:10.5px;fill:#5b6772;letter-spacing:.08em}\n  .art-cap{text-align:center;font-family:'IBM Plex Mono',monospace;font-size:.78rem;color:#5b6772;margin-top:10px;letter-spacing:.04em}\n  .art-cap b{color:var(--copper)}\n\n  /* ticker */\n  .ticker{background:var(--ink);color:var(--paper);overflow:hidden;border-bottom:2px solid var(--ink)}\n  .ticker-in{display:flex;width:max-content;animation:tick 26s linear infinite}\n  .ticker span{font-family:'IBM Plex Mono',monospace;font-size:.76rem;letter-spacing:.22em;text-transform:uppercase;padding:13px 0;white-space:nowrap}\n  .ticker i{font-style:normal;color:var(--copper-l);padding:0 18px}\n  @keyframes tick{to{transform:translateX(-50%)}}\n\n  /* sections */\n  section{padding:96px 0}\n  .sec-head{display:flex;align-items:baseline;justify-content:space-between;gap:30px;margin-bottom:52px;flex-wrap:wrap}\n  h2{font-family:'Fraunces',serif;font-weight:600;font-size:clamp(1.9rem,3.4vw,2.7rem);letter-spacing:-.01em;line-height:1.1}\n  .sec-head p{max-width:26rem;color:#3c4854}\n\n  /* services accordion */\n  .svc{border-top:2px solid var(--ink)}\n  .svc-row{border-bottom:1px solid var(--line)}\n  .svc-head{width:100%;display:grid;grid-template-columns:86px 1fr 44px;align-items:center;gap:18px;background:none;border:none;cursor:pointer;text-align:left;padding:26px 4px;font-family:inherit;color:var(--ink);transition:background .2s,padding .2s}\n  .svc-head:hover{background:var(--paper2)}\n  .svc-num{font-family:'Fraunces',serif;font-size:1.5rem;font-weight:400;color:#a09477;transition:color .2s}\n  .svc-row:hover .svc-num,.svc-row.open .svc-num{color:var(--copper)}\n  .svc-title{font-family:'Fraunces',serif;font-size:clamp(1.25rem,2.4vw,1.7rem);font-weight:600;letter-spacing:-.01em}\n  .svc-plus{width:34px;height:34px;border:2px solid var(--ink);display:flex;align-items:center;justify-content:center;transition:transform .35s,background .2s;justify-self:end}\n  .svc-plus svg{width:14px;height:14px;stroke:var(--ink);stroke-width:2.5}\n  .svc-row.open .svc-plus{transform:rotate(45deg);background:var(--ink)}\n  .svc-row.open .svc-plus svg{stroke:var(--paper)}\n  .svc-body{display:grid;grid-template-rows:0fr;transition:grid-template-rows .45s cubic-bezier(.4,0,.2,1)}\n  .svc-row.open .svc-body{grid-template-rows:1fr}\n  .svc-body-in{overflow:hidden}\n  .svc-body-grid{display:grid;grid-template-columns:86px 1fr;gap:18px;padding:0 4px 32px}\n  .svc-body p{max-width:36rem;color:#3c4854;margin-bottom:14px}\n  .svc-tags{display:flex;flex-wrap:wrap;gap:10px}\n  .svc-tags span{font-family:'IBM Plex Mono',monospace;font-size:.72rem;letter-spacing:.06em;border:1px solid var(--ink);padding:5px 12px}\n  .svc-price{font-family:'IBM Plex Mono',monospace;font-size:.78rem;color:var(--copper);margin-top:16px;letter-spacing:.04em}\n\n  /* family */\n  .family{background:var(--deep);color:var(--paper);position:relative;overflow:hidden}\n  .family .kicker{color:var(--copper-l)}\n  .family h2 em{font-style:italic;font-weight:400;color:var(--copper-l)}\n  .family .sec-head p{color:#b9c6c9}\n  .tl{position:relative;margin-top:26px;padding:34px 0 10px}\n  .tl-line{position:absolute;left:0;right:0;top:50%;height:2px;background:var(--copper)}\n  .tl-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:26px;position:relative}\n  .tl-item{position:relative;padding-top:34px}\n  .tl-item:nth-child(even){padding-top:0;padding-bottom:34px;transform:translateY(-100%);margin-bottom:-100%}\n  .tl-item::before{content:\"\";position:absolute;top:24px;left:2px;width:14px;height:14px;background:var(--paper);border:3px solid var(--copper);border-radius:50%}\n  .tl-item:nth-child(even)::before{top:auto;bottom:24px}\n  .tl-year{font-family:'IBM Plex Mono',monospace;font-size:.78rem;letter-spacing:.14em;color:var(--copper-l)}\n  .tl-name{font-family:'Fraunces',serif;font-size:1.45rem;font-weight:600;margin:6px 0 4px}\n  .tl-role{font-size:.82rem;text-transform:up