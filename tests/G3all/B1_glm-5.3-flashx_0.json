d var(--ink)}\n  .hd{display:flex;align-items:center;justify-content:space-between;height:74px}\n  .logo{display:flex;align-items:center;gap:12px;text-decoration:none;color:var(--ink)}\n  .logo strong{font-family:'Fraunces',serif;font-size:1.28rem;font-weight:700;letter-spacing:-.01em;display:block;line-height:1.05}\n  .logo small{font-family:'IBM Plex Mono',monospace;font-size:.66rem;letter-spacing:.14em;text-transform:uppercase;color:var(--copper)}\n  nav{display:flex;gap:30px;align-items:center}\n  nav a{color:var(--ink);text-decoration:none;font-weight:500;font-size:.95rem;border-bottom:2px solid transparent;padding-bottom:2px}\n  nav a:hover{border-color:var(--copper)}\n  .hd-phone{display:flex;align-items:center;gap:9px;text-decoration:none;color:var(--ink);font-weight:700;font-family:'Fraunces',serif;font-size:1.1rem;border:2px solid var(--ink);padding:9px 16px;background:var(--paper);transition:.18s}\n  .hd-phone:hover{background:var(--ink);color:var(--paper)}\n  .hd-phone svg{width:17px;height:17px;fill:currentColor}\n  @media(max-width:840px){nav{display:none}}\n\n  /* buttons */\n  .btn{display:inline-flex;align-items:center;gap:10px;text-decoration:none;font-weight:700;font-size:1rem;padding:15px 26px;border:2px solid var(--ink);cursor:pointer;font-family:'Karla',sans-serif;transition:.18s}\n  .btn-solid{background:var(--ink);color:var(--paper)}\n  .btn-solid:hover{transform:translate(-3px,-3px);box-shadow:5px 5px 0 var(--copper)}\n  .btn-out{background:transparent;color:var(--ink)}\n  .btn-out:hover{background:var(--ink);color:var(--paper)}\n  .btn-out svg{width:18px;height:18px;fill:currentColor}\n\n  /* hero */\n  .hero{padding:72px 0 66px;border-bottom:2px solid var(--ink)}\n  .hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:56px;align-items:center}\n  .kicker{font-family:'IBM Plex Mono',monospace;font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;color:var(--copper);display:flex;align-items:center;gap:12px;margin-bottom:22p