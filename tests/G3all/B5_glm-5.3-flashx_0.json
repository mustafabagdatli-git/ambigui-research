{"brief": "B5", "model": "z-ai/glm-5.3-flashx", "i": 0, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Meridian Health \u2014 Walk-in Sexual Health Clinic</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&family=Karla:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --paper:#f7f3ec;\n    --ink:#21281f;\n    --moss:#2e4a3a;\n    --clay:#c2502e;\n    --clay-dark:#9e3d21;\n    --sand:#ece5d8;\n    --line:#d8cfbe;\n    --serif:'Fraunces',serif;\n    --sans:'Karla',sans-serif;\n  }\n  *{margin:0;padding:0;box-sizing:border-box}\n  html{scroll-behavior:smooth}\n  body{\n    background:var(--paper);\n    color:var(--ink);\n    font-family:var(--sans);\n    font-size:17px;\n    line-height:1.6;\n    -webkit-font-smoothing:antialiased;\n  }\n  ::selection{background:var(--clay);color:var(--paper)}\n\n  /* ---------- top strip ---------- */\n  .strip{\n    background:var(--moss);\n    color:#e9e4d5;\n    font-size:13.5px;\n    letter-spacing:.04em;\n    text-align:center;\n    padding:9px 16px;\n  }\n  .strip strong{color:#fff}\n\n  /* ---------- header ---------- */\n  header{\n    display:flex;align-items:center;justify-content:space-between;\n    padding:22px 5vw;\n    border-bottom:1px solid var(--line);\n    position:sticky;top:0;background:rgba(247,243,236,.92);\n    backdrop-filter:blur(8px);z-index:50;\n  }\n  .logo{display:flex;align-items:center;gap:11px;text-decoration:none;color:var(--ink)}\n  .logo svg{display:block}\n  .logo span{font-family:var(--serif);font-size:21px;font-weight:500;letter-spacing:.01em}\n  nav{display:flex;gap:30px;align-items:center}\n  nav a{\n    color:var(--ink);text-decoration:none;font-size:15px;font-weight:500;\n    border-bottom:1.5px solid transparent;padding-bottom:2px;transition:border-color .2s;\n  }\n  nav a:hover{border-color:var(--clay)}\n  @media(max-width:760px){nav a:not(.btn){display:none}}\n\n  .btn{\n    display:inline-block;background:var(--clay);color:#fff;text-decoration:none;\n    padding:11px 24px;border-radius:99px;font-weight:600;font-size:15.5px;\n    border:none;cursor:pointer;font-family:var(--sans);\n    transition:background .2s, transform .15s;\n  }\n  .btn:hover{background:var(--clay-dark);transform:translateY(-1px)}\n  .btn-ghost{\n    background:transparent;color:var(--ink);border:1.5px solid var(--ink);\n  }\n  .btn-ghost:hover{background:var(--ink);color:var(--paper)}\n\n  /* ---------- hero ---------- */\n  .hero{\n    padding:80px 5vw 70px;\n    display:grid;grid-template-columns:1.35fr .9fr;gap:60px;align-items:end;\n    border-bottom:1px solid var(--line);\n  }\n  @media(max-width:900px){.hero{grid-template-columns:1fr;gap:44px;padding-top:56px}}\n  .kicker{\n    font-size:13px;letter-spacing:.22em;text-transform:uppercase;\n    color:var(--clay);font-weight:700;margin-bottom:26px;\n    display:flex;align-items:center;gap:12px;\n  }\n  .kicker::before{content:\"\";width:34px;height:1.5px;background:var(--clay)}\n  h1{\n    font-family:var(--serif);font-weight:400;\n    font-size:clamp(40px,5.6vw,72px);\n    line-height:1.06;letter-spacing:-.015em;\n  }\n  h1 em{font-style:italic;color:var(--moss)}\n  .hero p.lede{\n    margin-top:26px;max-width:52ch;font-size:18.5px;color:#4a4f45;\n  }\n  .hero-cta{margin-top:36px;display:flex;gap:16px;flex-wrap:wrap;align-items:center}\n  .hero-cta .micro{font-size:14px;color:#6b6f64}\n\n  /* hours card */\n  .hours-card{\n    background:var(--sand);border:1px solid var(--line);border-radius:6px;\n    padding:34px 34px 28px;position:relative;\n  }\n  .hours-card::before{\n    content:\"\";position:absolute;inset:8px;border:1px dashed var(--line);\n    border-radius:3px;pointer-events:none;\n  }\n  .status{display:flex;align-items:center;gap:9px;font-weight:700;font-size:14px;letter-spacing:.06em;text-transform:uppercase}\n  .dot{width:10px;height:10px;border-radius:50%;background:var(--moss);position:relative}\n  .dot::after{\n    content:\"\";position:absolute;inset:-5px;border-radius:50%;\n    border:1.5px solid var(--moss);opacity:.5;animation:pulse 2s infinite;\n  }\n  @keyframes pulse{0%{transform:scale(.7);opacity:.6}100%{transform:scale(1.4);opacity:0}}\n  .hours-card h3{font-family:var(--serif);font-size:26px;font-weight:500;margin:14px 0 18px}\n  .hours-card table{width:100%;border-collapse:collapse;font-size:15.5px}\n  .hours-card td{padding:7px 0;border-bottom:1px solid var(--line)}\n  .hours-card td:last-child{text-align:right;font-weight:600}\n  .today td{color:var(--clay);font-weight:700}\n  .hours-card .addr{\n    margin-top:18px;font-size:14.5px;color:#5b6055;display:flex;gap:9px;align-items:flex-start;\n  }\n\n  /* ---------- ticker ---------- */\n  .ticker{\n    background:var(--moss);color:#e9e4d5;overflow:hidden;white-space:nowrap;\n    padding:13px 0;border-bottom:1px solid var(--line);\n  }\n  .ticker-inner{display:inline-block;animation:scroll 30s linear infinite}\n  .ticker span{\n    font-family:var(--serif);font-style:italic;font-size:17px;margin:0 34px;\n  }\n  .ticker b{color:#fff;font-weight:500}\n  @keyframes scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}\n\n  /* ---------- sections ---------- */\n  section{padding:88px 5vw}\n  .sec-head{max-width:760px;margin-bottom:54px}\n  .sec-head h2{\n    font-family:var(--serif);font-weight:400;\n    font-size:clamp(30px,3.6vw,46px);line-height:1.12;letter-spacing:-.01em;\n  }\n  .sec-head p{margin-top:16px;color:#4a4f45;font-size:17.5px}\n\n  /* services */\n  .svc-list{border-top:1.5px solid var(--ink)}\n  .svc{\n    display:grid;grid-template-columns:64px 1fr 1.1fr auto;gap:26px;align-items:center;\n    padding:26px 6px;border-bottom:1.5px solid var(--ink);\n    transition:background .2s,padding-left .25s;\n  }\n  .svc:hover{background:var(--sand);padding-left:18px}\n  .svc .num{font-family:var(--serif);font-style:italic;font-size:19px;color:var(--clay)}\n  .svc h3{font-family:var(--serif);font-weight:500;font-size:24px}\n  .svc p{font-size:15.5px;color:#5b6055}\n  .svc .tag{\n    font-size:12.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;\n    border:1.5px solid var(--ink);border-radius:99px;padding:5px 14px;white-space:nowrap;\n    justify-self:end;\n  }\n  .svc .tag.free{border-color:var(--moss);color:var(--moss)}\n  @media(max-width:820px){\n    .svc{grid-template-columns:44px 1fr;row-gap:8px}\n    .svc p{grid-column:2}\n    .svc .tag{grid-column:2;justify-self:start}\n  }\n\n  /* reassurance band */\n  .reassure{\n    background:var(--moss);color:#e9e4d5;\n    display:grid;grid-template-columns:repeat(3,1fr);gap:1px;\n  }\n  @media(max-width:820px){.reassure{grid-template-columns:1fr}}\n  .reassure .cell{\n    padding:56px 44px;border-right:1px solid rgba(233,228,213,.18);\n  }\n  .reassure .cell:last-child{border-right:none}\n  .reassure svg{margin-bottom:20px}\n  .reassure h3{font-family:var(--serif);font-size:23px;font-weight:500;color:#fff;margin-bottom:10px}\n  .reassure p{font-size:15.5px;color:#c9c4b2;line-height:1.65}\n\n  /* what to expect */\n  .expect{display:grid;grid-template-columns:repeat(4,1fr);gap:34px}\n  @media(max-width:960px){.expect{grid-template-columns:repeat(2,1fr)}}\n  @media(max-width:560px){.expect{grid-template-columns:1fr}}\n  .step{border-top:2px solid var(--clay);padding-top:20px}\n  .step .n{\n    font-family:var(--serif);font-size:44px;font-weight:300;color:var(--clay);line-height:1;\n  }\n  .step h4{font-family:var(--serif);font-size:20px;font-weight:500;margin:14px 0 8px}\n  .step p{font-size:15px;color:#5b6055}\n\n  /* FAQ */\n  .faq{max-width:820px}\n  details{\n    border-bottom:1.5px solid var(--ink);padding:0 4px;\n  }\n  details:first-of-type{border-top:1.5px solid var(--ink)}\n  summary{\n    cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;\n    gap:20px;padding:24px 4px;font-family:var(--serif);font-size:21px;font-weight:500;\n    transition:color .2s;\n  }\n  summary::-webkit-details-marker{display:none}\n  summary:hover{color:var(--clay)}\n  summary .plus{\n    flex:none;width:30px;height:30px;border:1.5px solid var(--ink);border-radius:50%;\n    position:relative;transition:transform .25s,border-color .2s;\n  }\n  summary .plus::before,summary .plus::after{\n    content:\"\";position:absolute;background:currentColor;top:50%;left:50%;\n    transform:translate(-50%,-50%);\n  }\n  summary .plus::before{width:12px;height:1.5px}\n  summary .plus::after{width:1.5px;height:12px;transition:opacity .2s}\n  details[open] .plus{transform:rotate(45deg);border-color:var(--clay)}\n  details p{padding:0 4px 26px;max-width:64ch;color:#4a4f45;font-size:16px}\n\n  /* final CTA */\n  .final{\n    background:var(--clay);color:#fff;text-align:center;padding:100px 5vw;\n  }\n  .final h2{\n    font-family:var(--serif);font-weight:400;font-size:clamp(34px,4.6vw,58px);\n    line-height:1.1;max-width:18ch;margin:0 auto;\n  }\n  .final p{margin:22px auto 36px;max-width:52ch;color:#fbe3d8;font-size:17.5px}\n  .final .btn{background:#fff;color:var(--clay-dark)}\n  .final .btn:hover{background:var(--sand);transform:translateY(-1px)}\n  .final .micro{color:#f6cdbb}\n\n  footer{\n    background:var(--paper);padding:44px 5vw;display:flex;flex-wrap:wrap;gap:24px;\n    justify-content:space-between;align-items:center;border-top:1px solid var(--line);\n    font-size:14px;color:#6b6f64;\n  }\n  footer .f-links{display:flex;gap:22px}\n  footer a{color:var(--ink);text-decoration:none;border-bottom:1px solid var(--line)}\n  footer a:hover{border-color:var(--clay)}\n</style>\n</head>\n<body>\n\n<div class=\"strip\">Open today until <strong>8:00 pm</strong> \u00b7 No appointment needed \u00b7 No insurance required \u00b7 Free parking behind the building</div>\n\n<header>\n  <a class=\"logo\" href=\"#\">\n    <svg width=\"30\" height=\"30\" viewBox=\"0 0 30 30\" fill=\"none\">\n      <circle cx=\"15\" cy=\"15\" r=\"13.5\" stroke=\"#c2502e\" stroke-width=\"2\"/>\n      <path d=\"M15 7 C10 12, 10 18, 15 23 C20 18, 20 12, 15 7 Z\" stroke=\"#2e4a3a\" stroke-width=\"2\" fill=\"none\"/>\n    </svg>\n    <span>Meridian Health</span>\n  </a>\n  <nav>\n    <a href=\"#services\">Services</a>\n    <a href=\"#expect\">Your visit</a>\n    <a href=\"#faq\">Questions</a>\n    <a class=\"btn\" href=\"#visit\">Plan your visit</a>\n  </nav>\n</header>\n\n<main>\n  <!-- HERO -->\n  <section class=\"hero\" id=\"visit\">\n    <div>\n      <div class=\"kicker\">Walk-in sexual health clinic</div>\n      <h1>Walk in. No appointment.<br>No paperwork gauntlet.<br><em>No judgment, ever.</em></h1>\n      <p class=\"lede\">Testing, treatment, contraception, and honest answers \u2014 usually in under an hour. Everyone is welcome, everything is confidential, and most services are completely free.</p>\n      <div class=\"hero-cta\">\n        <a class=\"btn\" href=\"#hours\">See today's hours</a>\n        <a class=\"btn btn-ghost\" href=\"#services\">Browse services</a>\n        <span class=\"micro\">Average wait right now: ~15 min</span>\n      </div>\n    </div>\n    <aside class=\"hours-card\" id=\"hours\">\n      <div class=\"status\"><span class=\"dot\"></span> Open now \u00b7 Walk-ins welcome</div>\n      <h3>This week's hours</h3>\n      <table>\n        <tr class=\"today\"><td>Today \u2014 Thursday</td><td>9 am \u2013 8 pm</td></tr>\n        <tr><td>Friday</td><td>9 am \u2013 8 pm</td></tr>\n        <tr><td>Saturday</td><td>10 am \u2013 4 pm</td></tr>\n        <tr><td>Sunday</td><td>Closed</td></tr>\n        <tr><td>Monday \u2013 Wednesday</td><td>9 am \u2013 8 pm</td></tr>\n      </table>\n      <div class=\"addr\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" style=\"flex:none;margin-top:3px\">\n          <path d=\"M8 14.5s5-4.6 5-8.3A5 5 0 0 0 3 6.2c0 3.7 5 8.3 5 8.3Z\" stroke=\"#5b6055\" stroke-width=\"1.4\"/>\n          <circle cx=\"8\" cy=\"6.2\" r=\"1.7\" stroke=\"#5b6055\" stroke-width=\"1.4\"/>\n        </svg>\n        <span>412 Alder Street, Suite 2 \u2014 ground floor, step-free entrance, two blocks from Central Station.</span>\n      </div>\n    </aside>\n  </section>\n\n  <!-- TICKER -->\n  <div class=\"ticker\" aria-hidden=\"true\">\n    <div class=\"ticker-inner\">\n      <span>Free STI testing</span><b>\u00b7</b><span>Results by text in 3\u20135 days</span><b>\u00b7</b><span>Contraception, same day</span><b>\u00b7</b><span>All genders, all identities</span><b>\u00b7</b><span>No ID? No problem</span><b>\u00b7</b><span>Interpreters available</span><b>\u00b7</b>\n      <span>Free STI testing</span><b>\u00b7</b><span>Results by text in 3\u20135 days</span><b>\u00b7</b><span>Contraception, same day</span><b>\u00b7</b><span>All genders, all identities</span><b>\u00b7</b><span>No ID? No problem</span><b>\u00b7</b><span>Interpreters available</span><b>\u00b7</b>\n    </div>\n  </div>\n\n  <!-- SERVICES -->\n  <section id=\"services\">\n    <div class=\"sec-head\">\n      <h2>What we do, in plain words.</h2>\n      <p>No euphemisms, no forms written in medical Latin. Here's exactly what you can walk in for \u2014 and what it costs.</p>\n    </div>\n    <div class=\"svc-list\">\n      <div class=\"svc\">\n        <span class=\"num\">01</span>\n        <h3>STI &amp; HIV testing</h3>\n        <p>Urine, swab, or a quick blood draw. Most results back by text within 3\u20135 days; rapid HIV in 20 minutes.</p>\n        <span class=\"tag free\">Free</span>\n      </div>\n      <div class=\"svc\">\n        <span class=\"num\">02</span>\n        <h3>Treatment &amp; prescriptions</h3>\n        <p>If something comes back, we treat it the same visit whenever possible \u2014 no second trip, no referral maze.</p>\n        <span class=\"tag free\">Free</span>\n      </div>\n      <div class=\"svc\">\n        <span class=\"num\">03</span>\n        <h3>Contraception</h3>\n        <p>Pills, implants, IUDs, injections, emergency contraception. Fit, refit, or switch \u2014 decided with you, not for you.</p>\n        <span class=\"tag free\">Free</span>\n      </div>\n      <div class=\"svc\">\n        <span class=\"num\">04</span>\n        <h3>PrEP &amp; PEP</h3>\n        <p>HIV prevention medication, started the day you ask. PEP works best within 72 hours \u2014 come straight in.</p>\n        <span class=\"tag free\">Free</span>\n      </div>\n      <div class=\"svc\">\n        <span class=\"num\">05</span>\n        <h3>Vaccinations</h3>\n        <p>HPV and hepatitis A/B shots on the spot, whether or not you've had them somewhere else.</p>\n        <span class=\"tag\">Low cost</span>\n      </div>\n      <div class=\"svc\">\n        <span class=\"num\">06</span>\n        <h3>Someone to talk to</h3>\n        <p>Worried about a symptom, a situation, or a relationship? Our counsellors are here for exactly that.</p>\n        <span class=\"tag free\">Free</span>\n      </div>\n    </div>\n  </section>\n\n  <!-- REASSURANCE -->\n  <div class=\"reassure\">\n    <div class=\"cell\">\n      <svg width=\"34\" height=\"34\" viewBox=\"0 0 34 34\" fill=\"none\">\n        <rect x=\"7\" y=\"15\" width=\"20\" height=\"14\" rx=\"2.5\" stroke=\"#e9e4d5\" stroke-width=\"1.8\"/>\n        <path d=\"M12 15v-4a5 5 0 0 1 10 0v4\" stroke=\"#e9e4d5\" stroke-width=\"1.8\"/>\n        <circle cx=\"17\" cy=\"22\" r=\"2\" fill=\"#c2502e\"/>\n      </svg>\n      <h3>Confidential, by law and by habit</h3>\n      <p>Nothing leaves the building. We never contact you without your permission, and results go only to the number or address you choose.</p>\n    </div>\n    <div class=\"cell\">\n      <svg width=\"34\" height=\"34\" viewBox=\"0 0 34 34\" fill=\"none\">\n        <circle cx=\"12\" cy=\"12\" r=\"5\" stroke=\"#e9e4d5\" stroke-width=\"1.8\"/>\n        <circle cx=\"22\" cy=\"12\" r=\"5\" stroke=\"#e9e4d5\" stroke-width=\"1.8\"/>\n        <path d=\"M6 27c1-4 4-6 6-6s5 2 6 6M22 21c2 0 5 2 6 6\" stroke=\"#c2502e\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n      </svg>\n      <h3>Everyone means everyone</h3>\n      <p>All genders, orientations, relationships, and immigration statuses. Under 18? You can be seen on your own terms, confidentially.</p>\n    </div>\n    <div class=\"cell\">\n      <svg width=\"34\" height=\"34\" viewBox=\"0 0 34 34\" fill=\"none\">\n        <path d=\"M17 30s-12-6.5-12-15a6.5 6.5 0 0 1 12-3.5A6.5 6.5 0 0 1 29 15c0 8.5-12 15-12 15Z\" stroke=\"#e9e4d5\" stroke-width=\"1.8\"/>\n      </svg>\n      <h3>No insurance, no barrier</h3>\n      <p>We don't ask for proof of income, insurance, or ID for core services. If money is ever the reason you'd skip care, tell us \u2014 we'll sort it.</p>\n    </div>\n  </div>\n\n  <!-- EXPECT -->\n  <section id=\"expect\">\n    <div class=\"sec-head\">\n      <h2>Your first visit, step by step.</h2>\n      <p>Knowing what happens at the door makes the door a lot easier to walk through.</p>\n    </div>\n    <div class=\"expect\">\n      <div class=\"step\">\n        <div class=\"n\">1</div>\n        <h4>Check in at the desk</h4>\n        <p>First name and a way to reach you. That's genuinely the whole form \u2014 under two minutes.</p>\n      </div>\n      <div class=\"step\">\n        <div class=\"n\">2</div>\n        <h4>A short chat</h4>\n        <p>A nurse asks a few private questions so you get the right tests. You can bring someone in with you.</p>\n      </div>\n      <div class=\"step\">\n        <div class=\"n\">3</div>\n        <h4>The tests</h4>\n        <p>Most people only need a urine sample or a self-taken swab \u2014 you do those yourself, in private.</p>\n      </div>\n      <div class=\"step\">\n        <div class=\"n\">4</div>\n        <h4>Results &amp; next steps</h4>\n        <p>By text, in your own words, with treatment booked same-day if anything needs it.</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- FAQ -->\n  <section id=\"faq\">\n    <div class=\"sec-head\"><h2>The questions people are too nervous to ask.</h2></div>\n    <div class=\"faq\">\n      <details>\n        <summary>Will anyone know I was here?<span class=\"plus\"></span></summary>\n        <p>No. We don't confirm attendance to anyone \u2014 including family, partners, employers, or other clinics \u2014 without your written consent. Our billing, if there is any, appears under a discreet general health practice name.</p>\n      </details>\n      <details>\n        <summary>How long will I actually be there?<span class=\"plus\"></span></summary>\n        <p>A typical testing visit takes 30\u201350 minutes door to door. Busy periods are weekday lunchtimes and Saturday mornings; early afternoons are quietest.</p>\n      </details>\n      <details>\n        <summary>I don't have symptoms. Should I still get tested?<span class=\"plus\"></span></summary>\n        <p>Yes \u2014 most STIs cause no symptoms at all, which is exactly why routine testing is recommended every 3\u20136 months if you're sexually active with new or multiple partners.</p>\n      </details>\n      <details>\n        <summary>Can I come if I'm under 18?<span class=\"plus\"></span></summary>\n        <p>Absolutely. Young people can consent to sexual health care on their own, and that care stays confidential. Our staff are trained to support you without lecturing you.</p>\n      </details>\n      <details>\n        <summary>What if a test comes back positive?<span class=\"plus\"></span></summary>\n        <p>Most infections are cleared with a short course of treatment, often a single dose. We treat you the same visit when possible, answer every question, and help you tell partners safely and anonymously if you want us to.</p>\n      </details>\n    </div>\n  </section>\n\n  <!-- FINAL CTA -->\n  <div class=\"final\">\n    <h2>The hardest part is the parking lot. We handle the rest.</h2>\n    <p>412 Alder Street, Suite 2 \u00b7 Open today until 8 pm \u00b7 Step-free entrance, private side door if you'd rather skip the waiting room.</p>\n    <a class=\"btn\" href=\"#hours\">Plan your walk-in</a>\n    <p class=\"micro\" style=\"margin-top:20px;font-size:14px\">In urgent distress? Call our nurse line: (555) 014-8200 \u2014 staffed whenever we're open.</p>\n  </div>\n</main>\n\n<footer>\n  <span>\u00a9 2025 Meridian Health Clinic \u00b7 412 Alder Street, Suite 2</span>\n  <div class=\"f-links\">\n    <a href=\"#faq\">Privacy</a>\n    <a href=\"#faq\">Accessibility</a>\n    <a href=\"#faq\">Contact</a>\n  </div>\n</footer>\n\n</body>\n</html>\n"}