{"brief": "B6", "model": "anthropic/claude-haiku-5.5", "i": 1, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Kickstand Skate Co. | Shop, Ride, Learn</title>\n<meta name=\"description\" content=\"Decks, trucks, wheels and beginner-friendly skate lessons. Learn to skate or level up your riding at Kickstand Skate Co.\">\n<style>\n  :root {\n    --asphalt: #0d0e11;\n    --asphalt-2: #15171c;\n    --asphalt-3: #1f2229;\n    --line: #2a2e37;\n    --paper: #f4f1ea;\n    --muted: #9aa0ab;\n    --acid: #d7ff3a;\n    --coral: #ff5a4e;\n    --sky: #4fc3f7;\n    --radius: 14px;\n    --display: Impact, \"Arial Black\", \"Helvetica Neue\", sans-serif;\n    --body: system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n  }\n\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  html { scroll-behavior: smooth; }\n  body {\n    font-family: var(--body);\n    background: var(--asphalt);\n    color: var(--paper);\n    line-height: 1.6;\n    -webkit-font-smoothing: antialiased;\n    overflow-x: hidden;\n  }\n  img, svg { display: block; max-width: 100%; }\n  a { color: inherit; text-decoration: none; }\n  h1, h2, h3, h4 { font-family: var(--display); font-weight: 400; letter-spacing: .02em; line-height: 1.05; text-transform: uppercase; }\n  .container { width: min(1180px, 92%); margin: 0 auto; }\n  section { padding: 96px 0; position: relative; }\n  .eyebrow {\n    display: inline-block;\n    font: 700 13px/1 var(--body);\n    letter-spacing: .18em;\n    text-transform: uppercase;\n    color: var(--acid);\n    margin-bottom: 16px;\n  }\n  .section-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-bottom: 48px; }\n  .section-head h2 { font-size: clamp(40px, 6vw, 72px); max-width: 16ch; }\n  .section-head p { color: var(--muted); max-width: 42ch; }\n\n  .btn {\n    display: inline-flex; align-items: center; justify-content: center; gap: 10px;\n    padding: 14px 26px; border-radius: 999px; border: 2px solid transparent;\n    font: 700 15px/1 var(--body); letter-spacing: .04em; text-transform: uppercase;\n    cursor: pointer; transition: transform .15s ease, background .2s, color .2s, border-color .2s;\n  }\n  .btn:hover { transform: translateY(-2px); }\n  .btn-primary { background: var(--acid); color: var(--asphalt); }\n  .btn-primary:hover { background: #e8ff7a; }\n  .btn-ghost { border-color: var(--paper); color: var(--paper); background: transparent; }\n  .btn-ghost:hover { background: var(--paper); color: var(--asphalt); }\n  .btn-small { padding: 10px 18px; font-size: 13px; }\n\n  /* Header */\n  header {\n    position: sticky; top: 0; z-index: 50;\n    background: rgba(13,14,17,.85);\n    backdrop-filter: blur(10px);\n    border-bottom: 1px solid var(--line);\n  }\n  .nav { display: flex; align-items: center; justify-content: space-between; height: 76px; }\n  .logo { display: flex; align-items: center; gap: 12px; font-family: var(--display); font-size: 22px; letter-spacing: .03em; text-transform: uppercase; }\n  .logo-mark {\n    width: 38px; height: 38px; border-radius: 10px; background: var(--acid);\n    display: grid; place-items: center; color: var(--asphalt);\n  }\n  .nav-links { display: flex; gap: 32px; list-style: none; font-weight: 600; font-size: 15px; }\n  .nav-links a { color: var(--muted); transition: color .2s; }\n  .nav-links a:hover { color: var(--paper); }\n  .nav-cta { display: flex; align-items: center; gap: 16px; }\n  .menu-toggle { display: none; background: none; border: 0; color: var(--paper); cursor: pointer; padding: 8px; }\n  .menu-toggle svg { width: 28px; height: 28px; }\n\n  /* Hero */\n  .hero {\n    padding: 80px 0 110px;\n    background:\n      radial-gradient(circle at 80% 20%, rgba(215,255,58,.14), transparent 40%),\n      radial-gradient(circle at 10% 90%, rgba(255,90,78,.16), transparent 40%),\n      linear-gradient(180deg, var(--asphalt), var(--asphalt-2));\n    overflow: hidden;\n  }\n  .hero-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 48px; align-items: center; }\n  .hero h1 { font-size: clamp(56px, 9vw, 120px); margin-bottom: 24px; }\n  .hero h1 span { color: var(--acid); }\n  .hero h1 em { font-style: normal; -webkit-text-stroke: 2px var(--paper); color: transparent; }\n  .hero p.lead { font-size: 19px; color: var(--muted); max-width: 46ch; margin-bottom: 36px; }\n  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }\n  .hero-stats { display: flex; gap: 40px; margin-top: 56px; flex-wrap: wrap; }\n  .stat strong { display: block; font-family: var(--display); font-size: 44px; color: var(--paper); font-weight: 400; }\n  .stat span { font-size: 14px; color: var(--muted); text-transform: uppercase; letter-spacing: .1em; }\n  .hero-art { position: relative; display: grid; place-items: center; min-height: 460px; }\n  .hero-art::before {\n    content: \"\"; position: absolute; width: 85%; aspect-ratio: 1;\n    border-radius: 50%; border: 1px dashed var(--line);\n    animation: spin 40s linear infinite;\n  }\n  .deck { width: min(380px, 80%); animation: float 5s ease-in-out infinite; filter: drop-shadow(0 30px 40px rgba(0,0,0,.5)); }\n  .sticker {\n    position: absolute; background: var(--coral); color: var(--asphalt);\n    font-family: var(--display); font-size: 20px; padding: 14px 18px;\n    border-radius: 10px; transform: rotate(-8deg); top: 12%; right: 0;\n    box-shadow: 6px 6px 0 var(--asphalt-3);\n  }\n  @keyframes float { 0%,100% { transform: translateY(0) rotate(-6deg); } 50% { transform: translateY(-16px) rotate(-3deg); } }\n  @keyframes spin { to { transform: rotate(360deg); } }\n\n  /* Marquee */\n  .marquee { background: var(--acid); color: var(--asphalt); overflow: hidden; white-space: nowrap; padding: 18px 0; }\n  .marquee-track { display: inline-flex; animation: scroll 28s linear infinite; }\n  .marquee-track span { font-family: var(--display); font-size: 28px; padding: 0 28px; text-transform: uppercase; }\n  .marquee-track span::after { content: \"\u2736\"; margin-left: 56px; }\n  @keyframes scroll { to { transform: translateX(-50%); } }\n\n  /* Shop */\n  .categories { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }\n  .cat {\n    position: relative; border-radius: var(--radius); padding: 28px; min-height: 240px;\n    display: flex; flex-direction: column; justify-content: space-between;\n    border: 1px solid var(--line); overflow: hidden; transition: transform .25s, border-color .25s;\n    background: var(--asphalt-2);\n  }\n  .cat:hover { transform: translateY(-6px); border-color: var(--acid); }\n  .cat .icon { width: 56px; height: 56px; color: var(--acid); }\n  .cat h3 { font-size: 30px; margin-top: 18px; }\n  .cat p { color: var(--muted); font-size: 15px; }\n  .cat .arrow { font-weight: 700; color: var(--paper); margin-top: 16px; font-size: 14px; letter-spacing: .08em; text-transform: uppercase; }\n  .cat.wide { grid-column: span 2; background: linear-gradient(135deg, #1b1f27, #2a1d1e); }\n\n  .products { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 64px; }\n  .product { background: var(--asphalt-2); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }\n  .product-art { height: 220px; display: grid; place-items: center; position: relative; }\n  .product-art .badge {\n    position: absolute; top: 16px; left: 16px; background: var(--asphalt); color: var(--paper);\n    font: 700 11px/1 var(--body); letter-spacing: .14em; text-transform: uppercase; padding: 8px 10px; border-radius: 6px;\n  }\n  .product-body { padding: 22px; }\n  .product-body h4 { font-size: 22px; margin-bottom: 6px; }\n  .product-body p { color: var(--muted); font-size: 14px; margin-bottom: 18px; }\n  .product-foot { display: flex; justify-content: space-between; align-items: center; }\n  .price { font-family: var(--display); font-size: 26px; color: var(--paper); }\n  .price s { color: var(--muted); font-size: 16px; margin-left: 8px; font-family: var(--body); }\n  .add {\n    width: 44px; height: 44px; border-radius: 50%; border: 0; background: var(--paper); color: var(--asphalt);\n    font-size: 24px; font-weight: 700; cursor: pointer; transition: background .2s, transform .15s;\n  }\n  .add:hover { background: var(--acid); transform: rotate(90deg); }\n\n  /* Lessons */\n  .lessons { background: var(--paper); color: var(--asphalt); }\n  .lessons .eyebrow { color: var(--coral); }\n  .lessons .section-head p { color: #4b505a; }\n  .tiers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }\n  .tier {\n    background: #fff; border-radius: var(--radius); padding: 36px 30px; position: relative;\n    border: 2px solid transparent; display: flex; flex-direction: column;\n    box-shadow: 0 1px 0 rgba(0,0,0,.05), 0 20px 40px -24px rgba(0,0,0,.25);\n  }\n  .tier.featured { border-color: var(--asphalt); transform: translateY(-12px); }\n  .tier .tag {\n    position: absolute; top: -14px; left: 30px; background: var(--coral); color: #fff;\n    font: 700 12px/1 var(--body); letter-spacing: .12em; text-transform: uppercase; padding: 8px 12px; border-radius: 999px;\n  }\n  .tier h3 { font-size: 34px; margin-bottom: 8px; }\n  .tier .sub { color: #5a606b; font-size: 15px; margin-bottom: 22px; }\n  .tier .amount { font-family: var(--display); font-size: 60px; line-height: 1; }\n  .tier .amount small { font-family: var(--body); font-size: 15px; color: #5a606b; margin-left: 6px; }\n  .tier ul { list-style: none; margin: 26px 0 32px; display: grid; gap: 12px; flex: 1; }\n  .tier li { display: flex; gap: 10px; font-size: 15px; }\n  .tier li::before {\n    content: \"\"; flex: 0 0 18px; height: 18px; margin-top: 3px; border-radius: 50%;\n    background: var(--acid) url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M5 12l5 5 9-10' stroke='%230d0e11' stroke-width='3' fill='none'/></svg>\") center/12px no-repeat;\n  }\n  .tier .btn { width: 100%; }\n  .tier .btn-dark { background: var(--asphalt); color: var(--paper); }\n  .tier .btn-dark:hover { background: #2a2e37; }\n  .tier .btn-line { border-color: var(--asphalt); color: var(--asphalt); background: transparent; }\n  .tier .btn-line:hover { background: var(--asphalt); color: var(--paper); }\n\n  /* Schedule */\n  .schedule-wrap { margin-top: 80px; display: grid; grid-template-columns: 1fr 1.6fr; gap: 56px; align-items: start; }\n  .schedule-wrap h3 { font-size: 44px; margin-bottom: 16px; }\n  .schedule-wrap p { color: var(--muted); margin-bottom: 24px; }\n  .table-wrap { background: var(--asphalt-2); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }\n  table { width: 100%; border-collapse: collapse; font-size: 15px; }\n  th, td { padding: 18px 22px; text-align: left; border-bottom: 1px solid var(--line); }\n  th { font: 700 12px/1 var(--body); text-transform: uppercase; letter-spacing: .14em; color: var(--muted); background: var(--asphalt-3); }\n  tr:last-child td { border-bottom: 0; }\n  .level { display: inline-block; font-size: 12px; font-weight: 700; padding: 5px 10px; border-radius: 999px; }\n  .lvl-beg { background: rgba(215,255,58,.15); color: var(--acid); }\n  .lvl-int { background: rgba(79,195,247,.15); color: var(--sky); }\n  .lvl-adv { background: rgba(255,90,78,.15); color: var(--coral); }\n  .spots { color: var(--muted); }\n  .spots.low { color: var(--coral); font-weight: 700; }\n\n  /* Instructors */\n  .crew { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }\n  .coach { background: var(--asphalt-2); border: 1px solid var(--line); border-radius: var(--radius); padding: 30px; display: flex; gap: 22px; align-items: center; }\n  .avatar {\n    flex: 0 0 84px; height: 84px; border-radius: 50%; display: grid; place-items: center;\n    font-family: var(--display); font-size: 30px; color: var(--asphalt);\n  }\n  .coach h4 { font-size: 24px; }\n  .coach .role { color: var(--acid); font-size: 13px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; margin: 4px 0 8px; }\n  .coach p { color: var(--muted); font-size: 14px; }\n\n  /* Testimonials */\n  .quotes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }\n  .quote { border-left: 4px solid var(--coral); padding: 8px 0 8px 24px; }\n  .quote p { font-size: 19px; line-height: 1.5; margin-bottom: 18px; }\n  .quote cite { font-style: normal; font-weight: 700; font-size: 14px; color: var(--muted); }\n\n  /* Booking */\n  .booking {\n    background: linear-gradient(120deg, var(--coral), #ff8a4c);\n    color: var(--asphalt);\n  }\n  .booking-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }\n  .booking h2 { font-size: clamp(44px, 6vw, 80px); }\n  .booking p.lead { font-size: 18px; margin: 18px 0 28px; max-width: 40ch; }\n  .checks { list-style: none; display: grid; gap: 10px; font-weight: 600; }\n  .checks li::before { content: \"\u2192 \"; }\n  form.book {\n    background: var(--asphalt); color: var(--paper); border-radius: var(--radius); padding: 36px;\n    display: grid; gap: 16px; box-shadow: 0 30px 60px -20px rgba(0,0,0,.4);\n  }\n  form.book h3 { font-size: 30px; }\n  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }\n  label { display: block; font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin-bottom: 6px; }\n  input, select {\n    width: 100%; padding: 14px 16px; border-radius: 10px; border: 1px solid var(--line);\n    background: var(--asphalt-3); color: var(--paper); font: 500 15px var(--body);\n  }\n  input:focus, select:focus { outline: 2px solid var(--acid); outline-offset: 1px; }\n  form.book .btn { width: 100%; }\n  .form-msg { font-size: 14px; color: var(--acid); min-height: 20px; }\n\n  /* Footer */\n  footer { background: #080909; padding: 80px 0 32px; border-top: 1px solid var(--line); }\n  .foot-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1.2fr; gap: 40px; }\n  .foot-grid h5 { font: 700 13px/1 var(--body); letter-spacing: .16em; text-transform: uppercase; color: var(--muted); margin-bottom: 18px; }\n  .foot-grid ul { list-style: none; display: grid; gap: 10px; color: var(--paper); font-size: 15px; }\n  .foot-grid ul a:hover { color: var(--acid); }\n  .foot-about p { color: var(--muted); margin-top: 16px; font-size: 15px; max-width: 34ch; }\n  .news { display: flex; gap: 8px; margin-top: 8px; }\n  .news input { flex: 1; }\n  .news .btn { padding: 0 18px; }\n  .foot-bottom { margin-top: 64px; padding-top: 24px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; color: var(--muted); font-size: 14px; flex-wrap: wrap; gap: 12px; }\n\n  /* Responsive */\n  @media (max-width: 1000px) {\n    .hero-grid, .schedule-wrap, .booking-grid { grid-template-columns: 1fr; }\n    .hero-art { min-height: 360px; }\n    .categories { grid-template-columns: repeat(2, 1fr); }\n    .cat.wide { grid-column: span 2; }\n    .products, .tiers, .crew, .quotes { grid-template-columns: 1fr; }\n    .tier.featured { transform: none; }\n    .foot-grid { grid-template-columns: 1fr 1fr; }\n  }\n  @media (max-width: 760px) {\n    section { padding: 72px 0; }\n    .nav-links, .nav-cta .btn { display: none; }\n    .menu-toggle { display: block; }\n    .nav-links.open {\n      display: flex; flex-direction: column; position: absolute; top: 76px; left: 0; right: 0;\n      background: var(--asphalt); padding: 24px 4%; border-bottom: 1px solid var(--line); gap: 20px;\n    }\n    .categories { grid-template-columns: 1fr; }\n    .cat.wide { grid-column: span 1; }\n    .field-row { grid-template-columns: 1fr; }\n    .foot-grid { grid-template-columns: 1fr; }\n    th:nth-child(3), td:nth-child(3) { display: none; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    *, *::before, *::after { animation: none !important; transition: none !important; }\n  }\n</style>\n</head>\n<body>\n\n<!-- HEADER -->\n<header>\n  <div class=\"container nav\">\n    <a href=\"#top\" class=\"logo\">\n      <span class=\"logo-mark\" aria-hidden=\"true\">\n        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"><path d=\"M4 16c4 0 4-8 8-8s4 8 8 8\"/></svg>\n      </span>\n      Kickstand Skate Co.\n    </a>\n\n    <ul class=\"nav-links\" id=\"navLinks\">\n      <li><a href=\"#shop\">Shop</a></li>\n      <li><a href=\"#lessons\">Lessons</a></li>\n      <li><a href=\"#schedule\">Schedule</a></li>\n      <li><a href=\"#coaches\">Coaches</a></li>\n      <li><a href=\"#visit\">Visit</a></li>\n    </ul>\n\n    <div class=\"nav-cta\">\n      <a href=\"#book\" class=\"btn btn-primary btn-small\">Book a lesson</a>\n      <button class=\"menu-toggle\" id=\"menuToggle\" aria-label=\"Toggle menu\" aria-expanded=\"false\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M4 7h16M4 12h16M4 17h16\"/></svg>\n      </button>\n    </div>\n  </div>\n</header>\n\n<main id=\"top\">\n\n<!-- HERO -->\n<section class=\"hero\">\n  <div class=\"container hero-grid\">\n    <div>\n      <span class=\"eyebrow\">Skate shop &amp; school \u00b7 Est. 2012</span>\n      <h1>Roll <span>in.</span><br><em>Stay</em> up.</h1>\n      <p class=\"lead\">Decks, trucks, wheels and gear picked by riders who actually skate. Plus beginner-friendly lessons for kids, teens and adults who want to finally drop in.</p>\n      <div class=\"hero-actions\">\n        <a href=\"#lessons\" class=\"btn btn-primary\">Explore lessons</a>\n        <a href=\"#shop\" class=\"btn btn-ghost\">Shop the drop</a>\n      </div>\n      <div class=\"hero-stats\">\n        <div class=\"stat\"><strong>2,400+</strong><span>Students taught</span></div>\n        <div class=\"stat\"><strong>48</strong><span>Brands in stock</span></div>\n        <div class=\"stat\"><strong>4.9\u2605</strong><span>Average rating</span></div>\n      </div>\n    </div>\n\n    <div class=\"hero-art\" aria-hidden=\"true\">\n      <div class=\"sticker\">First lesson<br>free!</div>\n      <svg class=\"deck\" viewBox=\"0 0 300 760\" xmlns=\"http://www.w3.org/2000/svg\">\n        <!-- deck shape -->\n        <defs>\n          <linearGradient id=\"deckGrad\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n            <stop offset=\"0\" stop-color=\"#d7ff3a\"/>\n            <stop offset=\".55\" stop-color=\"#ff5a4e\"/>\n            <stop offset=\"1\" stop-color=\"#4fc3f7\"/>\n          </linearGradient>\n        </defs>\n        <path d=\"M150 10 C235 10 262 90 262 190 L262 570 C262 690 230 750 150 750 C70 750 38 690 38 570 L38 190 C38 90 65 10 150 10 Z\" fill=\"url(#deckGrad)\"/>\n        <path d=\"M150 40 C220 40 236 110 236 200 L236 560 C236 665 210 720 150 720 C90 720 64 665 64 560 L64 200 C64 110 80 40 150 40 Z\" fill=\"none\" stroke=\"#0d0e11\" stroke-width=\"3\" opacity=\".35\"/>\n        <!-- kicktail/nose cutouts -->\n        <rect x=\"120\" y=\"165\" width=\"60\" height=\"18\" rx=\"9\" fill=\"#0d0e11\" opacity=\".55\"/>\n        <rect x=\"120\" y=\"580\" width=\"60\" height=\"18\" rx=\"9\" fill=\"#0d0e11\" opacity=\".55\"/>\n        <text x=\"150\" y=\"380\" text-anchor=\"middle\" font-family=\"Impact, Arial Black, sans-serif\" font-size=\"46\" fill=\"#0d0e11\" transform=\"rotate(90 150 380)\" letter-spacing=\"3\">KICKSTAND</text>\n        <!-- trucks -->\n        <rect x=\"70\" y=\"250\" width=\"160\" height=\"10\" rx=\"4\" fill=\"#15171c\"/>\n        <rect x=\"70\" y=\"500\" width=\"160\" height=\"10\" rx=\"4\" fill=\"#15171c\"/>\n        <!-- wheels -->\n        <circle cx=\"60\" cy=\"255\" r=\"0\"/>\n      </svg>\n    </div>\n  </div>\n</section>\n\n<!-- MARQUEE -->\n<div class=\"marquee\" aria-hidden=\"true\">\n  <div class=\"marquee-track\">\n    <span>Kickflips</span><span>Ollies</span><span>Boardslides</span><span>Shove-its</span><span>Grind the rail</span><span>Learn to skate</span><span>Fresh decks weekly</span>\n    <span>Kickflips</span><span>Ollies</span><span>Boardslides</span><span>Shove-its</span><span>Grind the rail</span><span>Learn to skate</span><span>Fresh decks weekly</span>\n  </div>\n</div>\n\n<!-- SHOP -->\n<section id=\"shop\">\n  <div class=\"container\">\n    <div class=\"section-head\">\n      <div>\n        <span class=\"eyebrow\">The shop</span>\n        <h2>Gear that<br>won't let you down</h2>\n      </div>\n      <p>Every part is hand-checked in our shop before it hits the floor. Need a setup built? Our techs will assemble it free with any purchase over $150.</p>\n    </div>\n\n    <div class=\"categories\">\n      <a href=\"#\" class=\"cat\">\n        <svg class=\"icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><rect x=\"3\" y=\"9\" width=\"18\" height=\"5\" rx=\"2.5\"/><path d=\"M7 14v3M17 14v3\"/></svg>\n        <div><h3>Complete Boards</h3><p>Ready-to-ride setups for every style.</p></div>\n        <span class=\"arrow\">Shop boards \u2192</span>\n      </a>\n      <a href=\"#\" class=\"cat\">\n        <svg class=\"icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"6\" rx=\"2\"/><path d=\"M8 10v6M16 10v6M6 16h12\"/></svg>\n        <div><h3>Decks</h3><p>Pro models, shapes and custom sizes.</p></div>\n        <span class=\"arrow\">Shop decks \u2192</span>\n      </a>\n      <a href=\"#\" class=\"cat\">\n        <svg class=\"icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><circle cx=\"12\" cy=\"12\" r=\"8\"/><circle cx=\"12\" cy=\"12\" r=\"2.5\"/></svg>\n        <div><h3>Wheels &amp; Bearings</h3><p>Smooth cruisers to hard street durometers.</p></div>\n        <span class=\"arrow\">Shop wheels \u2192</span>\n      </a>\n      <a href=\"#\" class=\"cat\">\n        <svg class=\"icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"><path d=\"M4 16h10l4-6h2v6H4z\"/><path d=\"M8 19h8\"/></svg>\n        <div><h3>Shoes</h3><p>Flat-soled grip built for flip tricks.</p></div>\n        <span class=\"arrow\">Shop shoes \u2192</span>\n      </a>\n      <a href=\"#\" class=\"cat wide\">\n        <svg class=\"icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"><path d=\"M8 3l4 2 4-2 4 4-2 3-2-1v11H8V9L6 10 4 7z\"/></svg>\n        <div><h3>Apparel &amp; Protection</h3><p>Helmets, pads and the hoodies we actually wear.</p></div>\n        <span class=\"arrow\">Shop apparel \u2192</span>\n      </a>\n      <a href=\"#\" class=\"cat\">\n        <svg class=\"icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M12 3v12M7 10l5 5 5-5M5 21h14\"/></svg>\n        <div><h3>Trucks</h3><p>Low, mid and high profiles.</p></div>\n        <span class=\"arrow\">Shop trucks \u2192</span>\n      </a>\n    </div>\n\n    <div class=\"products\">\n      <article class=\"product\">\n        <div class=\"product-art\" style=\"background: linear-gradient(135deg, #d7ff3a, #8fd300);\">\n          <span class=\"badge\">Staff pick</span>\n          <svg width=\"160\" height=\"60\" viewBox=\"0 0 160 60\" aria-hidden=\"true\"><rect x=\"4\" y=\"8\" width=\"152\" height=\"18\" rx=\"9\" fill=\"#0d0e11\"/><circle cx=\"40\" cy=\"48\" r=\"10\" fill=\"#0d0e11\"/><circle cx=\"120\" cy=\"48\" r=\"10\" fill=\"#0d0e11\"/></svg>\n        </div>\n        <div class=\"product-body\">\n          <h4>Velvet Street 8.25\"</h4>\n          <p>Medium concave, 14.5\" wheelbase. Pops easy, holds up to daily sessions.</p>\n          <div class=\"product-foot\">\n            <span class=\"price\">$74 <s>$89</s></span>\n            <button class=\"add\" aria-label=\"Add Velvet Street to cart\">+</button>\n          </div>\n        </div>\n      </article>\n      <article class=\"product\">\n        <div class=\"product-art\" style=\"background: linear-gradient(135deg, #ff5a4e, #ff8a4c);\">\n          <span class=\"badge\">New</span>\n          <svg width=\"120\" height=\"120\" viewBox=\"0 0 120 120\" aria-hidden=\"true\"><circle cx=\"60\" cy=\"60\" r=\"50\" fill=\"#0d0e11\"/><circle cx=\"60\" cy=\"60\" r=\"18\" fill=\"#ff5a4e\"/></svg>\n        </div>\n        <div class=\"product-body\">\n          <h4>Hard Rolls 99A</h4>\n          <p>Street-spec 54mm wheels with sealed bearings. Grip, slide, repeat.</p>\n          <div class=\"product-foot\">\n            <span class=\"price\">$58</span>\n            <button class=\"add\" aria-label=\"Add Hard Rolls to cart\">+</button>\n          </div>\n        </div>\n      </article>\n      <article class=\"product\">\n        <div class=\"product-art\" style=\"background: linear-gradient(135deg, #4fc3f7, #1e88e5);\">\n          <span class=\"badge\">Beginner fave</span>\n          <svg width=\"150\" height=\"90\" viewBox=\"0 0 150 90\" aria-hidden=\"true\"><path d=\"M10 60 Q75 10 140 60\" stroke=\"#0d0e11\" stroke-width=\"14\" fill=\"none\" stroke-linecap=\"round\"/><circle cx=\"40\" cy=\"70\" r=\"10\" fill=\"#0d0e11\"/><circle cx=\"110\" cy=\"70\" r=\"10\" fill=\"#0d0e11\"/></svg>\n        </div>\n        <div class=\"product-body\">\n          <h4>Starter Complete</h4>\n          <p>Pre-assembled and tuned by our techs. The board most of our students start on.</p>\n          <div class=\"product-foot\">\n            <span class=\"price\">$129</span>\n            <button class=\"add\" aria-label=\"Add Starter Complete to cart\">+</button>\n          </div>\n        </div>\n      </article>\n    </div>\n  </div>\n</section>\n\n<!-- LESSONS -->\n<section id=\"lessons\" class=\"lessons\">\n  <div class=\"container\">\n    <div class=\"section-head\">\n      <div>\n        <span class=\"eyebrow\">Skate school</span>\n        <h2>Learn it right.<br>Learn it fast.</h2>\n      </div>\n      <p>Small groups, patient coaches and a safe, closed-off session area. Every program includes pads and a helmet to borrow.</p>\n    </div>\n\n    <div class=\"tiers\">\n      <div class=\"tier\">\n        <h3>Kickoff</h3>\n        <p class=\"sub\">For total beginners. Stand, push, stop, turn.</p>\n        <div class=\"amount\">$120<small>/ 4 weeks</small></div>\n        <ul>\n          <li>Four 60-minute group sessions</li>\n          <li>Max 6 students per coach</li>\n          <li>Safety gear included</li>\n          <li>Skate-park orientation</li>\n        </ul>\n        <a href=\"#book\" class=\"btn btn-line\">Sign up</a>\n      </div>\n\n      <div class=\"tier featured\">\n        <span class=\"tag\">Most popular</span>\n        <h3>Progression</h3>\n        <p class=\"sub\">For riders who can roll and want their first tricks.</p>\n        <div class=\"amount\">$180<small>/ 6 weeks</small></div>\n        <ul>\n          <li>Six 75-minute group sessions</li>\n          <li>Ollies, shove-its and manuals</li>\n          <li>Video breakdown every week</li>\n          <li>Free 10% off shop purchases</li>\n        </ul>\n        <a href=\"#book\" class=\"btn btn-dark\">Sign up</a>\n      </div>\n\n      <div class=\"tier\">\n        <h3>Private 1:1</h3>\n        <p class=\"sub\">Your board, your goals, your coach, your pace.</p>\n        <div class=\"amount\">$65<small>/ hour</small></div>\n        <ul>\n          <li>Fully customized lesson plan</li>\n          <li>Flexible weekday and weekend slots</li>\n          <li>Works for kids, adults and parents</li>\n          <li>Trick-by-trick progress tracking</li>\n        </ul>\n        <a href=\"#book\" class=\"btn btn-line\">Book private</a>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- SCHEDULE -->\n<section id=\"schedule\">\n  <div class=\"container\">\n    <div class=\"schedule-wrap\">\n      <div>\n        <span class=\"eyebrow\">This week</span>\n        <h3>Session schedule</h3>\n        <p>Classes fill fast. Spots update in real time, so grab yours before the board does.</p>\n        <a href=\"#book\" class=\"btn btn-primary\">Reserve a spot</a>\n      </div>\n\n      <div class=\"table-wrap\">\n        <table>\n          <thead>\n            <tr><th>Day</th><th>Time</th><th>Class</th><th>Level</th><th>Spots</th></tr>\n          </thead>\n          <tbody>\n            <tr><td>Mon</td><td>5:30 PM</td><td>Kickoff</td><td><span class=\"level lvl-beg\">Beginner</span></td><td class=\"spots low\">2 left</td></tr>\n            <tr><td>Tue</td><td>6:30 PM</td><td>Progression</td><td><span class=\"level lvl-int\">Intermediate</span></td><td class=\"spots\">5 left</td></tr>\n            <tr><td>Wed</td><td>5:30 PM</td><td>Kickoff</td><td><span class=\"level lvl-beg\">Beginner</span></td><td class=\"spots\">4 left</td></tr>\n            <tr><td>Thu</td><td>7:00 PM</td><td>Street Lab</td><td><span class=\"level lvl-adv\">Advanced</span></td><td class=\"spots low\">1 left</td></tr>\n            <tr><td>Sat</td><td>10:00 AM</td><td>Kids Kickoff (6\u201312)</td><td><span class=\"level lvl-beg\">Beginner</span></td><td class=\"spots\">3 left</td></tr>\n            <tr><td>Sun</td><td>11:30 AM</td><td>Parent &amp; Me</td><td><span class=\"level lvl-beg\">Beginner</span></td><td class=\"spots\">6 left</td></tr>\n          </tbody>\n        </table>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- COACHES -->\n<section id=\"coaches\" style=\"padding-top: 0;\">\n  <div class=\"container\">\n    <div class=\"section-head\">\n      <div>\n        <span class=\"eyebrow\">Your coaches</span>\n        <h2>Riders who<br>teach riders</h2>\n      </div>\n    </div>\n    <div class=\"crew\">\n      <div class=\"coach\">\n        <div class=\"avatar\" style=\"background: var(--acid);\">MR</div>\n        <div>\n          <h4>Maya Reyes</h4>\n          <div class=\"role\">Head Coach</div>\n          <p>Former regional park champ. Believes everyone can ollie by week three.</p>\n        </div>\n      </div>\n      <div class=\"coach\">\n        <div class=\"avatar\" style=\"background: var(--coral);\">DK</div>\n        <div>\n          <h4>Dev Kapoor</h4>\n          <div class=\"role\">Street Coach</div>\n          <p>Ledges, rails and gaps. Teaches the spots you've been watching from the curb.</p>\n        </div>\n      </div>\n      <div class=\"coach\">\n        <div class=\"avatar\" style=\"background: var(--sky);\">JT</div>\n        <div>\n          <h4>Jess Thorne</h4>\n          <div class=\"role\">Kids &amp; Adults</div>\n          <p>Patient, playful and certified in first aid. Our go-to for nervous first-timers.</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- TESTIMONIALS -->\n<section style=\"padding-top: 0;\">\n  <div class=\"container quotes\">\n    <blockquote class=\"quote\">\n      <p>\"I was 41 and terrified of falling. Jess had me rolling in two sessions and landing my first kickturn by the end of the month.\"</p>\n      <cite>\u2014 Andrea, Kickoff grad</cite>\n    </blockquote>\n    <blockquote class=\"quote\">\n      <p>\"My son has been asking for a board for a year. Now he's dragging me down here every Saturday. Best money we've spent.\"</p>\n      <cite>\u2014 Michael, parent</cite>\n    </blockquote>\n    <blockquote class=\"quote\">\n      <p>\"The staff actually check your trucks before you leave. Rare in this town. I've bought every board here since I was fourteen.\"</p>\n      <cite>\u2014 Sam, regular</cite>\n    </blockquote>\n  </div>\n</section>\n\n<!-- BOOKING -->\n<section id=\"book\" class=\"booking\">\n  <div class=\"container booking-grid\">\n    <div>\n      <span class=\"eyebrow\" style=\"color: var(--asphalt);\">Book now</span>\n      <h2>Your first lesson is on us</h2>\n      <p class=\"lead\">Fill out the form and a coach will reach out within 24 hours to confirm your spot and recommend a board if you need one.</p>\n      <ul class=\"checks\">\n        <li>Free first session for new students</li>\n        <li>Helmet and pads provided</li>\n        <li>Cancel up to 12 hours before, no fee</li>\n      </ul>\n    </div>\n\n    <form class=\"book\" id=\"bookingForm\">\n      <h3>Reserve your spot</h3>\n      <div class=\"field-row\">\n        <div>\n          <label for=\"name\">Name</label>\n          <input id=\"name\" name=\"name\" type=\"text\" placeholder=\"Your name\" required>\n        </div>\n        <div>\n          <label for=\"email\">Email</label>\n          <input id=\"email\" name=\"email\" type=\"email\" placeholder=\"you@email.com\" required>\n        </div>\n      </div>\n      <div class=\"field-row\">\n        <div>\n          <label for=\"level\">Experience</label>\n          <select id=\"level\" name=\"level\" required>\n            <option value=\"\">Select one</option>\n            <option>Never skated</option>\n            <option>Can push and turn</option>\n            <option>Can ollie</option>\n            <option>Advanced</option>\n          </select>\n        </div>\n        <div>\n          <label for=\"program\">Program</label>\n          <select id=\"program\" name=\"program\" required>\n            <option value=\"\">Select one</option>\n            <option>Kickoff (4 weeks)</option>\n            <option>Progression (6 weeks)</option>\n            <option>Private 1:1</option>\n            <option>Kids Kickoff</option>\n          </select>\n        </div>\n      </div>\n      <button type=\"submit\" class=\"btn btn-primary\">Request my spot</button>\n      <p class=\"form-msg\" id=\"formMsg\" role=\"status\" aria-live=\"polite\"></p>\n    </form>\n  </div>\n</section>\n\n</main>\n\n<!-- FOOTER -->\n<footer id=\"visit\">\n  <div class=\"container\">\n    <div class=\"foot-grid\">\n      <div class=\"foot-about\">\n        <a href=\"#top\" class=\"logo\">\n          <span class=\"logo-mark\" aria-hidden=\"true\">\n            <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"><path d=\"M4 16c4 0 4-8 8-8s4 8 8 8\"/></svg>\n          </span>\n          Kickstand\n        </a>\n        <p>Skate shop and lesson school serving the neighborhood since 2012. Come for the gear, stay for the crew.</p>\n      </div>\n      <div>\n        <h5>Visit</h5>\n        <ul>\n          <li>214 Mill Street</li>\n          <li>Riverside District</li>\n          <li>(555) 014-2290</li>\n        </ul>\n      </div>\n      <div>\n        <h5>Hours</h5>\n        <ul>\n          <li>Mon\u2013Fri \u00b7 11am \u2013 8pm</li>\n          <li>Sat \u00b7 10am \u2013 7pm</li>\n          <li>Sun \u00b7 11am \u2013 5pm</li>\n        </ul>\n      </div>\n      <div>\n        <h5>Stay in the loop</h5>\n        <form class=\"news\" onsubmit=\"event.preventDefault(); this.querySelector('input').value=''; this.querySelector('button').textContent='Done!';\">\n          <input type=\"email\" placeholder=\"Email address\" aria-label=\"Email address\" required>\n          <button class=\"btn btn-primary btn-small\" type=\"submit\">Join</button>\n        </form>\n        <ul style=\"margin-top: 20px;\">\n          <li><a href=\"#\">Instagram</a></li>\n          <li><a href=\"#\">YouTube</a></li>\n        </ul>\n      </div>\n    </div>\n    <div class=\"foot-bottom\">\n      <span>\u00a9 2025 Kickstand Skate Co. All rights reserved.</span>\n      <span>Skate at your own risk. Wear a helmet.</span>\n    </div>\n  </div>\n</footer>\n\n<script>\n  // Mobile nav toggle\n  const toggle = document.getElementById('menuToggle');\n  const links = document.getElementById('navLinks');\n  toggle.addEventListener('click', () => {\n    const open = links.classList.toggle('open');\n    toggle.setAttribute('aria-expanded', open);\n  });\n  links.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {\n    links.classList.remove('open');\n    toggle.setAttribute('aria-expanded', 'false');\n  }));\n\n  // Booking form (demo only, no backend)\n  const form = document.getElementById('bookingForm');\n  const msg = document.getElementById('formMsg');\n  form.addEventListener('submit', e => {\n    e.preventDefault();\n    const name = form.name.value.trim().split(' ')[0] || 'rider';\n    msg.textContent = `Thanks, ${name}! A coach will email you within 24 hours to confirm.`;\n    form.reset();\n  });\n\n  // Add-to-cart buttons (demo feedback)\n  document.querySelectorAll('.add').forEach(btn => {\n    btn.addEventListener('click', () => {\n      btn.textContent = '\u2713';\n      setTimeout(() => btn.textContent = '+', 1200);\n    });\n  });\n</script>\n</body>\n</html>\n"}