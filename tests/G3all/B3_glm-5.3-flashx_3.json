{"brief": "B3", "model": "z-ai/glm-5.3-flashx", "i": 3, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>SILT \u2014 The columnar engine for data engineers</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;1,400&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --paper:#F2EFE6;\n    --paper-2:#EAE6D9;\n    --ink:#16140F;\n    --ink-60:rgba(22,20,15,.6);\n    --ink-12:rgba(22,20,15,.12);\n    --ink-06:rgba(22,20,15,.06);\n    --signal:#E5470F;\n    --signal-ink:#B3360A;\n    --mono:'JetBrains Mono',ui-monospace,monospace;\n    --sans:'Archivo',sans-serif;\n  }\n  *{margin:0;padding:0;box-sizing:border-box}\n  html{scroll-behavior:smooth}\n  body{background:var(--paper);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased;overflow-x:hidden}\n  ::selection{background:var(--signal);color:var(--paper)}\n  a{color:inherit;text-decoration:none}\n  .wrap{max-width:1200px;margin:0 auto;padding:0 24px}\n  .mono{font-family:var(--mono)}\n\n  /* ---------- header ---------- */\n  header{position:sticky;top:0;z-index:50;background:var(--paper);border-bottom:1px solid var(--ink)}\n  .nav{display:flex;align-items:stretch;height:60px}\n  .logo{display:flex;align-items:center;gap:10px;font-weight:900;font-size:20px;letter-spacing:.02em;padding-right:28px;border-right:1px solid var(--ink)}\n  .logo svg{display:block}\n  nav.links{display:flex;align-items:stretch;flex:1}\n  nav.links a{display:flex;align-items:center;padding:0 22px;font-family:var(--mono);font-size:12.5px;letter-spacing:.06em;text-transform:uppercase;border-right:1px solid var(--ink-12);transition:background .15s,color .15s}\n  nav.links a:hover{background:var(--ink);color:var(--paper)}\n  .nav-cta{display:flex;align-items:center;gap:14px;margin-left:auto;padding-left:22px}\n  .stars{font-family:var(--mono);font-size:12.5px;display:flex;align-items:center;gap:7px;color:var(--ink-60)}\n  .stars b{color:var(--ink)}\n  .btn{font-family:var(--mono);font-size:12.5px;letter-spacing:.05em;text-transform:uppercase;padding:9px 18px;border:1px solid var(--ink);background:var(--ink);color:var(--paper);cursor:pointer;transition:all .15s;display:inline-block}\n  .btn:hover{background:var(--signal);border-color:var(--signal);color:#fff}\n  .btn.ghost{background:transparent;color:var(--ink)}\n  .btn.ghost:hover{background:var(--signal);color:#fff;border-color:var(--signal)}\n\n  /* ---------- hero ---------- */\n  .hero{border-bottom:1px solid var(--ink)}\n  .hero-grid{display:grid;grid-template-columns:1.1fr .9fr;min-height:calc(100vh - 60px)}\n  .hero-left{padding:72px 48px 56px 0;border-right:1px solid var(--ink);display:flex;flex-direction:column}\n  .kicker{font-family:var(--mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--signal-ink);display:flex;align-items:center;gap:10px;margin-bottom:28px}\n  .kicker::before{content:\"\";width:34px;height:1px;background:var(--signal)}\n  h1{font-size:clamp(52px,7.2vw,104px);line-height:.94;font-weight:900;letter-spacing:-.025em;text-transform:uppercase}\n  h1 .row{display:block;overflow:hidden}\n  h1 .row span{display:inline-block;transform:translateY(110%);animation:rise .7s cubic-bezier(.2,.7,.2,1) forwards}\n  h1 .row:nth-child(2) span{animation-delay:.08s}\n  h1 .row:nth-child(3) span{animation-delay:.16s;color:var(--signal)}\n  @keyframes rise{to{transform:translateY(0)}}\n  .hero-sub{margin-top:30px;font-size:17px;line-height:1.65;max-width:46ch;color:var(--ink-60)}\n  .hero-sub b{color:var(--ink);font-weight:600}\n  .install{margin-top:36px;display:flex;align-items:center;border:1px solid var(--ink);max-width:460px;background:var(--paper)}\n  .install .ps1{font-family:var(--mono);font-size:14px;padding:15px 0 15px 16px;color:var(--signal)}\n  .install code{font-family:var(--mono);font-size:14px;padding:15px 8px;flex:1;white-space:nowrap;overflow:hidden}\n  .install button{border:none;border-left:1px solid var(--ink);background:var(--paper-2);font-family:var(--mono);font-size:12px;letter-spacing:.06em;padding:0 18px;cursor:pointer;text-transform:uppercase;transition:all .15s}\n  .install button:hover{background:var(--signal);color:#fff}\n  .hero-meta{margin-top:auto;padding-top:44px;display:flex;gap:0;font-family:var(--mono);font-size:12px}\n  .hero-meta div{padding:0 26px;border-left:1px solid var(--ink-12)}\n  .hero-meta div:first-child{padding-left:0;border:none}\n  .hero-meta b{display:block;font-size:22px;font-weight:700;letter-spacing:-.02em}\n  .hero-meta span{color:var(--ink-60)}\n\n  /* terminal */\n  .hero-right{background:var(--ink);color:#D8D4C6;display:flex;flex-direction:column;position:relative}\n  .term-bar{display:flex;align-items:center;gap:8px;padding:14px 20px;border-bottom:1px solid rgba(242,239,230,.14);font-family:var(--mono);font-size:11.5px;letter-spacing:.08em;text-transform:uppercase;color:rgba(242,239,230,.5)}\n  .term-bar i{width:9px;height:9px;border-radius:50%;background:rgba(242,239,230,.22)}\n  .term-bar i:first-child{background:var(--signal)}\n  .term-body{padding:26px 24px;font-family:var(--mono);font-size:13.5px;line-height:1.75;flex:1;overflow:hidden}\n  .t-line{white-space:pre-wrap;word-break:break-all}\n  .t-p{color:var(--signal)}\n  .t-k{color:#F2EFE6;font-weight:700}\n  .t-dim{color:rgba(242,239,230,.42)}\n  .t-ok{color:#8FBF4D}\n  .cursor{display:inline-block;width:8px;height:16px;background:var(--signal);vertical-align:-3px;animation:blink 1s steps(1) infinite}\n  @keyframes blink{50%{opacity:0}}\n  .term-foot{border-top:1px solid rgba(242,239,230,.14);padding:14px 24px;font-family:var(--mono);font-size:11.5px;color:rgba(242,239,230,.42);display:flex;justify-content:space-between}\n\n  /* ticker */\n  .ticker{border-bottom:1px solid var(--ink);overflow:hidden;background:var(--paper-2)}\n  .ticker-track{display:flex;width:max-content;animation:tick 30s linear infinite}\n  .ticker-track span{font-family:var(--mono);font-size:13px;letter-spacing:.12em;text-transform:uppercase;padding:13px 0;white-space:nowrap}\n  .ticker-track em{font-style:normal;color:var(--signal);padding:0 22px}\n  @keyframes tick{to{transform:translateX(-50%)}}\n\n  /* ---------- section chrome ---------- */\n  section{border-bottom:1px solid var(--ink)}\n  .sec-head{display:flex;align-items:baseline;gap:22px;padding:56px 0 40px}\n  .sec-num{font-family:var(--mono);font-size:13px;color:var(--signal);letter-spacing:.1em}\n  .sec-title{font-size:clamp(30px,4vw,48px);font-weight:800;letter-spacing:-.02em;text-transform:uppercase;line-height:1}\n  .sec-note{margin-left:auto;font-family:var(--mono);font-size:12px;color:var(--ink-60);letter-spacing:.05em}\n\n  /* principles ledger */\n  .ledger{border-top:1px solid var(--ink)}\n  .ledger-row{display:grid;grid-template-columns:90px 1fr 1.1fr;gap:32px;padding:34px 0;border-bottom:1px solid var(--ink-12);transition:background .2s;align-items:start}\n  .ledger-row:hover{background:var(--paper-2)}\n  .ledger-row .idx{font-family:var(--mono);font-size:13px;color:var(--ink-60);padding-top:6px}\n  .ledger-row:hover .idx{color:var(--signal)}\n  .ledger-row h3{font-size:24px;font-weight:700;letter-spacing:-.01em;margin-bottom:10px}\n  .ledger-row h3 code{font-family:var(--mono);font-size:.85em;background:var(--ink-06);border:1px solid var(--ink-12);padding:2px 8px;color:var(--signal-ink)}\n  .ledger-row p{font-size:15px;line-height:1.7;color:var(--ink-60)}\n  .ledger-row p b{color:var(--ink);font-weight:600}\n\n  /* ---------- console ---------- */\n  .console-sec{background:var(--ink);color:var(--paper)}\n  .console-sec .sec-note{color:rgba(242,239,230,.45)}\n  .console{display:grid;grid-template-columns:300px 1fr;border:1px solid rgba(242,239,230,.2);margin-bottom:64px}\n  .console-side{border-right:1px solid rgba(242,239,230,.2);padding:22px;display:flex;flex-direction:column;gap:10px;background:rgba(242,239,230,.03)}\n  .console-side h4{font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:rgba(242,239,230,.45);margin-bottom:8px}\n  .q-chip{font-family:var(--mono);font-size:12.5px;text-align:left;background:transparent;border:1px solid rgba(242,239,230,.25);color:var(--paper);padding:13px 15px;cursor:pointer;line-height:1.45;transition:all .15s;display:flex;gap:10px;align-items:baseline}\n  .q-chip::before{content:\"\u25b8\";color:var(--signal);flex:none}\n  .q-chip:hover{border-color:var(--paper)}\n  .q-chip.active{background:var(--signal);border-color:var(--signal);color:#fff}\n  .q-chip.active::before{color:#fff}\n  .console-side .ds{margin-top:auto;font-family:var(--mono);font-size:11px;color:rgba(242,239,230,.4);line-height:1.8;border-top:1px solid rgba(242,239,230,.15);padding-top:14px}\n  .console-side .ds b{color:var(--paper)}\n  .console-main{display:flex;flex-direction:column;min-width:0}\n  .q-display{padding:20px 24px;font-family:var(--mono);font-size:13.5px;line-height:1.7;border-bottom:1px solid rgba(242,239,230,.2);white-space:pre-wrap;background:rgba(242,239,230,.03);min-height:96px}\n  .q-display .k{color:#F0A886;font-weight:700}\n  .q-run{display:flex;align-items:center;gap:16px;padding:12px 24px;border-bottom:1px solid rgba(242,239,230,.2)}\n  .run-btn{font-family:var(--mono);font-size:12px;letter-spacing:.1em;text-transform:uppercase;background:var(--signal);color:#fff;border:none;padding:10px 22px;cursor:pointer;transition:all .15s}\n  .run-btn:hover{background:#fff;color:var(--ink)}\n  .run-btn:disabled{opacity:.5;cursor:wait}\n  .q-stat{font-family:var(--mono);font-size:12px;color:rgba(242,239,230,.5);display:flex;gap:22px}\n  .q-stat b{color:var(--paper);font-weight:500}\n  .q-stat .ok{color:#8FBF4D}\n  .res-scroll{overflow-x:auto;flex:1}\n  table.res{width:100%;border-collapse:collapse;font-family:var(--mono);font-size:12.5px}\n  table.res th{font-weight:500;text-transform:uppercase;letter-spacing:.08em;font-size:10.5px;color:rgba(242,239,230,.45);text-align:left;padding:12px 18px;border-bottom:1px solid rgba(242,239,230,.2);white-space:nowrap}\n  table.res td{padding:11px 18px;border-bottom:1px solid rgba(242,239,230,.08);white-space:nowrap;color:#D8D4C6}\n  table.res td.num{text-align:right}\n  table.res th.num{text-align:right}\n  table.res tr{opacity:0;animation:rowin .3s forwards}\n  @keyframes rowin{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}\n  table.res td .bar{display:inline-block;height:8px;background:var(--signal);vertical-align:middle;margin-left:10px}\n  .res-empty{padding:44px 24px;font-family:var(--mono);font-size:12.5px;color:rgba(242,239,230,.35)}\n\n  /* ---------- benchmark ---------- */\n  .bench{display:grid;grid-template-columns:1fr 1.4fr;gap:56px;padding-bottom:72px;align-items:start}\n  .bench-copy p{font-size:15.5px;line-height:1.75;color:var(--ink-60);margin-bottom:18px}\n  .bench-copy p b{color:var(--ink)}\n  .bench-copy .foot{font-family:var(--mono);font-size:11.5px;color:var(--ink-60);border-top:1px solid var(--ink-12);padding-top:14px;line-height:1.8}\n  .chart{border:1px solid var(--ink);padding:30px 30px 22px;background:var(--paper)}\n  .chart h4{font-family:var(--mono);font-size:11.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-60);margin-bottom:26px}\n  .brow{display:grid;grid-template-columns:120px 1fr 78px;gap:14px;align-items:center;margin-bottom:20px;font-family:var(--mono);font-size:12.5px}\n  .brow .bname{color:var(--ink-60)}\n  .brow.silt .bname{color:var(--ink);font-weight:700}\n  .btrack{height:26px;background:var(--ink-06);position:relative}\n  .bfill{position:absolute;inset:0 auto 0 0;width:0;background:var(--ink-12);transition:width 1.1s cubic-bezier(.2,.7,.2,1)}\n  .brow.silt .bfill{background:var(--signal)}\n  .brow .bval{text-align:right;font-size:12px;color:var(--ink-60)}\n  .brow.silt .bval{color:var(--signal-ink);font-weight:700}\n  .chart .axis{display:flex;justify-content:space-between;font-family:var(--mono);font-size:10.5px;color:var(--ink-60);border-top:1px solid var(--ink-12);padding-top:8px;margin-top:6px}\n\n  /* ---------- code tabs ---------- */\n  .code-sec .sec-head{padding-bottom:32px}\n  .tabs{display:flex;border:1px solid var(--ink);border-bottom:none;width:max-content}\n  .tab{font-family:var(--mono);font-size:12px;letter-spacing:.06em;text-transform:uppercase;padding:11px 24px;cursor:pointer;border-right:1px solid var(--ink);background:var(--paper-2);transition:all .15s}\n  .tab:last-child{border-right:none}\n  .tab.active{background:var(--ink);color:var(--paper)}\n  .codebox{border:1px solid var(--ink);background:var(--ink);color:#D8D4C6;font-family:var(--mono);font-size:13.5px;line-height:1.8;padding:26px 28px;overflow-x:auto;min-height:280px;white-space:pre}\n  .codebox .c{color:rgba(216,212,198,.38)}\n  .codebox .k{color:#F0A886;font-weight:700}\n  .codebox .s{color:#8FBF4D}\n  .codebox .f{color:#E8C468}\n  .codebox .n{color:#D8D4C6}\n\n  /* ---------- cta / footer ---------- */\n  .cta{padding:96px 0;text-align:left;display:grid;grid-template-columns:1.2fr .8fr;gap:48px;align-items:center}\n  .cta h2{font-size:clamp(38px,5vw,68px);font-weight:900;text-transform:uppercase;letter-spacing:-.025em;line-height:.98}\n  .cta h2 em{font-style:normal;color:var(--signal)}\n  .cta .actions{display:flex;flex-direction:column;gap:14px;align-items:flex-start}\n  footer{border-bottom:none;background:var(--ink);color:rgba(242,239,230,.55)}\n  .foot-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:32px;padding:56px 0 40px}\n  footer .flogo{color:var(--paper);font-weight:900;font-size:20px;display:flex;align-items:center;gap:10px;margin-bottom:14px}\n  footer p{font-family:var(--mono);font-size:12px;line-height:1.8;max-width:34ch}\n  footer h5{font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:rgba(242,239,230,.4);margin-bottom:16px}\n  footer ul{list-style:none}\n  footer ul a{font-family:var(--mono);font-size:12.5px;line-height:2.1;transition:color .15s}\n  footer ul a:hover{color:var(--signal)}\n  .foot-base{border-top:1px solid rgba(242,239,230,.14);padding:18px 0;display:flex;justify-content:space-between;font-family:var(--mono);font-size:11.5px;color:rgba(242,239,230,.35)}\n\n  /* toast */\n  #toast{position:fixed;bottom:28px;left:50%;transform:translate(-50%,80px);background:var(--ink);color:var(--paper);font-family:var(--mono);font-size:12.5px;padding:13px 22px;border-left:3px solid var(--signal);opacity:0;transition:all .3s cubic-bezier(.2,.7,.2,1);z-index:100;pointer-events:none}\n  #toast.show{transform:translate(-50%,0);opacity:1}\n\n  @media(max-width:960px){\n    .hero-grid,.console,.bench,.cta{grid-template-columns:1fr}\n    .hero-left{border-right:none;border-bottom:1px solid var(--ink);padding-right:0}\n    .console-side{border-right:none;border-bottom:1px solid rgba(242,239,230,.2)}\n    .ledger-row{grid-template-columns:1fr;gap:10px}\n    .foot-grid{grid-template-columns:1fr 1fr}\n    nav.links{display:none}\n  }\n</style>\n</head>\n<body>\n\n<!-- ============ HEADER ============ -->\n<header>\n  <div class=\"wrap nav\">\n    <a class=\"logo\" href=\"#top\">\n      <svg width=\"26\" height=\"26\" viewBox=\"0 0 26 26\" fill=\"none\">\n        <rect x=\"1\" y=\"1\" width=\"24\" height=\"24\" stroke=\"currentColor\" stroke-width=\"2\"/>\n        <path d=\"M5 17h4v4H5zM10.5 11h4v10h-4zM16 5h4v16h-4z\" fill=\"#E5470F\"/>\n      </svg>\n      SILT\n    </a>\n    <nav class=\"links\">\n      <a href=\"#principles\">Principles</a>\n      <a href=\"#console\">Console</a>\n      <a href=\"#bench\">Benchmarks</a>\n      <a href=\"#code\">Quickstart</a>\n      <a href=\"#docs\" onclick=\"toast('Docs open in a new tab on the real site')\">Docs \u2197</a>\n    </nav>\n    <div class=\"nav-cta\">\n      <span class=\"stars\">\n        <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z\"/></svg>\n        <b id=\"starCount\">24,318</b>\n      </span>\n      <a class=\"btn ghost\" href=\"#top\" onclick=\"toast('Thanks for the thought \u2014 repo link would live here');return false\">Watch</a>\n      <a class=\"btn\" href=\"#code\">Get started</a>\n    </div>\n  </div>\n</header>\n\n<!-- ============ HERO ============ -->\n<div class=\"hero\" id=\"top\">\n  <div class=\"wrap hero-grid\">\n    <div class=\"hero-left\">\n      <div class=\"kicker\">Open source \u00b7 Apache-2.0 \u00b7 v0.9.4</div>\n      <h1>\n        <span class=\"row\"><span>Data settles.</span></span>\n        <span class=\"row\"><span>Queries</span></span>\n        <span class=\"row\"><span>surface.</span></span>\n      </h1>\n      <p class=\"hero-sub\">\n        <b>SILT</b> is a columnar, vectorized database built for data engineers \u2014\n        the ones who pipe, model and reconcile data at 3 a.m. <b>Zero-copy\n        ingestion from Parquet</b>, time-travel on every table, and a SQL engine\n        that treats your lakehouse like a first-class citizen.\n      </p>\n      <div class=\"install\">\n        <span class=\"ps1\">$</span>\n        <code id=\"installCmd\">curl -sSL silt.dev/install.sh | sh</code>\n        <button onclick=\"copyInstall()\">Copy</button>\n      </div>\n      <div class=\"hero-meta\">\n        <div><b>11.2\u00d7</b><span>faster than row-store</span></div>\n        <div><b>0-copy</b><span>Parquet ingestion</span></div>\n        <div><b>1 binary</b><span>no JVM, no cluster</span></div>\n      </div>\n    </div>\n    <div class=\"hero-right\">\n      <div class=\"term-bar\"><i></i><i></i><i></i><span style=\"margin-left:auto\">silt \u2014 zsh</span></div>\n      <div class=\"term-body\" id=\"term\"></div>\n      <div class=\"term-foot\"><span>silt 0.9.4 \u00b7 single node</span><span id=\"termTime\">\u2014</span></div>\n    </div>\n  </div>\n</div>\n\n<!-- ============ TICKER ============ -->\n<div class=\"ticker\">\n  <div class=\"ticker-track\" id=\"tickerTrack\"></div>\n</div>\n\n<!-- ============ PRINCIPLES ============ -->\n<section id=\"principles\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"sec-num\">01</span>\n      <h2 class=\"sec-title\">Built on hard opinions</h2>\n      <span class=\"sec-note\">Four principles, zero hedging</span>\n    </div>\n    <div class=\"ledger\">\n      <div class=\"ledger-row\">\n        <span class=\"idx\">/01</span>\n        <h3>Parquet is the contract, <code>read_parquet()</code> the door</h3>\n        <p>Mount any object store \u2014 S3, GCS, HDFS, a USB stick \u2014 and query it in place. <b>No ingestion step, no duplicate storage, no ELM tool tax.</b> If it writes Parquet, SILT already reads it.</p>\n      </div>\n      <div class=\"ledger-row\">\n        <span class=\"idx\">/02</span>\n        <h3>Every write is a replayable event</h3>\n        <p>Append-only, LSM-backed storage means <b>time-travel isn't a feature, it's the default.</b> Diff any two snapshots, rollback a bad merge, and audit every row's lineage \u2014 in plain SQL.</p>\n      </div>\n      <div class=\"ledger-row\">\n        <span class=\"idx\">/03</span>\n        <h3>Schema drift is data, not an error</h3>\n        <p>SILT tracks column evolution as a queryable log. <b>WHERE schema_version != previous</b> beats a 2 a.m. pager duty escalation. Breaking changes are detected, surfaced, and versioned \u2014 never silent.</p>\n      </div>\n      <div class=\"ledger-row\">\n        <span class=\"idx\">/04</span>\n        <h3>Boring to operate is a feature</h3>\n        <p>One static binary, ~40&nbsp;MB, no JVM, no coordinator nodes, no YAML cathedral. <b>It runs on your laptop exactly like it runs in prod.</b> Backpressure, not crashes.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ CONSOLE ============ -->\n<section class=\"console-sec\" id=\"console\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"sec-num\" style=\"color:var(--signal)\">02</span>\n      <h2 class=\"sec-title\" style=\"color:var(--paper)\">Try the engine</h2>\n      <span class=\"sec-note\">Live \u2014 runs on 2.1M simulated rows, in your browser</span>\n    </div>\n    <div class=\"console\">\n      <div class=\"console-side\">\n        <h4>Pick a query</h4>\n        <button class=\"q-chip active\" data-q=\"p95\">Top regions by p95 latency</button>\n        <button class=\"q-chip\" data-q=\"scan\">Bytes scanned per pipeline, 7d</button>\n        <button class=\"q-chip\" data-q=\"drift\">Detect schema drift events</button>\n        <div class=\"ds\">\n          table: <b>events_2025</b><br>\n          partitions: <b>daily</b><br>\n          rows: <b>2,147,483</b><br>\n          storage: <b>parquet / zstd</b>\n        </div>\n      </div>\n      <div class=\"console-main\">\n        <div class=\"q-display mono\" id=\"qDisplay\"></div>\n        <div class=\"q-run\">\n          <button class=\"run-btn\" id=\"runBtn\" onclick=\"runQuery()\">Run query \u23ce</button>\n          <div class=\"q-stat\" id=\"qStat\"><span>press <b>Run</b> or hit <b>\u2318\u21b5</b></span></div>\n        </div>\n        <div class=\"res-scroll\"><div class=\"res-empty\" id=\"resArea\">// results will appear here \u2014 pick a query on the left</div></div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ BENCHMARK ============ -->\n<section id=\"bench\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"sec-num\">03</span>\n      <h2 class=\"sec-title\">1 TB TPC-H, single node</h2>\n      <span class=\"sec-note\">geometric mean of 22 queries \u00b7 lower is better</span>\n    </div>\n    <div class=\"bench\">\n      <div class=\"bench-copy\">\n        <p><b>No cherry-picked queries.</b> The full TPC-H suite at 1&nbsp;TB scale factor, cold cache, one <b>c6id.8xlarge</b> with a single NVMe volume. SILT ships a vectorized execution engine with SIMD-native filters, late materialization, and join-order search that finishes before your coffee cools.</p>\n        <p>The same binary handles streaming upserts on the side \u2014 so your batch and your CDC land in <b>one engine, one copy of the truth</b>, not two systems stitched together with dbt glue and hope.</p>\n        <div class=\"foot\">Reproduce it: <b>git clone silt/benchmarks && make tpch-1tb</b><br>All harness code is public. Rerun it, break it, tell us.</div>\n      </div>\n      <div class=\"chart\" id=\"chartBox\">\n        <h4>End-to-end runtime \u00b7 seconds \u00b7 22-query geomean</h4>\n        <div id=\"chart\"></div>\n        <div class=\"axis\"><span>0s</span><span>25s</span><span>50s</span><span>75s</span><span>100s</span></div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ CODE ============ -->\n<section class=\"code-sec\" id=\"code\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"sec-num\">04</span>\n      <h2 class=\"sec-title\">Query it your way</h2>\n      <span class=\"sec-note\">SQL, Python, or declarative pipelines</span>\n    </div>\n    <div class=\"tabs\" id=\"tabs\">\n      <button class=\"tab active\" data-t=\"sql\">SQL</button>\n      <button class=\"tab\" data-t=\"py\">Python</button>\n      <button class=\"tab\" data-t=\"go\">Go</button>\n    </div>\n    <div class=\"codebox\" id=\"codebox\"></div>\n  </div>\n</section>\n\n<!-- ============ CTA ============ -->\n<section>\n  <div class=\"wrap cta\">\n    <h2>Ship the lakehouse.<br><em>Keep the weekend.</em></h2>\n    <div class=\"actions\">\n      <a class=\"btn\" style=\"padding:16px 30px;font-size:13px\" href=\"#top\" onclick=\"toast('Repo link would open here \u2014 go star it \u2b50');return false\">Star on GitHub</a>\n      <a class=\"btn ghost\" style=\"padding:16px 30px;font-size:13px\" href=\"#top\" onclick=\"toast('Discord invite would open here');return false\">Join the Discord</a>\n      <span class=\"mono\" style=\"font-size:12px;color:var(--ink-60)\">MIT-friendly \u00b7 Apache-2.0 \u00b7 412 contributors</span>\n    </div>\n  </div>\n</section>\n\n<!-- ============ FOOTER ============ -->\n<footer>\n  <div class=\"wrap\">\n    <div class=\"foot-grid\">\n      <div>\n        <div class=\"flogo\">\n          <svg width=\"24\" height=\"24\" viewBox=\"0 0 26 26\" fill=\"none\">\n            <rect x=\"1\" y=\"1\" width=\"24\" height=\"24\" stroke=\"currentColor\" stroke-width=\"2\"/>\n            <path d=\"M5 17h4v4H5zM10.5 11h4v10h-4zM16 5h4v16h-4z\" fill=\"#E5470F\"/>\n          </svg>\n          SILT\n        </div>\n        <p>The open-source columnar engine for people whose job title contains the word \"pipeline\".</p>\n      </div>\n      <div>\n        <h5>Project</h5>\n        <ul>\n          <li><a href=\"#top\" onclick=\"toast('GitHub would open here');return false\">GitHub</a></li>\n          <li><a href=\"#top\" onclick=\"toast('Roadmap would open here');return false\">Roadmap</a></li>\n          <li><a href=\"#top\" onclick=\"toast('Changelog would open here');return false\">Changelog</a></li>\n          <li><a href=\"#top\" onclick=\"toast('RFCs would open here');return false\">RFCs</a></li>\n        </ul>\n      </div>\n      <div>\n        <h5>Learn</h5>\n        <ul>\n          <li><a href=\"#code\">Quickstart</a></li>\n          <li><a href=\"#bench\">Benchmarks</a></li>\n          <li><a href=\"#top\" onclick=\"toast('Architecture doc would open here');return false\">Architecture</a></li>\n          <li><a href=\"#top\" onclick=\"toast('Blog would open here');return false\">Blog</a></li>\n        </ul>\n      </div>\n      <div>\n        <h5>Community</h5>\n        <ul>\n          <li><a href=\"#top\" onclick=\"toast('Discord would open here');return false\">Discord</a></li>\n          <li><a href=\"#top\" onclick=\"toast('Slack would open here');return false\">Slack</a></li>\n          <li><a href=\"#top\" onclick=\"toast('Twitter/X would open here');return false\">Twitter</a></li>\n          <li><a href=\"#top\" onclick=\"toast('Code of conduct would open here');return false\">Conduct</a></li>\n        </ul>\n      </div>\n    </div>\n    <div class=\"foot-base\">\n      <span>\u00a9 2025 The SILT contributors \u00b7 Apache-2.0</span>\n      <span>built with Rust \u00b7 v0.9.4</span>\n    </div>\n  </div>\n</footer>\n\n<div id=\"toast\"></div>\n\n<script>\n/* ---------- toast ---------- */\nlet toastTimer;\nfunction toast(msg){\n  const t=document.getElementById('toast');\n  t.textContent=msg;t.classList.add('show');\n  clearTimeout(toastTimer);\n  toastTimer=setTimeout(()=>t.classList.remove('show'),2400);\n}\nfunction copyInstall(){\n  navigator.clipboard&&navigator.clipboard.writeText(document.getElementById('installCmd').textContent);\n  toast('install command copied to clipboard');\n}\n\n/* ---------- ticker ---------- */\nconst words=['zero-copy','vectorized','acid streams','time-travel','schema drift aware','simd filters','parquet native','single binary','late materialization','ttl compaction'];\nconst half=words.map(w=>`<span>${w}<em>//</em></span>`).join('');\ndocument.getElementById('tickerTrack').innerHTML=half+half;\n\n/* ---------- hero typing terminal ---------- */\nconst termEl=document.getElementById('term');\nconst script=[\n  {t:'<span class=\"t-p\">$ </span>silt attach s3://acme-lake/events/',d:520},\n  {t:'<span class=\"t-dim\">mounted 412 files \u00b7 2.1 TB parquet \u00b7 0 bytes copied</span>',d:340},\n  {t:'<span class=\"t-p\">$ </span><span class=\"t-k\">SELECT</span> region, count(*) <span class=\"t-k\">FROM</span> events',d:300},\n  {t:'<span class=\"t-dim\">         </span><span class=\"t-k\">WHERE</span> ts >= yesterday() <span class=\"t-k\">GROUP BY</span> 1;',d:180},\n  {t:'<span class=\"t-ok\">\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510</span>',d:60},\n  {t:'<span class=\"t-ok\">\u2502 region         \u2502 count     \u2502</span>',d:60},\n  {t:'<span class=\"t-ok\">\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524</span>',d:60},\n  {t:'<span class=\"t-ok\">\u2502 eu-central     \u2502 8,142,905 \u2502</span>',d:60},\n  {t:'<span class=\"t-ok\">\u2502 us-east        \u2502 7,301,442 \u2502</span>',d:60},\n  {t:'<span class=\"t-ok\">\u2502 ap-south       \u2502 2,447,013 \u2502</span>',d:60},\n  {t:'<span class=\"t-ok\">\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518</span>',d:60},\n  {t:'<span class=\"t-dim\">scanned 41 GB \u00b7 projected 2 cols \u00b7 0.31 s \u00b7 SIMD on</span>',d:400},\n];\nlet li=0;\nfunction typeLine(){\n  if(li>=script.length)return;\n  const line=script[li];\n  const div=document.createElement('div');\n  div.className='t-line';div.innerHTML=line.t;termEl.appendChild(div);\n  li++;setTimeout(typeLine,line.d);\n}\ntypeLine();\ndocument.getElementById('termTime').textContent=new Date().toTimeString().slice(0,8);\n\n/* star count ticks up subtly */\nlet stars=24318;\nsetInterval(()=>{stars++;document.getElementById('starCount').textContent=stars.toLocaleString()},9000);\n\n/* ---------- live console ---------- */\nconst QUERIES={\n  p95:{\n    sql:'<span class=\"k\">SELECT</span> region,\\n       approx_percentile(latency_ms, 0.95) <span class=\"k\">AS</span> p95,\\n       count(*) <span class=\"k\">AS</span> reqs\\n<span class=\"k\">FROM</span> events_2025\\n<span class=\"k\">GROUP BY</span> region\\n<span class=\"k\">ORDER BY</span> p95 <span class=\"k\">DESC</span>;',\n    cols:['region','p95_ms','reqs'],\n    rows:[\n      ['ap-south','412.7','2,447,013',100],\n      ['us-west','287.3','5,102,884',69],\n      ['eu-central','198.1','8,142,905',48],\n      ['us-east','141.6','7,301,442',34],\n      ['sa-east',' 96.4','1,255,239',23],\n    ]\n  },\n  scan:{\n    sql:'<span class=\"k\">SELECT</span> pipeline,\\n       sum(bytes_scanned) / 1e9 <span class=\"k\">AS</span> gb,\\n       sum(rows) <span class=\"k\">AS</span> rows_read\\n<span class=\"k\">FROM</span> system.query_log\\n<span class=\"k\">WHERE</span> ts >= now() - <span class=\"k\">INTERVAL</span> 7 <span class=\"k\">DAY</span>\\n<span class=\"k\">GROUP BY</span> pipeline <span class=\"k\">ORDER BY</span> gb <span class=\"k\">DESC</span>;',\n    cols:['pipeline','gb_scanned','rows_read'],\n    rows:[\n      ['fct_orders_cdc','18,441.2','912,004,118',100],\n      ['dim_users_nightly','9,208.7','431,772,450',50],\n      ['rt_clickstream','6,930.4','1,908,411,207',38],\n      ['fin_recon_hourly','2,104.9','88,209,431',11],\n      ['ml_features_15m','  984.2','204,882,090',5],\n    ]\n  },\n  drift:{\n    sql:'<span class=\"k\">SELECT</span> table_name, schema_version,\\n       changed_columns, detected_at\\n<span class=\"k\">FROM</span> system.schema_log\\n<span class=\"k\">WHERE</span> schema_version != lag(schema_version)\\n<span class=\"k\">ORDER BY</span> detected_at <span class=\"k\">DESC</span>;',\n    cols:['table_name','ver','changed_columns','detected_at'],\n    rows:[\n      ['fct_orders_cdc','14 \u2192 15','+discount_code','2025-06-11 03:12',100],\n      ['rt_clickstream',' 8 \u2192  9','ua_family: widen','2025-06-09 14:47',66],\n      ['dim_users',' 21 \u2192 22','-fax_number','2025-06-02 22:03',41],\n      ['fin_ledger','  5 \u2192  6','amount: dec\u2192dec(18,4)','2025-05-28 11:40',19],\n    ]\n  }\n};\nlet currentQ='p95';\nconst qDisplay=document.getElementById('qDisplay');\nconst statEl=document.getElementById('qStat');\nconst resArea=document.getElementById('resArea');\n\nfunction renderQuery(){\n  qDisplay.innerHTML=QUERIES[currentQ].sql;\n}\nfunction selectQ(q,chip){\n  currentQ=q;\n  document.querySelectorAll('.q-chip').forEach(c=>c.classList.remove('active'));\n  chip.classList.add('active');\n  renderQuery();\n  statEl.innerHTML='<span>ready \u2014 press <b>Run</b></span>';\n  resArea.className='res-empty';\n  resArea.innerHTML='// results will appear here \u2014 press Run';\n}\ndocument.querySelectorAll('.q-chip').forEach(chip=>{\n  chip.addEventListener('click',()=>selectQ(chip.dataset.q,chip));\n});\nrenderQuery();\n\nfunction runQuery(){\n  const btn=document.getElementById('runBtn');\n  btn.disabled=true;btn.textContent='Executing\u2026';\n  statEl.innerHTML='<span>planning\u2026</span>';\n  resArea.className='res-empty';\n  resArea.textContent='// scanning partitions\u2026';\n  const t0=performance.now();\n  const think=260+Math.random()*220;\n  setTimeout(()=>{\n    const q=QUERIES[currentQ];\n    const ms=(think+18+Math.random()*22);\n    let html='<table class=\"res\"><thead><tr>'+q.cols.map((c,i)=>`<th${i>0?' class=\"num\"':''}>${c}</th>`).join('')+'</tr></thead><tbody>';\n    q.rows.forEach((r,ri)=>{\n      html+='<tr style=\"animation-delay:'+(ri*70)+'ms\">'+r.map((cell,ci)=>{\n        if(ci===r.length-1){ // bar width\n          return `<td class=\"num\"><span class=\"bar\" style=\"width:${cell*1.4}px\"></span></td>`;\n        }\n        return `<td${ci>0?' class=\"num\"':''}>${cell}</td>`;\n      }).join('')+'</tr>';\n    });\n    html+='</tbody></table>';\n    resArea.className='res-scroll';\n    resArea.innerHTML=html;\n    const elapsed=ms.toFixed(0);\n    const scanned=(Math.random()*38+8).toFixed(1);\n    statEl.innerHTML=\n      `<span class=\"ok\">\u2713 ${q.rows.length} rows in <b>${elapsed} ms</b></span>`+\n      `<span>scanned <b>${scanned} GB</b></span>`+\n      `<span>pruned <b>97.4%</b></span>`;\n    btn.disabled=false;btn.textContent='Run query \u23ce';\n  },think);\n}\ndocument.addEventListener('keydown',e=>{\n  if((e.metaKey||e.ctrlKey)&&e.key==='Enter'){e.preventDefault();runQuery();}\n});\n\n/* ---------- benchmark chart ---------- */\nconst bench=[\n  {name:'SILT 0.9',val:8.4,silt:true},\n  {name:'DuckDB',val:23.1},\n  {name:'ClickHouse',val:31.7},\n  {name:'Trino',val:67.2},\n  {name:'Spark 3.5',val:96.8},\n];\nconst chart=document.getElementById('chart');\nchart.innerHTML=bench.map(b=>`\n  <div class=\"brow${b.silt?' silt':''}\">\n    <span class=\"bname\">${b.name}</span>\n    <div class=\"btrack\"><div class=\"bfill\" data-w=\"${b.val}\"></div></div>\n    <span class=\"bval\">${b.val.toFixed(1)}s</span>\n  </div>`).join('');\nlet benchPlayed=false;\nconst io=new IntersectionObserver(es=>{\n  es.forEach(e=>{\n    if(e.isIntersecting&&!benchPlayed){\n      benchPlayed=true;\n      document.querySelectorAll('.bfill').forEach(f=>{\n        requestAnimationFrame(()=>{f.style.width=(f.dataset.w/100*100)+'%'});\n      });\n    }\n  });\n},{threshold:.4});\nio.observe(document.getElementById('chartBox'));\n\n/* ---------- code tabs ---------- */\nconst CODE={\nsql:`<span class=\"c\">-- attach a lake, time-travel, done.</span>\n<span class=\"k\">ATTACH</span> <span class=\"s\">'s3://acme-lake'</span> <span class=\"k\">AS</span> <span class=\"n\">lake</span>;\n\n<span class=\"k\">SELECT</span>  o.status,\n        sum(o.amount)  <span class=\"k\">AS</span> gmv,\n        count(<span class=\"k\">DISTINCT</span> o.user_id) <span class=\"k\">AS</span> buyers\n<span class=\"k\">FROM</span>   lake.orders <span class=\"k\">AT SNAPSHOT</span> <span class=\"s\">'2025-06-01'</span> o\n<span class=\"k\">JOIN</span>   lake.users u <span class=\"k\">USING</span> (user_id)\n<span class=\"k\">WHERE</span>  o.ts >= <span class=\"s\">'2025-05-01'</span>\n<span class=\"k\">GROUP BY</span> 1\n<span class=\"k\">ORDER BY</span> gmv <span class=\"k\">DESC</span>;`,\npy:`<span class=\"c\"># python client \u2014 same engine, zero serialization pain</span>\n<span class=\"k\">import</span> silt\n\ndb = silt.attach(<span class=\"s\">\"s3://acme-lake\"</span>)\n\ndf = db.sql(<span class=\"s\">\"\"\"\n    SELECT region, approx_pctile(latency_ms, 0.95) AS p95\n    FROM events\n    WHERE ts >= now() - interval 1 day\n\"\"\"</span>).to_pandas()\n\n<span class=\"c\"># streams work too</span>\ndb.stream(<span class=\"s\">\"kafka://orders\"</span>).upsert_into(<span class=\"s\">\"fct_orders\"</span>, key=<span class=\"s\">\"order_id\"</span>)`,\ngo:`<span class=\"c\">// typed Go API \u2014 compile-time safe, cgo-free</span>\n<span class=\"k\">package</span> main\n\n<span class=\"k\">import</span> <span class=\"s\">\"github.com/silt-db/silt\"</span>\n\n<span class=\"k\">func</span> <span class=\"f\">main</span>() {\n    db, _ := silt.<span class=\"f\">Attach</span>(<span class=\"s\">\"s3://acme-lake\"</span>)\n    <span class=\"k\">defer</span> db.<span class=\"f\">Close</span>()\n\n    rows, _ := db.<span class=\"f\">Query</span>(<span class=\"s\">`\n        SELECT status, sum(amount) FROM orders\n        WHERE ts >= $1 GROUP BY 1`</span>, yesterday)\n\n    rows.<span class=\"f\">StreamTo</span>(silt.<span class=\"f\">Parquet</span>(<span class=\"s\">\"out/daily.parquet\"</span>))\n}`};\nconst codebox=document.getElementById('codebox');\nfunction setTab(t){\n  document.querySelectorAll('.tab').forEach(b=>b.classList.toggle('active',b.dataset.t===t));\n  codebox.innerHTML=CODE[t];\n}\ndocument.querySelectorAll('.tab').forEach(b=>b.addEventListener('click',()=>setTab(b.dataset.t)));\nsetTab('sql');\n</script>\n</body>\n</html>\n"}