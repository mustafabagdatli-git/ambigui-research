{"arm": "direct", "model": "anthropic/claude-haiku-5.5", "i": 8, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Tidepool: Plan your week together</title>\n<meta name=\"description\" content=\"Tidepool helps small teams plan their week together. One shared board, a five-minute Monday ritual, and nothing important slipping through the cracks.\">\n<style>\n  :root {\n    --sea-900: #0b2e33;\n    --sea-700: #135760;\n    --sea-500: #1f8a8a;\n    --sea-100: #d9efee;\n    --sand-50: #fbf8f2;\n    --sand-100: #f4eee3;\n    --sand-300: #e2d6bf;\n    --coral-500: #f0745c;\n    --coral-100: #fde4dd;\n    --ink: #1c2b2d;\n    --ink-soft: #4f6264;\n    --white: #ffffff;\n    --radius-lg: 20px;\n    --radius-md: 14px;\n    --radius-sm: 10px;\n    --shadow-md: 0 10px 30px rgba(11, 46, 51, 0.10);\n    --shadow-lg: 0 24px 60px rgba(11, 46, 51, 0.18);\n    --font-body: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n    --font-display: \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif;\n  }\n\n  *, *::before, *::after { box-sizing: border-box; }\n\n  html { scroll-behavior: smooth; }\n\n  body {\n    margin: 0;\n    font-family: var(--font-body);\n    color: var(--ink);\n    background: var(--sand-50);\n    line-height: 1.6;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  img, svg { display: block; max-width: 100%; }\n\n  a { color: var(--sea-700); text-decoration: none; }\n  a:hover { text-decoration: underline; }\n\n  h1, h2, h3 {\n    font-family: var(--font-display);\n    color: var(--sea-900);\n    line-height: 1.15;\n    margin: 0 0 0.5em;\n    font-weight: 600;\n  }\n\n  h1 { font-size: clamp(2.4rem, 5vw, 3.8rem); letter-spacing: -0.02em; }\n  h2 { font-size: clamp(1.9rem, 3.5vw, 2.6rem); letter-spacing: -0.01em; }\n  h3 { font-size: 1.25rem; font-family: var(--font-body); font-weight: 650; }\n\n  p { margin: 0 0 1em; }\n\n  .container {\n    width: min(1120px, 92vw);\n    margin: 0 auto;\n  }\n\n  section { padding: clamp(64px, 9vw, 112px) 0; }\n\n  .eyebrow {\n    display: inline-block;\n    font-size: 0.8rem;\n    font-weight: 700;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    color: var(--sea-500);\n    margin-bottom: 14px;\n  }\n\n  .lead {\n    font-size: clamp(1.05rem, 1.6vw, 1.2rem);\n    color: var(--ink-soft);\n    max-width: 58ch;\n  }\n\n  .section-head {\n    max-width: 680px;\n    margin-bottom: clamp(40px, 6vw, 64px);\n  }\n  .section-head.center { margin-left: auto; margin-right: auto; text-align: center; }\n  .section-head.center .lead { margin-left: auto; margin-right: auto; }\n\n  /* Buttons */\n  .btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    padding: 14px 24px;\n    border-radius: 999px;\n    font: inherit;\n    font-weight: 600;\n    font-size: 1rem;\n    border: 2px solid transparent;\n    cursor: pointer;\n    transition: transform 0.15s ease, background 0.2s ease, box-shadow 0.2s ease;\n    white-space: nowrap;\n  }\n  .btn:hover { text-decoration: none; transform: translateY(-1px); }\n  .btn:focus-visible, a:focus-visible, summary:focus-visible {\n    outline: 3px solid var(--coral-500);\n    outline-offset: 3px;\n  }\n  .btn-primary {\n    background: var(--coral-500);\n    color: var(--white);\n    box-shadow: 0 8px 20px rgba(240, 116, 92, 0.35);\n  }\n  .btn-primary:hover { background: #e3634b; color: var(--white); }\n  .btn-ghost {\n    background: transparent;\n    color: var(--sea-900);\n    border-color: var(--sea-900);\n  }\n  .btn-ghost:hover { background: var(--sea-900); color: var(--white); }\n  .btn-light {\n    background: var(--white);\n    color: var(--sea-900);\n  }\n  .btn-light:hover { background: var(--sand-100); color: var(--sea-900); }\n  .btn-block { width: 100%; }\n\n  /* Nav */\n  .nav {\n    position: sticky;\n    top: 0;\n    z-index: 50;\n    background: rgba(251, 248, 242, 0.88);\n    backdrop-filter: blur(10px);\n    -webkit-backdrop-filter: blur(10px);\n    border-bottom: 1px solid rgba(19, 87, 96, 0.08);\n  }\n  .nav-inner {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    height: 72px;\n    gap: 24px;\n  }\n  .logo {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    font-family: var(--font-display);\n    font-size: 1.4rem;\n    font-weight: 700;\n    color: var(--sea-900);\n  }\n  .logo:hover { text-decoration: none; }\n  .nav-links {\n    display: flex;\n    align-items: center;\n    gap: 28px;\n    list-style: none;\n    margin: 0;\n    padding: 0;\n  }\n  .nav-links a {\n    color: var(--ink-soft);\n    font-weight: 500;\n    font-size: 0.95rem;\n  }\n  .nav-links a:hover { color: var(--sea-900); text-decoration: none; }\n  .nav-cta { display: flex; align-items: center; gap: 18px; }\n  .nav-cta .signin { color: var(--sea-900); font-weight: 600; font-size: 0.95rem; }\n  .nav-cta .btn { padding: 10px 18px; font-size: 0.92rem; }\n\n  /* Hero */\n  .hero {\n    position: relative;\n    overflow: hidden;\n    padding: clamp(56px, 8vw, 96px) 0 clamp(72px, 10vw, 120px);\n    background:\n      radial-gradient(900px 500px at 85% -10%, var(--sea-100), transparent 60%),\n      radial-gradient(700px 400px at -10% 110%, #fbe3d6, transparent 60%),\n      var(--sand-50);\n  }\n  .hero-grid {\n    display: grid;\n    grid-template-columns: 1.05fr 1fr;\n    gap: clamp(40px, 6vw, 72px);\n    align-items: center;\n  }\n  .hero h1 em {\n    font-style: italic;\n    color: var(--sea-500);\n  }\n  .hero .lead { margin-bottom: 32px; }\n  .hero-actions {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 14px;\n    align-items: center;\n    margin-bottom: 20px;\n  }\n  .hero-note {\n    font-size: 0.9rem;\n    color: var(--ink-soft);\n  }\n  .hero-note strong { color: var(--sea-900); }\n\n  /* Board mockup */\n  .board {\n    background: var(--white);\n    border-radius: var(--radius-lg);\n    box-shadow: var(--shadow-lg);\n    border: 1px solid rgba(19, 87, 96, 0.08);\n    padding: 20px;\n    position: relative;\n    transform: rotate(-1deg);\n  }\n  .board-top {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    margin-bottom: 16px;\n    padding-bottom: 14px;\n    border-bottom: 1px solid var(--sand-100);\n  }\n  .board-title {\n    font-weight: 700;\n    color: var(--sea-900);\n    font-size: 0.95rem;\n  }\n  .board-title span {\n    display: block;\n    font-weight: 500;\n    color: var(--ink-soft);\n    font-size: 0.8rem;\n  }\n  .avatars { display: flex; }\n  .avatar {\n    width: 30px;\n    height: 30px;\n    border-radius: 50%;\n    display: grid;\n    place-items: center;\n    font-size: 0.72rem;\n    font-weight: 700;\n    color: var(--white);\n    border: 2px solid var(--white);\n    margin-left: -8px;\n  }\n  .avatar:first-child { margin-left: 0; }\n  .a1 { background: var(--sea-500); }\n  .a2 { background: var(--coral-500); }\n  .a3 { background: #6b5ca5; }\n  .a4 { background: #c98b2b; }\n\n  .days {\n    display: grid;\n    grid-template-columns: repeat(5, 1fr);\n    gap: 8px;\n  }\n  .day {\n    background: var(--sand-100);\n    border-radius: var(--radius-sm);\n    padding: 10px 8px;\n    min-height: 260px;\n  }\n  .day-name {\n    font-size: 0.72rem;\n    text-transform: uppercase;\n    letter-spacing: 0.08em;\n    font-weight: 700;\n    color: var(--ink-soft);\n    margin-bottom: 10px;\n    display: flex;\n    justify-content: space-between;\n  }\n  .day-name b { color: var(--sea-900); }\n  .day.today { background: var(--sea-100); }\n  .day.today .day-name b { color: var(--coral-500); }\n\n  .card {\n    background: var(--white);\n    border-radius: 8px;\n    padding: 8px 9px;\n    font-size: 0.78rem;\n    line-height: 1.35;\n    color: var(--ink);\n    margin-bottom: 8px;\n    box-shadow: 0 2px 6px rgba(11, 46, 51, 0.06);\n    border-left: 3px solid var(--sea-500);\n  }\n  .card.coral { border-left-color: var(--coral-500); }\n  .card.purple { border-left-color: #6b5ca5; }\n  .card.gold { border-left-color: #c98b2b; }\n  .card.done { opacity: 0.55; text-decoration: line-through; }\n  .card small {\n    display: block;\n    color: var(--ink-soft);\n    font-size: 0.68rem;\n    margin-top: 3px;\n  }\n\n  .float-chip {\n    position: absolute;\n    right: -18px;\n    bottom: -22px;\n    background: var(--sea-900);\n    color: var(--white);\n    border-radius: var(--radius-md);\n    padding: 14px 16px;\n    box-shadow: var(--shadow-md);\n    font-size: 0.85rem;\n    max-width: 220px;\n    transform: rotate(2deg);\n  }\n  .float-chip strong { display: block; font-size: 0.95rem; margin-bottom: 2px; }\n  .float-chip span { opacity: 0.8; }\n\n  /* Problem */\n  .problem { background: var(--white); }\n  .problem-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 24px;\n  }\n  .problem-item {\n    padding: 28px;\n    border-radius: var(--radius-lg);\n    background: var(--sand-50);\n    border: 1px solid var(--sand-300);\n  }\n  .problem-item .num {\n    font-family: var(--font-display);\n    font-size: 2.4rem;\n    color: var(--coral-500);\n    line-height: 1;\n    margin-bottom: 12px;\n  }\n  .problem-item p { color: var(--ink-soft); margin: 0; }\n\n  /* Features */\n  .features-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 24px;\n  }\n  .feature {\n    background: var(--white);\n    border-radius: var(--radius-lg);\n    padding: 32px 28px;\n    box-shadow: var(--shadow-md);\n    border: 1px solid rgba(19, 87, 96, 0.06);\n    transition: transform 0.2s ease;\n  }\n  .feature:hover { transform: translateY(-4px); }\n  .icon {\n    width: 52px;\n    height: 52px;\n    border-radius: 14px;\n    display: grid;\n    place-items: center;\n    background: var(--sea-100);\n    color: var(--sea-700);\n    margin-bottom: 20px;\n  }\n  .icon.coral { background: var(--coral-100); color: var(--coral-500); }\n  .icon svg { width: 26px; height: 26px; }\n  .feature p { color: var(--ink-soft); margin: 0; font-size: 0.97rem; }\n\n  /* How it works */\n  .how { background: var(--sea-900); color: var(--sand-50); }\n  .how h2 { color: var(--white); }\n  .how .eyebrow { color: #7fd1cf; }\n  .how .lead { color: #b8d3d2; }\n  .steps {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 32px;\n    counter-reset: step;\n    position: relative;\n  }\n  .step {\n    padding-top: 22px;\n    border-top: 2px solid rgba(127, 209, 207, 0.35);\n  }\n  .step-num {\n    display: inline-grid;\n    place-items: center;\n    width: 40px;\n    height: 40px;\n    border-radius: 50%;\n    background: var(--coral-500);\n    color: var(--white);\n    font-weight: 700;\n    margin-bottom: 18px;\n  }\n  .step h3 { color: var(--white); }\n  .step p { color: #b8d3d2; margin: 0; }\n\n  /* Testimonial */\n  .quote-wrap {\n    display: grid;\n    grid-template-columns: 1fr;\n    justify-items: center;\n    text-align: center;\n  }\n  .quote {\n    font-family: var(--font-display);\n    font-size: clamp(1.4rem, 2.8vw, 2rem);\n    line-height: 1.4;\n    color: var(--sea-900);\n    max-width: 760px;\n    margin: 0 0 24px;\n    position: relative;\n  }\n  .quote::before {\n    content: \"\\201C\";\n    font-size: 4rem;\n    line-height: 0;\n    color: var(--coral-500);\n    display: block;\n    height: 28px;\n    margin-bottom: 6px;\n  }\n  .quote-author {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    color: var(--ink-soft);\n    font-size: 0.95rem;\n  }\n  .quote-author strong { color: var(--sea-900); display: block; }\n\n  /* Pricing */\n  .pricing { background: var(--white); }\n  .plans {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 24px;\n    align-items: stretch;\n  }\n  .plan {\n    border: 1px solid var(--sand-300);\n    border-radius: var(--radius-lg);\n    padding: 36px 30px;\n    display: flex;\n    flex-direction: column;\n    background: var(--sand-50);\n  }\n  .plan.featured {\n    background: var(--sea-900);\n    border-color: var(--sea-900);\n    color: var(--sand-50);\n    box-shadow: var(--shadow-lg);\n    transform: translateY(-8px);\n  }\n  .plan.featured h3,\n  .plan.featured .price,\n  .plan.featured .plan-desc { color: var(--white); }\n  .plan.featured .plan-desc,\n  .plan.featured li { color: #cfe6e5; }\n  .plan.featured .tag {\n    background: var(--coral-500);\n    color: var(--white);\n  }\n  .tag {\n    align-self: flex-start;\n    font-size: 0.75rem;\n    font-weight: 700;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n    padding: 5px 10px;\n    border-radius: 999px;\n    background: var(--sea-100);\n    color: var(--sea-700);\n    margin-bottom: 18px;\n  }\n  .plan-desc { color: var(--ink-soft); font-size: 0.95rem; margin-bottom: 20px; }\n  .price {\n    font-family: var(--font-display);\n    font-size: 2.8rem;\n    color: var(--sea-900);\n    line-height: 1;\n    margin-bottom: 4px;\n  }\n  .price small {\n    font-family: var(--font-body);\n    font-size: 0.95rem;\n    font-weight: 500;\n    color: var(--ink-soft);\n  }\n  .plan.featured .price small { color: #b8d3d2; }\n  .plan ul {\n    list-style: none;\n    padding: 0;\n    margin: 24px 0 32px;\n    flex: 1;\n  }\n  .plan li {\n    position: relative;\n    padding-left: 28px;\n    margin-bottom: 12px;\n    font-size: 0.97rem;\n    color: var(--ink-soft);\n  }\n  .plan li::before {\n    content: \"\";\n    position: absolute;\n    left: 0;\n    top: 6px;\n    width: 14px;\n    height: 14px;\n    border-radius: 50%;\n    background: var(--sea-100);\n    box-shadow: inset 0 0 0 4px var(--sea-500);\n  }\n  .plan.featured li::before {\n    background: rgba(127, 209, 207, 0.2);\n    box-shadow: inset 0 0 0 4px #7fd1cf;\n  }\n\n  /* FAQ */\n  .faq-wrap {\n    display: grid;\n    grid-template-columns: 0.8fr 1.2fr;\n    gap: clamp(32px, 6vw, 80px);\n    align-items: start;\n  }\n  .faq-wrap .lead { margin-bottom: 24px; }\n  details {\n    border-bottom: 1px solid var(--sand-300);\n    padding: 20px 0;\n  }\n  details:first-child { border-top: 1px solid var(--sand-300); }\n  summary {\n    cursor: pointer;\n    list-style: none;\n    font-weight: 600;\n    color: var(--sea-900);\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    gap: 16px;\n    font-size: 1.05rem;\n  }\n  summary::-webkit-details-marker { display: none; }\n  summary::after {\n    content: \"+\";\n    font-size: 1.5rem;\n    line-height: 1;\n    color: var(--coral-500);\n    transition: transform 0.2s ease;\n  }\n  details[open] summary::after { content: \"\\2212\"; }\n  details p {\n    margin: 12px 0 0;\n    color: var(--ink-soft);\n  }\n\n  /* Final CTA */\n  .final {\n    padding: 0 0 clamp(64px, 9vw, 112px);\n    background: var(--sand-50);\n  }\n  .final-card {\n    background:\n      radial-gradient(600px 300px at 90% 0%, rgba(240, 116, 92, 0.35), transparent 60%),\n      linear-gradient(135deg, var(--sea-700), var(--sea-900));\n    color: var(--white);\n    border-radius: 28px;\n    padding: clamp(40px, 6vw, 72px);\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    justify-content: space-between;\n    gap: 32px;\n    box-shadow: var(--shadow-lg);\n  }\n  .final-card h2 { color: var(--white); margin-bottom: 8px; }\n  .final-card p { color: #cfe6e5; margin: 0; max-width: 50ch; }\n  .final-actions { display: flex; flex-wrap: wrap; gap: 12px; }\n  .final-actions .btn-ghost {\n    color: var(--white);\n    border-color: rgba(255,255,255,0.5);\n  }\n  .final-actions .btn-ghost:hover { background: var(--white); color: var(--sea-900); }\n\n  /* Footer */\n  footer {\n    border-top: 1px solid var(--sand-300);\n    padding: 48px 0 40px;\n    background: var(--sand-100);\n    font-size: 0.92rem;\n    color: var(--ink-soft);\n  }\n  .footer-grid {\n    display: grid;\n    grid-template-columns: 2fr repeat(3, 1fr);\n    gap: 32px;\n    margin-bottom: 36px;\n  }\n  .footer-grid h4 {\n    font-size: 0.78rem;\n    text-transform: uppercase;\n    letter-spacing: 0.1em;\n    color: var(--sea-900);\n    margin: 0 0 14px;\n  }\n  .footer-grid ul { list-style: none; padding: 0; margin: 0; }\n  .footer-grid li { margin-bottom: 8px; }\n  .footer-grid a { color: var(--ink-soft); }\n  .footer-grid a:hover { color: var(--sea-900); }\n  .footer-brand p { max-width: 36ch; margin-top: 12px; }\n  .footer-bottom {\n    display: flex;\n    justify-content: space-between;\n    flex-wrap: wrap;\n    gap: 12px;\n    padding-top: 24px;\n    border-top: 1px solid var(--sand-300);\n    font-size: 0.85rem;\n  }\n\n  /* Responsive */\n  @media (max-width: 960px) {\n    .hero-grid { grid-template-columns: 1fr; }\n    .board { transform: none; }\n    .float-chip { right: 12px; bottom: -20px; }\n    .problem-grid,\n    .features-grid { grid-template-columns: 1fr 1fr; }\n    .steps { grid-template-columns: 1fr; gap: 28px; }\n    .plans { grid-template-columns: 1fr; max-width: 460px; margin: 0 auto; }\n    .plan.featured { transform: none; }\n    .faq-wrap { grid-template-columns: 1fr; }\n    .footer-grid { grid-template-columns: 1fr 1fr; }\n    .nav-links { display: none; }\n  }\n\n  @media (max-width: 640px) {\n    .problem-grid,\n    .features-grid { grid-template-columns: 1fr; }\n    .days { grid-template-columns: 1fr 1fr; }\n    .day { min-height: auto; }\n    .day.hide-sm { display: none; }\n    .nav-cta .signin { display: none; }\n    .float-chip { position: static; margin-top: 16px; transform: none; max-width: none; }\n    .final-card { flex-direction: column; align-items: flex-start; }\n    .footer-grid { grid-template-columns: 1fr; }\n    .hero-actions .btn { width: 100%; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    html { scroll-behavior: auto; }\n    *, *::before, *::after { transition: none !important; }\n  }\n</style>\n</head>\n<body>\n\n<header class=\"nav\">\n  <div class=\"container nav-inner\">\n    <a href=\"#top\" class=\"logo\" aria-label=\"Tidepool home\">\n      <svg width=\"30\" height=\"30\" viewBox=\"0 0 32 32\" aria-hidden=\"true\">\n        <circle cx=\"16\" cy=\"16\" r=\"15\" fill=\"#135760\"/>\n        <path d=\"M6 17c3-3 5-3 8 0s5 3 8 0 4-2 4-2\" stroke=\"#7fd1cf\" stroke-width=\"2.6\" fill=\"none\" stroke-linecap=\"round\"/>\n        <path d=\"M6 22c3-3 5-3 8 0s5 3 8 0 4-2 4-2\" stroke=\"#f0745c\" stroke-width=\"2.6\" fill=\"none\" stroke-linecap=\"round\"/>\n      </svg>\n      Tidepool\n    </a>\n\n    <ul class=\"nav-links\">\n      <li><a href=\"#features\">Features</a></li>\n      <li><a href=\"#how\">How it works</a></li>\n      <li><a href=\"#pricing\">Pricing</a></li>\n      <li><a href=\"#faq\">FAQ</a></li>\n    </ul>\n\n    <div class=\"nav-cta\">\n      <a href=\"#\" class=\"signin\">Sign in</a>\n      <a href=\"#get-started\" class=\"btn btn-primary\">Start free</a>\n    </div>\n  </div>\n</header>\n\n<main id=\"top\">\n\n  <!-- HERO -->\n  <section class=\"hero\">\n    <div class=\"container hero-grid\">\n      <div>\n        <span class=\"eyebrow\">Weekly planning for small teams</span>\n        <h1>Know what your team is doing <em>this week</em>, before Monday starts.</h1>\n        <p class=\"lead\">Tidepool gives teams of 2 to 12 one shared board for the week. Everyone sees the plan, handoffs stay visible, and a five-minute Monday check-in keeps the week on track.</p>\n\n        <div class=\"hero-actions\">\n          <a href=\"#get-started\" class=\"btn btn-primary\" id=\"get-started\">Start planning free</a>\n          <a href=\"#how\" class=\"btn btn-ghost\">See how it works</a>\n        </div>\n        <p class=\"hero-note\"><strong>Free forever</strong> for teams up to 5. No credit card, no setup call.</p>\n      </div>\n\n      <div aria-label=\"Preview of the Tidepool weekly board\">\n        <div class=\"board\">\n          <div class=\"board-top\">\n            <div class=\"board-title\">\n              Product team\n              <span>Week of March 9</span>\n            </div>\n            <div class=\"avatars\" aria-hidden=\"true\">\n              <div class=\"avatar a1\">JL</div>\n              <div class=\"avatar a2\">MR</div>\n              <div class=\"avatar a3\">DK</div>\n              <div class=\"avatar a4\">SO</div>\n            </div>\n          </div>\n\n          <div class=\"days\">\n            <div class=\"day\">\n              <div class=\"day-name\">Mon <b>9</b></div>\n              <div class=\"card\">Sprint goals review <small>All hands \u00b7 30m</small></div>\n              <div class=\"card coral\">Ship onboarding copy <small>MR</small></div>\n              <div class=\"card done\">Triage bug queue <small>DK</small></div>\n            </div>\n            <div class=\"day\">\n              <div class=\"day-name\">Tue <b>10</b></div>\n              <div class=\"card purple\">Pricing interviews <small>JL \u00b7 2 calls</small></div>\n              <div class=\"card\">Design crit <small>SO</small></div>\n            </div>\n            <div class=\"day today\">\n              <div class=\"day-name\">Wed <b>11</b></div>\n              <div class=\"card coral\">Beta release <small>DK \u00b7 blocked on QA</small></div>\n              <div class=\"card gold\">Review signup funnel <small>JL</small></div>\n              <div class=\"card\">Customer notes sync <small>MR</small></div>\n            </div>\n            <div class=\"day hide-sm\">\n              <div class=\"day-name\">Thu <b>12</b></div>\n              <div class=\"card\">Write release notes <small>MR</small></div>\n            </div>\n            <div class=\"day hide-sm\">\n              <div class=\"day-name\">Fri <b>13</b></div>\n              <div class=\"card done\">Retro <small>All</small></div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"float-chip\" role=\"note\">\n          <strong>Monday check-in: 4 min</strong>\n          <span>3 blockers flagged, 1 handoff confirmed.</span>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- PROBLEM -->\n  <section class=\"problem\" aria-labelledby=\"problem-title\">\n    <div class=\"container\">\n      <div class=\"section-head\">\n        <span class=\"eyebrow\">The problem</span>\n        <h2 id=\"problem-title\">Small teams don't need more tools. They need one clear week.</h2>\n        <p class=\"lead\">Plans live in chat threads, half-written docs, and somebody's head. By Wednesday, nobody is sure who owns what.</p>\n      </div>\n\n      <div class=\"problem-grid\">\n        <div class=\"problem-item\">\n          <div class=\"num\">01</div>\n          <h3>Plans scatter across channels</h3>\n          <p>Priorities are in Slack, tasks are in a tracker, and the real commitments are in a call nobody wrote down.</p>\n        </div>\n        <div class=\"problem-item\">\n          <div class=\"num\">02</div>\n          <h3>Handoffs quietly fall through</h3>\n          <p>\"I thought you were sending that\" is the most expensive sentence on a small team. It usually shows up on Thursday.</p>\n        </div>\n        <div class=\"problem-item\">\n          <div class=\"num\">03</div>\n          <h3>Planning takes too long</h3>\n          <p>Full project-management suites are built for bigger orgs. Your team wants a short ritual, not another system to maintain.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- FEATURES -->\n  <section id=\"features\" aria-labelledby=\"features-title\">\n    <div class=\"container\">\n      <div class=\"section-head center\">\n        <span class=\"eyebrow\">Features</span>\n        <h2 id=\"features-title\">Everything the week needs. Nothing it doesn't.</h2>\n        <p class=\"lead\">Tidepool stays deliberately small so your team spends its time doing the work, not configuring the tool.</p>\n      </div>\n\n      <div class=\"features-grid\">\n        <article class=\"feature\">\n          <div class=\"icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/>\n              <path d=\"M3 9h18M9 4v16M15 4v16\"/>\n            </svg>\n          </div>\n          <h3>One shared week</h3>\n          <p>A single board with Monday through Friday, plus a backlog for anything that isn't scheduled yet. Drag items between days and everyone sees the change instantly.</p>\n        </article>\n\n        <article class=\"feature\">\n          <div class=\"icon coral\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <circle cx=\"9\" cy=\"8\" r=\"3.5\"/>\n              <path d=\"M2.5 20c.7-3.3 3.2-5 6.5-5s5.8 1.7 6.5 5\"/>\n              <path d=\"M16 4.5a3.5 3.5 0 0 1 0 7M18.5 15c1.4.7 2.3 2 2.5 4\"/>\n            </svg>\n          </div>\n          <h3>Owners and handoffs</h3>\n          <p>Every item has one owner. When work moves between people, the handoff is explicit, acknowledged, and visible until it's done.</p>\n        </article>\n\n        <article class=\"feature\">\n          <div class=\"icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <path d=\"M12 3v3M12 18v3M3 12h3M18 12h3\"/>\n              <circle cx=\"12\" cy=\"12\" r=\"5\"/>\n              <path d=\"M9.5 12.5l1.8 1.8 3.2-3.6\"/>\n            </svg>\n          </div>\n          <h3>The Monday ritual</h3>\n          <p>A guided check-in walks the team through last week, flags blockers, and confirms the plan in about five minutes. Nothing gets planned twice.</p>\n        </article>\n\n        <article class=\"feature\">\n          <div class=\"icon coral\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <path d=\"M4 6h16M4 12h10M4 18h7\"/>\n              <path d=\"M17 15l2 2 3-4\" />\n            </svg>\n          </div>\n          <h3>Blockers at a glance</h3>\n          <p>Mark something blocked and it rises to the top of the board, with the reason attached. Nobody has to ask \"so what's stuck?\" in standup.</p>\n        </article>\n\n        <article class=\"feature\">\n          <div class=\"icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <path d=\"M12 21s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.5-7 10-7 10z\"/>\n            </svg>\n          </div>\n          <h3>Focus time, protected</h3>\n          <p>Block deep-work hours on the calendar view so meetings don't eat the afternoon that someone planned for writing or building.</p>\n        </article>\n\n        <article class=\"feature\">\n          <div class=\"icon coral\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <path d=\"M4 5h16v11H9l-5 4z\"/>\n            </svg>\n          </div>\n          <h3>Notes that stay attached</h3>\n          <p>Comment on any item without starting another thread. Decisions and context stay with the work, so next week's you can find them.</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <!-- HOW IT WORKS -->\n  <section id=\"how\" class=\"how\" aria-labelledby=\"how-title\">\n    <div class=\"container\">\n      <div class=\"section-head\">\n        <span class=\"eyebrow\">How it works</span>\n        <h2 id=\"how-title\">A week in three steps.</h2>\n        <p class=\"lead\">Tidepool runs on a rhythm your team can keep, even in the busiest weeks.</p>\n      </div>\n\n      <div class=\"steps\">\n        <div class=\"step\">\n          <div class=\"step-num\">1</div>\n          <h3>Set up your team in a minute</h3>\n          <p>Invite your teammates with a link. Name the board, pick a start day, and you're ready. There's nothing to configure beyond that.</p>\n        </div>\n        <div class=\"step\">\n          <div class=\"step-num\">2</div>\n          <h3>Plan together on Monday</h3>\n          <p>Run the five-minute check-in. Drag work onto days, assign owners, and mark what's blocked. The whole team agrees on the same plan.</p>\n        </div>\n        <div class=\"step\">\n          <div class=\"step-num\">3</div>\n          <h3>Review and roll forward</h3>\n          <p>On Friday, see what shipped and what slipped. Unfinished items move to next week with their history intact, so nothing gets lost.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- TESTIMONIAL -->\n  <section aria-label=\"Customer testimonial\">\n    <div class=\"container quote-wrap\">\n      <p class=\"quote\">Our Monday meeting used to run forty minutes and still left things unclear. Now it takes five, and I know exactly what the people I work with are doing this week.</p>\n      <div class=\"quote-author\">\n        <div class=\"avatar a2\" aria-hidden=\"true\">MR</div>\n        <div>\n          <strong>Maya Ruiz</strong>\n          Head of Product, a six-person studio\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- PRICING -->\n  <section id=\"pricing\" class=\"pricing\" aria-labelledby=\"pricing-title\">\n    <div class=\"container\">\n      <div class=\"section-head center\">\n        <span class=\"eyebrow\">Pricing</span>\n        <h2 id=\"pricing-title\">Priced for teams, not for enterprises.</h2>\n        <p class=\"lead\">Start free. Upgrade when your team grows past five people or needs longer history.</p>\n      </div>\n\n      <div class=\"plans\">\n        <div class=\"plan\">\n          <span class=\"tag\">Starter</span>\n          <h3>Free</h3>\n          <p class=\"plan-desc\">For small teams trying a shared weekly plan.</p>\n          <div class=\"price\">$0 <small>/ forever</small></div>\n          <ul>\n            <li>Up to 5 teammates</li>\n            <li>One weekly board</li>\n            <li>Monday check-in template</li>\n            <li>4 weeks of history</li>\n          </ul>\n          <a href=\"#get-started\" class=\"btn btn-ghost btn-block\">Start free</a>\n        </div>\n\n        <div class=\"plan featured\">\n          <span class=\"tag\">Most popular</span>\n          <h3>Team</h3>\n          <p class=\"plan-desc\">For teams that plan every week and want full history.</p>\n          <div class=\"price\">$8 <small>/ person / month</small></div>\n          <ul>\n            <li>Unlimited teammates</li>\n            <li>Multiple boards and projects</li>\n            <li>Owners, handoffs, and blockers</li>\n            <li>Unlimited history and exports</li>\n            <li>Calendar focus blocks</li>\n          </ul>\n          <a href=\"#get-started\" class=\"btn btn-primary btn-block\">Start a 14-day trial</a>\n        </div>\n\n        <div class=\"plan\">\n          <span class=\"tag\">For larger orgs</span>\n          <h3>Business</h3>\n          <p class=\"plan-desc\">For organizations rolling Tidepool out across several teams.</p>\n          <div class=\"price\">Custom</div>\n          <ul>\n            <li>Everything in Team</li>\n            <li>SSO and admin controls</li>\n            <li>Shared templates across teams</li>\n            <li>Priority support</li>\n          </ul>\n          <a href=\"#\" class=\"btn btn-ghost btn-block\">Talk to us</a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- FAQ -->\n  <section id=\"faq\" aria-labelledby=\"faq-title\">\n    <div class=\"container faq-wrap\">\n      <div>\n        <span class=\"eyebrow\">FAQ</span>\n        <h2 id=\"faq-title\">Questions, answered.</h2>\n        <p class=\"lead\">Still curious? Write to us and a real person will reply within a day.</p>\n        <a href=\"#\" class=\"btn btn-ghost\">Contact the team</a>\n      </div>\n\n      <div>\n        <details open>\n          <summary>Is Tidepool a replacement for our project tracker?</summary>\n          <p>Not necessarily. Tidepool is built for the weekly plan, not the full project backlog. Many teams keep their tracker for long-term work and use Tidepool to decide what happens this week. You can import items from common trackers.</p>\n        </details>\n        <details>\n          <summary>How long does the Monday check-in really take?</summary>\n          <p>Most teams finish in five to ten minutes. The check-in walks through last week's unfinished items, flags blockers, and confirms owners for the new week. You can skip sections you don't need.</p>\n        </details>\n        <details>\n          <summary>Can we use it with remote and part-time teammates?</summary>\n          <p>Yes. Each person sees the same board in their own time zone, and part-time teammates can be shown with their working days so the plan stays realistic.</p>\n        </details>\n        <details>\n          <summary>What happens to unfinished work at the end of the week?</summary>\n          <p>Unfinished items roll forward to the next week with their comments and history attached. Nothing is silently deleted, and you can choose to drop or defer items during the Friday review.</p>\n        </details>\n        <details>\n          <summary>Where is our data stored?</summary>\n          <p>Your data is encrypted in transit and at rest. You can export everything at any time in standard formats, and you can delete your workspace whenever you like.</p>\n        </details>\n      </div>\n    </div>\n  </section>\n\n  <!-- FINAL CTA -->\n  <section class=\"final\" aria-labelledby=\"final-title\">\n    <div class=\"container\">\n      <div class=\"final-card\">\n        <div>\n          <h2 id=\"final-title\">Make Monday the easiest meeting of the week.</h2>\n          <p>Set up your team's first week in under five minutes. Free for teams up to five.</p>\n        </div>\n        <div class=\"final-actions\">\n          <a href=\"#get-started\" class=\"btn btn-light\">Start planning free</a>\n          <a href=\"#how\" class=\"btn btn-ghost\">See how it works</a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"container\">\n    <div class=\"footer-grid\">\n      <div class=\"footer-brand\">\n        <a href=\"#top\" class=\"logo\">\n          <svg width=\"26\" height=\"26\" viewBox=\"0 0 32 32\" aria-hidden=\"true\">\n            <circle cx=\"16\" cy=\"16\" r=\"15\" fill=\"#135760\"/>\n            <path d=\"M6 17c3-3 5-3 8 0s5 3 8 0 4-2 4-2\" stroke=\"#7fd1cf\" stroke-width=\"2.6\" fill=\"none\" stroke-linecap=\"round\"/>\n            <path d=\"M6 22c3-3 5-3 8 0s5 3 8 0 4-2 4-2\" stroke=\"#f0745c\" stroke-width=\"2.6\" fill=\"none\" stroke-linecap=\"round\"/>\n          </svg>\n          Tidepool\n        </a>\n        <p>Plan your week together. Small teams, one shared board, a calmer Monday.</p>\n      </div>\n      <nav aria-label=\"Product\">\n        <h4>Product</h4>\n        <ul>\n          <li><a href=\"#features\">Features</a></li>\n          <li><a href=\"#how\">How it works</a></li>\n          <li><a href=\"#pricing\">Pricing</a></li>\n        </ul>\n      </nav>\n      <nav aria-label=\"Company\">\n        <h4>Company</h4>\n        <ul>\n          <li><a href=\"#\">About</a></li>\n          <li><a href=\"#\">Blog</a></li>\n          <li><a href=\"#\">Contact</a></li>\n        </ul>\n      </nav>\n      <nav aria-label=\"Legal\">\n        <h4>Legal</h4>\n        <ul>\n          <li><a href=\"#\">Privacy</a></li>\n          <li><a href=\"#\">Terms</a></li>\n          <li><a href=\"#\">Security</a></li>\n        </ul>\n      </nav>\n    </div>\n    <div class=\"footer-bottom\">\n      <span>&copy; 2025 Tidepool. All rights reserved.</span>\n      <span>Made for teams that like to know what's next.</span>\n    </div>\n  </div>\n</footer>\n\n</body>\n</html>\n"}