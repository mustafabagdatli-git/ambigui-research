{"brief": "B2", "model": "openai/gpt-6-luna", "i": 4, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#fff9ef\">\n  <title>Wonderlab \u2014 A hands-on science museum for curious kids</title>\n  <style>\n    :root {\n      --ink: #172b4d;\n      --muted: #53637c;\n      --cream: #fff9ef;\n      --paper: #ffffff;\n      --blue: #bde9f4;\n      --blue-deep: #167c9e;\n      --coral: #ff745c;\n      --yellow: #ffd75e;\n      --lavender: #e7ddff;\n      --green: #bce8c1;\n      --radius: 24px;\n      --shadow: 0 16px 40px rgba(23, 43, 77, .09);\n    }\n\n    * { box-sizing: border-box; }\n\n    html { scroll-behavior: smooth; }\n\n    body {\n      margin: 0;\n      color: var(--ink);\n      background: var(--cream);\n      font-family: \"Trebuchet MS\", \"Avenir Next\", Avenir, system-ui, sans-serif;\n      line-height: 1.5;\n    }\n\n    a { color: inherit; }\n\n    .wrap {\n      width: min(1160px, calc(100% - 48px));\n      margin: 0 auto;\n    }\n\n    .topline {\n      padding: 9px 16px;\n      color: var(--ink);\n      background: var(--yellow);\n      text-align: center;\n      font-size: .82rem;\n      font-weight: 800;\n      letter-spacing: .02em;\n    }\n\n    .topline a {\n      margin-left: 6px;\n      text-decoration-thickness: 2px;\n      text-underline-offset: 3px;\n    }\n\n    header {\n      position: relative;\n      z-index: 2;\n      background: var(--cream);\n    }\n\n    .nav {\n      min-height: 82px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 28px;\n    }\n\n    .brand {\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      color: var(--ink);\n      text-decoration: none;\n      font-size: 1.34rem;\n      font-weight: 1000;\n      letter-spacing: -.06em;\n    }\n\n    .brand-mark {\n      width: 40px;\n      height: 40px;\n      display: grid;\n      place-items: center;\n      border-radius: 14px;\n      background: var(--coral);\n      font-size: 1.35rem;\n      transform: rotate(-7deg);\n    }\n\n    .nav-links {\n      display: flex;\n      align-items: center;\n      gap: 28px;\n      margin-left: auto;\n    }\n\n    .nav-links a {\n      color: var(--ink);\n      font-size: .92rem;\n      font-weight: 800;\n      text-decoration: none;\n    }\n\n    .nav-links a:hover { color: var(--blue-deep); }\n\n    .button {\n      display: inline-flex;\n      min-height: 48px;\n      align-items: center;\n      justify-content: center;\n      gap: 9px;\n      padding: 0 21px;\n      border: 0;\n      border-radius: 999px;\n      background: var(--ink);\n      color: #fff;\n      font: inherit;\n      font-size: .93rem;\n      font-weight: 900;\n      text-decoration: none;\n      transition: transform .2s ease, box-shadow .2s ease;\n      box-shadow: 0 5px 0 rgba(23, 43, 77, .15);\n    }\n\n    .button:hover {\n      transform: translateY(-2px);\n      box-shadow: 0 8px 0 rgba(23, 43, 77, .13);\n    }\n\n    .button.coral { background: var(--coral); }\n    .button.light { background: #fff; color: var(--ink); }\n\n    .hero {\n      padding: 34px 0 84px;\n      overflow: hidden;\n    }\n\n    .hero-grid {\n      display: grid;\n      grid-template-columns: 1fr 1.02fr;\n      gap: 45px;\n      align-items: center;\n    }\n\n    .eyebrow {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      margin: 0 0 16px;\n      color: var(--blue-deep);\n      font-size: .79rem;\n      font-weight: 1000;\n      letter-spacing: .12em;\n      text-transform: uppercase;\n    }\n\n    .eyebrow::before {\n      width: 25px;\n      height: 3px;\n      content: \"\";\n      border-radius: 3px;\n      background: var(--coral);\n    }\n\n    h1, h2, h3, p { margin-top: 0; }\n\n    h1 {\n      max-width: 590px;\n      margin-bottom: 20px;\n      font-size: clamp(3.25rem, 6.7vw, 5.65rem);\n      line-height: .98;\n      letter-spacing: -.075em;\n    }\n\n    h1 .highlight {\n      position: relative;\n      z-index: 0;\n      white-space: nowrap;\n    }\n\n    h1 .highlight::after {\n      position: absolute;\n      z-index: -1;\n      right: -3px;\n      bottom: 4px;\n      left: -4px;\n      height: 20px;\n      content: \"\";\n      border-radius: 50%;\n      background: var(--yellow);\n      transform: rotate(-2deg);\n    }\n\n    .hero-copy > p {\n      max-width: 485px;\n      margin-bottom: 28px;\n      color: var(--muted);\n      font-size: 1.12rem;\n    }\n\n    .hero-actions {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 12px;\n      align-items: center;\n    }\n\n    .text-link {\n      padding: 10px 4px;\n      color: var(--ink);\n      font-weight: 900;\n      text-decoration-thickness: 2px;\n      text-underline-offset: 4px;\n    }\n\n    .hero-note {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      margin-top: 27px;\n      color: var(--muted);\n      font-size: .87rem;\n      font-weight: 700;\n    }\n\n    .tiny-faces {\n      display: flex;\n      padding-left: 5px;\n    }\n\n    .tiny-faces span {\n      display: grid;\n      width: 31px;\n      height: 31px;\n      margin-left: -5px;\n      place-items: center;\n      border: 2px solid var(--cream);\n      border-radius: 50%;\n      background: var(--lavender);\n      font-size: .9rem;\n    }\n\n    .tiny-faces span:nth-child(2) { background: var(--green); }\n    .tiny-faces span:nth-child(3) { background: #ffd4c8; }\n\n    .hero-art {\n      position: relative;\n      min-height: 470px;\n      overflow: hidden;\n      border-radius: 47% 53% 43% 57% / 49% 43% 57% 51%;\n      background: var(--blue);\n      isolation: isolate;\n    }\n\n    .hero-art::before,\n    .hero-art::after {\n      position: absolute;\n      z-index: -1;\n      content: \"\";\n      border: 2px solid rgba(255,255,255,.7);\n      border-radius: 50%;\n    }\n\n    .hero-art::before {\n      width: 390px;\n      height: 390px;\n      top: 35px;\n      left: 15%;\n      transform: rotate(-22deg) scaleY(.62);\n    }\n\n    .hero-art::after {\n      width: 290px;\n      height: 290px;\n      top: 83px;\n      left: 24%;\n      transform: rotate(35deg) scaleY(.62);\n    }\n\n    .orbit {\n      position: absolute;\n      top: 48%;\n      left: 50%;\n      width: 185px;\n      height: 185px;\n      display: grid;\n      place-items: center;\n      border: 3px solid var(--ink);\n      border-radius: 50%;\n      background: var(--yellow);\n      font-size: 6rem;\n      transform: translate(-50%, -50%) rotate(-9deg);\n      box-shadow: 9px 10px 0 rgba(23, 43, 77, .12);\n    }\n\n    .planet {\n      position: absolute;\n      display: grid;\n      place-items: center;\n      border-radius: 50%;\n      box-shadow: 0 6px 0 rgba(23, 43, 77, .08);\n    }\n\n    .planet.one {\n      top: 11%;\n      right: 17%;\n      width: 68px;\n      height: 68px;\n      background: var(--coral);\n      font-size: 2rem;\n      transform: rotate(12deg);\n    }\n\n    .planet.two {\n      bottom: 14%;\n      left: 11%;\n      width: 65px;\n      height: 65px;\n      background: var(--lavender);\n      font-size: 1.8rem;\n    }\n\n    .planet.three {\n      top: 18%;\n      left: 14%;\n      width: 41px;\n      height: 41px;\n      background: var(--green);\n      font-size: 1.2rem;\n    }\n\n    .spark {\n      position: absolute;\n      color: #fff;\n      font-size: 2rem;\n      font-weight: 900;\n    }\n\n    .spark.a { top: 38%; left: 12%; }\n    .spark.b { right: 12%; bottom: 25%; font-size: 2.6rem; }\n    .spark.c { right: 29%; top: 10%; font-size: 1.3rem; }\n\n    .art-label {\n      position: absolute;\n      right: 6%;\n      bottom: 9%;\n      padding: 11px 16px;\n      border: 2px solid var(--ink);\n      border-radius: 16px;\n      background: #fff;\n      color: var(--ink);\n      font-size: .8rem;\n      font-weight: 1000;\n      transform: rotate(4deg);\n      box-shadow: 4px 5px 0 var(--ink);\n    }\n\n    .quick-info {\n      position: relative;\n      z-index: 1;\n      margin-top: -35px;\n    }\n\n    .info-card {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      overflow: hidden;\n      border-radius: var(--radius);\n      background: #fff;\n      box-shadow: var(--shadow);\n    }\n\n    .info-item {\n      display: flex;\n      align-items: center;\n      gap: 15px;\n      padding: 22px 25px;\n    }\n\n    .info-item + .info-item { border-left: 1px solid #e9edf2; }\n\n    .info-icon {\n      flex: 0 0 45px;\n      width: 45px;\n      height: 45px;\n      display: grid;\n      place-items: center;\n      border-radius: 15px;\n      background: var(--yellow);\n      font-size: 1.35rem;\n    }\n\n    .info-item:nth-child(2) .info-icon { background: var(--green); }\n    .info-item:nth-child(3) .info-icon { background: var(--lavender); }\n\n    .info-item strong {\n      display: block;\n      font-size: .94rem;\n    }\n\n    .info-item span {\n      display: block;\n      color: var(--muted);\n      font-size: .82rem;\n    }\n\n    section { padding: 92px 0; }\n\n    .section-heading {\n      max-width: 650px;\n      margin: 0 auto 38px;\n      text-align: center;\n    }\n\n    .section-heading .eyebrow { justify-content: center; }\n\n    h2 {\n      margin-bottom: 12px;\n      font-size: clamp(2.35rem, 4vw, 3.55rem);\n      line-height: 1.04;\n      letter-spacing: -.065em;\n    }\n\n    .section-heading > p:last-child {\n      margin-bottom: 0;\n      color: var(--muted);\n      font-size: 1rem;\n    }\n\n    .exhibits {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 20px;\n    }\n\n    .exhibit-card {\n      min-height: 300px;\n      padding: 26px;\n      overflow: hidden;\n      border-radius: var(--radius);\n      text-decoration: none;\n      transition: transform .2s ease;\n    }\n\n    .exhibit-card:hover { transform: translateY(-5px); }\n\n    .exhibit-card:nth-child(1) { background: var(--lavender); }\n    .exhibit-card:nth-child(2) { background: #ffd8cc; }\n    .exhibit-card:nth-child(3) { background: var(--green); }\n\n    .exhibit-emoji {\n      height: 138px;\n      display: grid;\n      place-items: center;\n      font-size: 5.5rem;\n      filter: drop-shadow(0 7px 0 rgba(23,43,77,.08));\n    }\n\n    .exhibit-card h3 {\n      margin: 10px 0 6px;\n      font-size: 1.35rem;\n      letter-spacing: -.04em;\n    }\n\n    .exhibit-card p {\n      margin-bottom: 0;\n      color: #465671;\n      font-size: .92rem;\n    }\n\n    .explore-link {\n      display: inline-block;\n      margin-top: 25px;\n      font-weight: 900;\n      text-decoration-thickness: 2px;\n      text-underline-offset: 4px;\n    }\n\n    .visit-section {\n      background: #f1f8f5;\n    }\n\n    .visit-grid {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 55px;\n      align-items: center;\n    }\n\n    .visit-illustration {\n      position: relative;\n      min-height: 360px;\n      display: grid;\n      place-items: center;\n      overflow: hidden;\n      border-radius: 30px;\n      background: var(--yellow);\n    }\n\n    .visit-illustration::before,\n    .visit-illustration::after {\n      position: absolute;\n      content: \"\";\n      border: 2px dashed rgba(23,43,77,.25);\n      border-radius: 50%;\n    }\n\n    .visit-illustration::before {\n      width: 290px;\n      height: 290px;\n    }\n\n    .visit-illustration::after {\n      width: 215px;\n      height: 215px;\n    }\n\n    .building {\n      position: relative;\n      z-index: 1;\n      width: 210px;\n      height: 145px;\n      margin-top: 60px;\n      border: 4px solid var(--ink);\n      border-radius: 18px 18px 8px 8px;\n      background: #fff;\n      box-shadow: 9px 9px 0 rgba(23,43,77,.15);\n    }\n\n    .building::before {\n      position: absolute;\n      top: -54px;\n      left: 17px;\n      width: 168px;\n      height: 75px;\n      content: \"\";\n      border: 4px solid var(--ink);\n      border-radius: 16px 16px 2px 2px;\n      background: var(--coral);\n      clip-path: polygon(50% 0, 100% 100%, 0 100%);\n    }\n\n    .building::after {\n      position: absolute;\n      right: 77px;\n      bottom: 0;\n      width: 46px;\n      height: 75px;\n      content: \"\";\n      border: 3px solid var(--ink);\n      border-bottom: 0;\n      border-radius: 24px 24px 0 0;\n      background: var(--blue);\n    }\n\n    .window {\n      position: absolute;\n      top: 35px;\n      width: 34px;\n      height: 42px;\n      border: 3px solid var(--ink);\n      border-radius: 16px 16px 4px 4px;\n      background: var(--blue);\n    }\n\n    .window.left { left: 18px; }\n    .window.right { right: 18px; }\n\n    .visit-emoji {\n      position: absolute;\n      z-index: 2;\n      font-size: 2.4rem;\n    }\n\n    .visit-emoji.a { top: 36px; left: 43px; transform: rotate(-13deg); }\n    .visit-emoji.b { top: 48px; right: 38px; transform: rotate(12deg); }\n    .visit-emoji.c { right: 58px; bottom: 33px; font-size: 2rem; }\n\n    .visit-copy .eyebrow { margin-bottom: 12px; }\n\n    .visit-copy h2 {\n      max-width: 450px;\n      margin-bottom: 17px;\n    }\n\n    .visit-copy > p {\n      max-width: 490px;\n      color: var(--muted);\n    }\n\n    .visit-details {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 18px 22px;\n      margin: 27px 0;\n    }\n\n    .detail {\n      display: flex;\n      gap: 10px;\n      align-items: flex-start;\n      font-size: .9rem;\n    }\n\n    .detail b {\n      display: block;\n      margin-bottom: 2px;\n    }\n\n    .detail span { color: var(--muted); }\n\n    .detail-icon { font-size: 1.2rem; }\n\n    .event-card {\n      display: grid;\n      grid-template-columns: 1.1fr .9fr;\n      overflow: hidden;\n      border-radius: 30px;\n      background: var(--ink);\n      color: #fff;\n    }\n\n    .event-copy { padding: 46px; }\n\n    .event-copy .eyebrow { color: var(--yellow); }\n\n    .event-copy h2 {\n      max-width: 490px;\n      margin-bottom: 14px;\n    }\n\n    .event-copy p {\n      max-width: 490px;\n      color: #d4deeb;\n    }\n\n    .event-meta {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 18px;\n      margin: 23px 0 28px;\n      color: #e6edf5;\n      font-size: .9rem;\n      font-weight: 700;\n    }\n\n    .event-art {\n      position: relative;\n      min-height: 350px;\n      display: grid;\n      place-items: center;\n      overflow: hidden;\n      background: var(--coral);\n    }\n\n    .event-art::before,\n    .event-art::after {\n      position: absolute;\n      content: \"\";\n      border: 2px solid rgba(255,255,255,.6);\n      border-radius: 50%;\n      transform: scaleY(.55) rotate(-22deg);\n    }\n\n    .event-art::before { width: 300px; height: 300px; }\n    .event-art::after { width: 210px; height: 210px; }\n\n    .event-art span {\n      position: relative;\n      z-index: 1;\n      font-size: 8rem;\n      transform: rotate(-9deg);\n      filter: drop-shadow(8px 8px 0 rgba(23,43,77,.17));\n    }\n\n    .event-sticker {\n      position: absolute;\n      right: 10%;\n      bottom: 13%;\n      padding: 10px 14px;\n      border: 2px solid var(--ink);\n      border-radius: 50%;\n      background: var(--yellow);\n      color: var(--ink);\n      font-size: .75rem;\n      font-weight: 1000;\n      line-height: 1.1;\n      text-align: center;\n      transform: rotate(10deg);\n    }\n\n    .newsletter {\n      padding: 67px 0;\n      background: var(--blue);\n      text-align: center;\n    }\n\n    .newsletter h2 { margin-bottom: 10px; }\n\n    .newsletter p {\n      max-width: 550px;\n      margin: 0 auto 22px;\n      color: var(--muted);\n    }\n\n    .signup {\n      display: flex;\n      max-width: 480px;\n      gap: 9px;\n      margin: 0 auto;\n      padding: 6px;\n      border-radius: 999px;\n      background: #fff;\n      box-shadow: 0 7px 20px rgba(23,43,77,.1);\n    }\n\n    .signup input {\n      min-width: 0;\n      flex: 1;\n      padding: 0 14px;\n      border: 0;\n      outline: 0;\n      border-radius: 999px;\n      background: transparent;\n      color: var(--ink);\n      font: inherit;\n    }\n\n    .signup input::placeholder { color: #8190a4; }\n\n    footer {\n      padding: 35px 0;\n      background: var(--cream);\n    }\n\n    .footer-row {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 25px;\n    }\n\n    .footer-row p {\n      margin: 0;\n      color: var(--muted);\n      font-size: .84rem;\n    }\n\n    .footer-links {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 20px;\n    }\n\n    .footer-links a {\n      font-size: .84rem;\n      font-weight: 800;\n      text-decoration: none;\n    }\n\n    @media (max-width: 850px) {\n      .nav-links { gap: 16px; }\n      .nav-links a { font-size: .85rem; }\n      .hero-grid { gap: 24px; }\n      .hero-art { min-height: 390px; }\n      .orbit { width: 155px; height: 155px; font-size: 5rem; }\n      .info-item { padding: 18px 15px; }\n      .visit-grid { gap: 35px; }\n      .event-copy { padding: 35px; }\n    }\n\n    @media (max-width: 680px) {\n      .wrap { width: min(100% - 32px, 520px); }\n      .topline { font-size: .74rem; }\n      .nav { min-height: 70px; }\n      .nav-links { display: none; }\n      .nav > .button { min-height: 42px; padding: 0 15px; font-size: .83rem; }\n      .hero { padding: 24px 0 65px; }\n      .hero-grid { grid-template-columns: 1fr; gap: 34px; }\n      h1 { max-width: 500px; font-size: clamp(3.2rem, 14vw, 5rem); }\n      .hero-copy > p { font-size: 1rem; }\n      .hero-art { min-height: 355px; width: 100%; }\n      .orbit { width: 145px; height: 145px; }\n      .quick-info { margin-top: -23px; }\n      .info-card { grid-template-columns: 1fr; }\n      .info-item { padding: 15px 19px; }\n      .info-item + .info-item {\n        border-top: 1px solid #e9edf2;\n        border-left: 0;\n      }\n      section { padding: 67px 0; }\n      .exhibits { grid-template-columns: 1fr; gap: 14px; }\n      .exhibit-card { min-height: 0; padding: 22px; }\n      .exhibit-emoji { height: 115px; }\n      .visit-grid { grid-template-columns: 1fr; gap: 32px; }\n      .visit-illustration { min-height: 310px; }\n      .visit-details { gap: 16px 10px; }\n      .event-card { grid-template-columns: 1fr; }\n      .event-copy { padding: 31px 25px; }\n      .event-art { min-height: 250px; }\n      .event-art span { font-size: 6.5rem; }\n      .newsletter { padding: 55px 0; }\n      .signup { border-radius: 22px; }\n      .signup input { width: 40%; padding-left: 10px; font-size: .86rem; }\n      .signup .button { min-height: 43px; padding: 0 15px; font-size: .83rem; }\n      .footer-row { align-items: flex-start; flex-direction: column; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      html { scroll-behavior: auto; }\n      *, *::before, *::after { transition-duration: .01ms !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"topline\">\n    Big ideas for little scientists \u2014 summer camp registration is open!\n    <a href=\"#events\">Explore camps</a>\n  </div>\n\n  <header>\n    <div class=\"wrap nav\">\n      <a class=\"brand\" href=\"#\" aria-label=\"Wonderlab home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\u2697\ufe0f</span>\n        wonderlab\n      </a>\n      <nav class=\"nav-links\" aria-label=\"Main navigation\">\n        <a href=\"#explore\">Explore</a>\n        <a href=\"#visit\">Plan your visit</a>\n        <a href=\"#events\">What\u2019s on</a>\n      </nav>\n      <a class=\"button coral\" href=\"#visit\">Get tickets <span aria-hidden=\"true\">\u2197</span></a>\n    </div>\n  </header>\n\n  <main>\n    <section class=\"hero\">\n      <div class=\"wrap hero-grid\">\n        <div class=\"hero-copy\">\n          <p class=\"eyebrow\">Curiosity lives here</p>\n          <h1>Big fun for <span class=\"highlight\">little</span> minds.</h1>\n          <p>\n            Make a mess. Ask a million questions. Discover something amazing.\n            Wonderlab is a hands-on science adventure for the whole family.\n          </p>\n          <div class=\"hero-actions\">\n            <a class=\"button\" href=\"#explore\">Explore the museum <span aria-hidden=\"true\">\u2192</span></a>\n            <a class=\"text-link\" href=\"#visit\">Plan your visit</a>\n          </div>\n          <div class=\"hero-note\">\n            <div class=\"tiny-faces\" aria-hidden=\"true\">\n              <span>\ud83d\udc67</span><span>\ud83d\udc66</span><span>\ud83e\uddd2</span>\n            </div>\n            <span>Made for curious kids ages 2\u201312</span>\n          </div>\n        </div>\n\n        <div class=\"hero-art\" role=\"img\" aria-label=\"A playful illustrated planet surrounded by colorful stars\">\n          <span class=\"planet one\" aria-hidden=\"true\">\u2728</span>\n          <span class=\"planet two\" aria-hidden=\"true\">\ud83e\ude90</span>\n          <span class=\"planet three\" aria-hidden=\"true\">\u2726</span>\n          <span class=\"spark a\" aria-hidden=\"true\">\u2733</span>\n          <span class=\"spark b\" aria-hidden=\"true\">\u2726</span>\n          <span class=\"spark c\" aria-hidden=\"true\">\u2727</span>\n          <div class=\"orbit\" aria-hidden=\"true\">\ud83c\udf0d</div>\n          <div class=\"art-label\">YOUR NEXT<br>GREAT DISCOVERY!</div>\n        </div>\n      </div>\n    </section>\n\n    <div class=\"wrap quick-info\" aria-label=\"Museum highlights\">\n      <div class=\"info-card\">\n        <div class=\"info-item\">\n          <div class=\"info-icon\" aria-hidden=\"true\">\ud83d\udd58</div>\n          <div><strong>Open every day</strong><span>9:00 am \u2013 5:00 pm</span></div>\n        </div>\n        <div class=\"info-item\">\n          <div class=\"info-icon\" aria-hidden=\"true\">\ud83d\udccd</div>\n          <div><strong>Right in the heart of town</strong><span>14 Discovery Lane</span></div>\n        </div>\n        <div class=\"info-item\">\n          <div class=\"info-icon\" aria-hidden=\"true\">\ud83c\udf9f\ufe0f</div>\n          <div><strong>Little ones visit free</strong><span>Under 2 years old</span></div>\n        </div>\n      </div>\n    </div>\n\n    <section id=\"explore\">\n      <div class=\"wrap\">\n        <div class=\"section-heading\">\n          <p class=\"eyebrow\">Pick a path, any path</p>\n          <h2>Wonder is around every corner.</h2>\n          <p>Touch it, test it, take it apart (then put it back together). There\u2019s no wrong way to explore.</p>\n        </div>\n        <div class=\"exhibits\">\n          <a class=\"exhibit-card\" href=\"#visit\">\n            <div class=\"exhibit-emoji\" aria-hidden=\"true\">\ud83e\udee7</div>\n            <h3>Bubble Lab</h3>\n            <p>Step inside a giant bubble and find out what makes them pop.</p>\n            <span class=\"explore-link\">Get bubbly \u2192</span>\n          </a>\n          <a class=\"exhibit-card\" href=\"#visit\">\n            <div class=\"exhibit-emoji\" aria-hidden=\"true\">\ud83d\ude80</div>\n            <h3>Mission to Mars</h3>\n            <p>Build a rover, launch a rocket, and explore the red planet.</p>\n            <span class=\"explore-link\">Blast off \u2192</span>\n          </a>\n          <a class=\"exhibit-card\" href=\"#visit\">\n            <div class=\"exhibit-emoji\" aria-hidden=\"true\">\ud83c\udf31</div>\n            <h3>Little Green Lab</h3>\n            <p>Dig into big ideas about plants, bugs, and our planet.</p>\n            <span class=\"explore-link\">Get growing \u2192</span>\n          </a>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"visit-section\" id=\"visit\">\n      <div class=\"wrap visit-grid\">\n        <div class=\"visit-illustration\" role=\"img\" aria-label=\"A cheerful illustration of the Wonderlab museum\">\n          <span class=\"visit-emoji a\" aria-hidden=\"true\">\u2600\ufe0f</span>\n          <span class=\"visit-emoji b\" aria-hidden=\"true\">\ud83e\udd8b</span>\n          <span class=\"visit-emoji c\" aria-hidden=\"true\">\ud83c\udf3c</span>\n          <div class=\"building\" aria-hidden=\"true\">\n            <span class=\"window left\"></span>\n            <span class=\"window right\"></span>\n          </div>\n        </div>\n        <div class=\"visit-copy\">\n          <p class=\"eyebrow\">Your day starts here</p>\n          <h2>Come curious.<br>Leave amazed.</h2>\n          <p>Plan a day full of hands-on discoveries, happy surprises, and plenty of room to play.</p>\n          <div class=\"visit-details\">\n            <div class=\"detail\"><span class=\"detail-icon\" aria-hidden=\"true\">\ud83d\udcc5</span><div><b>Hours</b><span>Daily, 9 am\u20135 pm</span></div></div>\n            <div class=\"detail\"><span class=\"detail-icon\" aria-hidden=\"true\">\ud83d\ude97</span><div><b>Getting here</b><span>Easy parking nearby</span></div></div>\n            <div class=\"detail\"><span class=\"detail-icon\" aria-hidden=\"true\">\ud83c\udf4e</span><div><b>Bring a snack</b><span>Picnic spots on site</span></div></div>\n            <div class=\"detail\"><span class=\"detail-icon\" aria-hidden=\"true\">\u267f</span><div><b>Everyone belongs</b><span>Accessible for all</span></div></div>\n          </div>\n          <a class=\"button\" href=\"mailto:hello@wonderlab.example\">Plan your visit <span aria-hidden=\"true\">\u2192</span></a>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"events\">\n      <div class=\"wrap\">\n        <div class=\"event-card\">\n          <div class=\"event-copy\">\n            <p class=\"eyebrow\">Coming up at Wonderlab</p>\n            <h2>Summer of silly science!</h2>\n            <p>Make rainbow slime, fizz up a volcano, and discover just how fun a little mess can be. New experiments every week.</p>\n            <div class=\"event-meta\">\n              <span>\u2600\ufe0f &nbsp;June 10 \u2013 August 24</span>\n              <span>\ud83d\udc67 &nbsp;Ages 4\u201312</span>\n            </div>\n            <a class=\"button light\" href=\"#visit\">See camp details <span aria-hidden=\"true\">\u2192</span></a>\n          </div>\n          <div class=\"event-art\" role=\"img\" aria-label=\"A colorful chemistry flask bubbling over\">\n            <span aria-hidden=\"true\">\ud83e\uddea</span>\n            <div class=\"event-sticker\">MIX<br>IT UP!</div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"newsletter\">\n      <div class=\"wrap\">\n        <p class=\"eyebrow\">A little wonder in your inbox</p>\n        <h2>Curiosity looks good on you.</h2>\n        <p>Get hands-on activities, museum news, and the occasional very important dinosaur fact.</p>\n        <form class=\"signup\" action=\"#\" method=\"get\">\n          <label for=\"email\" class=\"visually-hidden\" style=\"position:absolute;left:-9999px;\">Your email address</label>\n          <input id=\"email\" type=\"email\" placeholder=\"Your email address\" required>\n          <button class=\"button coral\" type=\"submit\">Count me in <span aria-hidden=\"true\">\u2192</span></button>\n        </form>\n      </div>\n    </section>\n  </main>\n\n  <footer>\n    <div class=\"wrap footer-row\">\n      <a class=\"brand\" href=\"#\" aria-label=\"Wonderlab home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\u2697\ufe0f</span>\n        wonderlab\n      </a>\n      <p>Making room for wonder since 2008. \u00a9 2025 Wonderlab Museum</p>\n      <div class=\"footer-links\">\n        <a href=\"#visit\">Contact</a>\n        <a href=\"#visit\">Accessibility</a>\n        <a href=\"#visit\">Instagram \u2197</a>\n      </div>\n    </div>\n  </footer>\n</body>\n</html>\n"}