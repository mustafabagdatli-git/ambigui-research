{"brief": "B1", "model": "openai/gpt-6-luna", "i": 2, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en-GB\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#173b35\">\n  <meta name=\"description\" content=\"Friendly, reliable plumbing and heating from a family-run team in Leeds. Call Oak & Brass for repairs, installations and emergency help.\">\n  <title>Oak &amp; Brass Plumbing | Leeds Family Plumbers</title>\n  <style>\n    :root {\n      --green: #173b35;\n      --green-deep: #102d28;\n      --mint: #dcebe2;\n      --lime: #cce66a;\n      --cream: #f8f6ef;\n      --paper: #fffefa;\n      --ink: #1b2b27;\n      --muted: #66746f;\n      --line: #e7e9e1;\n      --coral: #ec805e;\n      --shadow: 0 20px 55px rgba(23, 59, 53, .12);\n      --radius: 22px;\n    }\n\n    * { box-sizing: border-box; }\n\n    html { scroll-behavior: smooth; }\n\n    body {\n      margin: 0;\n      color: var(--ink);\n      background: var(--paper);\n      font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      line-height: 1.55;\n    }\n\n    a { color: inherit; }\n\n    a:focus-visible {\n      outline: 3px solid var(--coral);\n      outline-offset: 4px;\n      border-radius: 4px;\n    }\n\n    .shell {\n      width: min(1160px, calc(100% - 48px));\n      margin-inline: auto;\n    }\n\n    .topbar {\n      background: var(--green-deep);\n      color: #eef5ef;\n      font-size: .83rem;\n    }\n\n    .topbar-inner {\n      min-height: 38px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 16px;\n    }\n\n    .topbar p { margin: 0; }\n\n    .topbar a {\n      color: var(--lime);\n      text-decoration: none;\n      font-weight: 700;\n    }\n\n    header {\n      position: relative;\n      z-index: 2;\n      background: var(--paper);\n      border-bottom: 1px solid rgba(23, 59, 53, .08);\n    }\n\n    .nav {\n      height: 82px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 28px;\n    }\n\n    .brand {\n      display: inline-flex;\n      align-items: center;\n      gap: 11px;\n      text-decoration: none;\n      flex-shrink: 0;\n    }\n\n    .brand-mark {\n      width: 43px;\n      height: 43px;\n      display: grid;\n      place-items: center;\n      color: var(--green);\n      background: var(--lime);\n      border-radius: 14px 14px 14px 5px;\n    }\n\n    .brand-mark svg { width: 25px; height: 25px; }\n\n    .brand-name {\n      display: block;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: 1.13rem;\n      font-weight: 700;\n      letter-spacing: -.03em;\n      line-height: 1.05;\n    }\n\n    .brand-sub {\n      display: block;\n      margin-top: 4px;\n      color: var(--muted);\n      font-size: .65rem;\n      font-weight: 700;\n      letter-spacing: .14em;\n      text-transform: uppercase;\n    }\n\n    .nav-links {\n      display: flex;\n      align-items: center;\n      gap: 30px;\n    }\n\n    .nav-links a {\n      color: #42534d;\n      font-size: .92rem;\n      font-weight: 650;\n      text-decoration: none;\n    }\n\n    .nav-links a:hover { color: var(--green); }\n\n    .button {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: 10px;\n      min-height: 51px;\n      padding: 0 22px;\n      border: 0;\n      border-radius: 999px;\n      background: var(--lime);\n      color: var(--green-deep);\n      font-size: .92rem;\n      font-weight: 800;\n      text-decoration: none;\n      transition: transform .18s ease, background .18s ease;\n    }\n\n    .button:hover {\n      transform: translateY(-2px);\n      background: #d8ef7e;\n    }\n\n    .button svg { width: 17px; height: 17px; }\n\n    .button-small { min-height: 44px; padding-inline: 18px; }\n\n    .hero {\n      position: relative;\n      overflow: hidden;\n      padding: 74px 0 88px;\n      background:\n        radial-gradient(ellipse at 77% 45%, rgba(204, 230, 106, .09), transparent 33%),\n        var(--green);\n      color: white;\n    }\n\n    .hero::before {\n      position: absolute;\n      top: -140px;\n      right: -150px;\n      width: 510px;\n      height: 510px;\n      border: 1px solid rgba(255,255,255,.08);\n      border-radius: 50%;\n      content: \"\";\n    }\n\n    .hero::after {\n      position: absolute;\n      top: -73px;\n      right: -83px;\n      width: 375px;\n      height: 375px;\n      border: 1px solid rgba(255,255,255,.08);\n      border-radius: 50%;\n      content: \"\";\n    }\n\n    .hero-grid {\n      position: relative;\n      z-index: 1;\n      display: grid;\n      grid-template-columns: 1.03fr .97fr;\n      align-items: center;\n      gap: 48px;\n    }\n\n    .eyebrow {\n      display: inline-flex;\n      align-items: center;\n      gap: 9px;\n      margin: 0 0 19px;\n      color: var(--lime);\n      font-size: .76rem;\n      font-weight: 800;\n      letter-spacing: .15em;\n      text-transform: uppercase;\n    }\n\n    .eyebrow::before {\n      width: 24px;\n      height: 2px;\n      background: currentColor;\n      content: \"\";\n    }\n\n    h1, h2, h3, p { margin-top: 0; }\n\n    h1, h2 {\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-weight: 500;\n      letter-spacing: -.045em;\n    }\n\n    h1 {\n      max-width: 620px;\n      margin-bottom: 22px;\n      font-size: clamp(3.2rem, 6vw, 5.35rem);\n      line-height: .99;\n    }\n\n    h1 em {\n      color: var(--lime);\n      font-weight: 500;\n    }\n\n    .hero-copy {\n      max-width: 495px;\n      margin-bottom: 29px;\n      color: #d5e2dc;\n      font-size: 1.1rem;\n      line-height: 1.7;\n    }\n\n    .hero-actions {\n      display: flex;\n      align-items: center;\n      flex-wrap: wrap;\n      gap: 14px 22px;\n    }\n\n    .text-link {\n      display: inline-flex;\n      align-items: center;\n      gap: 9px;\n      color: white;\n      font-size: .92rem;\n      font-weight: 700;\n      text-decoration: none;\n    }\n\n    .text-link svg { width: 18px; height: 18px; color: var(--lime); }\n\n    .hero-note {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      margin-top: 34px;\n      color: #c7d8d0;\n      font-size: .84rem;\n    }\n\n    .avatar-stack { display: flex; padding-left: 5px; }\n\n    .avatar {\n      display: grid;\n      width: 29px;\n      height: 29px;\n      margin-left: -5px;\n      place-items: center;\n      border: 2px solid var(--green);\n      border-radius: 50%;\n      background: #e7ae8f;\n      color: var(--green-deep);\n      font-size: .59rem;\n      font-weight: 900;\n    }\n\n    .avatar:nth-child(2) { background: #d3dc9c; }\n    .avatar:nth-child(3) { background: #c9d6e0; }\n\n    .hero-art {\n      position: relative;\n      min-height: 430px;\n      display: grid;\n      place-items: center;\n    }\n\n    .art-card {\n      position: relative;\n      width: min(100%, 470px);\n      padding: 20px;\n      border: 1px solid rgba(255,255,255,.12);\n      border-radius: 30px;\n      background: rgba(255,255,255,.07);\n      box-shadow: 0 30px 80px rgba(0,0,0,.18);\n      transform: rotate(2deg);\n    }\n\n    .art-card svg {\n      display: block;\n      width: 100%;\n      height: auto;\n      border-radius: 20px;\n    }\n\n    .floating-note {\n      position: absolute;\n      display: flex;\n      align-items: center;\n      gap: 11px;\n      padding: 13px 16px;\n      border: 1px solid rgba(23,59,53,.07);\n      border-radius: 15px;\n      background: var(--paper);\n      box-shadow: var(--shadow);\n      color: var(--ink);\n      transform: rotate(-2deg);\n    }\n\n    .floating-note.top {\n      top: 32px;\n      right: -20px;\n    }\n\n    .floating-note.bottom {\n      bottom: 30px;\n      left: -22px;\n      transform: rotate(2deg);\n    }\n\n    .note-icon {\n      width: 38px;\n      height: 38px;\n      display: grid;\n      place-items: center;\n      flex: 0 0 auto;\n      border-radius: 12px;\n      background: #edf2dc;\n      color: var(--green);\n    }\n\n    .note-icon svg { width: 21px; height: 21px; }\n\n    .floating-note strong {\n      display: block;\n      font-size: .84rem;\n      line-height: 1.2;\n    }\n\n    .floating-note span {\n      display: block;\n      margin-top: 3px;\n      color: var(--muted);\n      font-size: .72rem;\n    }\n\n    .trust-strip {\n      position: relative;\n      z-index: 1;\n      padding: 23px 0;\n      border-bottom: 1px solid var(--line);\n      background: var(--cream);\n    }\n\n    .trust-inner {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 22px;\n    }\n\n    .trust-intro {\n      color: var(--muted);\n      font-size: .82rem;\n      font-weight: 700;\n    }\n\n    .trust-points {\n      display: flex;\n      flex-wrap: wrap;\n      justify-content: flex-end;\n      gap: 14px 32px;\n    }\n\n    .trust-point {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      color: #344841;\n      font-size: .84rem;\n      font-weight: 700;\n    }\n\n    .trust-point svg { width: 18px; height: 18px; color: #678443; }\n\n    .section { padding: 94px 0; }\n\n    .section-heading {\n      display: flex;\n      align-items: end;\n      justify-content: space-between;\n      gap: 35px;\n      margin-bottom: 40px;\n    }\n\n    .section-heading h2 {\n      max-width: 560px;\n      margin-bottom: 0;\n      color: var(--green);\n      font-size: clamp(2.4rem, 4vw, 3.55rem);\n      line-height: 1.05;\n    }\n\n    .section-heading p {\n      max-width: 365px;\n      margin-bottom: 4px;\n      color: var(--muted);\n    }\n\n    .section .eyebrow { color: #6d8544; }\n\n    .services-grid {\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      gap: 16px;\n    }\n\n    .service-card {\n      min-height: 236px;\n      padding: 25px 22px;\n      border: 1px solid var(--line);\n      border-radius: var(--radius);\n      background: var(--paper);\n      transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;\n    }\n\n    .service-card:hover {\n      transform: translateY(-5px);\n      border-color: #d6dfc2;\n      box-shadow: var(--shadow);\n    }\n\n    .service-icon {\n      width: 48px;\n      height: 48px;\n      display: grid;\n      place-items: center;\n      margin-bottom: 22px;\n      border-radius: 15px;\n      background: var(--mint);\n      color: var(--green);\n    }\n\n    .service-icon svg { width: 24px; height: 24px; }\n\n    .service-card h3 {\n      margin-bottom: 8px;\n      color: var(--green);\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: 1.3rem;\n    }\n\n    .service-card p {\n      margin-bottom: 0;\n      color: var(--muted);\n      font-size: .91rem;\n    }\n\n    .about {\n      padding: 82px 0;\n      background: var(--cream);\n    }\n\n    .about-grid {\n      display: grid;\n      grid-template-columns: .9fr 1.1fr;\n      align-items: center;\n      gap: 80px;\n    }\n\n    .about-visual {\n      position: relative;\n      min-height: 370px;\n      display: grid;\n      place-items: center;\n      overflow: hidden;\n      border-radius: 28px;\n      background: #e7eee3;\n    }\n\n    .about-visual::before, .about-visual::after {\n      position: absolute;\n      border: 1px solid rgba(23,59,53,.12);\n      border-radius: 50%;\n      content: \"\";\n    }\n\n    .about-visual::before { width: 390px; height: 390px; }\n    .about-visual::after { width: 290px; height: 290px; }\n\n    .about-visual svg {\n      position: relative;\n      z-index: 1;\n      width: 74%;\n      max-width: 330px;\n    }\n\n    .about-tag {\n      position: absolute;\n      right: 20px;\n      bottom: 20px;\n      z-index: 1;\n      padding: 12px 15px;\n      border-radius: 14px;\n      background: var(--paper);\n      color: var(--green);\n      font-size: .78rem;\n      font-weight: 800;\n      box-shadow: 0 10px 30px rgba(23,59,53,.1);\n    }\n\n    .about-copy h2 {\n      margin-bottom: 18px;\n      color: var(--green);\n      font-size: clamp(2.4rem, 4vw, 3.4rem);\n      line-height: 1.06;\n    }\n\n    .about-copy > p {\n      margin-bottom: 24px;\n      color: var(--muted);\n    }\n\n    .check-list {\n      display: grid;\n      gap: 13px;\n      margin: 0 0 28px;\n      padding: 0;\n      list-style: none;\n    }\n\n    .check-list li {\n      display: flex;\n      align-items: center;\n      gap: 11px;\n      color: #344841;\n      font-weight: 700;\n    }\n\n    .check-list svg {\n      width: 20px;\n      height: 20px;\n      flex: 0 0 auto;\n      color: #779347;\n    }\n\n    .button-dark {\n      background: var(--green);\n      color: white;\n    }\n\n    .button-dark:hover { background: var(--green-deep); }\n\n    .review {\n      padding: 92px 0;\n      text-align: center;\n    }\n\n    .review .eyebrow { justify-content: center; }\n\n    .review blockquote {\n      max-width: 800px;\n      margin: 0 auto 25px;\n      color: var(--green);\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: clamp(1.8rem, 3.5vw, 2.75rem);\n      letter-spacing: -.03em;\n      line-height: 1.25;\n    }\n\n    .stars {\n      margin-bottom: 12px;\n      color: #e2a641;\n      font-size: 1.1rem;\n      letter-spacing: .15em;\n    }\n\n    .review cite {\n      color: var(--muted);\n      font-size: .9rem;\n      font-style: normal;\n      font-weight: 700;\n    }\n\n    .cta-band { padding: 0 0 86px; }\n\n    .cta-box {\n      position: relative;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 30px;\n      overflow: hidden;\n      padding: 48px 55px;\n      border-radius: 28px;\n      background: var(--green);\n      color: white;\n    }\n\n    .cta-box::after {\n      position: absolute;\n      top: -145px;\n      right: 195px;\n      width: 330px;\n      height: 330px;\n      border: 1px solid rgba(255,255,255,.12);\n      border-radius: 50%;\n      content: \"\";\n    }\n\n    .cta-copy { position: relative; z-index: 1; }\n\n    .cta-copy .eyebrow { margin-bottom: 12px; }\n\n    .cta-copy h2 {\n      max-width: 620px;\n      margin-bottom: 9px;\n      font-size: clamp(2rem, 4vw, 3.1rem);\n      line-height: 1.05;\n    }\n\n    .cta-copy p {\n      margin-bottom: 0;\n      color: #d5e2dc;\n    }\n\n    .cta-box .button {\n      position: relative;\n      z-index: 1;\n      flex: 0 0 auto;\n    }\n\n    footer {\n      padding: 35px 0 28px;\n      border-top: 1px solid var(--line);\n      background: var(--cream);\n    }\n\n    .footer-main {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 30px;\n      padding-bottom: 27px;\n    }\n\n    .footer-contact {\n      display: flex;\n      align-items: center;\n      gap: 25px;\n      color: #42534d;\n      font-size: .9rem;\n      font-weight: 700;\n    }\n\n    .footer-contact a { text-decoration: none; }\n    .footer-contact a:hover { color: var(--green); }\n\n    .footer-bottom {\n      display: flex;\n      justify-content: space-between;\n      gap: 20px;\n      padding-top: 19px;\n      border-top: 1px solid var(--line);\n      color: var(--muted);\n      font-size: .78rem;\n    }\n\n    .footer-bottom p { margin: 0; }\n\n    @media (max-width: 900px) {\n      .nav-links { gap: 18px; }\n      .hero-grid { gap: 24px; }\n      .hero-art { min-height: 360px; }\n      .services-grid { grid-template-columns: repeat(2, 1fr); }\n      .about-grid { gap: 44px; }\n      .trust-inner { align-items: flex-start; flex-direction: column; }\n      .trust-points { justify-content: flex-start; }\n    }\n\n    @media (max-width: 680px) {\n      .shell { width: min(100% - 36px, 520px); }\n      .topbar-inner { min-height: 36px; font-size: .75rem; }\n      .topbar-inner p:last-child { display: none; }\n      .nav { height: 70px; }\n      .nav-links { display: none; }\n      .brand-name { font-size: 1.04rem; }\n      .brand-mark { width: 39px; height: 39px; }\n      .button-small { min-height: 41px; padding-inline: 15px; font-size: .84rem; }\n      .hero { padding: 57px 0 65px; }\n      .hero-grid { grid-template-columns: 1fr; gap: 30px; }\n      h1 { font-size: clamp(3.15rem, 14vw, 4.6rem); }\n      .hero-copy { font-size: 1rem; }\n      .hero-art { min-height: 310px; margin-inline: 8px; }\n      .art-card { width: min(100%, 410px); padding: 13px; }\n      .floating-note.top { top: 13px; right: -7px; }\n      .floating-note.bottom { bottom: 12px; left: -8px; }\n      .floating-note { padding: 10px 12px; }\n      .trust-strip { padding: 20px 0; }\n      .trust-points { gap: 12px 18px; }\n      .trust-point { font-size: .78rem; }\n      .section { padding: 70px 0; }\n      .section-heading { align-items: flex-start; flex-direction: column; gap: 14px; margin-bottom: 28px; }\n      .section-heading h2 { font-size: 2.65rem; }\n      .services-grid { gap: 12px; }\n      .service-card { min-height: 220px; padding: 19px 16px; }\n      .service-icon { width: 43px; height: 43px; margin-bottom: 17px; }\n      .service-card h3 { font-size: 1.15rem; }\n      .service-card p { font-size: .84rem; }\n      .about { padding: 65px 0; }\n      .about-grid { grid-template-columns: 1fr; gap: 34px; }\n      .about-visual { min-height: 290px; }\n      .about-copy h2 { font-size: 2.65rem; }\n      .review { padding: 70px 0; }\n      .cta-band { padding-bottom: 65px; }\n      .cta-box { align-items: flex-start; flex-direction: column; padding: 34px 26px; }\n      .cta-copy h2 { font-size: 2.45rem; }\n      .footer-main { align-items: flex-start; flex-direction: column; }\n      .footer-contact { align-items: flex-start; flex-direction: column; gap: 10px; }\n      .footer-bottom { flex-direction: column; gap: 7px; }\n    }\n\n    @media (max-width: 390px) {\n      .hero-actions { align-items: flex-start; flex-direction: column; }\n      .services-grid { grid-template-columns: 1fr; }\n      .service-card { min-height: auto; }\n      .trust-points { display: grid; grid-template-columns: 1fr 1fr; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      *, *::before, *::after {\n        scroll-behavior: auto !important;\n        transition-duration: .01ms !important;\n      }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"topbar\">\n    <div class=\"shell topbar-inner\">\n      <p>Local, family-run plumbers serving Leeds &amp; nearby areas</p>\n      <p>Need a hand? <a href=\"tel:+441134960184\">0113 496 0184</a></p>\n    </div>\n  </div>\n\n  <header>\n    <div class=\"shell nav\">\n      <a class=\"brand\" href=\"#home\" aria-label=\"Oak and Brass Plumbing home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M4 11.2 12 4l8 7.2v8.3a.5.5 0 0 1-.5.5h-15a.5.5 0 0 1-.5-.5v-8.3Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/>\n            <path d=\"M9 20v-5.5a3 3 0 0 1 6 0V20M12 7.8v2.6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n          </svg>\n        </span>\n        <span>\n          <span class=\"brand-name\">Oak &amp; Brass</span>\n          <span class=\"brand-sub\">Plumbing \u00b7 Leeds</span>\n        </span>\n      </a>\n\n      <nav class=\"nav-links\" aria-label=\"Main navigation\">\n        <a href=\"#services\">Our services</a>\n        <a href=\"#about\">About us</a>\n        <a href=\"#reviews\">Reviews</a>\n      </nav>\n\n      <a class=\"button button-small\" href=\"tel:+441134960184\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n          <path d=\"M7.2 3.8h2.5l1.2 4.4-1.8 1.7a15.2 15.2 0 0 0 5 5l1.7-1.8 4.4 1.2v2.5a2 2 0 0 1-2.2 2A16.6 16.6 0 0 1 5.2 6a2 2 0 0 1 2-2.2Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </svg>\n        Call us\n      </a>\n    </div>\n  </header>\n\n  <main>\n    <section class=\"hero\" id=\"home\">\n      <div class=\"shell hero-grid\">\n        <div>\n          <p class=\"eyebrow\">Good people. Proper plumbing.</p>\n          <h1>Leeds homes, <em>in good hands.</em></h1>\n          <p class=\"hero-copy\">From a dripping tap to a full bathroom refresh, we bring friendly faces, tidy work and straight-talking advice to every job.</p>\n          <div class=\"hero-actions\">\n            <a class=\"button\" href=\"tel:+441134960184\">\n              Talk to a plumber\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n                <path d=\"M5 12h14m-6-6 6 6-6 6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n            </a>\n            <a class=\"text-link\" href=\"#services\">\n              Explore our services\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n                <path d=\"M12 5v14m-6-6 6 6 6-6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n            </a>\n          </div>\n          <div class=\"hero-note\">\n            <div class=\"avatar-stack\" aria-hidden=\"true\">\n              <span class=\"avatar\">O</span>\n              <span class=\"avatar\">M</span>\n              <span class=\"avatar\">J</span>\n            </div>\n            <span>A small family team that treats your home like our own.</span>\n          </div>\n        </div>\n\n        <div class=\"hero-art\" aria-label=\"Illustration of a cosy home and plumbing tools\">\n          <div class=\"art-card\">\n            <svg viewBox=\"0 0 500 390\" role=\"img\" aria-labelledby=\"heroArtTitle\">\n              <title id=\"heroArtTitle\">A cosy Leeds home with a plumber's toolkit</title>\n              <rect width=\"500\" height=\"390\" rx=\"22\" fill=\"#e5eee4\"/>\n              <circle cx=\"408\" cy=\"86\" r=\"38\" fill=\"#d1e0bd\"/>\n              <path d=\"M55 222 248 82l196 140v129H55V222Z\" fill=\"#f8f5e9\"/>\n              <path d=\"m34 224 214-158 211 158\" fill=\"none\" stroke=\"#b66e50\" stroke-width=\"15\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              <path d=\"M106 205v-51h65v4\" fill=\"none\" stroke=\"#b66e50\" stroke-width=\"11\" stroke-linecap=\"round\"/>\n              <path d=\"M153 206v-32h-31v32\" fill=\"#cce66a\"/>\n              <path d=\"M339 350v-91a46 46 0 0 0-92 0v91\" fill=\"#d4e2d4\"/>\n              <path d=\"M249 259v91\" stroke=\"#577e68\" stroke-width=\"5\"/>\n              <path d=\"M293 259v91\" stroke=\"#577e68\" stroke-width=\"5\"/>\n              <path d=\"M248 304h46\" stroke=\"#577e68\" stroke-width=\"5\"/>\n              <rect x=\"190\" y=\"275\" width=\"47\" height=\"75\" rx=\"3\" fill=\"#bf7658\"/>\n              <circle cx=\"226\" cy=\"314\" r=\"3\" fill=\"#f4d87a\"/>\n              <path d=\"M363 163h46v17h-46z\" fill=\"#d1e0bd\"/>\n              <path d=\"M384 180v56\" stroke=\"#d1e0bd\" stroke-width=\"10\" stroke-linecap=\"round\"/>\n              <path d=\"M375 236h18\" stroke=\"#d1e0bd\" stroke-width=\"8\" stroke-linecap=\"round\"/>\n              <path d=\"M76 350h354\" stroke=\"#bdcbbd\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n              <path d=\"M66 351h366\" stroke=\"#a9bea9\" stroke-width=\"2\"/>\n              <path d=\"M185 243h28m-14-14v28\" stroke=\"#78904e\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n              <path d=\"M323 116h15m-7-7v15\" stroke=\"#78904e\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n              <circle cx=\"91\" cy=\"113\" r=\"5\" fill=\"#cce66a\"/>\n              <circle cx=\"431\" cy=\"280\" r=\"5\" fill=\"#cce66a\"/>\n            </svg>\n          </div>\n          <div class=\"floating-note top\">\n            <span class=\"note-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\">\n                <path d=\"m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linejoin=\"round\"/>\n              </svg>\n            </span>\n            <span><strong>Care in every detail</strong><span>From first hello to final tidy-up</span></span>\n          </div>\n          <div class=\"floating-note bottom\">\n            <span class=\"note-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\">\n                <path d=\"M12 3v3m0 12v3M3 12h3m12 0h3M5.6 5.6l2.1 2.1m8.6 8.6 2.1 2.1m0-12.8-2.1 2.1m-8.6 8.6-2.1 2.1\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n                <circle cx=\"12\" cy=\"12\" r=\"4\" stroke=\"currentColor\" stroke-width=\"1.8\"/>\n              </svg>\n            </span>\n            <span><strong>Here when you need us</strong><span>Repairs, upgrades &amp; emergencies</span></span>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"trust-strip\" aria-label=\"What you can expect\">\n      <div class=\"shell trust-inner\">\n        <span class=\"trust-intro\">The little things make a big difference.</span>\n        <div class=\"trust-points\">\n          <span class=\"trust-point\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            Clear, upfront quotes\n          </span>\n          <span class=\"trust-point\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            Respect for your home\n          </span>\n          <span class=\"trust-point\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            Local Leeds team\n          </span>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section\" id=\"services\">\n      <div class=\"shell\">\n        <div class=\"section-heading\">\n          <div>\n            <p class=\"eyebrow\">What we can help with</p>\n            <h2>From the quick fix to the big refresh.</h2>\n          </div>\n          <p>Whatever\u2019s going on with your pipes, we\u2019ll help you find the right fix \u2014 with no fuss and no jargon.</p>\n        </div>\n\n        <div class=\"services-grid\">\n          <article class=\"service-card\">\n            <span class=\"service-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 4v5a6 6 0 0 0 12 0V4M4 4h4m8 0h4M12 15v5m-3 0h6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/><path d=\"M9 8h6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg>\n            </span>\n            <h3>Everyday plumbing</h3>\n            <p>Leaky taps, troublesome toilets, pipe repairs and all those little jobs.</p>\n          </article>\n\n          <article class=\"service-card\">\n            <span class=\"service-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M5 20V8l7-5 7 5v12M9 20v-7h6v7M3 20h18\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M12 6v4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg>\n            </span>\n            <h3>Bathrooms &amp; kitchens</h3>\n            <p>Thoughtful installations and upgrades, planned around your home.</p>\n          </article>\n\n          <article class=\"service-card\">\n            <span class=\"service-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 3v3m0 12v3M4 12h3m10 0h3M6.3 6.3l2.1 2.1m7.2 7.2 2.1 2.1m0-11.4-2.1 2.1m-7.2 7.2-2.1 2.1\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/><circle cx=\"12\" cy=\"12\" r=\"4\" stroke=\"currentColor\" stroke-width=\"1.8\"/></svg>\n            </span>\n            <h3>Heating &amp; radiators</h3>\n            <p>Help with radiator issues, heating pipework and system improvements.</p>\n          </article>\n\n          <article class=\"service-card\">\n            <span class=\"service-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 3s6 6.2 6 11a6 6 0 0 1-12 0c0-4.8 6-11 6-11Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/><path d=\"M9.5 15a2.5 2.5 0 0 0 2.5 2.5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg>\n            </span>\n            <h3>Urgent repairs</h3>\n            <p>When water\u2019s where it shouldn\u2019t be, give us a call and we\u2019ll talk it through.</p>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"about\" id=\"about\">\n      <div class=\"shell about-grid\">\n        <div class=\"about-visual\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 340 300\" fill=\"none\">\n            <path d=\"M170 32 292 124v137H48V124L170 32Z\" fill=\"#f8f6ef\" stroke=\"#173b35\" stroke-width=\"5\" stroke-linejoin=\"round\"/>\n            <path d=\"m32 129 138-105 139 105\" stroke=\"#bd7657\" stroke-width=\"13\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            <path d=\"M77 141h58v58H77z\" fill=\"#cce66a\" stroke=\"#173b35\" stroke-width=\"4\"/>\n            <path d=\"M106 141v58m-29-29h58\" stroke=\"#173b35\" stroke-width=\"3\"/>\n            <path d=\"M188 182a31 31 0 0 1 62 0v79h-62v-79Z\" fill=\"#dcebe2\" stroke=\"#173b35\" stroke-width=\"4\"/>\n            <path d=\"M219 185v76m-31-38h62\" stroke=\"#78907f\" stroke-width=\"3\"/>\n            <path d=\"M151 261v-58h27v58\" fill=\"#bd7657\" stroke=\"#173b35\" stroke-width=\"4\"/>\n            <circle cx=\"171\" cy=\"232\" r=\"3\" fill=\"#f8e396\"/>\n            <path d=\"M54 261h233\" stroke=\"#173b35\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n            <path d=\"M159 91h22m-11-11v22\" stroke=\"#78904e\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n            <circle cx=\"251\" cy=\"87\" r=\"5\" fill=\"#cce66a\"/>\n          </svg>\n          <span class=\"about-tag\">Proud to be your local team</span>\n        </div>\n\n        <div class=\"about-copy\">\n          <p class=\"eyebrow\">A bit about us</p>\n          <h2>Good work starts with good people.</h2>\n          <p>We\u2019re a family-run plumbing business built on a simple idea: turn up when we say, explain things clearly, and leave every home as tidy as we found it.</p>\n          <ul class=\"check-list\">\n            <li>\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n              Friendly, respectful service\n            </li>\n            <li>\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n              Clear advice before work begins\n            </li>\n            <li>\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n              Serving Leeds and nearby communities\n            </li>\n          </ul>\n          <a class=\"button button-dark\" href=\"tel:+441134960184\">\n            Get to know your plumber\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          </a>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"review\" id=\"reviews\">\n      <div class=\"shell\">\n        <p class=\"eyebrow\">Kind words from customers</p>\n        <div class=\"stars\" aria-label=\"Five stars\">\u2605\u2605\u2605\u2605\u2605</div>\n        <blockquote>\u201cA lovely local team. They explained everything, did a brilliant job and left the place spotless.\u201d</blockquote>\n        <cite>\u2014 A happy customer in Leeds</cite>\n      </div>\n    </section>\n\n    <section class=\"cta-band\">\n      <div class=\"shell\">\n        <div class=\"cta-box\">\n          <div class=\"cta-copy\">\n            <p class=\"eyebrow\">Let\u2019s get it sorted</p>\n            <h2>Need a hand with something?</h2>\n            <p>Tell us what\u2019s happening and we\u2019ll work out the next step together.</p>\n          </div>\n          <a class=\"button\" href=\"tel:+441134960184\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n              <path d=\"M7.2 3.8h2.5l1.2 4.4-1.8 1.7a15.2 15.2 0 0 0 5 5l1.7-1.8 4.4 1.2v2.5a2 2 0 0 1-2.2 2A16.6 16.6 0 0 1 5.2 6a2 2 0 0 1 2-2.2Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            </svg>\n            0113 496 0184\n          </a>\n        </div>\n      </div>\n    </section>\n  </main>\n\n  <footer>\n    <div class=\"shell\">\n      <div class=\"footer-main\">\n        <a class=\"brand\" href=\"#home\" aria-label=\"Oak and Brass Plumbing home\">\n          <span class=\"brand-mark\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\">\n              <path d=\"M4 11.2 12 4l8 7.2v8.3a.5.5 0 0 1-.5.5h-15a.5.5 0 0 1-.5-.5v-8.3Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/>\n              <path d=\"M9 20v-5.5a3 3 0 0 1 6 0V20M12 7.8v2.6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n            </svg>\n          </span>\n          <span>\n            <span class=\"brand-name\">Oak &amp; Brass</span>\n            <span class=\"brand-sub\">Plumbing \u00b7 Leeds</span>\n          </span>\n        </a>\n        <div class=\"footer-contact\">\n          <a href=\"tel:+441134960184\">0113 496 0184</a>\n          <span>Leeds &amp; surrounding areas</span>\n        </div>\n      </div>\n      <div class=\"footer-bottom\">\n        <p>\u00a9 2025 Oak &amp; Brass Plumbing. All rights reserved.</p>\n        <p>Local service. A personal touch.</p>\n      </div>\n    </div>\n  </footer>\n</body>\n</html>\n"}