{"brief": "B1", "model": "openai/gpt-6-luna", "i": 3, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en-GB\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#f7f5ef\">\n  <meta name=\"description\" content=\"Friendly, reliable plumbing and heating for homes across Leeds. Call your local family-run team to book a visit.\">\n  <title>Leeds Family Plumbing | Friendly local plumbers</title>\n  <style>\n    :root {\n      --ink: #172c32;\n      --muted: #647477;\n      --paper: #f7f5ef;\n      --white: #fffefa;\n      --teal: #14796e;\n      --teal-dark: #0c5f57;\n      --lime: #d9ec86;\n      --orange: #ef8b55;\n      --line: #e5e5dc;\n      --shadow: 0 18px 50px rgba(23, 44, 50, .09);\n      --radius: 24px;\n    }\n\n    * { box-sizing: border-box; }\n    html { scroll-behavior: smooth; }\n    body {\n      margin: 0;\n      color: var(--ink);\n      background: var(--paper);\n      font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      line-height: 1.55;\n    }\n    a { color: inherit; }\n    button, a { -webkit-tap-highlight-color: transparent; }\n    .wrap { width: min(1160px, calc(100% - 48px)); margin-inline: auto; }\n    .eyebrow {\n      display: inline-flex;\n      align-items: center;\n      gap: 9px;\n      margin: 0 0 16px;\n      color: var(--teal);\n      font-size: .76rem;\n      font-weight: 800;\n      letter-spacing: .12em;\n      text-transform: uppercase;\n    }\n    .eyebrow::before {\n      content: \"\";\n      width: 23px;\n      height: 2px;\n      background: var(--orange);\n      border-radius: 2px;\n    }\n    h1, h2, h3, p { margin-top: 0; }\n    h1, h2, h3 { line-height: 1.08; letter-spacing: -.045em; }\n    h1 { max-width: 650px; margin-bottom: 22px; font-size: clamp(3rem, 6.3vw, 5.65rem); }\n    h2 { margin-bottom: 17px; font-size: clamp(2.2rem, 4vw, 3.5rem); }\n    h3 { margin-bottom: 10px; font-size: 1.25rem; letter-spacing: -.025em; }\n    .lead { color: var(--muted); font-size: 1.1rem; max-width: 540px; }\n    .button {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: 10px;\n      min-height: 52px;\n      padding: 0 22px;\n      border: 0;\n      border-radius: 999px;\n      background: var(--teal);\n      color: white;\n      font: inherit;\n      font-weight: 750;\n      text-decoration: none;\n      transition: transform .2s ease, background .2s ease;\n    }\n    .button:hover { transform: translateY(-2px); background: var(--teal-dark); }\n    .button svg { width: 18px; height: 18px; }\n    .button--light { background: var(--white); color: var(--ink); }\n    .button--light:hover { background: var(--lime); color: var(--ink); }\n    .text-link {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      color: var(--teal-dark);\n      font-weight: 750;\n      text-decoration: none;\n    }\n    .text-link:hover { text-decoration: underline; text-underline-offset: 4px; }\n\n    /* Header */\n    .topbar {\n      padding: 9px 0;\n      background: var(--ink);\n      color: #e8eee9;\n      font-size: .83rem;\n    }\n    .topbar-inner { display: flex; justify-content: space-between; align-items: center; gap: 16px; }\n    .topbar p { margin: 0; }\n    .topbar a { color: var(--lime); font-weight: 750; text-decoration: none; }\n    .nav { position: relative; z-index: 2; }\n    .nav-inner { min-height: 82px; display: flex; align-items: center; justify-content: space-between; gap: 28px; }\n    .brand { display: inline-flex; align-items: center; gap: 11px; text-decoration: none; }\n    .brand-mark {\n      display: grid;\n      width: 43px;\n      height: 43px;\n      place-items: center;\n      border-radius: 15px;\n      background: var(--teal);\n      color: white;\n    }\n    .brand-mark svg { width: 25px; height: 25px; }\n    .brand-name { display: block; font-size: 1.02rem; font-weight: 850; line-height: 1.1; }\n    .brand-caption { display: block; margin-top: 3px; color: var(--muted); font-size: .72rem; }\n    .nav-links { display: flex; align-items: center; gap: 29px; }\n    .nav-links > a:not(.button) { color: #45585b; font-size: .92rem; font-weight: 650; text-decoration: none; }\n    .nav-links > a:not(.button):hover { color: var(--teal); }\n    .nav-links .button { min-height: 46px; padding-inline: 18px; font-size: .9rem; }\n\n    /* Hero */\n    .hero { padding: 48px 0 76px; overflow: hidden; }\n    .hero-grid { display: grid; grid-template-columns: 1.03fr .97fr; align-items: center; gap: 46px; }\n    .hero-copy { padding: 26px 0; }\n    .hero h1 span { color: var(--teal); }\n    .hero .lead { margin-bottom: 27px; }\n    .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; }\n    .hero-note { display: flex; align-items: center; gap: 9px; margin: 24px 0 0; color: var(--muted); font-size: .88rem; }\n    .hero-note svg { flex: 0 0 auto; width: 19px; color: var(--teal); }\n    .hero-art {\n      position: relative;\n      min-height: 450px;\n      display: grid;\n      place-items: center;\n      border-radius: 42% 42% 26px 26px;\n      background: #e7eee5;\n      overflow: hidden;\n    }\n    .hero-art::before {\n      content: \"\";\n      position: absolute;\n      width: 330px;\n      height: 330px;\n      left: -118px;\n      bottom: -170px;\n      border: 1px solid rgba(20,121,110,.2);\n      border-radius: 50%;\n      box-shadow: 0 0 0 22px rgba(20,121,110,.04), 0 0 0 48px rgba(20,121,110,.04);\n    }\n    .hero-art::after {\n      content: \"\";\n      position: absolute;\n      width: 180px;\n      height: 180px;\n      right: -68px;\n      top: -70px;\n      border-radius: 50%;\n      background: var(--lime);\n      opacity: .75;\n    }\n    .pipe-illustration { position: relative; z-index: 1; width: min(92%, 485px); height: auto; }\n    .art-sticker {\n      position: absolute;\n      z-index: 2;\n      right: 20px;\n      bottom: 27px;\n      max-width: 180px;\n      padding: 16px 19px;\n      border: 1px solid rgba(23,44,50,.06);\n      border-radius: 18px;\n      background: var(--white);\n      box-shadow: var(--shadow);\n      font-size: .85rem;\n      font-weight: 750;\n      line-height: 1.35;\n    }\n    .art-sticker span { display: block; margin-bottom: 5px; color: var(--teal); font-size: .72rem; letter-spacing: .09em; text-transform: uppercase; }\n    .trust-strip {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 12px;\n      margin-top: -24px;\n      position: relative;\n      z-index: 1;\n      padding: 21px 25px;\n      border: 1px solid var(--line);\n      border-radius: 18px;\n      background: var(--white);\n      box-shadow: 0 12px 35px rgba(23,44,50,.05);\n    }\n    .trust-item { display: flex; align-items: center; justify-content: center; gap: 11px; color: #3d5154; font-size: .9rem; font-weight: 700; }\n    .trust-item svg { width: 22px; height: 22px; flex: 0 0 auto; color: var(--teal); }\n\n    /* Sections */\n    section.content-section { padding: 100px 0; }\n    .section-heading { max-width: 680px; margin: 0 auto 42px; text-align: center; }\n    .section-heading .lead { margin-inline: auto; }\n    .services-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 17px; }\n    .service-card {\n      min-height: 225px;\n      padding: 28px;\n      border: 1px solid var(--line);\n      border-radius: var(--radius);\n      background: var(--white);\n      transition: transform .2s ease, box-shadow .2s ease;\n    }\n    .service-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }\n    .service-icon {\n      width: 48px;\n      height: 48px;\n      display: grid;\n      place-items: center;\n      margin-bottom: 23px;\n      border-radius: 16px;\n      background: #e8f2e9;\n      color: var(--teal);\n    }\n    .service-icon svg { width: 24px; height: 24px; }\n    .service-card p { margin-bottom: 0; color: var(--muted); font-size: .94rem; }\n\n    .about { background: #eaf0e9; }\n    .about-grid { display: grid; grid-template-columns: .9fr 1.1fr; align-items: center; gap: 75px; }\n    .about-art {\n      min-height: 355px;\n      display: grid;\n      place-items: center;\n      position: relative;\n      border-radius: 30px;\n      background: var(--teal);\n      overflow: hidden;\n    }\n    .about-art::before, .about-art::after {\n      content: \"\";\n      position: absolute;\n      border: 1px solid rgba(255,255,255,.2);\n      border-radius: 50%;\n    }\n    .about-art::before { width: 370px; height: 370px; }\n    .about-art::after { width: 280px; height: 280px; }\n    .about-illustration { position: relative; z-index: 1; width: 220px; height: 220px; }\n    .about-stamp {\n      position: absolute;\n      z-index: 2;\n      bottom: 23px;\n      left: 23px;\n      padding: 12px 16px;\n      border-radius: 14px;\n      background: var(--lime);\n      color: var(--ink);\n      font-size: .82rem;\n      font-weight: 800;\n    }\n    .about-copy .lead { margin-bottom: 25px; }\n    .check-list { display: grid; gap: 13px; margin: 0 0 28px; padding: 0; list-style: none; }\n    .check-list li { display: flex; align-items: flex-start; gap: 11px; color: #405457; font-weight: 650; }\n    .check-list svg { flex: 0 0 auto; width: 20px; height: 20px; margin-top: 2px; color: var(--teal); }\n\n    .process-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; counter-reset: steps; }\n    .process-step { position: relative; padding: 28px 25px; border-top: 1px solid #cfd8d3; counter-increment: steps; }\n    .process-step::before {\n      content: \"0\" counter(steps);\n      display: block;\n      margin-bottom: 25px;\n      color: var(--teal);\n      font-size: .78rem;\n      font-weight: 850;\n      letter-spacing: .1em;\n    }\n    .process-step p { margin: 0; color: var(--muted); }\n\n    .quote-band { padding: 56px 0; background: var(--ink); color: white; }\n    .quote-inner { display: flex; justify-content: space-between; align-items: center; gap: 35px; }\n    .quote-inner .eyebrow { color: var(--lime); }\n    .quote-inner h2 { max-width: 650px; margin: 0; font-size: clamp(2rem, 3.7vw, 3.2rem); }\n    .quote-inner p { margin: 12px 0 0; color: #c3d0cb; }\n\n    .area-row { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 32px; }\n    .area-chip { padding: 10px 16px; border: 1px solid var(--line); border-radius: 999px; background: var(--white); color: #4b5d5f; font-size: .88rem; font-weight: 700; }\n\n    footer { padding: 46px 0 24px; background: #102328; color: #eaf0e9; }\n    .footer-grid { display: grid; grid-template-columns: 1.3fr .7fr .8fr; gap: 45px; padding-bottom: 38px; }\n    footer .brand-caption { color: #acbbb7; }\n    footer .brand-name { color: white; }\n    .footer-copy { max-width: 330px; margin: 18px 0 0; color: #acbbb7; font-size: .9rem; }\n    .footer-title { margin: 3px 0 14px; color: var(--lime); font-size: .77rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }\n    .footer-links { display: grid; gap: 9px; }\n    .footer-links a { color: #e4eae6; font-size: .9rem; text-decoration: none; }\n    .footer-links a:hover { color: var(--lime); }\n    .footer-bottom { display: flex; justify-content: space-between; gap: 16px; padding-top: 20px; border-top: 1px solid rgba(255,255,255,.14); color: #9eaeaa; font-size: .8rem; }\n    .footer-bottom p { margin: 0; }\n\n    @media (max-width: 850px) {\n      .nav-links { gap: 16px; }\n      .nav-links > a:not(.button) { display: none; }\n      .hero-grid { grid-template-columns: 1fr 1fr; gap: 20px; }\n      .hero-art { min-height: 390px; }\n      .about-grid { gap: 38px; }\n      .service-card { padding: 23px; }\n    }\n    @media (max-width: 640px) {\n      .wrap { width: min(100% - 36px, 480px); }\n      .topbar-inner { justify-content: center; text-align: center; }\n      .topbar-inner p:first-child { display: none; }\n      .nav-inner { min-height: 72px; }\n      .nav-links .button { min-height: 42px; padding-inline: 14px; font-size: .83rem; }\n      .hero { padding: 23px 0 57px; }\n      .hero-grid { grid-template-columns: 1fr; gap: 26px; }\n      .hero-copy { padding: 20px 0 0; }\n      h1 { font-size: clamp(3rem, 13vw, 4.4rem); }\n      .hero-art { min-height: 330px; border-radius: 36% 36% 22px 22px; }\n      .pipe-illustration { width: 87%; }\n      .art-sticker { right: 12px; bottom: 13px; padding: 12px 14px; }\n      .trust-strip { grid-template-columns: 1fr; gap: 13px; margin-top: -26px; padding: 19px; }\n      .trust-item { justify-content: flex-start; }\n      section.content-section { padding: 73px 0; }\n      .section-heading { margin-bottom: 30px; text-align: left; }\n      .services-grid { grid-template-columns: 1fr; gap: 12px; }\n      .service-card { min-height: auto; padding: 23px; }\n      .service-icon { margin-bottom: 16px; }\n      .about-grid { grid-template-columns: 1fr; gap: 33px; }\n      .about-art { min-height: 275px; order: 2; }\n      .process-grid { grid-template-columns: 1fr; gap: 3px; }\n      .process-step { padding: 20px 10px; }\n      .process-step::before { margin-bottom: 13px; }\n      .quote-band { padding: 45px 0; }\n      .quote-inner { align-items: flex-start; flex-direction: column; }\n      .footer-grid { grid-template-columns: 1fr 1fr; gap: 28px; }\n      .footer-grid > div:first-child { grid-column: 1 / -1; }\n      .footer-bottom { flex-direction: column; }\n    }\n    @media (prefers-reduced-motion: reduce) {\n      html { scroll-behavior: auto; }\n      *, *::before, *::after { transition-duration: .01ms !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"topbar\">\n    <div class=\"wrap topbar-inner\">\n      <p>Your friendly, local family plumbing team</p>\n      <p>Need a hand? <a href=\"tel:+441135550198\">Call 0113 555 0198</a></p>\n    </div>\n  </div>\n\n  <header class=\"nav\">\n    <div class=\"wrap nav-inner\">\n      <a class=\"brand\" href=\"#\" aria-label=\"Leeds Family Plumbing home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M7 3v6a5 5 0 0 0 10 0V3M4 3h6M14 3h6M12 14v2.5a3.5 3.5 0 1 0 7 0\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n            <path d=\"M19 20.5c1.1-1.2 2-2.3 2-3.5a2 2 0 0 0-4 0c0 1.2.9 2.3 2 3.5Z\" fill=\"#d9ec86\"/>\n          </svg>\n        </span>\n        <span>\n          <span class=\"brand-name\">Leeds Family Plumbing</span>\n          <span class=\"brand-caption\">Local people. Properly looked after.</span>\n        </span>\n      </a>\n      <nav class=\"nav-links\" aria-label=\"Main navigation\">\n        <a href=\"#services\">Services</a>\n        <a href=\"#about\">About us</a>\n        <a href=\"#areas\">Areas we cover</a>\n        <a class=\"button\" href=\"tel:+441135550198\">Call the team <span aria-hidden=\"true\">\u2197</span></a>\n      </nav>\n    </div>\n  </header>\n\n  <main>\n    <section class=\"hero\">\n      <div class=\"wrap hero-grid\">\n        <div class=\"hero-copy\">\n          <p class=\"eyebrow\">Plumbing &amp; heating in Leeds</p>\n          <h1>Good people.<br><span>Great plumbing.</span></h1>\n          <p class=\"lead\">From a dripping tap to a bathroom refresh, we\u2019re the local family team that gets it sorted with care, clear advice and no fuss.</p>\n          <div class=\"hero-actions\">\n            <a class=\"button\" href=\"tel:+441135550198\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M7 3H4.8A1.8 1.8 0 0 0 3 4.8C3 13.7 10.3 21 19.2 21a1.8 1.8 0 0 0 1.8-1.8V17l-5-2-1.4 2.1a14.8 14.8 0 0 1-6.9-6.9L9.8 8.8 7 3Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/></svg>\n              Call 0113 555 0198\n            </a>\n            <a class=\"text-link\" href=\"#services\">Explore our services <span aria-hidden=\"true\">\u2192</span></a>\n          </div>\n          <p class=\"hero-note\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            Straightforward quotes. Work done with care.\n          </p>\n        </div>\n\n        <div class=\"hero-art\" aria-label=\"Illustration of friendly plumbing tools and pipes\">\n          <svg class=\"pipe-illustration\" viewBox=\"0 0 520 430\" fill=\"none\" role=\"img\" aria-labelledby=\"pipeTitle\">\n            <title id=\"pipeTitle\">A cheerful plumbing illustration</title>\n            <path d=\"M87 314V112c0-19 15-34 34-34h73\" stroke=\"#14796e\" stroke-width=\"31\" stroke-linecap=\"round\"/>\n            <path d=\"M194 78h75c19 0 34 15 34 34v58\" stroke=\"#ef8b55\" stroke-width=\"31\" stroke-linecap=\"round\"/>\n            <path d=\"M303 170v114c0 19-15 34-34 34h-49\" stroke=\"#14796e\" stroke-width=\"31\" stroke-linecap=\"round\"/>\n            <path d=\"M220 318h-82c-19 0-34-15-34-34\" stroke=\"#ef8b55\" stroke-width=\"31\" stroke-linecap=\"round\"/>\n            <path d=\"M194 62v32M178 62h32M288 150h32M288 166h32M124 298v32M108 314h32\" stroke=\"#172c32\" stroke-width=\"7\" stroke-linecap=\"round\"/>\n            <circle cx=\"205\" cy=\"193\" r=\"70\" fill=\"#fffefa\"/>\n            <path d=\"M205 143v49l35 21\" stroke=\"#14796e\" stroke-width=\"12\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            <circle cx=\"205\" cy=\"193\" r=\"56\" stroke=\"#172c32\" stroke-width=\"5\"/>\n            <path d=\"M382 111c0 22-33 57-33 57s-33-35-33-57a33 33 0 1 1 66 0Z\" fill=\"#d9ec86\"/>\n            <circle cx=\"349\" cy=\"110\" r=\"12\" fill=\"#14796e\"/>\n            <path d=\"M393 258c0 15-22 39-22 39s-22-24-22-39a22 22 0 1 1 44 0Z\" fill=\"#ef8b55\"/>\n            <circle cx=\"371\" cy=\"257\" r=\"8\" fill=\"#fffefa\"/>\n            <path d=\"M65 190h44M52 206h57\" stroke=\"#172c32\" stroke-width=\"7\" stroke-linecap=\"round\"/>\n            <path d=\"M410 184h39M410 201h57\" stroke=\"#172c32\" stroke-width=\"7\" stroke-linecap=\"round\"/>\n            <circle cx=\"427\" cy=\"84\" r=\"5\" fill=\"#14796e\"/>\n            <circle cx=\"126\" cy=\"49\" r=\"7\" fill=\"#ef8b55\"/>\n          </svg>\n          <div class=\"art-sticker\"><span>Here for your home</span>Local help, with a human touch.</div>\n        </div>\n      </div>\n\n      <div class=\"wrap trust-strip\" aria-label=\"What you can expect\">\n        <div class=\"trust-item\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M12 3 19 6v5c0 4.8-3 8.2-7 10-4-1.8-7-5.2-7-10V6l7-3Z\" stroke=\"currentColor\" stroke-width=\"1.8\"/><path d=\"m9 12 2 2 4-4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          Careful, respectful service\n        </div>\n        <div class=\"trust-item\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\" stroke=\"currentColor\" stroke-width=\"1.8\"/><path d=\"M12 7v5l3 2\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg>\n          Clear communication, start to finish\n        </div>\n        <div class=\"trust-item\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 12h16M12 4v16\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/><circle cx=\"12\" cy=\"12\" r=\"9\" stroke=\"currentColor\" stroke-width=\"1.8\"/></svg>\n          One friendly team for the job\n        </div>\n      </div>\n    </section>\n\n    <section class=\"content-section\" id=\"services\">\n      <div class=\"wrap\">\n        <div class=\"section-heading\">\n          <p class=\"eyebrow\">How we can help</p>\n          <h2>Small fixes to bigger plans.</h2>\n          <p class=\"lead\">Whatever\u2019s going on with your pipes, we\u2019ll talk it through and help you find the right solution for your home.</p>\n        </div>\n\n        <div class=\"services-grid\">\n          <article class=\"service-card\">\n            <div class=\"service-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M7 3v6a5 5 0 0 0 10 0V3M4 3h6M14 3h6M12 14v2\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/><path d=\"M12 20c1.4-1.5 2.5-2.7 2.5-4a2.5 2.5 0 0 0-5 0c0 1.3 1.1 2.5 2.5 4Z\" fill=\"currentColor\"/></svg>\n            </div>\n            <h3>Everyday plumbing</h3>\n            <p>Leaks, taps, toilets and those little jobs that make a big difference when they\u2019re finally sorted.</p>\n          </article>\n          <article class=\"service-card\">\n            <div class=\"service-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M5 20V9h14v11M3 20h18M8 9V5h8v4M8 13h2M14 13h2M8 17h2M14 17h2\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            </div>\n            <h3>Bathrooms &amp; kitchens</h3>\n            <p>Thoughtful updates, new fixtures and practical advice to help make your space work better.</p>\n          </article>\n          <article class=\"service-card\">\n            <div class=\"service-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 3v2M5.6 5.6 7 7M3 12h2m14 0h2M17 7l1.4-1.4M7 16a6 6 0 1 1 10 0c-.8.8-1 1.6-1 2H8c0-.4-.2-1.2-1-2ZM9 21h6M9 18h6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            </div>\n            <h3>Heating &amp; hot water</h3>\n            <p>Help with heating and hot water issues, plus friendly guidance on the next steps.</p>\n          </article>\n          <article class=\"service-card\">\n            <div class=\"service-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M4 5h16v14H4zM8 9h8M8 13h5M8 17h3\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"m16 16 2 2 3-4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            </div>\n            <h3>Repairs &amp; maintenance</h3>\n            <p>Careful troubleshooting and repair work, with a clear explanation of what we\u2019ve found.</p>\n          </article>\n          <article class=\"service-card\">\n            <div class=\"service-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M4 19 14 9l-3-3L1 16v3h3ZM13 7l2-2 4 4-2 2M14 19h7M17.5 15.5v7\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            </div>\n            <h3>Installations</h3>\n            <p>New fixtures and fittings installed neatly, with care taken to leave your home tidy.</p>\n          </article>\n          <article class=\"service-card\">\n            <div class=\"service-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 3 4 7v5c0 4.4 3.3 7.5 8 9 4.7-1.5 8-4.6 8-9V7l-8-4Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/><path d=\"M8 12h8M12 8v8\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg>\n            </div>\n            <h3>Honest advice</h3>\n            <p>Not sure what you need? Tell us what\u2019s happening and we\u2019ll help you work it out.</p>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"content-section about\" id=\"about\">\n      <div class=\"wrap about-grid\">\n        <div class=\"about-art\" aria-hidden=\"true\">\n          <svg class=\"about-illustration\" viewBox=\"0 0 220 220\" fill=\"none\">\n            <circle cx=\"110\" cy=\"110\" r=\"84\" stroke=\"rgba(255,255,255,.35)\" stroke-width=\"2\"/>\n            <path d=\"M64 139V91c0-25 20-45 45-45s45 20 45 45v48\" stroke=\"#d9ec86\" stroke-width=\"14\" stroke-linecap=\"round\"/>\n            <path d=\"M77 139v-34M141 139v-34\" stroke=\"#fffefa\" stroke-width=\"11\" stroke-linecap=\"round\"/>\n            <path d=\"M54 147h120\" stroke=\"#172c32\" stroke-width=\"11\" stroke-linecap=\"round\"/>\n            <circle cx=\"109\" cy=\"86\" r=\"17\" fill=\"#ef8b55\"/>\n            <path d=\"M109 103v31m-20-20 20 12 20-12\" stroke=\"#fffefa\" stroke-width=\"8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            <path d=\"M60 65 49 54m122 11 11-11M111 32V18\" stroke=\"#d9ec86\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n          </svg>\n          <span class=\"about-stamp\">Leeds is home. We\u2019re here to help.</span>\n        </div>\n        <div class=\"about-copy\">\n          <p class=\"eyebrow\">A family business, through and through</p>\n          <h2>Plumbing is our trade.<br>Looking after people is our thing.</h2>\n          <p class=\"lead\">We\u2019re a family-run team who believe good work starts with listening. We\u2019ll treat your home with respect, explain things in plain English and do our best to make the whole experience easy.</p>\n          <ul class=\"check-list\">\n            <li><svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Friendly faces and straightforward conversations</li>\n            <li><svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Clear recommendations, with no hard sell</li>\n            <li><svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Care and consideration in your home</li>\n          </ul>\n          <a class=\"text-link\" href=\"tel:+441135550198\">Get to know us \u2014 give us a call <span aria-hidden=\"true\">\u2192</span></a>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"content-section\">\n      <div class=\"wrap\">\n        <div class=\"section-heading\">\n          <p class=\"eyebrow\">Easy as one, two, three</p>\n          <h2>Getting help shouldn\u2019t be hard.</h2>\n          <p class=\"lead\">A simple, personal service from your first call to the finishing touch.</p>\n        </div>\n        <div class=\"process-grid\">\n          <article class=\"process-step\">\n            <h3>Tell us what\u2019s up</h3>\n            <p>Give us a call and let us know what you need. We\u2019ll ask a few questions and talk through the options.</p>\n          </article>\n          <article class=\"process-step\">\n            <h3>We\u2019ll make a plan</h3>\n            <p>We\u2019ll agree what needs doing and explain the next steps, so you know what to expect.</p>\n          </article>\n          <article class=\"process-step\">\n            <h3>Put the kettle on</h3>\n            <p>We\u2019ll get on with the work carefully and leave things tidy when we\u2019re done.</p>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"quote-band\">\n      <div class=\"wrap quote-inner\">\n        <div>\n          <p class=\"eyebrow\">Ready when you are</p>\n          <h2>Let\u2019s get things flowing again.</h2>\n          <p>Tell us what\u2019s happening and we\u2019ll figure out the best next step together.</p>\n        </div>\n        <a class=\"button button--light\" href=\"tel:+441135550198\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M7 3H4.8A1.8 1.8 0 0 0 3 4.8C3 13.7 10.3 21 19.2 21a1.8 1.8 0 0 0 1.8-1.8V17l-5-2-