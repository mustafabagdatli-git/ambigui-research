{"arm": "direct", "model": "openai/gpt-6-luna", "i": 4, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <meta name=\"theme-color\" content=\"#f7f6f0\" />\n  <title>Tidepool \u2014 Make a week that works</title>\n  <style>\n    :root {\n      --ink: #183b3a;\n      --muted: #667a75;\n      --paper: #f7f6f0;\n      --white: #fffefa;\n      --line: #e5e7dc;\n      --teal: #177e74;\n      --teal-dark: #11685f;\n      --mint: #dcefe6;\n      --coral: #f18367;\n      --sun: #f4cb70;\n      --lavender: #e9e5f4;\n      --shadow: 0 22px 70px rgba(27, 61, 57, .12);\n    }\n\n    * { box-sizing: border-box; }\n\n    html { scroll-behavior: smooth; }\n\n    body {\n      margin: 0;\n      color: var(--ink);\n      background: var(--paper);\n      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      -webkit-font-smoothing: antialiased;\n    }\n\n    a { color: inherit; text-decoration: none; }\n\n    .shell {\n      width: min(1160px, calc(100% - 48px));\n      margin: 0 auto;\n    }\n\n    .announcement {\n      padding: 10px 20px;\n      background: var(--ink);\n      color: #f6f4e9;\n      text-align: center;\n      font-size: 12px;\n      letter-spacing: .02em;\n    }\n\n    .announcement span {\n      color: #bde5d5;\n      font-weight: 650;\n    }\n\n    .site-header {\n      position: relative;\n      z-index: 2;\n      border-bottom: 1px solid rgba(24, 59, 58, .07);\n    }\n\n    .nav {\n      height: 76px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n    }\n\n    .brand {\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      font-size: 21px;\n      font-weight: 750;\n      letter-spacing: -.055em;\n    }\n\n    .brand-mark {\n      width: 31px;\n      height: 31px;\n      display: grid;\n      place-items: center;\n      border-radius: 10px;\n      color: white;\n      background: var(--teal);\n    }\n\n    .nav-links {\n      display: flex;\n      align-items: center;\n      gap: 34px;\n      color: #526a65;\n      font-size: 13px;\n      font-weight: 560;\n    }\n\n    .nav-links a:hover { color: var(--teal); }\n\n    .nav-actions {\n      display: flex;\n      align-items: center;\n      gap: 22px;\n      font-size: 13px;\n      font-weight: 650;\n    }\n\n    .nav-login { color: #526a65; }\n\n    .button {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: 9px;\n      min-height: 48px;\n      padding: 0 21px;\n      border: 0;\n      border-radius: 8px;\n      background: var(--teal);\n      color: white;\n      font: inherit;\n      font-size: 13px;\n      font-weight: 700;\n      transition: transform .2s, background .2s, box-shadow .2s;\n      cursor: pointer;\n    }\n\n    .button:hover {\n      transform: translateY(-2px);\n      background: var(--teal-dark);\n      box-shadow: 0 8px 20px rgba(23, 126, 116, .19);\n    }\n\n    .button.small {\n      min-height: 40px;\n      padding: 0 16px;\n      font-size: 12px;\n    }\n\n    .hero {\n      position: relative;\n      overflow: hidden;\n      padding: 76px 0 68px;\n    }\n\n    .hero::before {\n      content: \"\";\n      position: absolute;\n      width: 540px;\n      height: 540px;\n      right: -130px;\n      top: -165px;\n      border-radius: 50%;\n      background: radial-gradient(circle, rgba(220, 239, 230, .8), rgba(220, 239, 230, 0) 68%);\n      pointer-events: none;\n    }\n\n    .hero-grid {\n      position: relative;\n      display: grid;\n      grid-template-columns: .88fr 1.12fr;\n      align-items: center;\n      gap: 44px;\n    }\n\n    .eyebrow {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      margin-bottom: 20px;\n      color: var(--teal);\n      font-size: 11px;\n      font-weight: 750;\n      letter-spacing: .12em;\n      text-transform: uppercase;\n    }\n\n    .eyebrow-dot {\n      width: 7px;\n      height: 7px;\n      background: var(--coral);\n      border-radius: 50%;\n    }\n\n    h1, h2, h3, p { margin-top: 0; }\n\n    h1 {\n      max-width: 510px;\n      margin-bottom: 21px;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: clamp(46px, 5.5vw, 69px);\n      line-height: .99;\n      font-weight: 500;\n      letter-spacing: -.065em;\n    }\n\n    h1 em {\n      color: var(--teal);\n      font-weight: 500;\n    }\n\n    .hero-copy {\n      max-width: 440px;\n      margin-bottom: 28px;\n      color: #60736e;\n      font-size: 16px;\n      line-height: 1.7;\n    }\n\n    .hero-actions {\n      display: flex;\n      align-items: center;\n      gap: 17px;\n      margin-bottom: 20px;\n    }\n\n    .text-link {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      color: var(--ink);\n      font-size: 13px;\n      font-weight: 700;\n    }\n\n    .text-link svg { transition: transform .2s; }\n    .text-link:hover svg { transform: translateX(3px); }\n\n    .fine-print {\n      color: #89958d;\n      font-size: 11px;\n    }\n\n    .hero-art {\n      position: relative;\n      min-height: 438px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n\n    .orbit {\n      position: absolute;\n      width: 430px;\n      height: 430px;\n      border: 1px solid rgba(23, 126, 116, .11);\n      border-radius: 50%;\n    }\n\n    .orbit::after {\n      content: \"\";\n      position: absolute;\n      inset: 28px;\n      border: 1px solid rgba(23, 126, 116, .09);\n      border-radius: 50%;\n    }\n\n    .sun-shape {\n      position: absolute;\n      width: 80px;\n      height: 80px;\n      right: 5%;\n      top: 1%;\n      border-radius: 50%;\n      background: var(--sun);\n      opacity: .9;\n    }\n\n    .sparkle {\n      position: absolute;\n      z-index: 1;\n      color: var(--coral);\n      font-size: 24px;\n      line-height: 1;\n    }\n\n    .sparkle.one { top: 16%; left: 7%; }\n    .sparkle.two { right: 2%; bottom: 16%; font-size: 17px; color: var(--teal); }\n\n    .app-window {\n      position: relative;\n      z-index: 1;\n      width: min(100%, 506px);\n      overflow: hidden;\n      border: 1px solid rgba(25, 62, 57, .11);\n      border-radius: 13px;\n      background: var(--white);\n      box-shadow: var(--shadow);\n      transform: rotate(-1.3deg);\n    }\n\n    .app-top {\n      height: 51px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 0 19px;\n      border-bottom: 1px solid #edf0e9;\n    }\n\n    .app-logo {\n      display: flex;\n      align-items: center;\n      gap: 7px;\n      font-size: 12px;\n      font-weight: 750;\n      letter-spacing: -.03em;\n    }\n\n    .tiny-mark {\n      width: 19px;\n      height: 19px;\n      display: grid;\n      place-items: center;\n      border-radius: 6px;\n      background: var(--teal);\n      color: white;\n    }\n\n    .week-label {\n      color: #80908a;\n      font-size: 10px;\n      font-weight: 600;\n    }\n\n    .avatars {\n      display: flex;\n      align-items: center;\n    }\n\n    .avatar {\n      width: 24px;\n      height: 24px;\n      display: grid;\n      place-items: center;\n      margin-left: -5px;\n      border: 2px solid var(--white);\n      border-radius: 50%;\n      color: #345b52;\n      background: #e6c7a9;\n      font-size: 8px;\n      font-weight: 750;\n    }\n\n    .avatar:nth-child(2) { background: #d8b9d0; }\n    .avatar:nth-child(3) { background: #c6dfcb; }\n    .avatar:nth-child(4) { background: #efc67c; }\n\n    .board {\n      padding: 16px 18px 19px;\n    }\n\n    .board-heading {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      margin-bottom: 14px;\n    }\n\n    .board-heading strong {\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: 20px;\n      font-weight: 500;\n      letter-spacing: -.04em;\n    }\n\n    .board-heading span {\n      padding: 6px 9px;\n      border: 1px solid #e8ece4;\n      border-radius: 6px;\n      color: #6c8078;\n      font-size: 9px;\n      font-weight: 650;\n    }\n\n    .week-grid {\n      display: grid;\n      grid-template-columns: 39px repeat(5, 1fr);\n      border-top: 1px solid #edf0e9;\n      border-left: 1px solid #edf0e9;\n    }\n\n    .week-grid > div {\n      min-width: 0;\n      border-right: 1px solid #edf0e9;\n      border-bottom: 1px solid #edf0e9;\n    }\n\n    .day-name {\n      height: 34px;\n      display: grid;\n      place-items: center;\n      color: #7e8e87;\n      font-size: 8px;\n      font-weight: 700;\n    }\n\n    .day-name.today { color: var(--teal); }\n\n    .time {\n      display: flex;\n      justify-content: center;\n      padding-top: 9px;\n      color: #a2ada5;\n      font-size: 8px;\n    }\n\n    .slot {\n      position: relative;\n      height: 52px;\n      padding: 4px;\n    }\n\n    .event {\n      height: 100%;\n      padding: 6px 6px 4px;\n      border-radius: 5px;\n      overflow: hidden;\n      color: #31564d;\n      background: #e3f1e8;\n      font-size: 8px;\n      font-weight: 700;\n      line-height: 1.25;\n    }\n\n    .event small {\n      display: block;\n      margin-top: 3px;\n      color: #6d8980;\n      font-size: 7px;\n      font-weight: 550;\n    }\n\n    .event.coral { background: #fae8df; color: #895c49; }\n    .event.lavender { background: #eeeaf6; color: #685d84; }\n    .event.yellow { background: #f8f0d8; color: #816b32; }\n\n    .empty-note {\n      position: absolute;\n      left: 50%;\n      bottom: 15px;\n      z-index: 2;\n      width: max-content;\n      padding: 10px 13px;\n      border: 1px solid rgba(24, 59, 58, .08);\n      border-radius: 9px;\n      background: white;\n      box-shadow: 0 9px 24px rgba(27, 61, 57, .11);\n      color: #536c63;\n      font-size: 10px;\n      font-weight: 650;\n      transform: translateX(-50%);\n    }\n\n    .empty-note b { color: var(--teal); }\n\n    .proof {\n      padding: 34px 0 40px;\n      border-top: 1px solid rgba(24, 59, 58, .08);\n      border-bottom: 1px solid rgba(24, 59, 58, .08);\n      text-align: center;\n    }\n\n    .proof p {\n      margin-bottom: 24px;\n      color: #829089;\n      font-size: 10px;\n      font-weight: 750;\n      letter-spacing: .13em;\n      text-transform: uppercase;\n    }\n\n    .team-names {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: clamp(24px, 6vw, 70px);\n      color: #71827b;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: 19px;\n      font-weight: 600;\n      letter-spacing: -.04em;\n    }\n\n    .team-names span:nth-child(2) { font-family: ui-sans-serif, sans-serif; font-size: 16px; font-weight: 800; letter-spacing: -.07em; }\n    .team-names span:nth-child(3) { font-style: italic; }\n    .team-names span:nth-child(4) { font-family: ui-sans-serif, sans-serif; font-size: 15px; font-weight: 750; letter-spacing: -.04em; }\n    .team-names span:nth-child(5) { font-size: 17px; letter-spacing: -.07em; }\n\n    .section {\n      padding: 100px 0;\n    }\n\n    .section-heading {\n      max-width: 620px;\n      margin: 0 auto 52px;\n      text-align: center;\n    }\n\n    .section-heading .eyebrow { margin-bottom: 15px; }\n\n    h2 {\n      margin-bottom: 15px;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: clamp(34px, 4vw, 48px);\n      line-height: 1.08;\n      font-weight: 500;\n      letter-spacing: -.055em;\n    }\n\n    .section-heading p {\n      max-width: 485px;\n      margin: 0 auto;\n      color: var(--muted);\n      font-size: 14px;\n      line-height: 1.7;\n    }\n\n    .feature-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 17px;\n    }\n\n    .feature-card {\n      min-height: 245px;\n      padding: 25px 25px 24px;\n      border: 1px solid #e5e8df;\n      border-radius: 11px;\n      background: rgba(255, 254, 250, .7);\n    }\n\n    .icon-wrap {\n      width: 40px;\n      height: 40px;\n      display: grid;\n      place-items: center;\n      margin-bottom: 30px;\n      border-radius: 11px;\n      color: var(--teal);\n      background: var(--mint);\n    }\n\n    .feature-card:nth-child(2) .icon-wrap { color: #bd664c; background: #fae8df; }\n    .feature-card:nth-child(3) .icon-wrap { color: #776b99; background: var(--lavender); }\n\n    .feature-card h3 {\n      margin-bottom: 9px;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: 21px;\n      font-weight: 500;\n      letter-spacing: -.035em;\n    }\n\n    .feature-card p {\n      margin: 0;\n      color: #70817a;\n      font-size: 12px;\n      line-height: 1.7;\n    }\n\n    .feature-band {\n      padding: 66px 0;\n      background: #e9f1e9;\n    }\n\n    .feature-band-grid {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      align-items: center;\n      gap: 70px;\n    }\n\n    .feature-band-copy .eyebrow { margin-bottom: 16px; }\n\n    .feature-band-copy h2 {\n      max-width: 460px;\n      margin-bottom: 17px;\n    }\n\n    .feature-band-copy p {\n      max-width: 420px;\n      margin-bottom: 23px;\n      color: #60746d;\n      font-size: 14px;\n      line-height: 1.75;\n    }\n\n    .check-list {\n      display: grid;\n      gap: 12px;\n      margin: 0;\n      padding: 0;\n      list-style: none;\n      color: #49635b;\n      font-size: 12px;\n      font-weight: 650;\n    }\n\n    .check-list li {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n    }\n\n    .check {\n      width: 18px;\n      height: 18px;\n      display: grid;\n      place-items: center;\n      border-radius: 50%;\n      background: #cce6d8;\n      color: var(--teal);\n      font-size: 11px;\n      font-weight: 900;\n    }\n\n    .conversation-card {\n      max-width: 440px;\n      margin-left: auto;\n      padding: 24px;\n      border: 1px solid rgba(24, 59, 58, .08);\n      border-radius: 12px;\n      background: var(--white);\n      box-shadow: 0 16px 44px rgba(27, 61, 57, .08);\n    }\n\n    .conversation-top {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding-bottom: 17px;\n      border-bottom: 1px solid #edf0e9;\n      color: #6a7e75;\n      font-size: 10px;\n      font-weight: 700;\n    }\n\n    .online {\n      display: flex;\n      align-items: center;\n      gap: 6px;\n      color: var(--teal);\n      font-size: 9px;\n    }\n\n    .online::before {\n      content: \"\";\n      width: 6px;\n      height: 6px;\n      border-radius: 50%;\n      background: #63b58e;\n    }\n\n    .message {\n      display: flex;\n      align-items: flex-start;\n      gap: 10px;\n      padding-top: 19px;\n    }\n\n    .message .avatar {\n      flex: 0 0 27px;\n      width: 27px;\n      height: 27px;\n      margin: 0;\n      border: 0;\n      font-size: 8px;\n    }\n\n    .message-body {\n      flex: 1;\n      padding: 10px 12px;\n      border-radius: 8px;\n      background: #f1f5ef;\n      color: #60736b;\n      font-size: 10px;\n      line-height: 1.55;\n    }\n\n    .message-body strong {\n      display: block;\n      margin-bottom: 3px;\n      color: var(--ink);\n      font-size: 9px;\n    }\n\n    .message.reply { padding-left: 35px; }\n\n    .poll {\n      margin: 17px 0 0 37px;\n      padding: 13px;\n      border: 1px solid #e8ece4;\n      border-radius: 8px;\n    }\n\n    .poll-title {\n      margin-bottom: 10px;\n      color: var(--ink);\n      font-size: 10px;\n      font-weight: 700;\n    }\n\n    .poll-option {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      margin-top: 7px;\n      padding: 8px 9px;\n      border-radius: 5px;\n      background: #eef5ef;\n      color: #557168;\n      font-size: 9px;\n      font-weight: 600;\n    }\n\n    .poll-option.selected {\n      border: 1px solid #8dc5a8;\n      background: #e7f4e9;\n      color: #327663;\n    }\n\n    .poll-option span:last-child { color: #81938b; font-size: 8px; }\n\n    .quote-section { padding: 94px 0 100px; }\n\n    .quote-card {\n      position: relative;\n      max-width: 800px;\n      margin: 0 auto;\n      text-align: center;\n    }\n\n    .quote-mark {\n      display: block;\n      margin-bottom: 16px;\n      color: var(--coral);\n      font-family: Georgia, serif;\n      font-size: 61px;\n      line-height: .7;\n    }\n\n    blockquote {\n      max-width: 760px;\n      margin: 0 auto 25px;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: clamp(24px, 3.2vw, 37px);\n      line-height: 1.3;\n      letter-spacing: -.04em;\n    }\n\n    .quote-byline {\n      color: #829089;\n      font-size: 11px;\n      line-height: 1.7;\n    }\n\n    .quote-byline strong { color: var(--ink); }\n\n    .cta-section { padding: 0 0 82px; }\n\n    .cta-card {\n      position: relative;\n      overflow: hidden;\n      padding: 58px 35px;\n      border-radius: 14px;\n      background: var(--ink);\n      color: white;\n      text-align: center;\n    }\n\n    .cta-card::before,\n    .cta-card::after {\n      content: \"\";\n      position: absolute;\n      width: 240px;\n      height: 240px;\n      border: 1px solid rgba(195, 232, 211, .15);\n      border-radius: 50%;\n    }\n\n    .cta-card::before { top: -120px; left: -45px; }\n    .cta-card::after { right: -65px; bottom: -165px; width: 340px; height: 340px; }\n\n    .cta-content { position: relative; z-index: 1; }\n\n    .cta-card .eyebrow {\n      color: #a9d7c4;\n      margin-bottom: 15px;\n    }\n\n    .cta-card h2 {\n      max-width: 580px;\n      margin: 0 auto 14px;\n      color: white;\n    }\n\n    .cta-card p {\n      margin-bottom: 23px;\n      color: #bed0c8;\n      font-size: 13px;\n    }\n\n    .cta-card .button {\n      background: #c3e7d4;\n      color: #164943;\n    }\n\n    .cta-card .button:hover { background: white; }\n\n    .site-footer {\n      padding: 25px 0 30px;\n      border-top: 1px solid rgba(24, 59, 58, .08);\n    }\n\n    .footer-row {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 20px;\n    }\n\n    .footer-brand { font-size: 17px; }\n\n    .footer-note {\n      color: #87938c;\n      font-size: 10px;\n    }\n\n    .footer-links {\n      display: flex;\n      gap: 23px;\n      color: #6f8078;\n      font-size: 10px;\n      font-weight: 600;\n    }\n\n    @media (max-width: 900px) {\n      .hero-grid { grid-template-columns: 1fr; gap: 30px; }\n      .hero-copy { max-width: 560px; }\n      .hero-art { min-height: 400px; }\n      .app-window { width: min(100%, 560px); }\n      .feature-band-grid { gap: 36px; }\n    }\n\n    @media (max-width: 680px) {\n      .shell { width: min(100% - 36px, 520px); }\n      .announcement { font-size: 10px; }\n      .nav { height: 66px; }\n      .nav-links, .nav-login { display: none; }\n      .brand { font-size: 19px; }\n      .hero { padding: 55px 0 45px; }\n      h1 { font-size: clamp(44px, 12vw, 60px); }\n      .hero-copy { font-size: 14px; }\n      .hero-actions { flex-wrap: wrap; }\n      .hero-art { min-height: 335px; margin: 0 -8px; }\n      .orbit { width: 330px; height: 330px; }\n      .sun-shape { width: 58px; height: 58px; }\n      .app-window { transform: rotate(-.6deg); }\n      .app-top { padding: 0 12px; }\n      .board { padding: 13px 10px 17px; }\n      .week-grid { grid-template-columns: 29px repeat(5, 1fr); }\n      .slot { height: 48px; padding: 3px; }\n      .event { padding: 5px 4px; font-size: 7px; }\n      .event small { font-size: 6px; }\n      .empty-note { bottom: 7px; font-size: 9px; }\n      .proof { padding: 28px 0; }\n      .team-names { flex-wrap: wrap; gap: 15px 25px; font-size: 16px; }\n      .section { padding: 70px 0; }\n      .section-heading { margin-bottom: 35px; }\n      .feature-grid { grid-template-columns: 1fr; gap: 12px; }\n      .feature-card { min-height: auto; padding: 22px; }\n      .icon-wrap { margin-bottom: 20px; }\n      .feature-band { padding: 60px 0; }\n      .feature-band-grid { grid-template-columns: 1fr; gap: 35px; }\n      .conversation-card { margin: 0; }\n      .quote-section { padding: 70px 0; }\n      .cta-section { padding-bottom: 60px; }\n      .cta-card { padding: 46px 22px; }\n      .footer-row { align-items: flex-start; flex-wrap: wrap; }\n      .footer-note { order: 3; width: 100%; }\n      .footer-links { gap: 15px; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      html { scroll-behavior: auto; }\n      *, *::before, *::after { transition-duration: .01ms !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"announcement\">\n    A calmer kind of teamwork starts here. <span>Meet your new Monday ritual \u2192</span>\n  </div>\n\n  <header class=\"site-header\">\n    <div class=\"shell nav\">\n      <a class=\"brand\" href=\"#\" aria-label=\"Tidepool home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M3 9.2c2.1 0 2.1-2 4.2-2s2.1 2 4.2 2 2.1-2 4.2-2 2.1 2 4.4 2\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n            <path d=\"M3 14.5c2.1 0 2.1-2 4.2-2s2.1 2 4.2 2 2.1-2 4.2-2 2.1 2 4.4 2\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n          </svg>\n        </span>\n        tidepool\n      </a>\n\n      <nav class=\"nav-links\" aria-label=\"Main navigation\">\n        <a href=\"#how-it-works\">How it works</a>\n        <a href=\"#teams\">For teams</a>\n        <a href=\"#stories\">Stories</a>\n      </nav>\n\n      <div class=\"nav-actions\">\n        <a class=\"nav-login\" href=\"#get-started\">Log in</a>\n        <a class=\"button small\" href=\"#get-started\">Try Tidepool <span aria-hidden=\"true\">\u2197</span></a>\n      </div>\n    </div>\n  </header>\n\n  <main>\n    <section class=\"hero\">\n      <div class=\"shell hero-grid\">\n        <div class=\"hero-copy-wrap\">\n          <div class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> A little more in sync</div>\n          <h1>Make a week<br />that <em>works</em> for everyone.</h1>\n          <p class=\"hero-copy\">\n            Tidepool gives your small team one calm place to share priorities, make a plan, and leave room for the good work.\n          </p>\n          <div class=\"hero-actions\">\n            <a class=\"button\" href=\"#get-started\">Plan your first week <span aria-hidden=\"true\">\u2192</span></a>\n            <a class=\"text-link\" href=\"#how-it-works\">\n              See how it works\n              <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\">\n                <path d=\"M3 8h9M8 4l4 4-4 4\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n            </a>\n          </div>\n          <div class=\"fine-print\">Free for teams of up to 5. No credit card needed.</div>\n        </div>\n\n        <div class=\"hero-art\" aria-label=\"Preview of a team's shared weekly plan\">\n          <div class=\"orbit\" aria-hidden=\"true\"></div>\n          <div class=\"sun-shape\" aria-hidden=\"true\"></div>\n          <span class=\"sparkle one\" aria-hidden=\"true\">\u2733</span>\n          <span class=\"sparkle two\" aria-hidden=\"true\">\u2726</span>\n\n          <div class=\"app-window\">\n            <div class=\"app-top\">\n              <div class=\"app-logo\">\n                <span class=\"tiny-mark\" aria-hidden=\"true\">\n                  <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\">\n                    <path d=\"M3 9c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 5 2M3 15c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 5 2\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n                  </svg>\n                </span>\n                tidepool\n              </div>\n              <div class=\"week-label\">MON, MAY 13 \u2014 FRI, MAY 17</div>\n              <div class=\"avatars\" aria-label=\"Four teammates\">\n                <span class=\"avatar\">JM</span><span class=\"avatar\">AL</span><span class=\"avatar\">SK</span><span class=\"avatar\">+</span>\n              </div>\n            </div>\n\n            <div class=\"board\">\n              <div class=\"board-heading\">\n                <strong>Our week, together</strong>\n                <span>\u25f7 &nbsp; Weekly view</span>\n              </div>\n\n              <div class=\"week-grid\">\n                <div class=\"day-name\"></div>\n                <div class=\"day-name today\">MON 13</div>\n                <div class=\"day-name\">TUE 14</div>\n                <div class=\"day-name\">WED 15</div>\n                <div class=\"day-name\">THU 16</div>\n                <div class=\"day-name\">FRI 17</div>\n\n                <div class=\"time\">9am</div>\n                <div class=\"slot\"><div class=\"event\">Weekly kickoff<small>Everyone \u00b7 30m</small></div></div>\n                <div class=\"slot\"></div>\n                <div class=\"slot\"><div class=\"event lavender\">Design review<small>Alex + Sam</small></div></div>\n                <div class=\"slot\"></div>\n                <div class=\"slot\"><div class=\"event yellow\">Show & tell<small>Everyone \u00b7 45m</small></div></div>\n\n                <div class=\"time\">11am</div>\n                <div class=\"slot\"></div>\n                <div class=\"slot\"><div class=\"event coral\">Customer calls<small>Jamie \u00b7 Focus time</small></div></div>\n                <div class=\"slot\"></div>\n                <div class=\"slot\"><div class=\"event\">Build sprint<small>Team focus</small></div></div>\n                <div class=\"slot\"></div>\n\n                <div class=\"time\">1pm</div>\n                <div class=\"slot\"><div class=\"event yellow\">Lunch walk<small>Anyone welcome</small></div></div>\n                <div class=\"slot\"></div>\n                <div class=\"slot\"><div class=\"event coral\">No meetings<small>Focus block</small></div></div>\n                <div class=\"slot\"></div>\n                <div class=\"slot\"><div class=\"event lavender\">Wrap & reflect<small>Everyone \u00b7 20m</small></div></div>\n\n                <div class=\"time\">3pm</div>\n                <div class=\"slot\"></div>\n                <div class=\"slot\"><div class=\"event\">Ship the update<small>Jamie + Alex</small></div></div>\n                <div class=\"slot\"></div>\n                <div class=\"slot\"><div class=\"event yellow\">Open studio<small>Drop in if you like</small></div></div>\n                <div class=\"slot\"></div>\n              </div>\n            </div>\n            <div class=\"empty-note\">A plan with a little <b>breathing room</b> \u2728</div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"proof\" id=\"teams\">\n      <div class=\"shell\">\n        <p>Small teams, making good things together</p>\n        <div class=\"team-names\" aria-label=\"Teams using Tidepool\">\n          <span>Goodside</span>\n          <span>fieldnotes</span>\n          <span>Common Ground</span>\n          <span>softspace</span>\n          <span>Wilder Studio</span>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section\" id=\"how-it-works\">\n      <div class=\"shell\">\n        <div class=\"section-heading\">\n          <div class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> Less chasing, more making</div>\n          <h2>Good weeks don\u2019t just happen.<br />They come together.</h2>\n          <p>Skip the scattered messages and last-minute surprises. Give the whole team a shared view of what matters.</p>\n        </div>\n\n        <div class=\"feature-grid\">\n          <article class=\"feature-card\">\n            <div class=\"icon-wrap\" aria-hidden=\"true\">\n              <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\">\n                <path d=\"M5 5.5h14v14H5zM8 3v5M16 3v5M5 10h14\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n                <path d=\"m9 14 2 2 4-4\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n            </div>\n            <h3>See the whole week</h3>\n            <p>Bring priorities, plans, and people\u2019s availability into one easy view. No more piecing it together from five places.</p>\n          </article>\n\n          <article class=\"feature-card\">\n            <div class=\"icon-wrap\" aria-hidden=\"true\">\n              <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\">\n                <path d=\"M12 20s-7.5-4.5-7.5-10A4.1 4.1 0 0 1 12 7.7 4.1 4.1 0 0 1 19.5 10C19.5 15.5 12 20 12 20Z\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"/>\n                <path d=\"M8.5 12h2l1-2 1.5 4 1-2h1.5\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n            </div>\n            <h3>Make room for people</h3>\n            <p>Plan around real energy, focus time, and the humans on your team\u2014not just a never-ending list of tasks.</p>\n          </article>\n\n          <article class=\"feature-card\">\n            <div class=\"icon-wrap\" aria-hidden=\"true\">\n              <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\">\n                <path d=\"M4 6.5h16M4 12h10M4 17.5h7\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/>\n                <circle cx=\"18\" cy=\"16.5\" r=\"3\" stroke=\"currentColor\" stroke-width=\"1.6\"/>\n                <path d=\"m16.7 16.5.9.9 1.8-1.9\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n            </div>\n            <h3>Keep the plan flexible</h3>\n            <p>Things change. Update the plan together, keep everyone in the loop, and get back to the work that matters.</p>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"feature-band\">\n      <div class=\"shell feature-band-grid\">\n        <div class=\"feature-band-copy\">\n          <div class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> The team\u2019s on the same page</div>\n          <h2>Plan together.<br />Without another meeting.</h2>\n          <p>Check in, share a thought, or find a time that works\u2014all right alongside the plan. The little things stay clear, without filling up your calendar.</p>\n          <ul class=\"check-list\">\n            <li><span class=\"check\">\u2713</span> A simple Monday planning ritual</li>\n            <li><span class=\"check\">\u2713</span> Async updates that don\u2019t get lost</li>\n            <li><span class=\"check\">\u2713</span> Just enough structure to find your flow</li>\n          </ul>\n        </div>\n\n        <div class=\"conversation-card\" aria-label=\"Example team conversation and poll\">\n          <div class=\"conversation-top\">\n            <span>THIS WEEK\u2019S PLAN &nbsp;\u00b7&nbsp; TEAM CHAT</span>\n            <span class=\"online\">4 here</span>\n          </div>\n          <div class=\"message\">\n            <span class=\"avatar\">JM</span>\n            <div class=\"message-body\">\n              <strong>Jamie</strong>\n              I\u2019ve put a focus block in Wednesday morning for the new landing page. Hope that gives everyone some quiet time too \ud83c\udf31\n            </div>\n          </div>\n          <div class=\"message reply\">\n            <span class=\"avatar\">AL</span>\n            <div class=\"message-body\">\n              <strong>Alex</strong>\n              Love that. Could we do our review Thursday instead?\n            </div>\n          </div>\n          <div class=\"poll\">\n            <div class=\"poll-title\">Quick check: when should we share drafts?</div>\n            <div class=\"poll-option selected\"><span>Thursday, 10:30</span><span>3 votes \u2713</span></div>\n            <div class=\"poll-option\"><span>Thursday, 2:00</span><span>1 vote</span></div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"quote-section\" id=\"stories\">\n      <div class=\"shell\">\n        <div class=\"quote-card\">\n          <span class=\"quote-mark\" aria-hidden=\"true\">\u201c</span>\n          <blockquote>\n            We went from \u201cwait, who\u2019s doing what?\u201d to actually looking forward to planning our week. It\u2019s a small change that made a big difference.\n          </blockquote>\n          <div class=\"quote-byline\"><strong>Morgan Lee</strong> \u00b7 Co-founder, Goodside Studio</div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"cta-section\" id=\"get-started\">\n      <div class=\"shell\">\n        <div class=\"cta-card\">\n          <div class=\"cta-content\">\n            <div class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> Find your team\u2019s rhythm</div>\n            <h2>Here\u2019s to a week that feels a little lighter.</h2>\n            <p>Bring your team together and make your first plan in minutes.</p>\n            <a class=\"button\" href=\"mailto:hello@tidepool.team\">Get started for free <span aria-hidden=\"true\">\u2192</span></a>\n          </div>\n        </div>\n      </div>\n    </section>\n  </main>\n\n  <footer class=\"site-footer\">\n    <div class=\"shell footer-row\">\n      <a class=\"brand footer-brand\" href=\"#\" aria-label=\"Tidepool home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M3 9.2c2.1 0 2.1-2 4.2-2s2.1 2 4.2 2 2.1-2 4.2-2 2.1 2 4.4 2M3 14.5c2.1 0 2.1-2 4.2-2s2.1 2 4.2 2 2.1-2 4.2-2 2.1 2 4.4 2\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n          </svg>\n        </span>\n        tidepool\n      </a>\n      <div class=\"footer-note\">Made for small teams, wherever they work. \u00a9 2024 Tidepool</div>\n      <div class=\"footer-links\">\n        <a href=\"#how-it-works\">About</a>\n        <a href=\"mailto:hello@tidepool.team\">Contact</a>\n        <a href=\"#get-started\">Privacy</a>\n      </div>\n    </div>\n  </footer>\n</body>\n</html>"}