{"brief": "B5", "model": "z-ai/glm-5.3-flashx", "i": 2, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Marrow Clinic \u2014 Walk-in Sexual Health Care</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Karla:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n:root{\n  --paper:#FAF5EE;\n  --ink:#1F2A25;\n  --pine:#2E5A4C;\n  --pine-deep:#1E3F35;\n  --clay:#D96B4A;\n  --sand:#F0E7DA;\n  --line:#E2D7C6;\n  --radius:18px;\n}\n*{margin:0;padding:0;box-sizing:border-box}\nhtml{scroll-behavior:smooth}\nbody{\n  font-family:'Karla',sans-serif;\n  background:var(--paper);\n  color:var(--ink);\n  line-height:1.6;\n  -webkit-font-smoothing:antialiased;\n}\nh1,h2,h3,.serif{font-family:'Fraunces',serif;font-weight:500;letter-spacing:-0.01em}\na{color:inherit;text-decoration:none}\n.wrap{max-width:1160px;margin:0 auto;padding:0 24px}\n::selection{background:var(--clay);color:#fff}\n\n/* ---------- header ---------- */\nheader{\n  position:sticky;top:0;z-index:50;\n  background:rgba(250,245,238,.92);\n  backdrop-filter:blur(10px);\n  border-bottom:1px solid var(--line);\n}\n.nav{display:flex;align-items:center;justify-content:space-between;height:72px}\n.logo{display:flex;align-items:center;gap:10px;font-family:'Fraunces',serif;font-size:1.25rem;font-weight:600}\n.logo svg{display:block}\nnav ul{display:flex;gap:32px;list-style:none;font-size:.95rem;font-weight:600}\nnav a{position:relative;padding:4px 0}\nnav a::after{content:\"\";position:absolute;left:0;bottom:0;width:0;height:2px;background:var(--clay);transition:width .25s}\nnav a:hover::after{width:100%}\n.nav-cta{\n  background:var(--pine);color:#fff;padding:11px 22px;border-radius:999px;\n  font-weight:700;font-size:.92rem;transition:background .2s, transform .2s;display:inline-block;\n}\n.nav-cta:hover{background:var(--pine-deep);transform:translateY(-1px)}\n.menu-btn{display:none;background:none;border:0;cursor:pointer}\n\n/* ---------- hero ---------- */\n.hero{padding:80px 0 64px;position:relative;overflow:hidden}\n.hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:64px;align-items:center}\n.eyebrow{\n  display:inline-flex;align-items:center;gap:8px;\n  font-size:.8rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;\n  color:var(--pine);margin-bottom:22px;\n}\n.eyebrow::before{content:\"\";width:28px;height:2px;background:var(--clay)}\n.hero h1{font-size:clamp(2.6rem,5.2vw,4.3rem);line-height:1.06;margin-bottom:22px}\n.hero h1 em{font-style:italic;color:var(--pine)}\n.hero p{font-size:1.13rem;color:#4a564f;max-width:46ch;margin-bottom:32px}\n.hero-actions{display:flex;gap:14px;flex-wrap:wrap;align-items:center}\n.btn{\n  display:inline-flex;align-items:center;gap:10px;padding:15px 28px;border-radius:999px;\n  font-weight:700;font-size:1rem;transition:transform .2s, box-shadow .2s, background .2s;cursor:pointer;border:0;\n}\n.btn-primary{background:var(--clay);color:#fff}\n.btn-primary:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(217,107,74,.35)}\n.btn-ghost{border:2px solid var(--ink);color:var(--ink);background:transparent}\n.btn-ghost:hover{background:var(--ink);color:var(--paper)}\n\n/* status card */\n.status-card{\n  background:var(--pine);color:#F4EFE6;border-radius:24px;padding:36px 34px;\n  position:relative;overflow:hidden;\n  box-shadow:0 24px 60px -20px rgba(30,63,53,.5);\n}\n.status-card::before{\n  content:\"\";position:absolute;top:-60px;right:-60px;width:200px;height:200px;\n  border-radius:50%;background:rgba(255,255,255,.06);\n}\n.status-card::after{\n  content:\"\";position:absolute;bottom:-80px;left:-40px;width:180px;height:180px;\n  border-radius:50%;background:rgba(255,255,255,.05);\n}\n.status-head{display:flex;align-items:center;gap:10px;font-weight:700;font-size:.95rem;margin-bottom:20px}\n.pulse{width:10px;height:10px;border-radius:50%;background:#8FD6A8;position:relative;flex-shrink:0}\n.pulse::after{content:\"\";position:absolute;inset:-6px;border-radius:50%;border:2px solid #8FD6A8;animation:ping 1.8s ease-out infinite}\n@keyframes ping{0%{transform:scale(.5);opacity:1}100%{transform:scale(1.4);opacity:0}}\n.status-rows{position:relative;z-index:1}\n.status-row{display:flex;justify-content:space-between;align-items:baseline;padding:13px 0;border-bottom:1px solid rgba(255,255,255,.15);font-size:.98rem}\n.status-row:last-child{border-bottom:0}\n.status-row strong{font-family:'Fraunces',serif;font-size:1.15rem;font-weight:600}\n.status-row .muted{opacity:.65;font-size:.85rem}\n.status-note{margin-top:18px;font-size:.85rem;opacity:.75;line-height:1.5}\n\n/* ---------- ticker ---------- */\n.ticker{\n  background:var(--ink);color:var(--paper);overflow:hidden;white-space:nowrap;\n  padding:14px 0;font-size:.9rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;\n}\n.ticker-track{display:inline-block;animation:scroll 28s linear infinite}\n.ticker span{margin:0 28px}\n.ticker .dot{color:var(--clay)}\n@keyframes scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}\n\n/* ---------- sections ---------- */\nsection{padding:96px 0}\n.sec-label{font-size:.8rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--clay);margin-bottom:14px}\n.sec-title{font-size:clamp(1.9rem,3.4vw,2.7rem);line-height:1.15;margin-bottom:18px;max-width:22ch}\n.sec-sub{color:#5a655e;max-width:52ch}\n\n/* services \u2014 editorial list */\n.services{background:var(--sand);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}\n.svc-list{margin-top:52px;border-top:1px solid var(--line)}\n.svc{\n  display:grid;grid-template-columns:70px 1fr auto;gap:28px;align-items:center;\n  padding:30px 18px;border-bottom:1px solid var(--line);cursor:pointer;\n  transition:background .25s;\n}\n.svc:hover{background:rgba(255,255,255,.55)}\n.svc-num{font-family:'Fraunces',serif;font-size:1rem;color:var(--clay);font-weight:600}\n.svc h3{font-size:1.5rem;transition:color .2s}\n.svc:hover h3{color:var(--pine)}\n.svc p{color:#5a655e;font-size:.98rem;margin-top:4px;max-width:60ch}\n.svc-icon{\n  width:52px;height:52px;border-radius:50%;border:1.5px solid var(--ink);\n  display:flex;align-items:center;justify-content:center;flex-shrink:0;\n  transition:background .25s, transform .3s;\n}\n.svc:hover .svc-icon{background:var(--pine);border-color:var(--pine);transform:rotate(-45deg)}\n.svc:hover .svc-icon svg{stroke:#fff}\n\n/* steps */\n.steps-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin-top:56px}\n.step{\n  padding:36px 34px 42px;position:relative;\n}\n.step:nth-child(1){background:var(--pine);color:#F4EFE6;border-radius:24px 0 0 24px}\n.step:nth-child(2){background:var(--sand);margin:28px 0;z-index:1;border-radius:0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}\n.step:nth-child(3){background:var(--clay);color:#fff;border-radius:0 24px 24px 0}\n.step-k{font-family:'Fraunces',serif;font-size:3.2rem;font-weight:400;opacity:.35;line-height:1}\n.step h3{font-size:1.35rem;margin:14px 0 10px}\n.step p{font-size:.97rem;opacity:.88}\n\n/* reassurance band */\n.reassure{background:var(--pine-deep);color:#F4EFE6;text-align:center}\n.reassure blockquote{font-family:'Fraunces',serif;font-size:clamp(1.6rem,3vw,2.4rem);line-height:1.3;max-width:24ch;margin:0 auto}\n.reassure em{color:#F0A98F;font-style:italic}\n.reassure cite{display:block;margin-top:26px;font-family:'Karla',sans-serif;font-style:normal;font-size:.9rem;letter-spacing:.12em;text-transform:uppercase;opacity:.6}\n\n/* FAQ */\n.faq-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:64px;align-items:start}\n.faq-item{border-bottom:1px solid var(--line)}\n.faq-q{\n  width:100%;background:none;border:0;cursor:pointer;text-align:left;\n  display:flex;justify-content:space-between;align-items:center;gap:20px;\n  padding:24px 4px;font-family:'Fraunces',serif;font-size:1.2rem;color:var(--ink);\n}\n.faq-q:hover{color:var(--pine)}\n.faq-q .plus{flex-shrink:0;width:30px;height:30px;border-radius:50%;border:1.5px solid var(--ink);display:flex;align-items:center;justify-content:center;transition:transform .3s, background .25s}\n.faq-item.open .plus{transform:rotate(45deg);background:var(--clay);border-color:var(--clay)}\n.faq-item.open .plus svg line{stroke:#fff}\n.faq-a{max-height:0;overflow:hidden;transition:max-height .35s ease}\n.faq-a p{padding:0 4px 24px;color:#5a655e;max-width:60ch}\n\n/* visit */\n.visit{background:var(--sand);border-top:1px solid var(--line)}\n.visit-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;margin-top:48px;align-items:stretch}\n.hours{background:#fff;border:1px solid var(--line);border-radius:24px;padding:36px}\n.hours h3{font-size:1.4rem;margin-bottom:20px}\n.hour-row{display:flex;justify-content:space-between;padding:11px 0;border-bottom:1px dashed var(--line);font-size:.98rem}\n.hour-row:last-of-type{border-bottom:0}\n.hour-row.today{font-weight:700;color:var(--pine)}\n.hour-row .tag{background:var(--clay);color:#fff;font-size:.68rem;font-weight:700;padding:3px 10px;border-radius:999px;letter-spacing:.08em;text-transform:uppercase;margin-left:10px}\n.address-card{background:var(--pine);border-radius:24px;color:#F4EFE6;padding:36px;display:flex;flex-direction:column;gap:22px}\n.addr-line{display:flex;gap:14px;align-items:flex-start;font-size:.98rem}\n.addr-line svg{flex-shrink:0;margin-top:3px}\n.addr-line strong{display:block;font-size:1.05rem;margin-bottom:2px}\n.map-note{margin-top:auto;font-size:.85rem;opacity:.7;border-top:1px solid rgba(255,255,255,.2);padding-top:18px}\n\n/* footer */\nfooter{background:var(--ink);color:#CFC9BE;padding:64px 0 32px;font-size:.9rem}\n.foot-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:48px;margin-bottom:48px}\n.foot-grid .logo{color:var(--paper);margin-bottom:14px}\n.foot-grid h4{color:var(--paper);font-family:'Karla',sans-serif;font-weight:700;font-size:.85rem;letter-spacing:.12em;text-transform:uppercase;margin-bottom:16px}\n.foot-grid ul{list-style:none}\n.foot-grid li{margin-bottom:10px}\n.foot-grid a:hover{color:#fff;text-decoration:underline}\n.foot-bottom{border-top:1px solid rgba(255,255,255,.12);padding-top:24px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:.82rem;opacity:.7}\n\n/* reveal */\n.reveal{opacity:0;transform:translateY(24px);transition:opacity .7s ease, transform .7s ease}\n.reveal.in{opacity:1;transform:none}\n\n/* toast */\n.toast{\n  position:fixed;bottom:28px;left:50%;transform:translateX(-50%) translateY(80px);\n  background:var(--ink);color:var(--paper);padding:14px 26px;border-radius:999px;\n  font-weight:600;font-size:.92rem;opacity:0;transition:all .35s;z-index:100;pointer-events:none;\n  box-shadow:0 12px 30px rgba(0,0,0,.3);\n}\n.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}\n\n@media(max-width:900px){\n  .hero-grid,.faq-grid,.visit-grid{grid-template-columns:1fr}\n  .steps-grid{grid-template-columns:1fr}\n  .step{border-radius:24px !important;margin:0 !important}\n  .step:nth-child(2){margin:14px 0 !important}\n  nav ul{display:none}\n  .menu-btn{display:block}\n  .foot-grid{grid-template-columns:1fr}\n  section{padding:72px 0}\n  .svc{grid-template-columns:44px 1fr;gap:16px}\n  .svc-icon{display:none}\n}\n</style>\n</head>\n<body>\n\n<header>\n  <div class=\"wrap nav\">\n    <a href=\"#\" class=\"logo\">\n      <svg width=\"30\" height=\"30\" viewBox=\"0 0 30 30\" fill=\"none\">\n        <circle cx=\"15\" cy=\"15\" r=\"14\" stroke=\"#2E5A4C\" stroke-width=\"2\"/>\n        <path d=\"M15 8c-3 3-5 4.5-5 7a5 5 0 0 0 10 0c0-2.5-2-4-5-7z\" fill=\"#D96B4A\"/>\n      </svg>\n      Marrow Clinic\n    </a>\n    <nav>\n      <ul>\n        <li><a href=\"#services\">Services</a></li>\n        <li><a href=\"#how\">Your Visit</a></li>\n        <li><a href=\"#faq\">Questions</a></li>\n        <li><a href=\"#visit\">Find Us</a></li>\n      </ul>\n    </nav>\n    <a href=\"tel:+15550174400\" class=\"nav-cta\">(555) 017-4400</a>\n    <button class=\"menu-btn\" aria-label=\"Menu\" onclick=\"document.querySelector('nav ul').style.display=document.querySelector('nav ul').style.display==='flex'?'none':'flex'\">\n      <svg width=\"26\" height=\"26\" viewBox=\"0 0 26 26\" stroke=\"#1F2A25\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M4 8h18M4 13h18M4 18h18\"/></svg>\n    </button>\n  </div>\n</header>\n\n<!-- HERO -->\n<section class=\"hero\">\n  <div class=\"wrap hero-grid\">\n    <div>\n      <span class=\"eyebrow\">Walk-ins welcome \u00b7 No referral needed</span>\n      <h1>Sexual health care, <em>without the awkward part.</em></h1>\n      <p>Testing, treatment and honest answers \u2014 usually in under an hour. Come as you are, leave with a plan. Most visits are free or low-cost, and nothing leaves the building.</p>\n      <div class=\"hero-actions\">\n        <a href=\"#visit\" class=\"btn btn-primary\">Plan Your Visit\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M3 8h10M9 4l4 4-4 4\"/></svg>\n        </a>\n        <a href=\"tel:+15550174400\" class=\"btn btn-ghost\">Call the front desk</a>\n      </div>\n    </div>\n    <div class=\"status-card\">\n      <div class=\"status-head\"><span class=\"pulse\"></span> Right now at Marrow</div>\n      <div class=\"status-rows\">\n        <div class=\"status-row\"><span><strong id=\"openState\">Open</strong></span><span class=\"muted\" id=\"closesIn\">until 7:00 pm</span></div>\n        <div class=\"status-row\"><span>Current wait</span><span><strong>~15 min</strong></span></div>\n        <div class=\"status-row\"><span>Same-day results</span><span><strong>HIV \u00b7 Gonorrhea \u00b7 Chlamydia</strong></span></div>\n        <div class=\"status-row\"><span>Cost</span><span><strong>Free \u2013 $40</strong><br><span class=\"muted\">nobody turned away</span></span></div>\n      </div>\n      <p class=\"status-note\">Waiting in the lobby not your thing? Check in by text and we'll ping you when a room is ready.</p>\n    </div>\n  </div>\n</section>\n\n<!-- TICKER -->\n<div class=\"ticker\" aria-hidden=\"true\">\n  <div class=\"ticker-track\" id=\"tickerTrack\"></div>\n</div>\n\n<!-- SERVICES -->\n<section class=\"services\" id=\"services\">\n  <div class=\"wrap\">\n    <p class=\"sec-label\">What we do</p>\n    <h2 class=\"sec-title\">Everything a check-up should be. Nothing it shouldn't.</h2>\n    <p class=\"sec-sub\">One visit, one team, zero lectures. Tap any service to see what it involves.</p>\n    <div class=\"svc-list\" id=\"svcList\"></div>\n  </div>\n</section>\n\n<!-- HOW IT WORKS -->\n<section id=\"how\">\n  <div class=\"wrap\">\n    <p class=\"sec-label\">Your visit</p>\n    <h2 class=\"sec-title\">Three steps. Roughly an hour. That's it.</h2>\n    <div class=\"steps-grid\">\n      <div class=\"step reveal\">\n        <div class=\"step-k\">01</div>\n        <h3>Walk in &amp; check in</h3>\n        <p>No appointment, no referral, no explanation needed at the desk. First name and a way to reach you \u2014 that's all we ask for.</p>\n      </div>\n      <div class=\"step reveal\">\n        <div class=\"step-k\">02</div>\n        <h3>Talk to a clinician</h3>\n        <p>A private conversation, on your terms. Whatever you share stays between you and your care team. Ask us anything \u2014 we've heard it all.</p>\n      </div>\n      <div class=\"step reveal\">\n        <div class=\"step-k\">03</div>\n        <h3>Test, treat, done</h3>\n        <p>Most results are same-day. If you need treatment, we usually start it before you leave \u2014 and follow up by text, never by phone call at work.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- REASSURANCE -->\n<section class=\"reassure\">\n  <div class=\"wrap\">\n    <blockquote class=\"reveal\">\n      &ldquo;What you tell us <em>stays with us.</em> Your visit isn't on any record your employer, family, or insurer can see.&rdquo;\n    </blockquote>\n    <cite>Our confidentiality promise \u2014 posted in every room</cite>\n  </div>\n</section>\n\n<!-- FAQ -->\n<section id=\"faq\">\n  <div class=\"wrap faq-grid\">\n    <div>\n      <p class=\"sec-label\">Questions</p>\n      <h2 class=\"sec-title\">The things people actually ask us</h2>\n      <p class=\"sec-sub\">No question is too basic, too blunt, or too embarrassing. Seriously \u2014 these are the top four.</p>\n    </div>\n    <div id=\"faqList\"></div>\n  </div>\n</section>\n\n<!-- VISIT -->\n<section class=\"visit\" id=\"visit\">\n  <div class=\"wrap\">\n    <p class=\"sec-label\">Find us</p>\n    <h2 class=\"sec-title\">On the corner of Alder &amp; 9th. Look for the green door.</h2>\n    <div class=\"visit-grid\">\n      <div class=\"hours reveal\">\n        <h3>Walk-in hours</h3>\n        <div id=\"hoursList\"></div>\n      </div>\n      <div class=\"address-card reveal\">\n        <div class=\"addr-line\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"#F0A98F\" stroke-width=\"1.8\" stroke-linecap=\"round\"><path d=\"M10 18s6-5.2 6-9.5A6 6 0 0 0 4 8.5C4 12.8 10 18 10 18z\"/><circle cx=\"10\" cy=\"8.5\" r=\"2.2\"/></svg>\n          <div><strong>1420 Alder Street, Suite 100</strong>Harborview, CA 92104</div>\n        </div>\n        <div class=\"addr-line\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"#F0A98F\" stroke-width=\"1.8\" stroke-linecap=\"round\"><path d=\"M3 5h14v10H3z\"/><path d=\"M3 6l7 5 7-5\"/></svg>\n          <div><strong>hello@marrowclinic.org</strong>Email is fine. Replies come from a neutral sender name.</div>\n        </div>\n        <div class=\"addr-line\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"#F0A98F\" stroke-width=\"1.8\" stroke-linecap=\"round\"><circle cx=\"10\" cy=\"10\" r=\"7.5\"/><path d=\"M10 5.5V10l3 2\"/></svg>\n          <div><strong>Bus 14 &amp; 22 stop out front</strong>Two blocks from the 9th St. station. Bike racks by the entrance.</div>\n        </div>\n        <p class=\"map-note\">The waiting room has a side entrance if you'd rather skip the main street window. Just ask for \"the back door\" \u2014 staff will know.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<footer>\n  <div class=\"wrap\">\n    <div class=\"foot-grid\">\n      <div>\n        <div class=\"logo\">\n          <svg width=\"26\" height=\"26\" viewBox=\"0 0 30 30\" fill=\"none\">\n            <circle cx=\"15\" cy=\"15\" r=\"14\" stroke=\"#F0A98F\" stroke-width=\"2\"/>\n            <path d=\"M15 8c-3 3-5 4.5-5 7a5 5 0 0 0 10 0c0-2.5-2-4-5-7z\" fill=\"#F0A98F\"/>\n          </svg>\n          Marrow Clinic\n        </div>\n        <p>Independent, judgement-free sexual health care for everyone. A registered 501(c)(3) community health provider.</p>\n      </div>\n      <div>\n        <h4>Clinic</h4>\n        <ul>\n          <li><a href=\"#services\">Services</a></li>\n          <li><a href=\"#how\">Your visit</a></li>\n          <li><a href=\"#faq\">FAQ</a></li>\n          <li><a href=\"#visit\">Hours &amp; location</a></li>\n        </ul>\n      </div>\n      <div>\n        <h4>If it can't wait</h4>\n        <ul>\n          <li>Crisis line: <a href=\"tel:988\">call or text 988</a></li>\n          <li>After-hours nurse: <a href=\"tel:+15550174411\">(555) 017-4411</a></li>\n          <li>PEP works best within 72 hours \u2014 come in immediately.</li>\n        </ul>\n      </div>\n    </div>\n    <div class=\"foot-bottom\">\n      <span>\u00a9 2025 Marrow Community Health Clinic</span>\n      <span>Confidential \u00b7 Free or low-cost \u00b7 Everyone welcome</span>\n    </div>\n  </div>\n</footer>\n\n<div class=\"toast\" id=\"toast\"></div>\n\n<script>\n// ---- ticker ----\nconst items = [\"Walk-ins always welcome\",\"Free & low-cost testing\",\"Fully confidential\",\"Same-day results\",\"No insurance required\",\"All people, all identities\",\"Judgement-free zone\"];\ndocument.getElementById('tickerTrack').innerHTML =\n  (items.map(i=>`<span>${i}</span><span class=\"dot\">\u25cf</span>`).join('')).repeat(2);\n\n// ---- services ----\nconst services = [\n  [\"STI & HIV testing\",\"Quick swabs, blood draws or urine tests. HIV results in 20 minutes with a finger prick; most others back within the hour.\"],\n  [\"Treatment & prescriptions\",\"If something comes back positive, we treat it on the spot \u2014 antibiotics, antivirals, and prescriptions you can fill next door.\"],\n  [\"Contraception & options counselling\",\"Pills, implants, emergency contraception, and a conversation about what actually fits your life. No pressure, ever.\"],\n  [\"PrEP & PEP\",\"Daily and on-demand HIV prevention. If you may have been exposed in the last 72 hours, come in right now \u2014 PEP is urgent.\"],\n  [\"Vaccinations\",\"HPV and hepatitis A & B vaccines, including catch-up doses for adults. Most are free regardless of insurance.\"],\n  [\"Partner notification support\",\"Tested positive? We can notify partners anonymously so they can get treated \u2014 your name never comes up.\"]\n];\ndocument.getElementById('svcList').innerHTML = services.map(([t,d],i)=>`\n  <div class=\"svc\" onclick=\"toast('Ask about \u201c${t}\u201d at the front desk \u2014 no appointment needed.')\">\n    <div class=\"svc-num\">0${i+1}</div>\n    <div><h3>${t}</h3><p>${d}</p></div>\n    <div class=\"svc-icon\">\n      <svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"#1F2A25\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M5 15L15 5M8 5h7v7\"/></svg>\n    </div>\n  </div>`).join('');\n\n// ---- FAQ ----\nconst faqs = [\n  [\"Will anyone find out I was here?\",\"No. We're a confidential clinic \u2014 we don't report visits to insurers, employers, or family. Records are kept under your first name unless you choose otherwise, and we never call without checking how you'd like to be contacted first.\"],\n  [\"Do I need insurance or ID?\",\"Neither. Services are free to $40 on a sliding scale, and we won't turn anyone away for an inability to pay. A photo ID helps but isn't required.\"],\n  [\"How long does a visit take?\",\"Most testing visits wrap up in 45\u201360 minutes, including a short chat with a clinician. Rapid HIV results take about 20 minutes. If the lobby is busy, you can check in by text and wait elsewhere.\"],\n  [\"I think I was exposed. What do I do right now?\",\"Come in today. For HIV exposure, PEP medication works best within 24 hours and must start within 72 \u2014 we keep it stocked and can start you on it during a single visit. Outside our hours, call the after-hours nurse line.\"]\n];\ndocument.getElementById('faqList').innerHTML = faqs.map(([q,a])=>`\n  <div class=\"faq-item\">\n    <button class=\"faq-q\">${q}\n      <span class=\"plus\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 12 12\" stroke=\"#1F2A25\" stroke-width=\"2\" stroke-linecap=\"round\"><line x1=\"6\" y1=\"1\" x2=\"6\" y2=\"11\"/><line x1=\"1\" y1=\"6\" x2=\"11\" y2=\"6\"/></svg></span>\n    </button>\n    <div class=\"faq-a\"><p>${a}</p></div>\n  </div>`).join('');\ndocument.querySelectorAll('.faq-q').forEach(btn=>{\n  btn.addEventListener('click',()=>{\n    const item = btn.parentElement, ans = item.querySelector('.faq-a');\n    const open = item.classList.contains('open');\n    document.querySelectorAll('.faq-item.open').forEach(o=>{o.classList.remove('open');o.querySelector('.faq-a').style.maxHeight=null;});\n    if(!open){item.classList.add('open');ans.style.maxHeight=ans.scrollHeight+'px';}\n  });\n});\n\n// ---- hours (today highlighted) ----\nconst days = [[\"Sunday\",\"10:00 am \u2013 3:00 pm\"],[\"Monday\",\"8:00 am \u2013 7:00 pm\"],[\"Tuesday\",\"8:00 am \u2013 7:00 pm\"],[\"Wednesday\",\"8:00 am \u2013 7:00 pm\"],[\"Thursday\",\"8:00 am \u2013 7:00 pm\"],[\"Friday\",\"8:00 am \u2013 6:00 pm\"],[\"Saturday\",\"9:00 am \u2013 4:00 pm\"]];\nconst today = new Date().getDay();\ndocument.getElementById('hoursList').innerHTML = days.map(([d,h],i)=>\n  `<div class=\"hour-row ${i===today?'today':''}\"><span>${d}${i===today?'<span class=\"tag\">Today</span>':''}</span><span>${h}</span></div>`).join('');\nconst todayHours = days[today][1];\nconst openNow = todayHours !== 'Closed';\nif(!openNow){document.getElementById('openState').textContent='Closed now';document.getElementById('closesIn').textContent='walk-ins resume per hours below';}\n\n// ---- toast ----\nlet toastTimer;\nfunction toast(msg){\n  const t = document.getElementById('toast');\n  t.textContent = msg; t.classList.add('show');\n  clearTimeout(toastTimer);\n  toastTimer = setTimeout(()=>t.classList.remove('show'), 3200);\n}\n\n// ---- reveal on scroll ----\nconst io = new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}}),{threshold:.15});\ndocument.querySelectorAll('.reveal').forEach(el=>io.observe(el));\n</script>\n</body>\n</html>\n"}