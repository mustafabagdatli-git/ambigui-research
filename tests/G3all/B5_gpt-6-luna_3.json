{"brief": "B5", "model": "openai/gpt-6-luna", "i": 3, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#f8f6f0\">\n  <title>Open Door \u2014 Sexual Health, On Your Terms</title>\n  <style>\n    :root {\n      --ink: #193c38;\n      --ink-soft: #4e6660;\n      --green: #2b6557;\n      --green-dark: #214c43;\n      --lime: #d8ee9d;\n      --coral: #f28a70;\n      --cream: #f8f6f0;\n      --paper: #fffefa;\n      --line: #dfdfd5;\n      --lavender: #e8e5f2;\n      --shadow: 0 18px 50px rgba(25, 60, 56, .10);\n      --radius: 22px;\n    }\n\n    * { box-sizing: border-box; }\n\n    html { scroll-behavior: smooth; }\n\n    body {\n      margin: 0;\n      background: var(--cream);\n      color: var(--ink);\n      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      line-height: 1.55;\n      -webkit-font-smoothing: antialiased;\n    }\n\n    a { color: inherit; }\n\n    a:focus-visible {\n      outline: 3px solid var(--coral);\n      outline-offset: 4px;\n      border-radius: 4px;\n    }\n\n    .wrap {\n      width: min(1160px, calc(100% - 48px));\n      margin-inline: auto;\n    }\n\n    .topbar {\n      padding: 12px 24px;\n      background: var(--ink);\n      color: white;\n      text-align: center;\n      font-size: .82rem;\n      letter-spacing: .02em;\n    }\n\n    .topbar a {\n      color: var(--lime);\n      font-weight: 700;\n      text-decoration-thickness: 1px;\n      text-underline-offset: 3px;\n    }\n\n    header {\n      border-bottom: 1px solid rgba(25, 60, 56, .09);\n      background: rgba(248, 246, 240, .94);\n    }\n\n    .nav {\n      min-height: 82px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 28px;\n    }\n\n    .brand {\n      display: inline-flex;\n      align-items: center;\n      gap: 11px;\n      color: var(--ink);\n      text-decoration: none;\n      font-size: 1.2rem;\n      font-weight: 800;\n      letter-spacing: -.045em;\n    }\n\n    .brand-mark {\n      width: 38px;\n      height: 38px;\n      display: grid;\n      place-items: center;\n      color: var(--ink);\n      background: var(--lime);\n      border-radius: 13px 13px 13px 4px;\n    }\n\n    .brand-mark svg { width: 23px; height: 23px; }\n\n    .nav-links {\n      display: flex;\n      align-items: center;\n      gap: 30px;\n      font-size: .92rem;\n      font-weight: 650;\n    }\n\n    .nav-links a {\n      text-decoration: none;\n      color: var(--ink-soft);\n    }\n\n    .nav-links a:hover { color: var(--green); }\n\n    .button {\n      display: inline-flex;\n      min-height: 48px;\n      padding: 0 21px;\n      align-items: center;\n      justify-content: center;\n      gap: 9px;\n      border: 0;\n      border-radius: 999px;\n      background: var(--green);\n      color: white;\n      text-decoration: none;\n      font: inherit;\n      font-size: .93rem;\n      font-weight: 750;\n      transition: background .2s ease, transform .2s ease;\n    }\n\n    .button:hover {\n      background: var(--green-dark);\n      transform: translateY(-1px);\n    }\n\n    .button svg { width: 17px; height: 17px; }\n\n    .button-light {\n      color: var(--ink);\n      background: white;\n      border: 1px solid var(--line);\n    }\n\n    .button-light:hover { background: var(--lime); }\n\n    .hero {\n      padding: 72px 0 82px;\n      overflow: hidden;\n    }\n\n    .hero-grid {\n      display: grid;\n      grid-template-columns: 1.05fr .95fr;\n      align-items: center;\n      gap: 72px;\n    }\n\n    .eyebrow {\n      display: inline-flex;\n      align-items: center;\n      gap: 9px;\n      margin: 0 0 20px;\n      color: var(--green);\n      font-size: .78rem;\n      font-weight: 800;\n      letter-spacing: .13em;\n      text-transform: uppercase;\n    }\n\n    .eyebrow::before {\n      width: 23px;\n      height: 2px;\n      content: \"\";\n      background: var(--coral);\n    }\n\n    h1, h2, h3, p { margin-top: 0; }\n\n    h1 {\n      max-width: 650px;\n      margin-bottom: 23px;\n      font-size: clamp(3.2rem, 6.4vw, 5.65rem);\n      line-height: .99;\n      letter-spacing: -.075em;\n      font-weight: 750;\n    }\n\n    h1 em {\n      color: var(--green);\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-weight: 500;\n    }\n\n    .hero-copy {\n      max-width: 540px;\n      margin-bottom: 28px;\n      color: var(--ink-soft);\n      font-size: 1.12rem;\n      line-height: 1.7;\n    }\n\n    .hero-actions {\n      display: flex;\n      flex-wrap: wrap;\n      align-items: center;\n      gap: 12px;\n    }\n\n    .quiet-note {\n      margin: 18px 0 0;\n      color: #64756e;\n      font-size: .84rem;\n    }\n\n    .visual {\n      position: relative;\n      min-height: 440px;\n      display: grid;\n      place-items: center;\n    }\n\n    .visual-blob {\n      position: absolute;\n      width: min(420px, 95%);\n      aspect-ratio: 1;\n      border-radius: 43% 57% 58% 42% / 47% 43% 57% 53%;\n      background: var(--lavender);\n      transform: rotate(-8deg);\n    }\n\n    .visual-blob::before {\n      position: absolute;\n      width: 126px;\n      height: 126px;\n      top: 12px;\n      right: -18px;\n      content: \"\";\n      border-radius: 50%;\n      background: var(--coral);\n      opacity: .9;\n    }\n\n    .visual-blob::after {\n      position: absolute;\n      width: 74px;\n      height: 74px;\n      bottom: 15px;\n      left: -16px;\n      content: \"\";\n      border-radius: 50%;\n      background: var(--lime);\n    }\n\n    .visit-card {\n      position: relative;\n      z-index: 1;\n      width: min(360px, 85%);\n      padding: 28px;\n      border: 1px solid rgba(25, 60, 56, .08);\n      border-radius: 24px;\n      background: var(--paper);\n      box-shadow: var(--shadow);\n      transform: rotate(2deg);\n    }\n\n    .card-kicker {\n      display: flex;\n      align-items: center;\n      gap: 9px;\n      color: var(--green);\n      font-size: .79rem;\n      font-weight: 800;\n      letter-spacing: .08em;\n      text-transform: uppercase;\n    }\n\n    .status-dot {\n      width: 9px;\n      height: 9px;\n      border-radius: 50%;\n      background: #70a855;\n      box-shadow: 0 0 0 4px #e9f1df;\n    }\n\n    .visit-card h2 {\n      margin: 18px 0 8px;\n      font-size: 1.75rem;\n      letter-spacing: -.05em;\n      line-height: 1.15;\n    }\n\n    .visit-card > p {\n      margin-bottom: 22px;\n      color: var(--ink-soft);\n      font-size: .94rem;\n    }\n\n    .visit-detail {\n      display: flex;\n      align-items: flex-start;\n      gap: 12px;\n      padding: 15px 0;\n      border-top: 1px solid var(--line);\n      font-size: .9rem;\n    }\n\n    .visit-detail svg {\n      flex: 0 0 19px;\n      width: 19px;\n      height: 19px;\n      color: var(--green);\n    }\n\n    .visit-detail strong {\n      display: block;\n      margin-bottom: 2px;\n    }\n\n    .visit-detail span { color: var(--ink-soft); }\n\n    .mini-sticker {\n      position: absolute;\n      z-index: 2;\n      right: -20px;\n      bottom: 22px;\n      width: 107px;\n      height: 107px;\n      display: grid;\n      place-items: center;\n      padding: 13px;\n      border-radius: 50%;\n      background: var(--lime);\n      color: var(--ink);\n      text-align: center;\n      font-size: .78rem;\n      font-weight: 800;\n      line-height: 1.2;\n      transform: rotate(9deg);\n    }\n\n    .trust-strip {\n      padding: 19px 0;\n      background: var(--ink);\n      color: white;\n    }\n\n    .trust-inner {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 24px;\n    }\n\n    .trust-intro {\n      margin: 0;\n      color: var(--lime);\n      font-size: .78rem;\n      font-weight: 800;\n      letter-spacing: .12em;\n      text-transform: uppercase;\n    }\n\n    .trust-items {\n      display: flex;\n      flex-wrap: wrap;\n      justify-content: flex-end;\n      gap: 30px;\n      color: rgba(255,255,255,.88);\n      font-size: .9rem;\n      font-weight: 600;\n    }\n\n    .trust-items span {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n    }\n\n    .trust-items svg {\n      width: 17px;\n      height: 17px;\n      color: var(--lime);\n    }\n\n    .section {\n      padding: 94px 0;\n    }\n\n    .section-heading {\n      max-width: 670px;\n      margin-bottom: 38px;\n    }\n\n    .section-heading h2 {\n      margin-bottom: 14px;\n      font-size: clamp(2.2rem, 4vw, 3.35rem);\n      line-height: 1.05;\n      letter-spacing: -.065em;\n    }\n\n    .section-heading p {\n      max-width: 560px;\n      margin-bottom: 0;\n      color: var(--ink-soft);\n      font-size: 1.03rem;\n    }\n\n    .services-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 16px;\n    }\n\n    .service-card {\n      min-height: 206px;\n      padding: 25px;\n      border: 1px solid var(--line);\n      border-radius: var(--radius);\n      background: var(--paper);\n      transition: transform .2s ease, box-shadow .2s ease;\n    }\n\n    .service-card:hover {\n      transform: translateY(-3px);\n      box-shadow: 0 14px 35px rgba(25, 60, 56, .08);\n    }\n\n    .service-icon {\n      width: 43px;\n      height: 43px;\n      display: grid;\n      place-items: center;\n      margin-bottom: 21px;\n      border-radius: 14px;\n      background: #e8f0df;\n      color: var(--green);\n    }\n\n    .service-card:nth-child(2) .service-icon,\n    .service-card:nth-child(5) .service-icon { background: #fbe8df; }\n\n    .service-card:nth-child(3) .service-icon,\n    .service-card:nth-child(6) .service-icon { background: var(--lavender); }\n\n    .service-icon svg { width: 22px; height: 22px; }\n\n    .service-card h3 {\n      margin-bottom: 7px;\n      font-size: 1.08rem;\n      letter-spacing: -.02em;\n    }\n\n    .service-card p {\n      margin: 0;\n      color: var(--ink-soft);\n      font-size: .92rem;\n    }\n\n    .service-footnote {\n      margin: 20px 0 0;\n      color: #64756e;\n      font-size: .84rem;\n    }\n\n    .how-section {\n      background: #eef1e8;\n    }\n\n    .how-grid {\n      display: grid;\n      grid-template-columns: .85fr 1.15fr;\n      gap: 80px;\n      align-items: start;\n    }\n\n    .how-grid .section-heading { margin-bottom: 0; }\n\n    .steps {\n      display: grid;\n      gap: 0;\n    }\n\n    .step {\n      display: grid;\n      grid-template-columns: 46px 1fr;\n      gap: 17px;\n      padding: 0 0 27px;\n    }\n\n    .step + .step {\n      padding-top: 24px;\n      border-top: 1px solid #d5ded1;\n    }\n\n    .step-number {\n      width: 42px;\n      height: 42px;\n      display: grid;\n      place-items: center;\n      border-radius: 50%;\n      background: var(--lime);\n      font-size: .9rem;\n      font-weight: 800;\n    }\n\n    .step h3 {\n      margin: 1px 0 7px;\n      font-size: 1.08rem;\n    }\n\n    .step p {\n      max-width: 480px;\n      margin: 0;\n      color: var(--ink-soft);\n      font-size: .94rem;\n    }\n\n    .care-section { padding: 89px 0; }\n\n    .care-panel {\n      display: grid;\n      grid-template-columns: 1.1fr .9fr;\n      overflow: hidden;\n      border-radius: 28px;\n      background: var(--green);\n      color: white;\n    }\n\n    .care-copy { padding: 54px; }\n\n    .care-copy .eyebrow { color: var(--lime); }\n\n    .care-copy h2 {\n      max-width: 530px;\n      margin-bottom: 17px;\n      font-size: clamp(2.2rem, 4vw, 3.35rem);\n      line-height: 1.03;\n      letter-spacing: -.065em;\n    }\n\n    .care-copy p {\n      max-width: 510px;\n      margin-bottom: 24px;\n      color: rgba(255,255,255,.82);\n    }\n\n    .care-copy .button {\n      background: var(--lime);\n      color: var(--ink);\n    }\n\n    .care-copy .button:hover { background: white; }\n\n    .care-aside {\n      position: relative;\n      display: grid;\n      align-content: center;\n      padding: 46px;\n      background: #214f46;\n    }\n\n    .care-aside::before {\n      position: absolute;\n      width: 210px;\n      height: 210px;\n      top: -52px;\n      right: -42px;\n      content: \"\";\n      border: 1px solid rgba(216,238,157,.36);\n      border-radius: 50%;\n    }\n\n    .care-aside::after {\n      position: absolute;\n      width: 145px;\n      height: 145px;\n      right: 24px;\n      bottom: -75px;\n      content: \"\";\n      border: 1px solid rgba(216,238,157,.36);\n      border-radius: 50%;\n    }\n\n    .care-quote {\n      position: relative;\n      z-index: 1;\n      margin: 0;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: clamp(1.6rem, 3vw, 2.2rem);\n      line-height: 1.3;\n    }\n\n    .care-quote span { color: var(--lime); }\n\n    .visit-section { padding: 24px 0 96px; }\n\n    .visit-grid {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 58px;\n      align-items: start;\n    }\n\n    .visit-grid .section-heading { margin-bottom: 25px; }\n\n    .address-card {\n      padding: 25px;\n      border: 1px solid var(--line);\n      border-radius: var(--radius);\n      background: var(--paper);\n    }\n\n    .address-card + .address-card { margin-top: 14px; }\n\n    .address-card h3 {\n      margin-bottom: 10px;\n      font-size: .82rem;\n      letter-spacing: .1em;\n      text-transform: uppercase;\n    }\n\n    .address-card p {\n      margin-bottom: 0;\n      color: var(--ink-soft);\n    }\n\n    .address-card strong { color: var(--ink); }\n\n    .map-placeholder {\n      min-height: 320px;\n      position: relative;\n      display: grid;\n      place-items: center;\n      overflow: hidden;\n      border: 1px solid #d8ddd1;\n      border-radius: 24px;\n      background-color: #e9eee4;\n      background-image:\n        linear-gradient(28deg, transparent 47%, rgba(255,255,255,.78) 48%, rgba(255,255,255,.78) 53%, transparent 54%),\n        linear-gradient(115deg, transparent 44%, rgba(255,255,255,.8) 45%, rgba(255,255,255,.8) 50%, transparent 51%),\n        linear-gradient(74deg, transparent 60%, rgba(205,218,197,.8) 61%, rgba(205,218,197,.8) 66%, transparent 67%);\n      background-size: 210px 170px, 230px 190px, 270px 220px;\n    }\n\n    .map-pin {\n      width: 66px;\n      height: 66px;\n      display: grid;\n      place-items: center;\n      border: 7px solid white;\n      border-radius: 50% 50% 50% 8px;\n      background: var(--coral);\n      color: var(--ink);\n      box-shadow: 0 8px 18px rgba(25,60,56,.14);\n      transform: rotate(-45deg);\n    }\n\n    .map-pin svg {\n      width: 25px;\n      height: 25px;\n      transform: rotate(45deg);\n    }\n\n    .map-label {\n      position: absolute;\n      bottom: 20px;\n      left: 20px;\n      padding: 9px 13px;\n      border-radius: 999px;\n      background: white;\n      box-shadow: 0 5px 18px rgba(25,60,56,.08);\n      font-size: .81rem;\n      font-weight: 700;\n    }\n\n    footer {\n      padding: 32px 0;\n      background: var(--ink);\n      color: white;\n    }\n\n    .footer-inner {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 22px;\n    }\n\n    .footer-brand { color: white; }\n\n    footer p {\n      max-width: 530px;\n      margin: 0;\n      color: rgba(255,255,255,.7);\n      font-size: .8rem;\n      text-align: right;\n    }\n\n    @media (max-width: 850px) {\n      .hero-grid { gap: 30px; }\n      .how-grid { gap: 40px; }\n      .care-copy { padding: 40px; }\n      .care-aside { padding: 35px; }\n      .trust-inner { align-items: flex-start; flex-direction: column; }\n      .trust-items { justify-content: flex-start; }\n    }\n\n    @media (max-width: 680px) {\n      .wrap { width: min(100% - 36px, 520px); }\n      .topbar { padding-inline: 15px; font-size: .75rem; }\n      .nav { min-height: 70px; }\n      .nav-links { gap: 0; }\n      .nav-links a:not(.button) { display: none; }\n      .nav-links .button { min-height: 42px; padding-inline: 16px; font-size: .82rem; }\n      .hero { padding: 54px 0 56px; }\n      .hero-grid, .how-grid, .care-panel, .visit-grid { grid-template-columns: 1fr; }\n      .hero-grid { gap: 28px; }\n      h1 { font-size: clamp(3rem, 14vw, 4.4rem); }\n      .hero-copy { font-size: 1rem; }\n      .visual { min-height: 390px; }\n      .visual-blob { width: min(350px, 85%); }\n      .visit-card { padding: 24px; }\n      .mini-sticker { right: 0; bottom: 14px; width: 91px; height: 91px; font-size: .7rem; }\n      .trust-items { gap: 14px 21px; font-size: .82rem; }\n      .section { padding: 68px 0; }\n      .services-grid { grid-template-columns: 1fr 1fr; gap: 11px; }\n      .service-card { min-height: 190px; padding: 19px; }\n      .service-card h3 { font-size: 1rem; }\n      .service-card p { font-size: .85rem; }\n      .service-icon { margin-bottom: 16px; }\n      .how-grid { gap: 34px; }\n      .care-section { padding: 60px 0; }\n      .care-copy { padding: 34px 27px; }\n      .care-aside { min-height: 225px; padding: 32px 28px; }\n      .visit-section { padding: 0 0 68px; }\n      .visit-grid { gap: 28px; }\n      .map-placeholder { min-height: 250px; }\n      .footer-inner { align-items: flex-start; flex-direction: column; }\n      footer p { text-align: left; }\n    }\n\n    @media (max-width: 390px) {\n      .services-grid { grid-template-columns: 1fr; }\n      .service-card { min-height: auto; }\n      .hero-actions .button { width: 100%; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      *, *::before, *::after {\n        scroll-behavior: auto !important;\n        transition-duration: .01ms !important;\n      }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"topbar\">\n    Walk-ins welcome. No judgment, no lecture. <a href=\"#visit\">Plan your visit \u2192</a>\n  </div>\n\n  <header>\n    <div class=\"wrap nav\">\n      <a class=\"brand\" href=\"#\" aria-label=\"Open Door home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M6 19V5.5A2.5 2.5 0 0 1 8.5 3H18v18H8.5A2.5 2.5 0 0 1 6 18.5Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/>\n            <path d=\"M14 12h7m-3-3 3 3-3 3\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          </svg>\n        </span>\n        Open Door\n      </a>\n      <nav class=\"nav-links\" aria-label=\"Main navigation\">\n        <a href=\"#care\">Our approach</a>\n        <a href=\"#services\">Services</a>\n        <a href=\"#visit\">Visit us</a>\n        <a class=\"button\" href=\"#visit\">Walk in today <span aria-hidden=\"true\">\u2197</span></a>\n      </nav>\n    </div>\n  </header>\n\n  <main>\n    <section class=\"hero\">\n      <div class=\"wrap hero-grid\">\n        <div>\n          <p class=\"eyebrow\">Sexual health, on your terms</p>\n          <h1>Care that meets you <em>where you are.</em></h1>\n          <p class=\"hero-copy\">\n            Questions, testing, birth control, or just a conversation. Get welcoming sexual-health care from people who listen first.\n          </p>\n          <div class=\"hero-actions\">\n            <a class=\"button\" href=\"#visit\">\n              Find your way in\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n                <path d=\"M5 12h14m-6-6 6 6-6 6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n            </a>\n            <a class=\"button button-light\" href=\"#services\">Explore services</a>\n          </div>\n          <p class=\"quiet-note\">Walk in when it works for you. You don\u2019t need to have it all figured out.</p>\n        </div>\n\n        <div class=\"visual\" aria-label=\"Walk-in clinic information\">\n          <div class=\"visual-blob\" aria-hidden=\"true\"></div>\n          <div class=\"visit-card\">\n            <div class=\"card-kicker\"><span class=\"status-dot\" aria-hidden=\"true\"></span> Walk-ins welcome</div>\n            <h2>Come as you are.</h2>\n            <p>Friendly, practical care\u2014without an appointment.</p>\n\n            <div class=\"visit-detail\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n                <path d=\"M12 21s7-6.1 7-12a7 7 0 1 0-14 0c0 5.9 7 12 7 12Z\" stroke=\"currentColor\" stroke-width=\"1.8\"/>\n                <circle cx=\"12\" cy=\"9\" r=\"2.5\" stroke=\"currentColor\" stroke-width=\"1.8\"/>\n              </svg>\n              <div><strong>Easy to find</strong><span>See location and directions below</span></div>\n            </div>\n            <div class=\"visit-detail\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n                <circle cx=\"12\" cy=\"12\" r=\"9\" stroke=\"currentColor\" stroke-width=\"1.8\"/>\n                <path d=\"M12 7v5l3 2\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n              </svg>\n              <div><strong>Check before you come</strong><span>View current hours in the visit section</span></div>\n            </div>\n          </div>\n          <div class=\"mini-sticker\">Your body.<br>Your questions.<br>Your call.</div>\n        </div>\n      </div>\n    </section>\n\n    <div class=\"trust-strip\">\n      <div class=\"wrap trust-inner\">\n        <p class=\"trust-intro\">A softer place to start</p>\n        <div class=\"trust-items\">\n          <span>\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M12 21s8-4 8-10V5l-8-3-8 3v6c0 6 8 10 8 10Z\" stroke=\"currentColor\" stroke-width=\"1.8\"/><path d=\"m9 12 2 2 4-4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            Respectful care\n          </span>\n          <span>\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 12a8 8 0 1 0 2.3-5.6L4 8.5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/><path d=\"M4 4v4.5h4.5M12 8v4l3 2\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            No appointment needed\n          </span>\n          <span>\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M12 21s8-4 8-10V5l-8-3-8 3v6c0 6 8 10 8 10Z\" stroke=\"currentColor\" stroke-width=\"1.8\"/><path d=\"M9 12h6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg>\n            Your privacy matters\n          </span>\n        </div>\n      </div>\n    </div>\n\n    <section class=\"section\" id=\"services\">\n      <div class=\"wrap\">\n        <div class=\"section-heading\">\n          <p class=\"eyebrow\">Support for real life</p>\n          <h2>What can we help with?</h2>\n          <p>Come in with a question or a plan. We\u2019ll talk through your options together, at your pace.</p>\n        </div>\n\n        <div class=\"services-grid\">\n          <article class=\"service-card\">\n            <div class=\"service-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M4 6h16v13H4zM8 3v6m8-6v6M8 13h3m2 0h3m-8 3h3\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            </div>\n            <h3>STI testing & treatment</h3>\n            <p>Testing, answers, and support without the awkwardness.</p>\n          </article>\n\n          <article class=\"service-card\">\n            <div class=\"service-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 21s-8-4.4-8-11a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 20 10c0 6.6-8 11-8 11Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/><path d=\"M8 12h8m-4-4v8\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg>\n            </div>\n            <h3>Birth control</h3>\n            <p>Explore methods and find what fits your life and preferences.</p>\n          </article>\n\n          <article class=\"service-card\">\n            <div class=\"service-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 21s8-4 8-10V5l-8-3-8 3v6c0 6 8 10 8 10Z\" stroke=\"currentColor\" stroke-width=\"1.8\"/><path d=\"M9 12h6m-3-3v6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg>\n            </div>\n            <h3>PrEP & PEP</h3>\n            <p>Talk with a care team about HIV prevention options.</p>\n          </article>\n\n          <article class=\"service-card\">\n            <div class=\"service-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 21s-7-6.1-7-12a7 7 0 1 1 14 0c0 5.9-7 12-7 12Z\" stroke=\"currentColor\" stroke-width=\"1.8\"/><path d=\"M9 10h6m-3-3v6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg>\n            </div>\n            <h3>Pregnancy options</h3>\n            <p>Get information and compassionate support for your next step.</p>\n          </article>\n\n          <article class=\"service-card\">\n            <div class=\"service-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 3v18M3 12h18M5.6 5.6l12.8 12.8m0-12.8L5.6 18.4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg>\n            </div>\n            <h3>Gender-affirming care</h3>\n            <p>A respectful space for sexual-health questions and support.</p>\n          </article>\n\n          <article class=\"service-card\">\n            <div class=\"service-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 3a9 9 0 1 0 9 9h-9V3Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/><path d=\"M15 3.5A9 9 0 0 1 20.5 9H15V3.5Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/></svg>\n            </div>\n            <h3>Questions & check-ins</h3>\n            <p>Talk about pleasure, relationships, symptoms, or anything on your mind.</p>\n          </article>\n        </div>\n        <p class=\"service-footnote\">Services and availability can vary. Contact the clinic if you have questions about what\u2019s offered.</p>\n      </div>\n    </section>\n\n    <section class=\"section how-section\">\n      <div class=\"wrap how-grid\">\n        <div class=\"section-heading\">\n          <p class=\"eyebrow\">Simple by design</p>\n          <h2>Showing up is enough.</h2>\n          <p>No perfect words or paperwork prep required. We\u2019ll take it one step at a time.</p>\n        </div>\n\n        <div class=\"steps\">\n          <article class=\"step\">\n            <div class=\"step-number\">01</div>\n            <div>\n              <h3>Stop by</h3>\n              <p>Visit during walk-in hours. If you can, check today\u2019s hours before heading over.</p>\n            </div>\n          </article>\n          <article class=\"step\">\n            <div class=\"step-number\">02</div>\n            <div>\n              <h3>Tell us what you need</h3>\n              <p>Share as much or as little as you like. Your care team will listen and explain your options.</p>\n            </div>\n          </article>\n          <article class=\"step\">\n            <div class=\"step-number\">03</div>\n            <div>\n              <h3>Choose what feels right</h3>\n              <p>You\u2019re part of every decision. We\u2019ll talk through next steps together, without pressure.</p>\n            </div>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"care-section\" id=\"care\">\n      <div class=\"wrap care-panel\">\n        <div class=\"care-copy\">\n          <p class=\"eyebrow\">Care without assumptions</p>\n          <h2>You deserve to feel comfortable asking.</h2>\n          <p>We welcome people of all genders, orientations, backgrounds, and experiences. You\u2019ll be met with respect, clear information, and room to make your own choices.</p>\n          <a class=\"button\" href=\"#visit\">Come talk with us <span aria-hidden=\"true\">\u2197</span></a>\n        </div>\n        <div class=\"care-aside\">\n          <p class=\"care-quote\">\u201cYou don\u2019t have to know the right words. <span>We\u2019ll figure it out together.</span>\u201d</p>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"visit-section\" id=\"visit\">\n      <div class=\"wrap visit-grid\">\n        <div>\n          <div class=\"section-heading\">\n            <p class=\"eyebrow\">Your next step</p>\n            <h2>Come by when you\u2019re ready.</h2>\n            <p>We\u2019re here for walk-ins. Check the details below before you head over.</p>\n          </div>\n\n          <div class=\"address-card\">\n            <h3>Location</h3>\n            <p><strong>Open Door Sexual Health Clinic</strong><br>\n              1208 Pine Street, Suite 4<br>\n              Portland, OR 97205\n            </p>\n          </div>\n\n          <div class=\"address-card\">\n            <h3>Walk-in hours</h3>\n            <p><strong>Monday\u2013Friday:</strong> 9:00 am\u20136:00 pm<br>\n              <strong>Saturday:</strong> 10:00 am\u20132:00 pm<br>\n              Sunday: Closed\n            </p>\n          </div>\n\n          <div class=\"address-card\">\n            <h3>A note about privacy</h3>\n            <p>Your privacy matters. We\u2019ll explain how your information is handled, including any limits to confidentiality, before care.</p>\n          </div>\n        </div>\n\n        <div class=\"map-placeholder\" role=\"img\" aria-label=\"Illustrated map showing the clinic location\">\n          <div class=\"map-pin\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\">\n              <path d=\"M12 21s7-6.1 7-12a7 7 0 1 0-14 0c0 5.9 7 12 7 12Z\" stroke=\"currentColor\" stroke-width=\"1.8\"/>\n              <circle cx=\"12\" cy=\"9\" r=\"2.5\" stroke=\"currentColor\" stroke-width=\"1.8\"/>\n            </svg>\n          </div>\n          <span class=\"map-label\">Open Door \u00b7 Pine Street</span>\n        </div>\n      </div>\n    </section>\n  </main>\n\n  <footer>\n    <div class=\"wrap footer-inner\">\n      <a class=\"brand footer-brand\" href=\"#\" aria-label=\"Open Door home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M6 19V5.5A2.5 2.5 0 0 1 8.5 3H18v18H8.5A2.5 2.5 0 0 1 6 18.5Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/>\n            <path d=\"M14 12h7m-3-3 3 3-3 3\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          </svg>\n        </span>\n        Open Door\n      </a>\n      <p>For a medical emergency, call your local emergency number. Clinic services and hours may change; please confirm before visiting.</p>\n    </div>\n  </footer>\n</body>\n</html>\n"}