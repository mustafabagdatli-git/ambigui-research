{"brief": "B6", "model": "anthropic/claude-haiku-5.5", "i": 4, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Concrete Ollie | Skate Shop & Lessons</title>\n<meta name=\"description\" content=\"Skateboard shop and skate lessons for kids and adults. Decks, trucks, wheels, protection, and expert instruction.\">\n<style>\n  :root {\n    --asphalt: #111214;\n    --asphalt-2: #1a1c20;\n    --asphalt-3: #24272d;\n    --chalk: #f3f1ea;\n    --muted: #a7a9ae;\n    --acid: #d4ff3a;\n    --ember: #ff6b3d;\n    --line: rgba(255,255,255,0.09);\n    --radius: 14px;\n    --display: \"Arial Black\", \"Helvetica Neue\", Impact, sans-serif;\n    --body: system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n  }\n\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  html { scroll-behavior: smooth; }\n  body {\n    font-family: var(--body);\n    background: var(--asphalt);\n    color: var(--chalk);\n    line-height: 1.6;\n    -webkit-font-smoothing: antialiased;\n  }\n  img, svg { display: block; max-width: 100%; }\n  a { color: inherit; text-decoration: none; }\n  h1, h2, h3, h4 { font-family: var(--display); line-height: 1.05; letter-spacing: -0.01em; text-transform: uppercase; }\n  .wrap { width: min(1180px, 92%); margin: 0 auto; }\n  section { padding: 96px 0; position: relative; }\n  .eyebrow {\n    display: inline-block;\n    font-size: 0.75rem;\n    font-weight: 700;\n    letter-spacing: 0.22em;\n    text-transform: uppercase;\n    color: var(--acid);\n    margin-bottom: 14px;\n  }\n  .section-head { max-width: 640px; margin-bottom: 56px; }\n  .section-head h2 { font-size: clamp(2rem, 4.5vw, 3.2rem); margin-bottom: 14px; }\n  .section-head p { color: var(--muted); font-size: 1.05rem; }\n\n  .btn {\n    display: inline-flex; align-items: center; gap: 10px;\n    padding: 15px 26px;\n    border-radius: 999px;\n    font-weight: 700;\n    font-size: 0.95rem;\n    border: 2px solid transparent;\n    cursor: pointer;\n    transition: transform .15s ease, background .2s ease, color .2s ease, border-color .2s ease;\n    font-family: var(--body);\n  }\n  .btn:hover { transform: translateY(-2px); }\n  .btn-primary { background: var(--acid); color: var(--asphalt); }\n  .btn-primary:hover { background: #e5ff6e; }\n  .btn-ghost { border-color: var(--chalk); color: var(--chalk); background: transparent; }\n  .btn-ghost:hover { background: var(--chalk); color: var(--asphalt); }\n  .btn-dark { background: var(--asphalt); color: var(--chalk); }\n  .btn-dark:hover { background: #000; }\n\n  /* ---------- Header ---------- */\n  header {\n    position: sticky; top: 0; z-index: 50;\n    background: rgba(17,18,20,0.82);\n    backdrop-filter: blur(12px);\n    border-bottom: 1px solid var(--line);\n  }\n  .nav {\n    display: flex; align-items: center; justify-content: space-between;\n    height: 74px;\n  }\n  .logo {\n    font-family: var(--display);\n    font-size: 1.15rem;\n    text-transform: uppercase;\n    letter-spacing: -0.02em;\n    display: flex; align-items: center; gap: 10px;\n  }\n  .logo-mark {\n    width: 30px; height: 30px; border-radius: 8px;\n    background: var(--acid);\n    display: grid; place-items: center;\n    color: var(--asphalt);\n    font-size: 0.9rem;\n  }\n  .nav-links { display: flex; gap: 32px; list-style: none; }\n  .nav-links a { font-size: 0.92rem; font-weight: 600; color: var(--muted); transition: color .2s; }\n  .nav-links a:hover { color: var(--chalk); }\n  .nav-cta { display: flex; gap: 12px; align-items: center; }\n  .nav-cta .btn { padding: 10px 18px; font-size: 0.85rem; }\n  .menu-toggle {\n    display: none; background: none; border: 0; color: var(--chalk);\n    font-size: 1.6rem; cursor: pointer;\n  }\n\n  /* ---------- Hero ---------- */\n  .hero {\n    padding: 80px 0 96px;\n    background:\n      radial-gradient(circle at 80% 20%, rgba(212,255,58,0.14), transparent 40%),\n      radial-gradient(circle at 10% 90%, rgba(255,107,61,0.12), transparent 40%),\n      linear-gradient(180deg, var(--asphalt), var(--asphalt-2));\n    overflow: hidden;\n  }\n  .hero::before {\n    content: \"\"; position: absolute; inset: 0;\n    background-image:\n      linear-gradient(var(--line) 1px, transparent 1px),\n      linear-gradient(90deg, var(--line) 1px, transparent 1px);\n    background-size: 56px 56px;\n    mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);\n    -webkit-mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);\n    opacity: .6;\n    pointer-events: none;\n  }\n  .hero-grid {\n    position: relative;\n    display: grid;\n    grid-template-columns: 1.1fr 0.9fr;\n    gap: 40px;\n    align-items: center;\n  }\n  .hero h1 {\n    font-size: clamp(3rem, 8vw, 6.2rem);\n    margin-bottom: 24px;\n  }\n  .hero h1 span { color: var(--acid); }\n  .hero p.lede {\n    font-size: 1.15rem;\n    color: var(--muted);\n    max-width: 520px;\n    margin-bottom: 36px;\n  }\n  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }\n  .hero-stats {\n    display: flex; gap: 40px; margin-top: 56px; flex-wrap: wrap;\n    padding-top: 28px; border-top: 1px solid var(--line);\n  }\n  .hero-stats strong {\n    display: block; font-family: var(--display); font-size: 1.8rem; color: var(--chalk);\n  }\n  .hero-stats span { font-size: 0.85rem; color: var(--muted); }\n\n  .deck-stage {\n    position: relative;\n    aspect-ratio: 1 / 1;\n    display: grid; place-items: center;\n  }\n  .deck-stage::before {\n    content: \"\"; position: absolute;\n    width: 80%; aspect-ratio: 1;\n    border-radius: 50%;\n    background: radial-gradient(circle, rgba(212,255,58,0.25), transparent 65%);\n    filter: blur(10px);\n  }\n  .deck {\n    width: 78%;\n    transform: rotate(-16deg);\n    animation: float 6s ease-in-out infinite;\n    filter: drop-shadow(0 30px 40px rgba(0,0,0,0.6));\n  }\n  @keyframes float {\n    0%,100% { transform: rotate(-16deg) translateY(0); }\n    50% { transform: rotate(-12deg) translateY(-14px); }\n  }\n  .badge {\n    position: absolute;\n    background: var(--chalk);\n    color: var(--asphalt);\n    font-family: var(--display);\n    font-size: 0.78rem;\n    text-transform: uppercase;\n    padding: 12px 16px;\n    border-radius: 10px;\n    box-shadow: 0 12px 30px rgba(0,0,0,0.4);\n    transform: rotate(-4deg);\n  }\n  .badge.b1 { top: 8%; right: 0; }\n  .badge.b2 { bottom: 10%; left: 0; background: var(--ember); color: var(--chalk); transform: rotate(3deg); }\n\n  /* ---------- Marquee ---------- */\n  .marquee {\n    background: var(--acid);\n    color: var(--asphalt);\n    overflow: hidden;\n    white-space: nowrap;\n    padding: 18px 0;\n    border-block: 2px solid var(--asphalt);\n  }\n  .marquee-track {\n    display: inline-flex;\n    gap: 40px;\n    animation: scroll 28s linear infinite;\n    font-family: var(--display);\n    font-size: 1.4rem;\n    text-transform: uppercase;\n  }\n  .marquee-track span::after { content: \"\u2736\"; margin-left: 40px; }\n  @keyframes scroll { to { transform: translateX(-50%); } }\n\n  /* ---------- Shop ---------- */\n  .shop { background: var(--asphalt-2); }\n  .cat-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 20px;\n  }\n  .cat {\n    position: relative;\n    background: var(--asphalt-3);\n    border: 1px solid var(--line);\n    border-radius: var(--radius);\n    padding: 32px;\n    min-height: 220px;\n    display: flex; flex-direction: column; justify-content: space-between;\n    overflow: hidden;\n    transition: border-color .25s, transform .25s;\n  }\n  .cat:hover { border-color: var(--acid); transform: translateY(-4px); }\n  .cat .icon {\n    width: 56px; height: 56px; border-radius: 12px;\n    background: var(--asphalt);\n    display: grid; place-items: center;\n    color: var(--acid);\n    margin-bottom: 20px;\n  }\n  .cat h3 { font-size: 1.35rem; margin-bottom: 8px; }\n  .cat p { color: var(--muted); font-size: 0.95rem; }\n  .cat .arrow {\n    margin-top: 20px; font-weight: 700; font-size: 0.9rem; color: var(--acid);\n  }\n  .cat .num {\n    position: absolute; top: 18px; right: 22px;\n    font-family: var(--display); font-size: 3.5rem; color: rgba(255,255,255,0.04);\n  }\n\n  .feature-row {\n    margin-top: 28px;\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 16px;\n  }\n  .feature {\n    padding: 20px;\n    border-radius: 12px;\n    background: var(--asphalt);\n    border: 1px solid var(--line);\n    font-size: 0.9rem;\n    color: var(--muted);\n  }\n  .feature strong { display: block; color: var(--chalk); font-size: 1rem; margin-bottom: 4px; }\n\n  /* ---------- Lessons ---------- */\n  .lessons { background: var(--asphalt); }\n  .tabs {\n    display: inline-flex; gap: 6px; padding: 6px;\n    background: var(--asphalt-2);\n    border: 1px solid var(--line);\n    border-radius: 999px;\n    margin-bottom: 36px;\n    flex-wrap: wrap;\n  }\n  .tab {\n    background: none; border: 0; color: var(--muted);\n    padding: 10px 20px; border-radius: 999px;\n    font-weight: 700; font-size: 0.9rem; cursor: pointer;\n    font-family: var(--body);\n    transition: background .2s, color .2s;\n  }\n  .tab[aria-selected=\"true\"] { background: var(--acid); color: var(--asphalt); }\n  .tab:not([aria-selected=\"true\"]):hover { color: var(--chalk); }\n\n  .lesson-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 20px;\n  }\n  .lesson {\n    background: var(--asphalt-2);\n    border: 1px solid var(--line);\n    border-radius: var(--radius);\n    padding: 36px 30px;\n    display: flex; flex-direction: column;\n    position: relative;\n  }\n  .lesson.featured {\n    border-color: var(--acid);\n    background: linear-gradient(180deg, #20241a, var(--asphalt-2));\n  }\n  .lesson .tag {\n    position: absolute; top: -12px; left: 30px;\n    background: var(--acid); color: var(--asphalt);\n    font-size: 0.7rem; font-weight: 800; letter-spacing: .14em;\n    text-transform: uppercase; padding: 6px 12px; border-radius: 999px;\n  }\n  .lesson h3 { font-size: 1.5rem; margin-bottom: 6px; }\n  .lesson .meta { color: var(--muted); font-size: 0.9rem; margin-bottom: 22px; }\n  .price {\n    font-family: var(--display); font-size: 2.6rem; margin-bottom: 4px;\n  }\n  .price small { font-family: var(--body); font-size: 0.9rem; color: var(--muted); font-weight: 500; }\n  .lesson ul { list-style: none; margin: 22px 0 30px; display: grid; gap: 11px; }\n  .lesson li { position: relative; padding-left: 26px; font-size: 0.95rem; color: var(--muted); }\n  .lesson li::before {\n    content: \"\"; position: absolute; left: 0; top: 7px;\n    width: 12px; height: 12px; border-radius: 3px;\n    background: var(--acid);\n    transform: rotate(45deg) scale(.55);\n  }\n  .lesson .btn { margin-top: auto; justify-content: center; }\n\n  .lesson-hidden { display: none; }\n\n  .schedule {\n    margin-top: 80px;\n    background: var(--asphalt-2);\n    border: 1px solid var(--line);\n    border-radius: var(--radius);\n    overflow: hidden;\n  }\n  .schedule-head {\n    padding: 26px 32px;\n    border-bottom: 1px solid var(--line);\n    display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;\n  }\n  .schedule-head h3 { font-size: 1.3rem; }\n  .schedule-head span { color: var(--muted); font-size: .9rem; }\n  table { width: 100%; border-collapse: collapse; }\n  th, td { padding: 18px 32px; text-align: left; border-bottom: 1px solid var(--line); font-size: .95rem; }\n  th { font-size: .75rem; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); font-weight: 700; }\n  td.class-name { font-weight: 700; color: var(--chalk); }\n  tr:last-child td { border-bottom: 0; }\n  .pill {\n    display: inline-block; padding: 4px 10px; border-radius: 999px;\n    font-size: .75rem; font-weight: 700;\n    background: rgba(212,255,58,0.12); color: var(--acid);\n  }\n  .pill.full { background: rgba(255,107,61,0.15); color: var(--ember); }\n\n  /* ---------- Instructors ---------- */\n  .crew { background: var(--asphalt-2); }\n  .crew-grid {\n    display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px;\n  }\n  .crew-card {\n    background: var(--asphalt-3);\n    border-radius: var(--radius);\n    overflow: hidden;\n    border: 1px solid var(--line);\n  }\n  .crew-art {\n    aspect-ratio: 4/5;\n    display: grid; place-items: center;\n    position: relative;\n    font-family: var(--display);\n    font-size: 4rem;\n    color: rgba(17,18,20,0.85);\n  }\n  .crew-art::after {\n    content: \"\"; position: absolute; inset: 0;\n    background-image: radial-gradient(rgba(0,0,0,.18) 1px, transparent 1px);\n    background-size: 10px 10px;\n  }\n  .crew-art span { position: relative; z-index: 1; }\n  .crew-info { padding: 22px; }\n  .crew-info h4 { font-size: 1.1rem; margin-bottom: 4px; }\n  .crew-info .role { color: var(--acid); font-size: .85rem; font-weight: 600; margin-bottom: 10px; }\n  .crew-info p { color: var(--muted); font-size: .9rem; }\n\n  /* ---------- Testimonials ---------- */\n  .voices { background: var(--asphalt); }\n  .quote-grid {\n    display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;\n  }\n  .quote {\n    padding: 32px;\n    border-radius: var(--radius);\n    background: var(--asphalt-2);\n    border: 1px solid var(--line);\n  }\n  .quote .stars { color: var(--acid); letter-spacing: 3px; margin-bottom: 16px; font-size: .9rem; }\n  .quote p { font-size: 1.02rem; margin-bottom: 22px; }\n  .quote .who { display: flex; align-items: center; gap: 12px; font-size: .9rem; color: var(--muted); }\n  .quote .avatar {\n    width: 40px; height: 40px; border-radius: 50%;\n    background: var(--ember); color: var(--asphalt);\n    display: grid; place-items: center; font-weight: 800; font-size: .85rem;\n  }\n  .quote .who strong { color: var(--chalk); display: block; }\n\n  /* ---------- Visit ---------- */\n  .visit { background: var(--asphalt-2); }\n  .visit-grid {\n    display: grid; grid-template-columns: 1fr 1.1fr; gap: 40px; align-items: stretch;\n  }\n  .visit-info {\n    display: flex; flex-direction: column; gap: 24px;\n  }\n  .info-block h4 { font-size: 1rem; color: var(--acid); margin-bottom: 8px; letter-spacing: .05em; }\n  .info-block p, .info-block li { color: var(--muted); font-size: .98rem; }\n  .hours { list-style: none; display: grid; gap: 6px; }\n  .hours li { display: flex; justify-content: space-between; border-bottom: 1px dashed var(--line); padding-bottom: 6px; }\n  .hours li b { color: var(--chalk); font-weight: 600; }\n  .map {\n    position: relative;\n    border-radius: var(--radius);\n    overflow: hidden;\n    min-height: 380px;\n    background:\n      linear-gradient(135deg, #2a2d33 25%, transparent 25%) -20px 0/40px 40px,\n      linear-gradient(225deg, #2a2d33 25%, transparent 25%) -20px 0/40px 40px,\n      #1d1f24;\n    border: 1px solid var(--line);\n  }\n  .map svg { position: absolute; inset: 0; width: 100%; height: 100%; }\n  .map-pin {\n    position: absolute; top: 46%; left: 52%;\n    transform: translate(-50%, -100%);\n    background: var(--acid); color: var(--asphalt);\n    padding: 10px 14px; border-radius: 10px;\n    font-weight: 800; font-size: .85rem;\n    box-shadow: 0 10px 30px rgba(0,0,0,.5);\n    white-space: nowrap;\n  }\n  .map-pin::after {\n    content: \"\"; position: absolute; bottom: -7px; left: 50%;\n    transform: translateX(-50%) rotate(45deg);\n    width: 14px; height: 14px; background: var(--acid);\n  }\n\n  /* ---------- Newsletter / CTA ---------- */\n  .cta {\n    background: var(--acid);\n    color: var(--asphalt);\n    padding: 80px 0;\n    position: relative; overflow: hidden;\n  }\n  .cta::before {\n    content: \"OLLIE\"; position: absolute; right: -40px; top: -40px;\n    font-family: var(--display); font-size: 16rem; line-height: 1;\n    color: rgba(0,0,0,0.06); pointer-events: none;\n  }\n  .cta-grid {\n    position: relative;\n    display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; align-items: center;\n  }\n  .cta h2 { font-size: clamp(2.2rem, 5vw, 3.6rem); margin-bottom: 14px; }\n  .cta p { font-size: 1.05rem; max-width: 520px; }\n  .signup {\n    background: var(--asphalt);\n    color: var(--chalk);\n    padding: 32px;\n    border-radius: var(--radius);\n  }\n  .signup label { display: block; font-weight: 700; font-size: .9rem; margin-bottom: 10px; }\n  .signup-row { display: flex; gap: 10px; flex-wrap: wrap; }\n  .signup input, .signup select {\n    flex: 1; min-width: 180px;\n    padding: 14px 16px;\n    border-radius: 10px;\n    border: 1px solid var(--line);\n    background: var(--asphalt-3);\n    color: var(--chalk);\n    font: inherit;\n  }\n  .signup input:focus, .signup select:focus { outline: 2px solid var(--acid); outline-offset: 1px; }\n  .signup small { display: block; margin-top: 12px; color: var(--muted); font-size: .8rem; }\n  .form-msg { margin-top: 12px; color: var(--acid); font-weight: 600; font-size: .9rem; min-height: 1.2em; }\n\n  /* ---------- Footer ---------- */\n  footer { background: #0a0b0c; padding: 72px 0 32px; border-top: 1px solid var(--line); }\n  .foot-grid {\n    display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 40px;\n    margin-bottom: 56px;\n  }\n  .foot-grid p { color: var(--muted); font-size: .92rem; max-width: 300px; margin-top: 14px; }\n  .foot-grid h5 {\n    font-family: var(--body); font-size: .75rem; letter-spacing: .16em;\n    text-transform: uppercase; color: var(--chalk); margin-bottom: 18px;\n  }\n  .foot-grid ul { list-style: none; display: grid; gap: 10px; }\n  .foot-grid ul a { color: var(--muted); font-size: .92rem; transition: color .2s; }\n  .foot-grid ul a:hover { color: var(--acid); }\n  .foot-bottom {\n    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 14px;\n    padding-top: 28px; border-top: 1px solid var(--line);\n    color: var(--muted); font-size: .85rem;\n  }\n  .socials { display: flex; gap: 10px; }\n  .socials a {\n    width: 38px; height: 38px; border-radius: 10px;\n    border: 1px solid var(--line);\n    display: grid; place-items: center;\n    font-weight: 700; font-size: .8rem; color: var(--muted);\n    transition: border-color .2s, color .2s;\n  }\n  .socials a:hover { border-color: var(--acid); color: var(--acid); }\n\n  /* ---------- Responsive ---------- */\n  @media (max-width: 1000px) {\n    .hero-grid, .visit-grid, .cta-grid { grid-template-columns: 1fr; }\n    .deck-stage { max-width: 460px; margin: 0 auto; width: 100%; }\n    .cat-grid, .lesson-grid, .quote-grid { grid-template-columns: repeat(2, 1fr); }\n    .crew-grid { grid-template-columns: repeat(2, 1fr); }\n    .feature-row { grid-template-columns: repeat(2, 1fr); }\n    .foot-grid { grid-template-columns: 1fr 1fr; }\n  }\n  @media (max-width: 760px) {\n    section { padding: 72px 0; }\n    .nav-links, .nav-cta .btn-ghost { display: none; }\n    .menu-toggle { display: block; }\n    .nav-links.open {\n      display: flex; flex-direction: column; gap: 0;\n      position: absolute; top: 74px; left: 0; right: 0;\n      background: var(--asphalt); border-bottom: 1px solid var(--line);\n    }\n    .nav-links.open li a { display: block; padding: 16px 4%; font-size: 1rem; color: var(--chalk); border-bottom: 1px solid var(--line); }\n    .cat-grid, .lesson-grid, .quote-grid, .crew-grid, .feature-row { grid-template-columns: 1fr; }\n    .badge { display: none; }\n    th, td { padding: 14px 16px; font-size: .88rem; }\n    .schedule-head { padding: 22px 16px; }\n    .foot-grid { grid-template-columns: 1fr; }\n    .hero-stats { gap: 24px; }\n    .map-pin { font-size: .75rem; }\n  }\n</style>\n</head>\n<body>\n\n<!-- ============ HEADER ============ -->\n<header>\n  <div class=\"wrap nav\">\n    <a href=\"#top\" class=\"logo\">\n      <span class=\"logo-mark\">CO</span>\n      Concrete Ollie\n    </a>\n    <ul class=\"nav-links\" id=\"navLinks\">\n      <li><a href=\"#shop\">Shop</a></li>\n      <li><a href=\"#lessons\">Lessons</a></li>\n      <li><a href=\"#crew\">Instructors</a></li>\n      <li><a href=\"#visit\">Visit</a></li>\n      <li><a href=\"#visit\">Hours</a></li>\n    </ul>\n    <div class=\"nav-cta\">\n      <a href=\"#shop\" class=\"btn btn-ghost\">Shop</a>\n      <a href=\"#lessons\" class=\"btn btn-primary\">Book a lesson</a>\n      <button class=\"menu-toggle\" id=\"menuToggle\" aria-label=\"Toggle menu\" aria-expanded=\"false\">\u2630</button>\n    </div>\n  </div>\n</header>\n\n<main id=\"top\">\n\n<!-- ============ HERO ============ -->\n<section class=\"hero\">\n  <div class=\"wrap hero-grid\">\n    <div>\n      <span class=\"eyebrow\">Skate shop &amp; school \u00b7 Est. 2011</span>\n      <h1>Learn to roll. <span>Ride</span> it right.</h1>\n      <p class=\"lede\">Premium decks, trucks, wheels and protection from skaters who ride every day, plus lessons for first-timers, kids, and anyone ready to finally land the kickflip.</p>\n      <div class=\"hero-actions\">\n        <a href=\"#lessons\" class=\"btn btn-primary\">Book a lesson \u2192</a>\n        <a href=\"#shop\" class=\"btn btn-ghost\">Shop the store</a>\n      </div>\n      <div class=\"hero-stats\">\n        <div><strong>4,000+</strong><span>Students taught</span></div>\n        <div><strong>12</strong><span>Certified coaches</span></div>\n        <div><strong>300+</strong><span>Parts in stock</span></div>\n      </div>\n    </div>\n\n    <div class=\"deck-stage\" aria-hidden=\"true\">\n      <svg class=\"deck\" viewBox=\"0 0 300 900\" xmlns=\"http://www.w3.org/2000/svg\">\n        <defs>\n          <linearGradient id=\"deckGrad\" x1=\"0\" x2=\"1\" y1=\"0\" y2=\"0\">\n            <stop offset=\"0\" stop-color=\"#d4ff3a\"/>\n            <stop offset=\"0.5\" stop-color=\"#b8e62c\"/>\n            <stop offset=\"1\" stop-color=\"#8fb81d\"/>\n          </linearGradient>\n        </defs>\n        <!-- deck body (rounded, kicktail-ish) -->\n        <path d=\"M150 10 C 245 10, 262 90, 262 200 L 262 700 C 262 810, 245 890, 150 890 C 55 890, 38 810, 38 700 L 38 200 C 38 90, 55 10, 150 10 Z\"\n              fill=\"url(#deckGrad)\" stroke=\"#111214\" stroke-width=\"6\"/>\n        <!-- grip tape texture -->\n        <path d=\"M150 30 C 232 30, 244 100, 244 200 L 244 700 C 244 790, 232 870, 150 870 C 68 870, 56 790, 56 700 L 56 200 C 56 100, 68 30, 150 30 Z\"\n              fill=\"none\" stroke=\"rgba(0,0,0,0.12)\" stroke-width=\"2\" stroke-dasharray=\"4 6\"/>\n        <!-- graphic -->\n        <circle cx=\"150\" cy=\"450\" r=\"92\" fill=\"#111214\"/>\n        <circle cx=\"150\" cy=\"450\" r=\"70\" fill=\"none\" stroke=\"#d4ff3a\" stroke-width=\"4\"/>\n        <text x=\"150\" y=\"468\" text-anchor=\"middle\" font-family=\"Arial Black, Impact, sans-serif\" font-size=\"38\" fill=\"#d4ff3a\">CO</text>\n        <!-- trucks -->\n        <rect x=\"95\" y=\"160\" width=\"110\" height=\"10\" rx=\"4\" fill=\"#111214\"/>\n        <rect x=\"95\" y=\"730\" width=\"110\" height=\"10\" rx=\"4\" fill=\"#111214\"/>\n        <!-- bolts -->\n        <g fill=\"#111214\">\n          <circle cx=\"110\" cy=\"165\" r=\"4\"/><circle cx=\"190\" cy=\"165\" r=\"4\"/>\n          <circle cx=\"110\" cy=\"735\" r=\"4\"/><circle cx=\"190\" cy=\"735\" r=\"4\"/>\n        </g>\n      </svg>\n      <div class=\"badge b1\">Fresh drop<br>Spring '25 decks</div>\n      <div class=\"badge b2\">Beginner pack<br>from $149</div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ MARQUEE ============ -->\n<div class=\"marquee\" aria-hidden=\"true\">\n  <div class=\"marquee-track\">\n    <span>Decks</span><span>Trucks</span><span>Wheels</span><span>Bearings</span><span>Protection</span><span>Lessons</span><span>Kids Camps</span><span>Private Coaching</span>\n    <span>Decks</span><span>Trucks</span><span>Wheels</span><span>Bearings</span><span>Protection</span><span>Lessons</span><span>Kids Camps</span><span>Private Coaching</span>\n  </div>\n</div>\n\n<!-- ============ SHOP ============ -->\n<section class=\"shop\" id=\"shop\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <span class=\"eyebrow\">The Shop</span>\n      <h2>Built for the street. Tested at the park.</h2>\n      <p>Every board in our shop is assembled and tuned in-store. Not sure what fits? Ask a rider on the floor, we'll set you up.</p>\n    </div>\n\n    <div class=\"cat-grid\">\n      <a href=\"#\" class=\"cat\">\n        <span class=\"num\">01</span>\n        <div>\n          <div class=\"icon\">\n            <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"3\"/><path d=\"M7 9h10M7 13h6\"/></svg>\n          </div>\n          <h3>Complete Boards</h3>\n          <p>Pre-built setups from 7.75\" street to cruiser decks, ready to ride out of the box.</p>\n        </div>\n        <div class=\"arrow\">Shop decks \u2192</div>\n      </a>\n      <a href=\"#\" class=\"cat\">\n        <span class=\"num\">02</span>\n        <div>\n          <div class=\"icon\">\n            <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"8\"/><circle cx=\"12\" cy=\"12\" r=\"2.5\"/></svg>\n          </div>\n          <h3>Wheels &amp; Bearings</h3>\n          <p>Urethane formulas for speed, grip and slide, plus ABEC-rated bearings that roll smooth.</p>\n        </div>\n        <div class=\"arrow\">Shop wheels \u2192</div>\n      </a>\n      <a href=\"#\" class=\"cat\">\n        <span class=\"num\">03</span>\n        <div>\n          <div class=\"icon\">\n            <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 16h16M7 16V9h10v7M9 9V5h6v4\"/></svg>\n          </div>\n          <h3>Trucks &amp; Hardware</h3>\n          <p>Low, mid and high trucks, bushings, riser pads and bolts. Built to last through hard landings.</p>\n        </div>\n        <div class=\"arrow\">Shop trucks \u2192</div>\n      </a>\n      <a href=\"#\" class=\"cat\">\n        <span class=\"num\">04</span>\n        <div>\n          <div class=\"icon\">\n            <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 4h14v6a7 7 0 0 1-14 0z\"/><path d=\"M9 20h6\"/></svg>\n          </div>\n          <h3>Footwear</h3>\n          <p>Flat-soled skate shoes with reinforced ollie patches and grippy vulcanized rubber.</p>\n        </div>\n        <div class=\"arrow\">Shop shoes \u2192</div>\n      </a>\n      <a href=\"#\" class=\"cat\">\n        <span class=\"num\">05</span>\n        <div>\n          <div class=\"icon\">\n            <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z\"/></svg>\n          </div>\n          <h3>Protection</h3>\n          <p>Helmets, wrist guards, knee and elbow pads. Certified gear for beginners and bombers alike.</p>\n        </div>\n        <div class=\"arrow\">Shop protection \u2192</div>\n      </a>\n      <a href=\"#\" class=\"cat\">\n        <span class=\"num\">06</span>\n        <div>\n          <div class=\"icon\">\n            <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M6 4l6 4 6-4 2 4-3 3v9H7v-9L4 8z\"/></svg>\n          </div>\n          <h3>Apparel &amp; Merch</h3>\n          <p>Tees, hoodies, caps and local-artist collabs. Limited runs, restocked when they sell out.</p>\n        </div>\n        <div class=\"arrow\">Shop apparel \u2192</div>\n      </a>\n    </div>\n\n    <div class=\"feature-row\">\n      <div class=\"feature\"><strong>Free board setup</strong>Every complete is tuned and checked before it leaves the shop.</div>\n      <div class=\"feature\"><strong>Swap &amp; return</strong>Wrong size? Swap within 30 days, no questions asked.</div>\n      <div class=\"feature\"><strong>Lesson credit</strong>Spend $50+ on gear and get a discount on your first class.</div>\n      <div class=\"feature\"><strong>Local pickup</strong>Order online, grab it at the shop in under an hour.</div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ LESSONS ============ -->\n<section class=\"lessons\" id=\"lessons\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <span class=\"eyebrow\">Skate School</span>\n      <h2>Stop watching. Start rolling.</h2>\n      <p>Certified coaches, small groups, and a safe ramp-and-flat setup. All sessions include protective gear rental and a fresh-waxed loaner board if you need one.</p>\n    </div>\n\n    <div class=\"tabs\" role=\"tablist\" aria-label=\"Lesson type\">\n      <button class=\"tab\" role=\"tab\" aria-selected=\"true\" data-filter=\"all\">All lessons</button>\n      <button class=\"tab\" role=\"tab\" aria-selected=\"false\" data-filter=\"kids\">Kids</button>\n      <button class=\"tab\" role=\"tab\" aria-selected=\"false\" data-filter=\"adults\">Adults</button>\n      <button class=\"tab\" role=\"tab\" aria-selected=\"false\" data-filter=\"private\">Private</button>\n    </div>\n\n    <div class=\"lesson-grid\">\n      <article class=\"lesson\" data-type=\"kids\">\n        <h3>Little Rollers</h3>\n        <p class=\"meta\">Ages 5\u201310 \u00b7 Small groups of 6</p>\n        <div class=\"price\">$120 <small>/ 4 weeks</small></div>\n        <ul>\n          <li>Balance, stance and push fundamentals</li>\n          <li>Turning, stopping and falling safely</li>\n          <li>Helmet &amp; pads included</li>\n          <li>Parent pickup &amp; progress card</li>\n        </ul>\n        <a href=\"#book\" class=\"btn btn-ghost\">Book Little Rollers</a>\n      </article>\n\n      <article class=\"lesson featured\" data-type=\"adults\">\n        <span class=\"tag\">Most popular</span>\n        <h3>Adult Beginner</h3>\n        <p class=\"meta\">Ages 16+ \u00b7 Small groups of 5</p>\n        <div class=\"price\">$160 <small>/ 4 weeks</small></div>\n        <ul>\n          <li>Foundation skills in 90-minute sessions</li>\n          <li>Drop-in, push, turn and first ollie</li>\n          <li>Board rental and gear included</li>\n          <li>Graduate to our Sunday session crew</li>\n        </ul>\n        <a href=\"#book\" class=\"btn btn-primary\">Book Adult Beginner</a>\n      </article>\n\n      <article class=\"lesson\" data-type=\"private\">\n        <h3>1:1 Private Coaching</h3>\n        <p class=\"meta\">Any age \u00b7 Your schedule</p>\n        <div class=\"price\">$75 <small>/ hour</small></div>\n        <ul>\n          <li>Custom plan for your goals</li>\n          <li>Trick-specific breakdowns</li>\n          <li>Filmed session review on request</li>\n          <li>Pack of 5 hours saves 15%</li>\n        </ul>\n        <a href=\"#book\" class=\"btn btn-ghost\">Book a private session</a>\n      </article>\n    </div>\n\n    <div class=\"schedule\">\n      <div class=\"schedule-head\">\n        <h3>This week's schedule</h3>\n        <span>Walk-ins welcome if space allows. Booking recommended.</span>\n      </div>\n      <div style=\"overflow-x:auto;\">\n        <table>\n          <thead>\n            <tr><th>Day</th><th>Class</th><th>Time</th><th>Coach</th><th>Status</th></tr>\n          </thead>\n          <tbody>\n            <tr><td>Mon</td><td class=\"class-name\">Little Rollers</td><td>4:00 PM</td><td>Maya R.</td><td><span class=\"pill\">3 spots</span></td></tr>\n            <tr><td>Tue</td><td class=\"class-name\">Adult Beginner</td><td>7:00 PM</td><td>Jordan K.</td><td><span class=\"pill\">2 spots</span></td></tr>\n            <tr><td>Wed</td><td class=\"class-name\">Little Rollers</td><td>4:00 PM</td><td>Maya R.</td><td><span class=\"pill full\">Full</span></td></tr>\n            <tr><td>Thu</td><td class=\"class-name\">Adult Beginner</td><td>7:00 PM</td><td>Jordan K.</td><td><span class=\"pill\">4 spots</span></td></tr>\n            <tr><td>Sat</td><td class=\"class-name\">Saturday Crew (all levels)</td><td>10:00 AM</td><td>Devon T. &amp; Lea S.</td><td><span class=\"pill\">Open</span></td></tr>\n            <tr><td>Sun</td><td class=\"class-name\">Private Coaching</td><td>By appointment</td><td>Any coach</td><td><span class=\"pill\">Book</span></td></tr>\n          </tbody>\n        </table>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ INSTRUCTORS ============ -->\n<section class=\"crew\" id=\"crew\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <span class=\"eyebrow\">The Crew</span>\n      <h2>Coached by people who still skate.</h2>\n      <p>Our instructors are certified in first aid and CPR, and every one of them is still out there filming clips, competing, or building ramps.</p>\n    </div>\n\n    <div class=\"crew-grid\">\n      <div class=\"crew-card\">\n        <div class=\"crew-art\" style=\"background: linear-gradient(160deg, #d4ff3a, #8fb81d);\"><span>MR</span></div>\n        <div class=\"crew-info\">\n          <h4>Maya Rivera</h4>\n          <div class=\"role\">Head Coach, Kids</div>\n          <p>Former regional competitor. Runs our Little Rollers program and has taught over 800 kids to drop in.</p>\n        </div>\n      </div>\n      <div class=\"crew-card\">\n        <div class=\"crew-art\" style=\"background: linear-gradient(160deg, #ff6b3d, #c9461e);\"><span>JK</span></div>\n        <div class=\"crew-info\">\n          <h4>Jordan Kim</h4>\n          <div class=\"role\">Lead Coach, Adults</div>\n          <p>Ten years of street skating. Specializes in turning nervous beginners into confident cruisers.</p>\n        </div>\n      </div>\n      <div class=\"crew-card\">\n        <div class=\"crew-art\" style=\"background: linear-gradient(160deg, #e8e4d6, #aaa48f);\"><span>DT</span></div>\n        <div class=\"crew-info\">\n          <h4>Devon Thorne</h4>\n          <div class=\"role\">Private Coach</div>\n          <p>Trick progression specialist. Breaks down flip tricks into bite-size steps that actually stick.</p>\n        </div>\n      </div>\n      <div class=\"crew-card\">\n        <div class=\"crew-art\" style=\"background: linear-gradient(160deg, #6fd3ff, #2a7ea6);\"><span>LS</span></div>\n        <div class=\"crew-info\">\n          <h4>Lea Sato</h4>\n          <div class=\"role\">Coach &amp; Film Lead</div>\n          <p>Runs our session filming. Every private student gets a breakdown video and a clear next step.</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ TESTIMONIALS ============ -->\n<section class=\"voices\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <span class=\"eyebrow\">Word on the street</span>\n      <h2>From first push to first kickflip.</h2>\n    </div>\n    <div class=\"quote-grid\">\n      <figure class=\"quote\">\n        <div class=\"stars\">\u2605\u2605\u2605\u2605\u2605</div>\n        <p>\"My son was scared of his board for a month. After one Little Rollers session he was asking when the next class was. Total game changer.\"</p>\n        <figcaption class=\"who\"><span class=\"avatar\">AM</span><span><strong>Amara M.</strong>Parent of a 7-year-old</span></figcaption>\n      </figure>\n      <figure class=\"quote\">\n        <div class=\"stars\">\u2605\u2605\u2605\u2605\u2605</div>\n        <p>\"I signed up at 34 thinking I was too old. Jordan made it feel totally normal. Now I'm rolling the Saturday crew every week.\"</p>\n        <figcaption class=\"who\"><span class=\"avatar\">RB</span><span><strong>Ryan B.</strong>Adult Beginner, 2024</span></figcaption>\n      </figure>\n      <figure class=\"quote\">\n        <div class=\"stars\">\u2605\u2605\u2605\u2605\u2605</div>\n        <p>\"The staff actually know boards. They talked me out of a deck that was wrong for my weight and set me up with a better one for half the price.\"</p>\n        <figcaption class=\"who\"><span class=\"avatar\">TL</span><span><strong>Tasha L.</strong>Shop customer</span></figcaption>\n      </figure>\n    </div>\n  </div>\n</section>\n\n<!-- ============ VISIT ============ -->\n<section class=\"visit\" id=\"visit\">\n  <div class=\"wrap visit-grid\">\n    <div class=\"visit-info\">\n      <div class=\"info-block\">\n        <span class=\"eyebrow\">Find us</span>\n        <h2 style=\"font-size:clamp(2rem,4vw,2.8rem);margin-bottom:16px;\">Come say hi.</h2>\n        <p>Our 6,000 sq ft shop sits next to the riverside skatepark with a covered ramp, rails, and a flat-bottom bowl for lessons.</p>\n      </div>\n      <div class=\"info-block\">\n        <h4>ADDRESS</h4>\n        <p>418 Foundry Street<br>Riverside District</p>\n      </div>\n      <div class=\"info-block\">\n        <h4>HOURS</h4>\n        <ul class=\"hours\">\n          <li>Mon \u2013 Fri <b>11:00 AM \u2013 8:00 PM</b></li>\n          <li>Saturday <b>10:00 AM \u2013 7:00 PM</b></li>\n          <li>Sunday <b>11:00 AM \u2013 5:00 PM</b></li>\n        </ul>\n      </div>\n      <div class=\"info-block\">\n        <h4>CONTACT</h4>\n        <p>(555) 018-2277 \u00b7 hello@concreteollie.example</p>\n      </div>\n    </div>\n\n    <div class=\"map\" role=\"img\" aria-label=\"Stylized map showing the shop location on Foundry Street\">\n      <svg viewBox=\"0 0 400 400\" preserveAspectRatio=\"xMidYMid slice\" xmlns=\"http://www.w3.org/2000/svg\">\n        <path d=\"M0 120 Q120 90 200 150 T400 130\" stroke=\"#2f5a6e\" stroke-width=\"28\" fill=\"none\" opacity=\".7\"/>\n        <path d=\"M0 330 L400 300\" stroke=\"#3a3e46\" stroke-width=\"10\" fill=\"none\"/>\n        <path d=\"M120 0 L140 400\" stroke=\"#3a3e46\" stroke-width=\"10\" fill=\"none\"/>\n        <path d=\"M260 0 L240 400\" stroke=\"#3a3e46\" stroke-width=\"8\" fill=\"none\"/>\n        <path d=\"M0 220 L400 240\" stroke=\"#3a3e46\" stroke-width=\"8\" fill=\"none\"/>\n        <rect x=\"170\" y=\"240\" width=\"60\" height=\"40\" rx=\"4\" fill=\"#d4ff3a\" opacity=\".12\"/>\n        <rect x=\"40\" y=\"260\" width=\"50\" height=\"34\" fill=\"#2a2d33\"/>\n        <rect x=\"290\" y=\"60\" width=\"60\" height=\"50\" fill=\"#2a2d33\"/>\n        <rect x=\"300\" y=\"250\" width=\"70\" height=\"60\" fill=\"#2a2d33\"/>\n        <circle cx=\"200\" cy=\"260\" r=\"6\" fill=\"#d4ff3a\"/>\n      </svg>\n      <div class=\"map-pin\">Concrete Ollie</div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ BOOKING / NEWSLETTER CTA ============ -->\n<section class=\"cta\" id=\"book\">\n  <div class=\"wrap cta-grid\">\n    <div>\n      <span class=\"eyebrow\" style=\"color:var(--asphalt);opacity:.7;\">Next session</span>\n      <h2>Your first lesson is on us.</h2>\n      <p>Join the mailing list for drop dates, class openings and a free beginner session for first-time students. Spots fill fast, so sign up early.</p>\n    </div>\n    <form class=\"signup\" id=\"signupForm\" novalidate>\n      <label for=\"email\">Email address</label>\n      <div class=\"signup-row\">\n        <input type=\"email\" id=\"email\" name=\"email\" placeholder=\"you@example.com\" required>\n        <select id=\"interest\" name=\"interest\" aria-label=\"Interest\">\n          <option>I'm a beginner</option>\n          <option>Booking for my kid</option>\n          <option>Just shopping</option>\n        </select>\n      </div>\n      <div style=\"margin-top:12px;\">\n        <a href=\"#lessons\" class=\"btn btn-primary\" style=\"width:100%;justify-content:center;\">Reserve my free session</a>\n      </div>\n      <small>No spam. One email a week, and unsubscribe anytime.</small>\n      <div class=\"form-msg\" id=\"formMsg\" role=\"status\" aria-live=\"polite\"></div>\n    </form>\n  </div>\n</section>\n\n</main>\n\n<!-- ============ FOOTER ============ -->\n<footer>\n  <div class=\"wrap\">\n    <div class=\"foot-grid\">\n      <div>\n        <a href=\"#top\" class=\"logo\">\n          <span class=\"logo-mark\">CO</span>\n          Concrete Ollie\n        </a>\n        <p>Skate shop and school in the Riverside District. Gear that's tested, lessons that work, and a crew that shows up.</p>\n      </div>\n      <div>\n        <h5>Shop</h5>\n        <ul>\n          <li><a href=\"#shop\">Complete Boards</a></li>\n          <li><a href=\"#shop\">Wheels &amp; Bearings</a></li>\n          <li><a href=\"#shop\">Trucks</a></li>\n          <li><a href=\"#shop\">Footwear</a></li>\n          <li><a href=\"#shop\">Gift Cards</a></li>\n        </ul>\n      </div>\n      <div>\n        <h5>Lessons</h5>\n        <ul>\n          <li><a href=\"#lessons\">Little Rollers</a></li>\n          <li><a href=\"#lessons\">Adult Beginner</a></li>\n          <li><a href=\"#lessons\">Private Coaching</a></li>\n          <li><a href=\"#lessons\">Camps &amp; Birthdays</a></li>\n          <li><a href=\"#lessons\">Waiver</a></li>\n        </ul>\n      </div>\n      <div>\n        <h5>Info</h5>\n        <ul>\n          <li><a href=\"#visit\">Hours &amp; Location</a></li>\n          <li><a href=\"#visit\">Returns &amp; Swaps</a></li>\n          <li><a href=\"#visit\">FAQ</a></li>\n          <li><a href=\"#visit\">Contact</a></li>\n        </ul>\n      </div>\n    </div>\n    <div class=\"foot-bottom\">\n      <span>\u00a9 <span id=\"year\"></span> Concrete Ollie Skate Co. All rights reserved.</span>\n      <div class=\"socials\">\n        <a href=\"#\" aria-label=\"Instagram\">IG</a>\n        <a href=\"#\" aria-label=\"YouTube\">YT</a>\n        <a href=\"#\" aria-label=\"TikTok\">TT</a>\n      </div>\n    </div>\n  </div>\n</footer>\n\n<script>\n  // Mobile nav toggle\n  const toggle = document.getElementById('menuToggle');\n  const navLinks = document.getElementById('navLinks');\n  toggle.addEventListener('click', () => {\n    const open = navLinks.classList.toggle('open');\n    toggle.setAttribute('aria-expanded', open);\n  });\n  navLinks.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {\n    navLinks.classList.remove('open');\n    toggle.setAttribute('aria-expanded', 'false');\n  }));\n\n  // Lesson filter tabs\n  const tabs = document.querySelectorAll('.tab');\n  const cards = document.querySelectorAll('.lesson');\n  tabs.forEach(tab => tab.addEventListener('click', () => {\n    tabs.forEach(t => t.setAttribute('aria-selected', 'false'));\n    tab.setAttribute('aria-selected', 'true');\n    const f = tab.dataset.filter;\n    cards.forEach(card => {\n      card.classList.toggle('lesson-hidden', f !== 'all' && card.dataset.type !== f);\n    });\n  }));\n\n  // Signup form (front-end only)\n  const form = document.getElementById('signupForm');\n  const msg = document.getElementById('formMsg');\n  form.addEventListener('submit', e => {\n    e.preventDefault();\n    const email = document.getElementById('email').value.trim();\n    if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) {\n      msg.textContent = 'Please enter a valid email address.';\n      return;\n    }\n    msg.textContent = \"You're on the list. Check your inbox for your free session code.\";\n    form.reset();\n  });\n\n  document.getElementById('year').textContent = new Date().getFullYear();\n</script>\n</body>\n</html>\n"}