{"brief": "B6", "model": "anthropic/claude-haiku-5.5", "i": 0, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Lowline Skate Co. | Shop, Learn, Roll</title>\n<meta name=\"description\" content=\"Lowline Skate Co. is a skateboard shop with beginner-friendly lessons for kids and adults.\">\n<style>\n  :root {\n    --bg: #0e0f11;\n    --bg-2: #16181b;\n    --bg-3: #1f2226;\n    --ink: #f4efe6;\n    --muted: #9a9ca3;\n    --accent: #ff4d2e;\n    --accent-2: #ffc23d;\n    --line: #2a2d32;\n    --radius: 14px;\n    --display: Impact, \"Haettenschweiler\", \"Arial Narrow Bold\", sans-serif;\n    --body: system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n  }\n\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  html { scroll-behavior: smooth; }\n  body {\n    font-family: var(--body);\n    background: var(--bg);\n    color: var(--ink);\n    line-height: 1.6;\n    -webkit-font-smoothing: antialiased;\n  }\n  a { color: inherit; text-decoration: none; }\n  img, svg { display: block; max-width: 100%; }\n\n  .wrap { width: min(1180px, 92%); margin: 0 auto; }\n  section { padding: 96px 0; position: relative; }\n\n  .eyebrow {\n    font-family: var(--display);\n    letter-spacing: .14em;\n    text-transform: uppercase;\n    font-size: .85rem;\n    color: var(--accent);\n    display: inline-block;\n    margin-bottom: 14px;\n  }\n  h1, h2, h3 { font-family: var(--display); font-weight: 400; text-transform: uppercase; line-height: 1; letter-spacing: .01em; }\n  h1 { font-size: clamp(3.2rem, 9vw, 7.2rem); }\n  h2 { font-size: clamp(2.2rem, 5vw, 3.8rem); margin-bottom: 18px; }\n  h3 { font-size: 1.6rem; margin-bottom: 10px; }\n  p.lead { color: var(--muted); font-size: 1.1rem; max-width: 560px; }\n\n  .btn {\n    display: inline-flex; align-items: center; gap: 10px;\n    font-family: var(--display); text-transform: uppercase; letter-spacing: .06em;\n    font-size: 1rem; padding: 14px 26px; border-radius: 999px;\n    border: 2px solid transparent; cursor: pointer; transition: transform .15s, background .2s, color .2s;\n  }\n  .btn:hover { transform: translateY(-2px); }\n  .btn-primary { background: var(--accent); color: #111; }\n  .btn-primary:hover { background: var(--accent-2); }\n  .btn-ghost { border-color: var(--ink); color: var(--ink); background: transparent; }\n  .btn-ghost:hover { background: var(--ink); color: var(--bg); }\n  .btn-sm { padding: 9px 16px; font-size: .85rem; }\n\n  /* ---------- Header ---------- */\n  header {\n    position: sticky; top: 0; z-index: 50;\n    background: rgba(14,15,17,.85);\n    backdrop-filter: blur(10px);\n    border-bottom: 1px solid var(--line);\n  }\n  .nav { display: flex; align-items: center; justify-content: space-between; height: 72px; gap: 20px; }\n  .logo { display: flex; align-items: center; gap: 10px; font-family: var(--display); font-size: 1.35rem; text-transform: uppercase; letter-spacing: .04em; }\n  .logo small { display: block; font-family: var(--body); font-size: .6rem; letter-spacing: .25em; color: var(--muted); }\n  .nav-links { display: flex; gap: 28px; list-style: none; font-size: .95rem; color: var(--muted); }\n  .nav-links a:hover { color: var(--ink); }\n  .nav-actions { display: flex; align-items: center; gap: 14px; }\n  .cart { position: relative; font-size: .95rem; color: var(--ink); }\n  .cart span {\n    position: absolute; top: -8px; right: -12px; background: var(--accent); color: #111;\n    font-size: .7rem; font-weight: 700; border-radius: 999px; padding: 1px 6px;\n  }\n\n  /* ---------- Hero ---------- */\n  .hero {\n    padding: 80px 0 60px;\n    background:\n      radial-gradient(circle at 80% 30%, rgba(255,77,46,.22), transparent 45%),\n      repeating-linear-gradient(90deg, transparent 0 79px, rgba(255,255,255,.025) 79px 80px),\n      var(--bg);\n    overflow: hidden;\n  }\n  .hero-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 40px; align-items: center; }\n  .hero h1 span { color: var(--accent); }\n  .hero p.lead { margin: 24px 0 34px; }\n  .hero-buttons { display: flex; flex-wrap: wrap; gap: 14px; }\n  .hero-stats { display: flex; gap: 40px; margin-top: 48px; flex-wrap: wrap; }\n  .hero-stats strong { display: block; font-family: var(--display); font-size: 2.2rem; font-weight: 400; color: var(--accent-2); }\n  .hero-stats span { font-size: .85rem; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; }\n  .hero-art { position: relative; display: grid; place-items: center; }\n  .hero-art .sticker {\n    position: absolute; top: 6%; right: 2%;\n    background: var(--accent-2); color: #111; font-family: var(--display);\n    text-transform: uppercase; padding: 14px 18px; border-radius: 10px;\n    transform: rotate(8deg); font-size: 1.1rem; box-shadow: 6px 6px 0 #000;\n  }\n  .hero-art .sticker-2 {\n    position: absolute; bottom: 8%; left: 0;\n    background: var(--ink); color: #111; font-family: var(--display);\n    text-transform: uppercase; padding: 12px 16px; border-radius: 10px;\n    transform: rotate(-6deg); font-size: 1rem; box-shadow: 6px 6px 0 #000;\n  }\n  .deck { width: min(420px, 90%); filter: drop-shadow(0 30px 40px rgba(0,0,0,.5)); animation: float 6s ease-in-out infinite; }\n  @keyframes float { 0%,100% { transform: translateY(0) rotate(-8deg); } 50% { transform: translateY(-14px) rotate(-4deg); } }\n\n  /* ---------- Marquee ---------- */\n  .marquee { background: var(--accent); color: #111; overflow: hidden; white-space: nowrap; padding: 16px 0; }\n  .marquee-track { display: inline-block; animation: slide 22s linear infinite; font-family: var(--display); font-size: 1.6rem; text-transform: uppercase; letter-spacing: .05em; }\n  .marquee-track span { margin: 0 22px; }\n  @keyframes slide { from { transform: translateX(0); } to { transform: translateX(-50%); } }\n\n  /* ---------- Shop ---------- */\n  .section-head { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 20px; margin-bottom: 48px; }\n  .categories { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }\n  .cat {\n    background: var(--bg-2); border: 1px solid var(--line); border-radius: var(--radius);\n    padding: 28px 22px; transition: border-color .2s, transform .2s; position: relative; overflow: hidden;\n  }\n  .cat:hover { border-color: var(--accent); transform: translateY(-4px); }\n  .cat .icon { width: 48px; height: 48px; color: var(--accent); margin-bottom: 18px; }\n  .cat h3 { font-size: 1.35rem; }\n  .cat p { color: var(--muted); font-size: .92rem; }\n  .cat .from { margin-top: 14px; font-size: .85rem; color: var(--accent-2); font-weight: 600; }\n  .cat .num { position: absolute; top: 14px; right: 18px; font-family: var(--display); font-size: 2.4rem; color: var(--bg-3); }\n\n  .featured { margin-top: 56px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }\n  .product { background: var(--bg-2); border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); }\n  .product .art { height: 200px; display: grid; place-items: center; background: var(--bg-3); }\n  .product .art svg { height: 160px; width: auto; }\n  .product .body { padding: 20px 22px 24px; }\n  .product .row { display: flex; justify-content: space-between; align-items: center; margin-top: 10px; }\n  .product .name { font-weight: 600; }\n  .product .price { font-family: var(--display); font-size: 1.3rem; color: var(--accent-2); }\n  .tag { display: inline-block; font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; padding: 3px 9px; border-radius: 999px; background: var(--line); color: var(--ink); }\n  .tag.hot { background: var(--accent); color: #111; }\n\n  /* ---------- Lessons ---------- */\n  .lessons { background: var(--bg-2); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }\n  .plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }\n  .plan {\n    background: var(--bg); border: 1px solid var(--line); border-radius: 18px; padding: 36px 30px;\n    display: flex; flex-direction: column; position: relative;\n  }\n  .plan.popular { border: 2px solid var(--accent); transform: translateY(-10px); }\n  .plan .badge { position: absolute; top: -14px; left: 30px; background: var(--accent); color: #111; font-family: var(--display); text-transform: uppercase; padding: 4px 14px; border-radius: 999px; font-size: .85rem; }\n  .plan .level { font-family: var(--display); color: var(--accent-2); letter-spacing: .1em; text-transform: uppercase; font-size: .9rem; }\n  .plan .price { font-family: var(--display); font-size: 3.4rem; line-height: 1; margin: 14px 0 4px; }\n  .plan .price small { font-family: var(--body); font-size: .95rem; color: var(--muted); }\n  .plan p { color: var(--muted); font-size: .95rem; margin-bottom: 20px; }\n  .plan ul { list-style: none; margin-bottom: 28px; flex: 1; }\n  .plan li { padding: 9px 0; border-bottom: 1px dashed var(--line); font-size: .95rem; display: flex; gap: 10px; }\n  .plan li::before { content: \"\u2713\"; color: var(--accent); font-weight: 700; }\n  .plan .btn { justify-content: center; }\n\n  .steps { margin-top: 80px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; counter-reset: step; }\n  .step { padding: 0 24px; border-left: 2px solid var(--line); position: relative; }\n  .step:first-child { border-left: none; padding-left: 0; }\n  .step::before {\n    counter-increment: step; content: \"0\" counter(step);\n    font-family: var(--display); font-size: 3rem; color: var(--accent); line-height: 1; display: block; margin-bottom: 12px;\n  }\n  .step h3 { font-size: 1.3rem; }\n  .step p { color: var(--muted); font-size: .92rem; }\n\n  /* ---------- Instructors ---------- */\n  .crew { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }\n  .coach { background: var(--bg-2); border-radius: var(--radius); padding: 26px; display: flex; gap: 18px; align-items: center; border: 1px solid var(--line); }\n  .avatar {\n    flex: 0 0 84px; height: 84px; border-radius: 50%;\n    display: grid; place-items: center; font-family: var(--display); font-size: 1.9rem;\n    color: #111;\n  }\n  .coach h3 { font-size: 1.25rem; margin-bottom: 4px; }\n  .coach .role { color: var(--accent-2); font-size: .82rem; text-transform: uppercase; letter-spacing: .08em; }\n  .coach p { color: var(--muted); font-size: .9rem; margin-top: 6px; }\n\n  /* ---------- Schedule ---------- */\n  .schedule { background: var(--bg-2); border-top: 1px solid var(--line); }\n  .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius); }\n  table { width: 100%; border-collapse: collapse; min-width: 640px; background: var(--bg); }\n  th, td { text-align: left; padding: 16px 20px; border-bottom: 1px solid var(--line); font-size: .95rem; }\n  th { font-family: var(--display); font-weight: 400; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); background: var(--bg-3); font-size: .85rem; }\n  tr:last-child td { border-bottom: none; }\n  td .lvl { font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; padding: 3px 9px; border-radius: 999px; background: var(--line); }\n  .spots { color: var(--accent-2); font-weight: 600; }\n  .spots.full { color: var(--muted); text-decoration: line-through; }\n  td .btn { padding: 8px 14px; font-size: .8rem; }\n\n  /* ---------- Reviews ---------- */\n  .reviews { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }\n  .review { background: var(--bg-2); border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; }\n  .stars { color: var(--accent-2); letter-spacing: 3px; margin-bottom: 14px; }\n  .review blockquote { font-size: 1.02rem; margin-bottom: 18px; }\n  .review cite { font-style: normal; color: var(--muted); font-size: .88rem; }\n  .review cite strong { color: var(--ink); display: block; }\n\n  /* ---------- Visit ---------- */\n  .visit-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 40px; align-items: stretch; }\n  .hours { background: var(--bg-2); border-radius: var(--radius); padding: 34px; border: 1px solid var(--line); }\n  .hours dl { display: grid; grid-template-columns: 1fr auto; gap: 14px 24px; margin-top: 18px; }\n  .hours dt { color: var(--muted); }\n  .hours dd { font-weight: 600; text-align: right; }\n  .hours .note { margin-top: 24px; font-size: .9rem; color: var(--muted); border-top: 1px solid var(--line); padding-top: 18px; }\n  .map {\n    border-radius: var(--radius); min-height: 340px; position: relative; overflow: hidden;\n    background:\n      linear-gradient(115deg, transparent 47%, #2c3036 47% 53%, transparent 53%),\n      linear-gradient(25deg, transparent 62%, #2c3036 62% 66%, transparent 66%),\n      linear-gradient(0deg, transparent 30%, #2c3036 30% 33%, transparent 33%),\n      repeating-linear-gradient(0deg, #1a1c20 0 38px, #23262b 38px 40px),\n      #1a1c20;\n    border: 1px solid var(--line);\n  }\n  .pin {\n    position: absolute; left: 50%; top: 45%; transform: translate(-50%,-50%);\n    background: var(--accent); color: #111; font-family: var(--display); text-transform: uppercase;\n    padding: 10px 16px; border-radius: 10px; box-shadow: 0 10px 30px rgba(255,77,46,.4); white-space: nowrap;\n  }\n  .pin::after { content: \"\"; position: absolute; left: 50%; bottom: -8px; transform: translateX(-50%); border: 8px solid transparent; border-top-color: var(--accent); border-bottom: 0; }\n  .map .street { position: absolute; left: 14px; bottom: 12px; font-size: .8rem; color: var(--muted); background: rgba(0,0,0,.5); padding: 4px 10px; border-radius: 6px; }\n\n  /* ---------- CTA band ---------- */\n  .cta-band {\n    background: var(--accent); color: #111; padding: 70px 0; position: relative; overflow: hidden;\n  }\n  .cta-band h2 { color: #111; font-size: clamp(2.6rem, 6vw, 5rem); max-width: 14ch; }\n  .cta-inner { display: flex; justify-content: space-between; align-items: center; gap: 30px; flex-wrap: wrap; }\n  .cta-form { display: flex; gap: 10px; flex-wrap: wrap; }\n  .cta-form input {\n    font: inherit; padding: 14px 18px; border-radius: 999px; border: 2px solid #111; min-width: 260px; background: transparent; color: #111;\n  }\n  .cta-form input::placeholder { color: rgba(17,17,17,.6); }\n  .cta-form .btn { background: #111; color: var(--ink); }\n  .cta-form .btn:hover { background: var(--ink); color: #111; }\n\n  /* ---------- Footer ---------- */\n  footer { padding: 64px 0 30px; background: #08090a; border-top: 1px solid var(--line); }\n  .foot-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; }\n  .foot-grid h4 { font-family: var(--display); font-weight: 400; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); margin-bottom: 16px; font-size: .9rem; }\n  .foot-grid ul { list-style: none; }\n  .foot-grid li { margin-bottom: 10px; color: var(--ink); font-size: .95rem; }\n  .foot-grid li a:hover { color: var(--accent); }\n  .foot-grid p { color: var(--muted); font-size: .92rem; max-width: 300px; margin-top: 14px; }\n  .legal { margin-top: 50px; padding-top: 24px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; color: var(--muted); font-size: .82rem; flex-wrap: wrap; gap: 12px; }\n\n  /* ---------- Responsive ---------- */\n  @media (max-width: 980px) {\n    .hero-grid, .visit-grid { grid-template-columns: 1fr; }\n    .hero-art { order: -1; }\n    .categories { grid-template-columns: repeat(2, 1fr); }\n    .featured, .plans, .crew, .reviews { grid-template-columns: 1fr; }\n    .plan.popular { transform: none; }\n    .steps { grid-template-columns: repeat(2, 1fr); row-gap: 40px; }\n    .step:nth-child(odd) { border-left: none; padding-left: 0; }\n    .foot-grid { grid-template-columns: 1fr 1fr; }\n    .nav-links { display: none; }\n  }\n  @media (max-width: 560px) {\n    section { padding: 70px 0; }\n    .categories, .steps { grid-template-columns: 1fr; }\n    .step { border-left: none; padding-left: 0; }\n    .foot-grid { grid-template-columns: 1fr; }\n    .hero-stats { gap: 24px; }\n    .cta-form input { min-width: 100%; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    .deck, .marquee-track { animation: none; }\n    html { scroll-behavior: auto; }\n  }\n</style>\n</head>\n<body>\n\n<!-- ============ HEADER ============ -->\n<header>\n  <div class=\"wrap nav\">\n    <a href=\"#top\" class=\"logo\" id=\"top\" aria-label=\"Lowline Skate Co. home\">\n      <svg width=\"34\" height=\"34\" viewBox=\"0 0 34 34\" aria-hidden=\"true\">\n        <rect x=\"1\" y=\"1\" width=\"32\" height=\"32\" rx=\"8\" fill=\"#ff4d2e\"/>\n        <path d=\"M6 22 Q17 8 28 22\" stroke=\"#111\" stroke-width=\"3.2\" fill=\"none\" stroke-linecap=\"round\"/>\n        <circle cx=\"9\" cy=\"25\" r=\"2.4\" fill=\"#111\"/>\n        <circle cx=\"25\" cy=\"25\" r=\"2.4\" fill=\"#111\"/>\n      </svg>\n      <div>Lowline<small>SKATE CO.</small></div>\n    </a>\n    <ul class=\"nav-links\">\n      <li><a href=\"#shop\">Shop</a></li>\n      <li><a href=\"#lessons\">Lessons</a></li>\n      <li><a href=\"#coaches\">Coaches</a></li>\n      <li><a href=\"#schedule\">Schedule</a></li>\n      <li><a href=\"#visit\">Visit</a></li>\n    </ul>\n    <div class=\"nav-actions\">\n      <a href=\"#lessons\" class=\"btn btn-ghost btn-sm\">Book a Lesson</a>\n      <a href=\"#shop\" class=\"cart\" aria-label=\"Cart, 2 items\">Cart <span>2</span></a>\n    </div>\n  </div>\n</header>\n\n<main>\n\n<!-- ============ HERO ============ -->\n<section class=\"hero\">\n  <div class=\"wrap hero-grid\">\n    <div>\n      <span class=\"eyebrow\">Skate shop \u00b7 Lessons \u00b7 Since 2011</span>\n      <h1>Learn to roll.<br><span>Shop the good stuff.</span></h1>\n      <p class=\"lead\">Lowline is a neighborhood skate shop with real boards, honest advice, and certified coaches who'll get you from your first push to your first kickflip. Walk in curious. Walk out rolling.</p>\n      <div class=\"hero-buttons\">\n        <a href=\"#lessons\" class=\"btn btn-primary\">Book a lesson \u2192</a>\n        <a href=\"#shop\" class=\"btn btn-ghost\">Shop the shop</a>\n      </div>\n      <div class=\"hero-stats\">\n        <div><strong>4,200+</strong><span>Skaters taught</span></div>\n        <div><strong>12</strong><span>Certified coaches</span></div>\n        <div><strong>300+</strong><span>Decks in stock</span></div>\n      </div>\n    </div>\n\n    <div class=\"hero-art\" aria-hidden=\"true\">\n      <span class=\"sticker\">Beginners welcome!</span>\n      <svg class=\"deck\" viewBox=\"0 0 300 640\" role=\"img\" aria-label=\"Illustrated skateboard deck\">\n        <defs>\n          <linearGradient id=\"deckGrad\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n            <stop offset=\"0\" stop-color=\"#ffc23d\"/>\n            <stop offset=\".55\" stop-color=\"#ff4d2e\"/>\n            <stop offset=\"1\" stop-color=\"#8e1c0e\"/>\n          </linearGradient>\n        </defs>\n        <!-- deck shape -->\n        <path d=\"M150 10 C215 10 240 70 240 150 L240 490 C240 580 215 630 150 630 C85 630 60 580 60 490 L60 150 C60 70 85 10 150 10 Z\" fill=\"url(#deckGrad)\" stroke=\"#111\" stroke-width=\"6\"/>\n        <!-- inner graphic -->\n        <path d=\"M150 40 C200 40 215 90 215 150 L215 490 C215 560 200 600 150 600 C100 600 85 560 85 490 L85 150 C85 90 100 40 150 40 Z\" fill=\"none\" stroke=\"#111\" stroke-width=\"3\" stroke-dasharray=\"10 8\" opacity=\".6\"/>\n        <!-- wordmark -->\n        <text x=\"150\" y=\"300\" text-anchor=\"middle\" font-family=\"Impact, Arial Narrow, sans-serif\" font-size=\"46\" fill=\"#111\" transform=\"rotate(90 150 300)\">LOWLINE</text>\n        <!-- sun -->\n        <circle cx=\"150\" cy=\"150\" r=\"34\" fill=\"#f4efe6\" stroke=\"#111\" stroke-width=\"4\"/>\n        <!-- trucks -->\n        <rect x=\"58\" y=\"110\" width=\"184\" height=\"10\" fill=\"#111\"/>\n        <rect x=\"58\" y=\"500\" width=\"184\" height=\"10\" fill=\"#111\"/>\n        <!-- grip-tape holes -->\n        <g fill=\"#111\">\n          <circle cx=\"110\" cy=\"110\" r=\"4\"/><circle cx=\"190\" cy=\"110\" r=\"4\"/>\n          <circle cx=\"110\" cy=\"505\" r=\"4\"/><circle cx=\"190\" cy=\"505\" r=\"4\"/>\n        </g>\n        <!-- wheels -->\n        <g fill=\"#f4efe6\" stroke=\"#111\" stroke-width=\"4\">\n          <rect x=\"30\" y=\"98\" width=\"26\" height=\"34\" rx=\"8\"/>\n          <rect x=\"244\" y=\"98\" width=\"26\" height=\"34\" rx=\"8\"/>\n          <rect x=\"30\" y=\"498\" width=\"26\" height=\"34\" rx=\"8\"/>\n          <rect x=\"244\" y=\"498\" width=\"26\" height=\"34\" rx=\"8\"/>\n        </g>\n      </svg>\n      <span class=\"sticker-2\">Certified coaches</span>\n    </div>\n  </div>\n</section>\n\n<!-- ============ MARQUEE ============ -->\n<div class=\"marquee\" aria-hidden=\"true\">\n  <div class=\"marquee-track\">\n    <span>Decks</span><span>\u2726</span><span>Lessons</span><span>\u2726</span><span>Trucks</span><span>\u2726</span><span>Wheels</span><span>\u2726</span><span>Protection</span><span>\u2726</span><span>Kids Classes</span><span>\u2726</span><span>Private Coaching</span><span>\u2726</span>\n    <span>Decks</span><span>\u2726</span><span>Lessons</span><span>\u2726</span><span>Trucks</span><span>\u2726</span><span>Wheels</span><span>\u2726</span><span>Protection</span><span>\u2726</span><span>Kids Classes</span><span>\u2726</span><span>Private Coaching</span><span>\u2726</span>\n  </div>\n</div>\n\n<!-- ============ SHOP ============ -->\n<section id=\"shop\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <div>\n        <span class=\"eyebrow\">The Shop</span>\n        <h2>Gear that<br>actually rolls.</h2>\n      </div>\n      <p class=\"lead\">We build complete boards in-house, rebuild old setups, and only carry parts we'd ride ourselves. Not sure what you need? Ask at the counter.</p>\n    </div>\n\n    <div class=\"categories\">\n      <a href=\"#shop\" class=\"cat\">\n        <span class=\"num\">01</span>\n        <svg class=\"icon\" viewBox=\"0 0 48 48\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\"><rect x=\"6\" y=\"8\" width=\"36\" height=\"8\" rx=\"4\"/><path d=\"M14 16v22M34 16v22\"/><circle cx=\"12\" cy=\"40\" r=\"3\"/><circle cx=\"36\" cy=\"40\" r=\"3\"/></svg>\n        <h3>Complete Boards</h3>\n        <p>Pre-built and ready to ride. Street, cruiser, and park setups.</p>\n        <div class=\"from\">From $129</div>\n      </a>\n      <a href=\"#shop\" class=\"cat\">\n        <span class=\"num\">02</span>\n        <svg class=\"icon\" viewBox=\"0 0 48 48\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linejoin=\"round\"><path d=\"M16 4h16l4 40H12z\"/><path d=\"M20 14h8\"/></svg>\n        <h3>Decks</h3>\n        <p>Maple decks in every shape, width, and artist collab we can get.</p>\n        <div class=\"from\">From $58</div>\n      </a>\n      <a href=\"#shop\" class=\"cat\">\n        <span class=\"num\">03</span>\n        <svg class=\"icon\" viewBox=\"0 0 48 48\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\"><circle cx=\"24\" cy=\"24\" r=\"16\"/><circle cx=\"24\" cy=\"24\" r=\"5\"/><path d=\"M24 8v6M24 34v6M8 24h6M34 24h6\"/></svg>\n        <h3>Wheels & Bearings</h3>\n        <p>Urethane formulas for street, parks, and cruising, plus bearings.</p>\n        <div class=\"from\">From $32</div>\n      </a>\n      <a href=\"#shop\" class=\"cat\">\n        <span class=\"num\">04</span>\n        <svg class=\"icon\" viewBox=\"0 0 48 48\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linejoin=\"round\"><path d=\"M24 4l16 6v12c0 10-7 18-16 22C15 40 8 32 8 22V10z\"/><path d=\"M17 24l5 5 9-10\"/></svg>\n        <h3>Protection</h3>\n        <p>Helmets, pads, and wrist guards. Fitted in-store, no guessing.</p>\n        <div class=\"from\">From $24</div>\n      </a>\n    </div>\n\n    <div class=\"featured\">\n      <article class=\"product\">\n        <div class=\"art\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 120 160\"><path d=\"M60 6 C90 6 100 30 100 70 L100 130 C100 150 90 156 60 156 C30 156 20 150 20 130 L20 70 C20 30 30 6 60 6Z\" fill=\"#ffc23d\" stroke=\"#111\" stroke-width=\"3\"/><circle cx=\"60\" cy=\"60\" r=\"16\" fill=\"#f4efe6\" stroke=\"#111\" stroke-width=\"3\"/><path d=\"M40 120 L80 120\" stroke=\"#111\" stroke-width=\"4\"/></svg>\n        </div>\n        <div class=\"body\">\n          <span class=\"tag hot\">Staff Pick</span>\n          <h3 style=\"margin-top:12px;font-size:1.3rem\">Sunset Pop 8.25\" Deck</h3>\n          <div class=\"row\"><span class=\"name\">Medium concave \u00b7 7-ply maple</span><span class=\"price\">$68</span></div>\n        </div>\n      </article>\n      <article class=\"product\">\n        <div class=\"art\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 120 160\"><path d=\"M60 6 C90 6 100 30 100 70 L100 130 C100 150 90 156 60 156 C30 156 20 150 20 130 L20 70 C20 30 30 6 60 6Z\" fill=\"#8fd3ff\" stroke=\"#111\" stroke-width=\"3\"/><path d=\"M30 60 L90 100 M90 60 L30 100\" stroke=\"#111\" stroke-width=\"5\" stroke-linecap=\"round\"/></svg>\n        </div>\n        <div class=\"body\">\n          <span class=\"tag\">New</span>\n          <h3 style=\"margin-top:12px;font-size:1.3rem\">Lowline Starter Complete</h3>\n          <div class=\"row\"><span class=\"name\">Beginner-friendly, pre-tuned</span><span class=\"price\">$149</span></div>\n        </div>\n      </article>\n      <article class=\"product\">\n        <div class=\"art\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 120 160\"><path d=\"M60 6 C90 6 100 30 100 70 L100 130 C100 150 90 156 60 156 C30 156 20 150 20 130 L20 70 C20 30 30 6 60 6Z\" fill=\"#ff4d2e\" stroke=\"#111\" stroke-width=\"3\"/><rect x=\"40\" y=\"50\" width=\"40\" height=\"60\" rx=\"6\" fill=\"#111\"/></svg>\n        </div>\n        <div class=\"body\">\n          <span class=\"tag\">Restock</span>\n          <h3 style=\"margin-top:12px;font-size:1.3rem\">Gridlock Street Wheels</h3>\n          <div class=\"row\"><span class=\"name\">99A \u00b7 set of 4</span><span class=\"price\">$54</span></div>\n        </div>\n      </article>\n    </div>\n  </div>\n</section>\n\n<!-- ============ LESSONS ============ -->\n<section class=\"lessons\" id=\"lessons\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <div>\n        <span class=\"eyebrow\">Skate School</span>\n        <h2>Learn it<br>the right way.</h2>\n      </div>\n      <p class=\"lead\">Small groups, safe progressions, and a board you can use the moment class ends. Every lesson includes a helmet and pads if you need them.</p>\n    </div>\n\n    <div class=\"plans\">\n      <div class=\"plan\">\n        <div class=\"level\">Ages 6\u201312</div>\n        <h3 style=\"margin-top:10px\">Kids Foundations</h3>\n        <div class=\"price\">$65 <small>/ 4 weeks</small></div>\n        <p>Balance, pushing, stopping, and falling safely. Four 60-minute sessions in groups of 6.</p>\n        <ul>\n          <li>Helmet & pads loaner included</li>\n          <li>Progress card after week 4</li>\n          <li>Board discount for graduates</li>\n        </ul>\n        <a href=\"#schedule\" class=\"btn btn-ghost\">Reserve a spot</a>\n      </div>\n\n      <div class=\"plan popular\">\n        <span class=\"badge\">Most Popular</span>\n        <div class=\"level\">Teens & Adults</div>\n        <h3 style=\"margin-top:10px\">Group Foundations</h3>\n        <div class=\"price\">$85 <small>/ 4 weeks</small></div>\n        <p>From first push to confident carving, drop-ins, and your first ollie. Groups of 8.</p>\n        <ul>\n          <li>Drills for turning, stopping & pushing</li>\n          <li>Intro to ollies and curb work</li>\n          <li>Free skate-park session with coach</li>\n        </ul>\n        <a href=\"#schedule\" class=\"btn btn-primary\">Book this class</a>\n      </div>\n\n      <div class=\"plan\">\n        <div class=\"level\">One-on-one</div>\n        <h3 style=\"margin-top:10px\">Private Coaching</h3>\n        <div class=\"price\">$90 <small>/ hour</small></div>\n        <p>Custom sessions built around your goals, fear, or the trick that's been haunting you.</p>\n        <ul>\n          <li>Coach-selected session plan</li>\n          <li>Video breakdown of your attempts</li>\n          <li>Flexible times, weekends included</li>\n        </ul>\n        <a href=\"#visit\" class=\"btn btn-ghost\">Request a time</a>\n      </div>\n    </div>\n\n    <div class=\"steps\">\n      <div class=\"step\">\n        <h3>Book</h3>\n        <p>Pick a program online or stop by the counter. We'll match you with the right level.</p>\n      </div>\n      <div class=\"step\">\n        <h3>Gear Check</h3>\n        <p>We'll size your helmet and pads and set up a beginner-friendly board for class.</p>\n      </div>\n      <div class=\"step\">\n        <h3>Learn</h3>\n        <p>Coaches break every trick into small steps so you can progress without getting hurt.</p>\n      </div>\n      <div class=\"step\">\n        <h3>Progress</h3>\n        <p>Track your skills on a progress card, then keep going with open skate nights.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ COACHES ============ -->\n<section id=\"coaches\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <div>\n        <span class=\"eyebrow\">Your Coaches</span>\n        <h2>Skaters who<br>teach patiently.</h2>\n      </div>\n      <p class=\"lead\">Every coach is CPR-certified, background-checked, and has at least five years of riding behind them.</p>\n    </div>\n\n    <div class=\"crew\">\n      <div class=\"coach\">\n        <div class=\"avatar\" style=\"background:#ffc23d\">MR</div>\n        <div>\n          <h3>Maya Rios</h3>\n          <div class=\"role\">Head Coach</div>\n          <p>Former park competitor. Specializes in nervous first-timers and kids' classes.</p>\n        </div>\n      </div>\n      <div class=\"coach\">\n        <div class=\"avatar\" style=\"background:#8fd3ff\">DK</div>\n        <div>\n          <h3>Dev Kapoor</h3>\n          <div class=\"role\">Coach \u00b7 Private</div>\n          <p>Street skater. Ollie, shuvit, and manual progressions are his favorite projects.</p>\n        </div>\n      </div>\n      <div class=\"coach\">\n        <div class=\"avatar\" style=\"background:#ff4d2e\">JO</div>\n        <div>\n          <h3>Jules Okafor</h3>\n          <div class=\"role\">Coach \u00b7 Adults</div>\n          <p>Ran a bowl crew for a decade. Great for riders returning after a long break.</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ SCHEDULE ============ -->\n<section class=\"schedule\" id=\"schedule\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <div>\n        <span class=\"eyebrow\">This Week</span>\n        <h2>Upcoming classes.</h2>\n      </div>\n      <p class=\"lead\">Classes run in four-week blocks. Spots are limited, so reserve early.</p>\n    </div>\n\n    <div class=\"table-wrap\">\n      <table>\n        <thead>\n          <tr>\n            <th>Day</th>\n            <th>Time</th>\n            <th>Class</th>\n            <th>Level</th>\n            <th>Coach</th>\n            <th>Availability</th>\n            <th></th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <td>Saturday</td>\n            <td>10:00 \u2013 11:00 AM</td>\n            <td>Kids Foundations</td>\n            <td><span class=\"lvl\">Ages 6\u201312</span></td>\n            <td>Maya Rios</td>\n            <td class=\"spots\">3 spots left</td>\n            <td><a href=\"#visit\" class=\"btn btn-primary\">Reserve</a></td>\n          </tr>\n          <tr>\n            <td>Saturday</td>\n            <td>1:00 \u2013 2:00 PM</td>\n            <td>Group Foundations</td>\n    