{"brief": "B3", "model": "openai/gpt-6-luna", "i": 3, "finish": "stop", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#f6f7f3\">\n  <title>Fjord \u2014 The open-source database for data teams</title>\n  <style>\n    :root {\n      color-scheme: light;\n      --paper: #f6f7f3;\n      --ink: #19221f;\n      --muted: #66716b;\n      --line: #e1e6df;\n      --green: #b9f276;\n      --green-dark: #68a934;\n      --forest: #18251f;\n      --forest-soft: #22332b;\n      --white: #fff;\n      --sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      --mono: \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace;\n    }\n\n    * { box-sizing: border-box; }\n\n    html { scroll-behavior: smooth; }\n\n    body {\n      margin: 0;\n      background: var(--paper);\n      color: var(--ink);\n      font-family: var(--sans);\n      -webkit-font-smoothing: antialiased;\n    }\n\n    a { color: inherit; text-decoration: none; }\n\n    .wrap {\n      width: min(1160px, calc(100% - 48px));\n      margin-inline: auto;\n    }\n\n    .nav {\n      height: 80px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      border-bottom: 1px solid rgba(25, 34, 31, .09);\n    }\n\n    .brand {\n      display: inline-flex;\n      align-items: center;\n      gap: 11px;\n      font-size: 20px;\n      font-weight: 760;\n      letter-spacing: -.7px;\n    }\n\n    .brand-mark {\n      width: 30px;\n      height: 30px;\n      display: grid;\n      place-items: center;\n      border-radius: 9px;\n      color: var(--forest);\n      background: var(--green);\n    }\n\n    .brand-mark svg { width: 20px; height: 20px; }\n\n    .nav-links {\n      display: flex;\n      align-items: center;\n      gap: 34px;\n      color: #536059;\n      font-size: 13px;\n      font-weight: 560;\n    }\n\n    .nav-links a:hover { color: var(--ink); }\n\n    .nav-action {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      padding: 10px 15px;\n      border: 1px solid #d8ded6;\n      border-radius: 8px;\n      background: rgba(255,255,255,.55);\n      color: var(--ink);\n      font-size: 13px;\n      font-weight: 650;\n      transition: .2s ease;\n    }\n\n    .nav-action:hover {\n      background: white;\n      border-color: #aab6aa;\n      transform: translateY(-1px);\n    }\n\n    .nav-action svg { width: 15px; height: 15px; }\n\n    .hero {\n      display: grid;\n      grid-template-columns: minmax(0, .95fr) minmax(480px, 1.05fr);\n      gap: 56px;\n      align-items: center;\n      padding: 76px 0 82px;\n    }\n\n    .eyebrow {\n      display: inline-flex;\n      align-items: center;\n      gap: 9px;\n      color: #476238;\n      font-size: 11px;\n      font-weight: 760;\n      letter-spacing: 1.45px;\n      text-transform: uppercase;\n    }\n\n    .eyebrow-dot {\n      width: 7px;\n      height: 7px;\n      border-radius: 50%;\n      background: #72b744;\n      box-shadow: 0 0 0 4px rgba(114,183,68,.13);\n    }\n\n    h1 {\n      max-width: 590px;\n      margin: 22px 0 20px;\n      font-size: clamp(48px, 6vw, 76px);\n      line-height: .99;\n      letter-spacing: -5.3px;\n      font-weight: 660;\n    }\n\n    h1 span { color: #638c49; }\n\n    .hero-copy {\n      max-width: 490px;\n      margin: 0;\n      color: #647068;\n      font-size: 17px;\n      line-height: 1.7;\n      letter-spacing: -.15px;\n    }\n\n    .hero-buttons {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 12px;\n      margin-top: 30px;\n    }\n\n    .button {\n      min-height: 47px;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: 10px;\n      padding: 0 18px;\n      border: 1px solid transparent;\n      border-radius: 8px;\n      font-size: 13px;\n      font-weight: 700;\n      transition: .2s ease;\n    }\n\n    .button-primary {\n      background: var(--forest);\n      color: white;\n    }\n\n    .button-primary:hover {\n      background: #2a3c32;\n      transform: translateY(-2px);\n    }\n\n    .button-secondary {\n      border-color: #d9dfd7;\n      background: rgba(255,255,255,.55);\n    }\n\n    .button-secondary:hover {\n      background: white;\n      border-color: #b4beb3;\n      transform: translateY(-2px);\n    }\n\n    .button svg { width: 16px; height: 16px; }\n\n    .hero-note {\n      display: flex;\n      align-items: center;\n      gap: 9px;\n      margin-top: 24px;\n      color: #818a83;\n      font-size: 11px;\n    }\n\n    .hero-note svg { width: 14px; height: 14px; color: #628c4b; }\n\n    .demo {\n      position: relative;\n      min-width: 0;\n      padding: 12px;\n      overflow: hidden;\n      border: 1px solid rgba(255,255,255,.09);\n      border-radius: 15px;\n      background: #17211d;\n      box-shadow: 0 28px 70px rgba(30, 43, 35, .20), 0 4px 12px rgba(30,43,35,.08);\n    }\n\n    .demo::before {\n      position: absolute;\n      top: -120px;\n      right: -95px;\n      width: 330px;\n      height: 330px;\n      border-radius: 50%;\n      background: rgba(185,242,118,.08);\n      filter: blur(45px);\n      content: \"\";\n      pointer-events: none;\n    }\n\n    .demo-top {\n      position: relative;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 7px 8px 15px;\n      color: #aab7ae;\n      font-size: 10px;\n      letter-spacing: .2px;\n    }\n\n    .window-dots { display: flex; gap: 5px; }\n    .window-dots i { width: 7px; height: 7px; border-radius: 50%; background: #526057; }\n    .window-dots i:first-child { background: #e18d77; }\n    .window-dots i:nth-child(2) { background: #d9b76b; }\n    .window-dots i:nth-child(3) { background: #84b76f; }\n\n    .demo-top-label {\n      position: absolute;\n      left: 50%;\n      transform: translateX(-50%);\n      font-family: var(--mono);\n      color: #809087;\n    }\n\n    .live {\n      display: inline-flex;\n      align-items: center;\n      gap: 6px;\n      color: #a9d77f;\n      font-family: var(--mono);\n      font-size: 9px;\n      text-transform: uppercase;\n    }\n\n    .live::before {\n      width: 6px;\n      height: 6px;\n      border-radius: 50%;\n      background: #a9d77f;\n      content: \"\";\n      box-shadow: 0 0 9px rgba(169,215,127,.7);\n    }\n\n    .editor {\n      position: relative;\n      overflow: hidden;\n      border: 1px solid #34423a;\n      border-radius: 9px;\n      background: #1e2b25;\n    }\n\n    .editor-tabs {\n      height: 36px;\n      display: flex;\n      align-items: center;\n      gap: 20px;\n      padding: 0 14px;\n      border-bottom: 1px solid #34423a;\n      color: #829187;\n      font-size: 10px;\n    }\n\n    .editor-tabs span:first-child {\n      height: 100%;\n      display: inline-flex;\n      align-items: center;\n      border-bottom: 1px solid var(--green);\n      color: #e1e9e0;\n    }\n\n    .query {\n      display: flex;\n      gap: 16px;\n      min-height: 156px;\n      padding: 18px 17px 16px;\n      font: 11px/1.9 var(--mono);\n    }\n\n    .line-numbers {\n      color: #58695e;\n      text-align: right;\n      user-select: none;\n    }\n\n    .sql { color: #d5dfd6; white-space: pre; }\n    .sql .kw { color: #b9f276; }\n    .sql .fn { color: #85c9d2; }\n    .sql .str { color: #e3bc7d; }\n    .sql .comment { color: #74847a; }\n\n    .result {\n      margin: 0 10px 10px;\n      overflow: hidden;\n      border: 1px solid #34423a;\n      border-radius: 7px;\n      background: #1a2620;\n    }\n\n    .result-heading {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 11px 13px;\n      border-bottom: 1px solid #34423a;\n      color: #9eada2;\n      font-size: 9px;\n      letter-spacing: .35px;\n      text-transform: uppercase;\n    }\n\n    .result-heading span:last-child {\n      color: #829187;\n      font-family: var(--mono);\n      letter-spacing: 0;\n      text-transform: none;\n    }\n\n    .chart-wrap { padding: 10px 12px 7px; }\n\n    .chart-legend {\n      display: flex;\n      justify-content: space-between;\n      margin-bottom: 7px;\n      color: #8b9a90;\n      font: 9px var(--mono);\n    }\n\n    .chart-legend span:first-child {\n      display: inline-flex;\n      align-items: center;\n      gap: 6px;\n    }\n\n    .chart-legend i {\n      width: 7px;\n      height: 7px;\n      display: inline-block;\n      border-radius: 2px;\n      background: var(--green);\n    }\n\n    .chart {\n      width: 100%;\n      height: 86px;\n      display: block;\n    }\n\n    .demo-foot {\n      display: flex;\n      justify-content: space-between;\n      padding: 11px 9px 2px;\n      color: #738177;\n      font: 9px var(--mono);\n    }\n\n    .demo-foot strong { color: #b9f276; font-weight: 500; }\n\n    .trust-row {\n      display: flex;\n      align-items: center;\n      gap: 25px;\n      padding: 24px 0;\n      border-top: 1px solid var(--line);\n      border-bottom: 1px solid var(--line);\n      color: #78827b;\n      font-size: 11px;\n    }\n\n    .trust-label {\n      flex: 0 0 auto;\n      color: #69736c;\n      font-size: 10px;\n      font-weight: 700;\n      letter-spacing: 1px;\n      text-transform: uppercase;\n    }\n\n    .trust-items {\n      width: 100%;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 16px;\n    }\n\n    .trust-items span {\n      display: inline-flex;\n      align-items: center;\n      gap: 7px;\n      color: #748077;\n      font-weight: 660;\n      letter-spacing: -.2px;\n      white-space: nowrap;\n    }\n\n    .trust-items svg { width: 16px; height: 16px; color: #89948b; }\n\n    .section {\n      padding: 104px 0;\n    }\n\n    .section-heading {\n      max-width: 600px;\n      margin-bottom: 42px;\n    }\n\n    .section-heading .eyebrow { margin-bottom: 14px; }\n\n    h2 {\n      margin: 0;\n      font-size: clamp(34px, 4vw, 49px);\n      line-height: 1.08;\n      letter-spacing: -2.7px;\n      font-weight: 640;\n    }\n\n    .section-heading p {\n      max-width: 470px;\n      margin: 15px 0 0;\n      color: var(--muted);\n      font-size: 15px;\n      line-height: 1.7;\n    }\n\n    .feature-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 14px;\n    }\n\n    .feature {\n      min-height: 225px;\n      padding: 24px;\n      border: 1px solid var(--line);\n      border-radius: 11px;\n      background: rgba(255,255,255,.47);\n      transition: .2s ease;\n    }\n\n    .feature:hover {\n      transform: translateY(-3px);\n      border-color: #cad5c6;\n      background: white;\n    }\n\n    .feature-icon {\n      width: 37px;\n      height: 37px;\n      display: grid;\n      place-items: center;\n      margin-bottom: 27px;\n      border: 1px solid #dce5d6;\n      border-radius: 9px;\n      background: #eef4e9;\n      color: #547742;\n    }\n\n    .feature-icon svg { width: 18px; height: 18px; }\n\n    .feature h3 {\n      margin: 0 0 8px;\n      font-size: 16px;\n      letter-spacing: -.4px;\n    }\n\n    .feature p {\n      max-width: 290px;\n      margin: 0;\n      color: #727d74;\n      font-size: 13px;\n      line-height: 1.65;\n    }\n\n    .build {\n      padding: 68px 0;\n      background: var(--forest);\n      color: white;\n    }\n\n    .build-inner {\n      display: grid;\n      grid-template-columns: 1fr .9fr;\n      gap: 70px;\n      align-items: center;\n    }\n\n    .build .eyebrow { color: #b9df97; }\n    .build h2 { max-width: 480px; margin-top: 17px; }\n    .build-copy {\n      max-width: 455px;\n      margin: 16px 0 0;\n      color: #b4c0b7;\n      font-size: 14px;\n      line-height: 1.75;\n    }\n\n    .build .button-primary {\n      margin-top: 25px;\n      background: var(--green);\n      color: #17221c;\n    }\n\n    .build .button-primary:hover { background: #c8fa91; }\n\n    .terminal {\n      overflow: hidden;\n      border: 1px solid #3c4b41;\n      border-radius: 11px;\n      background: #111a15;\n      box-shadow: 0 20px 45px rgba(0,0,0,.18);\n    }\n\n    .terminal-head {\n      display: flex;\n      align-items: center;\n      gap: 6px;\n      height: 39px;\n      padding: 0 14px;\n      border-bottom: 1px solid #2d3b32;\n    }\n\n    .terminal-head i {\n      width: 7px;\n      height: 7px;\n      border-radius: 50%;\n      background: #56655b;\n    }\n\n    .terminal-head i:first-child { background: #e18d77; }\n    .terminal-head i:nth-child(2) { background: #d9b76b; }\n    .terminal-head i:nth-child(3) { background: #84b76f; }\n\n    .terminal-body {\n      padding: 20px 21px 23px;\n      color: #d0dbd1;\n      font: 12px/2 var(--mono);\n    }\n\n    .terminal-body .muted { color: #708176; }\n    .terminal-body .prompt { color: var(--green); }\n    .terminal-body .success { color: #a9d77f; }\n\n    .final-cta {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 24px;\n      padding: 71px 0;\n    }\n\n    .final-cta h2 {\n      max-width: 550px;\n      font-size: clamp(31px, 4vw, 43px);\n    }\n\n    .final-cta p {\n      margin: 11px 0 0;\n      color: var(--muted);\n      font-size: 14px;\n    }\n\n    .final-cta .button { flex: 0 0 auto; }\n\n    footer {\n      border-top: 1px solid var(--line);\n      color: #78827b;\n      font-size: 11px;\n    }\n\n    .footer-inner {\n      min-height: 69px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 20px;\n    }\n\n    .footer-brand {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      color: #5d6960;\n      font-weight: 700;\n    }\n\n    .footer-brand .brand-mark {\n      width: 22px;\n      height: 22px;\n      border-radius: 6px;\n    }\n\n    .footer-brand .brand-mark svg { width: 15px; height: 15px; }\n\n    .footer-links { display: flex; gap: 23px; }\n    .footer-links a:hover { color: var(--ink); }\n\n    @media (max-width: 900px) {\n      .hero {\n        grid-template-columns: 1fr;\n        gap: 42px;\n        padding-top: 62px;\n      }\n\n      .hero-copy { max-width: 580px; }\n      .demo { width: min(100%, 650px); }\n      .build-inner { gap: 38px; }\n      .trust-row { align-items: flex-start; flex-direction: column; gap: 15px; }\n    }\n\n    @media (max-width: 650px) {\n      .wrap { width: min(100% - 36px, 500px); }\n      .nav { height: 68px; }\n      .nav-links { display: none; }\n      .nav-action { padding: 9px 11px; font-size: 12px; }\n      .hero { padding: 53px 0 55px; gap: 34px; }\n      h1 { font-size: clamp(46px, 13vw, 64px); letter-spacing: -3.8px; }\n      .hero-copy { font-size: 15px; }\n      .demo { padding: 8px; border-radius: 12px; }\n      .query { font-size: 9px; gap: 11px; padding: 14px 11px; }\n      .result { margin-inline: 6px; }\n      .trust-items {\n        display: grid;\n        grid-template-columns: repeat(2, 1fr);\n        justify-content: start;\n        gap: 13px;\n      }\n      .section { padding: 73px 0; }\n      .feature-grid { grid-template-columns: 1fr; }\n      .feature { min-height: unset; padding: 21px; }\n      .feature-icon { margin-bottom: 19px; }\n      .build { padding: 58px 0; }\n      .build-inner { grid-template-columns: 1fr; gap: 32px; }\n      .terminal-body { font-size: 10px; padding: 16px; }\n      .final-cta { align-items: flex-start; flex-direction: column; padding: 56px 0; }\n      .footer-inner { align-items: flex-start; flex-direction: column; padding: 20px 0; }\n      .footer-links { gap: 17px; flex-wrap: wrap; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      html { scroll-behavior: auto; }\n      *, *::before, *::after { transition-duration: .01ms !important; }\n    }\n  </style>\n</head>\n<body>\n  <header class=\"wrap\">\n    <nav class=\"nav\" aria-label=\"Main navigation\">\n      <a class=\"brand\" href=\"#\" aria-label=\"Fjord home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M4 7.5 12 3l8 4.5v9L12 21l-8-4.5v-9Z\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linejoin=\"round\"/>\n            <path d=\"m4.5 8 7.5 4.3L19.5 8M12 12.5V20\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linejoin=\"round\"/>\n          </svg>\n        </span>\n        fjord\n      </a>\n\n      <div class=\"nav-links\">\n        <a href=\"#features\">Why Fjord</a>\n        <a href=\"#get-started\">Get started</a>\n        <a href=\"#community\">Community</a>\n      </div>\n\n      <a class=\"nav-action\" href=\"https://github.com/\" aria-label=\"View Fjord on GitHub\">\n        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\">\n          <path d=\"M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.53v-2.07c-3.1.68-3.76-1.32-3.76-1.32-.5-1.3-1.24-1.65-1.24-1.65-1.01-.69.08-.68.08-.68 1.12.08 1.7 1.15 1.7 1.15.99 1.69 2.6 1.2 3.23.91.1-.71.39-1.2.71-1.48-2.47-.28-5.06-1.24-5.06-5.5 0-1.21.43-2.2 1.15-2.98-.11-.28-.5-1.41.11-2.94 0 0 .94-.3 3.05 1.14a10.6 10.6 0 0 1 5.56 0c2.12-1.44 3.05-1.14 3.05-1.14.61 1.53.23 2.66.11 2.94.72.78 1.15 1.77 1.15 2.98 0 4.27-2.6 5.21-5.08 5.49.4.35.76 1.02.76 2.06V22c0 .29.2.64.77.53A11.1 11.1 0 0 0 12 .9Z\"/>\n        </svg>\n        Star on GitHub\n      </a>\n    </nav>\n  </header>\n\n  <main>\n    <section class=\"wrap hero\">\n      <div>\n        <div class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> Open-source analytical database</div>\n        <h1>Make your data<br>work <span>harder.</span></h1>\n        <p class=\"hero-copy\">\n          Fjord is the open-source SQL database built for data teams.\n          Query fast, keep your stack simple, and stay in control of your data.\n        </p>\n        <div class=\"hero-buttons\">\n          <a class=\"button button-primary\" href=\"#get-started\">\n            Get started\n            <svg viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 10h11m-4-4 4 4-4 4\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          </a>\n          <a class=\"button button-secondary\" href=\"https://github.com/\">\n            <svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.53v-2.07c-3.1.68-3.76-1.32-3.76-1.32-.5-1.3-1.24-1.65-1.24-1.65-1.01-.69.08-.68.08-.68 1.12.08 1.7 1.15 1.7 1.15.99 1.69 2.6 1.2 3.23.91.1-.71.39-1.2.71-1.48-2.47-.28-5.06-1.24-5.06-5.5 0-1.21.43-2.2 1.15-2.98-.11-.28-.5-1.41.11-2.94 0 0 .94-.3 3.05 1.14a10.6 10.6 0 0 1 5.56 0c2.12-1.44 3.05-1.14 3.05-1.14.61 1.53.23 2.66.11 2.94.72.78 1.15 1.77 1.15 2.98 0 4.27-2.6 5.21-5.08 5.49.4.35.76 1.02.76 2.06V22c0 .29.2.64.77.53A11.1 11.1 0 0 0 12 .9Z\"/></svg>\n            Explore the project\n          </a>\n        </div>\n        <div class=\"hero-note\">\n          <svg viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\"><path d=\"m5 10 3.2 3.2L15 6.5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"10\" cy=\"10\" r=\"8\" stroke=\"currentColor\" stroke-width=\"1.4\"/></svg>\n          Free forever. Open source by design.\n        </div>\n      </div>\n\n      <div class=\"demo\" aria-label=\"Fjord SQL query interface preview\">\n        <div class=\"demo-top\">\n          <div class=\"window-dots\" aria-hidden=\"true\"><i></i><i></i><i></i></div>\n          <span class=\"demo-top-label\">fjord / analytics</span>\n          <span class=\"live\">connected</span>\n        </div>\n\n        <div class=\"editor\">\n          <div class=\"editor-tabs\"><span>query.sql</span><span>schema</span><span>history</span></div>\n          <div class=\"query\">\n            <div class=\"line-numbers\">1<br>2<br>3<br>4<br>5</div>\n            <div class=\"sql\"><span class=\"comment\">-- daily events, by source</span>\n<span class=\"kw\">SELECT</span> date_trunc(<span class=\"str\">'day'</span>, created_at) <span class=\"kw\">AS</span> day,\n       source,\n       <span class=\"fn\">count</span>(*) <span class=\"kw\">AS</span> events\n<span class=\"kw\">FROM</span> product_events\n<span class=\"kw\">GROUP BY</span> 1, 2 <span class=\"kw\">ORDER BY</span> 1;</div>\n          </div>\n        </div>\n\n        <div class=\"result\">\n          <div class=\"result-heading\"><span>Query results</span><span>1,284 rows \u00b7 42ms</span></div>\n          <div class=\"chart-wrap\">\n            <div class=\"chart-legend\"><span><i></i> Events per day</span><span>Last 14 days</span></div>\n            <svg class=\"chart\" viewBox=\"0 0 520 100\" preserveAspectRatio=\"none\" role=\"img\" aria-label=\"A rising chart of daily events\">\n              <defs>\n                <linearGradient id=\"fill\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\">\n                  <stop offset=\"0\" stop-color=\"#b9f276\" stop-opacity=\".25\"/>\n                  <stop offset=\"1\" stop-color=\"#b9f276\" stop-opacity=\"0\"/>\n                </linearGradient>\n              </defs>\n              <path d=\"M0 78H520M0 52H520M0 26H520\" stroke=\"#35443a\" stroke-width=\"1\" stroke-dasharray=\"3 5\"/>\n              <path d=\"M0 77 38 69 77 73 116 50 155 58 194 41 233 48 272 34 311 44 350 23 389 32 428 14 467 20 520 7V100H0Z\" fill=\"url(#fill)\"/>\n              <path d=\"M0 77 38 69 77 73 116 50 155 58 194 41 233 48 272 34 311 44 350 23 389 32 428 14 467 20 520 7\" fill=\"none\" stroke=\"#b9f276\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              <circle cx=\"520\" cy=\"7\" r=\"3.2\" fill=\"#b9f276\"/>\n            </svg>\n            <div class=\"demo-foot\"><span>JUN 01 <span style=\"padding-left:105px\">JUN 07</span></span><strong>\u2191 18.6% vs. prior period</strong></div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"wrap trust-row\" aria-label=\"Built for your data stack\">\n      <div class=\"trust-label\">Fits your stack</div>\n      <div class=\"trust-items\">\n        <span><svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M5 5h14v14H5zM8 9h8M8 12h8M8 15h5\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg>PostgreSQL wire</span>\n        <span><svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 7h16M4 12h10M4 17h13\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/><circle cx=\"18\" cy=\"12\" r=\"2\" stroke=\"currentColor\" stroke-width=\"1.5\"/></svg>Standard SQL</span>\n        <span><svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 6h16v12H4zM8 10h8M8 14h5\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Your favorite tools</span>\n        <span><svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M12 3v18M3 12h18M5.6 5.6l12.8 12.8m0-12.8L5.6 18.4\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg>Open source</span>\n      </div>\n    </section>\n\n    <section class=\"wrap section\" id=\"features\">\n      <div class=\"section-heading\">\n        <div class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> Less plumbing, more progress</div>\n        <h2>Made for the people<br>who move data.</h2>\n        <p>Keep the familiar parts of your workflow. Lose the friction between your data and the answers you need.</p>\n      </div>\n\n      <div class=\"feature-grid\">\n        <article class=\"feature\">\n          <div class=\"feature-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 18V6m0 12h16M7 15l3-4 3 2 5-7\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"18\" cy=\"6\" r=\"1.4\" fill=\"currentColor\"/></svg>\n          </div>\n          <h3>Analytical by nature</h3>\n          <p>Run the queries your team actually asks. Fjord is designed for exploration across growing datasets.</p>\n        </article>\n\n        <article class=\"feature\">\n          <div class=\"feature-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M12 3 4.5 6v5.2c0 4.5 3.1 7.8 7.5 9.8 4.4-2 7.5-5.3 7.5-9.8V6L12 3Z\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"/><path d=\"m9 12 2 2 4-4\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          </div>\n          <h3>Your data stays yours</h3>\n          <p>Self-host it, inspect it, change it. An open codebase means no black boxes and no lock-in.</p>\n        </article>\n\n        <article class=\"feature\">\n          <div class=\"feature-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"m8 8-4 4 4 4m8-8 4 4-4 4m-3-11-2 14\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          </div>\n          <h3>SQL you already know</h3>\n          <p>Work in familiar SQL and connect through standard interfaces. Keep your existing tools in the loop.</p>\n        </article>\n      </div>\n    </section>\n\n    <section class=\"build\" id=\"get-started\">\n      <div class=\"wrap build-inner\">\n        <div>\n          <div class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> Up and running in minutes</div>\n          <h2>One command to a better data workflow.</h2>\n          <p class=\"build-copy\">Start locally, bring your own data, and build from there. Fjord is made to feel at home in your development workflow.</p>\n          <a class=\"button button-primary\" href=\"https://github.com/\">\n            Read the quickstart\n            <svg viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 10h11m-4-4 4 4-4 4\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          </a>\n        </div>\n\n        <div class=\"terminal\" aria-label=\"Example Fjord installation commands\">\n          <div class=\"terminal-head\"><i></i><i></i><i></i></div>\n          <div class=\"terminal-body\">\n            <div><span class=\"muted\"># install Fjord</span></div>\n            <div><span class=\"prompt\">$</span> curl -fsSL fjord.dev/install | sh</div>\n            <br>\n            <div><span class=\"muted\"># start a local instance</span></div>\n            <div><span class=\"prompt\">$</span> fjord start</div>\n            <div class=\"success\">\u2713 Fjord is ready at localhost:5432</div>\n            <div><span class=\"prompt\">$</span> fjord query \"SELECT 'hello, data';\"</div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"wrap final-cta\" id=\"community\">\n      <div>\n        <h2>Good data tools are built together.</h2>\n        <p>Join the open-source community shaping what Fjord becomes next.</p>\n      </div>\n      <a class=\"button button-primary\" href=\"https://github.com/\">\n        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.53v-2.07c-3.1.68-3.76-1.32-3.76-1.32-.5-1.3-1.24-1.65-1.24-1.65-1.01-.69.08-.68.08-.68 1.12.08 1.7 1.15 1.7 1.15.99 1.69 2.6 1.2 3.23.91.1-.71.39-1.2.71-1.48-2.47-.28-5.06-1.24-5.06-5.5 0-1.21.43-2.2 1.15-2.98-.11-.28-.5-1.41.11-2.94 0 0 .94-.3 3.05 1.14a10.6 10.6 0 0 1 5.56 0c2.12-1.44 3.05-1.14 3.05-1.14.61 1.53.23 2.66.11 2.94.72.78 1.15 1.77 1.15 2.98 0 4.27-2.6 5.21-5.08 5.49.4.35.76 1.02.76 2.06V22c0 .29.2.64.77.53A11.1 11.1 0 0 0 12 .9Z\"/></svg>\n        Visit us on GitHub\n      </a>\n    </section>\n  </main>\n\n  <footer>\n    <div class=\"wrap footer-inner\">\n      <a class=\"footer-brand\" href=\"#\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M4 7.5 12 3l8 4.5v9L12 21l-8-4.5v-9Z\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linejoin=\"round\"/><path d=\"m4.5 8 7.5 4.3L19.5 8M12 12.5V20\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linejoin=\"round\"/></svg>\n        </span>\n        Fjord\n      </a>\n      <span>Open source. Built for data people.</span>\n      <div class=\"footer-links\">\n        <a href=\"#get-started\">Docs</a>\n        <a href=\"https://github.com/\">GitHub</a>\n        <a href=\"#community\">Community</a>\n      </div>\n    </div>\n  </footer>\n</body>\n</html>\n"}