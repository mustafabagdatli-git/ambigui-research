{"arm": "direct", "model": "z-ai/glm-5.3-flashx", "i": 1, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Tidepool \u2014 Plan your week together</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Instrument+Sans:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --sand:#F6F1E7;\n    --sand-deep:#EDE5D5;\n    --ink:#0E3A38;\n    --ink-soft:#3E5F5C;\n    --coral:#E0592F;\n    --kelp:#2E7D6B;\n    --seafoam:#BFD9CE;\n    --amber:#D9A441;\n    --line:rgba(14,58,56,.14);\n  }\n  *{margin:0;padding:0;box-sizing:border-box}\n  html{scroll-behavior:smooth}\n  body{\n    background:var(--sand);\n    color:var(--ink);\n    font-family:'Instrument Sans',sans-serif;\n    font-size:17px;\n    line-height:1.6;\n    overflow-x:hidden;\n  }\n  ::selection{background:var(--coral);color:var(--sand)}\n  h1,h2,h3,.serif{font-family:'Fraunces',serif}\n\n  /* ---------- nav ---------- */\n  nav{\n    position:fixed;top:0;left:0;right:0;z-index:50;\n    display:flex;align-items:center;justify-content:space-between;\n    padding:20px clamp(24px,5vw,64px);\n    transition:background .3s,box-shadow .3s,padding .3s;\n  }\n  nav.scrolled{background:rgba(246,241,231,.9);backdrop-filter:blur(12px);box-shadow:0 1px 0 var(--line);padding:14px clamp(24px,5vw,64px)}\n  .logo{display:flex;align-items:center;gap:10px;font-family:'Fraunces',serif;font-weight:600;font-size:22px;letter-spacing:-.01em}\n  .logo svg{display:block}\n  .nav-links{display:flex;align-items:center;gap:32px;font-size:15px;font-weight:500}\n  .nav-links a{color:var(--ink);text-decoration:none;position:relative}\n  .nav-links a:not(.btn)::after{content:'';position:absolute;left:0;bottom:-4px;width:0;height:2px;background:var(--coral);transition:width .25s}\n  .nav-links a:not(.btn):hover::after{width:100%}\n  .btn{\n    display:inline-block;padding:11px 22px;border-radius:999px;\n    background:var(--ink);color:var(--sand);text-decoration:none;\n    font-weight:600;font-size:15px;border:1.5px solid var(--ink);\n    transition:transform .2s,background .2s,color .2s;cursor:pointer;\n  }\n  .btn:hover{background:var(--coral);border-color:var(--coral);transform:translateY(-2px)}\n  .btn.ghost{background:transparent;color:var(--ink)}\n  .btn.ghost:hover{background:var(--ink);color:var(--sand)}\n  @media(max-width:720px){.nav-links a:not(.btn){display:none}}\n\n  /* ---------- hero ---------- */\n  .hero{\n    position:relative;min-height:100vh;\n    display:flex;flex-direction:column;justify-content:center;\n    padding:140px clamp(24px,5vw,64px) 220px;\n  }\n  .hero-eyebrow{\n    display:inline-flex;align-items:center;gap:10px;\n    font-size:13px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;\n    color:var(--kelp);margin-bottom:28px;\n  }\n  .hero-eyebrow::before{content:'';width:32px;height:2px;background:var(--kelp)}\n  .hero h1{\n    font-size:clamp(44px,7.2vw,96px);\n    font-weight:400;line-height:1.02;letter-spacing:-.02em;\n    max-width:12ch;\n  }\n  .hero h1 em{font-style:italic;color:var(--coral);font-weight:340}\n  .hero-sub{\n    margin-top:28px;max-width:44ch;font-size:19px;color:var(--ink-soft);\n  }\n  .hero-cta{margin-top:38px;display:flex;gap:16px;flex-wrap:wrap;align-items:center}\n  .hero-note{font-size:14px;color:var(--ink-soft);opacity:.8}\n  .hero-wave{position:absolute;left:0;right:0;bottom:0;height:220px;pointer-events:none}\n  .hero-wave canvas{width:100%;height:100%;display:block}\n  .hero-hint{\n    position:absolute;bottom:26px;left:50%;transform:translateX(-50%);\n    font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--seafoam);\n    z-index:2;\n  }\n  @media(max-width:720px){.hero{padding-bottom:170px}}\n\n  /* ---------- ticker ---------- */\n  .ticker{\n    background:var(--ink);color:var(--sand);overflow:hidden;\n    padding:14px 0;border-top:1px solid rgba(246,241,231,.12);\n  }\n  .ticker-track{display:flex;gap:0;width:max-content;animation:tick 38s linear infinite}\n  .ticker:hover .ticker-track{animation-play-state:paused}\n  .ticker span{display:inline-flex;align-items:center;gap:14px;padding:0 28px;font-size:14px;white-space:nowrap;opacity:.85}\n  .ticker b{color:var(--amber);font-weight:600}\n  .dot{width:6px;height:6px;border-radius:50%;background:var(--coral);flex:none}\n  @keyframes tick{to{transform:translateX(-50%)}}\n\n  section{padding:clamp(80px,10vw,140px) clamp(24px,5vw,64px)}\n  .kicker{font-size:13px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--coral);margin-bottom:18px}\n\n  /* ---------- planner mock ---------- */\n  .planner-sec{background:var(--sand)}\n  .sec-head{max-width:820px;margin:0 auto clamp(48px,6vw,80px);text-align:center}\n  .sec-head h2{font-size:clamp(32px,4.4vw,54px);font-weight:400;letter-spacing:-.02em;line-height:1.1}\n  .sec-head h2 em{font-style:italic;color:var(--kelp)}\n  .sec-head p{margin-top:18px;color:var(--ink-soft);font-size:18px}\n\n  .board{\n    max-width:1080px;margin:0 auto;\n    background:#FFFDF8;border:1px solid var(--line);border-radius:20px;\n    box-shadow:0 30px 80px -30px rgba(14,58,56,.25), 0 4px 14px rgba(14,58,56,.06);\n    overflow:hidden;\n  }\n  .board-top{\n    display:flex;align-items:center;justify-content:space-between;\n    padding:18px 24px;border-bottom:1px solid var(--line);\n  }\n  .board-top .wk{font-family:'Fraunces',serif;font-size:18px;font-weight:600}\n  .avatars{display:flex}\n  .avatar{\n    width:32px;height:32px;border-radius:50%;display:grid;place-items:center;\n    font-size:12px;font-weight:600;color:#fff;border:2px solid #FFFDF8;margin-left:-8px;\n  }\n  .board-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:1px;background:var(--line)}\n  @media(max-width:860px){.board-grid{grid-template-columns:repeat(2,1fr)}.board-col:nth-child(5){grid-column:1/-1}}\n  @media(max-width:520px){.board-grid{grid-template-columns:1fr}}\n  .board-col{background:#FFFDF8;padding:16px 14px 20px;min-height:300px;transition:background .25s}\n  .board-col:hover{background:#FBF7EE}\n  .col-day{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:14px}\n  .col-day .d{font-family:'Fraunces',serif;font-weight:600;font-size:16px}\n  .col-day .n{font-size:12px;color:var(--ink-soft);opacity:.7}\n  .board-col.today .d{color:var(--coral)}\n  .card{\n    background:var(--sand);border-radius:10px;padding:11px 12px;margin-bottom:10px;\n    border-left:3px solid var(--kelp);font-size:13.5px;line-height:1.45;\n    transition:transform .2s,box-shadow .2s;cursor:default;\n  }\n  .card:hover{transform:translateY(-3px) rotate(-.5deg);box-shadow:0 8px 20px rgba(14,58,56,.12)}\n  .card .who{display:flex;align-items:center;gap:7px;margin-top:9px;font-size:11.5px;color:var(--ink-soft)}\n  .card .who i{width:18px;height:18px;border-radius:50%;display:grid;place-items:center;font-style:normal;font-size:9px;font-weight:600;color:#fff}\n  .card.coral{border-left-color:var(--coral)}\n  .card.amber{border-left-color:var(--amber)}\n  .card.done{opacity:.55;text-decoration:line-through}\n  .tag{display:inline-block;font-size:10px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--kelp);background:rgba(46,125,107,.1);padding:2px 7px;border-radius:99px;margin-bottom:6px}\n  .tag.hot{color:var(--coral);background:rgba(224,89,47,.1)}\n  .float-note{\n    max-width:1080px;margin:22px auto 0;display:flex;justify-content:flex-end;\n    font-size:14px;color:var(--ink-soft);font-style:italic;\n  }\n\n  /* ---------- how it works ---------- */\n  .how{background:var(--ink);color:var(--sand)}\n  .how .kicker{color:var(--amber)}\n  .how-grid{max-width:1080px;margin:0 auto}\n  .how-row{\n    display:grid;grid-template-columns:110px 1fr 1.1fr;gap:32px;align-items:start;\n    padding:44px 0;border-top:1px solid rgba(246,241,231,.15);\n  }\n  .how-row:last-child{border-bottom:1px solid rgba(246,241,231,.15)}\n  .how-num{font-family:'Fraunces',serif;font-size:52px;font-weight:300;font-style:italic;color:var(--coral);line-height:1}\n  .how-row h3{font-size:26px;font-weight:500;letter-spacing:-.01em}\n  .how-row p{color:rgba(246,241,231,.72);font-size:16px;margin-top:10px}\n  .how-visual{background:rgba(246,241,231,.06);border:1px solid rgba(246,241,231,.14);border-radius:14px;padding:20px;min-height:150px}\n  @media(max-width:860px){.how-row{grid-template-columns:64px 1fr}.how-visual{grid-column:2;margin-top:6px}.how-num{font-size:36px}}\n\n  /* small inline visuals */\n  .viz-tide{height:110px;position:relative}\n  .viz-tide svg{width:100%;height:100%}\n  .viz-check{display:flex;flex-direction:column;gap:10px;font-size:14px}\n  .viz-check div{display:flex;align-items:center;gap:10px;color:rgba(246,241,231,.85)}\n  .viz-check svg{flex:none}\n  .viz-pulse{display:flex;align-items:flex-end;gap:6px;height:100%;min-height:110px}\n  .viz-pulse i{flex:1;background:linear-gradient(to top,var(--kelp),var(--seafoam));border-radius:4px 4px 0 0;animation:pulse 2.6s ease-in-out infinite}\n  .viz-pulse i:nth-child(2){animation-delay:.2s}.viz-pulse i:nth-child(3){animation-delay:.4s}\n  .viz-pulse i:nth-child(4){animation-delay:.6s}.viz-pulse i:nth-child(5){animation-delay:.8s}\n  .viz-pulse i:nth-child(6){animation-delay:1s}.viz-pulse i:nth-child(7){animation-delay:1.2s;background:linear-gradient(to top,var(--coral),var(--amber))}\n  @keyframes pulse{0%,100%{transform:scaleY(.55)}50%{transform:scaleY(1)}}\n\n  /* ---------- rhythm chart ---------- */\n  .rhythm-sec{background:var(--sand-deep)}\n  .rhythm-wrap{max-width:1080px;margin:0 auto;display:grid;grid-template-columns:1fr 1.4fr;gap:clamp(32px,5vw,72px);align-items:center}\n  @media(max-width:860px){.rhythm-wrap{grid-template-columns:1fr}}\n  .rhythm-copy h2{font-size:clamp(30px,4vw,48px);font-weight:400;letter-spacing:-.02em;line-height:1.12}\n  .rhythm-copy h2 em{font-style:italic;color:var(--coral)}\n  .rhythm-copy p{margin-top:18px;color:var(--ink-soft)}\n  .chart-card{background:#FFFDF8;border:1px solid var(--line);border-radius:18px;padding:26px;box-shadow:0 20px 50px -24px rgba(14,58,56,.28)}\n  .chart-card h4{font-size:14px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:16px;display:flex;justify-content:space-between;align-items:center}\n  .legend{display:flex;gap:14px;font-size:11px;text-transform:none;letter-spacing:0}\n  .legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:5px;vertical-align:-1px}\n  #rhythmChart{width:100%;height:auto;display:block}\n  .bar-rect{transition:opacity .2s;cursor:pointer}\n  .bar-rect:hover{opacity:.75}\n\n  /* ---------- quote ---------- */\n  .quote-sec{text-align:center;background:var(--sand)}\n  blockquote{\n    max-width:820px;margin:0 auto;font-family:'Fraunces',serif;\n    font-size:clamp(26px,3.6vw,42px);font-weight:340;line-height:1.3;letter-spacing:-.01em;\n  }\n  blockquote em{font-style:italic;color:var(--coral)}\n  .attrib{margin-top:28px;display:flex;align-items:center;justify-content:center;gap:14px;font-size:15px;color:var(--ink-soft)}\n  .attrib .avatar{margin:0;border:none;width:40px;height:40px;font-size:14px}\n\n  /* ---------- cta ---------- */\n  .cta-sec{\n    background:var(--ink);color:var(--sand);text-align:center;position:relative;overflow:hidden;\n    padding-top:clamp(100px,12vw,160px);padding-bottom:clamp(100px,12vw,160px);\n  }\n  .cta-sec h2{font-size:clamp(38px,5.6vw,72px);font-weight:400;letter-spacing:-.02em;line-height:1.05;max-width:16ch;margin:0 auto}\n  .cta-sec h2 em{font-style:italic;color:var(--amber)}\n  .cta-sec p{margin:24px auto 0;max-width:44ch;color:rgba(246,241,231,.72)}\n  .cta-sec .btn{background:var(--coral);border-color:var(--coral);margin-top:36px;font-size:17px;padding:15px 34px}\n  .cta-sec .btn:hover{background:var(--sand);border-color:var(--sand);color:var(--ink)}\n  .cta-wave{position:absolute;left:0;right:0;bottom:0;height:120px;opacity:.5;pointer-events:none}\n\n  /* ---------- footer ---------- */\n  footer{\n    background:var(--ink);color:rgba(246,241,231,.6);\n    padding:32px clamp(24px,5vw,64px);border-top:1px solid rgba(246,241,231,.12);\n    display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;font-size:14px;\n  }\n  footer .logo{color:var(--sand);font-size:18px}\n  footer a{color:rgba(246,241,231,.6);text-decoration:none;margin-left:22px}\n  footer a:hover{color:var(--sand)}\n\n  /* ---------- reveal ---------- */\n  .reveal{opacity:0;transform:translateY(28px);transition:opacity .8s cubic-bezier(.2,.7,.2,1),transform .8s cubic-bezier(.2,.7,.2,1)}\n  .reveal.in{opacity:1;transform:none}\n</style>\n</head>\n<body>\n\n<nav id=\"nav\">\n  <a class=\"logo\" href=\"#\" style=\"text-decoration:none;color:inherit\">\n    <svg width=\"26\" height=\"26\" viewBox=\"0 0 26 26\" fill=\"none\">\n      <circle cx=\"13\" cy=\"13\" r=\"11.5\" stroke=\"#0E3A38\" stroke-width=\"2\"/>\n      <path d=\"M2 15c3.5-3 6-3 9 0s6 3 9 0\" stroke=\"#E0592F\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n    </svg>\n    Tidepool\n  </a>\n  <div class=\"nav-links\">\n    <a href=\"#product\">Product</a>\n    <a href=\"#how\">How it works</a>\n    <a href=\"#rhythm\">Rhythm</a>\n    <a href=\"#\" class=\"btn\">Start free</a>\n  </div>\n</nav>\n\n<!-- ============ HERO ============ -->\n<header class=\"hero\">\n  <span class=\"hero-eyebrow\">Weekly planning for small teams</span>\n  <h1>Your week has a <em>rhythm.</em> Plan with it, not against it.</h1>\n  <p class=\"hero-sub\">Tidepool is a calm, fifteen-minute Monday ritual. Your team surfaces what matters, spreads the load, and lets the small stuff drift out with the tide.</p>\n  <div class=\"hero-cta\">\n    <a href=\"#\" class=\"btn\">Plan your first week \u2014 free</a>\n    <span class=\"hero-note\">No credit card \u00b7 Up to 10 people \u00b7 4-minute setup</span>\n  </div>\n  <div class=\"hero-wave\"><canvas id=\"waves\"></canvas></div>\n  <div class=\"hero-hint\">move your cursor across the water</div>\n</header>\n\n<!-- ============ TICKER ============ -->\n<div class=\"ticker\">\n  <div class=\"ticker-track\" id=\"tickerTrack\">\n    <span><i class=\"dot\"></i><b>Mira</b> moved \u201cPricing page rewrite\u201d to Thursday</span>\n    <span><i class=\"dot\"></i><b>Jonas</b> is at capacity Wednesday \u2014 2 offers to help</span>\n    <span><i class=\"dot\"></i><b>Team Kelp</b> finished their Monday sync in 11 minutes</span>\n    <span><i class=\"dot\"></i><b>Priya</b> dropped \u201cInbox zero\u201d \u2014 let it drift \ud83c\udf0a</span>\n    <span><i class=\"dot\"></i><b>Sam</b> claimed \u201cShip onboarding emails v2\u201d</span>\n  </div>\n</div>\n\n<!-- ============ PRODUCT MOCK ============ -->\n<section class=\"planner-sec\" id=\"product\">\n  <div class=\"sec-head reveal\">\n    <p class=\"kicker\">The board</p>\n    <h2>One shared page. <em>The whole week.</em></h2>\n    <p>Every person, every commitment, in one glance. Drag work between days, see who's overloaded before it happens \u2014 not after.</p>\n  </div>\n\n  <div class=\"board reveal\">\n    <div class=\"board-top\">\n      <span class=\"wk\">Week of Mar 10 \u2014 14</span>\n      <div class=\"avatars\">\n        <span class=\"avatar\" style=\"background:#E0592F\">MK</span>\n        <span class=\"avatar\" style=\"background:#2E7D6B\">JO</span>\n        <span class=\"avatar\" style=\"background:#D9A441\">PR</span>\n        <span class=\"avatar\" style=\"background:#0E3A38\">SA</span>\n      </div>\n    </div>\n    <div class=\"board-grid\">\n      <div class=\"board-col\">\n        <div class=\"col-day\"><span class=\"d\">Monday</span><span class=\"n\">10</span></div>\n        <div class=\"card\"><span class=\"tag hot\">Ritual</span><br>Team sync \u2014 15 min, cameras optional\n          <div class=\"who\"><i style=\"background:#0E3A38\">All</i>4 attending</div>\n        </div>\n        <div class=\"card coral\">Draft Q2 narrative for all-hands\n          <div class=\"who\"><i style=\"background:#E0592F\">MK</i>Mira \u00b7 deep work</div>\n        </div>\n      </div>\n      <div class=\"board-col\">\n        <div class=\"col-day\"><span class=\"d\">Tuesday</span><span class=\"n\">11</span></div>\n        <div class=\"card amber\">User interviews \u2014 3 sessions\n          <div class=\"who\"><i style=\"background:#D9A441\">PR</i>Priya</div>\n        </div>\n        <div class=\"card\">Fix flaky checkout tests\n          <div class=\"who\"><i style=\"background:#2E7D6B\">JO</i>Jonas \u00b7 ~2h</div>\n        </div>\n      </div>\n      <div class=\"board-col today\">\n        <div class=\"col-day\"><span class=\"d\">Wednesday</span><span class=\"n\">12 \u00b7 today</span></div>\n        <div class=\"card coral\">No-meeting morning \u2014 everyone\n          <div class=\"who\"><i style=\"background:#0E3A38\">All</i>team pledge</div>\n        </div>\n        <div class=\"card amber\">Onboarding emails v2 \u2014 ship\n          <div class=\"who\"><i style=\"background:#2E7D6B\">SA</i>Sam \u00b7 due 5pm</div>\n        </div>\n      </div>\n      <div class=\"board-col\">\n        <div class=\"col-day\"><span class=\"d\">Thursday</span><span class=\"n\">13</span></div>\n        <div class=\"card\">Pricing page rewrite\n          <div class=\"who\"><i style=\"background:#E0592F\">MK</i>Mira \u00b7 moved from Mon</div>\n        </div>\n        <div class=\"card done\">Send investor update\n          <div class=\"who\"><i style=\"background:#D9A441\">PR</i>Priya \u00b7 done \u2713</div>\n        </div>\n      </div>\n      <div class=\"board-col\">\n        <div class=\"col-day\"><span class=\"d\">Friday</span><span class=\"n\">14</span></div>\n        <div class=\"card amber\">Demo Friday \u2014 show your week\n          <div class=\"who\"><i style=\"background:#0E3A38\">All</i>4 sharing</div>\n        </div>\n        <div class=\"card\" style=\"border-left-style:dashed;opacity:.6;background:transparent\">Light afternoon \u2014 drift allowed\n          <div class=\"who\">\ud83c\udf0a protected focus time</div>\n        </div>\n      </div>\n    </div>\n  </div>\n  <div class=\"float-note reveal\">\u2014 this is the actual board. No kanban maze, no status theatre.</div>\n</section>\n\n<!-- ============ HOW ============ -->\n<section class=\"how\" id=\"how\">\n  <div class=\"how-grid\">\n    <p class=\"kicker reveal\">How the tide works</p>\n    <div class=\"sec-head reveal\" style=\"text-align:left;margin-left:0;max-width:640px\">\n      <h2 style=\"color:var(--sand)\">Three small rituals. <em style=\"color:var(--amber)\">Fifteen minutes a week.</em></h2>\n    </div>\n\n    <div class=\"how-row reveal\">\n      <div class=\"how-num\">01</div>\n      <div><h3>Monday, the tide comes in</h3><p>Everyone adds their week in two minutes. Tidepool nudges you: what's realistic, what can wait, what overlaps.</p></div>\n      <div class=\"how-visual\"><div class=\"viz-tide\">\n        <svg viewBox=\"0 0 300 110\" preserveAspectRatio=\"none\">\n          <path d=\"M0 70 Q 40 30 80 60 T 160 55 T 240 62 T 320 50\" fill=\"none\" stroke=\"#BFD9CE\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n          <path d=\"M0 85 Q 50 55 100 78 T 200 74 T 300 80\" fill=\"none\" stroke=\"#2E7D6B\" stroke-width=\"2.5\" stroke-linecap=\"round\" opacity=\".6\"/>\n          <circle cx=\"80\" cy=\"52\" r=\"5\" fill=\"#E0592F\"/><circle cx=\"196\" cy=\"70\" r=\"5\" fill=\"#D9A441\"/><circle cx=\"252\" cy=\"58\" r=\"5\" fill=\"#BFD9CE\"/>\n        </svg>\n      </div></div>\n    </div>\n\n    <div class=\"how-row reveal\">\n      <div class=\"how-num\">02</div>\n      <div><h3>Midweek, read the water</h3><p>Tidepool watches the load. When someone's drowning, it says so \u2014 and shows who has room to take the wave.</p></div>\n      <div class=\"how-visual\"><div class=\"viz-pulse\">\n        <i style=\"height:60%\"></i><i style=\"height:85%\"></i><i style=\"height:95%;background:linear-gradient(to top,#E0592F,#D9A441)\"></i>\n        <i style=\"height:55%\"></i><i style=\"height:70%\"></i><i style=\"height:40%\"></i><i style=\"height:65%\"></i>\n      </div></div>\n    </div>\n\n    <div class=\"how-row reveal\">\n      <div class=\"how-num\">03</div>\n      <div><h3>Friday, let it go out</h3><p>What got done, celebrated. What didn't, drifts \u2014 automatically resurfaced next week or released. No guilt ledger.</p></div>\n      <div class=\"how-visual\"><div class=\"viz-check\">\n        <div><svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\"><circle cx=\"9\" cy=\"9\" r=\"8\" fill=\"none\" stroke=\"#BFD9CE\" stroke-width=\"1.5\"/><path d=\"M5.5 9.5l2.5 2.5 4.5-5\" stroke=\"#BFD9CE\" stroke-width=\"1.8\" fill=\"none\" stroke-linecap=\"round\"/></svg>Investor update \u2014 shipped</div>\n        <div><svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\"><circle cx=\"9\" cy=\"9\" r=\"8\" fill=\"none\" stroke=\"#BFD9CE\" stroke-width=\"1.5\"/><path d=\"M5.5 9.5l2.5 2.5 4.5-5\" stroke=\"#BFD9CE\" stroke-width=\"1.8\" fill=\"none\" stroke-linecap=\"round\"/></svg>Onboarding emails \u2014 shipped</div>\n        <div><svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\"><path d=\"M3 12c2-2 4-2 6 0s4 2 6 0\" stroke=\"#E0592F\" stroke-width=\"1.8\" fill=\"none\" stroke-linecap=\"round\"/></svg>Docs refresh \u2014 drifting to next week</div>\n      </div></div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ RHYTHM CHART ============ -->\n<section class=\"rhythm-sec\" id=\"rhythm\">\n  <div class=\"rhythm-wrap\">\n    <div class=\"rhythm-copy reveal\">\n      <p class=\"kicker\">Team rhythm</p>\n      <h2>See the week as <em>one tide,</em> not five separate schedules.</h2>\n      <p>The rhythm chart shows collective load across the week. Hover a day to see who's carrying it \u2014 and rebalance with a drag, not a meeting.</p>\n    </div>\n    <div class=\"chart-card reveal\">\n      <h4>Collective load\n        <span class=\"legend\">\n          <span><i style=\"background:#2E7D6B\"></i>Focus</span>\n          <span><i style=\"background:#D9A441\"></i>Collab</span>\n          <span><i style=\"background:#E0592F\"></i>Over</span>\n        </span>\n      </h4>\n      <svg id=\"rhythmChart\" viewBox=\"0 0 460 240\" aria-label=\"Team load chart\"></svg>\n    </div>\n  </div>\n</section>\n\n<!-- ============ QUOTE ============ -->\n<section class=\"quote-sec\">\n  <blockquote class=\"reveal\">\n    \u201cWe replaced our hour-long planning meeting with fifteen minutes in Tidepool. <em>Same clarity, a tenth of the ceremony.</em> Fridays feel like Friday again.\u201d\n  </blockquote>\n  <div class=\"attrib reveal\">\n    <span class=\"avatar\" style=\"background:#2E7D6B\">LN</span>\n    <span><strong style=\"color:var(--ink)\">Lena Ortiz</strong> \u00b7 Co-founder, Fieldnote (team of 6)</span>\n  </div>\n</section>\n\n<!-- ============ CTA ============ -->\n<section class=\"cta-sec\">\n  <h2 class=\"reveal\">Catch the next <em>tide.</em></h2>\n  <p class=\"reveal\">Free for teams up to 10. Your first Monday ritual takes four minutes to set up \u2014 and about eleven to run.</p>\n  <a href=\"#\" class=\"btn reveal\">Plan your first week</a>\n  <div class=\"cta-wave\">\n    <svg viewBox=\"0 0 1440 120\" preserveAspectRatio=\"none\" width=\"100%\" height=\"100%\">\n      <path d=\"M0 60 C 240 20 480 100 720 60 S 1200 20 1440 60 V120 H0 Z\" fill=\"rgba(246,241,231,.08)\"/>\n      <path d=\"M0 85 C 240 55 480 115 720 85 S 1200 55 1440 85 V120 H0 Z\" fill=\"rgba(246,241,231,.06)\"/>\n    </svg>\n  </div>\n</section>\n\n<footer>\n  <span class=\"logo\">\n    <svg width=\"20\" height=\"20\" viewBox=\"0 0 26 26\" fill=\"none\">\n      <circle cx=\"13\" cy=\"13\" r=\"11.5\" stroke=\"#F6F1E7\" stroke-width=\"2\"/>\n      <path d=\"M2 15c3.5-3 6-3 9 0s6 3 9 0\" stroke=\"#E0592F\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n    </svg>\n    Tidepool\n  </span>\n  <span>\u00a9 2025 Tidepool \u2014 made slowly, on the coast.</span>\n  <span>\n    <a href=\"#\">Privacy</a><a href=\"#\">Changelog</a><a href=\"#\">hello@tidepool.so</a>\n  </span>\n</footer>\n\n<script>\n  // ---- nav shadow ----\n  const nav = document.getElementById('nav');\n  addEventListener('scroll', () => nav.classList.toggle('scrolled', scrollY > 40), {passive:true});\n\n  // ---- interactive hero waves ----\n  const cv = document.getElementById('waves'), cx = cv.getContext('2d');\n  let mx = -9999, targetMx = -9999, t = 0;\n  function sizeCanvas(){ cv.width = cv.offsetWidth * devicePixelRatio; cv.height = cv.offsetHeight * devicePixelRatio; }\n  sizeCanvas(); addEventListener('resize', sizeCanvas);\n  addEventListener('mousemove', e => {\n    const r = cv.getBoundingClientRect();\n    if (e.clientY > r.top - 200) targetMx = (e.clientX - r.left) * devicePixelRatio;\n  });\n  const layers = [\n    {amp:.55, base:.42, len:.008, spd:.9,  col:'rgba(46,125,107,.35)', w:2},\n    {amp:.75, base:.58, len:.012, spd:-.6, col:'rgba(224,89,47,.5)',   w:2.2},\n    {amp:.95, base:.74, len:.006, spd:.5,  col:'rgba(14,58,56,.85)',   w:2.5},\n  ];\n  function draw(){\n    t += .016;\n    mx += (targetMx - mx) * .07;\n    const W = cv.width, H = cv.height;\n    cx.clearRect(0,0,W,H);\n    layers.forEach((L,li) => {\n      cx.beginPath();\n      for (let x = 0; x <= W; x += 6 * devicePixelRatio){\n        const y0 = H * L.base + Math.sin(x * L.len + t * L.spd + li*2) * H * .14 * L.amp;\n        // bump near cursor\n        const d = (x - mx) / (260 * devicePixelRatio);\n        const bump = Math.exp(-d*d) * Math.sin(t*3 + x*.01) * 26 * devicePixelRatio * L.amp;\n        const y = y0 + bump;\n        x === 0 ? cx.moveTo(x,y) : cx.lineTo(x,y);\n      }\n      cx.strokeStyle = L.col; cx.lineWidth = L.w * devicePixelRatio;\n      cx.lineCap = 'round'; cx.stroke();\n    });\n    requestAnimationFrame(draw);\n  }\n  draw();\n\n  // ---- ticker: duplicate content for seamless loop ----\n  const tt = document.getElementById('tickerTrack');\n  tt.innerHTML += tt.innerHTML;\n\n  // ---- rhythm chart (hand-drawn, interactive) ----\n  const svg = document.getElementById('rhythmChart');\n  const days = ['Mon','Tue','Wed','Thu','Fri'];\n  // per-day stacked segments: [focus, collab, overload]\n  const data = [\n    [[60,'#2E7D6B'],[35,'#D9A441'],[0,'#E0592F']],\n    [[80,'#2E7D6B'],[55,'#D9A441'],[10,'#E0592F']],\n    [[95,'#2E7D6B'],[20,'#D9A441'],[0,'#E0592F']],\n    [[45,'#2E7D6B'],[70,'#D9A441'],[18,'#E0592F']],\n    [[35,'#2E7D6B'],[40,'#D9A441'],[0,'#E0592F']],\n  ];\n  const NS = 'http://www.w3.org/2000/svg';\n  const bw = 52, gap = 30, x0 = 15, baseY = 200, maxH = 165;\n  const info = document.createElementNS(NS,'text');\n  Object.assign(info.getAttributeNode?{}:{},{});\n  function mk(tag, attrs){ const el = document.createElementNS(NS,tag); for(const k in attrs) el.setAttribute(k,attrs[k]); return el; }\n  data.forEach((segs,i) => {\n    const x = x0 + i*(bw+gap);\n    const total = segs.reduce((s,[v])=>s+v,0);\n    let y = baseY;\n    segs.forEach(([v,c]) => {\n      if(!v) return;\n      const h = v/200*maxH*2; // scale: 200 units = full height\n      const r = mk('rect',{x, y:y-h, width:bw, height:h, rx:6, fill:c, class:'bar-rect'});\n      r.style.transformOrigin = `${x+bw/2}px ${baseY}px`;\n      r.style.transform = 'scaleY(0)';\n      r.style.transition = `transform .7s cubic-bezier(.2,.7,.2,1) ${i*90}ms`;\n      r.addEventListener('mouseenter', () => { info.textContent = `${days[i]} \u00b7 ${total}% of team capacity committed`; });\n      svg.appendChild(r);\n      y -= h;\n    });\n    const lbl = mk('text',{x:x+bw/2, y:baseY+24, 'text-anchor':'middle', fill:'#3E5F5C','font-size':13,'font-family':'Instrument Sans'});\n    lbl.textContent = days[i];\n    svg.appendChild(lbl);\n  });\n  info.setAttribute('x',230); info.setAttribute('y',16);\n  info.setAttribute('text-anchor','middle'); info.setAttribute('fill','#0E3A38');\n  info.setAttribute('font-size',13); info.setAttribute('font-family','Instrument Sans');\n  info.setAttribute('font-weight',600);\n  info.textContent = 'Hover a day to read the water';\n  svg.appendChild(info);\n  // animate bars in on scroll\n  const chartObs = new IntersectionObserver(es => es.forEach(e => {\n    if(e.isIntersecting){\n      svg.querySelectorAll('.bar-rect').forEach((r,i)=>{\n        r.style.transform='scaleY(1)';\n      });\n      chartObs.disconnect();\n    }\n  }),{threshold:.4});\n  chartObs.observe(svg);\n\n  // ---- scroll reveal ----\n  const obs = new IntersectionObserver(es => es.forEach(e => {\n    if(e.isIntersecting){ e.target.classList.add('in'); obs.unobserve(e.target); }\n  }),{threshold:.12});\n  document.querySelectorAll('.reveal').forEach(el => obs.observe(el));\n</script>\n</body>\n</html>\n"}