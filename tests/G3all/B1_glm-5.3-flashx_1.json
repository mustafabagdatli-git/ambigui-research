{"brief": "B1", "model": "z-ai/glm-5.3-flashx", "i": 1, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Brook & Son Plumbing \u2014 Family Plumbers in Leeds Since 1987</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,600;9..144,700&family=Archivo:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --cream:#f6f1e7;\n    --ink:#1d2b32;\n    --copper:#b5651d;\n    --copper-dark:#8f4d12;\n    --pipe:#2e4a56;\n    --paper:#fdfaf3;\n    --rule:#d8cfbd;\n  }\n  *{margin:0;padding:0;box-sizing:border-box}\n  html{scroll-behavior:smooth}\n  body{\n    background:var(--cream);\n    color:var(--ink);\n    font-family:'Archivo',sans-serif;\n    font-size:17px;\n    line-height:1.6;\n  }\n  h1,h2,h3,.serif{font-family:'Fraunces',serif;font-weight:600;line-height:1.08}\n  a{color:inherit}\n  img,svg{display:block}\n\n  /* ---------- top strip ---------- */\n  .strip{\n    background:var(--ink);color:var(--cream);\n    font-size:13.5px;letter-spacing:.04em;\n    display:flex;justify-content:space-between;align-items:center;\n    padding:9px 5vw;flex-wrap:wrap;gap:6px;\n  }\n  .strip .pulse{display:inline-block;width:8px;height:8px;border-radius:50%;background:#e05b3a;margin-right:8px;animation:pulse 1.6s infinite}\n  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}\n  .strip a{color:#f0b27a;text-decoration:none;font-weight:600}\n\n  /* ---------- nav ---------- */\n  nav{\n    position:sticky;top:0;z-index:50;\n    background:var(--cream);\n    border-bottom:1px solid var(--rule);\n    display:flex;align-items:center;justify-content:space-between;\n    padding:16px 5vw;\n  }\n  .logo{display:flex;align-items:center;gap:12px;text-decoration:none}\n  .logo svg{width:38px;height:38px}\n  .logo .name{font-family:'Fraunces',serif;font-weight:700;font-size:20px;line-height:1.05}\n  .logo .name small{display:block;font-family:'Archivo';font-weight:500;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--copper)}\n  .nav-links{display:flex;gap:32px;list-style:none}\n  .nav-links a{text-decoration:none;font-weight:500;font-size:15px;position:relative}\n  .nav-links a::after{content:\"\";position:absolute;left:0;bottom:-4px;width:0;height:2px;background:var(--copper);transition:width .25s}\n  .nav-links a:hover::after{width:100%}\n  .btn{\n    display:inline-block;background:var(--copper);color:#fff;\n    padding:13px 26px;border-radius:999px;text-decoration:none;\n    font-weight:600;font-size:15px;border:none;cursor:pointer;\n    transition:background .2s, transform .2s;font-family:'Archivo';\n  }\n  .btn:hover{background:var(--copper-dark);transform:translateY(-2px)}\n  .btn.dark{background:var(--ink)}\n  .btn.dark:hover{background:#0f1a20}\n  @media(max-width:820px){.nav-links{display:none}}\n\n  /* ---------- hero ---------- */\n  .hero{\n    display:grid;grid-template-columns:1.15fr .85fr;gap:4vw;\n    padding:64px 5vw 72px;align-items:center;\n  }\n  @media(max-width:900px){.hero{grid-template-columns:1fr}}\n  .eyebrow{\n    font-size:13px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;\n    color:var(--copper);margin-bottom:20px;display:flex;align-items:center;gap:12px;\n  }\n  .eyebrow::before{content:\"\";width:36px;height:1px;background:var(--copper)}\n  .hero h1{font-size:clamp(42px,6vw,74px);font-weight:700;letter-spacing:-.01em}\n  .hero h1 em{font-style:italic;font-weight:400;color:var(--copper)}\n  .hero p.lede{margin:26px 0 34px;max-width:46ch;font-size:18px;color:#43525a}\n  .hero-cta{display:flex;gap:16px;flex-wrap:wrap;align-items:center}\n  .hero-trust{margin-top:44px;display:flex;gap:36px;flex-wrap:wrap}\n  .hero-trust div strong{display:block;font-family:'Fraunces',serif;font-size:30px;font-weight:700}\n  .hero-trust div span{font-size:13px;letter-spacing:.05em;color:#6a747a;text-transform:uppercase}\n\n  /* tap illustration */\n  .tap-wrap{position:relative;background:var(--pipe);border-radius:20px;padding:48px 36px 36px;color:var(--cream);overflow:hidden}\n  .tap-wrap::before{content:\"\";position:absolute;inset:0;background:radial-gradient(circle at 75% 15%, rgba(255,255,255,.09), transparent 55%)}\n  .tap-head{font-family:'Fraunces',serif;font-size:22px;font-weight:600;margin-bottom:6px}\n  .tap-sub{font-size:14px;color:#a8bcc4;margin-bottom:18px}\n  .tap-scene{width:100%;height:auto}\n  .counter-box{\n    margin-top:22px;background:rgba(0,0,0,.28);border:1px solid rgba(255,255,255,.14);\n    border-radius:14px;padding:18px 20px;display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap;\n  }\n  .litres{font-family:'Fraunces',serif;font-size:32px;font-weight:700;font-variant-numeric:tabular-nums}\n  .counter-box small{display:block;font-size:12px;color:#a8bcc4;letter-spacing:.06em;text-transform:uppercase}\n  .tap-toggle{\n    background:transparent;color:var(--cream);border:1px solid rgba(255,255,255,.4);\n    padding:10px 18px;border-radius:999px;font-family:'Archivo';font-weight:600;font-size:13.5px;cursor:pointer;transition:.2s;\n  }\n  .tap-toggle:hover{background:rgba(255,255,255,.12)}\n\n  /* ---------- marquee ---------- */\n  .areas{\n    border-top:1px solid var(--rule);border-bottom:1px solid var(--rule);\n    background:var(--paper);overflow:hidden;white-space:nowrap;padding:14px 0;\n  }\n  .areas-track{display:inline-block;animation:scroll 32s linear infinite}\n  .areas span{font-family:'Fraunces',serif;font-size:16px;font-style:italic;color:#5c6a71;margin:0 18px}\n  .areas b{color:var(--copper);font-style:normal}\n  @keyframes scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}\n\n  /* ---------- sections ---------- */\n  section{padding:88px 5vw}\n  .sec-head{max-width:640px;margin-bottom:56px}\n  .sec-head h2{font-size:clamp(32px,4.2vw,50px);margin-top:16px}\n  .sec-head p{margin-top:16px;color:#43525a}\n\n  /* services \u2014 editorial numbered list */\n  .svc{border-top:1px solid var(--rule);max-width:1100px}\n  .svc-row{\n    display:grid;grid-template-columns:70px 1.1fr 1.4fr auto;gap:28px;align-items:baseline;\n    padding:30px 8px;border-bottom:1px solid var(--rule);transition:background .25s;\n    cursor:default;\n  }\n  .svc-row:hover{background:var(--paper)}\n  .svc-num{font-family:'Fraunces',serif;font-style:italic;color:var(--copper);font-size:18px}\n  .svc-row h3{font-size:26px}\n  .svc-row p{color:#4c5a61;font-size:15.5px}\n  .svc-tag{font-size:12px;letter-spacing:.12em;text-transform:uppercase;border:1px solid var(--rule);border-radius:999px;padding:6px 14px;color:#6a747a;white-space:nowrap}\n  @media(max-width:820px){\n    .svc-row{grid-template-columns:44px 1fr;grid-template-rows:auto auto auto}\n    .svc-row p{grid-column:2}.svc-tag{grid-column:2;justify-self:start}\n  }\n\n  /* story */\n  .story{background:var(--ink);color:var(--cream)}\n  .story-grid{display:grid;grid-template-columns:1fr 1fr;gap:6vw;align-items:center;max-width:1200px;margin:0 auto}\n  @media(max-width:900px){.story-grid{grid-template-columns:1fr}}\n  .story h2{font-size:clamp(32px,4vw,48px);margin-top:16px;color:var(--cream)}\n  .story h2 em{color:#e0a05a;font-style:italic;font-weight:400}\n  .story p{color:#b8c4ca;margin-top:18px}\n  .timeline{list-style:none;margin-top:8px}\n  .timeline li{display:flex;gap:22px;padding:20px 0;border-bottom:1px solid rgba(255,255,255,.12)}\n  .timeline .yr{font-family:'Fraunces',serif;font-weight:700;font-size:22px;color:#e0a05a;min-width:72px}\n  .timeline div strong{display:block;font-family:'Fraunces',serif;font-size:18px}\n  .timeline div span{font-size:14.5px;color:#a3b0b7}\n\n  /* emergency */\n  .emergency{\n    background:#c8502c;color:#fff;text-align:center;padding:64px 5vw;\n  }\n  .emergency h2{font-size:clamp(30px,4vw,46px)}\n  .emergency p{margin:14px auto 28px;max-width:52ch;color:#ffe4d8}\n  .emergency .btn{background:#fff;color:#c8502c}\n  .emergency .btn:hover{background:#ffe4d8}\n\n  /* testimonials */\n  .quotes{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:28px;max-width:1200px;margin:0 auto}\n  .quote{\n    background:var(--paper);border:1px solid var(--rule);border-radius:18px;padding:34px 30px;\n    display:flex;flex-direction:column;gap:18px;transition:transform .25s, box-shadow .25s;\n  }\n  .quote:hover{transform:translateY(-5px);box-shadow:0 18px 40px rgba(29,43,50,.10)}\n  .quote .stars{color:var(--copper);font-size:17px;letter-spacing:3px}\n  .quote blockquote{font-family:'Fraunces',serif;font-size:19px;font-style:italic;line-height:1.45}\n  .quote cite{font-style:normal;font-size:14px;color:#6a747a}\n  .quote cite b{display:block;color:var(--ink);font-size:15px}\n\n  /* contact */\n  .contact{background:var(--paper);border-top:1px solid var(--rule)}\n  .contact-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:6vw;max-width:1200px;margin:0 auto;align-items:start}\n  @media(max-width:900px){.contact-grid{grid-template-columns:1fr}}\n  .contact-info dl{margin-top:32px}\n  .contact-info dt{font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--copper);font-weight:600;margin-top:24px}\n  .contact-info dd{font-family:'Fraunces',serif;font-size:22px;margin-top:4px}\n  form{display:grid;gap:18px}\n  label{font-size:13px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:#5c6a71}\n  input,select,textarea{\n    width:100%;margin-top:6px;padding:14px 16px;border:1px solid var(--rule);\n    border-radius:10px;background:var(--cream);font-family:'Archivo';font-size:16px;color:var(--ink);\n  }\n  input:focus,select:focus,textarea:focus{outline:2px solid var(--copper);outline-offset:1px}\n  .form-note{font-size:13px;color:#6a747a}\n  @media(max-width:900px){.nav-cta{display:none}}\n\n  /* footer */\n  footer{background:var(--ink);color:#93a1a8;padding:52px 5vw;font-size:14px}\n  .foot{max-width:1200px;margin:0 auto;display:flex;justify-content:space-between;gap:32px;flex-wrap:wrap}\n  footer .logo .name{color:var(--cream)}\n  footer p{max-width:38ch;margin-top:12px}\n  footer ul{list-style:none;line-height:2}\n  footer a{text-decoration:none}\n  footer a:hover{color:#e0a05a}\n  .copy{border-top:1px solid rgba(255,255,255,.12);margin-top:40px;padding-top:22px;text-align:center;font-size:13px}\n</style>\n</head>\n<body>\n\n<div class=\"strip\">\n  <span><span class=\"pulse\"></span>24-hour emergency callout across Leeds</span>\n  <span>Call Ken direct: <a href=\"tel:+441132456789\">0113 245 6789</a></span>\n</div>\n\n<nav>\n  <a class=\"logo\" href=\"#top\">\n    <svg viewBox=\"0 0 40 40\" fill=\"none\">\n      <circle cx=\"20\" cy=\"20\" r=\"18\" stroke=\"#b5651d\" stroke-width=\"2.5\"/>\n      <path d=\"M12 14h10a5 5 0 0 1 5 5v3\" stroke=\"#1d2b32\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n      <path d=\"M27 26c0 1.6-1.3 3-3 3s-3-1.4-3-3c0-2 3-5 3-5s3 3 3 5z\" fill=\"#b5651d\"/>\n      <circle cx=\"12\" cy=\"14\" r=\"2.6\" fill=\"#1d2b32\"/>\n    </svg>\n    <span class=\"name\">Brook &amp; Son<small>Plumbers \u00b7 Leeds</small></span>\n  </a>\n  <ul class=\"nav-links\">\n    <li><a href=\"#services\">Services</a></li>\n    <li><a href=\"#family\">Our Family</a></li>\n    <li><a href=\"#reviews\">Reviews</a></li>\n    <li><a href=\"#contact\">Contact</a></li>\n  </ul>\n  <a class=\"btn nav-cta\" href=\"#contact\">Get a Free Quote</a>\n</nav>\n\n<!-- HERO -->\n<header class=\"hero\" id=\"top\">\n  <div>\n    <div class=\"eyebrow\">Family-run since 1987</div>\n    <h1>Leeds plumbing, done the <em>proper</em> way.</h1>\n    <p class=\"lede\">Three generations of BrooksWith vans, wrenches and a war on drip. From a weepy washer in Headingley to a full boiler swap in Horsforth \u2014 we treat your home like it's our mum's.</p>\n    <div class=\"hero-cta\">\n      <a class=\"btn\" href=\"#contact\">Book a Home Visit</a>\n      <a class=\"btn dark\" href=\"tel:+441132456789\">\ud83d\udcde 0113 245 6789</a>\n    </div>\n    <div class=\"hero-trust\">\n      <div><strong>38 yrs</strong><span>Serving Leeds</span></div>\n      <div><strong>4.9 \u2605</strong><span>300+ reviews</span></div>\n      <div><strong>Gas Safe</strong><span>Reg. 512 444</span></div>\n    </div>\n  </div>\n\n  <div class=\"tap-wrap\">\n    <div class=\"tap-head\">That dripping tap?</div>\n    <div class=\"tap-sub\">A worn washer wastes roughly a bath a week. Watch it add up \u2014 or click to turn the tap off.</div>\n    <svg class=\"tap-scene\" viewBox=\"0 0 300 200\" aria-hidden=\"true\">\n      <rect x=\"30\" y=\"150\" width=\"240\" height=\"14\" rx=\"4\" fill=\"#d8cfbd\"/>\n      <rect x=\"40\" y=\"140\" width=\"80\" height=\"12\" rx=\"3\" fill=\"#c3b89f\"/>\n      <!-- pipe -->\n      <rect x=\"120\" y=\"40\" width=\"22\" height=\"60\" rx=\"6\" fill=\"#8fb4bf\"/>\n      <rect x=\"100\" y=\"30\" width=\"62\" height=\"20\" rx=\"8\" fill=\"#a9c7d0\"/>\n      <circle cx=\"131\" cy=\"26\" r=\"9\" fill=\"#e0a05a\"/>\n      <rect x=\"118\" y=\"98\" width=\"26\" height=\"14\" rx=\"3\" fill=\"#7ba3ae\"/>\n      <!-- water -->\n      <g id=\"stream\"><rect x=\"126\" y=\"112\" width=\"10\" height=\"38\" rx=\"5\" fill=\"#9fd4e8\" opacity=\".9\"/></g>\n      <ellipse id=\"drop\" cx=\"131\" cy=\"168\" rx=\"0\" ry=\"0\" fill=\"#9fd4e8\"/>\n      <ellipse cx=\"131\" cy=\"152\" rx=\"26\" ry=\"4\" fill=\"#9fd4e8\" opacity=\".35\"/>\n    </svg>\n    <div class=\"counter-box\">\n      <div>\n        <span class=\"litres\" id=\"litres\">0</span><span style=\"font-size:16px\"> litres</span>\n        <small>wasted this year, one tap at a time</small>\n      </div>\n      <button class=\"tap-toggle\" id=\"tapBtn\">Turn the tap off</button>\n    </div>\n  </div>\n</header>\n\n<!-- AREAS MARQUEE -->\n<div class=\"areas\" aria-label=\"Areas we cover\">\n  <div class=\"areas-track\" id=\"track\">\n    <span>Headingley</span><b>\u2726</b><span>Chapel Allerton</span><b>\u2726</b><span>Horsforth</span><b>\u2726</b><span>Roundhay</span><b>\u2726</b><span>Kirkstall</span><b>\u2726</b><span>Meanwood</span><b>\u2726</b><span>Garforth</span><b>\u2726</b><span>Morley</span><b>\u2726</b><span>Pudsey</span><b>\u2726</b><span>Otley</span><b>\u2726</b><span>Wetherby</span><b>\u2726</b><span>Leeds City Centre</span><b>\u2726</b>\n  </div>\n</div>\n\n<!-- SERVICES -->\n<section id=\"services\">\n  <div class=\"sec-head\">\n    <div class=\"eyebrow\">What we do</div>\n    <h2>Everything wet, warm and working.</h2>\n    <p>No job too small, no call-out fee for regulars, and always a fixed quote before we pick up a spanner.</p>\n  </div>\n  <div class=\"svc\">\n    <div class=\"svc-row\">\n      <span class=\"svc-num\">01</span>\n      <h3>Emergency Callouts</h3>\n      <p>Burst pipes, no hot water, flooding loo \u2014 we answer the phone at 3am and aim to be with you within the hour, anywhere in Leeds.</p>\n      <span class=\"svc-tag\">24 / 7</span>\n    </div>\n    <div class=\"svc-row\">\n      <span class=\"svc-num\">02</span>\n      <h3>Boilers &amp; Heating</h3>\n      <p>Servicing, repairs and full replacements by our Gas Safe engineers. We'll tell you honestly whether it needs replacing or just a good service.</p>\n      <span class=\"svc-tag\">Gas Safe</span>\n    </div>\n    <div class=\"svc-row\">\n      <span class=\"svc-num\">03</span>\n      <h3>Bathrooms &amp; Kitchens</h3>\n      <p>From a leaking mixer tap to a full wet-room refit. Tiling, pipework and finishing \u2014 one family team, start to shine.</p>\n      <span class=\"svc-tag\">Full refits</span>\n    </div>\n    <div class=\"svc-row\">\n      <span class=\"svc-num\">04</span>\n      <h3>Landlord Certificates</h3>\n      <p>Gas safety checks, EICR-adjacent plumbing inspections and prompt tenant repairs. We look after your property like our own rental.</p>\n      <span class=\"svc-tag\">CP12</span>\n    </div>\n    <div class=\"svc-row\">\n      <span class=\"svc-num\">05</span>\n      <h3>Blocked Drains</h3>\n      <p>High-pressure jetting and CCTV surveys. We clear it, show you the footage, and tell you how to stop it happening again.</p>\n      <span class=\"svc-tag\">Same day</span>\n    </div>\n  </div>\n</section>\n\n<!-- FAMILY STORY -->\n<section class=\"story\" id=\"family\">\n  <div class=\"story-grid\">\n    <div>\n      <div class=\"eyebrow\" style=\"color:#e0a05a\">Our family</div>\n      <h2>Still answering the phone to the same streets Dad started on.</h2>\n      <p>Ken Brook started out with a van, a toolbox and his late father's wrench. Today his son Tom runs the emergency line, daughter-in-law Priya handles the quotes, and Ken still won't retire (\"who'd answer the phone?\").</p>\n      <p>We're the firm your neighbour recommends \u2014 because we've probably already fixed their boiler.</p>\n    </div>\n    <ul class=\"timeline\">\n      <li><span class=\"yr\">1987</span><div><strong>Ken picks up a wrench</strong><span>One van, one phone in the hall, Headingley and beyond.</span></div></li>\n      <li><span class=\"yr\">2004</span><div><strong>Tom joins the vans</strong><span>Apprenticed at 16, Gas Safe by 19, never left.</span></div></li>\n      <li><span class=\"yr\">2015</span><div><strong>Priya opens the office</strong><span>Fixed quotes, honest invoices, no jargon.</span></div></li>\n      <li><span class=\"yr\">2023</span><div><strong>Third apprentice</strong><span>We train Leeds lads and lasses properly \u2014 one at a time.</span></div></li>\n    </ul>\n  </div>\n</section>\n\n<!-- EMERGENCY -->\n<section class=\"emergency\">\n  <h2>Burst pipe? Boiler dead? Don't wait until morning.</h2>\n  <p>Our emergency line rings straight through to a Brook \u2014 not a call centre in another county. Average response time across Leeds: 47 minutes.</p>\n  <a class=\"btn\" href=\"tel:+441132456789\">Call the Emergency Line \u2014 0113 245 6789</a>\n</section>\n\n<!-- REVIEWS -->\n<section id=\"reviews\">\n  <div class=\"sec-head\">\n    <div class=\"eyebrow\">Word of mouth</div>\n    <h2>What Leeds says about us.</h2>\n  </div>\n  <div class=\"quotes\">\n    <div class=\"quote\">\n      <span class=\"stars\">\u2605\u2605\u2605\u2605\u2605</span>\n      <blockquote>\"Tom came out at 11pm on a Sunday when our pipe burst above the shop. Lifesavers. Wouldn't use anyone else in Leeds.\"</blockquote>\n      <cite><b>Margaret H.</b>Chapel Allerton</cite>\n    </div>\n    <div class=\"quote\">\n      <span class=\"stars\">\u2605\u2605\u2605\u2605\u2605</span>\n      <blockquote>\"Quoted for the job, stuck to the quote, cleaned up after themselves. Refreshing. The new bathroom is lovely.\"</blockquote>\n      <cite><b>Daniel &amp; Ash</b>Horsforth</cite>\n    </div>\n    <div class=\"quote\">\n      <span class=\"stars\">\u2605\u2605\u2605\u2605\u2605</span>\n      <blockquote>\"Ken serviced my mum's boiler and noticed she'd had the thermostat set wrong for years. Charged her nowt for it. Proper gentlemen.\"</blockquote>\n      <cite><b>Sarah W.</b>Roundhay</cite>\n    </div>\n  </div>\n</section>\n\n<!-- CONTACT -->\n<section class=\"contact\" id=\"contact\">\n  <div class=\"contact-grid\">\n    <div class=\"contact-info\">\n      <div class=\"eyebrow\">Get in touch</div>\n      <h2>Ring us, or drop us a note.</h2>\n      <dl>\n        <dt>Phone (24hr)</dt><dd>0113 245 6789</dd>\n        <dt>Email</dt><dd>hello@brookandson.co.uk</dd>\n        <dt>Workshop</dt><dd>14 Cardigan Road, Leeds LS6</dd>\n        <dt>Hours</dt><dd>Mon\u2013Sat 7:30\u201318:00 \u00b7 Emergencies always</dd>\n      </dl>\n    </div>\n    <form onsubmit=\"event.preventDefault();this.innerHTML='<p style=\\'font-family:Fraunces,serif;font-size:24px\\'>Thanks \u2014 Priya will ring you back within the hour (office hours). For emergencies, call 0113 245 6789.</p>'\">\n      <div><label for=\"n\">Your name</label><input id=\"n\" required placeholder=\"e.g. Margaret Harrison\"></div>\n      <div><label for=\"p\">Phone</label><input id=\"p\" type=\"tel\" required placeholder=\"07\u2026\"></div>\n      <div><label for=\"a\">Area of Leeds</label><input id=\"a\" placeholder=\"e.g. Headingley\"></div>\n      <div><label for=\"j\">What's the job?</label>\n        <select id=\"j\">\n          <option>Leak or drip</option><option>Boiler / heating</option>\n          <option>Bathroom or kitchen refit</option><option>Blocked drain</option>\n          <option>Landlord certificate</option><option>Something else</option>\n        </select>\n      </div>\n      <div><label for=\"m\">Anything else?</label><textarea id=\"m\" rows=\"3\" placeholder=\"Tell us what's going on\u2026\"></textarea></div>\n      <button class=\"btn dark\" type=\"submit\">Request a Callback</button>\n      <p class=\"form-note\">No spam, no sales calls \u2014 just Priya or Ken, from a Leeds number.</p>\n    </form>\n  </div>\n</section>\n\n<footer>\n  <div class=\"foot\">\n    <div>\n      <a class=\"logo\" href=\"#top\">\n        <svg viewBox=\"0 0 40 40\" fill=\"none\" width=\"34\" height=\"34\">\n          <circle cx=\"20\" cy=\"20\" r=\"18\" stroke=\"#b5651d\" stroke-width=\"2.5\"/>\n          <path d=\"M12 14h10a5 5 0 0 1 5 5v3\" stroke=\"#f6f1e7\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n          <path d=\"M27 26c0 1.6-1.3 3-3 3s-3-1.4-3-3c0-2 3-5 3-5s3 3 3 5z\" fill=\"#e0a05a\"/>\n        </svg>\n        <span class=\"name\">Brook &amp; Son<small style=\"color:#e0a05a\">Plumbers \u00b7 Leeds</small></span>\n      </a>\n      <p>Family-run plumbing and heating across Leeds since 1987. Gas Safe registered, fully insured, properly local.</p>\n    </div>\n    <ul>\n      <li><a href=\"#services\">Services</a></li>\n      <li><a href=\"#family\">Our Family</a></li>\n      <li><a href=\"#reviews\">Reviews</a></li>\n      <li><a href=\"#contact\">Contact</a></li>\n    </ul>\n    <ul>\n      <li>0113 245 6789</li>\n      <li>hello@brookandson.co.uk</li>\n      <li>Gas Safe Reg. 512 444</li>\n    </ul>\n  </div>\n  <div class=\"copy\">\u00a9 2025 Brook &amp; Son Plumbing Ltd \u00b7 Proudly based in Leeds, West Yorkshire</div>\n</footer>\n\n<script>\n  // dripping tap counter\n  const litresEl = document.getElementById('litres');\n  const drop = document.getElementById('drop');\n  const stream = document.getElementById('stream');\n  const btn = document.getElementById('tapBtn');\n  let litres = 0, running = true, t = 0;\n  setInterval(() => {\n    if (!running) return;\n    litres += 0.0038; // ~1 drip per second \u2248 120,000 L/yr scaled\n    litresEl.textContent = Math.floor(litres).toLocaleString();\n  }, 100);\n  function animate(){\n    if (running){\n      t += 0.06;\n      const p = (t % 1);\n      const y = 118 + p * 46;\n      drop.setAttribute('cy', y);\n      drop.setAttribute('rx', 4.5);\n      drop.setAttribute('ry', 7 * (1 - p*0.4));\n      drop.setAttribute('opacity', 1 - p * 0.6);\n      stream.setAttribute('opacity', 0.9);\n    } else {\n      drop.setAttribute('rx', 0); drop.setAttribute('ry', 0);\n      stream.setAttribute('opacity', 0);\n    }\n    requestAnimationFrame(animate);\n  }\n  animate();\n  btn.addEventListener('click', () => {\n    running = !running;\n    btn.textContent = running ? 'Turn the tap off' : 'Turn it back on (why?)';\n    if (!running) stream.setAttribute('opacity', 0);\n  });\n  // duplicate marquee track for seamless loop\n  const track = document.getElementById('track');\n  track.innerHTML += track.innerHTML;\n</script>\n</body>\n</html>\n"}