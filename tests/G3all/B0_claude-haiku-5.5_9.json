{"arm": "direct", "model": "anthropic/claude-haiku-5.5", "i": 9, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Tidepool: Plan your week together</title>\n<meta name=\"description\" content=\"Tidepool helps small teams plan their week together. One shared board, three short rituals, and no status meetings.\">\n<style>\n  :root {\n    --ink: #0b2a3a;\n    --ink-soft: #3d5a68;\n    --teal: #13807a;\n    --teal-deep: #0c5f5a;\n    --foam: #7fd1c0;\n    --mist: #e4f3ef;\n    --sand: #f7f2e8;\n    --coral: #ff7a59;\n    --white: #ffffff;\n    --line: rgba(11, 42, 58, 0.12);\n    --radius: 18px;\n    --shadow: 0 1px 2px rgba(11,42,58,.06), 0 12px 32px -12px rgba(11,42,58,.18);\n    --font-body: ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n    --font-display: ui-serif, Georgia, \"Iowan Old Style\", \"Palatino Linotype\", serif;\n  }\n\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  html { scroll-behavior: smooth; }\n  body {\n    font-family: var(--font-body);\n    color: var(--ink);\n    background: var(--white);\n    line-height: 1.6;\n    -webkit-font-smoothing: antialiased;\n  }\n  img, svg { display: block; max-width: 100%; }\n  a { color: inherit; text-decoration: none; }\n  h1, h2, h3 { line-height: 1.15; letter-spacing: -0.01em; }\n  h1, h2 { font-family: var(--font-display); font-weight: 600; }\n\n  .wrap { width: min(1160px, 92%); margin-inline: auto; }\n  section { padding: clamp(64px, 9vw, 120px) 0; position: relative; }\n\n  .eyebrow {\n    display: inline-flex; align-items: center; gap: 8px;\n    font-size: 13px; font-weight: 600; letter-spacing: .08em;\n    text-transform: uppercase; color: var(--teal);\n  }\n  .eyebrow::before {\n    content: \"\"; width: 18px; height: 2px; background: currentColor; border-radius: 2px;\n  }\n  .section-head { max-width: 640px; margin-bottom: 56px; }\n  .section-head h2 { font-size: clamp(2rem, 4vw, 2.9rem); margin-top: 14px; }\n  .section-head p { margin-top: 16px; color: var(--ink-soft); font-size: 1.1rem; }\n\n  /* Buttons */\n  .btn {\n    display: inline-flex; align-items: center; justify-content: center; gap: 8px;\n    padding: 13px 22px; border-radius: 999px; font-weight: 600; font-size: 15px;\n    border: 1.5px solid transparent; cursor: pointer; transition: transform .15s ease, background .15s ease, box-shadow .15s ease;\n    white-space: nowrap;\n  }\n  .btn:hover { transform: translateY(-1px); }\n  .btn-primary { background: var(--ink); color: var(--white); box-shadow: 0 8px 20px -8px rgba(11,42,58,.5); }\n  .btn-primary:hover { background: #123a4f; }\n  .btn-ghost { background: transparent; color: var(--ink); border-color: var(--line); }\n  .btn-ghost:hover { border-color: var(--ink); }\n  .btn-light { background: var(--white); color: var(--ink); }\n  .btn-light:hover { background: var(--mist); }\n  .btn-sm { padding: 9px 16px; font-size: 14px; }\n\n  /* Nav */\n  header.site {\n    position: sticky; top: 0; z-index: 50;\n    background: rgba(255,255,255,.86);\n    backdrop-filter: saturate(1.4) blur(10px);\n    border-bottom: 1px solid var(--line);\n  }\n  .nav { display: flex; align-items: center; justify-content: space-between; height: 72px; gap: 24px; }\n  .logo { display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-display); font-weight: 700; font-size: 22px; letter-spacing: -0.01em; }\n  .nav-links { display: flex; gap: 32px; font-size: 15px; color: var(--ink-soft); }\n  .nav-links a:hover { color: var(--ink); }\n  .nav-actions { display: flex; align-items: center; gap: 12px; }\n  .nav-actions .login { font-size: 15px; font-weight: 600; color: var(--ink-soft); padding: 8px 12px; }\n\n  /* Hero */\n  .hero {\n    padding-top: clamp(48px, 7vw, 96px);\n    padding-bottom: clamp(72px, 9vw, 120px);\n    background:\n      radial-gradient(900px 460px at 85% -10%, rgba(127,209,192,.45), transparent 70%),\n      radial-gradient(700px 400px at -10% 30%, rgba(255,122,89,.12), transparent 70%),\n      var(--sand);\n    overflow: hidden;\n  }\n  .hero-grid { display: grid; grid-template-columns: 1.02fr 1fr; gap: clamp(40px, 6vw, 80px); align-items: center; }\n  .hero h1 { font-size: clamp(2.6rem, 5.6vw, 4.3rem); margin: 20px 0 22px; }\n  .hero h1 em { font-style: italic; color: var(--teal); }\n  .hero .lede { font-size: clamp(1.05rem, 1.6vw, 1.2rem); color: var(--ink-soft); max-width: 34em; }\n  .hero-ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }\n  .hero-note { margin-top: 18px; font-size: 14px; color: var(--ink-soft); display: flex; gap: 8px; align-items: center; }\n  .hero-note svg { color: var(--teal); flex: none; }\n\n  /* Mock board */\n  .board-wrap { position: relative; }\n  .board {\n    background: var(--white);\n    border-radius: 22px;\n    box-shadow: var(--shadow), 0 40px 80px -30px rgba(11,42,58,.35);\n    border: 1px solid var(--line);\n    padding: 18px;\n    transform: rotate(-1.2deg);\n  }\n  .board-top { display: flex; align-items: center; justify-content: space-between; padding: 4px 6px 16px; border-bottom: 1px solid var(--line); margin-bottom: 14px; }\n  .board-top strong { font-size: 15px; }\n  .board-top span { font-size: 12px; color: var(--ink-soft); }\n  .avatars { display: flex; }\n  .av {\n    width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center;\n    font-size: 11px; font-weight: 700; color: var(--white); border: 2px solid var(--white); margin-left: -6px;\n  }\n  .av:first-child { margin-left: 0; }\n  .days { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }\n  .day { background: var(--mist); border-radius: 12px; padding: 10px 8px; min-height: 260px; display: flex; flex-direction: column; gap: 8px; }\n  .day.today { background: var(--ink); color: var(--white); }\n  .day-name { font-size: 12px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; display: flex; justify-content: space-between; align-items: baseline; }\n  .day-name small { font-weight: 500; opacity: .6; font-size: 11px; }\n  .card {\n    background: var(--white); border-radius: 10px; padding: 9px 10px; font-size: 12px; line-height: 1.35;\n    box-shadow: 0 1px 2px rgba(11,42,58,.08); color: var(--ink); border-left: 3px solid var(--teal);\n  }\n  .card.coral { border-left-color: var(--coral); }\n  .card.sea { border-left-color: var(--foam); }\n  .card.plum { border-left-color: #7a5ea8; }\n  .card .meta { display: flex; justify-content: space-between; align-items: center; margin-top: 6px; font-size: 10.5px; color: var(--ink-soft); }\n  .card .dot { width: 16px; height: 16px; border-radius: 50%; font-size: 8px; display: grid; place-items: center; color: #fff; font-weight: 700; }\n  .done { text-decoration: line-through; opacity: .55; }\n  .float-chip {\n    position: absolute; right: -14px; bottom: -22px; background: var(--white); border-radius: 16px;\n    padding: 12px 14px; box-shadow: var(--shadow); display: flex; gap: 10px; align-items: center; font-size: 13px;\n    border: 1px solid var(--line);\n  }\n  .float-chip .ic { width: 32px; height: 32px; border-radius: 10px; background: var(--coral); display: grid; place-items: center; color: #fff; }\n  .float-chip b { display: block; font-size: 13px; }\n  .float-chip span { color: var(--ink-soft); font-size: 12px; }\n\n  /* Proof strip */\n  .strip { background: var(--ink); color: var(--white); padding: 34px 0; }\n  .strip-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; text-align: center; }\n  .strip-grid b { display: block; font-family: var(--font-display); font-size: 2rem; font-weight: 600; color: var(--foam); }\n  .strip-grid span { font-size: 14px; opacity: .8; }\n\n  /* Problem */\n  .problem-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }\n  .problem {\n    padding: 32px 28px; border-radius: var(--radius); border: 1px solid var(--line); background: var(--white);\n  }\n  .problem .num { font-family: var(--font-display); font-size: 42px; color: var(--coral); line-height: 1; }\n  .problem h3 { font-size: 1.2rem; margin: 18px 0 10px; }\n  .problem p { color: var(--ink-soft); font-size: 15px; }\n\n  /* Features */\n  .features { background: var(--mist); }\n  .feature-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }\n  .feature {\n    background: var(--white); border-radius: var(--radius); padding: 30px 28px; box-shadow: 0 1px 2px rgba(11,42,58,.05);\n    transition: transform .2s ease, box-shadow .2s ease;\n  }\n  .feature:hover { transform: translateY(-3px); box-shadow: var(--shadow); }\n  .feature .ico {\n    width: 48px; height: 48px; border-radius: 14px; background: var(--mist); color: var(--teal-deep);\n    display: grid; place-items: center; margin-bottom: 20px;\n  }\n  .feature h3 { font-size: 1.15rem; margin-bottom: 8px; }\n  .feature p { color: var(--ink-soft); font-size: 15px; }\n\n  /* How it works */\n  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; counter-reset: step; position: relative; }\n  .step { position: relative; padding-top: 8px; }\n  .step::before {\n    counter-increment: step; content: \"0\" counter(step);\n    display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 50%;\n    background: var(--teal); color: var(--white); font-weight: 700; font-size: 14px; margin-bottom: 20px;\n    box-shadow: 0 0 0 6px var(--mist);\n  }\n  .step h3 { font-size: 1.35rem; margin-bottom: 10px; font-family: var(--font-display); }\n  .step p { color: var(--ink-soft); }\n  .step ul { list-style: none; margin-top: 16px; display: grid; gap: 8px; font-size: 14.5px; color: var(--ink); }\n  .step li { display: flex; gap: 10px; align-items: flex-start; }\n  .step li::before { content: \"\"; width: 6px; height: 6px; border-radius: 50%; background: var(--coral); margin-top: 9px; flex: none; }\n\n  /* Rhythm */\n  .rhythm { background: var(--ink); color: var(--white); overflow: hidden; }\n  .rhythm .eyebrow { color: var(--foam); }\n  .rhythm h2 { color: var(--white); font-size: clamp(2rem, 4vw, 2.9rem); margin-top: 14px; }\n  .rhythm-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 90px); align-items: center; }\n  .rhythm p.lead { color: rgba(255,255,255,.78); margin-top: 18px; font-size: 1.1rem; }\n  .timeline { display: grid; gap: 14px; }\n  .tl-item {\n    display: grid; grid-template-columns: 90px 1fr; gap: 18px; padding: 20px 22px; border-radius: 16px;\n    background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1);\n  }\n  .tl-item time { font-size: 13px; font-weight: 700; color: var(--foam); letter-spacing: .04em; text-transform: uppercase; padding-top: 2px; }\n  .tl-item h4 { font-size: 1.02rem; margin-bottom: 4px; }\n  .tl-item p { font-size: 14.5px; color: rgba(255,255,255,.7); }\n  .wave-bg { position: absolute; left: 0; right: 0; bottom: -2px; opacity: .08; pointer-events: none; }\n\n  /* Pricing */\n  .pricing-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; align-items: stretch; }\n  .plan { border: 1px solid var(--line); border-radius: 22px; padding: 36px 30px; display: flex; flex-direction: column; background: var(--white); }\n  .plan.featured { border: 2px solid var(--teal); box-shadow: 0 24px 50px -24px rgba(19,128,122,.5); position: relative; }\n  .plan .tag {\n    position: absolute; top: -13px; left: 30px; background: var(--teal); color: var(--white);\n    font-size: 12px; font-weight: 700; padding: 5px 12px; border-radius: 999px; letter-spacing: .03em;\n  }\n  .plan h3 { font-family: var(--font-display); font-size: 1.5rem; }\n  .plan .desc { color: var(--ink-soft); font-size: 15px; margin-top: 6px; min-height: 44px; }\n  .price { margin: 24px 0 26px; display: flex; align-items: baseline; gap: 6px; }\n  .price strong { font-size: 3rem; font-family: var(--font-display); font-weight: 600; line-height: 1; }\n  .price span { color: var(--ink-soft); font-size: 15px; }\n  .plan ul { list-style: none; display: grid; gap: 12px; margin-bottom: 30px; font-size: 15px; }\n  .plan li { display: flex; gap: 10px; align-items: flex-start; }\n  .plan li svg { color: var(--teal); flex: none; margin-top: 3px; }\n  .plan .btn { margin-top: auto; width: 100%; }\n\n  /* FAQ */\n  .faq-wrap { display: grid; grid-template-columns: 1fr 1.5fr; gap: clamp(40px, 6vw, 80px); }\n  .faq-wrap h2 { font-size: clamp(2rem, 4vw, 2.7rem); }\n  .faq-wrap .side p { color: var(--ink-soft); margin-top: 14px; }\n  .faq-wrap .side a { color: var(--teal); font-weight: 600; }\n  details { border-bottom: 1px solid var(--line); padding: 22px 0; }\n  details:first-child { border-top: 1px solid var(--line); }\n  summary {\n    list-style: none; cursor: pointer; font-weight: 600; font-size: 1.05rem; display: flex; justify-content: space-between; align-items: center; gap: 20px;\n  }\n  summary::-webkit-details-marker { display: none; }\n  summary::after {\n    content: \"+\"; font-size: 24px; font-weight: 400; color: var(--teal); transition: transform .2s ease; line-height: 1;\n  }\n  details[open] summary::after { transform: rotate(45deg); }\n  details p { margin-top: 12px; color: var(--ink-soft); max-width: 44em; }\n\n  /* Final CTA */\n  .final {\n    background: linear-gradient(160deg, var(--teal) 0%, var(--teal-deep) 60%, var(--ink) 100%);\n    color: var(--white); text-align: center; overflow: hidden; padding: clamp(80px, 10vw, 130px) 0;\n  }\n  .final h2 { font-size: clamp(2.3rem, 5vw, 3.6rem); max-width: 16em; margin: 0 auto; }\n  .final p { margin: 20px auto 34px; max-width: 34em; color: rgba(255,255,255,.82); font-size: 1.12rem; }\n  .final .hero-ctas { justify-content: center; }\n  .final .btn-ghost { color: var(--white); border-color: rgba(255,255,255,.4); }\n  .final .btn-ghost:hover { border-color: var(--white); }\n  .final .wave { position: absolute; left: 0; right: 0; bottom: 0; opacity: .12; }\n\n  /* Footer */\n  footer { background: var(--white); border-top: 1px solid var(--line); padding: 64px 0 36px; font-size: 14.5px; }\n  .foot-grid { display: grid; grid-template-columns: 2fr repeat(3, 1fr); gap: 40px; }\n  .foot-grid p { color: var(--ink-soft); margin-top: 14px; max-width: 26em; }\n  .foot-grid h4 { font-size: 13px; text-transform: uppercase; letter-spacing: .08em; color: var(--ink-soft); margin-bottom: 14px; }\n  .foot-grid ul { list-style: none; display: grid; gap: 10px; }\n  .foot-grid ul a:hover { color: var(--teal); }\n  .foot-base { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--line); color: var(--ink-soft); font-size: 13.5px; }\n\n  /* Responsive */\n  @media (max-width: 980px) {\n    .hero-grid, .rhythm-grid, .faq-wrap { grid-template-columns: 1fr; }\n    .board { transform: none; }\n    .float-chip { right: 12px; bottom: -18px; }\n    .nav-links { display: none; }\n    .problem-grid, .feature-grid, .pricing-grid, .steps { grid-template-columns: 1fr; }\n    .steps { gap: 40px; }\n    .strip-grid { grid-template-columns: repeat(2, 1fr); }\n    .foot-grid { grid-template-columns: 1fr 1fr; }\n  }\n  @media (max-width: 600px) {\n    .nav-actions .login { display: none; }\n    .days { gap: 6px; }\n    .day { padding: 8px 5px; min-height: 220px; }\n    .card { font-size: 11px; padding: 7px 7px; }\n    .card .meta { display: none; }\n    .day-name small { display: none; }\n    .avatars .av:nth-child(n+4) { display: none; }\n    .tl-item { grid-template-columns: 1fr; gap: 6px; }\n  }\n</style>\n</head>\n<body>\n\n<header class=\"site\">\n  <div class=\"wrap nav\">\n    <a href=\"#top\" class=\"logo\" aria-label=\"Tidepool home\">\n      <svg width=\"28\" height=\"28\" viewBox=\"0 0 28 28\" aria-hidden=\"true\">\n        <circle cx=\"14\" cy=\"14\" r=\"13\" fill=\"#0b2a3a\"/>\n        <path d=\"M4 12c2.5-2.2 5-2.2 7.5 0s5 2.2 7.5 0 3-1.6 5-.4\" fill=\"none\" stroke=\"#7fd1c0\" stroke-width=\"2.4\" stroke-linecap=\"round\"/>\n        <path d=\"M4 18c2.5-2.2 5-2.2 7.5 0s5 2.2 7.5 0 3-1.6 5-.4\" fill=\"none\" stroke=\"#ff7a59\" stroke-width=\"2.4\" stroke-linecap=\"round\"/>\n      </svg>\n      Tidepool\n    </a>\n    <nav class=\"nav-links\" aria-label=\"Primary\">\n      <a href=\"#features\">Features</a>\n      <a href=\"#how\">How it works</a>\n      <a href=\"#pricing\">Pricing</a>\n      <a href=\"#faq\">FAQ</a>\n    </nav>\n    <div class=\"nav-actions\">\n      <a href=\"#\" class=\"login\">Log in</a>\n      <a href=\"#start\" class=\"btn btn-primary btn-sm\">Start free</a>\n    </div>\n  </div>\n</header>\n\n<main id=\"top\">\n\n  <!-- HERO -->\n  <section class=\"hero\">\n    <div class=\"wrap hero-grid\">\n      <div>\n        <span class=\"eyebrow\">Weekly planning for small teams</span>\n        <h1>Plan your week <em>together</em>, before it plans you.</h1>\n        <p class=\"lede\">Tidepool gives teams of two to twelve one shared board for the week. Everyone sees what's in motion, what's blocked, and what can wait, in about ten minutes on Monday.</p>\n        <div class=\"hero-ctas\">\n          <a href=\"#start\" class=\"btn btn-primary\">Start planning free</a>\n          <a href=\"#how\" class=\"btn btn-ghost\">See how it works</a>\n        </div>\n        <p class=\"hero-note\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          Free for teams up to five. No credit card required.\n        </p>\n      </div>\n\n      <div class=\"board-wrap\" aria-hidden=\"true\">\n        <div class=\"board\">\n          <div class=\"board-top\">\n            <div>\n              <strong>Week of March 9</strong><br>\n              <span>Product & Design \u00b7 6 people</span>\n            </div>\n            <div class=\"avatars\">\n              <div class=\"av\" style=\"background:#13807a\">JM</div>\n              <div class=\"av\" style=\"background:#ff7a59\">AK</div>\n              <div class=\"av\" style=\"background:#7a5ea8\">RS</div>\n              <div class=\"av\" style=\"background:#0b2a3a\">TL</div>\n              <div class=\"av\" style=\"background:#d4a017\">+2</div>\n            </div>\n          </div>\n          <div class=\"days\">\n            <div class=\"day\">\n              <div class=\"day-name\">Mon <small>9</small></div>\n              <div class=\"card coral\">Ship pricing copy<div class=\"meta\"><span>JM</span><span>Focus</span></div></div>\n              <div class=\"card\">Customer call prep<div class=\"meta\"><span>AK</span><span>30m</span></div></div>\n            </div>\n            <div class=\"day today\">\n              <div class=\"day-name\">Tue <small>10</small></div>\n              <div class=\"card sea\">Onboarding flow review<div class=\"meta\"><span>RS</span><span>Today</span></div></div>\n              <div class=\"card coral\">Waiting on legal<div class=\"meta\"><span>TL</span><span>Blocked</span></div></div>\n              <div class=\"card\">Usability sessions<div class=\"meta\"><span>JM</span><span>2pm</span></div></div>\n            </div>\n            <div class=\"day\">\n              <div class=\"day-name\">Wed <small>11</small></div>\n              <div class=\"card plum\">Hiring panel sync<div class=\"meta\"><span>AK</span><span>Team</span></div></div>\n              <div class=\"card done\">Fix nav overflow<div class=\"meta\"><span>RS</span><span>Done</span></div></div>\n            </div>\n            <div class=\"day\">\n              <div class=\"day-name\">Thu <small>12</small></div>\n              <div class=\"card\">Write release notes<div class=\"meta\"><span>TL</span><span>Async</span></div></div>\n              <div class=\"card sea\">Roadmap draft<div class=\"meta\"><span>JM</span><span>Focus</span></div></div>\n            </div>\n            <div class=\"day\">\n              <div class=\"day-name\">Fri <small>13</small></div>\n              <div class=\"card\">Weekly review<div class=\"meta\"><span>All</span><span>30m</span></div></div>\n            </div>\n          </div>\n        </div>\n        <div class=\"float-chip\">\n          <div class=\"ic\">\n            <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          </div>\n          <div><b>Everyone's aligned</b><span>Monday check-in took 9 min</span></div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- PROOF STRIP -->\n  <div class=\"strip\">\n    <div class=\"wrap strip-grid\">\n      <div><b>Under 5 min</b><span>to set up your first board</span></div>\n      <div><b>3 rituals</b><span>built in: Monday, midweek, Friday</span></div>\n      <div><b>Async-first</b><span>works across time zones</span></div>\n      <div><b>Zero status</b><span>meetings needed to stay in sync</span></div>\n    </div>\n  </div>\n\n  <!-- PROBLEM -->\n  <section>\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <span class=\"eyebrow\">The problem</span>\n        <h2>Small teams don't need more tools. They need the same page.</h2>\n        <p>Plans live in five places at once: chat threads, someone's notebook, a doc nobody opens, and the heads of whoever was in the last call.</p>\n      </div>\n      <div class=\"problem-grid\">\n        <div class=\"problem\">\n          <div class=\"num\">01</div>\n          <h3>Monday starts with a scramble</h3>\n          <p>Everyone asks \"what are we doing this week?\" and the answer gets reconstructed from memory every time.</p>\n        </div>\n        <div class=\"problem\">\n          <div class=\"num\">02</div>\n          <h3>Blockers hide in threads</h3>\n          <p>A stuck task gets mentioned once in a busy channel and then quietly ages until someone notices on Thursday.</p>\n        </div>\n        <div class=\"problem\">\n          <div class=\"num\">03</div>\n          <h3>Status meetings eat the afternoon</h3>\n          <p>To avoid the chaos, teams add a daily standup that nobody wants, to report on plans that were never written down.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- FEATURES -->\n  <section class=\"features\" id=\"features\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <span class=\"eyebrow\">Features</span>\n        <h2>One board for the week. Nothing else to maintain.</h2>\n        <p>Tidepool is deliberately small. It does the planning job well and then gets out of the way.</p>\n      </div>\n      <div class=\"feature-grid\">\n        <article class=\"feature\">\n          <div class=\"ico\">\n            <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"3\"/><path d=\"M3 9h18M9 4v16\"/></svg>\n          </div>\n          <h3>A shared weekly board</h3>\n          <p>Five days, one view. Drag work onto the day it will happen, and see the whole team's week at a glance.</p>\n        </article>\n        <article class=\"feature\">\n          <div class=\"ico\">\n            <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 3v4M12 17v4M3 12h4M17 12h4\"/><circle cx=\"12\" cy=\"12\" r=\"4\"/></svg>\n          </div>\n          <h3>Blockers that surface themselves</h3>\n          <p>Mark something blocked and it pins to the top of the board with who's waiting on what, so nothing ages in silence.</p>\n        </article>\n        <article class=\"feature\">\n          <div class=\"ico\">\n            <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 6h16M4 12h10M4 18h7\"/></svg>\n          </div>\n          <h3>Focus limits per person</h3>\n          <p>Set how many deep-work blocks each person can hold. Tidepool warns you before someone's week becomes a wall of commitments.</p>\n        </article>\n        <article class=\"feature\">\n          <div class=\"ico\">\n            <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z\"/></svg>\n          </div>\n          <h3>Async check-ins</h3>\n          <p>Each person answers three short prompts on their own schedule. Teammates see the replies in one digest, not a meeting invite.</p>\n        </article>\n        <article class=\"feature\">\n          <div class=\"ico\">\n            <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M6 8a6 6 0 0 1 12 0c0 7 3 7 3 9H3c0-2 3-2 3-9\"/><path d=\"M10 21a2 2 0 0 0 4 0\"/></svg>\n          </div>\n          <h3>Gentle, useful reminders</h3>\n          <p>A nudge on Friday for unfinished items, and a Monday summary of what carried over. Quiet by default, loud only when it matters.</p>\n        </article>\n        <article class=\"feature\">\n          <div class=\"ico\">\n            <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 19V5M4 19h16\"/><path d=\"M8 15l4-4 3 3 5-6\"/></svg>\n          </div>\n          <h3>A week you can look back on</h3>\n          <p>Every Friday review is saved. See what got done, what kept slipping, and how your planning has changed over quarters.</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <!-- HOW IT WORKS -->\n  <section id=\"how\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <span class=\"eyebrow\">How it works</span>\n        <h2>Three moments a week. About twenty minutes total.</h2>\n        <p>Tidepool is built around a simple rhythm, so planning becomes a habit instead of a project.</p>\n      </div>\n      <div class=\"steps\">\n        <div class=\"step\">\n          <h3>Set the week</h3>\n          <p>On Monday, each person drops their commitments onto the board. Pull in what carried over from last Friday with one click.</p>\n          <ul>\n            <li>Drag tasks onto days</li>\n            <li>Mark blockers and who they wait on</li>\n            <li>Confirm your focus blocks</li>\n          </ul>\n        </div>\n        <div class=\"step\">\n          <h3>Keep it honest</h3>\n          <p>Midweek, the board updates itself as work moves. Anyone can see what changed without asking for a status update.</p>\n          <ul>\n            <li>Move cards as plans shift</li>\n            <li>Leave a one-line note, no thread needed</li>\n            <li>Watch for overloaded days</li>\n          </ul>\n        </div>\n        <div class=\"step\">\n          <h3>Close the loop</h3>\n          <p>On Friday, review the board together or on your own time. Unfinished work rolls forward on purpose, not by accident.</p>\n          <ul>\n            <li>See completed vs. planned at a glance</li>\n            <li>Carry over or drop, with a reason</li>\n            <li>Save a short retro for the week</li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- RHYTHM -->\n  <section class=\"rhythm\">\n    <div class=\"wrap rhythm-grid\">\n      <div>\n        <span class=\"eyebrow\">The weekly rhythm</span>\n        <h2>Designed around how small teams actually work.</h2>\n        <p class=\"lead\">Big-company planning tools assume a project manager. Tidepool assumes you're all in the same few channels and need a single source of truth that doesn't demand upkeep.</p>\n      </div>\n      <div class=\"timeline\">\n        <div class=\"tl-item\">\n          <time>Mon</time>\n          <div>\n            <h4>Tide in</h4>\n            <p>Set the week in ten minutes. Pull in carryovers and name the one thing that matters most.</p>\n          </div>\n        </div>\n        <div class=\"tl-item\">\n          <time>Wed</time>\n          <div>\n            <h4>Check the current</h4>\n            <p>A quick async pulse: anything blocked, anything slipping, anything that needs another pair of eyes.</p>\n          </div>\n        </div>\n        <div class=\"tl-item\">\n          <time>Fri</time>\n          <div>\n            <h4>Pull back out</h4>\n            <p>Review what shipped, decide what rolls forward, and save a line or two about what you learned.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- PRICING -->\n  <section id=\"pricing\">\n    <div class=\"wrap\">\n      <div class=\"section-head\" style=\"margin-inline:auto;text-align:center\">\n        <span class=\"eyebrow\">Pricing</span>\n        <h2>Start free. Pay only when your team grows.</h2>\n        <p>Every plan includes the weekly board, async check-ins, and the Friday review. No seat minimums on the free tier.</p>\n      </div>\n      <div class=\"pricing-grid\">\n        <div class=\"plan\">\n          <h3>Starter</h3>\n          <p class=\"desc\">For a small crew getting their first real week on one page.</p>\n          <div class=\"price\"><strong>$0</strong><span>forever</span></div>\n          <ul>\n            <li>\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n              Up to 5 people\n            </li>\n            <li>\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n              One active board\n            </li>\n            <li>\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n              Blockers and Friday review\n            </li>\n            <li>\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n              4 weeks of history\n            </li>\n          </ul>\n          <a href=\"#start\" class=\"btn btn-ghost\">Start free</a>\n        </div>\n\n        <div class=\"plan featured\">\n          <span class=\"tag\">Most popular</span>\n          <h3>Team</h3>\n          <p class=\"desc\">For growing teams that want focus limits, digests, and long-term history.</p>\n          <div class=\"price\"><strong>$6</strong><span>per person / month, billed annually</span></div>\n          <ul>\n            <li>\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n              Up to 12 people\n            </li>\n            <li>\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n              Focus limits and overload warnings\n            </li>\n            <li>\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n              Async check-ins and weekly digest\n            </li>\n            <li>\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n              Unlimited history and exports\n            </li>\n          </ul>\n          <a href=\"#start\" class=\"btn btn-primary\">Start a 14-day trial</a>\n        </div>\n\n        <div class=\"plan\">\n          <h3>Studio</h3>\n          <p class=\"desc\">For organizations running several teams that need shared visibility.</p>\n          <div class=\"price\"><strong>Custom</strong></div>\n          <ul>\n            <li>\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n              Unlimited teams and boards\n            </li>\n            <li>\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n              Single sign-on and admin controls\n            </li>\n            <li>\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M3 8.5l3 3 7-7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n              Onboarding help for your leads\n            </li>\n          </ul>\n          <a href=\"#contact\" class=\"btn btn-ghost\">Talk to us</a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- FAQ -->\n  <section id=\"faq\" style=\"padding-top:0\">\n    <div class=\"wrap faq-wrap\">\n      <div class=\"side\">\n        <span class=\"eyebrow\">FAQ</span>\n        <h2 style=\"margin-top:14px\">Questions, answered plainly.</h2>\n        <p>Can't find what you need? Email <a href=\"#contact\">hello@tidepool.example</a> and a real person will reply within a day.</p>\n      </div>\n      <div>\n        <details open>\n          <summary>Who is Tidepool built for?</summary>\n          <p>Teams of two to twelve people who share work and want to see the week together without running a formal project process. It works well for product and design squads, agencies, small support or ops groups, and founding teams.</p>\n        </details>\n        <details>\n          <summary>How is this different from a project management tool?</summary>\n          <p>Project tools track long-running work across months. Tidepool focuses on the next five days. It has no epics, no dependency charts, and no configuration to maintain. If you find yourself wanting Gantt charts, Tidepool is probably not the right fit.</p>\n        </details>\n        <details>\n          <summary>Does everyone need to be online at the same time?</summary>\n          <p>No. The board is designed for async work. Check-ins, blocker notes, and the Friday review all work on each person's schedule, and the Monday summary captures what changed while you were offline.</p>\n        </details>\n        <details>\n          <summary>Does it connect to our calendar or chat app?</summary>\n          <p>Tidepool can read your calendar to show meeting load on each day, and it posts the Monday summary and blocker alerts to a channel you choose. Both are optional and can be turned off at any time.</p>\n        </details>\n        <details>\n          <summary>What happens to my data if I cancel?</summary>\n          <p>You can export every board and review as CSV or Markdown at any time. After cancellation, your data is kept for 30 days in case you change your mind, then permanently deleted.</p>\n        </details>\n      </div>\n    </div>\n  </section>\n\n  <!-- FINAL CTA -->\n  <section class=\"final\" id=\"start\">\n    <svg class=\"wave\" viewBox=\"0 0 1440 160\" preserveAspectRatio=\"none\" aria-hidden=\"true\">\n      <path fill=\"#ffffff\" d=\"M0,64 C240,128 480,0 720,64 C960,128 1200,0 1440,64 L1440,160 L0,160 Z\"/>\n    </svg>\n    <div class=\"wrap\" style=\"position:relative\">\n      <h2>Your team's next week deserves a shared page.</h2>\n      <p>Set up your first board in the time it takes to finish your coffee. Bring your team along when you're ready.</p>\n      <div class=\"hero-ctas\">\n        <a href=\"#\" class=\"btn btn-light\">Start planning free</a>\n        <a href=\"#contact\" class=\"btn btn-ghost\">Book a 15-minute walkthrough</a>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer id=\"contact\">\n  <div class=\"wrap\">\n    <div class=\"foot-grid\">\n      <div>\n        <a href=\"#top\" class=\"logo\">\n          <svg width=\"26\" height=\"26\" viewBox=\"0 0 28 28\" aria-hidden=\"true\">\n            <circle cx=\"14\" cy=\"14\" r=\"13\" fill=\"#0b2a3a\"/>\n            <path d=\"M4 12c2.5-2.2 5-2.2 7.5 0s5 2.2 7.5 0 3-1.6 5-.4\" fill=\"none\" stroke=\"#7fd1c0\" stroke-width=\"2.4\" stroke-linecap=\"round\"/>\n            <path d=\"M4 18c2.5-2.2 5-2.2 7.5 0s5 2.2 7.5 0 3-1.6 5-.4\" fill=\"none\" stroke=\"#ff7a59\" stroke-width=\"2.4\" stroke-linecap=\"round\"/>\n          </svg>\n          Tidepool\n        </a>\n        <p>A weekly planning board for small teams who would rather be doing the work than talking about it.</p>\n      </div>\n      <div>\n        <h4>Product</h4>\n        <ul>\n          <li><a href=\"#features\">Features</a></li>\n          <li><a href=\"#how\">How it works</a></li>\n          <li><a href=\"#pricing\">Pricing</a></li>\n          <li><a href=\"#faq\">FAQ</a></li>\n        </ul>\n      </div>\n      <div>\n        <h4>Company</h4>\n        <ul>\n          <li><a href=\"#\">About</a></li>\n          <li><a href=\"#\">Changelog</a></li>\n          <li><a href=\"#\">Careers</a></li>\n          <li><a href=\"#contact\">Contact</a></li>\n        </ul>\n      </div>\n      <div>\n        <h4>Resources</h4>\n        <ul>\n          <li><a href=\"#\">Weekly ritual guide</a></li>\n          <li><a href=\"#\">Templates</a></li>\n          <li><a href=\"#\">Privacy</a></li>\n          <li><a href=\"#\">Terms</a></li>\n        </ul>\n      </div>\n    </div>\n    <div class=\"foot-base\">\n      <span>\u00a9 2025 Tidepool. Plan the week, keep the tide in.</span>\n      <span>hello@tidepool.example</span>\n    </div>\n  </div>\n</footer>\n\n</body>\n</html>\n"}