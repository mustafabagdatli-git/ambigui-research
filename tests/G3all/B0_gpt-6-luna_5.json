{"arm": "direct", "model": "openai/gpt-6-luna", "i": 5, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <meta name=\"theme-color\" content=\"#f6f7f1\" />\n  <title>Tidepool \u2014 Make room for a week that works</title>\n  <style>\n    :root {\n      --ink: #153c38;\n      --ink-soft: #56706a;\n      --green: #286b5d;\n      --green-dark: #1d5148;\n      --mint: #dcece2;\n      --mint-light: #edf4ec;\n      --coral: #f2a183;\n      --cream: #f6f7f1;\n      --white: #fffefa;\n      --line: #e6e9df;\n      --shadow: 0 24px 70px rgba(26, 63, 55, 0.13);\n    }\n\n    * { box-sizing: border-box; }\n\n    html { scroll-behavior: smooth; }\n\n    body {\n      margin: 0;\n      color: var(--ink);\n      background: var(--cream);\n      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      -webkit-font-smoothing: antialiased;\n    }\n\n    a { color: inherit; text-decoration: none; }\n\n    .page-shell {\n      overflow: hidden;\n      min-height: 100vh;\n      background:\n        radial-gradient(ellipse at 82% 15%, rgba(218, 235, 222, 0.7) 0, rgba(218, 235, 222, 0) 31rem),\n        var(--cream);\n    }\n\n    .container {\n      width: min(1160px, calc(100% - 48px));\n      margin: 0 auto;\n    }\n\n    .site-header {\n      height: 84px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      border-bottom: 1px solid rgba(21, 60, 56, 0.08);\n    }\n\n    .brand {\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      font-size: 21px;\n      font-weight: 750;\n      letter-spacing: -0.06em;\n    }\n\n    .brand-mark {\n      width: 31px;\n      height: 31px;\n      display: grid;\n      place-items: center;\n      border-radius: 10px;\n      color: white;\n      background: var(--green);\n    }\n\n    .brand-mark svg { width: 21px; height: 21px; }\n\n    .nav-links {\n      display: flex;\n      align-items: center;\n      gap: 34px;\n      margin-left: 90px;\n      color: #536d66;\n      font-size: 13px;\n      font-weight: 600;\n    }\n\n    .nav-links a:hover, .login:hover { color: var(--green); }\n\n    .header-actions {\n      display: flex;\n      align-items: center;\n      gap: 24px;\n      font-size: 13px;\n      font-weight: 650;\n    }\n\n    .login { color: #536d66; }\n\n    .button {\n      min-height: 46px;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: 9px;\n      padding: 0 20px;\n      border: 1px solid transparent;\n      border-radius: 9px;\n      background: var(--green);\n      color: white;\n      font-size: 13px;\n      font-weight: 700;\n      box-shadow: 0 5px 12px rgba(40, 107, 93, 0.12);\n      transition: transform 160ms ease, background 160ms ease, box-shadow 160ms ease;\n    }\n\n    .button:hover {\n      transform: translateY(-2px);\n      background: var(--green-dark);\n      box-shadow: 0 9px 18px rgba(40, 107, 93, 0.18);\n    }\n\n    .button svg { width: 15px; height: 15px; }\n\n    .button.secondary {\n      color: var(--ink);\n      background: rgba(255, 254, 250, 0.72);\n      border-color: #dce2d9;\n      box-shadow: none;\n    }\n\n    .button.secondary:hover { background: white; }\n\n    .hero {\n      position: relative;\n      display: grid;\n      grid-template-columns: 0.91fr 1.09fr;\n      align-items: center;\n      gap: 48px;\n      padding: 86px 0 76px;\n    }\n\n    .hero-copy { position: relative; z-index: 1; }\n\n    .eyebrow {\n      display: inline-flex;\n      align-items: center;\n      gap: 9px;\n      margin-bottom: 22px;\n      color: var(--green);\n      font-size: 11px;\n      font-weight: 800;\n      letter-spacing: 0.13em;\n      text-transform: uppercase;\n    }\n\n    .eyebrow-dot {\n      width: 7px;\n      height: 7px;\n      border-radius: 50%;\n      background: var(--coral);\n      box-shadow: 0 0 0 4px rgba(242, 161, 131, 0.18);\n    }\n\n    h1 {\n      max-width: 530px;\n      margin: 0;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: clamp(49px, 6vw, 73px);\n      font-weight: 500;\n      line-height: 0.99;\n      letter-spacing: -0.06em;\n    }\n\n    h1 em {\n      color: var(--green);\n      font-weight: 500;\n    }\n\n    .hero-description {\n      max-width: 440px;\n      margin: 24px 0 29px;\n      color: var(--ink-soft);\n      font-size: 16px;\n      line-height: 1.75;\n    }\n\n    .hero-actions {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 11px;\n    }\n\n    .tiny-note {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      margin-top: 17px;\n      color: #74857e;\n      font-size: 11px;\n    }\n\n    .tiny-note svg { width: 14px; height: 14px; color: var(--green); }\n\n    .hero-art {\n      position: relative;\n      min-width: 0;\n      padding: 16px 0 19px 11px;\n    }\n\n    .art-blob {\n      position: absolute;\n      z-index: 0;\n      top: 0;\n      right: -9%;\n      width: 88%;\n      height: 96%;\n      border-radius: 48% 52% 45% 55% / 52% 43% 57% 48%;\n      background: #e2eee3;\n      transform: rotate(-8deg);\n    }\n\n    .sparkle {\n      position: absolute;\n      z-index: 2;\n      top: -3px;\n      right: 12%;\n      color: #e69574;\n      font-size: 28px;\n      transform: rotate(12deg);\n    }\n\n    .dashboard {\n      position: relative;\n      z-index: 1;\n      overflow: hidden;\n      border: 1px solid rgba(27, 69, 61, 0.12);\n      border-radius: 17px;\n      background: var(--white);\n      box-shadow: var(--shadow);\n      transform: rotate(1.5deg);\n    }\n\n    .dash-topbar {\n      height: 52px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 0 19px;\n      border-bottom: 1px solid #edf0e9;\n      background: #fffefa;\n    }\n\n    .dash-brand {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      font-size: 12px;\n      font-weight: 750;\n      letter-spacing: -0.03em;\n    }\n\n    .mini-mark {\n      width: 20px;\n      height: 20px;\n      display: grid;\n      place-items: center;\n      border-radius: 6px;\n      background: var(--green);\n      color: white;\n    }\n\n    .mini-mark svg { width: 14px; height: 14px; }\n\n    .dash-top-right {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      color: #6f8078;\n      font-size: 9px;\n      font-weight: 650;\n    }\n\n    .avatar-stack { display: flex; padding-left: 5px; }\n\n    .avatar {\n      width: 23px;\n      height: 23px;\n      display: grid;\n      place-items: center;\n      margin-left: -5px;\n      border: 2px solid white;\n      border-radius: 50%;\n      color: #315f51;\n      background: #e6c2a8;\n      font-size: 7px;\n      font-weight: 800;\n    }\n\n    .avatar:nth-child(2) { background: #c9dbd0; color: #345d51; }\n    .avatar:nth-child(3) { background: #f0d6a6; color: #805f38; }\n    .avatar:nth-child(4) { background: #d8c9e4; color: #5f4d70; }\n\n    .dash-body {\n      display: grid;\n      grid-template-columns: 120px 1fr;\n      min-height: 336px;\n    }\n\n    .dash-sidebar {\n      padding: 21px 12px;\n      border-right: 1px solid #edf0e9;\n      background: #fcfcf8;\n    }\n\n    .workspace-label {\n      padding: 0 8px;\n      margin-bottom: 14px;\n      color: #98a49c;\n      font-size: 8px;\n      font-weight: 800;\n      letter-spacing: 0.11em;\n      text-transform: uppercase;\n    }\n\n    .side-link {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      padding: 9px 8px;\n      margin-bottom: 4px;\n      border-radius: 6px;\n      color: #7b8982;\n      font-size: 9px;\n      font-weight: 650;\n    }\n\n    .side-link.active {\n      color: var(--green);\n      background: #eaf2e9;\n    }\n\n    .side-icon {\n      width: 13px;\n      height: 13px;\n      display: grid;\n      place-items: center;\n      font-size: 11px;\n    }\n\n    .sidebar-bottom {\n      margin-top: 62px;\n      padding: 12px 10px;\n      border-radius: 8px;\n      background: #f0f4eb;\n    }\n\n    .sidebar-bottom strong {\n      display: block;\n      margin-bottom: 4px;\n      font-size: 9px;\n    }\n\n    .sidebar-bottom span {\n      display: block;\n      color: #75847a;\n      font-size: 8px;\n      line-height: 1.5;\n    }\n\n    .dash-content { padding: 20px 20px 18px; }\n\n    .dash-heading {\n      display: flex;\n      align-items: flex-start;\n      justify-content: space-between;\n      margin-bottom: 16px;\n    }\n\n    .dash-heading h2 {\n      margin: 0 0 4px;\n      font-size: 16px;\n      letter-spacing: -0.04em;\n    }\n\n    .dash-heading p {\n      margin: 0;\n      color: #849189;\n      font-size: 8px;\n    }\n\n    .week-button {\n      padding: 6px 9px;\n      border: 1px solid #e6eae2;\n      border-radius: 5px;\n      color: #536d66;\n      font-size: 8px;\n      font-weight: 650;\n    }\n\n    .week-grid {\n      display: grid;\n      grid-template-columns: 39px repeat(5, 1fr);\n      border-top: 1px solid #edf0e9;\n      border-left: 1px solid #edf0e9;\n    }\n\n    .grid-cell {\n      min-height: 49px;\n      padding: 5px 4px;\n      border-right: 1px solid #edf0e9;\n      border-bottom: 1px solid #edf0e9;\n      background: #fffefa;\n    }\n\n    .grid-cell.day {\n      min-height: 39px;\n      padding: 8px 2px 5px;\n      color: #77867e;\n      text-align: center;\n      font-size: 8px;\n      font-weight: 700;\n    }\n\n    .grid-cell.day strong {\n      display: block;\n      margin-top: 3px;\n      color: var(--ink);\n      font-size: 10px;\n    }\n\n    .grid-cell.time {\n      padding: 8px 3px 0;\n      color: #a0aaa2;\n      text-align: center;\n      font-size: 7px;\n    }\n\n    .event {\n      min-height: 34px;\n      padding: 5px 5px;\n      border-left: 2px solid #76a98c;\n      border-radius: 3px;\n      background: #e8f1e7;\n      color: #365f4d;\n      font-size: 7px;\n      font-weight: 700;\n      line-height: 1.35;\n    }\n\n    .event small {\n      display: block;\n      margin-top: 2px;\n      color: #6f8977;\n      font-size: 6px;\n      font-weight: 550;\n    }\n\n    .event.coral {\n      border-color: #e58f70;\n      background: #fbede4;\n      color: #92583e;\n    }\n\n    .event.blue {\n      border-color: #83a9b8;\n      background: #eaf1f2;\n      color: #496a75;\n    }\n\n    .event.purple {\n      border-color: #a48dba;\n      background: #f1edf5;\n      color: #6d5a7b;\n    }\n\n    .event.empty { background: transparent; border: 0; }\n\n    .dash-footer {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding-top: 14px;\n      color: #708078;\n      font-size: 8px;\n    }\n\n    .focus-label {\n      display: flex;\n      align-items: center;\n      gap: 6px;\n    }\n\n    .focus-label span {\n      width: 7px;\n      height: 7px;\n      border-radius: 50%;\n      background: #e99b7b;\n    }\n\n    .progress {\n      width: 76px;\n      height: 5px;\n      overflow: hidden;\n      border-radius: 99px;\n      background: #edf0e9;\n    }\n\n    .progress i {\n      display: block;\n      width: 65%;\n      height: 100%;\n      border-radius: inherit;\n      background: #78a98b;\n    }\n\n    .float-note {\n      position: absolute;\n      z-index: 2;\n      right: -12px;\n      bottom: 42px;\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      padding: 11px 14px;\n      border: 1px solid #e8ece3;\n      border-radius: 10px;\n      background: white;\n      box-shadow: 0 10px 28px rgba(26, 63, 55, 0.12);\n      transform: rotate(-2deg);\n    }\n\n    .note-check {\n      width: 24px;\n      height: 24px;\n      display: grid;\n      place-items: center;\n      border-radius: 7px;\n      background: #e6f1e6;\n      color: var(--green);\n      font-size: 13px;\n      font-weight: 800;\n    }\n\n    .float-note strong {\n      display: block;\n      margin-bottom: 2px;\n      font-size: 9px;\n    }\n\n    .float-note small {\n      color: #85928a;\n      font-size: 8px;\n    }\n\n    .social-proof {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 24px;\n      padding: 25px 0 29px;\n      border-top: 1px solid rgba(21, 60, 56, 0.1);\n      border-bottom: 1px solid rgba(21, 60, 56, 0.1);\n    }\n\n    .proof-copy {\n      max-width: 245px;\n      color: #718179;\n      font-size: 11px;\n      line-height: 1.5;\n    }\n\n    .proof-copy strong {\n      display: block;\n      margin-bottom: 4px;\n      color: var(--ink);\n      font-size: 12px;\n    }\n\n    .team-list {\n      display: flex;\n      align-items: center;\n      gap: clamp(18px, 4vw, 49px);\n      color: #829087;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: 18px;\n      font-weight: 700;\n      letter-spacing: -0.05em;\n    }\n\n    .team-list span:nth-child(2) { font-family: ui-sans-serif, system-ui, sans-serif; font-size: 13px; letter-spacing: -0.04em; }\n    .team-list span:nth-child(3) { font-style: italic; }\n    .team-list span:nth-child(4) { font-family: ui-sans-serif, system-ui, sans-serif; font-size: 15px; letter-spacing: 0.02em; }\n\n    .features {\n      padding: 90px 0 98px;\n    }\n\n    .section-heading {\n      max-width: 570px;\n      margin: 0 auto 42px;\n      text-align: center;\n    }\n\n    .section-heading .eyebrow { margin-bottom: 13px; }\n\n    .section-heading h2 {\n      margin: 0;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: clamp(34px, 4vw, 48px);\n      font-weight: 500;\n      letter-spacing: -0.055em;\n      line-height: 1.05;\n    }\n\n    .section-heading p {\n      max-width: 440px;\n      margin: 14px auto 0;\n      color: var(--ink-soft);\n      font-size: 14px;\n      line-height: 1.7;\n    }\n\n    .feature-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 16px;\n    }\n\n    .feature-card {\n      min-height: 216px;\n      padding: 24px 24px 22px;\n      border: 1px solid #e5e9df;\n      border-radius: 13px;\n      background: rgba(255, 254, 250, 0.68);\n      transition: transform 180ms ease, box-shadow 180ms ease;\n    }\n\n    .feature-card:hover {\n      transform: translateY(-4px);\n      box-shadow: 0 12px 30px rgba(26, 63, 55, 0.08);\n    }\n\n    .feature-icon {\n      width: 38px;\n      height: 38px;\n      display: grid;\n      place-items: center;\n      margin-bottom: 22px;\n      border-radius: 11px;\n      background: #e7f0e6;\n      color: var(--green);\n    }\n\n    .feature-card:nth-child(2) .feature-icon { background: #faece2; color: #b56d4d; }\n    .feature-card:nth-child(3) .feature-icon { background: #e9eff0; color: #587e87; }\n    .feature-icon svg { width: 19px; height: 19px; }\n\n    .feature-card h3 {\n      margin: 0 0 8px;\n      font-size: 15px;\n      letter-spacing: -0.03em;\n    }\n\n    .feature-card p {\n      max-width: 290px;\n      margin: 0;\n      color: #718179;\n      font-size: 12px;\n      line-height: 1.65;\n    }\n\n    .bottom-cta {\n      position: relative;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 24px;\n      overflow: hidden;\n      padding: 36px 42px;\n      margin-bottom: 44px;\n      border-radius: 17px;\n      background: var(--green-dark);\n      color: white;\n    }\n\n    .bottom-cta::after {\n      position: absolute;\n      content: \"\";\n      width: 260px;\n      height: 260px;\n      top: -142px;\n      right: 17%;\n      border: 1px solid rgba(255,255,255,0.13);\n      border-radius: 50%;\n      box-shadow: 0 0 0 24px rgba(255,255,255,0.035), 0 0 0 49px rgba(255,255,255,0.025);\n    }\n\n    .bottom-cta h2 {\n      position: relative;\n      z-index: 1;\n      max-width: 510px;\n      margin: 0;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: clamp(27px, 3vw, 36px);\n      font-weight: 500;\n      letter-spacing: -0.045em;\n      line-height: 1.08;\n    }\n\n    .bottom-cta .button {\n      position: relative;\n      z-index: 1;\n      flex: 0 0 auto;\n      color: var(--green-dark);\n      background: #f4f4e9;\n      box-shadow: none;\n    }\n\n    .bottom-cta .button:hover { background: white; }\n\n    .site-footer {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 0 0 27px;\n      color: #839087;\n      font-size: 10px;\n    }\n\n    .footer-links { display: flex; gap: 22px; }\n\n    .footer-links a:hover { color: var(--green); }\n\n    @media (max-width: 900px) {\n      .nav-links { gap: 20px; margin-left: 20px; }\n      .hero { grid-template-columns: 0.9fr 1.1fr; gap: 22px; padding: 70px 0 62px; }\n      .dash-body { grid-template-columns: 98px 1fr; }\n      .dash-content { padding: 17px 14px 14px; }\n      .dash-sidebar { padding-left: 8px; padding-right: 8px; }\n      .float-note { right: -4px; }\n      .team-list { gap: 20px; }\n    }\n\n    @media (max-width: 700px) {\n      .container { width: min(100% - 36px, 520px); }\n      .site-header { height: 70px; }\n      .nav-links, .login { display: none; }\n      .header-actions { gap: 0; }\n      .header-actions .button { min-height: 40px; padding: 0 14px; font-size: 12px; }\n      .hero { grid-template-columns: 1fr; gap: 43px; padding: 61px 0 52px; }\n      .hero-copy { max-width: 520px; }\n      h1 { max-width: 480px; font-size: clamp(48px, 12vw, 68px); }\n      .hero-description { margin-top: 20px; font-size: 15px; }\n      .hero-art { width: 100%; max-width: 570px; margin: 0 auto; padding-left: 0; }\n      .dashboard { transform: rotate(0.5deg); }\n      .float-note { right: -4px; bottom: 23px; }\n      .social-proof { align-items: flex-start; flex-direction: column; gap: 17px; padding: 22px 0; }\n      .proof-copy { max-width: none; }\n      .team-list { width: 100%; justify-content: space-between; gap: 10px; font-size: 16px; }\n      .features { padding: 68px 0 70px; }\n      .feature-grid { grid-template-columns: 1fr; gap: 11px; }\n      .feature-card { min-height: auto; padding: 20px; }\n      .feature-icon { margin-bottom: 15px; }\n      .bottom-cta { align-items: flex-start; flex-direction: column; padding: 29px 25px; }\n      .bottom-cta .button { min-height: 43px; }\n    }\n\n    @media (max-width: 430px) {\n      .dash-body { grid-template-columns: 1fr; }\n      .dash-sidebar { display: none; }\n      .dash-topbar { padding: 0 13px; }\n      .dash-content { padding: 16px 11px 13px; }\n      .week-grid { grid-template-columns: 31px repeat(5, 1fr); }\n      .grid-cell { padding: 4px 2px; }\n      .grid-cell.day { font-size: 7px; }\n      .grid-cell.day strong { font-size: 9px; }\n      .event { font-size: 6px; }\n      .event small { font-size: 5px; }\n      .dash-top-right { gap: 6px; }\n      .dash-top-right > span:first-child { display: none; }\n      .float-note { right: -2px; bottom: 11px; padding: 9px 10px; }\n      .team-list { font-size: 14px; }\n      .team-list span:nth-child(2) { font-size: 11px; }\n      .team-list span:nth-child(4) { font-size: 13px; }\n      .site-footer { align-items: flex-start; flex-direction: column; gap: 13px; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      html { scroll-behavior: auto; }\n      *, *::before, *::after { transition-duration: 0.01ms !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"page-shell\">\n    <div class=\"container\">\n      <header class=\"site-header\">\n        <a class=\"brand\" href=\"#\" aria-label=\"Tidepool home\">\n          <span class=\"brand-mark\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\">\n              <path d=\"M4 14.2c2.1 0 2.1-2.1 4.2-2.1s2.1 2.1 4.2 2.1 2.1-2.1 4.2-2.1 2.1 2.1 4.2 2.1M4 18.2c2.1 0 2.1-2.1 4.2-2.1s2.1 2.1 4.2 2.1 2.1-2.1 4.2-2.1 2.1 2.1 4.2 2.1\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n              <path d=\"M6.4 8.3a5.6 5.6 0 0 1 11.2 0\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n            </svg>\n          </span>\n          tidepool\n        </a>\n\n        <nav class=\"nav-links\" aria-label=\"Main navigation\">\n          <a href=\"#how-it-works\">How it works</a>\n          <a href=\"#features\">Why Tidepool</a>\n          <a href=\"#teams\">For teams</a>\n        </nav>\n\n        <div class=\"header-actions\">\n          <a class=\"login\" href=\"#login\">Log in</a>\n          <a class=\"button\" href=\"#get-started\">Get started <span aria-hidden=\"true\">\u2192</span></a>\n        </div>\n      </header>\n\n      <main>\n        <section class=\"hero\" aria-labelledby=\"hero-title\">\n          <div class=\"hero-copy\">\n            <div class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> A calmer way to plan together</div>\n            <h1 id=\"hero-title\">Make room for a week that <em>works.</em></h1>\n            <p class=\"hero-description\">\n              Tidepool brings your team\u2019s plans, priorities, and people into one clear view\u2014so everyone can do their best work without the busywork.\n            </p>\n            <div class=\"hero-actions\">\n              <a class=\"button\" href=\"#get-started\">Plan your week <span aria-hidden=\"true\">\u2192</span></a>\n              <a class=\"button secondary\" href=\"#how-it-works\">See how it works</a>\n            </div>\n            <div class=\"tiny-note\">\n              <svg viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\">\n                <path d=\"m5 10.2 3.1 3.1L15.5 6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n                <circle cx=\"10\" cy=\"10\" r=\"8\" stroke=\"currentColor\" stroke-width=\"1.4\"/>\n              </svg>\n              Free to start \u00b7 No credit card needed\n            </div>\n          </div>\n\n          <div class=\"hero-art\" aria-label=\"Preview of the Tidepool weekly planning workspace\">\n            <div class=\"art-blob\"></div>\n            <span class=\"sparkle\" aria-hidden=\"true\">\u2733</span>\n            <div class=\"dashboard\">\n              <div class=\"dash-topbar\">\n                <div class=\"dash-brand\">\n                  <span class=\"mini-mark\" aria-hidden=\"true\">\n                    <svg viewBox=\"0 0 24 24\" fill=\"none\">\n                      <path d=\"M4 14c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2M4 18c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n                    </svg>\n                  </span>\n                  Juniper Studio\n                </div>\n                <div class=\"dash-top-right\">\n                  <span>Team this week</span>\n                  <div class=\"avatar-stack\" aria-label=\"Four team members\">\n                    <span class=\"avatar\">AM</span>\n                    <span class=\"avatar\">JL</span>\n                    <span class=\"avatar\">RK</span>\n                    <span class=\"avatar\">+2</span>\n                  </div>\n                </div>\n              </div>\n\n              <div class=\"dash-body\">\n                <aside class=\"dash-sidebar\" aria-label=\"Workspace menu\">\n                  <div class=\"workspace-label\">Workspace</div>\n                  <div class=\"side-link\"><span class=\"side-icon\">\u2302</span> Overview</div>\n                  <div class=\"side-link active\"><span class=\"side-icon\">\u25a6</span> Weekly plan</div>\n                  <div class=\"side-link\"><span class=\"side-icon\">\u25f7</span> My focus</div>\n                  <div class=\"side-link\"><span class=\"side-icon\">\u2637</span> Projects</div>\n                  <div class=\"sidebar-bottom\">\n                    <strong>Small steps add up.</strong>\n                    <span>2 of 3 team priorities are on track.</span>\n                  </div>\n                </aside>\n\n                <div class=\"dash-content\">\n                  <div class=\"dash-heading\">\n                    <div>\n                      <h2>Our week, at a glance</h2>\n                      <p>A little clarity goes a long way.</p>\n                    </div>\n                    <span class=\"week-button\">May 13\u201317&nbsp;\u2304</span>\n                  </div>\n\n                  <div class=\"week-grid\" role=\"img\" aria-label=\"A weekly calendar with team tasks and meetings\">\n                    <div class=\"grid-cell day\"></div>\n                    <div class=\"grid-cell day\">MON<strong>13</strong></div>\n                    <div class=\"grid-cell day\">TUE<strong>14</strong></div>\n                    <div class=\"grid-cell day\">WED<strong>15</strong></div>\n                    <div class=\"grid-cell day\">THU<strong>16</strong></div>\n                    <div class=\"grid-cell day\">FRI<strong>17</strong></div>\n\n                    <div class=\"grid-cell time\">9 am</div>\n                    <div class=\"grid-cell\"><div class=\"event\">Weekly kickoff<small>Everyone \u00b7 30m</small></div></div>\n                    <div class=\"grid-cell\"><div class=\"event empty\"></div></div>\n                    <div class=\"grid-cell\"><div class=\"event blue\">Design review<small>Alex \u00b7 45m</small></div></div>\n                    <div class=\"grid-cell\"><div class=\"event empty\"></div></div>\n                    <div class=\"grid-cell\"><div class=\"event coral\">Share progress<small>Team \u00b7 20m</small></div></div>\n\n                    <div class=\"grid-cell time\">11 am</div>\n                    <div class=\"grid-cell\"><div class=\"event purple\">Plan launch<small>Jamie \u00b7 1h</small></div></div>\n                    <div class=\"grid-cell\"><div class=\"event coral\">Customer calls<small>Riley \u00b7 45m</small></div></div>\n                    <div class=\"grid-cell\"><div class=\"event empty\"></div></div>\n                    <div class=\"grid-cell\"><div class=\"event\">Write project brief<small>Alex \u00b7 Focus time</small></div></div>\n                    <div class=\"grid-cell\"><div class=\"event empty\"></div></div>\n\n                    <div class=\"grid-cell time\">1 pm</div>\n                    <div class=\"grid-cell\"><div class=\"event empty\"></div></div>\n                    <div class=\"grid-cell\"><div class=\"event\">Build first draft<small>Jamie \u00b7 Focus time</small></div></div>\n                    <div class=\"grid-cell\"><div class=\"event coral\">Lunch &amp; learn<small>Everyone \u00b7 45m</small></div></div>\n                    <div class=\"grid-cell\"><div class=\"event empty\"></div></div>\n                    <div class=\"grid-cell\"><div class=\"event blue\">Weekly wrap-up<small>Everyone \u00b7 30m</small></div></div>\n\n                    <div class=\"grid-cell time\">3 pm</div>\n                    <div class=\"grid-cell\"><div class=\"event empty\"></div></div>\n                    <div class=\"grid-cell\"><div class=\"event purple\">Review feedback<small>Riley \u00b7 30m</small></div></div>\n                    <div class=\"grid-cell\"><div class=\"event empty\"></div></div>\n                    <div class=\"grid-cell\"><div class=\"event coral\">Design handoff<small>Alex \u00b7 30m</small></div></div>\n                    <div class=\"grid-cell\"><div class=\"event empty\"></div></div>\n                  </div>\n\n                  <div class=\"dash-footer\">\n                    <div class=\"focus-label\"><span></span> Team focus this week</div>\n                    <div class=\"progress\" aria-hidden=\"true\"><i></i></div>\n                    <strong>65%</strong>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <div class=\"float-note\">\n              <span class=\"note-check\" aria-hidden=\"true\">\u2713</span>\n              <span><strong>Everyone\u2019s in the loop</strong><small>Plans updated just now</small></span>\n            </div>\n          </div>\n        </section>\n\n        <section class=\"social-proof\" id=\"teams\" aria-label=\"Teams who plan with Tidepool\">\n          <div class=\"proof-copy\">\n            <strong>Good weeks are a team effort.</strong>\n            Thoughtful teams use Tidepool to make work feel a little lighter.\n          </div>\n          <div class=\"team-list\" aria-label=\"Juniper, fieldnotes, Sunday, and northstar\">\n            <span>juniper</span>\n            <span>fieldnotes</span>\n            <span>sunday</span>\n            <span>northstar</span>\n          </div>\n        </section>\n\n        <section class=\"features\" id=\"features\" aria-labelledby=\"features-title\">\n          <div class=\"section-heading\" id=\"how-it-works\">\n            <div class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> Less juggling, more doing</div>\n            <h2 id=\"features-title\">A shared plan. A better kind of Monday.</h2>\n            <p>Bring the moving pieces together, find your team\u2019s rhythm, and leave a little breathing room in the week.</p>\n          </div>\n\n          <div class=\"feature-grid\">\n            <article class=\"feature-card\">\n              <div class=\"feature-icon\" aria-hidden=\"true\">\n                <svg viewBox=\"0 0 24 24\" fill=\"none\">\n                  <rect x=\"3.5\" y=\"5\" width=\"17\" height=\"15.5\" rx=\"2.5\" stroke=\"currentColor\" stroke-width=\"1.7\"/>\n                  <path d=\"M7.5 3.5v3M16.5 3.5v3M3.5 9.5h17M8 13h3M8 16.5h6\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/>\n                </svg>\n              </div>\n              <h3>See the week together</h3>\n              <p>Make meetings, deadlines, and focus time easy to spot\u2014without another status meeting.</p>\n            </article>\n\n            <article class=\"feature-card\">\n              <div class=\"feature-icon\" aria-hidden=\"true\">\n                <svg viewBox=\"0 0 24 24\" fill=\"none\">\n                  <path d=\"M5 12.5 9.2 17 19 7\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n                  <circle cx=\"12\" cy=\"12\" r=\"9.2\" stroke=\"currentColor\" stroke-width=\"1.6\"/>\n                </svg>\n              </div>\n              <h3>Make priorities feel clear</h3>\n              <p>Agree on what matters most, give it an owner, and keep the team moving in the same direction.</p>\n            </article>\n\n            <article class=\"feature-card\">\n              <div class=\"feature-icon\" aria-hidden=\"true\">\n                <svg viewBox=\"0 0 24 24\" fill=\"none\">\n                  <path d=\"M4 15.5c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2M4 19c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/>\n                  <path d=\"M7 9a5 5 0 0 1 10 0\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/>\n                </svg>\n              </div>\n              <h3>Find a steadier rhythm</h3>\n              <p>Make room for deep work, check in when it helps, and end the week knowing what moved forward.</p>\n            </article>\n          </div>\n        </section>\n\n        <section class=\"bottom-cta\" id=\"get-started\" aria-label=\"Get started with Tidepool\">\n          <h2>Make your next week feel more like yours.</h2>\n          <a class=\"button\" href=\"mailto:hello@tidepool.team\">Start planning for free <span aria-hidden=\"true\">\u2192</span></a>\n        </section>\n      </main>\n\n      <footer class=\"site-footer\">\n        <a class=\"brand\" href=\"#\" aria-label=\"Tidepool home\">\n          <span class=\"brand-mark\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\">\n              <path d=\"M4 14.2c2.1 0 2.1-2.1 4.2-2.1s2.1 2.1 4.2 2.1 2.1-2.1 4.2-2.1 2.1 2.1 4.2 2.1M4 18.2c2.1 0 2.1-2.1 4.2-2.1s2.1 2.1 4.2 2.1 2.1-2.1 4.2-2.1 2.1 2.1 4.2 2.1\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n              <path d=\"M6.4 8.3a5.6 5.6 0 0 1 11.2 0\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n            </svg>\n          </span>\n          tidepool\n        </a>\n        <span>\u00a9 2024 Tidepool. Make space for good work.</span>\n        <nav class=\"footer-links\" aria-label=\"Footer navigation\">\n          <a href=\"#privacy\">Privacy</a>\n          <a href=\"#terms\">Terms</a>\n          <a href=\"mailto:hello@tidepool.team\">Contact</a>\n        </nav>\n      </footer>\n    </div>\n  </div>\n</body>\n</html>\n"}