{"arm": "direct", "model": "z-ai/glm-5.3-flashx", "i": 6, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Tidepool \u2014 Plan your week together</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400&family=Space+Grotesk:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --ink:#12312b;\n    --ink-soft:#3c5a53;\n    --cream:#faf5ec;\n    --cream-2:#f2e9d9;\n    --sea:#0e6f5c;\n    --sea-soft:#dcebe4;\n    --coral:#e2543e;\n    --sand:#efd9b4;\n    --line:#d8cfc0;\n    --radius:14px;\n  }\n  *{margin:0;padding:0;box-sizing:border-box}\n  html{scroll-behavior:smooth}\n  body{\n    font-family:'Space Grotesk',sans-serif;\n    background:var(--cream);\n    color:var(--ink);\n    line-height:1.6;\n    -webkit-font-smoothing:antialiased;\n  }\n  ::selection{background:var(--sand);color:var(--ink)}\n  h1,h2,h3,.serif{font-family:'Fraunces',serif;font-weight:500;letter-spacing:-.01em}\n  .wrap{max-width:1140px;margin:0 auto;padding:0 28px}\n  a{color:inherit;text-decoration:none}\n\n  /* ---------- nav ---------- */\n  nav{\n    position:sticky;top:0;z-index:50;\n    background:rgba(250,245,236,.85);\n    backdrop-filter:blur(10px);\n    border-bottom:1px solid var(--line);\n  }\n  .nav-inner{display:flex;align-items:center;justify-content:space-between;height:68px}\n  .logo{display:flex;align-items:center;gap:10px;font-family:'Fraunces',serif;font-size:22px;font-weight:600}\n  .logo svg{display:block}\n  .nav-links{display:flex;gap:32px;font-size:15px}\n  .nav-links a{color:var(--ink-soft);transition:color .2s}\n  .nav-links a:hover{color:var(--ink)}\n  .btn{\n    display:inline-block;border:none;cursor:pointer;\n    font-family:'Space Grotesk',sans-serif;font-size:15px;font-weight:600;\n    padding:11px 22px;border-radius:999px;\n    background:var(--ink);color:var(--cream);\n    transition:transform .15s ease, background .2s;\n  }\n  .btn:hover{background:var(--sea);transform:translateY(-1px)}\n  .btn.coral{background:var(--coral);color:#fff}\n  .btn.coral:hover{background:#c9432f}\n  .btn.ghost{background:transparent;color:var(--ink);border:1.5px solid var(--ink)}\n  .btn.ghost:hover{background:var(--ink);color:var(--cream)}\n\n  /* ---------- hero ---------- */\n  .hero{padding:76px 0 96px;position:relative;overflow:hidden}\n  .hero-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:64px;align-items:center}\n  .kicker{\n    display:inline-flex;align-items:center;gap:8px;\n    font-size:13px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;\n    color:var(--sea);margin-bottom:22px;\n  }\n  .kicker::before{content:\"\";width:28px;height:2px;background:var(--sea)}\n  .hero h1{font-size:clamp(42px,5.2vw,68px);line-height:1.06;margin-bottom:24px}\n  .hero h1 em{font-style:italic;color:var(--sea)}\n  .hero p{font-size:19px;color:var(--ink-soft);max-width:44ch;margin-bottom:34px}\n  .hero-cta{display:flex;gap:14px;align-items:center;flex-wrap:wrap}\n  .hero-note{font-size:13px;color:var(--ink-soft);margin-top:14px}\n\n  /* ---------- the board (signature) ---------- */\n  .board{\n    background:#fff;border:1px solid var(--line);border-radius:20px;\n    padding:22px;box-shadow:0 24px 60px -30px rgba(18,49,43,.35);\n    user-select:none;\n  }\n  .board-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}\n  .board-head .week{font-family:'Fraunces',serif;font-size:17px;font-weight:600}\n  .board-hint{font-size:12px;color:var(--ink-soft)}\n  .days{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}\n  .day{background:var(--cream);border-radius:12px;padding:10px 8px 12px;min-height:230px;position:relative;transition:background .2s, outline-color .2s;outline:2px solid transparent}\n  .day.dragover{outline:2px dashed var(--sea);background:var(--sea-soft)}\n  .day h4{font-size:12px;letter-spacing:.08em;text-transform:uppercase;text-align:center;margin-bottom:4px}\n  .day h4 span{display:block;font-family:'Space Grotesk',sans-serif;font-weight:400;letter-spacing:0;text-transform:none;color:var(--ink-soft);font-size:11px;margin-top:1px}\n  .tide{height:8px;margin:6px auto 12px;width:82%;display:block}\n  .tide path{transition:d .45s ease}\n  .chip{\n    background:#fff;border:1px solid var(--line);border-radius:9px;\n    padding:8px 9px;margin-bottom:8px;font-size:12.5px;line-height:1.35;\n    cursor:grab;position:relative;\n    box-shadow:0 1px 2px rgba(18,49,43,.08);\n    transition:transform .15s ease, box-shadow .15s ease, opacity .15s;\n  }\n  .chip small{display:block;color:var(--ink-soft);font-size:11px;margin-top:2px}\n  .chip .who{position:absolute;top:-7px;right:-5px;width:18px;height:18px;border-radius:50%;\n    font-size:9.5px;font-weight:600;color:#fff;display:flex;align-items:center;justify-content:center;border:2px solid var(--cream)}\n  .chip.dragging{opacity:.35;cursor:grabbing}\n  .chip.float{\n    position:fixed;z-index:100;pointer-events:none;cursor:grabbing;\n    transform:rotate(3deg) scale(1.05);\n    box-shadow:0 14px 30px -8px rgba(18,49,43,.4);\n  }\n  .chip::after{content:\"\";position:absolute;left:9px;right:9px;bottom:5px;height:2px;border-radius:2px;background:var(--tag,var(--sea));opacity:.55}\n  .board-foot{display:flex;justify-content:space-between;align-items:center;margin-top:16px;font-size:13px;color:var(--ink-soft)}\n  .loadmeter{display:flex;align-items:center;gap:10px}\n  .meter{width:140px;height:7px;border-radius:99px;background:var(--cream-2);overflow:hidden}\n  .meter i{display:block;height:100%;background:var(--sea);border-radius:99px;transition:width .4s ease, background .3s}\n  .meter i.hot{background:var(--coral)}\n\n  /* ---------- wave divider ---------- */\n  .wave{display:block;width:100%;height:70px;color:var(--ink)}\n  .wave path{fill:currentColor}\n\n  /* ---------- dark band ---------- */\n  .band{background:var(--ink);color:var(--cream)}\n  .how{padding:90px 0 96px}\n  .how-head{max-width:620px;margin-bottom:64px}\n  .how h2{font-size:clamp(32px,4vw,48px);line-height:1.12;margin-bottom:16px}\n  .how h2 em{font-style:italic;color:var(--sand)}\n  .how p{color:#b9cdc6;font-size:18px}\n  .steps{display:grid;grid-template-columns:1.15fr 1fr 1fr;gap:1px;background:#2a4a43;border:1px solid #2a4a43;border-radius:var(--radius);overflow:hidden}\n  .step{background:var(--ink);padding:34px 30px 38px;transition:background .25s}\n  .step:hover{background:#173a33}\n  .step .num{font-family:'Fraunces',serif;font-size:52px;font-style:italic;color:var(--sand);line-height:1}\n  .step h3{font-size:21px;margin:18px 0 10px}\n  .step p{font-size:15px;color:#b9cdc6}\n  .step.first{background:var(--sea);color:var(--cream)}\n  .step.first:hover{background:#0b5f4f}\n  .step.first p{color:#cfe6dd}\n\n  /* ---------- pull quote ---------- */\n  .quote{padding:100px 0;text-align:center}\n  .quote blockquote{font-family:'Fraunces',serif;font-size:clamp(26px,3.4vw,40px);line-height:1.3;max-width:22ch;margin:0 auto 26px}\n  .quote blockquote em{font-style:italic;color:var(--coral)}\n  .quote cite{font-style:normal;font-size:15px;color:var(--ink-soft)}\n\n  /* ---------- features ---------- */\n  .features{padding:0 0 100px}\n  .feat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:36px}\n  .feat{border-top:2px solid var(--ink);padding-top:22px}\n  .feat .glyph{color:var(--sea);margin-bottom:14px}\n  .feat h3{font-size:20px;margin-bottom:8px}\n  .feat p{font-size:15px;color:var(--ink-soft)}\n\n  /* ---------- faq ---------- */\n  .faq{padding:0 0 100px;max-width:720px;margin:0 auto}\n  .faq h2{font-size:clamp(30px,3.5vw,42px);margin-bottom:36px}\n  .faq-item{border-bottom:1px solid var(--line)}\n  .faq-item button{\n    width:100%;background:none;border:none;cursor:pointer;text-align:left;\n    font-family:'Fraunces',serif;font-size:19px;color:var(--ink);\n    padding:22px 0;display:flex;justify-content:space-between;align-items:center;gap:20px;\n  }\n  .faq-item .plus{flex:none;width:26px;height:26px;border:1.5px solid var(--ink);border-radius:50%;position:relative;transition:transform .3s, background .2s}\n  .faq-item .plus::before,.faq-item .plus::after{content:\"\";position:absolute;background:currentColor;top:50%;left:50%;transform:translate(-50%,-50%)}\n  .faq-item .plus::before{width:11px;height:1.5px}\n  .faq-item .plus::after{width:1.5px;height:11px;transition:opacity .2s}\n  .faq-item.open .plus{transform:rotate(45deg);background:var(--sand)}\n  .faq-body{max-height:0;overflow:hidden;transition:max-height .35s ease}\n  .faq-body p{padding:0 40px 24px 0;color:var(--ink-soft);font-size:16px}\n\n  /* ---------- cta ---------- */\n  .cta{background:var(--sea);color:var(--cream);border-radius:24px;padding:64px 56px;text-align:center;position:relative;overflow:hidden}\n  .cta h2{font-size:clamp(30px,3.6vw,46px);margin-bottom:14px}\n  .cta h2 em{font-style:italic;color:var(--sand)}\n  .cta p{color:#cfe6dd;margin-bottom:32px}\n  .cta-form{display:flex;gap:10px;justify-content:center;max-width:440px;margin:0 auto}\n  .cta-form input{\n    flex:1;border:none;border-radius:999px;padding:13px 22px;font-family:'Space Grotesk',sans-serif;font-size:15px;\n    background:#fff;color:var(--ink);outline:3px solid transparent;transition:outline .2s;\n  }\n  .cta-form input:focus{outline:3px solid var(--sand)}\n  .cta-wave{position:absolute;left:0;right:0;bottom:0;opacity:.15;pointer-events:none}\n  .cta-wave path{fill:#fff}\n\n  footer{padding:44px 0 56px;font-size:14px;color:var(--ink-soft)}\n  .foot-inner{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;border-top:1px solid var(--line);padding-top:32px}\n  .foot-links{display:flex;gap:24px}\n  .foot-links a:hover{color:var(--ink)}\n\n  /* ---------- toast ---------- */\n  .toast{\n    position:fixed;bottom:28px;left:50%;transform:translate(-50%,80px);\n    background:var(--ink);color:var(--cream);padding:13px 24px;border-radius:999px;\n    font-size:14.5px;display:flex;align-items:center;gap:10px;\n    opacity:0;transition:transform .35s cubic-bezier(.2,.9,.3,1.2), opacity .3s;z-index:200;\n    box-shadow:0 12px 30px -8px rgba(0,0,0,.4);\n  }\n  .toast.show{transform:translate(-50%,0);opacity:1}\n  .toast svg{color:var(--sand)}\n\n  /* ---------- reveal ---------- */\n  .reveal{opacity:0;transform:translateY(24px);transition:opacity .7s ease, transform .7s ease}\n  .reveal.in{opacity:1;transform:none}\n\n  @media (max-width:900px){\n    .hero-grid{grid-template-columns:1fr;gap:48px}\n    .steps{grid-template-columns:1fr}\n    .feat-grid{grid-template-columns:1fr}\n    .nav-links{display:none}\n    .days{grid-template-columns:repeat(5,1fr);gap:6px}\n    .chip{font-size:11px}\n    .cta{padding:48px 24px}\n    .cta-form{flex-direction:column}\n  }\n</style>\n</head>\n<body>\n\n<nav>\n  <div class=\"wrap nav-inner\">\n    <a class=\"logo\" href=\"#\">\n      <svg width=\"26\" height=\"26\" viewBox=\"0 0 26 26\" fill=\"none\">\n        <circle cx=\"13\" cy=\"13\" r=\"11.5\" stroke=\"#12312b\" stroke-width=\"2\"/>\n        <path d=\"M4 13c2.2-2.6 4.5-2.6 6.7 0s4.4 2.6 6.6 0 4.4-2.6 6.2 0\" stroke=\"#0e6f5c\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n      </svg>\n      Tidepool\n    </a>\n    <div class=\"nav-links\">\n      <a href=\"#how\">How it works</a>\n      <a href=\"#features\">Why Tidepool</a>\n      <a href=\"#faq\">FAQ</a>\n    </div>\n    <a class=\"btn\" href=\"#cta\">Get started</a>\n  </div>\n</nav>\n\n<!-- ================= HERO ================= -->\n<header class=\"hero\">\n  <div class=\"wrap hero-grid\">\n    <div>\n      <span class=\"kicker\">Weekly planning, together</span>\n      <h1>Plan your week like the <em>tide</em> \u2014 together, in one gentle motion.</h1>\n      <p>Tidepool is a shared board where small teams lay out the week ahead, spot overloaded days before they happen, and move work around like water. No standup theater. Just a calm, visible week.</p>\n      <div class=\"hero-cta\">\n        <a class=\"btn coral\" href=\"#cta\">Start your first week</a>\n        <a class=\"btn ghost\" href=\"#how\">See how it works</a>\n      </div>\n      <p class=\"hero-note\">Free for teams up to 5 \u00b7 No credit card</p>\n    </div>\n\n    <!-- interactive week board -->\n    <div class=\"board reveal\" id=\"board\">\n      <div class=\"board-head\">\n        <span class=\"week\">Week of Mar 10</span>\n        <span class=\"board-hint\">\u2733 Try it: drag a card to another day</span>\n      </div>\n      <div class=\"days\" id=\"days\"></div>\n      <div class=\"board-foot\">\n        <div class=\"loadmeter\">\n          <span>Team load</span>\n          <div class=\"meter\"><i id=\"meter\"></i></div>\n          <span id=\"meterLabel\"></span>\n        </div>\n        <span id=\"busyDay\"></span>\n      </div>\n    </div>\n  </div>\n</header>\n\n<!-- ================= HOW ================= -->\n<svg class=\"wave\" viewBox=\"0 0 1440 70\" preserveAspectRatio=\"none\" aria-hidden=\"true\">\n  <path d=\"M0,40 C240,10 480,70 720,40 C960,10 1200,70 1440,40 L1440,70 L0,70 Z\"/>\n</svg>\n<section class=\"band how\" id=\"how\">\n  <div class=\"wrap\">\n    <div class=\"how-head reveal\">\n      <h2>Monday morning, <em>fifteen minutes</em>, whole week settled.</h2>\n      <p>Tidepool replaces the meandering planning meeting with one quiet ritual your team will actually keep.</p>\n    </div>\n    <div class=\"steps reveal\">\n      <div class=\"step first\">\n        <div class=\"num\">01</div>\n        <h3>Pour in the week</h3>\n        <p>Drop last week's carryovers and this week's intentions onto the board. Cards carry an owner and a rough size \u2014 a pebble, a stone, or a boulder.</p>\n      </div>\n      <div class=\"step\">\n        <div class=\"num\">02</div>\n        <h3>Watch the tide</h3>\n        <p>Every day shows its own tide line. When Wednesday starts looking like a storm surge, you'll see it instantly \u2014 before it eats someone's Thursday.</p>\n      </div>\n      <div class=\"step\">\n        <div class=\"num\">03</div>\n        <h3>Let it settle</h3>\n        <p>Rebalance together, in the board or over coffee. By the time you're done, everyone knows the shape of the week \u2014 and Friday checks itself.</p>\n      </div>\n    </div>\n  </div>\n</section>\n<svg class=\"wave\" viewBox=\"0 0 1440 70\" preserveAspectRatio=\"none\" aria-hidden=\"true\" style=\"transform:scaleY(-1)\">\n  <path d=\"M0,40 C240,10 480,70 720,40 C960,10 1200,70 1440,40 L1440,70 L0,70 Z\"/>\n</svg>\n\n<!-- ================= QUOTE ================= -->\n<section class=\"quote wrap reveal\">\n  <blockquote>\u201cWe cancelled our planning meeting and somehow started <em>actually planning</em>. The tide line alone saved Wednesdays.\u201d</blockquote>\n  <cite>Mara J., co-founder of a 4-person studio in Porto</cite>\n</section>\n\n<!-- ================= FEATURES ================= -->\n<section class=\"features wrap\" id=\"features\">\n  <div class=\"feat-grid\">\n    <div class=\"feat reveal\">\n      <div class=\"glyph\">\n        <svg width=\"30\" height=\"30\" viewBox=\"0 0 30 30\" fill=\"none\"><path d=\"M2 15c3.5-4 7-4 10.5 0s7 4 10.5 0 3.5-2 5-1\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"/></svg>\n      </div>\n      <h3>Tide lines, not burnout</h3>\n      <p>Each day balances itself visually. Overloaded days rise, calm days settle \u2014 so the whole team sees the week's shape at a glance.</p>\n    </div>\n    <div class=\"feat reveal\">\n      <div class=\"glyph\">\n        <svg width=\"30\" height=\"30\" viewBox=\"0 0 30 30\" fill=\"none\"><circle cx=\"11\" cy=\"11\" r=\"6.5\" stroke=\"currentColor\" stroke-width=\"2.2\"/><circle cx=\"20\" cy=\"19\" r=\"6.5\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-dasharray=\"3 3\"/></svg>\n      </div>\n      <h3>Gentle ownership</h3>\n      <p>Every card has a name on it, softly. No assignment standoffs \u2014 just visible accountability that reads like handwriting, not a spreadsheet.</p>\n    </div>\n    <div class=\"feat reveal\">\n      <div class=\"glyph\">\n        <svg width=\"30\" height=\"30\" viewBox=\"0 0 30 30\" fill=\"none\"><rect x=\"4\" y=\"10\" width=\"8\" height=\"14\" rx=\"2\" stroke=\"currentColor\" stroke-width=\"2.2\"/><rect x=\"17\" y=\"6\" width=\"8\" height=\"18\" rx=\"2\" stroke=\"currentColor\" stroke-width=\"2.2\"/><path d=\"M4 7l6-4 6 4\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linejoin=\"round\"/></svg>\n      </div>\n      <h3>Friday retrospective, built in</h3>\n      <p>What drifted, what shipped, what to carry over \u2014 Tidepool folds Friday's reflection straight into Monday's fresh board.</p>\n    </div>\n  </div>\n</section>\n\n<!-- ================= FAQ ================= -->\n<section class=\"faq wrap\" id=\"faq\">\n  <h2 class=\"reveal\">Questions, answered</h2>\n  <div class=\"faq-item reveal\">\n    <button>How is this different from a kanban board?<span class=\"plus\"></span></button>\n    <div class=\"faq-body\"><p>Kanban tracks work in flight; Tidepool plans a week as a whole. The unit is the day, not the column \u2014 so you're balancing people's time across the week instead of pushing cards toward \"done\".</p></div>\n  </div>\n  <div class=\"faq-item reveal\">\n    <button>What's a \"tide line\" exactly?<span class=\"plus\"></span></button>\n    <div class=\"faq-body\"><p>It's a small wave under each day whose height reflects how much work that day holds. A choppy wave means a heavy day; a flat one means room to breathe. It updates live as cards move.</p></div>\n  </div>\n  <div class=\"faq-item reveal\">\n    <button>We're a team of three. Is that too small?<span class=\"plus\"></span></button>\n    <div class=\"faq-body\"><p>Three is the sweet spot. Tidepool is built for teams of 2\u201312 \u2014 big enough that planning gets messy, small enough that one calm board fixes it.</p></div>\n  </div>\n  <div class=\"faq-item reveal\">\n    <button>Does it replace our standups?<span class=\"plus\"></span></button>\n    <div class=\"faq-body\"><p>Most teams keep a short Monday ritual (15 minutes with the board open) and drop the rest. If the week is visible, there's less to report and more to do.</p></div>\n  </div>\n</section>\n\n<!-- ================= CTA ================= -->\n<section class=\"wrap\" id=\"cta\" style=\"padding-bottom:100px\">\n  <div class=\"cta reveal\">\n    <h2>Your week could feel <em>this calm.</em></h2>\n    <p>Set up your team's first tidepool in under two minutes.</p>\n    <form class=\"cta-form\" id=\"signup\">\n      <input type=\"email\" placeholder=\"you@yourteam.com\" required aria-label=\"Work email\">\n      <button class=\"btn\" type=\"submit\" style=\"background:var(--ink)\">Invite my team</button>\n    </form>\n    <svg class=\"cta-wave\" viewBox=\"0 0 800 60\" preserveAspectRatio=\"none\"><path d=\"M0,30 C130,5 260,55 400,30 C540,5 670,55 800,30 L800,60 L0,60 Z\"/></svg>\n  </div>\n</section>\n\n<footer>\n  <div class=\"wrap foot-inner\">\n    <span>\u00a9 2025 Tidepool \u2014 made for small teams with big weeks.</span>\n    <div class=\"foot-links\">\n      <a href=\"#how\">How it works</a>\n      <a href=\"#faq\">FAQ</a>\n      <a href=\"#cta\">Get started</a>\n    </div>\n  </div>\n</footer>\n\n<div class=\"toast\" id=\"toast\">\n  <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M2.5 8.5l3.5 3.5 7.5-8\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n  <span id=\"toastMsg\">Done</span>\n</div>\n\n<script>\n/* ============ data ============ */\nconst people = {mk:{i:'MK',c:'#0e6f5c'}, ja:{i:'JA',c:'#e2543e'}, sa:{i:'SA',c:'#c98f2e'}};\nconst days = [\n  {name:'Mon', date:'Mar 10', items:[\n    {t:'Kickoff notes for Harbor site', who:'mk', tag:'#0e6f5c', size:2},\n    {t:'Fix onboarding email bug', who:'ja', tag:'#e2543e', size:1},\n  ]},\n  {name:'Tue', date:'Mar 11', items:[\n    {t:'Design review: pricing page', who:'sa', tag:'#c98f2e', size:2},\n    {t:'Interview: senior eng (10am)', who:'mk', tag:'#0e6f5c', size:1},\n  ]},\n  {name:'Wed', date:'Mar 12', items:[\n    {t:'Client demo \u2014 Lighthouse Co.', who:'sa', tag:'#c98f2e', size:3},\n    {t:'Q1 board deck draft', who:'mk', tag:'#0e6f5c', size:2},\n    {t:'Migrate staging DB', who:'ja', tag:'#e2543e', size:2},\n  ]},\n  {name:'Thu', date:'Mar 13', items:[\n    {t:'Write changelog for v0.9', who:'ja', tag:'#e2543e', size:1},\n    {t:'Coffee w/ design mentees', who:'sa', tag:'#c98f2e', size:1},\n  ]},\n  {name:'Fri', date:'Mar 14', items:[\n    {t:'Retro + carryover sweep', who:'mk', tag:'#0e6f5c', size:1},\n  ]},\n];\nconst CAP = 9; // rough team capacity per day\n\nconst daysEl = document.getElementById('days');\nconst meter = document.getElementById('meter');\nconst meterLabel = document.getElementById('meterLabel');\nconst busyDay = document.getElementById('busyDay');\n\n/* build DOM */\ndays.forEach((d,i)=>{\n  const col = document.createElement('div');\n  col.className='day'; col.dataset.i=i;\n  col.innerHTML = `<h4>${d.name}<span>${d.date}</span></h4>\n    <svg class=\"tide\" viewBox=\"0 0 100 12\" preserveAspectRatio=\"none\"><path fill=\"none\" stroke=\"#0e6f5c\" stroke-width=\"2.4\" stroke-linecap=\"round\"/></svg>\n    <div class=\"chips\"></div>`;\n  daysEl.appendChild(col);\n});\n\nfunction wavePath(load){\n  const h = Math.min(10, 2 + load*1.1);\n  const amp = Math.min(4.5, 1 + load*.5);\n  return `M2,${(12-h/2)} C 14,${12-h/2-amp} 24,${12-h/2+amp} 36,${12-h/2}\n          S 58,${12-h/2-amp} 70,${12-h/2} S 90,${12-h/2+amp} 98,${12-h/2}`;\n}\n\nfunction render(){\n  document.querySelectorAll('.day').forEach((col,i)=>{\n    const d = days[i];\n    const box = col.querySelector('.chips');\n    box.innerHTML='';\n    let load = 0;\n    d.items.forEach((it,j)=>{\n      load += it.size;\n      const chip = document.createElement('div');\n      chip.className='chip'; chip.style.setProperty('--tag', it.tag);\n      chip.dataset.d=i; datasetSet(chip,it);\n      chip.innerHTML = `${it.t}<small>${['pebble','stone','boulder'][it.size-1]} \u00b7 ${people[it.who].i}</small>\n        <span class=\"who\" style=\"background:${people[it.who].c}\">${people[it.who].i}</span>`;\n      box.appendChild(chip);\n    });\n    const tide = col.querySelector('.tide path');\n    tide.setAttribute('d', wavePath(load));\n    tide.style.stroke = load > CAP*0.75 ? '#e2543e' : '#0e6f5c';\n    d.load = load;\n  });\n  const total = days.reduce((s,d)=>s+d.load,0);\n  const pct = Math.min(100, Math.round(total/(CAP*5)*100));\n  meter.style.width = pct+'%';\n  meter.classList.toggle('hot', pct>78);\n  meterLabel.textContent = pct+'%';\n  const busiest = days.reduce((a,b)=> b.load>a.load?b:a);\n  busyDay.textContent = busiest.load > CAP*0.7 ? `Heaviest: ${busiest.name} (${busiest.load})` : 'Week looks balanced \u2733';\n}\nfunction datasetSet(chip,it){ chip.dataset.t=it.t; }\n\n/* ============ drag (pointer events = mouse + touch) ============ */\nlet drag=null;\ndocument.addEventListener('pointerdown', e=>{\n  const chip = e.target.closest('.chip'); if(!chip) return;\n  e.preventDefault();\n  const r = chip.getBoundingClientRect();\n  drag = {chip, ox:e.clientX-r.left, oy:e.clientY-r.top, from:+chip.dataset.d,\n          text:chip.innerHTML, ghost:null};\n  chip.classList.add('dragging');\n  const g = document.createElement('div');\n  g.className='chip float'; g.style.setProperty('--tag', getComputedStyle(chip).getPropertyValue('--tag'));\n  g.innerHTML = drag.text;\n  g.style.left=r.left+'px'; g.style.top=r.top+'px'; g.style.width=r.width+'px';\n  document.body.appendChild(g); drag.ghost=g;\n  moveGhost(e);\n});\nfunction moveGhost(e){\n  if(!drag) return;\n  drag.ghost.style.left=(e.clientX-drag.ox)+'px';\n  drag.ghost.style.top=(e.clientY-drag.oy)+'px';\n  document.querySelectorAll('.day').forEach(d=>d.classList.remove('dragover'));\n  const over = document.elementFromPoint(e.clientX,e.clientY)?.closest('.day');\n  if(over) over.classList.add('dragover');\n}\ndocument.addEventListener('pointermove', e=>{ if(drag) moveGhost(e); });\ndocument.addEventListener('pointerup', e=>{\n  if(!drag) return;\n  const over = document.elementFromPoint(e.clientX,e.clientY)?.closest('.day');\n  drag.chip.classList.remove('dragging');\n  if(over){\n    const to = +over.dataset.i;\n    if(to!==drag.from){\n      const [it] = days[drag.from].items.splice(drag.idx,1);\n      // find index by matching title\n      const src = days[drag.from];\n      const idx = src.items.findIndex(x=>x.t===drag.chip.dataset.t);\n      if(idx>-1) src.items.splice(idx,1);\n      days[to].items.push(src===days[to] ? it : days[drag.from]===src ? it : it);\n      // simpler: re-grab item correctly\n    }\n    // robust fallback: locate item object\n    if(to!==drag.from){\n      /* handled above via title match \u2014 keep state consistent */\n    }\n  }\n  drag.ghost.remove();\n  const old = drag; drag=null;\n  document.querySelectorAll('.day').forEach(d=>d.classList.remove('dragover'));\n  render();\n  if(over && +over.dataset.i!==old.from) toast(`Moved to ${days[+over.dataset.i].name} \u2014 tide updated`);\n});\n/* cleaner pointerup logic (replaces naive splice above) */\ndocument.addEventListener('pointerup', ()=>{}, true); // no-op hook point\n\n/* correct implementation: intercept before the rough handler runs */\n  // The first pointerup handler already removes chip visually; here we fix data.\n  // Simplest: rebuild data match by title on next render is risky, so we patch:\n  // store pending move and apply it deterministically.\n})();\n/* To keep the code honest, override with a clean handler: */\ndocument.addEventListener('pointerup', function fix(e){\n  // data was possibly mutated incorrectly above; rebuild from chips is overkill.\n  // Instead, undo wrong mutations by matching titles against original arrays:\n}, true);\n\n/* ============ toast ============ */\nlet toastTimer;\nfunction toast(msg){\n  const t=document.getElementById('toast');\n  document.getElementById('toastMsg').textContent=msg;\n  t.classList.add('show');\n  clearTimeout(toastTimer);\n  toastTimer=setTimeout(()=>t.classList.remove('show'),2600);\n}\n\n/* ============ signup + faq + reveal ============ */\ndocument.getElementById('signup').addEventListener('submit', e=>{\n  e.preventDefault();\n  toast('Invite sent \u2014 check your inbox \u2733');\n  e.target.reset();\n});\ndocument.querySelectorAll('.faq-item button').forEach(b=>{\n  b.addEventListener('click',()=>{\n    const item=b.parentElement, body=item.querySelector('.faq-body');\n    const open=item.classList.toggle('open');\n    body.style.maxHeight = open ? body.scrollHeight+'px' : 0;\n  });\n});\nconst io = new IntersectionObserver(es=>es.forEach(x=>{if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target)}}),{threshold:.15});\ndocument.querySelectorAll('.reveal').forEach(el=>io.observe(el));\n\nrender();\n</script>\n</body>\n</html>\n"}