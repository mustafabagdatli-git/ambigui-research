{"brief": "B4", "model": "anthropic/claude-haiku-5.5", "i": 2, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Marginalia Press \u00b7 Small Books of Poetry</title>\n  <meta name=\"description\" content=\"Marginalia Press publishes four small books of poetry a year. Slow reading, careful printing, poems that stay.\">\n  <style>\n    :root {\n      --paper: #f4efe4;\n      --paper-deep: #ebe3d1;\n      --ink: #1f1c18;\n      --muted: #6e665a;\n      --rule: #cfc5b1;\n      --oxblood: #7a2e2a;\n      --oxblood-soft: #a5504a;\n      --serif: \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, \"Times New Roman\", serif;\n      --sans: \"Helvetica Neue\", Helvetica, Arial, system-ui, sans-serif;\n      --max: 1120px;\n    }\n\n    *, *::before, *::after { box-sizing: border-box; }\n\n    html { scroll-behavior: smooth; }\n\n    body {\n      margin: 0;\n      background: var(--paper);\n      color: var(--ink);\n      font-family: var(--serif);\n      font-size: 1.125rem;\n      line-height: 1.65;\n      -webkit-font-smoothing: antialiased;\n    }\n\n    a { color: inherit; }\n\n    img, svg { display: block; max-width: 100%; }\n\n    .skip-link {\n      position: absolute;\n      left: -9999px;\n      top: 0;\n      background: var(--ink);\n      color: var(--paper);\n      padding: .5rem 1rem;\n      z-index: 100;\n    }\n    .skip-link:focus { left: 1rem; top: 1rem; }\n\n    .wrap {\n      width: min(var(--max), 100% - 3rem);\n      margin-inline: auto;\n    }\n\n    /* ---------- Header ---------- */\n    header.site {\n      position: sticky;\n      top: 0;\n      z-index: 50;\n      background: color-mix(in srgb, var(--paper) 92%, transparent);\n      backdrop-filter: blur(6px);\n      border-bottom: 1px solid transparent;\n      transition: border-color .3s;\n    }\n    header.site.scrolled { border-bottom-color: var(--rule); }\n\n    .nav {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 2rem;\n      padding: 1.25rem 0;\n    }\n\n    .brand {\n      text-decoration: none;\n      display: flex;\n      align-items: baseline;\n      gap: .5rem;\n    }\n    .brand-mark {\n      font-style: italic;\n      font-size: 1.5rem;\n      letter-spacing: -.01em;\n    }\n    .brand-sub {\n      font-family: var(--sans);\n      font-size: .7rem;\n      text-transform: uppercase;\n      letter-spacing: .18em;\n      color: var(--muted);\n    }\n\n    .nav ul {\n      list-style: none;\n      display: flex;\n      gap: 1.75rem;\n      margin: 0;\n      padding: 0;\n      font-family: var(--sans);\n      font-size: .8rem;\n      text-transform: uppercase;\n      letter-spacing: .14em;\n    }\n    .nav a {\n      text-decoration: none;\n      padding: .25rem 0;\n      background-image: linear-gradient(currentColor, currentColor);\n      background-size: 0 1px;\n      background-repeat: no-repeat;\n      background-position: 0 100%;\n      transition: background-size .25s;\n    }\n    .nav a:hover, .nav a:focus-visible { background-size: 100% 1px; }\n\n    /* ---------- Buttons ---------- */\n    .btn {\n      display: inline-block;\n      font-family: var(--sans);\n      font-size: .8rem;\n      text-transform: uppercase;\n      letter-spacing: .14em;\n      text-decoration: none;\n      padding: .9rem 1.6rem;\n      border: 1px solid var(--ink);\n      color: var(--ink);\n      transition: background .2s, color .2s, border-color .2s;\n    }\n    .btn:hover, .btn:focus-visible {\n      background: var(--ink);\n      color: var(--paper);\n    }\n    .btn.solid {\n      background: var(--oxblood);\n      border-color: var(--oxblood);\n      color: var(--paper);\n    }\n    .btn.solid:hover, .btn.solid:focus-visible {\n      background: var(--ink);\n      border-color: var(--ink);\n    }\n\n    /* ---------- Hero ---------- */\n    .hero {\n      padding: clamp(4rem, 10vw, 8rem) 0 clamp(4rem, 8vw, 6rem);\n    }\n    .hero-grid {\n      display: grid;\n      grid-template-columns: 1.15fr 1fr;\n      gap: clamp(2.5rem, 6vw, 6rem);\n      align-items: center;\n    }\n    .eyebrow {\n      font-family: var(--sans);\n      font-size: .75rem;\n      text-transform: uppercase;\n      letter-spacing: .2em;\n      color: var(--oxblood);\n      margin: 0 0 1.5rem;\n    }\n    h1 {\n      font-weight: 400;\n      font-size: clamp(2.8rem, 6.5vw, 5.4rem);\n      line-height: 1.02;\n      letter-spacing: -.02em;\n      margin: 0 0 1.75rem;\n    }\n    h1 em { color: var(--oxblood); }\n    .lede {\n      font-size: 1.25rem;\n      color: var(--muted);\n      max-width: 34rem;\n      margin: 0 0 2.5rem;\n    }\n    .cta-row {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 1rem;\n    }\n\n    /* Poem excerpt as hero visual */\n    .poem-card {\n      position: relative;\n      background: var(--paper-deep);\n      padding: clamp(2rem, 4vw, 3.25rem);\n      border: 1px solid var(--rule);\n      box-shadow: 14px 14px 0 var(--rule);\n    }\n    .poem-card::before {\n      content: \"\";\n      position: absolute;\n      inset: 10px;\n      border: 1px solid var(--rule);\n      pointer-events: none;\n    }\n    .poem-card p {\n      margin: 0;\n      font-style: italic;\n      font-size: 1.1rem;\n      line-height: 1.9;\n    }\n    .poem-card .stanza + .stanza { margin-top: 1.25rem; }\n    .poem-card footer {\n      margin-top: 2rem;\n      font-family: var(--sans);\n      font-style: normal;\n      font-size: .72rem;\n      text-transform: uppercase;\n      letter-spacing: .16em;\n      color: var(--muted);\n    }\n\n    /* ---------- Section scaffolding ---------- */\n    section { padding: clamp(4rem, 8vw, 7rem) 0; }\n    section + section { border-top: 1px solid var(--rule); }\n\n    .section-head {\n      display: flex;\n      justify-content: space-between;\n      align-items: end;\n      flex-wrap: wrap;\n      gap: 1rem 3rem;\n      margin-bottom: 3.5rem;\n    }\n    h2 {\n      font-weight: 400;\n      font-size: clamp(2rem, 4vw, 3rem);\n      line-height: 1.1;\n      letter-spacing: -.01em;\n      margin: 0;\n    }\n    .section-head p {\n      margin: 0;\n      max-width: 26rem;\n      color: var(--muted);\n      font-size: 1rem;\n    }\n\n    /* ---------- Featured book ---------- */\n    .featured {\n      display: grid;\n      grid-template-columns: minmax(220px, 340px) 1fr;\n      gap: clamp(2.5rem, 6vw, 5rem);\n      align-items: center;\n    }\n\n    /* CSS-only book cover */\n    .cover {\n      position: relative;\n      aspect-ratio: 2 / 3;\n      width: 100%;\n      color: var(--paper);\n      padding: 2rem 1.75rem;\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      box-shadow: 0 1px 0 rgba(0,0,0,.2), 18px 22px 40px -18px rgba(31,28,24,.55);\n      background:\n        linear-gradient(90deg, rgba(0,0,0,.25) 0, rgba(255,255,255,.08) 3%, transparent 6%),\n        linear-gradient(170deg, #7a2e2a 0%, #4e1c1a 100%);\n    }\n    .cover::after {\n      content: \"\";\n      position: absolute;\n      inset: 14px;\n      border: 1px solid rgba(244,239,228,.35);\n      pointer-events: none;\n    }\n    .cover .c-top,\n    .cover .c-bottom {\n      font-family: var(--sans);\n      font-size: .62rem;\n      letter-spacing: .24em;\n      text-transform: uppercase;\n      opacity: .85;\n      position: relative;\n      z-index: 1;\n    }\n    .cover .c-title {\n      font-size: clamp(1.6rem, 3vw, 2.2rem);\n      line-height: 1.05;\n      font-weight: 400;\n      position: relative;\n      z-index: 1;\n    }\n    .cover .c-title span {\n      display: block;\n      font-style: italic;\n      font-size: .6em;\n      margin-top: .4rem;\n      opacity: .9;\n    }\n    .cover .c-sun {\n      position: absolute;\n      right: 22%;\n      top: 38%;\n      width: 42%;\n      aspect-ratio: 1;\n      border-radius: 50%;\n      background: var(--paper);\n      opacity: .12;\n    }\n\n    .featured .kicker {\n      font-family: var(--sans);\n      font-size: .72rem;\n      text-transform: uppercase;\n      letter-spacing: .18em;\n      color: var(--oxblood);\n      margin: 0 0 .75rem;\n    }\n    .featured h3 {\n      font-weight: 400;\n      font-size: clamp(2rem, 3.6vw, 2.8rem);\n      line-height: 1.1;\n      margin: 0 0 .25rem;\n    }\n    .featured .byline {\n      font-style: italic;\n      color: var(--muted);\n      margin: 0 0 1.5rem;\n    }\n    .featured blockquote {\n      margin: 0 0 2rem;\n      padding-left: 1.25rem;\n      border-left: 2px solid var(--oxblood);\n      font-size: 1.2rem;\n      font-style: italic;\n    }\n    .meta {\n      display: flex;\n      flex-wrap: wrap;\n      gap: .5rem 2rem;\n      list-style: none;\n      padding: 1.25rem 0 0;\n      margin: 2rem 0 0;\n      border-top: 1px solid var(--rule);\n      font-family: var(--sans);\n      font-size: .8rem;\n      color: var(--muted);\n    }\n    .meta li strong { color: var(--ink); font-weight: 600; }\n\n    /* ---------- Catalogue ---------- */\n    .catalogue {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 3rem 2.25rem;\n      list-style: none;\n      padding: 0;\n      margin: 0;\n    }\n    .book {\n      display: flex;\n      flex-direction: column;\n      gap: 1.1rem;\n    }\n    .book .mini {\n      aspect-ratio: 3 / 4;\n      position: relative;\n      padding: 1.25rem;\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      color: var(--paper);\n      box-shadow: 10px 12px 26px -14px rgba(31,28,24,.5);\n      transition: transform .35s ease, box-shadow .35s ease;\n    }\n    .book:hover .mini {\n      transform: translateY(-4px);\n      box-shadow: 14px 20px 34px -16px rgba(31,28,24,.55);\n    }\n    .book .mini .t {\n      font-size: 1.35rem;\n      line-height: 1.1;\n      font-weight: 400;\n    }\n    .book .mini .a {\n      font-family: var(--sans);\n      font-size: .6rem;\n      letter-spacing: .2em;\n      text-transform: uppercase;\n      opacity: .85;\n    }\n    .book h4 {\n      font-weight: 400;\n      font-size: 1.35rem;\n      margin: 0;\n      line-height: 1.2;\n    }\n    .book .author {\n      font-style: italic;\n      color: var(--muted);\n      margin: 0;\n      font-size: 1rem;\n    }\n    .book p {\n      margin: 0;\n      font-size: .98rem;\n      color: var(--muted);\n    }\n    .book .price {\n      font-family: var(--sans);\n      font-size: .8rem;\n      letter-spacing: .08em;\n      margin-top: auto;\n    }\n    .book .price a {\n      text-decoration: none;\n      border-bottom: 1px solid currentColor;\n      padding-bottom: 1px;\n    }\n\n    /* Cover palettes */\n    .p-ochre   { background: linear-gradient(165deg, #c98f3a, #8a5a1c); }\n    .p-slate   { background: linear-gradient(165deg, #5b6b73, #2d373d); }\n    .p-moss    { background: linear-gradient(165deg, #7d8a5a, #424c2b); }\n    .p-plum    { background: linear-gradient(165deg, #6d4262, #3b2236); }\n    .p-bone    { background: linear-gradient(165deg, #e4dac4, #bfb296); color: var(--ink); }\n    .p-navy    { background: linear-gradient(165deg, #33466b, #1a2540); }\n\n    /* ---------- About ---------- */\n    .about-grid {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: clamp(2.5rem, 6vw, 6rem);\n    }\n    .about-grid p { margin: 0 0 1.25rem; }\n    .about-grid p:first-child::first-letter {\n      float: left;\n      font-size: 4.2rem;\n      line-height: .9;\n      padding: .35rem .6rem 0 0;\n      color: var(--oxblood);\n    }\n    .principles {\n      list-style: none;\n      margin: 0;\n      padding: 0;\n      counter-reset: p;\n    }\n    .principles li {\n      counter-increment: p;\n      position: relative;\n      padding: 1.5rem 0 1.5rem 3.25rem;\n      border-top: 1px solid var(--rule);\n    }\n    .principles li:last-child { border-bottom: 1px solid var(--rule); }\n    .principles li::before {\n      content: counter(p, upper-roman);\n      position: absolute;\n      left: 0;\n      top: 1.6rem;\n      font-family: var(--sans);\n      font-size: .75rem;\n      letter-spacing: .1em;\n      color: var(--oxblood);\n    }\n    .principles h3 {\n      font-weight: 400;\n      font-size: 1.3rem;\n      margin: 0 0 .35rem;\n    }\n    .principles p { margin: 0; color: var(--muted); font-size: 1rem; }\n\n    /* ---------- Submissions ---------- */\n    .submit {\n      background: var(--ink);\n      color: var(--paper);\n      border-top: none !important;\n    }\n    .submit h2 { color: var(--paper); }\n    .submit .eyebrow { color: #d9a39c; }\n    .submit-grid {\n      display: grid;\n      grid-template-columns: 1.2fr 1fr;\n      gap: clamp(2.5rem, 6vw, 6rem);\n      align-items: start;\n    }\n    .submit p { color: #cdc4b2; margin: 0 0 1.25rem; }\n    .submit dl {\n      margin: 0;\n      font-family: var(--sans);\n      font-size: .9rem;\n    }\n    .submit dl div {\n      display: grid;\n      grid-template-columns: 9rem 1fr;\n      gap: 1rem;\n      padding: .9rem 0;\n      border-top: 1px solid #3a352e;\n    }\n    .submit dl div:last-child { border-bottom: 1px solid #3a352e; }\n    .submit dt {\n      text-transform: uppercase;\n      letter-spacing: .14em;\n      font-size: .72rem;\n      color: #9d9584;\n      padding-top: .2rem;\n    }\n    .submit dd { margin: 0; color: var(--paper); }\n    .submit .btn { border-color: var(--paper); color: var(--paper); margin-top: 2rem; }\n    .submit .btn:hover, .submit .btn:focus-visible { background: var(--paper); color: var(--ink); }\n\n    /* ---------- Newsletter ---------- */\n    .letter {\n      text-align: center;\n      max-width: 40rem;\n      margin-inline: auto;\n    }\n    .letter h2 { margin-bottom: 1rem; }\n    .letter p { color: var(--muted); margin: 0 0 2.25rem; }\n    form.signup {\n      display: flex;\n      gap: 0;\n      max-width: 30rem;\n      margin: 0 auto;\n      border-bottom: 1px solid var(--ink);\n    }\n    form.signup label { position: absolute; left: -9999px; }\n    form.signup input {\n      flex: 1;\n      min-width: 0;\n      background: transparent;\n      border: 0;\n      padding: .9rem .25rem;\n      font: inherit;\n      color: var(--ink);\n    }\n    form.signup input::placeholder { color: #9b9284; font-style: italic; }\n    form.signup input:focus { outline: none; }\n    form.signup button {\n      background: none;\n      border: 0;\n      font-family: var(--sans);\n      font-size: .78rem;\n      text-transform: uppercase;\n      letter-spacing: .16em;\n      color: var(--oxblood);\n      cursor: pointer;\n      padding: .9rem .25rem .9rem 1rem;\n    }\n    form.signup button:hover { color: var(--ink); }\n    .form-note {\n      font-family: var(--sans);\n      font-size: .8rem;\n      color: var(--muted);\n      min-height: 1.4em;\n      margin-top: 1rem;\n    }\n\n    /* ---------- Footer ---------- */\n    footer.site-foot {\n      border-top: 1px solid var(--rule);\n      padding: 3rem 0 2.5rem;\n      font-family: var(--sans);\n      font-size: .85rem;\n      color: var(--muted);\n    }\n    .foot-grid {\n      display: flex;\n      justify-content: space-between;\n      flex-wrap: wrap;\n      gap: 2rem;\n    }\n    .foot-grid nav ul {\n      list-style: none;\n      display: flex;\n      gap: 1.5rem;\n      margin: 0;\n      padding: 0;\n      flex-wrap: wrap;\n    }\n    .foot-grid a { text-decoration: none; }\n    .foot-grid a:hover { color: var(--ink); text-decoration: underline; }\n    .colophon {\n      margin-top: 2.5rem;\n      font-family: var(--serif);\n      font-style: italic;\n      font-size: .95rem;\n    }\n\n    /* ---------- Responsive ---------- */\n    @media (max-width: 960px) {\n      .catalogue { grid-template-columns: repeat(2, 1fr); }\n      .hero-grid, .featured, .about-grid, .submit-grid {\n        grid-template-columns: 1fr;\n      }\n      .cover { max-width: 300px; }\n      .poem-card { box-shadow: 8px 8px 0 var(--rule); }\n    }\n\n    @media (max-width: 680px) {\n      body { font-size: 1.05rem; }\n      .nav { flex-direction: column; align-items: flex-start; gap: .9rem; }\n      .nav ul { gap: 1.1rem; flex-wrap: wrap; }\n      .catalogue { grid-template-columns: 1fr; }\n      .section-head { margin-bottom: 2.5rem; }\n      .submit dl div { grid-template-columns: 1fr; gap: .25rem; }\n      form.signup { flex-direction: column; border-bottom: 0; gap: .5rem; }\n      form.signup input { border-bottom: 1px solid var(--ink); }\n      form.signup button { align-self: flex-end; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      html { scroll-behavior: auto; }\n      *, *::before, *::after { transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n\n  <a class=\"skip-link\" href=\"#main\">Skip to content</a>\n\n  <header class=\"site\" id=\"top\">\n    <div class=\"wrap nav\">\n      <a class=\"brand\" href=\"#top\" aria-label=\"Marginalia Press home\">\n        <span class=\"brand-mark\">Marginalia</span>\n        <span class=\"brand-sub\">Press</span>\n      </a>\n      <nav aria-label=\"Primary\">\n        <ul>\n          <li><a href=\"#books\">Books</a></li>\n          <li><a href=\"#featured\">Featured</a></li>\n          <li><a href=\"#about\">About</a></li>\n          <li><a href=\"#submit\">Submit</a></li>\n          <li><a href=\"#letter\">Letters</a></li>\n        </ul>\n      </nav>\n    </div>\n  </header>\n\n  <main id=\"main\">\n\n    <!-- Hero -->\n    <section class=\"hero\">\n      <div class=\"wrap hero-grid\">\n        <div>\n          <p class=\"eyebrow\">Small press &middot; Est. 2014 &middot; Four books a year</p>\n          <h1>Small books for <em>slow</em> reading.</h1>\n          <p class=\"lede\">\n            We publish a handful of poetry collections each year, printed in short runs on\n            heavy paper, edited closely and sold without apology. Every book is meant to be\n            read twice, and kept.\n          </p>\n          <div class=\"cta-row\">\n            <a class=\"btn solid\" href=\"#books\">Browse the catalogue</a>\n            <a class=\"btn\" href=\"#submit\">Send us your manuscript</a>\n          </div>\n        </div>\n\n        <figure class=\"poem-card\" aria-label=\"Excerpt from a featured poem\">\n          <p class=\"stanza\">\n            The kettle hums its small grey song<br>\n            while the year turns over in its sleep,<br>\n            and I am learning what to keep<br>\n            and what to let go, and for how long.\n          </p>\n          <p class=\"stanza\">\n            Outside, the hedge has given up<br>\n            its last few berries to the wren.<br>\n            Nothing here is finished. Nothing ever was.\n          </p>\n          <footer>From <em>Winter Accounts</em> &middot; Ilse Varga</footer>\n        </figure>\n      </div>\n    </section>\n\n    <!-- Featured -->\n    <section id=\"featured\">\n      <div class=\"wrap\">\n        <div class=\"section-head\">\n          <h2>Now available</h2>\n          <p>Our latest title, a debut collection written across three winters and one very long move.</p>\n        </div>\n\n        <article class=\"featured\">\n          <div class=\"cover\" role=\"img\" aria-label=\"Cover of Salt Road, by Tomasz Adeyemi-Lind\">\n            <span class=\"c-sun\" aria-hidden=\"true\"></span>\n            <span class=\"c-top\">Marginalia Press</span>\n            <div class=\"c-title\">Salt Road<span>poems</span></div>\n            <span class=\"c-bottom\">Tomasz Adeyemi-Lind</span>\n          </div>\n\n          <div>\n            <p class=\"kicker\">New &middot; Debut collection</p>\n            <h3>Salt Road</h3>\n            <p class=\"byline\">Tomasz Adeyemi-Lind</p>\n            <blockquote>\n              &ldquo;These poems know the exact weight of a borrowed coat and the cost of\n              every road that doesn&rsquo;t lead home.&rdquo;\n              <br><span style=\"font-style:normal;font-family:var(--sans);font-size:.75rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)\">&mdash; Advance reader</span>\n            </blockquote>\n            <p>\n              Forty-one poems in four sections, set in a single hardback with sewn binding and\n              a ribbon marker. Limited to 500 numbered copies.\n            </p>\n            <ul class=\"meta\">\n              <li><strong>Hardback</strong>, 96 pp.</li>\n              <li><strong>$24</strong></li>\n              <li>ISBN 978-0-000-00000-0</li>\n            </ul>\n            <div class=\"cta-row\" style=\"margin-top:2rem\">\n              <a class=\"btn solid\" href=\"#\">Buy the book</a>\n              <a class=\"btn\" href=\"#\">Read a sample poem</a>\n            </div>\n          </div>\n        </article>\n      </div>\n    </section>\n\n    <!-- Catalogue -->\n    <section id=\"books\">\n      <div class=\"wrap\">\n        <div class=\"section-head\">\n          <h2>The catalogue</h2>\n          <p>Recent titles, most of them still in print. Each one is a small object you can hold in one hand.</p>\n        </div>\n\n        <ul class=\"catalogue\">\n          <li class=\"book\">\n            <div class=\"mini p-ochre\">\n              <span class=\"a\">Marginalia</span>\n              <span class=\"t\">The Orchard Ledger</span>\n            </div>\n            <h4>The Orchard Ledger</h4>\n            <p class=\"author\">Rosa Ferreira-Doyle</p>\n            <p>Inventories of fruit, debt, and the labour of an inherited valley.</p>\n            <span class=\"price\"><a href=\"#\">$18 &middot; Paperback</a></span>\n          </li>\n\n          <li class=\"book\">\n            <div class=\"mini p-slate\">\n              <span class=\"a\">Marginalia</span>\n              <span class=\"t\">Tidewater Grammar</span>\n            </div>\n            <h4>Tidewater Grammar</h4>\n            <p class=\"author\">Okonkwo Haddad</p>\n            <p>Sonnets arranged by the tide tables of a city that keeps changing its name.</p>\n            <span class=\"price\"><a href=\"#\">$20 &middot; Paperback</a></span>\n          </li>\n\n          <li class=\"book\">\n            <div class=\"mini p-moss\">\n              <span class=\"a\">Marginalia</span>\n              <span class=\"t\">A Field Guide to Small Mercies</span>\n            </div>\n            <h4>A Field Guide to Small Mercies</h4>\n            <p class=\"author\">Delphine Carrow</p>\n            <p>Poems in the form of identification notes for birds, weather, and people.</p>\n            <span class=\"price\"><a href=\"#\">$16 &middot; Paperback</a></span>\n          </li>\n\n          <li class=\"book\">\n            <div class=\"mini p-plum\">\n              <span class=\"a\">Marginalia</span>\n              <span class=\"t\">Nocturne for Two Radios</span>\n            </div>\n            <h4>Nocturne for Two Radios</h4>\n            <p class=\"author\">Anand Mbatha</p>\n            <p>A long sequence about a marriage conducted almost entirely through static.</p>\n            <span class=\"price\"><a href=\"#\">$22 &middot; Hardback</a></span>\n          </li>\n\n          <li class=\"book\">\n            <div class=\"mini p-bone\">\n              <span class=\"a\">Marginalia</span>\n              <span class=\"t\">Notes Toward a Quieter House</span>\n            </div>\n            <h4>Notes Toward a Quieter House</h4>\n            <p class=\"author\">Ines Okafor-Lund</p>\n            <p>Domestic poems that refuse the easy consolations of the domestic.</p>\n            <span class=\"price\"><a href=\"#\">$17 &middot; Paperback</a></span>\n          </li>\n\n          <li class=\"book\">\n            <div class=\"mini p-navy\">\n              <span class=\"a\">Marginalia</span>\n              <span class=\"t\">Lighthouse, Reconsidered</span>\n            </div>\n            <h4>Lighthouse, Reconsidered</h4>\n            <p class=\"author\">Edmund Tarrant</p>\n            <p>Thirty short poems written from the keeper&rsquo;s logbook, one night at a time.</p>\n            <span class=\"price\"><a href=\"#\">$15 &middot; Paperback</a></span>\n          </li>\n        </ul>\n      </div>\n    </section>\n\n    <!-- About -->\n    <section id=\"about\">\n      <div class=\"wrap about-grid\">\n        <div>\n          <p class=\"eyebrow\">About the press</p>\n          <h2 style=\"margin-bottom:2rem\">Founded on the margins of a notebook.</h2>\n          <p>\n            Marginalia began in a kitchen in 2014, with a secondhand letterpress, a box of\n            mismatched type, and a conviction that poetry deserved the same care as a good\n            wooden chair.\n          </p>\n          <p>\n            We are a team of five. We read every submission ourselves, edit with our authors\n            over months rather than weeks, and set most of our books by hand or in small\n            digital runs on paper we choose individually.\n          </p>\n          <p>\n            We are not trying to be the largest poetry publisher. We are trying to be the one\n            you remember finding.\n          </p>\n        </div>\n\n        <ol class=\"principles\">\n          <li>\n            <h3>Close editing</h3>\n            <p>Every manuscript receives at least three full rounds of editorial conversation.</p>\n          </li>\n          <li>\n            <h3>Honest runs</h3>\n            <p>Small editions, never reprinted to chase a trend. When a book sells out, we say so.</p>\n          </li>\n          <li>\n            <h3>Fair terms</h3>\n            <p>Authors keep their rights, receive royalties from the first copy, and get a say in the cover.</p>\n          </li>\n          <li>\n            <h3>Physical care</h3>\n            <p>Sewn bindings, acid-free stock, and a ribbon in every hardback. Books should feel like something.</p>\n          </li>\n        </ol>\n      </div>\n    </section>\n\n    <!-- Submissions -->\n    <section id=\"submit\" class=\"submit\">\n      <div class=\"wrap submit-grid\">\n        <div>\n          <p class=\"eyebrow\">Open for submissions</p>\n          <h2 style=\"margin-bottom:1.5rem\">We are reading for our next season.</h2>\n          <p>\n            We welcome manuscripts from poets at every stage, including first collections and\n            translations. We especially want work that takes its time and trusts the reader.\n          </p>\n          <p>\n            Please send a complete manuscript of 40 to 80 pages with a short cover letter. We\n            read every submission and aim to reply within four months.\n          </p>\n          <a class=\"btn\" href=\"#\">Read our guidelines</a>\n        </div>\n\n        <dl>\n          <div>\n            <dt>Window</dt>\n            <dd>1 March &ndash; 15 April</dd>\n          </div>\n          <div>\n            <dt>Length</dt>\n            <dd>40 &ndash; 80 pages of poetry</dd>\n          </div>\n          <div>\n            <dt>Fee</dt>\n            <dd>None. Ever.</dd>\n          </div>\n          <div>\n            <dt>Format</dt>\n            <dd>PDF, single file, anonymised title page</dd>\n          </div>\n          <div>\n            <dt>Response</dt>\n            <dd>Within four months</dd>\n          </div>\n        </dl>\n      </div>\n    </section>\n\n    <!-- Newsletter -->\n    <section id=\"letter\">\n      <div class=\"wrap letter\">\n        <p class=\"eyebrow\">Letters from the press</p>\n        <h2>Four times a year, in your inbox.</h2>\n        <p>New titles, readings, and the occasional poem that didn&rsquo;t fit anywhere else. No more than four messages a season.</p>\n\n        <form class=\"signup\" id=\"signup\" action=\"#\" method=\"post\" novalidate>\n          <label for=\"email\">Email address</label>\n          <input type=\"email\" id=\"email\" name=\"email\" placeholder=\"you@example.com\" autocomplete=\"email\" required>\n          <button type=\"submit\">Subscribe</button>\n        </form>\n        <p class=\"form-note\" id=\"form-note\" role=\"status\" aria-live=\"polite\"></p>\n      </div>\n    </section>\n\n  </main>\n\n  <footer class=\"site-foot\">\n    <div class=\"wrap foot-grid\">\n      <div>\n        <strong style=\"font-family:var(--serif);font-style:italic;font-weight:400;font-size:1.25rem;color:var(--ink)\">Marginalia Press</strong>\n        <div style=\"margin-top:.5rem\">Poetry, printed slowly.<br>Studio 4, 19 Cooper Lane, Bristol</div>\n        <div style=\"margin-top:.5rem\"><a href=\"mailto:hello@marginalia.example\">hello@marginalia.example</a></div>\n      </div>\n      <nav aria-label=\"Footer\">\n        <ul>\n          <li><a href=\"#books\">Catalogue</a></li>\n          <li><a href=\"#about\">About</a></li>\n          <li><a href=\"#submit\">Submissions</a></li>\n          <li><a href=\"#\">Distribution</a></li>\n          <li><a href=\"#\">Events</a></li>\n          <li><a href=\"#\">Contact</a></li>\n        </ul>\n      </nav>\n    </div>\n    <div class=\"wrap colophon\">\n      Set in Palatino and printed in short runs. &copy; 2025 Marginalia Press.\n    </div>\n  </footer>\n\n  <script>\n    // Subtle header rule on scroll\n    (function () {\n      var header = document.querySelector('header.site');\n      function onScroll() {\n        header.classList.toggle('scrolled', window.scrollY > 8);\n      }\n      window.addEventListener('scroll', onScroll, { passive: true });\n      onScroll();\n    })();\n\n    // Newsletter form: client-side validation only\n    (function () {\n      var form = document.getElementById('signup');\n      var input = document.getElementById('email');\n      var note = document.getElementById('form-note');\n      form.addEventListener('submit', function (e) {\n        e.preventDefault();\n        var value = input.value.trim();\n        if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(value)) {\n          note.textContent = 'Please enter a valid email address.';\n          input.focus();\n          return;\n        }\n        note.textContent = 'Thank you. Your first letter will arrive at the end of the season.';\n        input.value = '';\n      });\n    })();\n  </script>\n\n</body>\n</html>\n"}