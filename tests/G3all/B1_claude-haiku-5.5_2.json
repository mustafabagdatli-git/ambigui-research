{"brief": "B1", "model": "anthropic/claude-haiku-5.5", "i": 2, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en-GB\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Hollins Family Plumbing & Heating | Leeds Plumbers Since 1987</title>\n<meta name=\"description\" content=\"Family-run plumbers and heating engineers in Leeds. Emergency call-outs, boiler repairs, bathroom installs and drain clearance. Gas Safe registered, upfront pricing.\">\n<style>\n  :root {\n    --navy: #14263b;\n    --navy-2: #1d3652;\n    --copper: #c8703a;\n    --copper-dark: #a85a2c;\n    --cream: #faf6f0;\n    --sand: #f1e8dc;\n    --ink: #1f2933;\n    --muted: #5d6b7a;\n    --white: #ffffff;\n    --line: #e4dbcf;\n    --green: #2f7d5b;\n    --radius: 14px;\n    --shadow: 0 10px 30px rgba(20, 38, 59, 0.10);\n    --max: 1160px;\n  }\n\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  html { scroll-behavior: smooth; }\n  body {\n    font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n    color: var(--ink);\n    background: var(--cream);\n    line-height: 1.6;\n    -webkit-font-smoothing: antialiased;\n  }\n  img, svg { display: block; max-width: 100%; }\n  a { color: inherit; }\n  :focus-visible { outline: 3px solid var(--copper); outline-offset: 3px; border-radius: 4px; }\n\n  .container { width: min(var(--max), 92%); margin: 0 auto; }\n  section { padding: 88px 0; }\n  .eyebrow {\n    display: inline-block;\n    font-size: 0.78rem;\n    font-weight: 700;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    color: var(--copper-dark);\n    margin-bottom: 12px;\n  }\n  h1, h2, h3 { font-family: Georgia, \"Times New Roman\", serif; color: var(--navy); line-height: 1.15; font-weight: 700; }\n  h1 { font-size: clamp(2.3rem, 5vw, 3.7rem); letter-spacing: -0.01em; }\n  h2 { font-size: clamp(1.9rem, 3.6vw, 2.6rem); margin-bottom: 16px; }\n  h3 { font-size: 1.25rem; margin-bottom: 8px; }\n  .lead { font-size: 1.12rem; color: var(--muted); max-width: 640px; }\n  .section-head { max-width: 680px; margin-bottom: 52px; }\n  .section-head.center { margin-left: auto; margin-right: auto; text-align: center; }\n  .section-head.center .lead { margin: 0 auto; }\n\n  /* Buttons */\n  .btn {\n    display: inline-flex; align-items: center; justify-content: center; gap: 10px;\n    padding: 14px 26px; border-radius: 999px; font-weight: 700; font-size: 1rem;\n    text-decoration: none; border: 2px solid transparent; cursor: pointer;\n    transition: transform .15s ease, background .15s ease, color .15s ease, box-shadow .15s ease;\n    font-family: inherit;\n  }\n  .btn:hover { transform: translateY(-2px); }\n  .btn-primary { background: var(--copper); color: var(--white); box-shadow: 0 8px 20px rgba(200,112,58,.35); }\n  .btn-primary:hover { background: var(--copper-dark); }\n  .btn-ghost { background: transparent; color: var(--white); border-color: rgba(255,255,255,.5); }\n  .btn-ghost:hover { background: rgba(255,255,255,.1); }\n  .btn-navy { background: var(--navy); color: var(--white); }\n  .btn-navy:hover { background: var(--navy-2); }\n  .btn-small { padding: 10px 18px; font-size: 0.92rem; }\n\n  /* Top bar */\n  .topbar {\n    background: var(--navy);\n    color: #d7e0ea;\n    font-size: 0.9rem;\n  }\n  .topbar .container {\n    display: flex; justify-content: space-between; align-items: center; gap: 16px;\n    padding: 9px 0; flex-wrap: wrap;\n  }\n  .topbar strong { color: var(--white); }\n  .topbar a { color: var(--white); text-decoration: none; font-weight: 700; }\n  .pulse {\n    display: inline-block; width: 8px; height: 8px; border-radius: 50%;\n    background: #5fd39b; margin-right: 8px; box-shadow: 0 0 0 0 rgba(95,211,155,.7);\n    animation: pulse 2s infinite;\n  }\n  @keyframes pulse {\n    0% { box-shadow: 0 0 0 0 rgba(95,211,155,.7); }\n    70% { box-shadow: 0 0 0 10px rgba(95,211,155,0); }\n    100% { box-shadow: 0 0 0 0 rgba(95,211,155,0); }\n  }\n\n  /* Header */\n  header.site {\n    position: sticky; top: 0; z-index: 50;\n    background: rgba(250,246,240,.92);\n    backdrop-filter: blur(10px);\n    border-bottom: 1px solid var(--line);\n  }\n  header.site .container {\n    display: flex; align-items: center; justify-content: space-between; height: 76px;\n  }\n  .logo { display: flex; align-items: center; gap: 12px; text-decoration: none; }\n  .logo-text { line-height: 1.1; }\n  .logo-text b { display: block; font-family: Georgia, serif; font-size: 1.15rem; color: var(--navy); }\n  .logo-text span { font-size: 0.72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }\n  nav.primary ul { display: flex; gap: 28px; list-style: none; align-items: center; }\n  nav.primary a {\n    text-decoration: none; font-weight: 600; color: var(--navy); font-size: 0.95rem;\n  }\n  nav.primary a:hover { color: var(--copper-dark); }\n  .header-cta { display: flex; align-items: center; gap: 16px; }\n  .menu-toggle {\n    display: none; background: none; border: 0; cursor: pointer; padding: 8px;\n  }\n  .menu-toggle span {\n    display: block; width: 24px; height: 2px; background: var(--navy); margin: 5px 0; border-radius: 2px;\n  }\n\n  /* Hero */\n  .hero {\n    position: relative;\n    background:\n      radial-gradient(circle at 85% 20%, rgba(200,112,58,.35), transparent 40%),\n      radial-gradient(circle at 10% 90%, rgba(47,125,91,.18), transparent 40%),\n      linear-gradient(135deg, var(--navy) 0%, var(--navy-2) 100%);\n    color: var(--white);\n    padding: 96px 0 110px;\n    overflow: hidden;\n  }\n  .hero h1 { color: var(--white); }\n  .hero .eyebrow { color: #f2b48a; }\n  .hero .lead { color: #c7d3e0; margin: 22px 0 36px; font-size: 1.2rem; }\n  .hero-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 56px; align-items: center; }\n  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; }\n  .trust-row {\n    display: flex; flex-wrap: wrap; gap: 18px 26px; margin-top: 40px;\n    font-size: 0.92rem; color: #c7d3e0;\n  }\n  .trust-row div { display: flex; align-items: center; gap: 8px; }\n  .trust-row svg { width: 18px; height: 18px; flex-shrink: 0; }\n\n  .booking-card {\n    background: var(--white);\n    color: var(--ink);\n    border-radius: 20px;\n    padding: 30px;\n    box-shadow: 0 30px 60px rgba(0,0,0,.25);\n    position: relative;\n  }\n  .booking-card .badge {\n    position: absolute; top: -14px; right: 24px;\n    background: var(--green); color: var(--white);\n    font-size: 0.8rem; font-weight: 700; padding: 6px 14px; border-radius: 999px;\n  }\n  .booking-card h3 { font-size: 1.35rem; }\n  .booking-card > p { color: var(--muted); font-size: 0.95rem; margin-bottom: 18px; }\n  .slot-title { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); margin-bottom: 10px; }\n  .slots { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 22px; }\n  .slot {\n    border: 1px solid var(--line); border-radius: 10px; padding: 10px 6px; text-align: center;\n    font-size: 0.9rem; font-weight: 600; color: var(--navy); background: var(--cream);\n  }\n  .slot.taken { opacity: .45; text-decoration: line-through; }\n  .slot.selected { background: var(--navy); color: var(--white); border-color: var(--navy); }\n  .booking-card .btn { width: 100%; }\n  .booking-card small { display: block; text-align: center; margin-top: 12px; color: var(--muted); }\n\n  /* Stats strip */\n  .stats {\n    background: var(--white);\n    border-bottom: 1px solid var(--line);\n  }\n  .stats-grid {\n    display: grid; grid-template-columns: repeat(4, 1fr);\n    text-align: center; padding: 42px 0;\n  }\n  .stat strong {\n    display: block; font-family: Georgia, serif; font-size: 2.4rem; color: var(--navy); line-height: 1;\n  }\n  .stat span { color: var(--muted); font-size: 0.95rem; }\n\n  /* Services */\n  .services { background: var(--cream); }\n  .service-grid {\n    display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;\n  }\n  .service {\n    background: var(--white); border: 1px solid var(--line); border-radius: var(--radius);\n    padding: 30px; transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;\n    text-decoration: none; display: block;\n  }\n  .service:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-color: transparent; }\n  .icon {\n    width: 56px; height: 56px; border-radius: 14px; background: var(--sand);\n    display: grid; place-items: center; margin-bottom: 20px;\n  }\n  .icon svg { width: 28px; height: 28px; stroke: var(--copper-dark); fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }\n  .service p { color: var(--muted); font-size: 0.97rem; }\n  .service .price { margin-top: 16px; font-size: 0.9rem; font-weight: 700; color: var(--green); }\n  .service.featured { background: var(--navy); border-color: var(--navy); }\n  .service.featured h3, .service.featured p { color: var(--white); }\n  .service.featured p { color: #c7d3e0; }\n  .service.featured .icon { background: rgba(255,255,255,.1); }\n  .service.featured .icon svg { stroke: #f2b48a; }\n  .service.featured .price { color: #8fe0b7; }\n  .tag {\n    display: inline-block; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em;\n    background: var(--copper); color: var(--white); padding: 4px 10px; border-radius: 999px; margin-bottom: 14px;\n  }\n\n  /* Pricing promise */\n  .promise { background: var(--white); }\n  .promise-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: start; }\n  .checklist { list-style: none; display: grid; gap: 18px; margin-top: 28px; }\n  .checklist li { display: flex; gap: 14px; align-items: flex-start; }\n  .checklist .tick {\n    flex-shrink: 0; width: 28px; height: 28px; border-radius: 50%;\n    background: #e3f2ea; display: grid; place-items: center;\n  }\n  .checklist .tick svg { width: 16px; height: 16px; stroke: var(--green); stroke-width: 3; fill: none; }\n  .checklist strong { color: var(--navy); display: block; }\n  .checklist span { color: var(--muted); font-size: 0.97rem; }\n  .price-table {\n    border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--cream);\n  }\n  .price-table h3 {\n    background: var(--navy); color: var(--white); padding: 20px 26px; margin: 0; font-size: 1.1rem;\n  }\n  .price-row {\n    display: flex; justify-content: space-between; padding: 16px 26px; border-bottom: 1px solid var(--line);\n    font-size: 0.97rem;\n  }\n  .price-row:last-child { border-bottom: 0; }\n  .price-row b { color: var(--navy); }\n  .price-note { padding: 16px 26px; font-size: 0.85rem; color: var(--muted); background: var(--white); }\n\n  /* Family story */\n  .story { background: var(--sand); }\n  .story-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 64px; align-items: center; }\n  .story-art {\n    position: relative; aspect-ratio: 4 / 5; border-radius: 24px; overflow: hidden;\n    background: linear-gradient(160deg, #e9b58f 0%, #c8703a 45%, var(--navy) 100%);\n    box-shadow: var(--shadow);\n  }\n  .story-art .sun {\n    position: absolute; width: 150px; height: 150px; border-radius: 50%;\n    background: rgba(255,240,220,.35); top: 12%; right: 12%;\n  }\n  .story-art .hill {\n    position: absolute; bottom: 0; left: -10%; right: -10%; height: 46%;\n    background: var(--navy); border-radius: 50% 50% 0 0 / 100% 100% 0 0;\n  }\n  .story-art .quote-card {\n    position: absolute; left: 24px; right: 24px; bottom: 24px;\n    background: rgba(255,255,255,.96); border-radius: 16px; padding: 22px;\n  }\n  .story-art .quote-card p { font-family: Georgia, serif; font-style: italic; color: var(--navy); }\n  .story-art .quote-card small { color: var(--muted); font-weight: 600; }\n  .story p { margin-bottom: 16px; color: #3a4754; }\n  .signature { font-family: Georgia, serif; font-style: italic; color: var(--navy); font-size: 1.15rem; margin-top: 8px; }\n  .timeline { margin-top: 32px; display: grid; gap: 16px; }\n  .tl-item { display: grid; grid-template-columns: 70px 1fr; gap: 16px; }\n  .tl-item b { font-family: Georgia, serif; color: var(--copper-dark); font-size: 1.1rem; }\n  .tl-item span { color: var(--muted); font-size: 0.95rem; }\n\n  /* Areas */\n  .areas { background: var(--cream); }\n  .areas-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 56px; align-items: start; }\n  .area-chips { display: flex; flex-wrap: wrap; gap: 10px; }\n  .chip {\n    background: var(--white); border: 1px solid var(--line); border-radius: 999px;\n    padding: 10px 18px; font-size: 0.95rem; font-weight: 600; color: var(--navy);\n  }\n  .map-card {\n    background: var(--navy); border-radius: 22px; padding: 34px; color: #c7d3e0; position: relative; overflow: hidden;\n  }\n  .map-card h3 { color: var(--white); }\n  .map-card .ring {\n    position: absolute; border: 1px dashed rgba(242,180,138,.35); border-radius: 50%;\n    right: -80px; bottom: -80px; width: 320px; height: 320px;\n  }\n  .map-card .ring.r2 { width: 480px; height: 480px; right: -160px; bottom: -160px; }\n  .map-card .dot {\n    display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: var(--copper); margin-right: 10px;\n  }\n  .map-card ul { list-style: none; margin-top: 16px; display: grid; gap: 10px; position: relative; z-index: 1; }\n  .map-card li { font-size: 0.98rem; }\n  .map-card .btn { margin-top: 24px; position: relative; z-index: 1; }\n\n  /* Reviews */\n  .reviews { background: var(--white); }\n  .review-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }\n  .review {\n    background: var(--cream); border-radius: var(--radius); padding: 30px; border: 1px solid var(--line);\n    display: flex; flex-direction: column;\n  }\n  .stars { color: #e0a526; letter-spacing: 3px; font-size: 1.05rem; margin-bottom: 14px; }\n  .review blockquote { color: #3a4754; font-size: 1rem; flex: 1; margin-bottom: 22px; }\n  .reviewer { display: flex; align-items: center; gap: 12px; }\n  .avatar {\n    width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center;\n    background: var(--navy); color: var(--white); font-weight: 700; font-size: 0.95rem;\n  }\n  .reviewer b { display: block; color: var(--navy); font-size: 0.98rem; }\n  .reviewer span { font-size: 0.85rem; color: var(--muted); }\n  .google-line {\n    text-align: center; margin-top: 36px; color: var(--muted); font-size: 0.97rem;\n  }\n  .google-line strong { color: var(--navy); }\n\n  /* Contact / booking form */\n  .contact { background: var(--navy); color: #c7d3e0; }\n  .contact h2 { color: var(--white); }\n  .contact .eyebrow { color: #f2b48a; }\n  .contact-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 64px; align-items: start; }\n  .contact-info { display: grid; gap: 26px; margin-top: 30px; }\n  .contact-info div { display: flex; gap: 16px; align-items: flex-start; }\n  .contact-info .icon { margin: 0; flex-shrink: 0; background: rgba(255,255,255,.08); width: 48px; height: 48px; }\n  .contact-info .icon svg { stroke: #f2b48a; }\n  .contact-info b { display: block; color: var(--white); font-size: 1.02rem; }\n  .contact-info a { color: #f2b48a; text-decoration: none; font-weight: 700; font-size: 1.25rem; }\n  .contact-info small { color: #9fb0c3; }\n\n  form.booking {\n    background: var(--white); color: var(--ink); border-radius: 22px; padding: 38px;\n    box-shadow: 0 30px 60px rgba(0,0,0,.25);\n  }\n  form.booking h3 { font-size: 1.5rem; margin-bottom: 4px; }\n  form.booking > p { color: var(--muted); margin-bottom: 24px; font-size: 0.95rem; }\n  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }\n  .field { display: flex; flex-direction: column; gap: 6px; }\n  .field.full { grid-column: 1 / -1; }\n  .field label { font-size: 0.88rem; font-weight: 700; color: var(--navy); }\n  .field input, .field select, .field textarea {\n    font: inherit; font-size: 0.98rem; padding: 13px 14px; border-radius: 10px;\n    border: 1.5px solid var(--line); background: var(--cream); color: var(--ink); width: 100%;\n  }\n  .field input:focus, .field select:focus, .field textarea:focus {\n    outline: none; border-color: var(--copper); background: var(--white); box-shadow: 0 0 0 4px rgba(200,112,58,.15);\n  }\n  .field textarea { min-height: 110px; resize: vertical; }\n  .form-foot { margin-top: 22px; display: flex; flex-direction: column; gap: 14px; }\n  .form-foot .btn { width: 100%; }\n  .form-foot small { color: var(--muted); font-size: 0.85rem; text-align: center; }\n  .form-success {\n    display: none; background: #e3f2ea; color: #1d5a40; border-radius: 12px; padding: 16px 18px;\n    font-weight: 600; margin-top: 16px; text-align: center;\n  }\n  .form-success.show { display: block; }\n\n  /* Footer */\n  footer { background: #0e1b2b; color: #9fb0c3; padding: 64px 0 28px; font-size: 0.95rem; }\n  .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 40px; }\n  footer h4 { color: var(--white); font-family: Georgia, serif; font-size: 1.05rem; margin-bottom: 16px; }\n  footer ul { list-style: none; display: grid; gap: 10px; }\n  footer a { color: #9fb0c3; text-decoration: none; }\n  footer a:hover { color: var(--white); }\n  footer .logo-text b { color: var(--white); }\n  footer .logo-text span { color: #7d8fa3; }\n  .accreds { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }\n  .accreds span {\n    border: 1px solid rgba(255,255,255,.15); border-radius: 8px; padding: 7px 12px; font-size: 0.82rem; color: #c7d3e0;\n  }\n  .footer-bottom {\n    margin-top: 48px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,.08);\n    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; font-size: 0.85rem;\n  }\n\n  /* Mobile sticky call bar */\n  .mobile-call { display: none; }\n\n  /* Responsive */\n  @media (max-width: 980px) {\n    .hero-grid, .promise-grid, .story-grid, .areas-grid, .contact-grid { grid-template-columns: 1fr; gap: 44px; }\n    .service-grid, .review-grid { grid-template-columns: 1fr 1fr; }\n    .footer-grid { grid-template-columns: 1fr 1fr; }\n    .stats-grid { grid-template-columns: 1fr 1fr; gap: 24px; }\n    nav.primary { display: none; }\n    nav.primary.open {\n      display: block; position: absolute; top: 76px; left: 0; right: 0; background: var(--cream);\n      border-bottom: 1px solid var(--line); padding: 20px 0;\n    }\n    nav.primary.open ul { flex-direction: column; gap: 18px; align-items: flex-start; }\n    .menu-toggle { display: block; }\n  }\n  @media (max-width: 680px) {\n    section { padding: 64px 0; }\n    .hero { padding: 64px 0 80px; }\n    .service-grid, .review-grid, .form-grid { grid-template-columns: 1fr; }\n    .header-cta .btn { display: none; }\n    .topbar .container { justify-content: center; text-align: center; }\n    .footer-grid { grid-template-columns: 1fr; }\n    form.booking { padding: 26px; }\n    .mobile-call {\n      display: flex; position: fixed; bottom: 0; left: 0; right: 0; z-index: 60;\n      background: var(--copper); color: var(--white); text-align: center; padding: 16px;\n      font-weight: 800; text-decoration: none; box-shadow: 0 -6px 20px rgba(0,0,0,.2);\n      justify-content: center; gap: 10px;\n    }\n    body { padding-bottom: 60px; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    * { animation: none !important; transition: none !important; scroll-behavior: auto !important; }\n  }\n</style>\n</head>\n<body>\n\n<!-- Top bar -->\n<div class=\"topbar\">\n  <div class=\"container\">\n    <span><span class=\"pulse\" aria-hidden=\"true\"></span><strong>Emergency leak or no heating?</strong> We're answering calls 24/7 across Leeds.</span>\n    <a href=\"tel:01134960123\">Call 0113 496 0123</a>\n  </div>\n</div>\n\n<!-- Header -->\n<header class=\"site\">\n  <div class=\"container\">\n    <a href=\"#top\" class=\"logo\" aria-label=\"Hollins Family Plumbing & Heating home\">\n      <svg width=\"40\" height=\"40\" viewBox=\"0 0 40 40\" aria-hidden=\"true\">\n        <rect width=\"40\" height=\"40\" rx=\"12\" fill=\"#14263b\"/>\n        <path d=\"M20 8 C20 8 11 18.5 11 24.5 A9 9 0 0 0 29 24.5 C29 18.5 20 8 20 8 Z\" fill=\"#c8703a\"/>\n        <path d=\"M16 25 A4 4 0 0 0 20 29\" stroke=\"#faf6f0\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\" opacity=\".85\"/>\n      </svg>\n      <div class=\"logo-text\">\n        <b>Hollins</b>\n        <span>Family Plumbing &amp; Heating</span>\n      </div>\n    </a>\n\n    <nav class=\"primary\" id=\"primary-nav\" aria-label=\"Main navigation\">\n      <ul>\n        <li><a href=\"#services\">Services</a></li>\n        <li><a href=\"#pricing\">Pricing</a></li>\n        <li><a href=\"#story\">About</a></li>\n        <li><a href=\"#areas\">Areas</a></li>\n        <li><a href=\"#reviews\">Reviews</a></li>\n        <li><a href=\"#contact\">Contact</a></li>\n      </ul>\n    </nav>\n\n    <div class=\"header-cta\">\n      <a href=\"#contact\" class=\"btn btn-primary btn-small\">Book a visit</a>\n      <button class=\"menu-toggle\" aria-label=\"Toggle menu\" aria-expanded=\"false\" aria-controls=\"primary-nav\" id=\"menuBtn\">\n        <span></span><span></span><span></span>\n      </button>\n    </div>\n  </div>\n</header>\n\n<main id=\"top\">\n\n<!-- Hero -->\n<section class=\"hero\">\n  <div class=\"container hero-grid\">\n    <div>\n      <span class=\"eyebrow\">Leeds plumbers, three generations strong</span>\n      <h1>Plumbing and heating done properly, by people who live here.</h1>\n      <p class=\"lead\">From a dripping tap in Headingley to a boiler failure in Morley, the Hollins family has looked after Leeds homes since 1987. Gas Safe registered, fully insured, and we'll tell you the price before we pick up a spanner.</p>\n      <div class=\"hero-actions\">\n        <a href=\"#contact\" class=\"btn btn-primary\">Book a visit</a>\n        <a href=\"tel:01134960123\" class=\"btn btn-ghost\">Call 0113 496 0123</a>\n      </div>\n      <div class=\"trust-row\">\n        <div>\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#8fe0b7\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6L9 17l-5-5\"/></svg>\n          Gas Safe registered\n        </div>\n        <div>\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#8fe0b7\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6L9 17l-5-5\"/></svg>\n          WaterSafe approved\n        </div>\n        <div>\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#8fe0b7\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6L9 17l-5-5\"/></svg>\n          \u00a35m public liability\n        </div>\n      </div>\n    </div>\n\n    <aside class=\"booking-card\" aria-label=\"Quick booking\">\n      <span class=\"badge\">Next slot: today</span>\n      <h3>Book a visit in under a minute</h3>\n      <p>Pick a time that suits you. Our engineers confirm by text.</p>\n      <div class=\"slot-title\">Today, Leeds LS6 area</div>\n      <div class=\"slots\" role=\"group\" aria-label=\"Available time slots\">\n        <div class=\"slot taken\">8\u201310am</div>\n        <div class=\"slot selected\">10\u201312pm</div>\n        <div class=\"slot\">12\u20132pm</div>\n        <div class=\"slot\">2\u20134pm</div>\n        <div class=\"slot taken\">4\u20136pm</div>\n        <div class=\"slot\">6\u20138pm</div>\n      </div>\n      <a href=\"#contact\" class=\"btn btn-primary\">Continue with this slot</a>\n      <small>Emergencies skip the queue. Call us directly.</small>\n    </aside>\n  </div>\n</section>\n\n<!-- Stats -->\n<div class=\"stats\">\n  <div class=\"container stats-grid\">\n    <div class=\"stat\"><strong>1987</strong><span>Family business since</span></div>\n    <div class=\"stat\"><strong>12,000+</strong><span>Leeds jobs completed</span></div>\n    <div class=\"stat\"><strong>4.9\u2605</strong><span>Average customer rating</span></div>\n    <div class=\"stat\"><strong>24/7</strong><span>Emergency call-out line</span></div>\n  </div>\n</div>\n\n<!-- Services -->\n<section class=\"services\" id=\"services\">\n  <div class=\"container\">\n    <div class=\"section-head\">\n      <span class=\"eyebrow\">What we do</span>\n      <h2>Everything your home's water and heating needs</h2>\n      <p class=\"lead\">Small fixes and full installations, handled by the same trusted team. Every job starts with a clear explanation of what's needed.</p>\n    </div>\n\n    <div class=\"service-grid\">\n      <a href=\"#contact\" class=\"service featured\">\n        <span class=\"tag\">Available now</span>\n        <div class=\"icon\">\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8\"/><circle cx=\"12\" cy=\"12\" r=\"4\"/></svg>\n        </div>\n        <h3>24/7 emergency call-outs</h3>\n        <p>Burst pipes, flooding, or no hot water on a cold night. We aim to reach most Leeds postcodes within two hours.</p>\n        <div class=\"price\">Call-outs from \u00a379 inc. VAT</div>\n      </a>\n\n      <div class=\"service\">\n        <div class=\"icon\">\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5S5.5 10 5.5 14.5a6.5 6.5 0 0 0 13 0C18.5 10 12 2.5 12 2.5z\"/><path d=\"M9.5 14.5a2.5 2.5 0 0 0 2.5 2.5\"/></svg>\n        </div>\n        <h3>Leak detection &amp; repair</h3>\n        <p>We find hidden leaks behind walls, under floors and in ceilings, with minimal disruption to your home.</p>\n        <div class=\"price\">Diagnostics from \u00a395</div>\n      </div>\n\n      <div class=\"service\">\n        <div class=\"icon\">\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"4\" y=\"3\" width=\"16\" height=\"18\" rx=\"2\"/><circle cx=\"12\" cy=\"13\" r=\"4\"/><path d=\"M8 7h2M14 7h2\"/></svg>\n        </div>\n        <h3>Boiler service &amp; repair</h3>\n        <p>All major makes. Annual services, breakdowns, pressure faults and magnetic filter fits, with a service record for your warranty.</p>\n        <div class=\"price\">Annual service from \u00a389</div>\n      </div>\n\n      <div class=\"service\">\n        <div class=\"icon\">\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 12h18v3a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4v-3z\"/><path d=\"M6 12V6a2 2 0 0 1 4 0M7 19v2M17 19v2\"/></svg>\n        </div>\n        <h3>Bathrooms &amp; wet rooms</h3>\n        <p>Full bathroom refits from design through to tiling and sanitaryware. Walk-in showers and accessible wet rooms too.</p>\n        <div class=\"price\">Fixed-price quotes, no surprises</div>\n      </div>\n\n      <div class=\"service\">\n        <div class=\"icon\">\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z\"/></svg>\n        </div>\n        <h3>Central heating</h3>\n        <p>Radiator replacements, powerflushing, thermostat upgrades and smart controls. We'll balance your system so every room heats evenly.</p>\n        <div class=\"price\">Powerflush from \u00a3320</div>\n      </div>\n\n      <div class=\"service\">\n        <div class=\"icon\">\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 9h14l-1.5 10h-11z\"/><path d=\"M9 9V6a3 3 0 0 1 6 0v3\"/><path d=\"M12 13v3\"/></svg>\n        </div>\n        <h3>Drain unblocking</h3>\n        <p>Kitchen, bath and external drains cleared with jetting and CCTV surveys, so we fix the cause and not just the symptom.</p>\n        <div class=\"price\">Unblocking from \u00a385</div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- Pricing promise -->\n<section class=\"promise\" id=\"pricing\">\n  <div class=\"container promise-grid\">\n    <div>\n      <span class=\"eyebrow\">Our promise</span>\n      <h2>You'll know the price before we start</h2>\n      <p class=\"lead\">Plumbing bills have a reputation for surprises. We've built our business on the opposite. Here's what you can count on with every Hollins visit.</p>\n      <ul class=\"checklist\">\n        <li>\n          <span class=\"tick\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20 6L9 17l-5-5\"/></svg></span>\n          <div><strong>Written quotes, always</strong><span>Agreed in writing before any work begins. If the job changes, we ask first.</span></div>\n        </li>\n        <li>\n          <span class=\"tick\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20 6L9 17l-5-5\"/></svg></span>\n          <div><strong>Engineers who stay in touch</strong><span>You get your engineer's name and a text when they're on the way.</span></div>\n        </li>\n        <li>\n          <span class=\"tick\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20 6L9 17l-5-5\"/></svg></span>\n          <div><strong>Guaranteed workmanship</strong><span>Every repair and installation carries a written guarantee, 12 months as standard.</span></div>\n        </li>\n        <li>\n          <span class=\"tick\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20 6L9 17l-5-5\"/></svg></span>\n          <div><strong>Clean up after ourselves</strong><span>Dust sheets, shoe covers, and we take our old parts away with us.</span></div>\n        </li>\n      </ul>\n    </div>\n\n    <div class=\"price-table\" role=\"table\" aria-label=\"Typical prices\">\n      <h3 role=\"columnheader\">Typical starting prices (inc. VAT)</h3>\n      <div class=\"price-row\" role=\"row\"><span role=\"cell\">Emergency call-out (out of hours)</span><b role=\"cell\">From \u00a379</b></div>\n      <div class=\"price-row\" role=\"row\"><span role=\"cell\">Standard call-out and diagnosis</span><b role=\"cell\">From \u00a349</b></div>\n      <div class=\"price-row\" role=\"row\"><span role=\"cell\">Annual boiler service</span><b role=\"cell\">From \u00a389</b></div>\n      <div class=\"price-row\" role=\"row\"><span role=\"cell\">Tap replacement (fitted)</span><b role=\"cell\">From \u00a3120</b></div>\n      <div class=\"price-row\" role=\"row\"><span role=\"cell\">Drain unblocking (single drain)</span><b role=\"cell\">From \u00a385</b></div>\n      <div class=\"price-row\" role=\"row\"><span role=\"cell\">Powerflush (full system)</span><b role=\"cell\">From \u00a3320</b></div>\n      <p class=\"price-note\">Final prices depend on parts and access. You'll always receive a written quote first.</p>\n    </div>\n  </div>\n</section>\n\n<!-- Family story -->\n<section class=\"story\" id=\"story\">\n  <div class=\"container story-grid\">\n    <div class=\"story-art\" role=\"img\" aria-label=\"Illustration of a sunset over Leeds rooftops\">\n      <div class=\"sun\"></div>\n      <div class=\"hill\"></div>\n      <div class=\"quote-card\">\n        <p>\"Dad taught me that a good plumber leaves a house better than he found it. We still work that way.\"</p>\n        <small>Sam Hollins, Director</small>\n      </div>\n    </div>\n\n    <div>\n      <span class=\"eyebrow\">Our story</span>\n      <h2>Started in a van on Harehills Road</h2>\n      <p>Frank Hollins founded the business in 1987 with a single van, a toolbox, and a rule he never broke: if you can't fix it properly, say so. That rule is still on the wall of our Hunslet workshop.</p>\n      <p>Today his son Sam runs the day-to-day, his daughter Priya manages the office and bookings, and a team of 14 Gas Safe and WaterSafe engineers covers the whole of Leeds. Many of our customers are second or third generation Hollins customers, and we'd like to keep it that way.</p>\n      <div class=\"timeline\">\n        <div class=\"tl-item\"><b>1987</b><span>Frank starts the business from his driveway in Harehills.</span></div>\n        <div class=\"tl-item\"><b>2003</b><span>Moved to our Hunslet workshop and grew to a team of six.</span></div>\n        <div class=\"tl-item\"><b>2016</b><span>Launched 24/7 emergency cover across the city.</span></div>\n        <div class=\"tl-item\"><b>Today</b><span>Still family-owned, still answering the phone ourselves.</span></div>\n      </div>\n      <p class=\"signature\" style=\"margin-top:28px\">\u2014 The Hollins family</p>\n    </div>\n  </div>\n</section>\n\n<!-- Areas -->\n<section class=\"areas\" id=\"areas\">\n  <div class=\"container areas-grid\">\n    <div>\n      <span class=\"eyebrow\">Where we work</span>\n      <h2>Covering every corner of Leeds</h2>\n      <p class=\"lead\" style=\"margin-bottom:28px\">Our engineers are based across the city, so we're rarely far away. If you're not sure we cover your street, give us a ring.</p>\n      <div class=\"area-chips\">\n        <span class=\"chip\">Headingley</span>\n        <span class=\"chip\">Roundhay</span>\n        <span class=\"chip\">Chapel Allerton</span>\n        <span class=\"chip\">Horsforth</span>\n        <span class=\"chip\">Kirkstall</span>\n        <span class=\"chip\">Pudsey</span>\n        <span class=\"chip\">Morley</span>\n        <span class=\"chip\">Rothwell</span>\n        <span class=\"chip\">Beeston</span>\n        <span class=\"chip\">Moortown</span>\n        <span class=\"chip\">Harehills</span>\n        <span class=\"chip\">Hyde Park</span>\n        <span class=\"chip\">Garforth</span>\n        <span class=\"chip\">Yeadon</span>\n        <span class=\"chip\">Adel</span>\n        <span class=\"chip\">Wetherby</span>\n      </div>\n    </div>\n\n    <div class=\"map-card\">\n      <div class=\"ring\"></div>\n      <div class=\"ring r2\"></div>\n      <h3>Response times</h3>\n      <ul>\n        <li><span class=\"dot\"></span>Inner Leeds (LS1\u2013LS11): usually within 1 hour</li>\n        <li><span class=\"dot\"></span>Outer Leeds (LS12\u2013LS20): usually within 2 hours</li>\n        <li><span class=\"dot\"></span>Surrounding villages: same day for emergencies</li>\n      </ul>\n      <a href=\"tel:01134960123\" class=\"btn btn-primary\">Check my postcode</a>\n    </div>\n  </div>\n</section>\n\n<!-- Reviews -->\n<section class=\"reviews\" id=\"reviews\">\n  <div class=\"container\">\n    <div class=\"section-head center\">\n      <span class=\"eyebrow\">Customer reviews</span>\n      <h2>Trusted by Leeds neighbours</h2>\n      <p class=\"lead\">Here's what our customers say after we've left their homes dry, warm and tidy.</p>\n    </div>\n\n    <div class=\"review-grid\">\n      <figure class=\"review\">\n        <div class=\"stars\" aria-label=\"5 out of 5 stars\">\u2605\u2605\u2605\u2605\u2605</div>\n        <blockquote>\"Our boiler packed in on Boxing Day. Sam was at the door within the hour, had it running by teatime and didn't charge us a penny extra. Honest, fast, and kind to the kids.\"</blockquote>\n        <figcaption class=\"reviewer\"><span class=\"avatar\">LM</span><div><b>Laura M.</b><span>Headingley \u00b7 Boiler repair</span></div></figcaption>\n      </figure>\n\n      <figure class=\"review\">\n        <div class=\"stars\" aria-label=\"5 out of 5 stars\">\u2605\u2605\u2605\u2605\u2605</div>\n        <blockquote>\"We had a bathroom refit in Roundhay. They gave us a fixed price on day one and stuck to it. The tiling is immaculate and the team left the place spotless.\"</blockquote>\n        <figcaption class=\"reviewer\"><span class=\"avatar\">DR</span><div><b>David R.</b><span>Roundhay \u00b7 Bathroom installation</span></div></figcaption>\n      </figure>\n\n      <figure class=\"review\">\n        <div class=\"stars\" aria-label=\"5 out of 5 stars\">\u2605\u2605\u2605\u2605\u2605</div>\n        <blockquote>\"Found a leak under our kitchen floor that two other firms had missed. Priya kept us updated by text the whole way through. Couldn't ask for more.\"</blockquote>\n        <figcaption class=\"reviewer\"><span class=\"avatar\">AK</span><div><b>Aisha K.</b><span>Horsforth \u00b7 Leak detection</span></div></figcaption>\n      </figure>\n    </div>\n\n    <p class=\"google-line\"><strong>4.9 out of 5</strong> from over 600 Google reviews. Read them all on our Google Business profile.</p>\n  </div>\n</section>\n\n<!-- Contact & booking -->\n<section class=\"contact\" id=\"contact\">\n  <div class=\"container contact-grid\">\n    <div>\n      <span class=\"eyebrow\">Get in touch</span>\n      <h2>Tell us what's going on</h2>\n      <p class=\"lead\" style=\"color:#c7d3e0\">Describe the problem and we'll come back with a time and a price. For emergencies, always call us straight away.</p>\n\n      <div class=\"contact-info\">\n        <div>\n          <span class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z\"/></svg></span>\n          <div>\n            <b>Emergency line, 24/7</b>\n            <a href=\"tel:01134960123\">0113 496 0123</a>\n          </div>\n        </div>\n        <div>\n          <span class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"M3 7l9 6 9-6\"/></svg></span>\n          <div>\n            <b>Email the office</b>\n            <a href=\"mailto:bookings@hollinsplumbing.example\" style=\"font-size:1rem\">bookings@hollinsplumbing.example</a>\n          </div>\n        </div>\n        <div>\n          <span class=\"icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/></svg></span>\n          <div>\n            <b>Office hours</b>\n            <small>Mon\u2013Fri 7:00am\u20137:00pm \u00b7 Sat 8:00am\u20134:00pm \u00b7 Sun emergencies only</small>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <form class=\"booking\" id=\"bookingForm\" novalidate>\n      <h3>Request a visit</h3>\n      <p>We'll call you back within 30 minutes during office hours.</p>\n\n      <div class=\"form-grid\">\n        <div class=\"field\">\n          <label for=\"name\">Full name</label>\n          <input id=\"name\" name=\"name\" type=\"text\" autocomplete=\"name\" required>\n        </div>\n        <div class=\"field\">\n          <label for=\"phone\">Phone number</label>\n          <input id=\"phone\" name=\"phone\" type=\"tel\" autocomplete=\"tel\" required>\n        </div>\n        <div class=\"field\">\n          <label for=\"postcode\">Postcode</label>\n          <input id=\"postcode\" name=\"postcode\" type=\"text\" autocomplete=\"postal-code\" placeholder=\"e.g. LS6 1AB\" required>\n        </div>\n        <div class=\"field\">\n          <label for=\"service\">What do you need?</label>\n          <select id=\"service\" name=\"service\" required>\n            <option value=\"\">Choose a service</option>\n            <option>Emergency (leak, no heating, no hot water)</option>\n            <option>Boiler service or repair</option>\n            <option>Leak detection or repair</option>\n            <option>Drain unblocking</option>\n            <option>Central heating</option>\n            <option>Bathroom or wet room</option>\n            <option>Something else</option>\n          </select>\n        </div>\n        <div class=\"field full\">\n          <label for=\"message\">Tell us more <span style=\"font-weight:400;color:var(--muted)\">(optional)</span></label>\n          <textarea id=\"message\" name=\"message\" placeholder=\"Boiler make and age, where the leak is, access notes, anything that helps.\"></textarea>\n        </div>\n      </div>\n\n      <div class=\"form-foot\">\n        <button type=\"submit\" class=\"btn btn-primary\">Send my request</button>\n        <small>We only use your details to arrange your visit. No spam, ever.</small>\n        <div class=\"form-success\" id=\"formSuccess\" role=\"status\" aria-live=\"polite\">\n          Thanks! We've received your request and will call you shortly.\n        </div>\n      </div>\n    </form>\n  </div>\n</section>\n\n</main>\n\n<!-- Footer -->\n<footer>\n  <div class=\"container\">\n    <div class=\"footer-grid\">\n      <div>\n        <a href=\"#top\" class=\"logo\" aria-label=\"Back to top\">\n          <svg width=\"40\" height=\"40\" viewBox=\"0 0 40 40\" aria-hidden=\"true\">\n            <rect width=\"40\" height=\"40\" rx=\"12\" fill=\"#c8703a\"/>\n            <path d=\"M20 8 C20 8 11 18.5 11 24.5 A9 9 0 0 0 29 24.5 C29 18.5 20 8 20 8 Z\" fill=\"#14263b\"/>\n          </svg>\n          <div class=\"logo-text\"><b>Hollins</b><span>Family Plumbing &amp; Heating</span></div>\n        </a>\n        <p style=\"margin-top:18px;max-width:300px\">Family-run plumbing and heating in Leeds since 1987. Honest prices, careful workmanship, and a real person answering the phone.</p>\n        <div class=\"accreds\">\n          <span>Gas Safe No. 000000</span>\n          <span>WaterSafe</span>\n          <span>Checkatrade</span>\n        </div>\n      </div>\n\n      <div>\n        <h4>Services</h4>\n        <ul>\n          <li><a href=\"#services\">Emergency call-outs</a></li>\n          <li><a href=\"#services\">Boiler repair</a></li>\n          <li><a href=\"#services\">Leak detection</a></li>\n          <li><a href=\"#services\">Bathrooms</a></li>\n          <li><a href=\"#services\">Drain unblocking</a></li>\n        </ul>\n      </div>\n\n      <div>\n        <h4>Company</h4>\n        <ul>\n          <li><a href=\"#story\">Our story</a></li>\n          <li><a href=\"#reviews\">Reviews</a></li>\n          <li><a href=\"#areas\">Areas we cover</a></li>\n          <li><a href=\"#pricing\">Pricing</a></li>\n          <li><a href=\"#contact\">Contact</a></li>\n        </ul>\n      </div>\n\n      <div>\n        <h4>Contact</h4>\n        <ul>\n          <li><a href=\"tel:01134960123\">0113 496 0123</a></li>\n          <li><a href=\"mailto:bookings@hollinsplumbing.example\">Email us</a></li>\n          <li>Unit 4, Hunslet Mills<br>Leeds LS10 2BP</li>\n        </ul>\n      </div>\n    </div>\n\n    <div class=\"footer-bottom\">\n      <span>\u00a9 <span id=\"year\">2025</span> Hollins Family Plumbing &amp; Heating Ltd. Registered in England &amp; Wales.</span>\n      <span><a href=\"#top\">Privacy</a> \u00b7 <a href=\"#top\">Terms</a> \u00b7 <a href=\"#top\">Cookies</a></span>\n    </div>\n  </div>\n</footer>\n\n<a href=\"tel:01134960123\" class=\"mobile-call\" aria-label=\"Call Hollins Plumbing\">\n  <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z\"/></svg>\n  Call now: 0113 496 0123\n</a>\n\n<script>\n  // Mobile menu toggle\n  const menuBtn = document.getElementById('menuBtn');\n  const nav = document.getElementById('primary-nav');\n  menuBtn.addEventListener('click', () => {\n    const open = nav.classList.toggle('open');\n    menuBtn.setAttribute('aria-expanded', open);\n  });\n  nav.querySelectorAll('a').forEach(link =>\n    link.addEventListener('click', () => {\n      nav.classList.remove('open');\n      menuBtn.setAttribute('aria-expanded', 'false');\n    })\n  );\n\n  // Time slot selection (hero widget)\n  document.querySelectorAll('.slot:not(.taken)').forEach(slot => {\n    slot.addEventListener('click', () => {\n      document.querySelectorAll('.slot').forEach(s => s.classList.remove('selected'));\n      slot.classList.add('selected');\n    });\n  });\n\n  // Booking form: client-side validation and confirmation\n  const form = document.getElementById('bookingForm');\n  const success = document.getElementById('formSuccess');\n  form.addEventListener('submit', (e) => {\n    e.preventDefault();\n    let valid = true;\n    form.querySelectorAll('[required]').forEach(field => {\n      const ok = field.value.trim() !== '';\n      field.style.borderColor = ok ? '' : '#c0392b';\n      if (!ok) valid = false;\n    });\n    if (valid) {\n      success.classList.add('show');\n      form.reset();\n    } else {\n      const firstInvalid = form.querySelector('[required]:invalid, [required][style*=\"rgb(192\"], [required][style*=\"#c0392b\"]');\n      const empty = [...form.querySelectorAll('[required]')].find(f => !f.value.trim());\n      if (empty) empty.focus();\n    }\n  });\n\n  // Footer year\n  document.getElementById('year').textContent = new Date().getFullYear();\n</script>\n\n</body>\n</html>\n"}