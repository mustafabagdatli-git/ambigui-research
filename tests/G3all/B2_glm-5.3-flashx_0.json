{"brief": "B2", "model": "z-ai/glm-5.3-flashx", "i": 0, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>WonderLab \u2014 Children's Science Museum</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Nunito:wght@400;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --paper:#FFF6E9;\n    --ink:#2B2118;\n    --coral:#FF6B4A;\n    --teal:#1FA9A0;\n    --sun:#FFC93C;\n    --sky:#E8F4F2;\n    --berry:#E5484D;\n  }\n  *{margin:0;padding:0;box-sizing:border-box}\n  html{scroll-behavior:smooth}\n  body{\n    font-family:'Nunito',sans-serif;\n    background:var(--paper);\n    color:var(--ink);\n    overflow-x:hidden;\n  }\n  h1,h2,h3{font-family:'Baloo 2',cursive}\n\n  /* ===== NAV ===== */\n  nav{\n    position:sticky;top:0;z-index:50;\n    display:flex;align-items:center;justify-content:space-between;\n    padding:14px 5vw;\n    background:rgba(255,246,233,.92);\n    backdrop-filter:blur(8px);\n    border-bottom:3px solid var(--ink);\n  }\n  .logo{display:flex;align-items:center;gap:10px;font-family:'Baloo 2';font-weight:800;font-size:1.5rem;text-decoration:none;color:var(--ink)}\n  .logo svg{transition:transform .4s}\n  .logo:hover svg{transform:rotate(180deg)}\n  .nav-links{display:flex;gap:26px;align-items:center}\n  .nav-links a{color:var(--ink);text-decoration:none;font-weight:700;position:relative}\n  .nav-links a::after{content:\"\";position:absolute;left:0;bottom:-4px;width:0;height:3px;background:var(--coral);border-radius:3px;transition:width .25s}\n  .nav-links a:hover::after{width:100%}\n  .btn{\n    font-family:'Baloo 2';font-weight:700;\n    display:inline-block;\n    padding:10px 24px;border-radius:999px;\n    background:var(--coral);color:#fff;text-decoration:none;\n    border:3px solid var(--ink);\n    box-shadow:4px 4px 0 var(--ink);\n    transition:transform .15s, box-shadow .15s;\n  }\n  .btn:hover{transform:translate(-2px,-2px);box-shadow:6px 6px 0 var(--ink)}\n  .btn:active{transform:translate(3px,3px);box-shadow:0 0 0 var(--ink)}\n  .btn.teal{background:var(--teal)}\n  .btn.sun{background:var(--sun);color:var(--ink)}\n\n  /* ===== HERO ===== */\n  header{\n    position:relative;\n    padding:80px 5vw 120px;\n    text-align:center;\n  }\n  .hero-kicker{\n    display:inline-block;background:var(--sun);\n    border:3px solid var(--ink);border-radius:999px;\n    padding:6px 20px;font-weight:800;letter-spacing:.5px;\n    transform:rotate(-2deg);\n    box-shadow:3px 3px 0 var(--ink);\n  }\n  header h1{\n    font-size:clamp(2.6rem,7vw,5.2rem);\n    line-height:1.05;margin:24px auto 16px;max-width:900px;\n  }\n  header h1 .squig{\n    color:var(--coral);position:relative;display:inline-block;\n  }\n  .squig svg{position:absolute;left:0;bottom:-14px;width:100%}\n  header p{max-width:560px;margin:0 auto 32px;font-size:1.15rem;font-weight:600;opacity:.85}\n  .hero-cta{display:flex;gap:16px;justify-content:center;flex-wrap:wrap}\n\n  /* floating doodles */\n  .float{position:absolute;animation:bob 5s ease-in-out infinite;pointer-events:none}\n  @keyframes bob{0%,100%{transform:translateY(0) rotate(-4deg)}50%{transform:translateY(-18px) rotate(4deg)}}\n  .f1{top:12%;left:7%;animation-delay:0s}\n  .f2{top:20%;right:9%;animation-delay:.8s}\n  .f3{bottom:14%;left:14%;animation-delay:1.6s}\n  .f4{bottom:20%;right:12%;animation-delay:2.4s}\n  @media(max-width:700px){.float{transform:scale(.6);opacity:.5}}\n\n  /* squiggle divider */\n  .divider{display:block;width:100%;margin:-1px 0}\n\n  /* ===== EXHIBITS ===== */\n  section{padding:90px 5vw}\n  .sec-title{text-align:center;font-size:clamp(2rem,4.5vw,3rem);margin-bottom:12px}\n  .sec-sub{text-align:center;max-width:520px;margin:0 auto 56px;font-weight:600;opacity:.75}\n  .cards{\n    display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));\n    gap:32px;max-width:1200px;margin:0 auto;\n  }\n  .card{\n    background:#fff;border:3px solid var(--ink);border-radius:24px;\n    padding:32px 28px;box-shadow:6px 6px 0 var(--ink);\n    transition:transform .2s, box-shadow .2s;\n    position:relative;overflow:hidden;\n  }\n  .card:hover{transform:translate(-4px,-4px) rotate(-1deg);box-shadow:10px 10px 0 var(--ink)}\n  .card .badge{\n    position:absolute;top:-14px;right:20px;background:var(--berry);color:#fff;\n    font-family:'Baloo 2';font-weight:700;padding:4px 16px;\n    border:3px solid var(--ink);border-radius:999px;transform:rotate(3deg);\n    font-size:.85rem;\n  }\n  .card h3{font-size:1.5rem;margin:18px 0 8px}\n  .card p{font-weight:600;opacity:.8;line-height:1.55}\n  .card .age{margin-top:16px;display:inline-block;font-weight:800;font-size:.85rem;\n    border:2px solid var(--ink);border-radius:999px;padding:3px 12px}\n  .icon-wrap{\n    width:72px;height:72px;border-radius:50%;\n    display:flex;align-items:center;justify-content:center;\n    border:3px solid var(--ink);\n  }\n  .c1 .icon-wrap{background:var(--sun)}\n  .c2 .icon-wrap{background:var(--teal)}\n  .c3 .icon-wrap{background:var(--coral)}\n\n  /* ===== BIG MOMENT: interactive lab ===== */\n  .lab{\n    background:var(--ink);color:var(--paper);\n  }\n  .lab-inner{max-width:1100px;margin:0 auto;text-align:center}\n  .lab h2{font-size:clamp(2rem,4.5vw,3rem);color:var(--sun)}\n  .lab p{max-width:520px;margin:12px auto 40px;font-weight:600;opacity:.85}\n  .lab-stage{\n    background:#1B140E;border:3px solid var(--paper);border-radius:24px;\n    padding:40px 20px;position:relative;overflow:hidden;cursor:pointer;\n    user-select:none;\n  }\n  .lab-stage svg{max-width:100%}\n  .atom-orbit{transform-origin:center;animation:spin 8s linear infinite}\n  @keyframes spin{to{transform:rotate(360deg)}}\n  .lab-hint{margin-top:18px;font-family:'Baloo 2';font-weight:700;color:var(--sun);font-size:1.1rem}\n  .bubbles span{\n    position:absolute;bottom:-60px;border-radius:50%;\n    background:rgba(255,201,60,.25);border:2px solid var(--sun);\n    animation:rise 4s ease-in forwards;\n  }\n  @keyframes rise{to{transform:translateY(-420px);opacity:0}}\n\n  /* ===== VISIT ===== */\n  .visit-grid{\n    display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));\n    gap:28px;max-width:1100px;margin:0 auto;\n  }\n  .visit-card{\n    background:#fff;border:3px solid var(--ink);border-radius:20px;\n    padding:28px;text-align:center;box-shadow:5px 5px 0 var(--ink);\n  }\n  .visit-card h3{margin:12px 0 6px;font-size:1.3rem}\n  .visit-card p{font-weight:600;opacity:.8;line-height:1.6}\n  .visit-card .big{font-family:'Baloo 2';font-weight:800;font-size:1.8rem;color:var(--teal)}\n\n  /* ===== FOOTER ===== */\n  footer{\n    background:var(--ink);color:var(--paper);\n    text-align:center;padding:56px 5vw 40px;\n  }\n  footer h2{font-size:2rem;color:var(--sun);margin-bottom:16px}\n  footer p{opacity:.7;font-weight:600;margin-top:24px;font-size:.9rem}\n</style>\n</head>\n<body>\n\n<nav>\n  <a class=\"logo\" href=\"#\">\n    <svg width=\"34\" height=\"34\" viewBox=\"0 0 34 34\"><circle cx=\"17\" cy=\"17\" r=\"8\" fill=\"#FF6B4A\" stroke=\"#2B2118\" stroke-width=\"2.5\"/><ellipse cx=\"17\" cy=\"17\" rx=\"15\" ry=\"6\" fill=\"none\" stroke=\"#1FA9A0\" stroke-width=\"2.5\" transform=\"rotate(-25 17 17)\"/></svg>\n    WonderLab\n  </a>\n  <div class=\"nav-links\">\n    <a href=\"#exhibits\">Exhibits</a>\n    <a href=\"#lab\">Play Lab</a>\n    <a href=\"#visit\">Visit</a>\n    <a class=\"btn\" href=\"#visit\">Get Tickets</a>\n  </div>\n</nav>\n\n<!-- ===== HERO ===== -->\n<header>\n  <!-- floating doodles -->\n  <div class=\"float f1\">\n    <svg width=\"70\" height=\"70\" viewBox=\"0 0 70 70\"><path d=\"M35 8 Q50 20 58 35 Q50 50 35 62 Q20 50 12 35 Q20 20 35 8Z\" fill=\"#1FA9A0\" stroke=\"#2B2118\" stroke-width=\"3\"/><circle cx=\"35\" cy=\"35\" r=\"7\" fill=\"#FFC93C\" stroke=\"#2B2118\" stroke-width=\"3\"/></svg>\n  </div>\n  <div class=\"float f2\">\n    <svg width=\"60\" height=\"80\" viewBox=\"0 0 60 80\"><rect x=\"20\" y=\"8\" width=\"20\" height=\"46\" rx=\"10\" fill=\"#FF6B4A\" stroke=\"#2B2118\" stroke-width=\"3\"/><path d=\"M30 54 L14 74 M30 54 L46 74\" stroke=\"#2B2118\" stroke-width=\"4\" stroke-linecap=\"round\"/><circle cx=\"30\" cy=\"14\" r=\"4\" fill=\"#FFC93C\"/></svg>\n  </div>\n  <div class=\"float f3\">\n    <svg width=\"72\" height=\"60\" viewBox=\"0 0 72 60\"><path d=\"M6 30 Q18 8 36 30 Q54 52 66 30\" fill=\"none\" stroke=\"#E5484D\" stroke-width=\"6\" stroke-linecap=\"round\"/></svg>\n  </div>\n  <div class=\"float f4\">\n    <svg width=\"70\" height=\"70\" viewBox=\"0 0 70 70\"><circle cx=\"35\" cy=\"35\" r=\"18\" fill=\"#FFC93C\" stroke=\"#2B2118\" stroke-width=\"3\"/><g stroke=\"#2B2118\" stroke-width=\"3\"><line x1=\"35\" y1=\"4\" x2=\"35\" y2=\"17\"/><line x1=\"35\" y1=\"53\" x2=\"35\" y2=\"66\"/><line x1=\"4\" y1=\"35\" x2=\"17\" y2=\"35\"/><line x1=\"53\" y1=\"35\" x2=\"66\" y2=\"35\"/></g><circle cx=\"35\" cy=\"35\" r=\"18\" fill=\"none\" stroke=\"#2B2118\" stroke-width=\"3\"/></svg>\n  </div>\n\n  <span class=\"hero-kicker\">\ud83d\udd2c Now open \u2014 Weekends & school holidays!</span>\n  <h1>Where curious kids become\n    <span class=\"squig\">tiny scientists\n      <svg viewBox=\"0 0 200 20\" preserveAspectRatio=\"none\"><path d=\"M4 12 Q25 2 50 12 Q75 22 100 12 Q125 2 150 12 Q175 22 196 12\" fill=\"none\" stroke=\"#FFC93C\" stroke-width=\"7\" stroke-linecap=\"round\"/></svg>\n    </span>\n  </h1>\n  <p>Three floors of hands-on experiments, bubbling beakers, and gloriously messy discoveries \u2014 built for kids ages 3\u201312 and the grown-ups who love them.</p>\n  <div class=\"hero-cta\">\n    <a class=\"btn\" href=\"#visit\">Book Your Visit</a>\n    <a class=\"btn teal\" href=\"#exhibits\">See the Exhibits</a>\n  </div>\n</header>\n\n<!-- wavy divider -->\n<svg class=\"divider\" viewBox=\"0 0 1440 60\" preserveAspectRatio=\"none\" style=\"height:60px\"><path d=\"M0 30 Q120 0 240 30 Q360 60 480 30 Q600 0 720 30 Q840 60 960 30 Q1080 0 1200 30 Q1320 60 1440 30 L1440 60 L0 60Z\" fill=\"#1FA9A0\"/></svg>\n\n<!-- ===== EXHIBITS ===== -->\n<section id=\"exhibits\" style=\"background:var(--teal)\">\n  <h2 class=\"sec-title\" style=\"color:#fff\">Pick Your Adventure</h2>\n  <p class=\"sec-sub\" style=\"color:#fff;opacity:.9\">Every exhibit is touchable, testable, and totally kid-powered. No glass boxes here!</p>\n  <div class=\"cards\">\n\n    <div class=\"card c1\">\n      <div class=\"icon-wrap\">\n        <svg width=\"40\" height=\"40\" viewBox=\"0 0 40 40\"><path d=\"M17 4 h6 v14 l9 14 a4 4 0 0 1-3.4 6H11.4 A4 4 0 0 1 8 32 L17 18Z\" fill=\"#fff\" stroke=\"#2B2118\" stroke-width=\"2.5\"/><circle cx=\"17\" cy=\"30\" r=\"3\" fill=\"#FF6B4A\"/><circle cx=\"23\" cy=\"33\" r=\"2\" fill=\"#1FA9A0\"/></svg>\n      </div>\n      <h3>The Bubble Factory</h3>\n      <p>Dip giant wands, step inside a human-sized bubble, and discover why soap films love circles.</p>\n      <span class=\"age\">Ages 3+</span>\n    </div>\n\n    <div class=\"card c2\">\n      <div class=\"badge\">MOST POPULAR</div>\n      <div class=\"icon-wrap\">\n        <svg width=\"40\" height=\"40\" viewBox=\"0 0 40 40\"><circle cx=\"20\" cy=\"20\" r=\"8\" fill=\"#FFC93C\" stroke=\"#2B2118\" stroke-width=\"2.5\"/><ellipse cx=\"20\" cy=\"20\" rx=\"18\" ry=\"7\" fill=\"none\" stroke=\"#2B2118\" stroke-width=\"2.5\" transform=\"rotate(-25 20 20)\"/></svg>\n      </div>\n      <h3>Space Station Playground</h3>\n      <p>Climb through a rocket, steer a Mars rover, and launch foam meteors across the gravity well.</p>\n      <span class=\"age\">Ages 5+</span>\n    </div>\n\n    <div class=\"card c3\">\n      <div class=\"icon-wrap\">\n        <svg width=\"40\" height=\"40\" viewBox=\"0 0 40 40\"><path d=\"M6 32 Q13 10 20 24 Q27 38 34 14\" fill=\"none\" stroke=\"#2B2118\" stroke-width=\"3.5\" stroke-linecap=\"round\"/><circle cx=\"34\" cy=\"14\" r=\"4\" fill=\"#2B2118\"/></svg>\n      </div>\n      <h3>Zap! Electricity Zone</h3>\n      <p>Build circuits with squishy dough, crank a human generator, and make lightning you can hear.</p>\n      <span class=\"age\">Ages 7+</span>\n    </div>\n\n  </div>\n</section>\n\n<!-- wavy divider -->\n<svg class=\"divider\" viewBox=\"0 0 1440 60\" preserveAspectRatio=\"none\" style=\"height:60px\"><path d=\"M0 30 Q120 60 240 30 Q360 0 480 30 Q600 60 720 30 Q840 0 960 30 Q1080 60 1200 30 Q1320 0 1440 30 L1440 60 L0 60Z\" fill=\"#1FA9A0\"/></svg>\n\n<!-- ===== PLAY LAB ===== -->\n<section class=\"lab\" id=\"lab\">\n  <div class=\"lab-inner\">\n    <h2>The Play Lab \u269b\ufe0f</h2>\n    <p>Can't wait until your visit? Tap the atom to kick up some energy \u2014 just a tiny taste of the fun waiting at WonderLab.</p>\n\n    <div class=\"lab-stage\" id=\"labStage\">\n      <svg viewBox=\"0 0 300 200\" width=\"340\" id=\"atomSvg\">\n        <g class=\"atom-orbit\">\n          <ellipse cx=\"150\" cy=\"100\" rx=\"90\" ry=\"34\" fill=\"none\" stroke=\"#FFC93C\" stroke-width=\"3\"/>\n          <ellipse cx=\"150\" cy=\"100\" rx=\"90\" ry=\"34\" fill=\"none\" stroke=\"#1FA9A0\" stroke-width=\"3\" transform=\"rotate(60 150 100)\"/>\n          <ellipse cx=\"150\" cy=\"100\" rx=\"90\" ry=\"34\" fill=\"none\" stroke=\"#FF6B4A\" stroke-width=\"3\" transform=\"rotate(-60 150 100)\"/>\n          <circle cx=\"240\" cy=\"100\" r=\"9\" fill=\"#FFC93C\" stroke=\"#FFF6E9\" stroke-width=\"2\"/>\n          <circle cx=\"105\" cy=\"22\" r=\"9\" fill=\"#1FA9A0\" stroke=\"#FFF6E9\" stroke-width=\"2\"/>\n          <circle cx=\"105\" cy=\"178\" r=\"9\" fill=\"#FF6B4A\" stroke=\"#FFF6E9\" stroke-width=\"2\"/>\n        </g>\n        <circle cx=\"150\" cy=\"100\" r=\"22\" fill=\"#FF6B4A\" stroke=\"#FFF6E9\" stroke-width=\"3\" id=\"nucleus\"/>\n        <text x=\"150\" y=\"107\" text-anchor=\"middle\" font-family=\"Baloo 2\" font-weight=\"800\" font-size=\"18\" fill=\"#FFF6E9\">Go!</text>\n      </svg>\n    </div>\n    <div class=\"lab-hint\" id=\"labHint\">\ud83d\udc46 Tap the atom to make bubbles!</div>\n  </div>\n</section>\n\n<!-- ===== VISIT ===== -->\n<section id=\"visit\">\n  <h2 class=\"sec-title\">Plan Your Visit</h2>\n  <p class=\"sec-sub\">Everything you need to know before the big day.</p>\n  <div class=\"visit-grid\">\n    <div class=\"visit-card\">\n      <svg width=\"44\" height=\"44\" viewBox=\"0 0 44 44\"><circle cx=\"22\" cy=\"22\" r=\"18\" fill=\"#FFC93C\" stroke=\"#2B2118\" stroke-width=\"2.5\"/><path d=\"M22 12 v10 l7 5\" stroke=\"#2B2118\" stroke-width=\"3\" fill=\"none\" stroke-linecap=\"round\"/></svg>\n      <h3>Hours</h3>\n      <p><span class=\"big\">10am \u2013 5pm</span><br>Wednesday through Sunday<br>Closed Mondays & Tuesdays</p>\n    </div>\n    <div class=\"visit-card\">\n      <svg width=\"44\" height=\"44\" viewBox=\"0 0 44 44\"><rect x=\"6\" y=\"14\" width=\"32\" height=\"18\" rx=\"6\" fill=\"#FF6B4A\" stroke=\"#2B2118\" stroke-width=\"2.5\"/><circle cx=\"14\" cy=\"23\" r=\"2.5\" fill=\"#FFF6E9\"/><path d=\"M20 18 h12 M20 23 h12 M20 28 h8\" stroke=\"#FFF6E9\" stroke-width=\"2.5\" stroke-linecap=\"round\"/></svg>\n      <h3>Tickets</h3>\n      <p><span class=\"big\">$12</span> per person<br>Kids under 2 are free<br>Members always free!</p>\n    </div>\n    <div class=\"visit-card\">\n      <svg width=\"44\" height=\"44\" viewBox=\"0 0 44 44\"><path d=\"M22 4 C14 4 10 10 10 16 c0 10 12 24 12 24 s12-14 12-24 c0-6-4-12-12-12z\" fill=\"#1FA9A0\" stroke=\"#2B2118\" stroke-width=\"2.5\"/><circle cx=\"22\" cy=\"16\" r=\"4.5\" fill=\"#FFF6E9\"/></svg>\n      <h3>Find Us</h3>\n      <p><span class=\"big\">42 Curiosity Lane</span><br>Downtown, next to the fountain<br>Free parking on weekends</p>\n    </div>\n  </div>\n</section>\n\n<!-- ===== FOOTER ===== -->\n<footer>\n  <h2>Ready to get curious?</h2>\n  <a class=\"btn sun\" href=\"#\">Book Tickets Now</a>\n  <p>\u00a9 2025 WonderLab Children's Science Museum \u00b7 Made with curiosity \u2726</p>\n</footer>\n\n<script>\n  const stage = document.getElementById('labStage');\n  const hint = document.getElementById('labHint');\n  const phrases = [\n    '\ud83d\udc46 Tap the atom to make bubbles!',\n    '\u26a1 Zappity zap! Try again!',\n    '\ud83d\udd2c Science is 90% giggles.',\n    '\ud83d\ude80 More energy! Keep tapping!',\n    '\u2728 You are officially a scientist now.'\n  ];\n  let taps = 0;\n  stage.addEventListener('click', (e) => {\n    const rect = stage.getBoundingClientRect();\n    for (let i = 0; i < 6; i++) {\n      const b = document.createElement('span');\n      const size = 10 + Math.random() * 26;\n      b.style.width = b.style.height = size + 'px';\n      b.style.left = (e.clientX - rect.left - size/2 + (Math.random()*80-40)) + 'px';\n      b.style.animationDuration = (2.5 + Math.random()*2) + 's';\n      stage.appendChild(b);\n      setTimeout(() => b.remove(), 4500);\n    }\n    taps++;\n    hint.textContent = phrases[Math.min(taps, phrases.length - 1)];\n  });\n</script>\n</body>\n</html>\n"}