{"brief": "B6", "model": "z-ai/glm-5.3-flashx", "i": 0, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>GRINDHAUS \u2014 Skate Shop & Lessons</title>\n<style>\n  :root{\n    --ink:#111;\n    --paper:#f4f0e6;\n    --acid:#d8ff3e;\n    --hot:#ff4d2e;\n    --blue:#2b4bff;\n  }\n  *{margin:0;padding:0;box-sizing:border-box}\n  html{scroll-behavior:smooth}\n  body{\n    font-family:'Arial Black','Helvetica Neue',Arial,sans-serif;\n    background:var(--paper);\n    color:var(--ink);\n    overflow-x:hidden;\n  }\n  a{color:inherit;text-decoration:none}\n\n  /* ===== marquee ===== */\n  .marquee{\n    background:var(--ink);color:var(--acid);\n    padding:10px 0;white-space:nowrap;overflow:hidden;\n    font-size:14px;letter-spacing:2px;text-transform:uppercase;\n  }\n  .marquee span{display:inline-block;animation:slide 22s linear infinite}\n  @keyframes slide{from{transform:translateX(0)}to{transform:translateX(-50%)}}\n\n  /* ===== nav ===== */\n  nav{\n    display:flex;align-items:center;justify-content:space-between;\n    padding:18px 5%;position:sticky;top:0;background:var(--paper);\n    border-bottom:3px solid var(--ink);z-index:100;\n  }\n  .logo{font-size:22px;letter-spacing:-1px}\n  .logo b{background:var(--ink);color:var(--acid);padding:2px 8px;transform:skewX(-8deg);display:inline-block}\n  nav ul{display:flex;gap:28px;list-style:none;font-size:13px;letter-spacing:2px}\n  nav ul a:hover{color:var(--hot)}\n  .nav-cta{\n    background:var(--hot);color:#fff;padding:10px 20px;\n    transform:skewX(-8deg);font-size:13px;letter-spacing:1px;\n    box-shadow:4px 4px 0 var(--ink);transition:.15s;\n  }\n  .nav-cta:hover{transform:skewX(-8deg) translate(-2px,-2px);box-shadow:6px 6px 0 var(--ink)}\n\n  /* ===== hero ===== */\n  header{\n    padding:70px 5% 90px;position:relative;\n    background:\n      repeating-linear-gradient(-45deg, transparent 0 60px, rgba(0,0,0,.04) 60px 61px),\n      var(--paper);\n  }\n  .hero-flex{display:flex;gap:40px;align-items:center;flex-wrap:wrap}\n  .hero-text{flex:1 1 480px}\n  h1{\n    font-size:clamp(48px,9vw,110px);\n    line-height:.9;letter-spacing:-3px;text-transform:uppercase;\n  }\n  h1 .stroke{color:transparent;-webkit-text-stroke:3px var(--ink)}\n  h1 .acid{background:var(--acid);padding:0 12px;display:inline-block;transform:rotate(-2deg)}\n  .hero-text p{\n    font-family:Georgia,serif;font-size:19px;line-height:1.6;\n    max-width:480px;margin:28px 0 36px;\n  }\n  .btn-row{display:flex;gap:18px;flex-wrap:wrap}\n  .btn{\n    display:inline-block;padding:16px 30px;font-size:15px;letter-spacing:1px;\n    text-transform:uppercase;transform:skewX(-8deg);\n    transition:.15s;\n  }\n  .btn>span{display:inline-block;transform:skewX(8deg)}\n  .btn-dark{background:var(--ink);color:var(--acid);box-shadow:5px 5px 0 var(--hot)}\n  .btn-hot{background:var(--hot);color:#fff;border:3px solid var(--ink)}\n  .btn:hover{transform:skewX(-8deg) translate(-3px,-3px)}\n  .btn-dark:hover{box-shadow:8px 8px 0 var(--hot)}\n  .btn-hot:hover{box-shadow:5px 5px 0 var(--ink)}\n\n  /* CSS skateboard */\n  .board-wrap{flex:1 1 340px;display:flex;justify-content:center;animation:float 4s ease-in-out infinite}\n  @keyframes float{0%,100%{transform:rotate(-18deg) translateY(0)}50%{transform:rotate(-18deg) translateY(-16px)}}\n  .board{position:relative;width:300px;height:640px}\n  .deck{\n    width:130px;height:560px;margin:0 auto;\n    background:linear-gradient(160deg,var(--hot) 0 30%,var(--acid) 30% 55%,var(--blue) 55%);\n    border-radius:65px/90px;border:5px solid var(--ink);position:relative;\n    box-shadow:10px 12px 0 rgba(0,0,0,.25);\n  }\n  .deck::after{\n    content:\"GRINDHAUS\";position:absolute;inset:0;\n    display:flex;align-items:center;justify-content:center;\n    color:var(--ink);font-size:20px;letter-spacing:4px;\n    writing-mode:vertical-rl;opacity:.75;\n  }\n  .wheel{\n    position:absolute;width:52px;height:52px;border-radius:50%;\n    background:radial-gradient(circle at 35% 35%,#fff 0 20%,#f2b200 21%);\n    border:5px solid var(--ink);left:50%;\n  }\n  .wheel::before{content:\"\";position:absolute;inset:35%;background:var(--ink);border-radius:50%}\n  .w1{top:140px;transform:translateX(-50%) translateX(-55px)}\n  .w2{top:140px;transform:translateX(-50%) translateX(55px)}\n  .w3{top:440px;transform:translateX(-50%) translateX(-55px)}\n  .w4{top:440px;transform:translateX(-50%) translateX(55px)}\n  .truck{\n    position:absolute;left:50%;transform:translateX(-50%);\n    width:120px;height:14px;background:var(--ink);border-radius:7px;\n  }\n  .t1{top:166px}.t2{top:466px}\n\n  /* ===== ticker strip ===== */\n  .strip{\n    background:var(--blue);color:#fff;border-top:3px solid var(--ink);border-bottom:3px solid var(--ink);\n    padding:14px 0;text-transform:uppercase;font-size:18px;letter-spacing:3px;\n    white-space:nowrap;overflow:hidden;\n  }\n  .strip span{display:inline-block;animation:slide 18s linear infinite reverse}\n\n  /* ===== sections ===== */\n  section{padding:90px 5%}\n  .tag{\n    display:inline-block;background:var(--ink);color:var(--acid);\n    padding:6px 14px;font-size:12px;letter-spacing:3px;text-transform:uppercase;\n    transform:skewX(-8deg);margin-bottom:18px;\n  }\n  h2{font-size:clamp(34px,5vw,60px);text-transform:uppercase;letter-spacing:-2px;margin-bottom:14px}\n  .sub{font-family:Georgia,serif;font-size:18px;max-width:560px;line-height:1.6;margin-bottom:50px}\n\n  /* decks grid */\n  .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:26px}\n  .card{\n    border:3px solid var(--ink);background:#fff;padding:22px;\n    transition:.15s;position:relative;\n  }\n  .card:hover{transform:translate(-4px,-4px);box-shadow:8px 8px 0 var(--ink)}\n  .card .art{\n    height:220px;border:3px solid var(--ink);margin-bottom:18px;\n    display:flex;align-items:center;justify-content:center;font-size:40px;\n  }\n  .a1{background:linear-gradient(135deg,var(--acid),#9ecb00)}\n  .a2{background:repeating-linear-gradient(45deg,var(--hot) 0 20px,#ff7a5e 20px 40px)}\n  .a3{background:radial-gradient(circle at 30% 30%,#6d83ff,var(--blue))}\n  .a4{background:repeating-linear-gradient(-45deg,var(--ink) 0 14px,var(--paper) 14px 28px)}\n  .card h3{font-size:18px;text-transform:uppercase;letter-spacing:1px}\n  .card p{font-family:Georgia,serif;font-size:14px;color:#555;margin:8px 0 14px}\n  .price{font-size:22px}\n  .price s{font-size:14px;color:#999;margin-left:8px}\n  .badge{\n    position:absolute;top:-14px;right:-10px;background:var(--hot);color:#fff;\n    padding:5px 12px;font-size:11px;letter-spacing:2px;transform:rotate(6deg);\n    border:2px solid var(--ink);\n  }\n\n  /* lessons */\n  .lessons{background:var(--ink);color:var(--paper)}\n  .lessons h2{color:var(--acid)}\n  .lesson-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:26px}\n  .lesson{\n    border:3px solid var(--acid);padding:30px;transition:.15s;background:#181818;\n  }\n  .lesson:hover{background:var(--acid);color:var(--ink)}\n  .lesson .lvl{font-size:12px;letter-spacing:3px;text-transform:uppercase;color:var(--hot)}\n  .lesson:hover .lvl{color:var(--ink)}\n  .lesson h3{font-size:26px;text-transform:uppercase;margin:10px 0}\n  .lesson ul{list-style:none;font-family:Georgia,serif;font-size:15px;line-height:2;margin:14px 0 20px}\n  .lesson li::before{content:\"\u25b8 \";color:var(--hot)}\n  .lesson:hover li::before{color:var(--ink)}\n  .lesson .cost{font-size:34px}\n  .lesson .cost small{font-size:13px;letter-spacing:1px}\n  .lesson .pick{\n    display:inline-block;margin-top:18px;background:var(--acid);color:var(--ink);\n    padding:10px 22px;font-size:13px;letter-spacing:2px;transform:skewX(-8deg);\n  }\n  .lesson:hover .pick{background:var(--ink);color:var(--acid)}\n\n  /* coach / quote */\n  .quote{\n    max-width:820px;margin:0 auto;text-align:center;\n  }\n  .quote blockquote{\n    font-family:Georgia,serif;font-size:clamp(22px,3.4vw,34px);line-height:1.5;\n  }\n  .quote blockquote::before{content:\"\u201c\";color:var(--hot);font-size:1.6em}\n  .quote cite{\n    display:inline-block;margin-top:24px;font-style:normal;font-size:14px;\n    letter-spacing:3px;text-transform:uppercase;background:var(--acid);padding:8px 16px;\n    transform:skewX(-8deg);\n  }\n\n  /* cta */\n  .cta-band{\n    background:var(--acid);border-top:3px solid var(--ink);border-bottom:3px solid var(--ink);\n    text-align:center;padding:80px 5%;\n  }\n  .cta-band h2{font-size:clamp(34px,6vw,72px)}\n  .cta-band p{font-family:Georgia,serif;font-size:18px;margin:16px 0 34px}\n\n  footer{\n    background:var(--ink);color:var(--paper);padding:50px 5%;\n    display:flex;justify-content:space-between;flex-wrap:wrap;gap:24px;\n    font-size:13px;letter-spacing:1px;\n  }\n  footer .logo b{background:var(--acid);color:var(--ink)}\n  footer a:hover{color:var(--acid)}\n  footer ul{list-style:none;display:flex;gap:20px;flex-wrap:wrap}\n\n  @media(max-width:700px){nav ul{display:none}}\n</style>\n</head>\n<body>\n\n<div class=\"marquee\"><span>\u2605 FREE GRIP TAPE WITH EVERY DECK \u2605 FIRST LESSON HALF PRICE THIS MONTH \u2605 SKATE. FALL. GET UP. REPEAT. \u2605 FREE GRIP TAPE WITH EVERY DECK \u2605 FIRST LESSON HALF PRICE THIS MONTH \u2605 SKATE. FALL. GET UP. REPEAT. \u2605&nbsp;</span></div>\n\n<nav>\n  <div class=\"logo\">GRIND<b>HAUS</b></div>\n  <ul>\n    <li><a href=\"#shop\">Shop</a></li>\n    <li><a href=\"#lessons\">Lessons</a></li>\n    <li><a href=\"#crew\">Crew</a></li>\n    <li><a href=\"#contact\">Contact</a></li>\n  </ul>\n  <a href=\"#lessons\" class=\"nav-cta\">Book a Lesson</a>\n</nav>\n\n<header>\n  <div class=\"hero-flex\">\n    <div class=\"hero-text\">\n      <h1>Ride<br><span class=\"stroke\">Harder.</span><br><span class=\"acid\">Land It.</span></h1>\n      <p>Independent skate shop and school since 2011. Decks built by skaters, lessons taught by skaters, and a shop floor you're actually allowed to scuff up.</p>\n      <div class=\"btn-row\">\n        <a href=\"#shop\" class=\"btn btn-dark\"><span>Shop Decks</span></a>\n        <a href=\"#lessons\" class=\"btn btn-hot\"><span>Start Skating</span></a>\n      </div>\n    </div>\n    <div class=\"board-wrap\">\n      <div class=\"board\">\n        <div class=\"wheel w1\"></div><div class=\"wheel w2\"></div>\n        <div class=\"wheel w3\"></div><div class=\"wheel w4\"></div>\n        <div class=\"truck t1\"></div><div class=\"truck t2\"></div>\n        <div class=\"deck\"></div>\n      </div>\n    </div>\n  </div>\n</header>\n\n<div class=\"strip\"><span>DECKS \u2605 TRUCKS \u2605 WHEELS \u2605 LESSONS \u2605 CAMPS \u2605 COMPS \u2605 REPAIRS \u2605 DECKS \u2605 TRUCKS \u2605 WHEELS \u2605 LESSONS \u2605 CAMPS \u2605 COMPS \u2605 REPAIRS \u2605&nbsp;</span></div>\n\n<section id=\"shop\">\n  <span class=\"tag\">The Shop</span>\n  <h2>Fresh Decks</h2>\n  <p class=\"sub\">Maple-pressed, locally screened, and tested down the shop stairs before they ever hit the wall.</p>\n  <div class=\"grid\">\n    <div class=\"card\"><span class=\"badge\">NEW</span><div class=\"art a1\">\ud83d\udef9</div><h3>Acid Drop 8.25\"</h3><p>Our house shape. Medium concave, pops forever.</p><div class=\"price\">$64</div></div>\n    <div class=\"card\"><span class=\"badge\">HOT</span><div class=\"art a2\">\ud83d\udd25</div><h3>Baker's Dozen 8.0\"</h3><p>Classic popsicle for street and park laps.</p><div class=\"price\">$58 <s>$70</s></div></div>\n    <div class=\"card\"><div class=\"art a3\">\ud83c\udf0a</div><h3>Night Pool 8.75\"</h3><p>Wide cruiser shape for bowls and ramps.</p><div class=\"price\">$72</div></div>\n    <div class=\"card\"><span class=\"badge\">RESTOCK</span><div class=\"art a4\">\u26a1</div><h3>Static 7.75\"</h3><p>Narrow and snappy \u2014 a kid-favorite starter.</p><div class=\"price\">$54</div></div>\n  </div>\n</section>\n\n<section id=\"lessons\" class=\"lessons\">\n  <span class=\"tag\" style=\"background:var(--acid);color:var(--ink)\">The School</span>\n  <h2>Learn to Skate</h2>\n  <p class=\"sub\" style=\"color:#bbb\">Small groups, real progression. Helmets on, egos off. Every class ends with a mini jam session.</p>\n  <div class=\"lesson-grid\">\n    <div class=\"lesson\">\n      <div class=\"lvl\">Level 1 \u00b7 Ages 5+</div>\n      <h3>First Push</h3>\n      <ul>\n        <li>Stance, pushing & stopping</li>\n        <li>Falling safely (yes, it's a skill)</li>\n        <li>All gear included</li>\n      </ul>\n      <div class=\"cost\">$35 <small>/ session</small></div><br>\n      <a class=\"pick\" href=\"#contact\">Book it</a>\n    </div>\n    <div class=\"lesson\">\n      <div class=\"lvl\">Level 2 \u00b7 All Ages</div>\n      <h3>Ollie School</h3>\n      <ul>\n        <li>Ollies, shuvits & manuals</li>\n        <li>Park etiquette & flow</li>\n        <li>Weekly progress video</li>\n      </ul>\n      <div class=\"cost\">$40 <small>/ session</small></div><br>\n      <a class=\"pick\" href=\"#contact\">Book it</a>\n    </div>\n    <div class=\"lesson\">\n      <div class=\"lvl\">Level 3 \u00b7 By Tryout</div>\n      <h3>Team Prep</h3>\n      <ul>\n        <li>Rails, bowls & ledges</li>\n        <li>Line-building & filming</li>\n        <li>Am contest coaching</li>\n      </ul>\n      <div class=\"cost\">$55 <small>/ session</small></div><br>\n      <a class=\"pick\" href=\"#contact\">Book it</a>\n    </div>\n  </div>\n</section>\n\n<section id=\"crew\">\n  <div class=\"quote\">\n    <blockquote>My daughter showed up terrified of the board. Six weeks later she's dropping in and teaching ME how to fall properly. Best money we've spent, full stop.</blockquote>\n    <cite>\u2014 Dana R., proud skate mom</cite>\n  </div>\n</section>\n\n<section class=\"cta-band\" id=\"contact\">\n  <h2>Your First Lesson Is<br>Half Off. No Excuses.</h2>\n  <p>Saturdays 10am at the shop. Boards, pads, and patience provided.</p>\n  <a href=\"#\" class=\"btn btn-dark\"><span>Claim Your Spot \u2192</span></a>\n</section>\n\n<footer>\n  <div>\n    <div class=\"logo\">GRIND<b>HAUS</b></div><br>\n    141 Culvert Lane \u00b7 Open daily 10\u20138<br>hello@grindhaus.example\n  </div>\n  <ul>\n    <li><a href=\"#shop\">Shop</a></li>\n    <li><a href=\"#lessons\">Lessons</a></li>\n    <li><a href=\"#\">Instagram</a></li>\n    <li><a href=\"#\">Waivers</a></li>\n  </ul>\n  <div>\u00a9 2025 Grindhaus. Skate everything.</div>\n</footer>\n\n</body>\n</html>\n"}