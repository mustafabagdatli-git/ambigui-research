{"brief": "B5", "model": "anthropic/claude-haiku-5.5", "i": 2, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Harbor Sexual Health Clinic | Walk-In Testing & Care</title>\n<meta name=\"description\" content=\"Confidential, judgment-free walk-in sexual health care: STI testing, treatment, contraception, PEP, PrEP, and vaccines. No appointment needed.\">\n<style>\n  :root {\n    --teal-900: #0b3b40;\n    --teal-700: #137a80;\n    --teal-600: #1a8f96;\n    --teal-100: #e0f2f1;\n    --teal-50:  #f2fafa;\n    --coral-600: #c8553d;\n    --ink: #1d2b2e;\n    --ink-soft: #4a5d61;\n    --line: #d7e4e5;\n    --white: #ffffff;\n    --radius: 14px;\n    --shadow: 0 10px 30px rgba(11, 59, 64, 0.10);\n    --max: 1120px;\n  }\n\n  * { box-sizing: border-box; }\n  html { scroll-behavior: smooth; }\n  body {\n    margin: 0;\n    font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n    color: var(--ink);\n    background: var(--white);\n    line-height: 1.6;\n    font-size: 17px;\n  }\n\n  img, svg { display: block; max-width: 100%; }\n  a { color: var(--teal-700); }\n  a:focus-visible, button:focus-visible, summary:focus-visible, input:focus-visible {\n    outline: 3px solid var(--coral-600);\n    outline-offset: 3px;\n    border-radius: 4px;\n  }\n\n  .skip-link {\n    position: absolute; left: -9999px; top: 8px;\n    background: var(--white); padding: 10px 16px; z-index: 100;\n    border-radius: 8px; box-shadow: var(--shadow);\n  }\n  .skip-link:focus { left: 8px; }\n\n  .container { width: min(var(--max), 92%); margin: 0 auto; }\n  section { padding: 84px 0; }\n  h1, h2, h3 { line-height: 1.2; color: var(--teal-900); margin: 0 0 0.5em; }\n  h1 { font-size: clamp(2.2rem, 4.5vw, 3.4rem); letter-spacing: -0.02em; }\n  h2 { font-size: clamp(1.7rem, 3vw, 2.3rem); letter-spacing: -0.01em; }\n  h3 { font-size: 1.15rem; }\n  p { margin: 0 0 1em; }\n  .eyebrow {\n    display: inline-block;\n    font-size: 0.8rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;\n    color: var(--teal-700); background: var(--teal-100);\n    padding: 6px 12px; border-radius: 999px; margin-bottom: 16px;\n  }\n  .lead { font-size: 1.12rem; color: var(--ink-soft); max-width: 62ch; }\n  .section-head { max-width: 680px; margin-bottom: 48px; }\n  .section-head.center { margin-left: auto; margin-right: auto; text-align: center; }\n\n  .btn {\n    display: inline-flex; align-items: center; justify-content: center; gap: 8px;\n    padding: 14px 24px; border-radius: 999px; font-weight: 600; font-size: 1rem;\n    text-decoration: none; border: 2px solid transparent; cursor: pointer;\n    transition: background 0.2s, color 0.2s, transform 0.2s, border-color 0.2s;\n    font-family: inherit;\n  }\n  .btn-primary { background: var(--teal-700); color: var(--white); }\n  .btn-primary:hover { background: var(--teal-900); transform: translateY(-1px); }\n  .btn-outline { background: transparent; color: var(--teal-900); border-color: var(--teal-700); }\n  .btn-outline:hover { background: var(--teal-700); color: var(--white); }\n  .btn-light { background: var(--white); color: var(--teal-900); }\n  .btn-light:hover { background: var(--teal-100); }\n  .btn-quick {\n    background: var(--coral-600); color: var(--white); padding: 10px 16px; font-size: 0.9rem;\n  }\n  .btn-quick:hover { background: #a94330; }\n\n  /* Top utility bar */\n  .utility {\n    background: var(--teal-900); color: #cfe7e8; font-size: 0.9rem;\n  }\n  .utility .container {\n    display: flex; justify-content: space-between; align-items: center; gap: 16px;\n    padding: 8px 0; flex-wrap: wrap;\n  }\n  .utility a { color: var(--white); text-decoration: none; font-weight: 600; }\n  .utility a:hover { text-decoration: underline; }\n  .status { display: inline-flex; align-items: center; gap: 8px; }\n  .dot { width: 9px; height: 9px; border-radius: 50%; background: #4ade80; box-shadow: 0 0 0 3px rgba(74,222,128,0.25); }\n\n  /* Header / nav */\n  header.site {\n    position: sticky; top: 0; z-index: 50;\n    background: rgba(255,255,255,0.96);\n    backdrop-filter: blur(8px);\n    border-bottom: 1px solid var(--line);\n  }\n  header.site .container {\n    display: flex; align-items: center; justify-content: space-between; gap: 20px;\n    padding: 14px 0;\n  }\n  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--teal-900); font-weight: 700; font-size: 1.1rem; }\n  .brand small { display: block; font-weight: 500; font-size: 0.75rem; color: var(--ink-soft); letter-spacing: 0.02em; }\n  nav.primary ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 26px; align-items: center; }\n  nav.primary a { text-decoration: none; color: var(--ink); font-weight: 500; font-size: 0.95rem; }\n  nav.primary a:hover { color: var(--teal-700); }\n  .nav-cta { display: flex; gap: 12px; align-items: center; }\n  .menu-toggle {\n    display: none; background: none; border: 1px solid var(--line); border-radius: 10px;\n    padding: 8px 10px; cursor: pointer; color: var(--teal-900);\n  }\n\n  /* Hero */\n  .hero {\n    background:\n      radial-gradient(900px 400px at 85% -10%, #cdeeed 0%, transparent 60%),\n      linear-gradient(180deg, var(--teal-50), var(--white));\n    padding: 80px 0 90px;\n  }\n  .hero-grid {\n    display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 56px; align-items: center;\n  }\n  .hero .lead { margin-bottom: 28px; }\n  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 28px; }\n  .hero-badges { display: flex; gap: 22px; flex-wrap: wrap; font-size: 0.92rem; color: var(--ink-soft); }\n  .hero-badges span { display: inline-flex; align-items: center; gap: 8px; }\n  .hero-badges svg { color: var(--teal-700); }\n\n  .hero-card {\n    background: var(--white); border: 1px solid var(--line); border-radius: 20px;\n    box-shadow: var(--shadow); padding: 28px;\n  }\n  .hero-card h3 { margin-bottom: 4px; }\n  .hero-card .muted { color: var(--ink-soft); font-size: 0.95rem; margin-bottom: 20px; }\n  .step-list { list-style: none; padding: 0; margin: 0 0 22px; }\n  .step-list li {\n    display: flex; gap: 14px; padding: 12px 0; border-bottom: 1px dashed var(--line);\n  }\n  .step-list li:last-child { border-bottom: none; }\n  .step-num {\n    flex: 0 0 34px; height: 34px; border-radius: 50%;\n    background: var(--teal-100); color: var(--teal-900); font-weight: 700;\n    display: flex; align-items: center; justify-content: center; font-size: 0.95rem;\n  }\n  .step-list strong { display: block; color: var(--teal-900); }\n  .step-list span { font-size: 0.93rem; color: var(--ink-soft); }\n\n  /* Notice strip */\n  .notice {\n    background: #fff6f2; border-left: 4px solid var(--coral-600);\n    padding: 16px 20px; border-radius: 10px; font-size: 0.95rem; color: #5a2a1e;\n    margin: 0;\n  }\n  .notice strong { color: #7a2f1d; }\n\n  /* Services */\n  .services { background: var(--white); }\n  .service-grid {\n    display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;\n  }\n  .service-card {\n    border: 1px solid var(--line); border-radius: var(--radius); padding: 28px;\n    background: var(--white); transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;\n  }\n  .service-card:hover { transform: translateY(-3px); box-shadow: var(--shadow); border-color: #b8d7d9; }\n  .icon {\n    width: 52px; height: 52px; border-radius: 14px; background: var(--teal-100);\n    color: var(--teal-700); display: flex; align-items: center; justify-content: center; margin-bottom: 18px;\n  }\n  .service-card p { color: var(--ink-soft); font-size: 0.97rem; margin: 0; }\n\n  /* Testing panel */\n  .panels { background: var(--teal-50); }\n  .panel-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }\n  .panel {\n    background: var(--white); border-radius: var(--radius); padding: 34px; border: 1px solid var(--line);\n  }\n  .panel ul { padding-left: 20px; margin: 0; }\n  .panel li { margin-bottom: 8px; color: var(--ink-soft); }\n  .panel li strong { color: var(--ink); }\n  .tag {\n    display: inline-block; font-size: 0.78rem; font-weight: 700; padding: 4px 10px;\n    border-radius: 999px; background: var(--teal-100); color: var(--teal-900); margin-bottom: 12px;\n  }\n\n  /* Walk-in info */\n  .walkin { background: var(--teal-900); color: #e6f4f4; }\n  .walkin h2, .walkin h3 { color: var(--white); }\n  .walkin .lead { color: #bfe0e1; }\n  .walkin-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: start; }\n  table.hours {\n    width: 100%; border-collapse: collapse; background: rgba(255,255,255,0.06);\n    border-radius: 12px; overflow: hidden;\n  }\n  table.hours caption { text-align: left; font-weight: 700; color: var(--white); padding-bottom: 12px; font-size: 1.1rem; }\n  table.hours th, table.hours td { padding: 14px 18px; text-align: left; border-bottom: 1px solid rgba(255,255,255,0.12); }\n  table.hours th { font-weight: 600; color: #cfe9ea; }\n  table.hours td { color: var(--white); }\n  table.hours tr:last-child th, table.hours tr:last-child td { border-bottom: none; }\n  table.hours tr.today td, table.hours tr.today th { background: rgba(255,255,255,0.12); }\n  .today-label { font-size: 0.75rem; background: #4ade80; color: #06302e; padding: 2px 8px; border-radius: 999px; margin-left: 8px; font-weight: 700; }\n  .check-list { list-style: none; padding: 0; margin: 0 0 24px; }\n  .check-list li { display: flex; gap: 12px; margin-bottom: 14px; color: #e6f4f4; }\n  .check-list svg { flex: 0 0 22px; color: #6ee7b7; margin-top: 3px; }\n\n  /* Privacy */\n  .privacy-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }\n  .privacy-item {\n    padding: 28px; border-radius: var(--radius); background: var(--teal-50); border: 1px solid #cfe6e7;\n  }\n  .privacy-item p { color: var(--ink-soft); font-size: 0.96rem; margin: 0; }\n\n  /* Pricing */\n  .pricing { background: var(--teal-50); }\n  .price-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }\n  .price-card {\n    background: var(--white); border-radius: var(--radius); padding: 30px; border: 1px solid var(--line);\n    display: flex; flex-direction: column;\n  }\n  .price-card .amount { font-size: 2rem; font-weight: 800; color: var(--teal-900); margin: 6px 0 12px; }\n  .price-card .amount small { font-size: 0.95rem; font-weight: 500; color: var(--ink-soft); }\n  .price-card ul { padding-left: 20px; color: var(--ink-soft); font-size: 0.95rem; margin: 0 0 18px; flex: 1; }\n  .price-card.featured { border: 2px solid var(--teal-700); box-shadow: var(--shadow); }\n  .fine { font-size: 0.88rem; color: var(--ink-soft); margin-top: 24px; }\n\n  /* Team */\n  .team-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }\n  .team-card { padding: 26px; border-radius: var(--radius); border: 1px solid var(--line); text-align: left; }\n  .avatar {\n    width: 64px; height: 64px; border-radius: 50%; background: linear-gradient(135deg, var(--teal-600), var(--teal-900));\n    color: var(--white); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.2rem; margin-bottom: 14px;\n  }\n  .team-card p { font-size: 0.95rem; color: var(--ink-soft); margin: 0; }\n\n  /* FAQ */\n  .faq { background: var(--white); }\n  .faq-wrap { max-width: 820px; margin: 0 auto; }\n  details {\n    border: 1px solid var(--line); border-radius: 12px; padding: 0; margin-bottom: 14px; background: var(--white);\n  }\n  details[open] { box-shadow: var(--shadow); border-color: #b8d7d9; }\n  summary {\n    cursor: pointer; padding: 20px 24px; font-weight: 600; color: var(--teal-900);\n    list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 16px;\n  }\n  summary::-webkit-details-marker { display: none; }\n  summary::after {\n    content: \"+\"; font-size: 1.5rem; line-height: 1; color: var(--teal-700); transition: transform 0.2s;\n  }\n  details[open] summary::after { content: \"\u2212\"; }\n  details > div { padding: 0 24px 22px; color: var(--ink-soft); }\n  details p:last-child { margin-bottom: 0; }\n\n  /* Location */\n  .location { background: var(--teal-50); }\n  .loc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: start; }\n  .info-block { margin-bottom: 26px; }\n  .info-block h3 { margin-bottom: 6px; font-size: 1rem; }\n  .info-block p, .info-block a { color: var(--ink-soft); margin: 0; font-size: 1rem; }\n  .info-block a { text-decoration: none; font-weight: 600; }\n  .info-block a:hover { text-decoration: underline; }\n  .map-placeholder {\n    border-radius: var(--radius); min-height: 320px; background:\n      repeating-linear-gradient(45deg, #e8f3f3 0 14px, #f4fafa 14px 28px);\n    border: 1px solid var(--line); display: flex; align-items: center; justify-content: center;\n    text-align: center; color: var(--teal-900); padding: 24px; box-shadow: var(--shadow);\n  }\n  .map-placeholder div { background: var(--white); padding: 18px 22px; border-radius: 12px; }\n  .map-placeholder strong { display: block; margin-bottom: 4px; }\n\n  /* CTA band */\n  .cta-band {\n    background: linear-gradient(120deg, var(--teal-700), var(--teal-900)); color: var(--white); text-align: center; padding: 72px 0;\n  }\n  .cta-band h2 { color: var(--white); }\n  .cta-band p { color: #d6eeef; max-width: 56ch; margin: 0 auto 28px; font-size: 1.08rem; }\n  .cta-band .hero-actions { justify-content: center; margin-bottom: 0; }\n\n  /* Footer */\n  footer.site-footer { background: #082c30; color: #b9d6d8; padding: 56px 0 28px; font-size: 0.93rem; }\n  .foot-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 36px; }\n  footer h4 { color: var(--white); margin: 0 0 14px; font-size: 0.98rem; }\n  footer ul { list-style: none; padding: 0; margin: 0; }\n  footer li { margin-bottom: 9px; }\n  footer a { color: #b9d6d8; text-decoration: none; }\n  footer a:hover { color: var(--white); text-decoration: underline; }\n  .disclaimer { margin-top: 40px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,0.12); font-size: 0.85rem; color: #8fb3b6; }\n  .emergency { color: #fca5a5; font-weight: 600; }\n\n  /* Responsive */\n  @media (max-width: 960px) {\n    .hero-grid, .walkin-grid, .loc-grid, .panel-grid { grid-template-columns: 1fr; gap: 40px; }\n    .privacy-grid, .price-grid, .team-grid { grid-template-columns: 1fr 1fr; }\n    .foot-grid { grid-template-columns: 1fr 1fr; }\n    nav.primary { display: none; }\n    nav.primary.open {\n      display: block; position: absolute; top: 100%; left: 0; right: 0;\n      background: var(--white); border-bottom: 1px solid var(--line); padding: 16px 0; box-shadow: var(--shadow);\n    }\n    nav.primary.open ul { flex-direction: column; align-items: flex-start; gap: 14px; padding: 0 4%; }\n    .menu-toggle { display: inline-flex; }\n  }\n  @media (max-width: 640px) {\n    section { padding: 60px 0; }\n    .privacy-grid, .price-grid, .team-grid, .foot-grid { grid-template-columns: 1fr; }\n    .nav-cta .btn-primary { display: none; }\n    .utility .container { justify-content: center; text-align: center; }\n    .hero { padding: 56px 0 64px; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    * { transition: none !important; scroll-behavior: auto !important; }\n  }\n</style>\n</head>\n<body>\n\n<a class=\"skip-link\" href=\"#main\">Skip to content</a>\n\n<!-- Utility bar -->\n<div class=\"utility\" role=\"region\" aria-label=\"Clinic status and contact\">\n  <div class=\"container\">\n    <span class=\"status\"><span class=\"dot\" aria-hidden=\"true\"></span> <span id=\"status-text\">Walk-ins welcome today</span></span>\n    <span>No appointment needed &middot; Confidential &middot; Free and low-cost options</span>\n    <a href=\"tel:+15550102345\">Call (555) 010-2345</a>\n  </div>\n</div>\n\n<!-- Header -->\n<header class=\"site\">\n  <div class=\"container\">\n    <a class=\"brand\" href=\"#top\" aria-label=\"Harbor Sexual Health Clinic home\">\n      <svg width=\"36\" height=\"36\" viewBox=\"0 0 40 40\" aria-hidden=\"true\">\n        <circle cx=\"20\" cy=\"20\" r=\"19\" fill=\"#137a80\"/>\n        <path d=\"M12 22c3 0 4-4 8-4s5 4 8 4\" stroke=\"#fff\" stroke-width=\"2.5\" fill=\"none\" stroke-linecap=\"round\"/>\n        <path d=\"M12 28c3 0 4-4 8-4s5 4 8 4\" stroke=\"#bfe6e7\" stroke-width=\"2.5\" fill=\"none\" stroke-linecap=\"round\"/>\n        <path d=\"M20 9v6\" stroke=\"#fff\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n      </svg>\n      <span>Harbor Sexual Health<small>Walk-in clinic &middot; Est. 2014</small></span>\n    </a>\n\n    <nav class=\"primary\" id=\"primary-nav\" aria-label=\"Main\">\n      <ul>\n        <li><a href=\"#services\">Services</a></li>\n        <li><a href=\"#testing\">Testing</a></li>\n        <li><a href=\"#walk-in\">Walk-in hours</a></li>\n        <li><a href=\"#pricing\">Pricing</a></li>\n        <li><a href=\"#faq\">FAQ</a></li>\n        <li><a href=\"#visit\">Visit us</a></li>\n      </ul>\n    </nav>\n\n    <div class=\"nav-cta\">\n      <a class=\"btn btn-primary\" href=\"#walk-in\">Find walk-in hours</a>\n      <button class=\"menu-toggle\" id=\"menu-toggle\" aria-expanded=\"false\" aria-controls=\"primary-nav\" aria-label=\"Open menu\">\n        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M4 7h16M4 12h16M4 17h16\"/></svg>\n      </button>\n    </div>\n  </div>\n</header>\n\n<main id=\"main\">\n\n<!-- Hero -->\n<section class=\"hero\" id=\"top\">\n  <div class=\"container hero-grid\">\n    <div>\n      <span class=\"eyebrow\">Confidential care, no judgment</span>\n      <h1>Sexual health care, on your schedule.</h1>\n      <p class=\"lead\">Walk in for STI testing, treatment, contraception, and preventive care. Our clinicians are trained to talk about bodies, relationships, and sex without awkwardness, and every visit is private.</p>\n      <div class=\"hero-actions\">\n        <a class=\"btn btn-primary\" href=\"#walk-in\">See today's walk-in hours</a>\n        <a class=\"btn btn-outline\" href=\"#services\">Explore services</a>\n      </div>\n      <div class=\"hero-badges\">\n        <span>\n          <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><rect x=\"5\" y=\"11\" width=\"14\" height=\"10\" rx=\"2\"/><path d=\"M8 11V7a4 4 0 0 1 8 0v4\"/></svg>\n          Private, confidential visits\n        </span>\n        <span>\n          <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/></svg>\n          Usually seen within 30 minutes\n        </span>\n        <span>\n          <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z\"/><path d=\"M9 12l2 2 4-4\"/></svg>\n          Sliding-scale fees available\n        </span>\n      </div>\n    </div>\n\n    <aside class=\"hero-card\" aria-label=\"What to expect\">\n      <h3>What to expect when you walk in</h3>\n      <p class=\"muted\">Most visits take 30 to 60 minutes.</p>\n      <ol class=\"step-list\">\n        <li>\n          <span class=\"step-num\">1</span>\n          <div><strong>Check in at the front desk</strong><span>Give your first name or a nickname. No insurance card is needed to be seen.</span></div>\n        </li>\n        <li>\n          <span class=\"step-num\">2</span>\n          <div><strong>Private consultation</strong><span>A clinician asks about your health and what brought you in, then recommends tests.</span></div>\n        </li>\n        <li>\n          <span class=\"step-num\">3</span>\n          <div><strong>Testing and treatment</strong><span>Swabs, urine samples, or blood tests, with treatment offered on the same visit when it's appropriate.</span></div>\n        </li>\n        <li>\n          <span class=\"step-num\">4</span>\n          <div><strong>Results and next steps</strong><span>We explain your results, how to notify partners, and how to get results securely.</span></div>\n        </li>\n      </ol>\n      <p class=\"notice\"><strong>Have symptoms that feel urgent?</strong> Severe pain, heavy bleeding, or trouble breathing needs emergency care. Call 911 or go to the nearest emergency department.</p>\n    </aside>\n  </div>\n</section>\n\n<!-- Services -->\n<section class=\"services\" id=\"services\" aria-labelledby=\"services-title\">\n  <div class=\"container\">\n    <div class=\"section-head center\">\n      <span class=\"eyebrow\">Our services</span>\n      <h2 id=\"services-title\">Everything under one roof</h2>\n      <p class=\"lead\">Whether you need a routine check, a quick answer, or ongoing support, we can help. Ask about anything. There's no question too small or too personal.</p>\n    </div>\n\n    <div class=\"service-grid\">\n      <article class=\"service-card\">\n        <div class=\"icon\" aria-hidden=\"true\">\n          <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M9 3h6M10 3v6l-5 9a3 3 0 0 0 2.6 4.5h8.8A3 3 0 0 0 19 18l-5-9V3\"/><path d=\"M8 15h8\"/></svg>\n        </div>\n        <h3>STI testing</h3>\n        <p>Tests for chlamydia, gonorrhea, syphilis, HIV, hepatitis B and C, and trichomoniasis. Testing is available for every body type, including sites beyond the genitals when relevant.</p>\n      </article>\n\n      <article class=\"service-card\">\n        <div class=\"icon\" aria-hidden=\"true\">\n          <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M12 21s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.6-7 10-7 10z\"/></svg>\n        </div>\n        <h3>Treatment</h3>\n        <p>Same-visit treatment for many common infections, including antibiotics for chlamydia and gonorrhea, plus treatment for yeast infections, BV, and genital warts.</p>\n      </article>\n\n      <article class=\"service-card\">\n        <div class=\"icon\" aria-hidden=\"true\">\n          <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"3\"/><path d=\"M9 9h6M9 13h6M9 17h3\"/></svg>\n        </div>\n        <h3>Contraception</h3>\n        <p>Pills, patches, rings, injections, IUDs, implants, and condoms. We help you choose what fits your health history and lifestyle, and can often start a method the same day.</p>\n      </article>\n\n      <article class=\"service-card\">\n        <div class=\"icon\" aria-hidden=\"true\">\n          <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M12 3v4M12 17v4M3 12h4M17 12h4\"/><circle cx=\"12\" cy=\"12\" r=\"4\"/></svg>\n        </div>\n        <h3>PEP and PrEP</h3>\n        <p>Post-exposure prophylaxis (PEP) can reduce the risk of HIV after a possible exposure and must be started within 72 hours. PrEP is a daily or long-acting option to help prevent HIV ahead of time.</p>\n      </article>\n\n      <article class=\"service-card\">\n        <div class=\"icon\" aria-hidden=\"true\">\n          <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M18 8l-8 8M10 8l8 8\"/><path d=\"M4 12a8 8 0 0 0 16 0\"/></svg>\n        </div>\n        <h3>Vaccines</h3>\n        <p>HPV, hepatitis A and B, and mpox vaccines are available for eligible patients. We'll check your records and tell you what you still need.</p>\n      </article>\n\n      <article class=\"service-card\">\n        <div class=\"icon\" aria-hidden=\"true\">\n          <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M4 5h16v11H8l-4 4z\"/></svg>\n        </div>\n        <h3>Questions and support</h3>\n        <p>Concerns about sexual function, pain during sex, changes in libido, or a recent partner's test result? Book a private conversation with a clinician, with no test required.</p>\n      </article>\n    </div>\n  </div>\n</section>\n\n<!-- Testing panels -->\n<section class=\"panels\" id=\"testing\" aria-labelledby=\"testing-title\">\n  <div class=\"container\">\n    <div class=\"section-head\">\n      <span class=\"eyebrow\">Testing guidance</span>\n      <h2 id=\"testing-title\">Not sure what to get tested for?</h2>\n      <p class=\"lead\">Your ideal testing panel depends on your body, your sexual activity, and your risk factors. These are common starting points. Your clinician will tailor them with you.</p>\n    </div>\n\n    <div class=\"panel-grid\">\n      <div class=\"panel\">\n        <span class=\"tag\">Common panel</span>\n        <h3>Routine screen</h3>\n        <ul>\n          <li><strong>Chlamydia and gonorrhea</strong> via urine or swab, depending on the site(s) of exposure</li>\n          <li><strong>HIV</strong> via rapid test or blood test</li>\n          <li><strong>Syphilis</strong> via blood test</li>\n          <li><strong>Hepatitis B and C</strong> via blood test, if recommended</li>\n        </ul>\n      </div>\n      <div class=\"panel\">\n        <span class=\"tag\">When to come in</span>\n        <h3>Consider testing if you:</h3>\n        <ul>\n          <li>Have a new or multiple sexual partners</li>\n          <li>Notice discharge, sores, itching, pain when urinating, or unusual bleeding</li>\n          <li>Had sex without a condom or with a condom that broke or slipped</li>\n          <li>Were told a partner has an infection</li>\n          <li>Have had sex under the influence or while someone else's consent was unclear and want support</li>\n        </ul>\n      </div>\n    </div>\n\n    <p class=\"fine\">Testing timelines vary. Some results are available the same day, and others take several days. Your clinician will explain what to expect for each test.</p>\n  </div>\n</section>\n\n<!-- Walk-in hours -->\n<section class=\"walkin\" id=\"walk-in\" aria-labelledby=\"walkin-title\">\n  <div class=\"container walkin-grid\">\n    <div>\n      <span class=\"eyebrow\" style=\"background:rgba(255,255,255,0.12);color:#e6f4f4\">Walk-in hours</span>\n      <h2 id=\"walkin-title\">Come in when it works for you</h2>\n      <p class=\"lead\">No appointment is needed during walk-in hours. Arrive early in the day for the shortest wait. Evening and Saturday hours fill up quickly on weekdays.</p>\n\n      <ul class=\"check-list\">\n        <li>\n          <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" aria-hidden=\"true\"><path d=\"M5 12l5 5 9-10\"/></svg>\n          <span>Walk-in visits are seen in order of arrival, with the most urgent cases prioritized.</span>\n        </li>\n        <li>\n          <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" aria-hidden=\"true\"><path d=\"M5 12l5 5 9-10\"/></svg>\n          <span>Bring a photo ID if you have one, but you don't need one to be seen.</span>\n        </li>\n        <li>\n          <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" aria-hidden=\"true\"><path d=\"M5 12l5 5 9-10\"/></svg>\n          <span>Bring your medication list and any previous test results if you have them.</span>\n        </li>\n      </ul>\n    </div>\n\n    <div>\n      <table class=\"hours\" id=\"hours-table\">\n        <caption>Clinic hours</caption>\n        <tbody>\n          <tr data-day=\"1\"><th scope=\"row\">Monday</th><td>8:00 am \u2013 6:00 pm</td></tr>\n          <tr data-day=\"2\"><th scope=\"row\">Tuesday</th><td>8:00 am \u2013 6:00 pm</td></tr>\n          <tr data-day=\"3\"><th scope=\"row\">Wednesday</th><td>10:00 am \u2013 8:00 pm</td></tr>\n          <tr data-day=\"4\"><th scope=\"row\">Thursday</th><td>8:00 am \u2013 6:00 pm</td></tr>\n          <tr data-day=\"5\"><th scope=\"row\">Friday</th><td>8:00 am \u2013 4:00 pm</td></tr>\n          <tr data-day=\"6\"><th scope=\"row\">Saturday</th><td>9:00 am \u2013 1:00 pm</td></tr>\n          <tr data-day=\"0\"><th scope=\"row\">Sunday</th><td>Closed</td></tr>\n        </tbody>\n      </table>\n      <p class=\"fine\" style=\"color:#bfe0e1\">Holiday hours may vary. Check the phone line or our website before you visit.</p>\n    </div>\n  </div>\n</section>\n\n<!-- Privacy -->\n<section aria-labelledby=\"privacy-title\">\n  <div class=\"container\">\n    <div class=\"section-head center\">\n      <span class=\"eyebrow\">Your privacy</span>\n      <h2 id=\"privacy-title\">Confidential by design</h2>\n      <p class=\"lead\">We know that privacy matters as much as care. Here's how we protect it.</p>\n    </div>\n\n    <div class=\"privacy-grid\">\n      <div class=\"privacy-item\">\n        <h3>Discreet visits</h3>\n        <p>Our waiting room is private, and we never announce patients by their full name or what they're there for. Text and voicemail reminders are sent only if you opt in, and only with a neutral message.</p>\n      </div>\n      <div class=\"privacy-item\">\n        <h3>Secure results</h3>\n        <p>Choose how you receive results: a secure patient portal, a phone call to a number you choose, or in person. We never leave results on an unprotected voicemail.</p>\n      </div>\n      <div class=\"privacy-item\">\n        <h3>Your records, your rules</h3>\n        <p>Your health information is protected under applicable privacy law and is never shared with employers or schools. We will only share it with others when you ask us to or when the law requires it.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- Pricing -->\n<section class=\"pricing\" id=\"pricing\" aria-labelledby=\"pricing-title\">\n  <div class=\"container\">\n    <div class=\"section-head center\">\n      <span class=\"eyebrow\">Transparent pricing</span>\n      <h2 id=\"pricing-title\">Know what you'll pay before you arrive</h2>\n      <p class=\"lead\">We accept most major insurance plans. If you're uninsured or underinsured, our sliding-scale fees are based on household income. Ask at the front desk. Cost should never stop you from getting care.</p>\n    </div>\n\n    <div class=\"price-grid\">\n      <div class=\"price-card\">\n        <h3>Basic STI screen</h3>\n        <div class=\"amount\">$49 <small>self-pay</small></div>\n        <ul>\n          <li>Chlamydia and gonorrhea</li>\n          <li>HIV rapid test</li>\n          <li>Syphilis blood test</li>\n          <li>Results within 2 to 5 days</li>\n        </ul>\n        <a class=\"btn btn-outline\" href=\"#visit\">Ask about this panel</a>\n      </div>\n\n      <div class=\"price-card featured\">\n        <h3>Full sexual health panel</h3>\n        <div class=\"amount\">$89 <small>self-pay</small></div>\n        <ul>\n          <li>Everything in the basic screen</li>\n          <li>Hepatitis B and C</li>\n          <li>Trichomoniasis</li>\n          <li>Clinician consultation included</li>\n        </ul>\n        <a class=\"btn btn-primary\" href=\"#visit\">Book your visit</a>\n      </div>\n\n      <div class=\"price-card\">\n        <h3>Sliding scale</h3>\n        <div class=\"amount\">From $0 <small>income-based</small></div>\n        <ul>\n          <li>Available for uninsured and low-income patients</li>\n          <li>Apply at the front desk</li>\n          <li>No documentation hassle for most applicants</li>\n          <li>Medication assistance when eligible</li>\n        </ul>\n        <a class=\"btn btn-outline\" href=\"#faq\">How sliding scale works</a>\n      </div>\n    </div>\n\n    <p class=\"fine\">Prices are estimates for 2025 and do not include lab send-out fees or prescription medication costs. Insurance coverage varies by plan. We will verify your coverage and explain any out-of-pocket costs before testing.</p>\n  </div>\n</section>\n\n<!-- Team -->\n<section aria-labelledby=\"team-title\">\n  <div class=\"container\">\n    <div class=\"section-head center\">\n      <span class=\"eyebrow\">Our clinicians</span>\n      <h2 id=\"team-title\">Care from people who listen</h2>\n      <p class=\"lead\">Our team is trained in trauma-informed, inclusive care for patients of every gender, sexual orientation, age, and background.</p>\n    </div>\n\n    <div class=\"team-grid\">\n      <article class=\"team-card\">\n        <div class=\"avatar\" aria-hidden=\"true\">AR</div>\n        <h3>Dr. Amara Reyes</h3>\n        <p>Medical director. Board-certified family physician with 15 years in sexual and reproductive health.</p>\n      </article>\n      <article class=\"team-card\">\n        <div class=\"avatar\" aria-hidden=\"true\">JK</div>\n        <h3>Jordan Kim, NP</h3>\n        <p>Nurse practitioner focused on contraception, PrEP, and gender-affirming sexual health care.</p>\n      </article>\n      <article class=\"team-card\">\n        <div class=\"avatar\" aria-hidden=\"true\">SO</div>\n        <h3>Sam Okafor, RN</h3>\n        <p>Registered nurse and certified sexual health educator who leads our testing and results team.</p>\n      </article>\n    </div>\n  </div>\n</section>\n\n<!-- FAQ -->\n<section class=\"faq\" id=\"faq\" aria-labelledby=\"faq-title\">\n  <div class=\"container\">\n    <div class=\"section-head center\">\n      <span class=\"eyebrow\">Common questions</span>\n      <h2 id=\"faq-title\">Frequently asked questions</h2>\n    </div>\n\n    <div class=\"faq-wrap\">\n      <details>\n        <summary>Do I need an appointment?</summary>\n        <div><p>No. You can walk in during any open hour. If you'd rather have a set time, you can book online or by phone. Booked patients are seen first.</p></div>\n      </details>\n\n      <details>\n        <summary>Will my parents or insurance company find out I was tested?</summary>\n        <div><p>Patients 13 and older can usually consent to STI and contraception care on their own, depending on local law. If you're on a parent's insurance, the explanation of benefits may list services, so ask us about self-pay or confidential billing options. We'll never share information without your consent unless the law requires it.</p></div>\n      </details>\n\n      <details>\n        <summary>How long do I need to wait for results?</summary>\n        <div><p>It depends on the test. Rapid HIV tests give results during your visit. Chlamydia and gonorrhea results usually take 2 to 5 days. Syphilis and hepatitis results may take longer. Your clinician will tell you when and how you'll be notified.</p></div>\n      </details>\n\n      <details>\n        <summary>What should I do if I think I was exposed to HIV?</summary>\n        <div><p>Come in as soon as possible. PEP must be started within 72 hours of exposure to be effective. Don't wait for symptoms, and don't wait for a test result to start seeking care. If it's after hours, go to the nearest emergency department or call our line for guidance.</p></div>\n      </details>\n\n      <details>\n        <summary>Do you test people who have no symptoms?</summary>\n        <div><p>Yes. Many STIs cause no symptoms, which is why routine testing is recommended for anyone who is sexually active. Regular testing is one of the best ways to protect your health and your partners'.</p></div>\n      </details>\n\n      <details>\n        <summary>Can I get emergency contraception here?</summary>\n        <div><p>Yes. Emergency contraception is available on a walk-in basis, and the sooner you take it, the more effective it is. Some forms are available over the counter, and we can help you choose the right one.</p></div>\n      </details>\n\n      <details>\n        <summary>Is the clinic accessible?</summary>\n        <div><p>Yes. Our clinic is wheelchair accessible, has gender-neutral restrooms, and offers interpretation services in more than 20 languages. Let the front desk know if you need an accommodation.</p></div>\n      </details>\n    </div>\n  </div>\n</section>\n\n<!-- Location -->\n<section class=\"location\" id=\"visit\" aria-labelledby=\"visit-title\">\n  <div class=\"container loc-grid\">\n    <div>\n      <span class=\"eyebrow\">Visit us</span>\n      <h2 id=\"visit-title\">Find the clinic</h2>\n      <p class=\"lead\" style=\"margin-bottom:32px\">We're on the ground floor of the Eastbrook Medical Plaza, with parking at the rear and a discreet side entrance on Mercer Street.</p>\n\n      <div class=\"info-block\">\n        <h3>Address</h3>\n        <p>1420 Mercer Street, Suite 101<br>Harborview, ST 00000</p>\n      </div>\n      <div class=\"info-block\">\n        <h3>Phone</h3>\n        <p><a href=\"tel:+15550102345\">(555) 010-2345</a></p>\n      </div>\n      <div class=\"info-block\">\n        <h3>Secure messaging</h3>\n        <p><a href=\"#visit\">Message us through the patient portal</a></p>\n      </div>\n      <div class=\"info-block\">\n        <h3>Public transit</h3>\n        <p>Bus routes 4, 9, and 22 stop directly outside. The Mercer Street station is a 5-minute walk.</p>\n      </div>\n    </div>\n\n    <div class=\"map-placeholder\" role=\"img\" aria-label=\"Map placeholder showing the clinic location\">\n      <div>\n        <strong>Interactive map</strong>\n        <span>Embed your mapping service here.</span>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- CTA band -->\n<section class=\"cta-band\" aria-labelledby=\"cta-title\">\n  <div class=\"container\">\n    <h2 id=\"cta-title\">Your health is worth a visit</h2>\n    <p>Whether it's been a year or a week, you can walk in today. We'll meet you where you are.</p>\n    <div class=\"hero-actions\">\n      <a class=\"btn btn-light\" href=\"tel:+15550102345\">Call (555) 010-2345</a>\n      <a class=\"btn btn-outline\" href=\"#walk-in\" style=\"color:#fff;border-color:#fff\">View walk-in hours</a>\n    </div>\n  </div>\n</section>\n\n</main>\n\n<!-- Footer -->\n<footer class=\"site-footer\">\n  <div class=\"container\">\n    <div class=\"foot-grid\">\n      <div>\n        <h4>Harbor Sexual Health</h4>\n        <p>A nonprofit, walk-in sexual health clinic providing confidential, inclusive care since 2014.</p>\n        <p>1420 Mercer Street, Suite 101<br>Harborview, ST 00000</p>\n      </div>\n      <div>\n        <h4>Services</h4>\n        <ul>\n          <li><a href=\"#services\">STI testing</a></li>\n          <li><a href=\"#services\">Contraception</a></li>\n          <li><a href=\"#services\">PEP and PrEP</a></li>\n          <li><a href=\"#services\">Vaccines</a></li>\n        </ul>\n      </div>\n      <div>\n        <h4>Patients</h4>\n        <ul>\n          <li><a href=\"#walk-in\">Walk-in hours</a></li>\n          <li><a href=\"#pricing\">Pricing and sliding scale</a></li>\n          <li><a href=\"#faq\">FAQ</a></li>\n          <li><a href=\"#visit\">Patient portal</a></li>\n        </ul>\n      </div>\n      <div>\n        <h4>About</h4>\n        <ul>\n          <li><a href=\"#top\">Our team</a></li>\n          <li><a href=\"#top\">Privacy policy</a></li>\n          <li><a href=\"#top\">Accessibility</a></li>\n          <li><a href=\"#top\">Careers</a></li>\n        </ul>\n      </div>\n    </div>\n\n    <div class=\"disclaimer\">\n      <p><span class=\"emergency\">Medical emergency?</span> Call 911 or go to the nearest emergency department. This website is for general information and does not replace advice from a qualified clinician.</p>\n      <p>&copy; <span id=\"year\"></span> Harbor Sexual Health Clinic. All rights reserved.</p>\n    </div>\n  </div>\n</footer>\n\n<script>\n  // Mobile menu toggle\n  (function () {\n    var toggle = document.getElementById('menu-toggle');\n    var nav = document.getElementById('primary-nav');\n    toggle.addEventListener('click', function () {\n      var open = nav.classList.toggle('open');\n      toggle.setAttribute('aria-expanded', String(open));\n      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');\n    });\n    nav.querySelectorAll('a').forEach(function (link) {\n      link.addEventListener('click', function () {\n        nav.classList.remove('open');\n        toggle.setAttribute('aria-expanded', 'false');\n      });\n    });\n  })();\n\n  // Highlight today's hours and update open/closed status\n  (function () {\n    var now = new Date();\n    var day = now.getDay();\n    var hour = now.getHours() + now.getMinutes() / 60;\n\n    var hours = {\n      1: [8, 18], 2: [8, 18], 3: [10, 20], 4: [8, 18],\n      5: [8, 16], 6: [9, 13], 0: null\n    };\n\n    var row = document.querySelector('#hours-table tr[data-day=\"' + day + '\"]');\n    if (row) {\n      row.classList.add('today');\n      var label = document.createElement('span');\n      label.className = 'today-label';\n      label.textContent = 'Today';\n      row.querySelector('th').appendChild(label);\n    }\n\n    var status = document.getElementById('status-text');\n    var h = hours[day];\n    if (!h) {\n      status.textContent = 'Closed today \u00b7 Call for after-hours guidance';\n    } else if (hour >= h[0] && hour < h[1] - 0.5) {\n      status.textContent = 'Walk-ins welcome now \u00b7 Open until ' + formatTime(h[1]);\n    } else if (hour >= h[0] && hour < h[1]) {\n      status.textContent = 'Open now \u00b7 Last walk-in check-in at ' + formatTime(h[1] - 0.5);\n    } else {\n      status.textContent = 'Currently closed \u00b7 Walk-ins resume ' + (hour < h[0] ? 'today at ' + formatTime(h[0]) : 'tomorrow');\n    }\n\n    function formatTime(decimal) {\n      var hr = Math.floor(decimal);\n      var suffix = hr >= 12 ? 'pm' : 'am';\n      var display = hr % 12 === 0 ? 12 : hr % 12;\n      return display + ':00 ' + suffix;\n    }\n  })();\n\n  document.getElementById('year').textContent = new Date().getFullYear();\n</script>\n\n</body>\n</html>\n"}