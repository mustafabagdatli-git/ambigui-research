{"brief": "B5", "model": "openai/gpt-6-luna", "i": 4, "finish": "stop", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#f7f5ef\">\n  <meta name=\"description\" content=\"Welcoming walk-in sexual-health care, without judgment.\">\n  <title>Open Door \u2014 Sexual Health, on Your Terms</title>\n  <style>\n    :root {\n      --ink: #203832;\n      --muted: #62726b;\n      --paper: #f7f5ef;\n      --white: #fffefa;\n      --green: #315d4e;\n      --green-dark: #24483c;\n      --lime: #dcefaa;\n      --coral: #f3a48b;\n      --line: #e6e4da;\n      --serif: Georgia, \"Times New Roman\", serif;\n      --sans: \"Avenir Next\", Avenir, \"Segoe UI\", sans-serif;\n      --shadow: 0 18px 50px rgba(32, 56, 50, .08);\n    }\n\n    * { box-sizing: border-box; }\n    html { scroll-behavior: smooth; }\n    body {\n      margin: 0;\n      background: var(--paper);\n      color: var(--ink);\n      font-family: var(--sans);\n      line-height: 1.6;\n      -webkit-font-smoothing: antialiased;\n    }\n    a { color: inherit; }\n    a:focus-visible, summary:focus-visible {\n      outline: 3px solid #b85f44;\n      outline-offset: 4px;\n      border-radius: 4px;\n    }\n    .skip-link {\n      position: absolute;\n      top: -100px;\n      left: 1rem;\n      z-index: 10;\n      padding: .7rem 1rem;\n      background: var(--white);\n      border-radius: 8px;\n    }\n    .skip-link:focus { top: 1rem; }\n\n    .wrap { width: min(1160px, calc(100% - 48px)); margin: 0 auto; }\n    .topline {\n      border-bottom: 1px solid var(--line);\n      color: var(--muted);\n      font-size: .82rem;\n    }\n    .topline-inner {\n      min-height: 40px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 1rem;\n    }\n    .topline p { margin: 0; }\n    .topline a { text-decoration-thickness: 1px; text-underline-offset: 3px; }\n\n    header { background: var(--paper); }\n    .nav {\n      min-height: 84px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 2rem;\n    }\n    .brand {\n      display: inline-flex;\n      align-items: center;\n      gap: .7rem;\n      font-weight: 750;\n      letter-spacing: -.04em;\n      text-decoration: none;\n      font-size: 1.2rem;\n    }\n    .brand-mark {\n      display: grid;\n      place-items: center;\n      width: 34px;\n      height: 34px;\n      color: var(--green-dark);\n      background: var(--lime);\n      border-radius: 50% 50% 50% 12px;\n      font-family: var(--serif);\n      font-size: 1.2rem;\n    }\n    .nav-links { display: flex; align-items: center; gap: 2rem; }\n    .nav-links a {\n      color: var(--muted);\n      font-size: .92rem;\n      font-weight: 600;\n      text-decoration: none;\n    }\n    .nav-links a:hover { color: var(--green-dark); }\n    .button {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: .5rem;\n      min-height: 48px;\n      padding: .75rem 1.2rem;\n      border: 1px solid transparent;\n      border-radius: 999px;\n      background: var(--green);\n      color: white;\n      font-weight: 700;\n      font-size: .92rem;\n      text-decoration: none;\n      transition: background .2s ease, transform .2s ease;\n    }\n    .button:hover { background: var(--green-dark); transform: translateY(-1px); }\n    .button-light {\n      background: transparent;\n      color: var(--green-dark);\n      border-color: #c8d0c3;\n    }\n    .button-light:hover { background: #edf0e7; color: var(--green-dark); }\n\n    .hero { padding: 58px 0 84px; }\n    .hero-grid {\n      display: grid;\n      grid-template-columns: 1.08fr .92fr;\n      align-items: center;\n      gap: clamp(2rem, 6vw, 5.5rem);\n    }\n    .eyebrow {\n      display: inline-flex;\n      align-items: center;\n      gap: .55rem;\n      margin: 0 0 1.2rem;\n      color: var(--green);\n      font-size: .76rem;\n      font-weight: 800;\n      letter-spacing: .12em;\n      text-transform: uppercase;\n    }\n    .eyebrow::before {\n      content: \"\";\n      width: 22px;\n      height: 2px;\n      background: var(--coral);\n    }\n    h1, h2, h3, p { margin-top: 0; }\n    h1 {\n      max-width: 650px;\n      margin-bottom: 1.25rem;\n      font-family: var(--serif);\n      font-size: clamp(3.2rem, 6.5vw, 5.8rem);\n      font-weight: 400;\n      letter-spacing: -.065em;\n      line-height: .99;\n    }\n    h1 em { color: var(--green); font-weight: 400; }\n    .hero-copy {\n      max-width: 510px;\n      margin-bottom: 1.8rem;\n      color: var(--muted);\n      font-size: 1.08rem;\n    }\n    .hero-actions { display: flex; flex-wrap: wrap; gap: .75rem; }\n    .reassurance {\n      display: flex;\n      align-items: center;\n      gap: .65rem;\n      margin: 1.4rem 0 0;\n      color: var(--muted);\n      font-size: .87rem;\n    }\n    .reassurance svg { flex: 0 0 auto; color: var(--green); }\n\n    .hero-art {\n      position: relative;\n      min-height: 440px;\n      display: grid;\n      place-items: center;\n      overflow: hidden;\n      border-radius: 48% 48% 24px 24px;\n      background: #e7ecdc;\n    }\n    .sun {\n      position: absolute;\n      width: 255px;\n      height: 255px;\n      top: 40px;\n      right: 40px;\n      border-radius: 50%;\n      background: var(--lime);\n    }\n    .orbit {\n      position: absolute;\n      width: 350px;\n      height: 350px;\n      top: 17px;\n      right: -7px;\n      border: 1px solid rgba(49, 93, 78, .25);\n      border-radius: 50%;\n    }\n    .orbit::after {\n      content: \"\";\n      position: absolute;\n      width: 12px;\n      height: 12px;\n      top: 50px;\n      left: 45px;\n      border-radius: 50%;\n      background: var(--coral);\n    }\n    .plant {\n      position: absolute;\n      bottom: -14px;\n      left: 13%;\n      width: 150px;\n      height: 205px;\n      color: #789179;\n    }\n    .visit-card {\n      position: relative;\n      z-index: 1;\n      width: min(310px, 72%);\n      padding: 1.65rem;\n      margin-top: 65px;\n      background: var(--white);\n      border-radius: 22px;\n      box-shadow: var(--shadow);\n      transform: rotate(-3deg);\n    }\n    .card-icon {\n      display: grid;\n      place-items: center;\n      width: 42px;\n      height: 42px;\n      margin-bottom: 1rem;\n      border-radius: 14px;\n      background: #fce5d9;\n      color: #8b4f3d;\n    }\n    .visit-card h2 {\n      margin-bottom: .4rem;\n      font-family: var(--serif);\n      font-size: 1.8rem;\n      font-weight: 400;\n      letter-spacing: -.04em;\n      line-height: 1.1;\n    }\n    .visit-card p { margin-bottom: 1.15rem; color: var(--muted); font-size: .91rem; }\n    .card-link {\n      color: var(--green);\n      font-size: .9rem;\n      font-weight: 750;\n      text-decoration: none;\n    }\n    .card-link span { margin-left: .25rem; }\n\n    .trust-strip {\n      border-top: 1px solid var(--line);\n      border-bottom: 1px solid var(--line);\n      background: rgba(255, 254, 250, .55);\n    }\n    .trust-inner {\n      min-height: 90px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 1.5rem;\n    }\n    .trust-inner p { margin: 0; color: var(--muted); font-size: .9rem; }\n    .trust-points { display: flex; flex-wrap: wrap; gap: 1.5rem; }\n    .trust-point {\n      display: flex;\n      align-items: center;\n      gap: .5rem;\n      color: var(--ink);\n      font-size: .88rem;\n      font-weight: 650;\n    }\n    .trust-point svg { color: var(--green); flex: 0 0 auto; }\n\n    section.content-section { padding: 92px 0; }\n    .section-heading {\n      max-width: 680px;\n      margin-bottom: 2.5rem;\n    }\n    .section-heading h2 {\n      margin-bottom: .8rem;\n      font-family: var(--serif);\n      font-size: clamp(2.4rem, 4.5vw, 3.6rem);\n      font-weight: 400;\n      letter-spacing: -.055em;\n      line-height: 1.08;\n    }\n    .section-heading p { max-width: 560px; margin-bottom: 0; color: var(--muted); }\n    .services-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 16px;\n    }\n    .service {\n      min-height: 210px;\n      padding: 1.6rem;\n      border: 1px solid var(--line);\n      border-radius: 18px;\n      background: var(--white);\n    }\n    .service-number {\n      display: block;\n      margin-bottom: 2.1rem;\n      color: #9aab99;\n      font-family: var(--serif);\n      font-size: 1.1rem;\n    }\n    .service h3 { margin-bottom: .5rem; font-size: 1.1rem; letter-spacing: -.02em; }\n    .service p { margin: 0; color: var(--muted); font-size: .92rem; }\n\n    .visit-section { background: #e9eee4; }\n    .visit-grid {\n      display: grid;\n      grid-template-columns: .9fr 1.1fr;\n      gap: clamp(2rem, 7vw, 6rem);\n      align-items: start;\n    }\n    .visit-section .section-heading { margin: 0; }\n    .visit-section .section-heading h2 { max-width: 440px; }\n    .visit-section .section-heading p { margin-bottom: 1.5rem; }\n    .details-card {\n      padding: 1.9rem;\n      background: var(--white);\n      border-radius: 20px;\n      box-shadow: 0 12px 35px rgba(32, 56, 50, .05);\n    }\n    .detail-row {\n      display: grid;\n      grid-template-columns: 42px 1fr;\n      gap: 1rem;\n      padding: 1rem 0;\n      border-bottom: 1px solid var(--line);\n    }\n    .detail-row:first-child { padding-top: 0; }\n    .detail-row:last-of-type { border-bottom: 0; }\n    .detail-icon {\n      display: grid;\n      place-items: center;\n      width: 40px;\n      height: 40px;\n      border-radius: 13px;\n      background: #edf1e8;\n      color: var(--green);\n    }\n    .detail-row h3 { margin: 0 0 .15rem; font-size: .92rem; }\n    .detail-row p { margin: 0; color: var(--muted); font-size: .9rem; }\n    .small-note {\n      margin: .4rem 0 0;\n      padding-top: 1rem;\n      border-top: 1px solid var(--line);\n      color: var(--muted);\n      font-size: .82rem;\n    }\n\n    .steps {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 2rem;\n      counter-reset: step;\n    }\n    .step {\n      position: relative;\n      padding-top: 1.2rem;\n      border-top: 1px solid #cfd5ca;\n      counter-increment: step;\n    }\n    .step::before {\n      content: \"0\" counter(step);\n      display: block;\n      margin-bottom: 1.2rem;\n      color: var(--green);\n      font-family: var(--serif);\n      font-size: 1.1rem;\n    }\n    .step h3 { margin-bottom: .45rem; font-size: 1.06rem; }\n    .step p { margin: 0; color: var(--muted); font-size: .92rem; }\n\n    .urgent {\n      padding: 1.25rem 1.4rem;\n      border-left: 4px solid var(--coral);\n      border-radius: 0 12px 12px 0;\n      background: #fff1e9;\n      color: #583d33;\n      font-size: .9rem;\n    }\n    .urgent strong { color: #452d25; }\n\n    .faq-section { background: var(--white); }\n    .faq-layout {\n      display: grid;\n      grid-template-columns: .8fr 1.2fr;\n      gap: clamp(2rem, 7vw, 6rem);\n    }\n    .faq-layout .section-heading { margin: 0; }\n    .faq-list details { border-bottom: 1px solid var(--line); }\n    .faq-list details:first-child { border-top: 1px solid var(--line); }\n    .faq-list summary {\n      position: relative;\n      padding: 1.2rem 2rem 1.2rem 0;\n      cursor: pointer;\n      font-weight: 700;\n      list-style: none;\n    }\n    .faq-list summary::-webkit-details-marker { display: none; }\n    .faq-list summary::after {\n      content: \"+\";\n      position: absolute;\n      right: .2rem;\n      top: 1rem;\n      color: var(--green);\n      font-size: 1.4rem;\n      font-weight: 400;\n    }\n    .faq-list details[open] summary::after { content: \"\u2212\"; }\n    .faq-list details p {\n      max-width: 620px;\n      margin: -.2rem 2rem 1.2rem 0;\n      color: var(--muted);\n      font-size: .92rem;\n    }\n\n    .closing { padding: 74px 0; }\n    .closing-card {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 2rem;\n      padding: clamp(2rem, 5vw, 3.5rem);\n      border-radius: 24px;\n      background: var(--green-dark);\n      color: white;\n    }\n    .closing-card h2 {\n      max-width: 570px;\n      margin: 0;\n      font-family: var(--serif);\n      font-size: clamp(2rem, 4vw, 3.4rem);\n      font-weight: 400;\n      letter-spacing: -.05em;\n      line-height: 1.1;\n    }\n    .closing-card .button { flex: 0 0 auto; background: var(--lime); color: var(--green-dark); }\n    .closing-card .button:hover { background: #e7f5c6; }\n\n    footer { padding: 28px 0; border-top: 1px solid var(--line); }\n    .footer-inner {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 1rem;\n      color: var(--muted);\n      font-size: .8rem;\n    }\n    .footer-inner p { margin: 0; }\n    .footer-links { display: flex; gap: 1.2rem; }\n    .footer-links a { text-underline-offset: 3px; }\n\n    @media (max-width: 800px) {\n      .nav { min-height: 72px; }\n      .nav-links { gap: 1rem; }\n      .nav-links > a:not(.button) { display: none; }\n      .hero { padding: 38px 0 60px; }\n      .hero-grid, .visit-grid, .faq-layout { grid-template-columns: 1fr; }\n      .hero-art { min-height: 360px; }\n      .trust-inner { padding: 1.2rem 0; align-items: flex-start; flex-direction: column; }\n      .trust-points { gap: .8rem 1.3rem; }\n      section.content-section { padding: 68px 0; }\n      .services-grid { grid-template-columns: repeat(2, 1fr); }\n      .closing-card { align-items: flex-start; flex-direction: column; }\n    }\n    @media (max-width: 540px) {\n      .wrap { width: min(100% - 32px, 1160px); }\n      .topline-inner { font-size: .75rem; }\n      .topline-inner p:first-child { max-width: 65%; }\n      .nav-links .button { min-height: 42px; padding: .6rem .9rem; font-size: .84rem; }\n      h1 { font-size: clamp(3rem, 15vw, 4.4rem); }\n      .hero-copy { font-size: 1rem; }\n      .hero-art { min-height: 325px; }\n      .sun { width: 210px; height: 210px; }\n      .orbit { width: 290px; height: 290px; right: -24px; }\n      .plant { left: 5%; transform: scale(.82); transform-origin: bottom left; }\n      .visit-card { margin-top: 48px; }\n      .services-grid, .steps { grid-template-columns: 1fr; }\n      .service { min-height: 0; }\n      .service-number { margin-bottom: 1rem; }\n      .steps { gap: 1.4rem; }\n      .footer-inner { align-items: flex-start; flex-direction: column; }\n    }\n    @media (prefers-reduced-motion: reduce) {\n      html { scroll-behavior: auto; }\n      *, *::before, *::after { transition-duration: .01ms !important; }\n    }\n  </style>\n</head>\n\n<body>\n  <a class=\"skip-link\" href=\"#main\">Skip to content</a>\n\n  <div class=\"topline\">\n    <div class=\"wrap topline-inner\">\n      <p>Walk-in sexual-health care, with room for every kind of you.</p>\n      <a href=\"#visit\">Visit information <span aria-hidden=\"true\">\u2197</span></a>\n    </div>\n  </div>\n\n  <header>\n    <div class=\"wrap nav\">\n      <a class=\"brand\" href=\"#\" aria-label=\"Open Door home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">o</span>\n        <span>open door</span>\n      </a>\n      <nav class=\"nav-links\" aria-label=\"Main navigation\">\n        <a href=\"#care\">Our care</a>\n        <a href=\"#visit\">Plan a visit</a>\n        <a href=\"#faq\">FAQs</a>\n        <a class=\"button\" href=\"#visit\">Come see us <span aria-hidden=\"true\">\u2192</span></a>\n      </nav>\n    </div>\n  </header>\n\n  <main id=\"main\">\n    <section class=\"hero\">\n      <div class=\"wrap hero-grid\">\n        <div>\n          <p class=\"eyebrow\">Care without judgment</p>\n          <h1>Sexual health, <em>on your terms.</em></h1>\n          <p class=\"hero-copy\">\n            Questions, checkups, or something on your mind\u2014we\u2019re here to listen\n            and help you figure out what\u2019s next. Drop in during walk-in hours.\n          </p>\n          <div class=\"hero-actions\">\n            <a class=\"button\" href=\"#visit\">Plan your visit <span aria-hidden=\"true\">\u2192</span></a>\n            <a class=\"button button-light\" href=\"#care\">Explore our care</a>\n          </div>\n          <p class=\"reassurance\">\n            <svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n              <path d=\"M12 3 20 6v5c0 5-3.4 8.4-8 10-4.6-1.6-8-5-8-10V6l8-3Z\" stroke=\"currentColor\" stroke-width=\"1.7\"/>\n              <path d=\"m8.5 12 2.2 2.2 4.8-5\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            </svg>\n            Your privacy matters. We\u2019ll explain how your information is used.\n          </p>\n        </div>\n\n        <div class=\"hero-art\" aria-label=\"A welcoming note about walk-in care\">\n          <div class=\"sun\" aria-hidden=\"true\"></div>\n          <div class=\"orbit\" aria-hidden=\"true\"></div>\n          <svg class=\"plant\" viewBox=\"0 0 150 205\" fill=\"none\" aria-hidden=\"true\">\n            <path d=\"M76 203c-4-49-3-91 2-139\" stroke=\"currentColor\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n            <path d=\"M75 117C47 112 35 96 37 74c23 2 39 14 40 39M78 91c2-26 17-42 41-45 2 23-9 40-39 50M74 157c-27-1-43-13-49-36 23-4 41 4 51 28M78 138c8-24 26-35 50-33-3 23-17 37-49 39\" fill=\"#d9e3ce\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linejoin=\"round\"/>\n            <path d=\"M43 202h68l-8-36H51l-8 36Z\" fill=\"#e7a18a\"/>\n            <path d=\"M47 174h60\" stroke=\"#bb745e\" stroke-width=\"3\"/>\n          </svg>\n          <article class=\"visit-card\">\n            <div class=\"card-icon\" aria-hidden=\"true\">\n              <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\">\n                <path d=\"M7 3v3m10-3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13H4V6a1 1 0 0 1 1-1Z\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/>\n                <path d=\"M8 13h3m2 0h3m-8 4h3\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/>\n              </svg>\n            </div>\n            <h2>Walk in.<br>We\u2019ll take it from here.</h2>\n            <p>No appointment needed during walk-in hours. Start with a conversation; we\u2019ll work out the rest together.</p>\n            <a class=\"card-link\" href=\"#visit\">Know before you go <span aria-hidden=\"true\">\u2192</span></a>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <div class=\"trust-strip\">\n      <div class=\"wrap trust-inner\">\n        <p>Care that meets you where you are.</p>\n        <div class=\"trust-points\">\n          <span class=\"trust-point\">\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            All genders welcome\n          </span>\n          <span class=\"trust-point\">\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            Respectful, practical support\n          </span>\n          <span class=\"trust-point\">\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            Walk-in visits\n          </span>\n        </div>\n      </div>\n    </div>\n\n    <section class=\"content-section\" id=\"care\">\n      <div class=\"wrap\">\n        <div class=\"section-heading\">\n          <p class=\"eyebrow\">How we can help</p>\n          <h2>Good care starts with a conversation.</h2>\n          <p>Tell us what\u2019s on your mind\u2014or ask a question and take it one step at a time. Our team can talk through your options and help you find the right next step.</p>\n        </div>\n        <div class=\"services-grid\">\n          <article class=\"service\">\n            <span class=\"service-number\">01</span>\n            <h3>STI testing &amp; treatment</h3>\n            <p>Get tested, talk through results, and ask about treatment or follow-up care.</p>\n          </article>\n          <article class=\"service\">\n            <span class=\"service-number\">02</span>\n            <h3>Birth control</h3>\n            <p>Explore contraceptive options and find out what may work for you.</p>\n          </article>\n          <article class=\"service\">\n            <span class=\"service-number\">03</span>\n            <h3>Pregnancy testing</h3>\n            <p>Get a test and compassionate support as you consider what comes next.</p>\n          </article>\n          <article class=\"service\">\n            <span class=\"service-number\">04</span>\n            <h3>PrEP &amp; HIV prevention</h3>\n            <p>Ask about HIV prevention, including PrEP, and where to access support.</p>\n          </article>\n          <article class=\"service\">\n            <span class=\"service-number\">05</span>\n            <h3>Sexual-health questions</h3>\n            <p>Talk openly about your body, relationships, safer sex, or anything else.</p>\n          </article>\n          <article class=\"service\">\n            <span class=\"service-number\">06</span>\n            <h3>Help finding care</h3>\n            <p>If you need something we don\u2019t provide, we\u2019ll help you explore options.</p>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"content-section visit-section\" id=\"visit\">\n      <div class=\"wrap visit-grid\">\n        <div class=\"section-heading\">\n          <p class=\"eyebrow\">Your visit</p>\n          <h2>Easy to come in. Easy to ask.</h2>\n          <p>Walk in during our listed hours. You don\u2019t need to have everything figured out before you arrive.</p>\n          <a class=\"button\" href=\"tel:{{PHONE_NUMBER}}\">Call the clinic <span aria-hidden=\"true\">\u2192</span></a>\n        </div>\n        <div class=\"details-card\">\n          <div class=\"detail-row\">\n            <div class=\"detail-icon\" aria-hidden=\"true\">\n              <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 21s7-6.1 7-12a7 7 0 1 0-14 0c0 5.9 7 12 7 12Z\" stroke=\"currentColor\" stroke-width=\"1.7\"/><circle cx=\"12\" cy=\"9\" r=\"2.2\" stroke=\"currentColor\" stroke-width=\"1.7\"/></svg>\n            </div>\n            <div>\n              <h3>Find us</h3>\n              <p>{{CLINIC_ADDRESS}}</p>\n            </div>\n          </div>\n          <div class=\"detail-row\">\n            <div class=\"detail-icon\" aria-hidden=\"true\">\n              <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\"><circle cx=\"12\" cy=\"12\" r=\"9\" stroke=\"currentColor\" stroke-width=\"1.7\"/><path d=\"M12 7v5l3.5 2\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/></svg>\n            </div>\n            <div>\n              <h3>Walk-in hours</h3>\n              <p>{{WALK_IN_HOURS}}</p>\n            </div>\n          </div>\n          <div class=\"detail-row\">\n            <div class=\"detail-icon\" aria-hidden=\"true\">\n              <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M5 4h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-7l-5 4v-4H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linejoin=\"round\"/><path d=\"M8 9h8M8 12h5\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/></svg>\n            </div>\n            <div>\n              <h3>Questions before you come?</h3>\n              <p><a href=\"tel:{{PHONE_NUMBER}}\">{{PHONE_NUMBER}}</a></p>\n            </div>\n          </div>\n          <p class=\"small-note\">Hours and services may change. Call ahead to confirm details before traveling.</p>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"content-section\" aria-labelledby=\"steps-heading\">\n      <div class=\"wrap\">\n        <div class=\"section-heading\">\n          <p class=\"eyebrow\">What to expect</p>\n          <h2 id=\"steps-heading\">A visit, at your pace.</h2>\n          <p>We\u2019ll explain what\u2019s happening and check in with you along the way.</p>\n        </div>\n        <div class=\"steps\">\n          <article class=\"step\">\n            <h3>Check in</h3>\n            <p>Let our front desk know you\u2019re here. You can share as much or as little as you\u2019re comfortable with.</p>\n          </article>\n          <article class=\"step\">\n            <h3>Talk it through</h3>\n            <p>A care team member will listen, answer questions, and discuss possible next steps with you.</p>\n          </article>\n          <article class=\"step\">\n            <h3>Choose what\u2019s right for you</h3>\n            <p>We\u2019ll explain your options and help make a plan together. You can ask questions at any point.</p>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <div class=\"wrap\">\n      <aside class=\"urgent\" aria-label=\"Urgent health information\">\n        <strong>Need urgent HIV prevention?</strong>\n        If you may have been exposed to HIV, seek medical care as soon as possible to ask about PEP. It must be started within 72 hours. Don\u2019t wait for a routine visit.\n      </aside>\n    </div>\n\n    <section class=\"content-section faq-section\" id=\"faq\">\n      <div class=\"wrap faq-layout\">\n        <div class=\"section-heading\">\n          <p class=\"eyebrow\">A few answers</p>\n          <h2>It\u2019s okay to have questions.</h2>\n          <p>Not sure what to expect? Here are a few things people often ask.</p>\n        </div>\n        <div class=\"faq-list\">\n          <details>\n            <summary>Do I need an appointment?</summary>\n            <p>No appointment is needed during walk-in hours. Check the visit details above for the latest schedule, and call ahead if you can.</p>\n          </details>\n          <details>\n            <summary>What should I bring?</summary>\n            <p>If you have them, bring a photo ID and any insurance information. If you don\u2019t have these, contact us to ask about your options\u2014please don\u2019t assume you can\u2019t be seen.</p>\n          </details>\n          <details>\n            <summary>Will my visit be private?</summary>\n            <p>We take your privacy seriously. Privacy rules can depend on where you live and your circumstances; our team can explain how your information is handled.</p>\n          </details>\n          <details>\n            <summary>What if I\u2019m nervous or don\u2019t know what to ask?</summary>\n            <p>That\u2019s okay. You can start with \u201cI\u2019m not sure where to begin.\u201d Our team is here to listen and help you work it out.</p>\n          </details>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"closing\">\n      <div class=\"wrap closing-card\">\n        <h2>You deserve care that listens.</h2>\n        <a class=\"button\" href=\"#visit\">Plan a walk-in visit <span aria-hidden=\"true\">\u2192</span></a>\n      </div>\n    </section>\n  </main>\n\n  <footer>\n    <div class=\"wrap footer-inner\">\n      <p>\u00a9 Open Door Sexual Health \u00b7 You are welcome here.</p>\n      <div class=\"footer-links\">\n        <a href=\"#visit\">Visit information</a>\n        <a href=\"#care\">Services</a>\n        <a href=\"#main\">Back to top</a>\n      </div>\n    </div>\n    <div class=\"wrap\" style=\"padding-top: 12px; color: #7b8780; font-size: .74rem;\">\n      Template note: Replace the clinic address, walk-in hours, and phone-number placeholders before publishing.\n    </div>\n  </footer>\n</body>\n</html>\n"}