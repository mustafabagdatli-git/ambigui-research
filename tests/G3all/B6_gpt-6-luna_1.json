overflow: hidden;\n      background: var(--orange);\n      color: var(--ink);\n      margin-top: 16px;\n      padding: 13px 0;\n      white-space: nowrap;\n    }\n    .ticker-track {\n      display: flex;\n      justify-content: space-around;\n      gap: 26px;\n      font-size: 11px;\n      font-weight: 950;\n      letter-spacing: .16em;\n      text-transform: uppercase;\n    }\n    .ticker b { font-size: 17px; line-height: 10px; }\n\n    section { scroll-margin-top: 30px; }\n    .section-head {\n      display: flex;\n      justify-content: space-between;\n      align-items: end;\n      gap: 25px;\n      margin: 90px 0 30px;\n    }\n    .section-kicker {\n      margin: 0 0 12px;\n      color: var(--muted);\n      font-size: 10px;\n      font-weight: 900;\n      letter-spacing: .18em;\n      text-transform: uppercase;\n    }\n    h2 {\n      margin: 0;\n      font-size: clamp(37px, 5vw, 62px);\n      line-height: .95;\n      letter-spacing: -.07em;\n      text-transform: uppercase;\n    }\n    .section-link {\n      padding-bottom: 8px;\n      border-bottom: 1px solid var(--ink);\n      font-size: 11px;\n      font-weight: 900;\n      letter-spacing: .11em;\n      text-transform: uppercase;\n      white-space: nowrap;\n    }\n\n    .products {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 15px;\n    }\n    .product-card {\n      position: relative;\n      min-width: 0;\n      background: #e9e5da;\n      overflow: hidden;\n    }\n    .product-visual {\n      height: 300px;\n      display: grid;\n      place-items: center;\n      position: relative;\n      overflow: hidden;\n    }\n    .product-visual::before {\n      content: \"\";\n      width: 230px;\n      height: 230px;\n      position: absolute;\n      border: 1px solid rgba(23,25,20,.16);\n      border-radius: 50%;\n    }\n    .product-visual::after {\n      content: \"\";\n      position: absolute;\n      width: 280px;\n      height: 1px;\n      background: rgba(23,25,20,.2);\n      transform: rotate(-38deg);\n    }\n    .product-visual svg { width: 78%; height: 90%; position: relative; z-index: 1; }\n    .visual-orange { background: #ed6845; }\n    .visual-lime { background: #d9fa52; }\n    .visual-blue { background: #b7d8d4; }\n    .product-info {\n      display: flex;\n      justify-content: space-between;\n      gap: 15px;\n      padding: 17px 18px 19px;\n      border-top: 1px solid rgba(23,25,20,.14);\n    }\n    .product-info h3 {\n      margin: 0 0 5px;\n      font-size: 15px;\n      font-weight: 900;\n      letter-spacing: -.02em;\n      text-transform: uppercase;\n    }\n    .product-info p { margin: 0; color: var(--muted); font-size: 12px; }\n    .price { font-size: 13px; font-weight: 900; white-space: nowrap; }\n\n    .lessons {\n      position: relative;\n      margin-top: 100px;\n      background: var(--lime);\n      display: grid;\n      grid-template-columns: 1.1fr .9fr;\n      min-height: 405px;\n      overflow: hidden;\n    }\n    .lesson-copy { padding: 58px 8%; position: relative; z-index: 1; }\n    .lesson-copy .section-kicker { color: rgba(23,25,20,.65); }\n    .lesson-copy h2 { max-width: 520px; }\n    .lesson-copy > p:not(.section-kicker) {\n      max-width: 390px;\n      margin: 21px 0 25px;\n      font-size: 14px;\n      line-height: 1.7;\n    }\n    .button-dark { color: var(--paper); background: var(--ink); }\n    .lesson-art {\n      position: relative;\n      min-height: 360px;\n      background: var(--orange);\n      overflow: hidden;\n    }\n    .lesson-art::before {\n      content: \"LEARN TO RIDE\";\n      position: absolute;\n      z-index: 1;\n      top: 22px;\n      left: 25px;\n      color: rgba(23,25,20,.65);\n      font-size: 10px;\n      font-weight: 900;\n      letter-spacing: .2em;\n    }\n    .lesson-art svg { width: 100%; height: 100%; position: absolute; inset: 0; }\n    .lesson-badge {\n      position: absolute;\n      z-index: 2;\n      right: 25px;\n      bottom: 25px;\n      width: 88px;\n 