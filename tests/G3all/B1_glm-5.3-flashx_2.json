{"brief": "B1", "model": "z-ai/glm-5.3-flashx", "i": 2, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Wren & Sons Plumbing \u2014 Family Plumbers in Leeds Since 1998</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Instrument+Sans:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --ink:#1d2a32;\n    --ink-soft:#41525c;\n    --cream:#f7f1e8;\n    --cream-deep:#efe6d8;\n    --copper:#b05c2a;\n    --copper-deep:#8f4a20;\n    --water:#2e6f8e;\n    --line:#d9cdba;\n  }\n  *{margin:0;padding:0;box-sizing:border-box}\n  html{scroll-behavior:smooth}\n  body{\n    font-family:'Instrument Sans',sans-serif;\n    background:var(--cream);\n    color:var(--ink);\n    line-height:1.6;\n    -webkit-font-smoothing:antialiased;\n  }\n  h1,h2,h3,.serif{font-family:'Fraunces',serif;font-weight:600;line-height:1.1;letter-spacing:-0.01em}\n  a{color:inherit;text-decoration:none}\n  .wrap{max-width:1120px;margin:0 auto;padding:0 24px}\n\n  /* ---------- Header ---------- */\n  header{\n    position:sticky;top:0;z-index:50;\n    background:rgba(247,241,232,.92);\n    backdrop-filter:blur(8px);\n    border-bottom:1px solid var(--line);\n  }\n  .nav{display:flex;align-items:center;justify-content:space-between;height:72px}\n  .logo{display:flex;align-items:center;gap:10px;font-family:'Fraunces',serif;font-size:1.25rem;font-weight:700}\n  .logo svg{display:block}\n  .nav-links{display:flex;gap:32px;font-size:.95rem;font-weight:500;color:var(--ink-soft)}\n  .nav-links a{transition:color .2s}\n  .nav-links a:hover{color:var(--copper)}\n  .nav-phone{\n    display:inline-flex;align-items:center;gap:8px;\n    background:var(--ink);color:var(--cream);\n    padding:10px 20px;border-radius:999px;font-weight:600;font-size:.95rem;\n    transition:background .2s,transform .2s;\n  }\n  .nav-phone:hover{background:var(--copper);transform:translateY(-1px)}\n  @media(max-width:760px){.nav-links{display:none}}\n\n  /* ---------- Hero ---------- */\n  .hero{padding:72px 0 96px;position:relative;overflow:hidden}\n  .hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:56px;align-items:center}\n  @media(max-width:900px){.hero-grid{grid-template-columns:1fr}}\n  .eyebrow{\n    display:inline-flex;align-items:center;gap:10px;\n    font-size:.8rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;\n    color:var(--copper);margin-bottom:24px;\n  }\n  .eyebrow::before{content:\"\";width:32px;height:2px;background:var(--copper)}\n  .hero h1{font-size:clamp(2.6rem,5.5vw,4.2rem);margin-bottom:24px}\n  .hero h1 em{font-style:italic;color:var(--copper)}\n  .hero p{font-size:1.15rem;color:var(--ink-soft);max-width:32rem;margin-bottom:36px}\n  .hero-ctas{display:flex;gap:16px;flex-wrap:wrap;align-items:center}\n  .btn{\n    display:inline-flex;align-items:center;gap:10px;\n    padding:16px 30px;border-radius:999px;font-weight:600;font-size:1rem;\n    border:none;cursor:pointer;transition:transform .2s,box-shadow .2s,background .2s;\n    font-family:'Instrument Sans',sans-serif;\n  }\n  .btn-primary{background:var(--copper);color:#fff;box-shadow:0 4px 0 var(--copper-deep)}\n  .btn-primary:hover{transform:translateY(-2px);box-shadow:0 6px 0 var(--copper-deep)}\n  .btn-primary:active{transform:translateY(2px);box-shadow:0 2px 0 var(--copper-deep)}\n  .btn-ghost{background:transparent;color:var(--ink);border:2px solid var(--ink)}\n  .btn-ghost:hover{background:var(--ink);color:var(--cream)}\n  .hero-trust{display:flex;gap:28px;margin-top:44px;flex-wrap:wrap}\n  .trust-item{font-size:.9rem;color:var(--ink-soft)}\n  .trust-item strong{display:block;font-family:'Fraunces',serif;font-size:1.5rem;color:var(--ink)}\n\n  /* Tap illustration */\n  .tap-stage{display:flex;justify-content:center}\n  .tap-stage svg{max-width:100%;height:auto;cursor:pointer}\n  .tap-hint{\n    text-align:center;font-size:.85rem;color:var(--ink-soft);margin-top:8px;\n    opacity:.7;transition:opacity .3s;\n  }\n  /* pipe water animation */\n  .pipe-water{stroke-dasharray:14 10;stroke-dashoffset:0;animation:flow 1s linear infinite paused;opacity:0;transition:opacity .4s}\n  .flowing .pipe-water{animation-play-state:running;opacity:1}\n  @keyframes flow{to{stroke-dashoffset:-48}}\n  .drip{animation:drip 2.2s ease-in infinite paused;transform-origin:center}\n  .flowing .drip{animation-play-state:running}\n  @keyframes drip{\n    0%{transform:translateY(0);opacity:0}\n    15%{opacity:1}\n    90%{transform:translateY(46px);opacity:1}\n    100%{transform:translateY(52px);opacity:0}\n  }\n  .drop-pool{opacity:.35}\n  .valve-wheel{transform-origin:88px 118px;transition:transform .6s cubic-bezier(.6,-0.2,.3,1.4)}\n  .flowing .valve-wheel{transform:rotate(150deg)}\n  .water-fill{transform:scaleY(0);transform-origin:120px 200px;transition:transform 1.6s ease .3s}\n  .flowing .water-fill{transform:scaleY(1)}\n\n  /* ---------- Marquee strip ---------- */\n  .strip{background:var(--ink);color:var(--cream);padding:16px 0;overflow:hidden;white-space:nowrap}\n  .strip-inner{display:inline-block;animation:scroll 28s linear infinite}\n  .strip span{font-family:'Fraunces',serif;font-size:1rem;letter-spacing:.06em;margin:0 28px}\n  .strip .dot{color:var(--copper)}\n  @keyframes scroll{to{transform:translateX(-50%)}}\n\n  /* ---------- Sections ---------- */\n  section{padding:96px 0}\n  .sec-head{max-width:38rem;margin-bottom:56px}\n  .sec-head .eyebrow{margin-bottom:16px}\n  .sec-head h2{font-size:clamp(2rem,3.6vw,2.9rem);margin-bottom:16px}\n  .sec-head p{color:var(--ink-soft);font-size:1.05rem}\n\n  /* Services \u2014 editorial numbered list */\n  .service{\n    display:grid;grid-template-columns:90px 1fr 2fr auto;gap:28px;align-items:baseline;\n    padding:34px 0;border-top:1px solid var(--line);\n    transition:background .25s;\n  }\n  .service:last-of-type{border-bottom:1px solid var(--line)}\n  .service:hover{background:rgba(176,92,42,.05)}\n  .service .num{font-family:'Fraunces',serif;font-style:italic;color:var(--copper);font-size:1.1rem}\n  .service h3{font-size:1.45rem}\n  .service p{color:var(--ink-soft);font-size:.98rem}\n  .service .price{font-size:.85rem;font-weight:600;color:var(--ink-soft);white-space:nowrap;border:1px solid var(--line);padding:6px 14px;border-radius:999px}\n  @media(max-width:800px){\n    .service{grid-template-columns:60px 1fr;grid-template-rows:auto auto}\n    .service p{grid-column:2}\n    .service .price{grid-column:2;justify-self:start}\n  }\n\n  /* Family story */\n  .story{background:var(--cream-deep)}\n  .story-grid{display:grid;grid-template-columns:1fr 1fr;gap:72px;align-items:center}\n  @media(max-width:860px){.story-grid{grid-template-columns:1fr}}\n  .badge-spin{display:flex;justify-content:center}\n  .badge-spin svg{animation:spin 24s linear infinite}\n  @keyframes spin{to{transform:rotate(360deg)}}\n  .story h2{font-size:clamp(1.9rem,3.4vw,2.6rem);margin-bottom:20px}\n  .story p{color:var(--ink-soft);margin-bottom:18px}\n  .sig{font-family:'Fraunces',serif;font-style:italic;font-size:1.3rem;color:var(--copper);margin-top:28px}\n  .sig small{display:block;font-family:'Instrument Sans',sans-serif;font-style:normal;font-size:.85rem;color:var(--ink-soft);margin-top:4px}\n\n  /* Coverage */\n  .area-tags{display:flex;flex-wrap:wrap;gap:12px}\n  .area-tag{\n    padding:10px 20px;border:1.5px solid var(--ink);border-radius:999px;\n    font-size:.92rem;font-weight:500;transition:all .2s;cursor:default;\n  }\n  .area-tag:hover{background:var(--ink);color:var(--cream);transform:translateY(-2px)}\n\n  /* Reviews */\n  .reviews{background:var(--ink);color:var(--cream)}\n  .reviews .eyebrow{color:var(--copper)}\n  .reviews .eyebrow::before{background:var(--copper)}\n  .quote{max-width:52rem}\n  .quote blockquote{\n    font-family:'Fraunces',serif;font-size:clamp(1.5rem,3vw,2.2rem);\n    font-style:italic;line-height:1.35;min-height:5.5em;\n    transition:opacity .3s;\n  }\n  .quote blockquote.fading{opacity:0}\n  .quote-meta{margin-top:28px;font-size:.95rem;color:#9fb3bd}\n  .quote-nav{display:flex;gap:12px;margin-top:36px}\n  .qbtn{\n    width:48px;height:48px;border-radius:50%;border:1.5px solid #4a5c66;\n    background:transparent;color:var(--cream);font-size:1.1rem;cursor:pointer;\n    transition:all .2s;\n  }\n  .qbtn:hover{background:var(--copper);border-color:var(--copper)}\n\n  /* Contact */\n  .contact-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:72px}\n  @media(max-width:860px){.contact-grid{grid-template-columns:1fr}}\n  .contact-info h2{font-size:clamp(2rem,3.4vw,2.7rem);margin-bottom:20px}\n  .contact-info p{color:var(--ink-soft);margin-bottom:32px}\n  .contact-line{display:flex;align-items:center;gap:16px;padding:18px 0;border-top:1px solid var(--line);font-size:1rem}\n  .contact-line strong{font-family:'Fraunces',serif;font-size:1.15rem}\n  .contact-line .lbl{font-size:.78rem;text-transform:uppercase;letter-spacing:.1em;color:var(--ink-soft)}\n  form{display:grid;gap:18px}\n  .field label{display:block;font-size:.82rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:8px}\n  .field input,.field select,.field textarea{\n    width:100%;padding:14px 16px;border:1.5px solid var(--line);border-radius:10px;\n    background:#fffdf9;font-family:'Instrument Sans',sans-serif;font-size:1rem;color:var(--ink);\n    transition:border-color .2s;\n  }\n  .field input:focus,.field select:focus,.field textarea:focus{outline:none;border-color:var(--copper)}\n  .field textarea{resize:vertical;min-height:110px}\n  .form-row{display:grid;grid-template-columns:1fr 1fr;gap:18px}\n  @media(max-width:560px){.form-row{grid-template-columns:1fr}}\n\n  /* Toast */\n  .toast{\n    position:fixed;bottom:28px;left:50%;transform:translate(-50%,120%);\n    background:var(--ink);color:var(--cream);padding:16px 28px;border-radius:999px;\n    font-weight:500;font-size:.95rem;box-shadow:0 12px 32px rgba(29,42,50,.3);\n    transition:transform .4s cubic-bezier(.2,.9,.3,1.2);z-index:100;\n    display:flex;align-items:center;gap:10px;\n  }\n  .toast.show{transform:translate(-50%,0)}\n  .toast .tick{width:22px;height:22px;border-radius:50%;background:var(--copper);display:grid;place-items:center;font-size:.7rem}\n\n  /* Footer */\n  footer{background:var(--ink);color:#9fb3bd;padding:56px 0 40px;font-size:.9rem}\n  .foot-grid{display:flex;justify-content:space-between;gap:40px;flex-wrap:wrap;margin-bottom:40px}\n  .foot-grid .logo{color:var(--cream);margin-bottom:12px}\n  .foot-col h4{color:var(--cream);font-size:.8rem;letter-spacing:.12em;text-transform:uppercase;margin-bottom:14px;font-weight:600}\n  .foot-col a{display:block;padding:4px 0;transition:color .2s}\n  .foot-col a:hover{color:var(--copper)}\n  .foot-bottom{border-top:1px solid #33434d;padding-top:24px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px}\n</style>\n</head>\n<body>\n\n<header>\n  <div class=\"wrap nav\">\n    <a class=\"logo\" href=\"#top\">\n      <svg width=\"30\" height=\"30\" viewBox=\"0 0 30 30\" fill=\"none\">\n        <circle cx=\"15\" cy=\"15\" r=\"13\" stroke=\"#b05c2a\" stroke-width=\"2.5\"/>\n        <path d=\"M9 19c0-4 2-8 6-8s6 4 6 8\" stroke=\"#1d2a32\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n        <circle cx=\"15\" cy=\"19\" r=\"1.8\" fill=\"#b05c2a\"/>\n      </svg>\n      Wren &amp; Sons\n    </a>\n    <nav class=\"nav-links\">\n      <a href=\"#services\">Services</a>\n      <a href=\"#family\">Our Family</a>\n      <a href=\"#areas\">Areas Covered</a>\n      <a href=\"#reviews\">Reviews</a>\n    </nav>\n    <a class=\"nav-phone\" href=\"tel:01131234567\">\n      <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.6 2Z\"/></svg>\n      0113 123 4567\n    </a>\n  </div>\n</header>\n\n<main id=\"top\">\n\n  <!-- HERO -->\n  <section class=\"hero\">\n    <div class=\"wrap hero-grid\">\n      <div>\n        <span class=\"eyebrow\">Family-run in Leeds since 1998</span>\n        <h1>Fixed properly. By people who <em>answer the phone.</em></h1>\n        <p>Three generations of Wrens have kept Leeds homes warm and dry \u2014 from Headingley terraces to Horsforth semis. No call centres, no upselling, no mess left behind.</p>\n        <div class=\"hero-ctas\">\n          <a href=\"#contact\" class=\"btn btn-primary\">Book a plumber</a>\n          <a href=\"tel:01131234567\" class=\"btn btn-ghost\">Emergency? Call now</a>\n        </div>\n        <div class=\"hero-trust\">\n          <div class=\"trust-item\"><strong>26 yrs</strong>trading in Leeds</div>\n          <div class=\"trust-item\"><strong>&lt; 90 min</strong>emergency response</div>\n          <div class=\"trust-item\"><strong>Gas Safe</strong>reg. no. 512 443</div>\n        </div>\n      </div>\n\n      <!-- Interactive tap: click to open the valve -->\n      <div class=\"tap-stage\" id=\"tapStage\">\n        <svg viewBox=\"0 0 300 340\" width=\"360\" aria-label=\"Illustration of a tap and copper pipe \u2014 click to turn on\">\n          <!-- copper pipe from right -->\n          <rect x=\"150\" y=\"96\" width=\"150\" height=\"24\" rx=\"4\" fill=\"#b05c2a\"/>\n          <rect x=\"150\" y=\"96\" width=\"150\" height=\"8\" rx=\"4\" fill=\"#c9763f\"/>\n          <!-- water inside pipe -->\n          <line class=\"pipe-water\" x1=\"152\" y1=\"108\" x2=\"298\" y2=\"108\" stroke=\"#8fc3da\" stroke-width=\"8\" stroke-linecap=\"round\"/>\n          <!-- vertical drop pipe -->\n          <rect x=\"150\" y=\"96\" width=\"24\" height=\"60\" rx=\"4\" fill=\"#b05c2a\"/>\n          <rect x=\"150\" y=\"96\" width=\"8\" height=\"60\" rx=\"4\" fill=\"#c9763f\"/>\n          <!-- tap body -->\n          <path d=\"M150 156 h-58 a14 14 0 0 0 -14 14 v22 a10 10 0 0 0 10 10 h62 a10 10 0 0 0 10 -10 v-26 Z\" fill=\"#3a4a54\"/>\n          <rect x=\"86\" y=\"188\" width=\"20\" height=\"14\" rx=\"3\" fill=\"#2c3941\"/>\n          <!-- spout outlet -->\n          <rect x=\"76\" y=\"200\" width=\"24\" height=\"10\" rx=\"3\" fill=\"#232e35\"/>\n          <!-- valve stem + wheel -->\n          <rect x=\"82\" y=\"126\" width=\"12\" height=\"34\" rx=\"3\" fill=\"#2c3941\"/>\n          <g class=\"valve-wheel\">\n            <circle cx=\"88\" cy=\"118\" r=\"16\" fill=\"none\" stroke=\"#b05c2a\" stroke-width=\"4\"/>\n            <line x1=\"88\" y1=\"102\" x2=\"88\" y2=\"134\" stroke=\"#b05c2a\" stroke-width=\"4\"/>\n            <line x1=\"72\" y1=\"118\" x2=\"104\" y2=\"118\" stroke=\"#b05c2a\" stroke-width=\"4\"/>\n            <circle cx=\"88\" cy=\"118\" r=\"4\" fill=\"#8f4a20\"/>\n          </g>\n          <!-- drip + stream -->\n          <g id=\"dripGroup\">\n            <ellipse class=\"drop-pool\" cx=\"88\" cy=\"252\" rx=\"14\" ry=\"4\" fill=\"#8fc3da\"/>\n            <path class=\"pipe-water-stream\" d=\"M82 212 v34\" stroke=\"#8fc3da\" stroke-width=\"6\" stroke-linecap=\"round\" style=\"animation:drip 0s\" display=\"none\"/>\n            <path class=\"pipe-water\" d=\"M84 212 v36\" stroke=\"#8fc3da\" stroke-width=\"6\" stroke-linecap=\"round\" fill=\"none\"/>\n            <circle class=\"drip\" cx=\"88\" cy=\"218\" r=\"4.5\" fill=\"#2e6f8e\"/>\n          </g>\n          <!-- bucket filling -->\n          <path d=\"M60 300 h56 l-7 -48 h-42 Z\" fill=\"#41525c\"/>\n          <path d=\"M64 262 h48 l1.5 10 h-51 Z\" fill=\"#5a6f7a\"/>\n          <path class=\"water-fill\" d=\"M65.5 272 h45 l4.5 28 h-54 Z\" fill=\"#2e6f8e\" opacity=\".85\"/>\n          <!-- click target highlight -->\n          <circle cx=\"88\" cy=\"118\" r=\"26\" fill=\"transparent\"/>\n          <text x=\"150\" y=\"326\" text-anchor=\"middle\" font-family=\"Instrument Sans, sans-serif\" font-size=\"13\" fill=\"#41525c\" font-style=\"italic\">go on \u2014 turn the tap</text>\n        </svg>\n      </div>\n      <div class=\"tap-hint\" id=\"tapHint\" style=\"grid-column:2;max-width:360px;margin:0 auto\">Click the tap to open the valve</div>\n    </div>\n  </section>\n\n  <!-- STRIP -->\n  <div class=\"strip\" aria-hidden=\"true\">\n    <div class=\"strip-inner\" id=\"stripInner\"></div>\n  </div>\n\n  <!-- SERVICES -->\n  <section id=\"services\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"eyebrow\">What we do</span>\n        <h2>Every job, from a drip to a full re-plumb</h2>\n        <p>Honest quotes before we start, fixed pricing, and the same two faces every time \u2014 Dave on the emergencies, Tom on the big jobs.</p>\n      </div>\n\n      <div class=\"service\">\n        <span class=\"num\">01</span>\n        <h3>Emergency call-outs</h3>\n        <p>Burst pipes, leaks and no hot water \u2014 we answer 24/7 and aim to be with you inside 90 minutes anywhere in Leeds.</p>\n        <span class=\"price\">from \u00a385 + parts</span>\n      </div>\n      <div class=\"service\">\n        <span class=\"num\">02</span>\n        <h3>Boiler service &amp; repair</h3>\n        <p>Gas Safe registered for all makes. Annual servicing plans that actually include the parts, not just the glance.</p>\n        <span class=\"price\">from \u00a370</span>\n      </div>\n      <div class=\"service\">\n        <span class=\"num\">03</span>\n        <h3>Bathroom installations</h3>\n        <p>Full design-to-tiling refits. We've done over 300 across Leeds \u2014 ask to see photos of one near you.</p>\n        <span class=\"price\">free quote</span>\n      </div>\n      <div class=\"service\">\n        <span class=\"num\">04</span>\n        <h3>Leak detection</h3>\n        <p>Thermal imaging and acoustic kit finds hidden leaks without ripping up your floor on a guess.</p>\n        <span class=\"price\">from \u00a3120</span>\n      </div>\n      <div class=\"service\">\n        <span class=\"num\">05</span>\n        <h3>Landlord certificates</h3>\n        <p>CP12 gas safety records with reminders every year, so you never miss a renewal date.</p>\n        <span class=\"price\">from \u00a360</span>\n      </div>\n    </div>\n  </section>\n\n  <!-- FAMILY -->\n  <section class=\"story\" id=\"family\">\n    <div class=\"wrap story-grid\">\n      <div>\n        <span class=\"eyebrow\">Our family</span>\n        <h2>Started by Ron. Run by his grandkids.</h2>\n        <p>Ron Wren left the pit in 1998 with a van, a toolkit and a phone number painted on the side. He fixed boilers in Chapel Allerton for twenty years and never once advertised \u2014 word of mouth did it all.</p>\n        <p>Today his grandkids Dave and Tom run the same van route, with the same rule Ron had: <strong style=\"color:var(--ink)\">if we wouldn't accept the job in our own mum's house, we don't do it in yours.</strong></p>\n        <div class=\"sig\">\u2014 Dave &amp; Tom Wren<small>Third-generation plumbers, Leeds</small></div>\n      </div>\n      <div class=\"badge-spin\">\n        <svg width=\"300\" height=\"300\" viewBox=\"0 0 300 300\">\n          <defs>\n            <path id=\"circlePath\" d=\"M150,150 m-108,0 a108,108 0 1,1 216,0 a108,108 0 1,1 -216,0\"/>\n          </defs>\n          <circle cx=\"150\" cy=\"150\" r=\"72\" fill=\"none\" stroke=\"#b05c2a\" stroke-width=\"1.5\"/>\n          <circle cx=\"150\" cy=\"150\" r=\"66\" fill=\"none\" stroke=\"#b05c2a\" stroke-width=\"1.5\" stroke-dasharray=\"3 6\"/>\n          <text font-family=\"Fraunces, serif\" font-size=\"17\" fill=\"#1d2a32\" letter-spacing=\"3.5\">\n            <textPath href=\"#circlePath\">WREN &amp; SONS \u00b7 LEEDS \u00b7 EST. 1998 \u00b7 GAS SAFE \u00b7 </textPath>\n          </text>\n          <g transform=\"translate(150,150)\">\n            <path d=\"M-26 26 l0 -34 a8 8 0 0 1 8 -8 h36 l-10 10 8 8 -10 10 6 6 -8 8 Z\" fill=\"none\" stroke=\"#b05c2a\" stroke-width=\"3\" stroke-linejoin=\"round\"/>\n            <circle cx=\"10\" cy=\"8\" r=\"5\" fill=\"none\" stroke=\"#1d2a32\" stroke-width=\"3\"/>\n          </g>\n          <text x=\"150\" y=\"208\" text-anchor=\"middle\" font-family=\"Fraunces, serif\" font-style=\"italic\" font-size=\"15\" fill=\"#41525c\">three generations</text>\n        </svg>\n      </div>\n    </div>\n  </section>\n\n  <!-- AREAS -->\n  <section id=\"areas\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"eyebrow\">Where we work</span>\n        <h2>Leeds through and through</h2>\n        <p>If you're within these neighbourhoods, you're on our patch. Slightly outside? Ring us anyway \u2014 we're soft.</p>\n      </div>\n      <div class=\"area-tags\">\n        <span class=\"area-tag\">Headingley</span><span class=\"area-tag\">Hyde Park</span>\n        <span class=\"area-tag\">Chapel Allerton</span><span class=\"area-tag\">Horsforth</span>\n        <span class=\"area-tag\">Meanwood</span><span class=\"area-tag\">Roundhay</span>\n        <span class=\"area-tag\">Kirkstall</span><span class=\"area-tag\">Bramley</span>\n        <span class=\"area-tag\">Armley</span><span class=\"area-tag\">Morley</span>\n        <span class=\"area-tag\">Pudsey</span><span class=\"area-tag\">Garforth</span>\n        <span class=\"area-tag\">Otley</span><span class=\"area-tag\">Wetherby</span>\n        <span class=\"area-tag\">Leeds City Centre</span>\n      </div>\n    </div>\n  </section>\n\n  <!-- REVIEWS -->\n  <section class=\"reviews\" id=\"reviews\">\n    <div class=\"wrap\">\n      <span class=\"eyebrow\">Word of mouth</span>\n      <div class=\"quote\">\n        <blockquote id=\"quoteText\">\"Water pouring through the kitchen ceiling at 11pm. Dave answered on the second ring, was here by midnight, and charged exactly what he quoted. Can't recommend enough.\"</blockquote>\n        <div class=\"quote-meta\" id=\"quoteMeta\">\u2014 Sarah M., Headingley \u00b7 Google review</div>\n      </div>\n      <div class=\"quote-nav\">\n        <button class=\"qbtn\" id=\"prevQ\" aria-label=\"Previous review\">\u2190</button>\n        <button class=\"qbtn\" id=\"nextQ\" aria-label=\"Next review\">\u2192</button>\n      </div>\n    </div>\n  </section>\n\n  <!-- CONTACT -->\n  <section id=\"contact\">\n    <div class=\"wrap contact-grid\">\n      <div class=\"contact-info\">\n        <span class=\"eyebrow\">Get in touch</span>\n        <h2>Tell us what's gone wrong</h2>\n        <p>We'll ring you back the same day \u2014 usually within the hour. For emergencies, skip the form and call.</p>\n        <div class=\"contact-line\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#b05c2a\" stroke-width=\"2.2\" stroke-linecap=\"round\"><path d=\"M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.6 2Z\"/></svg>\n          <div><span class=\"lbl\">24hr line</span><br><strong>0113 123 4567</strong></div>\n        </div>\n        <div class=\"contact-line\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#b05c2a\" stroke-width=\"2.2\" stroke-linecap=\"round\"><rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"/><path d=\"m22 7-10 6L2 7\"/></svg>\n          <div><span class=\"lbl\">Email</span><br><strong>hello@wrenandsons.co.uk</strong></div>\n        </div>\n        <div class=\"contact-line\" style=\"border-bottom:1px solid var(--line)\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#b05c2a\" stroke-width=\"2.2\" stroke-linecap=\"round\"><path d=\"M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/></svg>\n          <div><span class=\"lbl\">The yard</span><br><strong>Unit 4, Kirkstall Road, Leeds LS4</strong></div>\n        </div>\n      </div>\n      <form id=\"bookForm\" novalidate>\n        <div class=\"form-row\">\n          <div class=\"field\">\n            <label for=\"fname\">Your name</label>\n            <input id=\"fname\" type=\"text\" required placeholder=\"Jane Cooper\">\n          </div>\n          <div class=\"field\">\n            <label for=\"fphone\">Phone</label>\n            <input id=\"fphone\" type=\"tel\" required placeholder=\"07\u2014 \u2014\u2014\u2014 \u2014\u2014\u2014\">\n          </div>\n        </div>\n        <div class=\"field\">\n          <label for=\"farea\">Your area</label>\n          <select id=\"farea\">\n            <option>Headingley</option><option>Chapel Allerton</option>\n            <option>Horsforth</option><option>Meanwood</option>\n            <option>Roundhay</option><option>Elsewhere in Leeds</option>\n          </select>\n        </div>\n        <div class=\"field\">\n          <label for=\"fmsg\">What's the problem?</label>\n          <textarea id=\"fmsg\" required placeholder=\"e.g. Boiler's making a banging noise and the radiators are cold upstairs\u2026\"></textarea>\n        </div>\n        <button type=\"submit\" class=\"btn btn-primary\" style=\"justify-self:start\">Send it over</button>\n      </form>\n    </div>\n  </section>\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <div class=\"foot-grid\">\n      <div style=\"max-width:300px\">\n        <a class=\"logo\" href=\"#top\">\n          <svg width=\"26\" height=\"26\" viewBox=\"0 0 30 30\" fill=\"none\">\n            <circle cx=\"15\" cy=\"15\" r=\"13\" stroke=\"#b05c2a\" stroke-width=\"2.5\"/>\n            <path d=\"M9 19c0-4 2-8 6-8s6 4 6 8\" stroke=\"#f7f1e8\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n            <circle cx=\"15\" cy=\"19\" r=\"1.8\" fill=\"#b05c2a\"/>\n          </svg>\n          Wren &amp; Sons\n        </a>\n        <p>Family plumbers and heating engineers serving Leeds since 1998. Gas Safe reg. 512 443.</p>\n      </div>\n      <div class=\"foot-col\">\n        <h4>Services</h4>\n        <a href=\"#services\">Emergencies</a><a href=\"#services\">Boilers</a>\n        <a href=\"#services\">Bathrooms</a><a href=\"#services\">Leak detection</a>\n      </div>\n      <div class=\"foot-col\">\n        <h4>Company</h4>\n        <a href=\"#family\">Our family</a><a href=\"#areas\">Areas covered</a>\n        <a href=\"#reviews\">Reviews</a><a href=\"#contact\">Contact</a>\n      </div>\n      <div class=\"foot-col\">\n        <h4>Emergency</h4>\n        <a href=\"tel:01131234567\">0113 123 4567</a>\n        <p style=\"margin-top:8px\">Answered 24/7 by Dave or Tom \u2014 never a call centre.</p>\n      </div>\n    </div>\n    <div class=\"foot-bottom\">\n      <span>\u00a9 2024 Wren &amp; Sons Plumbing Ltd</span>\n      <span>Made in Leeds, like everything else we do.</span>\n    </div>\n  </div>\n</footer>\n\n<div class=\"toast\" id=\"toast\"><span class=\"tick\">\u2713</span><span id=\"toastMsg\">Thanks \u2014 we'll ring you back within the hour.</span></div>\n\n<script>\n  // Marquee strip\n  const items = [\"24/7 emergency call-outs\",\"Fixed quotes, no surprises\",\"Gas Safe registered\",\"Three generations of Wrens\",\"We clean up after ourselves\",\"90-minute response in Leeds\"];\n  const stripInner = document.getElementById('stripInner');\n  stripInner.innerHTML = Array(2).fill(items.map(t => `<span>${t}</span><span class=\"dot\">\u25cf</span>`).join('')).join('');\n\n  // Interactive tap\n  const stage = document.getElementById('tapStage');\n  const svg = stage.querySelector('svg');\n  const hint = document.getElementById('tapHint');\n  svg.addEventListener('click', () => {\n    const on = svg.classList.toggle('flowing');\n    hint.textContent = on ? \"That's the water on \u2014 same as us, quick and reliable\" : \"Click the tap to open the valve\";\n    hint.style.opacity = 1;\n  });\n\n  // Reviews carousel\n  const quotes = [\n    {t:'\"Water pouring through the kitchen ceiling at 11pm. Dave answered on the second ring, was here by midnight, and charged exactly what he quoted. Can\\'t recommend enough.\"', m:'\u2014 Sarah M., Headingley \u00b7 Google review'},\n    {t:'\"Tom re-plumbed our whole bathroom and treated the house like his own. Dust sheets everywhere, hoovered up after, and even fixed a dodgy radiator for free while he was here.\"', m:'\u2014 Raj P., Chapel Allerton \u00b7 Word of mouth'},\n    {t:'\"Third boiler service with these now. They remember the house, they remember the boiler, and they always turn up when they say they will. Rare as hen\\'s teeth.\"', m:'\u2014 Margaret W., Horsforth \u00b7 Annual service customer'},\n    {t:'\"Landlord with eight properties across Leeds. One phone number for all of them, certificates filed automatically. They\\'ve saved my weekends for years.\"', m:'\u2014 Daniel O., City centre \u00b7 Landlord account'}\n  ];\n  let qi = 0;\n  const qText = document.getElementById('quoteText'), qMeta = document.getElementById('quoteMeta');\n  function showQuote(i){\n    qText.classList.add('fading');\n    setTimeout(() => {\n      qi = (i + quotes.length) % quotes.length;\n      qText.textContent = quotes[qi].t;\n      qMeta.textContent = quotes[qi].m;\n      qText.classList.remove('fading');\n    }, 300);\n  }\n  document.getElementById('nextQ').onclick = () => showQuote(qi + 1);\n  document.getElementById('prevQ').onclick = () => showQuote(qi - 1);\n\n  // Toast + form\n  const toast = document.getElementById('toast');\n  let toastTimer;\n  function showToast(msg){\n    document.getElementById('toastMsg').textContent = msg;\n    toast.classList.add('show');\n    clearTimeout(toastTimer);\n    toastTimer = setTimeout(() => toast.classList.remove('show'), 3500);\n  }\n  document.getElementById('bookForm').addEventListener('submit', e => {\n    e.preventDefault();\n    const name = document.getElementById('fname');\n    const phone = document.getElementById('fphone');\n    const msg = document.getElementById('fmsg');\n    if(!name.value.trim() || !phone.value.trim() || !msg.value.trim()){\n      showToast('A quick note: name, phone and the problem, please.');\n      [name, phone, msg].forEach(f => { if(!f.value.trim()){ f.style.borderColor = '#b05c2a'; } });\n      return;\n    }\n    [name, phone, msg].forEach(f => f.style.borderColor = '');\n    showToast(`Cheers ${name.value.split(' ')[0]} \u2014 we'll ring you back within the hour.`);\n    e.target.reset();\n  });\n</script>\n</body>\n</html>\n"}