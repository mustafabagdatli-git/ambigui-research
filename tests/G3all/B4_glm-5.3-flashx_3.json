{"brief": "B4", "model": "z-ai/glm-5.3-flashx", "i": 3, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Minnow Editions \u2014 Small Poems, Kept Well</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=IBM+Plex+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --paper:#f4efe6;\n    --ink:#1e1a16;\n    --ink-soft:#5c5348;\n    --accent:#9c2b1f;\n    --rule:#d8cfbe;\n  }\n  *{margin:0;padding:0;box-sizing:border-box}\n  html{scroll-behavior:smooth}\n  body{\n    background:var(--paper);\n    color:var(--ink);\n    font-family:'Cormorant Garamond',serif;\n    font-size:19px;\n    line-height:1.6;\n    -webkit-font-smoothing:antialiased;\n  }\n  .mono{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-soft)}\n  a{color:inherit}\n  ::selection{background:var(--accent);color:var(--paper)}\n\n  /* ---------- masthead ---------- */\n  header{\n    display:flex;justify-content:space-between;align-items:baseline;\n    padding:26px 6vw 22px;\n    border-bottom:1px solid var(--rule);\n  }\n  .wordmark{font-size:26px;font-weight:600;letter-spacing:.02em}\n  .wordmark em{color:var(--accent);font-style:italic;font-weight:500}\n  nav{display:flex;gap:34px}\n  nav a{\n    text-decoration:none;position:relative;\n  }\n  nav a::after{\n    content:\"\";position:absolute;left:0;bottom:-4px;height:1px;width:0;\n    background:var(--accent);transition:width .3s ease;\n  }\n  nav a:hover::after{width:100%}\n\n  /* ---------- hero ---------- */\n  .hero{\n    padding:14vh 6vw 12vh;\n    max-width:1100px;\n    position:relative;\n  }\n  .hero .mono{margin-bottom:40px;display:block}\n  h1{\n    font-size:clamp(44px,7.5vw,104px);\n    font-weight:500;\n    line-height:1.05;\n    letter-spacing:-.01em;\n    max-width:14em;\n  }\n  h1 .accent{font-style:italic;color:var(--accent)}\n  .hero-line{margin-top:42px;font-style:italic;font-size:22px;color:var(--ink-soft);max-width:34em}\n  .hero-line .src{font-style:normal;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;margin-left:14px;color:var(--ink-soft);opacity:.7}\n  .hero-cta{margin-top:56px;display:flex;gap:40px;align-items:center;flex-wrap:wrap}\n  .btn{\n    text-decoration:none;border:1px solid var(--ink);\n    padding:14px 30px;font-family:'IBM Plex Mono',monospace;\n    font-size:11px;letter-spacing:.18em;text-transform:uppercase;\n    transition:background .25s,color .25s;\n    display:inline-block;\n  }\n  .btn:hover{background:var(--ink);color:var(--paper)}\n  .btn.solid{background:var(--ink);color:var(--paper)}\n  .btn.solid:hover{background:var(--accent);border-color:var(--accent)}\n\n  /* hero epigraph rotator */\n  #epigraph{transition:opacity .5s ease}\n\n  /* ---------- section scaffolding ---------- */\n  section{padding:100px 6vw}\n  .sec-head{display:flex;align-items:baseline;gap:24px;margin-bottom:64px}\n  .sec-head .num{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.18em;color:var(--accent)}\n  .sec-head h2{font-size:clamp(30px,4vw,48px);font-weight:500;font-style:italic}\n  .sec-head .line{flex:1;height:1px;background:var(--rule)}\n\n  /* ---------- catalog: asymmetric editorial list ---------- */\n  .catalog{border-top:1px solid var(--rule)}\n  .book{\n    display:grid;\n    grid-template-columns:110px 1fr 220px;\n    gap:40px;\n    padding:44px 0;\n    border-bottom:1px solid var(--rule);\n    align-items:baseline;\n    text-decoration:none;\n    transition:background .3s;\n    position:relative;\n  }\n  .book:hover{background:rgba(156,43,31,.04)}\n  .book .no{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.14em;color:var(--ink-soft)}\n  .book h3{font-size:clamp(24px,2.6vw,34px);font-weight:500;line-height:1.2;transition:color .3s}\n  .book:hover h3{color:var(--accent)}\n  .book .meta{font-style:italic;color:var(--ink-soft);font-size:17px;margin-top:6px}\n  .book .spine{\n    justify-self:end;text-align:right;\n  }\n  .book .price{font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.1em}\n  .book .arrow{\n    display:inline-block;margin-left:10px;opacity:0;\n    transform:translateX(-6px);transition:.3s;color:var(--accent);\n  }\n  .book:hover .arrow{opacity:1;transform:translateX(0)}\n  /* small hand-set glyph per title */\n  .glyph{\n    width:44px;height:44px;border:1px solid var(--rule);border-radius:50%;\n    display:flex;align-items:center;justify-content:center;\n    font-size:20px;font-style:italic;color:var(--accent);\n    margin-bottom:10px;\n  }\n\n  /* ---------- manifesto ---------- */\n  .manifesto{\n    background:var(--ink);color:var(--paper);\n  }\n  .manifesto .inner{max-width:820px;margin:0 auto}\n  .manifesto .mono{color:#a89c8d;display:block;margin-bottom:36px}\n  .manifesto p{\n    font-size:clamp(24px,3.2vw,38px);\n    line-height:1.4;font-weight:400;\n  }\n  .manifesto p + p{margin-top:1.2em}\n  .manifesto em{font-style:italic;color:#e5b9a8}\n  .manifesto .sig{margin-top:56px;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:#a89c8d}\n\n  /* reveal on scroll */\n  .reveal{opacity:0;transform:translateY(24px);transition:opacity .8s ease,transform .8s ease}\n  .reveal.in{opacity:1;transform:none}\n\n  /* ---------- broadside / subscription ---------- */\n  .subscribe{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center}\n  .subscribe h2{font-size:clamp(34px,4.5vw,56px);font-weight:500;line-height:1.1}\n  .subscribe h2 em{font-style:italic;color:var(--accent)}\n  .subscribe p{margin-top:24px;color:var(--ink-soft);max-width:34em}\n  .broadside{\n    border:1px solid var(--ink);\n    padding:56px 44px;\n    position:relative;\n    background:var(--paper);\n  }\n  .broadside::before{\n    content:\"\";position:absolute;inset:10px;\n    border:1px solid var(--rule);pointer-events:none;\n  }\n  .broadside .mono{display:block;margin-bottom:26px}\n  .broadside blockquote{\n    font-size:26px;font-style:italic;line-height:1.5;\n  }\n  .broadside .attr{margin-top:22px;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-soft)}\n  .broadside .bbtn{margin-top:36px}\n\n  /* ---------- footer ---------- */\n  footer{\n    border-top:1px solid var(--rule);\n    padding:56px 6vw;\n    display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:20px;\n  }\n  footer .small{font-style:italic;color:var(--ink-soft)}\n\n  @media (max-width:820px){\n    nav{display:none}\n    .book{grid-template-columns:1fr;gap:12px}\n    .book .spine{justify-self:start;text-align:left}\n    .subscribe{grid-template-columns:1fr}\n  }\n</style>\n</head>\n<body>\n\n<header>\n  <div class=\"wordmark\">Minnow <em>Editions</em></div>\n  <nav class=\"mono\">\n    <a href=\"#catalog\">Catalog</a>\n    <a href=\"#about\">About</a>\n    <a href=\"#subscribe\">Broadside Club</a>\n  </nav>\n</header>\n\n<main>\n  <!-- HERO -->\n  <section class=\"hero\">\n    <span class=\"mono\">Est. 2019 \u00b7 Three pamphlets a year \u00b7 Providence, RI</span>\n    <h1>We publish small poems, <span class=\"accent\">kept well.</span></h1>\n    <p class=\"hero-line\"><span id=\"epigraph\">\u201cAttention is the rarest and purest form of generosity.\u201d</span><span class=\"src\" id=\"epigraph-src\">\u2014 Simone Weil</span></p>\n    <div class=\"hero-cta\">\n      <a class=\"btn solid\" href=\"#catalog\">Browse the catalog</a>\n      <a class=\"btn\" href=\"#subscribe\">Join the broadside club</a>\n    </div>\n  </section>\n\n  <!-- CATALOG -->\n  <section id=\"catalog\" class=\"catalog-wrap\">\n    <div class=\"sec-head\">\n      <span class=\"num\">01</span>\n      <h2>Recent Titles</h2>\n      <div class=\"line\"></div>\n    </div>\n\n    <div class=\"catalog\">\n      <a class=\"book reveal\" href=\"#\">\n        <div>\n          <div class=\"glyph\">\u203a</div>\n          <span class=\"no\">No. 14</span>\n        </div>\n        <div>\n          <h3>The Salt Hour</h3>\n          <div class=\"meta\">Poems by Ada Reyes \u00b7 32 pp \u00b7 letterpress cover</div>\n        </div>\n        <div class=\"spine\">\n          <span class=\"price\">$14.00</span><span class=\"arrow\">\u2192</span>\n        </div>\n      </a>\n\n      <a class=\"book reveal\" href=\"#\">\n        <div>\n          <div class=\"glyph\">\u00b7</div>\n          <span class=\"no\">No. 13</span>\n        </div>\n        <div>\n          <h3>Field Notes for a Vanishing Bird</h3>\n          <div class=\"meta\">Poems by Tomas Okafor \u00b7 40 pp \u00b7 sewn binding</div>\n        </div>\n        <div class=\"spine\">\n          <span class=\"price\">$16.00</span><span class=\"arrow\">\u2192</span>\n        </div>\n      </a>\n\n      <a class=\"book reveal\" href=\"#\">\n        <div>\n          <div class=\"glyph\">\u2014</div>\n          <span class=\"no\">No. 12</span>\n        </div>\n        <div>\n          <h3>Winter, Unsolved</h3>\n          <div class=\"meta\">Poems by Marguerite Lin \u00b7 28 pp \u00b7 hand-numbered</div>\n        </div>\n        <div class=\"spine\">\n          <span class=\"price\">$14.00</span><span class=\"arrow\">\u2192</span>\n        </div>\n      </a>\n\n      <a class=\"book reveal\" href=\"#\">\n        <div>\n          <div class=\"glyph\">\u00d7</div>\n          <span class=\"no\">No. 11</span>\n        </div>\n        <div>\n          <h3>Small Gods of the Kitchen</h3>\n          <div class=\"meta\">Poems by R. Elliott Vance \u00b7 36 pp \u00b7 out of print</div>\n        </div>\n        <div class=\"spine\">\n          <span class=\"price\" style=\"color:var(--accent)\">Sold out</span>\n        </div>\n      </a>\n    </div>\n  </section>\n\n  <!-- MANIFESTO -->\n  <section id=\"about\" class=\"manifesto\">\n    <div class=\"inner reveal\">\n      <span class=\"mono\">02 \u00b7 Why we exist</span>\n      <p>We are a press of two people, one letterpress, and a stubborn belief that a poem deserves <em>a body</em> \u2014 paper you can feel, type set with intention, a book light enough to carry into the woods.</p>\n      <p>We print few titles, slowly. Each pamphlet is edited line by line, proofed twice, and sewn by hand in editions of <em>three hundred or fewer</em>. When they\u2019re gone, they\u2019re gone.</p>\n      <div class=\"sig\">\u2014 June Hartley &amp; Sam Oyelaran, editors</div>\n    </div>\n  </section>\n\n  <!-- SUBSCRIBE -->\n  <section id=\"subscribe\">\n    <div class=\"subscribe\">\n      <div class=\"reveal\">\n        <span class=\"mono\" style=\"display:block;margin-bottom:28px\">03 \u00b7 Broadside Club</span>\n        <h2>One poem, printed beautifully, <em>four times a year.</em></h2>\n        <p>Members receive a letterpress broadside each season \u2014 a single poem, set by hand on cotton paper, signed by the poet \u2014 plus first refusal on all pamphlets before they sell out.</p>\n        <p style=\"margin-top:16px\"><strong>$40 / year.</strong> Editions of 150. No renewals held over.</p>\n        <a class=\"btn solid\" href=\"#\" style=\"margin-top:36px\">Join the club</a>\n      </div>\n\n      <div class=\"broadside reveal\">\n        <span class=\"mono\">Broadside \u2116 23 \u00b7 Spring</span>\n        <blockquote>\n          \u201cwhat the tide takes<br>\n          it takes politely \u2014<br>\n          a chair, a name,<br>\n          the shape of a door\u201d\n        </blockquote>\n        <div class=\"attr\">\u2014 from \u201cErosion,\u201d Ada Reyes</div>\n        <a class=\"btn bbtn\" href=\"#\">See past broadsides</a>\n      </div>\n    </div>\n  </section>\n</main>\n\n<footer>\n  <div class=\"wordmark\" style=\"font-size:20px\">Minnow <em>Editions</em></div>\n  <div class=\"small\">Submissions open each January, post only.</div>\n  <div class=\"mono\">hello@minnoweditions.press</div>\n</footer>\n\n<script>\n  // rotating epigraph\n  const lines = [\n    [\"\u201cAttention is the rarest and purest form of generosity.\u201d\",\"\u2014 Simone Weil\"],\n    [\"\u201cPoetry is language against which we have no defenses.\u201d\",\"\u2014 after Frost\"],\n    [\"\u201cA little fish is better than an empty dish.\u201d\",\"\u2014 Proverb\"],\n    [\"\u201cMake it simple, but significant.\u201d\",\"\u2014 attributed to Don Draper's better angels\"]\n  ];\n  const el = document.getElementById('epigraph');\n  const src = document.getElementById('epigraph-src');\n  let i = 0;\n  setInterval(() => {\n    el.style.opacity = 0; src.style.opacity = 0;\n    setTimeout(() => {\n      i = (i + 1) % lines.length;\n      el.textContent = lines[i][0];\n      src.textContent = lines[i][1];\n      el.style.opacity = 1; src.style.opacity = 1;\n    }, 500);\n  }, 6000);\n\n  // scroll reveal\n  const io = new IntersectionObserver(entries => {\n    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });\n  }, { threshold: 0.15 });\n  document.querySelectorAll('.reveal').forEach(el => io.observe(el));\n</script>\n\n</body>\n</html>\n"}