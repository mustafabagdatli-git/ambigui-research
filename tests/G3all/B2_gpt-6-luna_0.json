{"brief": "B2", "model": "openai/gpt-6-luna", "i": 0, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#f7f7ef\">\n  <title>WonderLab \u2014 Big discoveries for little scientists</title>\n  <style>\n    :root {\n      --ink: #172b4d;\n      --muted: #5d6b80;\n      --paper: #f7f7ef;\n      --white: #fff;\n      --coral: #ff695b;\n      --yellow: #ffd45e;\n      --mint: #8edcc3;\n      --blue: #79b9f2;\n      --purple: #b5a0ef;\n      --line: rgba(23, 43, 77, .12);\n      --shadow: 0 18px 45px rgba(23, 43, 77, .11);\n      --round: 24px;\n    }\n\n    * { box-sizing: border-box; }\n\n    html { scroll-behavior: smooth; }\n\n    body {\n      margin: 0;\n      color: var(--ink);\n      background: var(--paper);\n      font-family: ui-rounded, \"Avenir Next\", Avenir, \"Segoe UI\", sans-serif;\n      line-height: 1.5;\n    }\n\n    a { color: inherit; text-decoration: none; }\n\n    button, a { -webkit-tap-highlight-color: transparent; }\n\n    .wrap {\n      width: min(1160px, calc(100% - 48px));\n      margin: 0 auto;\n    }\n\n    .announcement {\n      padding: 10px 20px;\n      background: var(--ink);\n      color: white;\n      text-align: center;\n      font-size: .82rem;\n      letter-spacing: .02em;\n    }\n\n    .announcement strong { color: var(--yellow); }\n    .announcement a { text-decoration: underline; text-underline-offset: 3px; }\n\n    header {\n      position: relative;\n      z-index: 3;\n      background: var(--paper);\n    }\n\n    nav {\n      min-height: 82px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 28px;\n    }\n\n    .brand {\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      font-size: 1.35rem;\n      font-weight: 900;\n      letter-spacing: -.06em;\n    }\n\n    .brand-mark {\n      width: 36px;\n      height: 36px;\n      display: grid;\n      place-items: center;\n      border-radius: 12px;\n      background: var(--coral);\n      color: white;\n      transform: rotate(-7deg);\n    }\n\n    .brand-mark svg { width: 23px; height: 23px; }\n\n    .nav-links {\n      display: flex;\n      align-items: center;\n      gap: 30px;\n      color: var(--muted);\n      font-size: .92rem;\n      font-weight: 700;\n    }\n\n    .nav-links a:hover { color: var(--coral); }\n\n    .button {\n      display: inline-flex;\n      justify-content: center;\n      align-items: center;\n      gap: 9px;\n      min-height: 49px;\n      padding: 0 21px;\n      border: 0;\n      border-radius: 999px;\n      background: var(--ink);\n      color: white;\n      font: inherit;\n      font-weight: 800;\n      transition: transform .2s ease, box-shadow .2s ease;\n    }\n\n    .button:hover {\n      transform: translateY(-2px);\n      box-shadow: 0 9px 20px rgba(23, 43, 77, .18);\n    }\n\n    .button-light {\n      background: white;\n      color: var(--ink);\n      box-shadow: 0 8px 18px rgba(23, 43, 77, .1);\n    }\n\n    .button svg { width: 17px; height: 17px; }\n\n    .hero {\n      position: relative;\n      overflow: hidden;\n      padding: 56px 0 74px;\n    }\n\n    .hero-grid {\n      display: grid;\n      grid-template-columns: 1fr 1.05fr;\n      align-items: center;\n      gap: 40px;\n    }\n\n    .eyebrow {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      margin: 0 0 17px;\n      color: #397d70;\n      font-size: .78rem;\n      font-weight: 900;\n      letter-spacing: .12em;\n      text-transform: uppercase;\n    }\n\n    .eyebrow::before {\n      content: \"\";\n      width: 22px;\n      height: 3px;\n      border-radius: 3px;\n      background: var(--coral);\n    }\n\n    h1, h2, h3, p { margin-top: 0; }\n\n    h1 {\n      max-width: 580px;\n      margin-bottom: 20px;\n      font-size: clamp(3.3rem, 6vw, 5.4rem);\n      line-height: .98;\n      letter-spacing: -.075em;\n    }\n\n    h1 span {\n      position: relative;\n      white-space: nowrap;\n    }\n\n    h1 span::after {\n      content: \"\";\n      position: absolute;\n      z-index: -1;\n      left: -3px;\n      right: -4px;\n      bottom: 5px;\n      height: 15px;\n      border-radius: 20px;\n      background: var(--yellow);\n      transform: rotate(-2deg);\n    }\n\n    .hero-copy > p {\n      max-width: 460px;\n      margin-bottom: 28px;\n      color: var(--muted);\n      font-size: 1.1rem;\n    }\n\n    .hero-actions {\n      display: flex;\n      flex-wrap: wrap;\n      align-items: center;\n      gap: 13px;\n    }\n\n    .text-link {\n      display: inline-flex;\n      align-items: center;\n      gap: 7px;\n      padding: 10px 6px;\n      font-size: .92rem;\n      font-weight: 800;\n    }\n\n    .text-link:hover { color: #d64e43; }\n\n    .hero-art {\n      position: relative;\n      min-height: 445px;\n      display: grid;\n      place-items: center;\n    }\n\n    .art-blob {\n      position: absolute;\n      width: min(100%, 500px);\n      aspect-ratio: 1 / .83;\n      border-radius: 48% 52% 42% 58% / 52% 43% 57% 48%;\n      background: #d8f0e8;\n      transform: rotate(-5deg);\n    }\n\n    .hero-art svg {\n      position: relative;\n      z-index: 1;\n      width: 100%;\n      max-width: 540px;\n      height: auto;\n      overflow: visible;\n    }\n\n    .float-note {\n      position: absolute;\n      z-index: 2;\n      display: flex;\n      align-items: center;\n      gap: 9px;\n      padding: 11px 15px;\n      border: 2px solid var(--ink);\n      border-radius: 15px;\n      background: white;\n      box-shadow: 4px 5px 0 var(--ink);\n      font-size: .83rem;\n      font-weight: 900;\n      transform: rotate(-4deg);\n    }\n\n    .float-note.one { top: 14%; right: 0; }\n    .float-note.two { bottom: 14%; left: -2%; transform: rotate(4deg); }\n    .float-note span { font-size: 1.3rem; }\n\n    .spark {\n      position: absolute;\n      color: var(--coral);\n      font-size: 2.4rem;\n      font-weight: 900;\n    }\n    .spark.a { top: 13%; left: 9%; transform: rotate(-15deg); }\n    .spark.b { right: 5%; bottom: 24%; color: #e8a926; font-size: 1.7rem; }\n\n    .quick-info {\n      position: relative;\n      z-index: 2;\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 1px;\n      margin-top: 12px;\n      overflow: hidden;\n      border: 1px solid var(--line);\n      border-radius: 19px;\n      background: var(--line);\n      box-shadow: 0 10px 30px rgba(23, 43, 77, .05);\n    }\n\n    .quick-info a {\n      display: flex;\n      align-items: center;\n      gap: 13px;\n      padding: 18px 22px;\n      background: white;\n      transition: background .2s ease;\n    }\n\n    .quick-info a:hover { background: #fff9e8; }\n    .info-icon { font-size: 1.45rem; }\n    .quick-info strong { display: block; font-size: .91rem; }\n    .quick-info small { display: block; color: var(--muted); font-size: .78rem; }\n\n    section { padding: 78px 0; }\n\n    .section-heading {\n      display: flex;\n      align-items: end;\n      justify-content: space-between;\n      gap: 24px;\n      margin-bottom: 30px;\n    }\n\n    .section-heading h2 {\n      max-width: 550px;\n      margin-bottom: 0;\n      font-size: clamp(2rem, 4vw, 3.1rem);\n      line-height: 1.05;\n      letter-spacing: -.06em;\n    }\n\n    .section-heading p {\n      max-width: 360px;\n      margin-bottom: 3px;\n      color: var(--muted);\n    }\n\n    .exhibits { background: white; }\n\n    .exhibit-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 20px;\n    }\n\n    .exhibit-card {\n      min-height: 325px;\n      padding: 23px;\n      overflow: hidden;\n      border-radius: var(--round);\n      transition: transform .2s ease;\n    }\n\n    .exhibit-card:hover { transform: translateY(-5px); }\n    .exhibit-card:nth-child(1) { background: #fff1d2; }\n    .exhibit-card:nth-child(2) { background: #e5f4f0; }\n    .exhibit-card:nth-child(3) { background: #eee9ff; }\n\n    .exhibit-visual {\n      height: 155px;\n      display: grid;\n      place-items: center;\n      margin: -1px -2px 17px;\n      border-radius: 17px;\n      background: rgba(255,255,255,.45);\n      font-size: 5rem;\n    }\n\n    .exhibit-card h3 {\n      margin-bottom: 7px;\n      font-size: 1.25rem;\n      letter-spacing: -.035em;\n    }\n\n    .exhibit-card p {\n      margin-bottom: 14px;\n      color: var(--muted);\n      font-size: .9rem;\n    }\n\n    .card-link {\n      display: inline-flex;\n      align-items: center;\n      gap: 6px;\n      font-size: .85rem;\n      font-weight: 900;\n    }\n\n    .card-link:hover { color: #d64e43; }\n\n    .visit {\n      padding: 82px 0;\n      background: var(--ink);\n      color: white;\n    }\n\n    .visit-grid {\n      display: grid;\n      grid-template-columns: 1.05fr .95fr;\n      align-items: center;\n      gap: 55px;\n    }\n\n    .visit .eyebrow { color: var(--mint); }\n    .visit h2 {\n      max-width: 520px;\n      margin-bottom: 16px;\n      font-size: clamp(2.4rem, 4.5vw, 3.9rem);\n      line-height: 1;\n      letter-spacing: -.065em;\n    }\n\n    .visit-copy > p {\n      max-width: 460px;\n      margin-bottom: 26px;\n      color: #c2ccdc;\n    }\n\n    .visit-details {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 16px;\n      padding: 26px;\n      border: 1px solid rgba(255,255,255,.16);\n      border-radius: var(--round);\n      background: rgba(255,255,255,.06);\n    }\n\n    .detail {\n      padding: 8px 0;\n    }\n\n    .detail strong {\n      display: block;\n      margin-bottom: 4px;\n      color: var(--yellow);\n      font-size: .76rem;\n      letter-spacing: .09em;\n      text-transform: uppercase;\n    }\n\n    .detail span { color: #e5ebf4; font-size: .92rem; }\n\n    .note-card {\n      padding: 30px;\n      border-radius: var(--round);\n      background: var(--yellow);\n      color: var(--ink);\n      transform: rotate(2deg);\n      box-shadow: 10px 12px 0 rgba(0,0,0,.17);\n    }\n\n    .note-card .note-icon { font-size: 2.5rem; }\n    .note-card h3 {\n      margin: 12px 0 8px;\n      font-size: 1.65rem;\n      line-height: 1.08;\n      letter-spacing: -.05em;\n    }\n    .note-card p { margin-bottom: 18px; color: #46546a; }\n\n    .events { background: #f7f7ef; }\n\n    .event-card {\n      display: grid;\n      grid-template-columns: 150px 1fr auto;\n      align-items: center;\n      gap: 25px;\n      padding: 23px;\n      border: 1px solid var(--line);\n      border-radius: var(--round);\n      background: white;\n      box-shadow: 0 8px 25px rgba(23, 43, 77, .05);\n    }\n\n    .event-date {\n      display: grid;\n      place-items: center;\n      min-height: 125px;\n      border-radius: 17px;\n      background: #ffe5df;\n      color: var(--coral);\n      text-align: center;\n      font-weight: 900;\n      line-height: 1;\n    }\n\n    .event-date strong { font-size: 2.8rem; letter-spacing: -.08em; }\n    .event-date span { font-size: .78rem; letter-spacing: .13em; text-transform: uppercase; }\n    .event-info small {\n      color: #c45a4e;\n      font-size: .77rem;\n      font-weight: 900;\n      letter-spacing: .1em;\n      text-transform: uppercase;\n    }\n    .event-info h3 {\n      margin: 7px 0;\n      font-size: 1.45rem;\n      letter-spacing: -.04em;\n    }\n    .event-info p { margin: 0; color: var(--muted); font-size: .9rem; }\n\n    footer {\n      padding: 36px 0;\n      border-top: 1px solid var(--line);\n      background: white;\n    }\n\n    .footer-row {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 25px;\n    }\n\n    .footer-row p { margin: 8px 0 0; color: var(--muted); font-size: .83rem; }\n    .footer-links { display: flex; flex-wrap: wrap; gap: 22px; color: var(--muted); font-size: .85rem; font-weight: 700; }\n    .footer-links a:hover { color: var(--coral); }\n\n    @media (max-width: 850px) {\n      .nav-links { gap: 16px; }\n      .nav-links a:not(.button) { display: none; }\n      .hero-grid { grid-template-columns: 1fr; gap: 5px; }\n      .hero-copy { padding-top: 18px; }\n      .hero-art { min-height: 390px; }\n      .quick-info a { padding: 15px; }\n      .visit-grid { gap: 35px; }\n      .event-card { grid-template-columns: 115px 1fr; }\n      .event-card > .button { grid-column: 2; justify-self: start; }\n      .event-date { grid-row: span 2; }\n    }\n\n    @media (max-width: 620px) {\n      .wrap { width: min(100% - 32px, 520px); }\n      .announcement { font-size: .73rem; }\n      nav { min-height: 70px; }\n      .brand { font-size: 1.2rem; }\n      nav > .button { min-height: 42px; padding: 0 15px; font-size: .83rem; }\n      .hero { padding: 30px 0 54px; }\n      h1 { font-size: clamp(3rem, 14vw, 4.2rem); }\n      .hero-copy > p { font-size: 1rem; }\n      .hero-art { min-height: 310px; margin: 0 -10px; }\n      .float-note { padding: 8px 11px; font-size: .72rem; }\n      .float-note.one { right: 1%; }\n      .float-note.two { left: 0; }\n      .quick-info { grid-template-columns: 1fr; }\n      .quick-info a { padding: 12px 18px; }\n      section { padding: 58px 0; }\n      .section-heading { align-items: start; flex-direction: column; gap: 12px; }\n      .exhibit-grid { grid-template-columns: 1fr; }\n      .exhibit-card { min-height: auto; }\n      .exhibit-visual { height: 145px; }\n      .visit-grid { grid-template-columns: 1fr; }\n      .visit-details { padding: 19px; }\n      .note-card { max-width: 430px; transform: rotate(1deg); }\n      .event-card { grid-template-columns: 78px 1fr; gap: 15px; padding: 15px; }\n      .event-date { min-height: 100px; }\n      .event-date strong { font-size: 2.1rem; }\n      .event-info h3 { font-size: 1.18rem; }\n      .event-info p { font-size: .82rem; }\n      .event-card > .button { grid-column: 1 / -1; justify-self: stretch; }\n      .footer-row { align-items: start; flex-direction: column; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"announcement\">\n    <strong>Curiosity looks good on you.</strong> Weekend tickets are going fast \u2014\n    <a href=\"#tickets\">plan your visit</a>\n  </div>\n\n  <header>\n    <nav class=\"wrap\" aria-label=\"Main navigation\">\n      <a class=\"brand\" href=\"#\" aria-label=\"WonderLab home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M12 2.5 14.7 9l6.8 3-6.8 2.8L12 21.5l-2.8-6.7L2.5 12l6.7-3L12 2.5Z\" fill=\"currentColor\"/>\n            <circle cx=\"18.5\" cy=\"5.5\" r=\"1.5\" fill=\"#FFD45E\"/>\n          </svg>\n        </span>\n        wonderlab\n      </a>\n      <div class=\"nav-links\">\n        <a href=\"#exhibits\">Explore</a>\n        <a href=\"#visit\">Plan your visit</a>\n        <a href=\"#events\">What's on</a>\n        <a class=\"button\" href=\"#tickets\">Get tickets <span aria-hidden=\"true\">\u2197</span></a>\n      </div>\n    </nav>\n  </header>\n\n  <main>\n    <section class=\"hero\">\n      <div class=\"wrap\">\n        <div class=\"hero-grid\">\n          <div class=\"hero-copy\">\n            <p class=\"eyebrow\">A hands-on science adventure</p>\n            <h1>Big ideas.<br>Little <span>explorers.</span></h1>\n            <p>Make a spectacular mess, ask a million questions, and discover just how amazing the world can be.</p>\n            <div class=\"hero-actions\">\n              <a class=\"button\" href=\"#tickets\">Plan your visit <span aria-hidden=\"true\">\u2192</span></a>\n              <a class=\"text-link\" href=\"#exhibits\">See what you can do <span aria-hidden=\"true\">\u2193</span></a>\n            </div>\n          </div>\n\n          <div class=\"hero-art\" aria-label=\"Colorful illustration of a bubbling science experiment\">\n            <div class=\"art-blob\"></div>\n            <span class=\"spark a\" aria-hidden=\"true\">\u2733</span>\n            <span class=\"spark b\" aria-hidden=\"true\">\u2726</span>\n            <div class=\"float-note one\"><span aria-hidden=\"true\">\ud83e\uddea</span> Experiment freely!</div>\n            <div class=\"float-note two\"><span aria-hidden=\"true\">\ud83e\ude90</span> Ages 2\u201312</div>\n            <svg viewBox=\"0 0 540 430\" role=\"img\" aria-labelledby=\"artTitle\">\n              <title id=\"artTitle\">A happy little scientist discovering a colorful bubbling experiment</title>\n              <ellipse cx=\"276\" cy=\"385\" rx=\"172\" ry=\"18\" fill=\"#B6DED2\"/>\n              <path d=\"M379 111c42-25 91 1 89 35-2 29-33 38-57 24-19-11-17-36-32-59Z\" fill=\"#FFD45E\"/>\n              <circle cx=\"444\" cy=\"86\" r=\"7\" fill=\"#FF695B\"/>\n              <circle cx=\"422\" cy=\"60\" r=\"4\" fill=\"#79B9F2\"/>\n              <path d=\"M81 139c-21-15-11-45 11-44 18 1 18 22 6 31-7 5-12 9-17 13Z\" fill=\"#B5A0EF\"/>\n              <path d=\"M115 99c-11-9-5-25 7-24 10 1 10 12 4 17-4 3-7 5-11 7Z\" fill=\"#FF695B\"/>\n              <g stroke=\"#172B4D\" stroke-width=\"7\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                <path d=\"M196 143c-2-40 26-68 66-68 39 0 69 30 67 71l-8 56H207l-11-59Z\" fill=\"#FFD8BD\"/>\n                <path d=\"M198 139c7-39 29-58 68-58 28 0 51 13 61 42-18-3-33-15-41-27-16 20-46 34-88 43Z\" fill=\"#172B4D\"/>\n                <path d=\"M219 200c-26 14-42 45-43 92l-9 71c-2 15 9 28 24 28h135c16 0 26-14 23-29l-12-72c-5-41-22-74-48-90l-70 0Z\" fill=\"#FF695B\"/>\n                <path d=\"M227 198c14 20 44 26 67 2l8 19c-18 24-59 29-82 2l7-23Z\" fill=\"#FFFFFF\"/>\n                <path d=\"M186 257c-30 7-48 27-52 54-2 13 6 23 18 23 10 0 16-7 19-18l15-23\" fill=\"#FFD8BD\"/>\n                <path d=\"M332 252c24 5 44 21 56 44 7 13 1 25-12 26-10 1-17-6-21-16l-21-25\" fill=\"#FFD8BD\"/>\n                <path d=\"M218 383v26h-44c-11 0-16-13-7-20l20-15\" fill=\"#172B4D\"/>\n                <path d=\"M298 383v26h46c11 0 16-13 7-20l-22-16\" fill=\"#172B4D\"/>\n                <path d=\"M256 123c-2-7 2-12 8-12 5 0 9 5 7 12\" fill=\"none\"/>\n                <path d=\"M303 123c-2-7 2-12 8-12 5 0 9 5 7 12\" fill=\"none\"/>\n                <path d=\"M269 147c10 10 23 10 33-1\" fill=\"none\"/>\n              </g>\n              <path d=\"M244 217 268 267l27-50\" fill=\"#FFF1D2\" stroke=\"#172B4D\" stroke-width=\"6\" stroke-linejoin=\"round\"/>\n              <path d=\"M280 254c-12 19-29 49-15 64 14 14 53 5 62-10 6-11-12-34-23-51\" fill=\"#79B9F2\" stroke=\"#172B4D\" stroke-width=\"6\" stroke-linejoin=\"round\"/>\n              <path d=\"M264 296c19 8 43 7 57-1\" fill=\"none\" stroke=\"#172B4D\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n              <circle cx=\"285\" cy=\"278\" r=\"5\" fill=\"#FFFFFF\"/>\n              <circle cx=\"299\" cy=\"287\" r=\"3\" fill=\"#FFFFFF\"/>\n              <path d=\"M370 207c17-18 40-15 44 0 4 15-13 22-24 17-8-4-13-9-20-17Z\" fill=\"#8EDCC3\" stroke=\"#172B4D\" stroke-width=\"5\"/>\n              <path d=\"M147 168c-12-15-7-33 7-35 13-2 20 13 13 23-5 7-12 9-20 12Z\" fill=\"#79B9F2\"/>\n              <path d=\"M379 303c11-12 27-10 30 2 3 11-10 17-18 13-5-3-8-8-12-15Z\" fill=\"#B5A0EF\"/>\n            </svg>\n          </div>\n        </div>\n\n        <div class=\"quick-info\" aria-label=\"Visitor highlights\">\n          <a href=\"#visit\">\n            <span class=\"info-icon\" aria-hidden=\"true\">\ud83d\udd52</span>\n            <span><strong>Open every day</strong><small>10am\u20135pm, wonder waits!</small></span>\n          </a>\n          <a href=\"#tickets\">\n            <span class=\"info-icon\" aria-hidden=\"true\">\ud83c\udf9f\ufe0f</span>\n            <span><strong>From $12 per person</strong><small>Little ones under 2 visit free</small></span>\n          </a>\n          <a href=\"#visit\">\n            <span class=\"info-icon\" aria-hidden=\"true\">\ud83d\udccd</span>\n            <span><strong>Right in the city</strong><small>Easy to get to, hard to leave</small></span>\n          </a>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"exhibits\" id=\"exhibits\">\n      <div class=\"wrap\">\n        <div class=\"section-heading\">\n          <div>\n            <p class=\"eyebrow\">Come play with a big idea</p>\n            <h2>Curiosity is the main attraction.</h2>\n          </div>\n          <p>Every corner is made for trying, building, wondering, and doing it all over again.</p>\n        </div>\n\n        <div class=\"exhibit-grid\">\n          <article class=\"exhibit-card\">\n            <div class=\"exhibit-visual\" aria-hidden=\"true\">\ud83c\udf2a\ufe0f</div>\n            <h3>Wind Works</h3>\n            <p>Build a flying machine and see where the breeze takes it.</p>\n            <a class=\"card-link\" href=\"#visit\">Explore the exhibit <span aria-hidden=\"true\">\u2192</span></a>\n          </article>\n          <article class=\"exhibit-card\">\n            <div class=\"exhibit-visual\" aria-hidden=\"true\">\ud83e\udee7</div>\n            <h3>Bubble Universe</h3>\n            <p>Step inside a world of giant bubbles, color, and surface tension.</p>\n            <a class=\"card-link\" href=\"#visit\">Explore the exhibit <span aria-hidden=\"true\">\u2192</span></a>\n          </article>\n          <article class=\"exhibit-card\">\n            <div class=\"exhibit-visual\" aria-hidden=\"true\">\ud83e\uddb4</div>\n            <h3>Dino Detectives</h3>\n            <p>Grab a brush, uncover ancient clues, and meet a giant or two.</p>\n            <a class=\"card-link\" href=\"#visit\">Explore the exhibit <span aria-hidden=\"true\">\u2192</span></a>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"visit\" id=\"visit\">\n      <div class=\"wrap visit-grid\">\n        <div class=\"visit-copy\">\n          <p class=\"eyebrow\">Your next great day out</p>\n          <h2>Come curious.<br>Leave amazed.</h2>\n          <p>There\u2019s space to roam, room to make a mess, and something new to discover around every corner. Bring the whole crew!</p>\n          <a class=\"button button-light\" href=\"#tickets\">Get tickets <span aria-hidden=\"true\">\u2197</span></a>\n        </div>\n\n        <div class=\"visit-details\" aria-label=\"Museum information\">\n          <div class=\"detail\">\n            <strong>Find us</strong>\n            <span>42 Discovery Lane<br>Brighton, MA 02135</span>\n          </div>\n          <div class=\"detail\">\n            <strong>We're open</strong>\n            <span>Daily, 10am\u20135pm<br>Last entry at 4pm</span>\n          </div>\n          <div class=\"detail\">\n            <strong>Getting here</strong>\n            <span>Green Line, B branch<br>Free bike parking</span>\n          </div>\n          <div class=\"detail\">\n            <strong>Good to know</strong>\n            <span>Stroller friendly<br>Caf\u00e9 & family restrooms</span>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"events\" id=\"events\">\n      <div class=\"wrap\">\n        <div class=\"section-heading\">\n          <div>\n            <p class=\"eyebrow\">Mark your calendar</p>\n            <h2>Something special is bubbling up.</h2>\n          </div>\n          <a class=\"text-link\" href=\"#tickets\">All events <span aria-hidden=\"true\">\u2192</span></a>\n        </div>\n\n        <article class=\"event-card\">\n          <div class=\"event-date\" aria-label=\"Saturday, June 14\">\n            <span>Jun</span>\n            <strong>14</strong>\n          </div>\n          <div class=\"event-info\">\n            <small>Saturday \u00b7 11am\u20131pm</small>\n            <h3>Slime Time: The Great Goo Lab</h3>\n            <p>Mix, stretch, and squish your way through our most delightfully gooey workshop.</p>\n     