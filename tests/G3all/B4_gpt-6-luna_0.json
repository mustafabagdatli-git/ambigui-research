{"brief": "B4", "model": "openai/gpt-6-luna", "i": 0, "finish": "stop", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#f5f1e8\">\n  <title>Fieldnote Poetry \u2014 Small books, big feeling</title>\n  <style>\n    :root {\n      --paper: #f5f1e8;\n      --ink: #20332c;\n      --muted: #68756c;\n      --green: #315443;\n      --coral: #d86b51;\n      --line: #dcd7ca;\n      --serif: Georgia, \"Times New Roman\", serif;\n      --sans: \"Helvetica Neue\", Helvetica, Arial, sans-serif;\n    }\n\n    * { box-sizing: border-box; }\n\n    html { scroll-behavior: smooth; }\n\n    body {\n      margin: 0;\n      color: var(--ink);\n      background: var(--paper);\n      font-family: var(--sans);\n      -webkit-font-smoothing: antialiased;\n    }\n\n    a { color: inherit; }\n\n    .page-shell {\n      width: min(1200px, calc(100% - 64px));\n      margin: 0 auto;\n    }\n\n    .site-header {\n      min-height: 88px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      border-bottom: 1px solid var(--line);\n    }\n\n    .wordmark {\n      display: flex;\n      align-items: center;\n      gap: 11px;\n      color: var(--ink);\n      text-decoration: none;\n      font-size: 13px;\n      font-weight: 750;\n      letter-spacing: .12em;\n      text-transform: uppercase;\n    }\n\n    .mark {\n      width: 31px;\n      height: 31px;\n      display: grid;\n      place-items: center;\n      color: var(--paper);\n      background: var(--green);\n      border-radius: 50% 50% 50% 2px;\n      font-family: var(--serif);\n      font-size: 19px;\n      font-weight: 400;\n      letter-spacing: 0;\n    }\n\n    .nav-links {\n      display: flex;\n      align-items: center;\n      gap: 35px;\n      font-size: 13px;\n    }\n\n    .nav-links a {\n      text-decoration: none;\n      color: #45534b;\n    }\n\n    .nav-links a:hover { color: var(--coral); }\n\n    .nav-links .nav-cta {\n      padding: 12px 17px;\n      border: 1px solid var(--ink);\n      border-radius: 2px;\n      color: var(--ink);\n      transition: background .2s, color .2s;\n    }\n\n    .nav-links .nav-cta:hover {\n      color: var(--paper);\n      background: var(--ink);\n    }\n\n    .hero {\n      min-height: 600px;\n      display: grid;\n      grid-template-columns: 1.08fr .92fr;\n      align-items: center;\n      gap: 64px;\n      padding: 76px 0 82px;\n    }\n\n    .eyebrow {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      margin: 0 0 24px;\n      color: var(--green);\n      font-size: 11px;\n      font-weight: 700;\n      letter-spacing: .16em;\n      text-transform: uppercase;\n    }\n\n    .eyebrow::before {\n      content: \"\";\n      display: inline-block;\n      width: 24px;\n      height: 1px;\n      background: var(--coral);\n    }\n\n    h1, h2, h3, p { margin-top: 0; }\n\n    h1 {\n      max-width: 640px;\n      margin-bottom: 24px;\n      font-family: var(--serif);\n      font-size: clamp(54px, 7.2vw, 91px);\n      font-weight: 400;\n      letter-spacing: -.065em;\n      line-height: .98;\n    }\n\n    h1 em {\n      color: var(--coral);\n      font-weight: 400;\n    }\n\n    .hero-copy {\n      max-width: 440px;\n      margin-bottom: 30px;\n      color: #58665d;\n      font-family: var(--serif);\n      font-size: 19px;\n      line-height: 1.65;\n    }\n\n    .button {\n      min-height: 48px;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: 18px;\n      padding: 0 19px;\n      border: 1px solid var(--green);\n      border-radius: 2px;\n      color: white;\n      background: var(--green);\n      font-size: 12px;\n      font-weight: 700;\n      letter-spacing: .04em;\n      text-decoration: none;\n      transition: transform .2s, background .2s;\n    }\n\n    .button:hover {\n      transform: translateY(-2px);\n      background: #243f32;\n    }\n\n    .button .arrow { font-size: 17px; line-height: 1; }\n\n    .hero-note {\n      display: inline-block;\n      margin: 0 0 0 17px;\n      color: var(--muted);\n      font-family: var(--serif);\n      font-size: 13px;\n      font-style: italic;\n    }\n\n    .hero-art {\n      min-height: 412px;\n      position: relative;\n      display: grid;\n      place-items: center;\n    }\n\n    .sun {\n      width: 340px;\n      height: 340px;\n      position: absolute;\n      top: 20px;\n      right: 25px;\n      border: 1px solid #d8cdb9;\n      border-radius: 50%;\n    }\n\n    .sun::before, .sun::after {\n      content: \"\";\n      position: absolute;\n      border: 1px solid #e2d8c8;\n      border-radius: 50%;\n    }\n\n    .sun::before { inset: 22px; }\n    .sun::after { inset: 45px; }\n\n    .little-star {\n      position: absolute;\n      top: 48px;\n      right: 62px;\n      color: var(--coral);\n      font-size: 28px;\n    }\n\n    .book {\n      width: 255px;\n      height: 355px;\n      position: relative;\n      z-index: 1;\n      overflow: hidden;\n      padding: 27px 25px;\n      box-shadow: 16px 19px 35px #263c2a24, 2px 2px 0 #fff7e9;\n      transform: rotate(-4deg);\n    }\n\n    .book::after {\n      content: \"\";\n      width: 30px;\n      position: absolute;\n      inset: 0 auto 0 0;\n      background: linear-gradient(90deg, #0000001d, transparent);\n    }\n\n    .book-feature {\n      color: #f5eddb;\n      background: #bd5c48;\n    }\n\n    .book-kicker {\n      display: block;\n      margin: 0 0 35px;\n      font-size: 9px;\n      font-weight: 700;\n      letter-spacing: .19em;\n      text-transform: uppercase;\n    }\n\n    .book-title {\n      margin: 0;\n      font-family: var(--serif);\n      font-size: 41px;\n      font-weight: 400;\n      letter-spacing: -.055em;\n      line-height: .94;\n    }\n\n    .book-title em { font-weight: 400; }\n\n    .cover-illustration {\n      width: 108px;\n      height: 108px;\n      position: absolute;\n      right: 21px;\n      bottom: 73px;\n      border: 1px solid #f5eddb9c;\n      border-radius: 50%;\n    }\n\n    .cover-illustration::before,\n    .cover-illustration::after {\n      content: \"\";\n      position: absolute;\n      border: 1px solid #f5eddb9c;\n      border-radius: 50%;\n      transform: rotate(-30deg) scaleX(.45);\n    }\n\n    .cover-illustration::before { inset: -1px 32px; }\n    .cover-illustration::after { inset: 30px -1px; }\n\n    .book-author {\n      position: absolute;\n      bottom: 23px;\n      left: 25px;\n      margin: 0;\n      font-size: 9px;\n      font-weight: 700;\n      letter-spacing: .15em;\n      text-transform: uppercase;\n    }\n\n    .art-caption {\n      position: absolute;\n      right: 0;\n      bottom: 19px;\n      color: var(--muted);\n      font-family: var(--serif);\n      font-size: 12px;\n      font-style: italic;\n      transform: rotate(-5deg);\n    }\n\n    .section-rule {\n      border-top: 1px solid var(--line);\n    }\n\n    .catalogue {\n      padding: 76px 0 92px;\n    }\n\n    .section-heading {\n      display: flex;\n      align-items: end;\n      justify-content: space-between;\n      gap: 30px;\n      margin-bottom: 39px;\n    }\n\n    .section-heading .eyebrow { margin-bottom: 13px; }\n\n    h2 {\n      margin-bottom: 0;\n      font-family: var(--serif);\n      font-size: clamp(38px, 5vw, 57px);\n      font-weight: 400;\n      letter-spacing: -.055em;\n      line-height: 1;\n    }\n\n    .text-link {\n      padding-bottom: 5px;\n      color: var(--green);\n      font-size: 12px;\n      font-weight: 700;\n      text-decoration: none;\n      border-bottom: 1px solid #8c9b8e;\n    }\n\n    .text-link span { margin-left: 8px; }\n\n    .books-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 25px;\n    }\n\n    .book-card { min-width: 0; }\n\n    .mini-cover {\n      height: 320px;\n      position: relative;\n      display: grid;\n      place-items: center;\n      overflow: hidden;\n      margin-bottom: 21px;\n    }\n\n    .mini-cover-inner {\n      width: 190px;\n      height: 265px;\n      position: relative;\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      padding: 23px 20px;\n      box-shadow: 9px 12px 24px #263c2a21;\n      transition: transform .25s;\n    }\n\n    .book-card:hover .mini-cover-inner { transform: translateY(-5px) rotate(-1deg); }\n\n    .cover-one { background: #d9b978; }\n    .cover-two { background: #657e70; color: #f5f1e8; }\n    .cover-three { background: #d9d3c4; }\n\n    .mini-cover-inner small {\n      font-size: 8px;\n      font-weight: 700;\n      letter-spacing: .16em;\n      text-transform: uppercase;\n    }\n\n    .mini-cover-inner strong {\n      max-width: 145px;\n      font-family: var(--serif);\n      font-size: 32px;\n      font-weight: 400;\n      letter-spacing: -.045em;\n      line-height: .98;\n    }\n\n    .mini-cover-inner em { font-weight: 400; }\n\n    .mini-cover-inner .cover-byline {\n      font-size: 8px;\n      font-weight: 700;\n      letter-spacing: .12em;\n      text-transform: uppercase;\n    }\n\n    .cover-one::after {\n      content: \"\";\n      width: 82px;\n      height: 82px;\n      position: absolute;\n      right: 14px;\n      bottom: 57px;\n      border: 1px solid #f5f1e8a8;\n      border-radius: 50%;\n    }\n\n    .cover-two::after {\n      content: \"\u2733\";\n      position: absolute;\n      right: 20px;\n      bottom: 58px;\n      color: #e4c88f;\n      font-size: 50px;\n    }\n\n    .cover-three::after {\n      content: \"\";\n      width: 80px;\n      height: 80px;\n      position: absolute;\n      right: 20px;\n      bottom: 46px;\n      border: 1px solid var(--coral);\n      border-radius: 50%;\n      box-shadow: 0 0 0 8px #d9d3c4, 0 0 0 9px var(--coral);\n    }\n\n    .book-meta {\n      display: flex;\n      align-items: start;\n      justify-content: space-between;\n      gap: 12px;\n    }\n\n    .book-meta h3 {\n      margin: 0 0 5px;\n      font-family: var(--serif);\n      font-size: 21px;\n      font-weight: 400;\n    }\n\n    .book-meta p {\n      margin: 0;\n      color: var(--muted);\n      font-size: 12px;\n    }\n\n    .format {\n      flex: 0 0 auto;\n      padding: 6px 8px;\n      border: 1px solid var(--line);\n      color: var(--muted);\n      font-size: 9px;\n      letter-spacing: .08em;\n      text-transform: uppercase;\n    }\n\n    .newsletter {\n      position: relative;\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 55px;\n      align-items: center;\n      overflow: hidden;\n      padding: 57px 65px;\n      color: var(--paper);\n      background: var(--green);\n    }\n\n    .newsletter::after {\n      content: \"\u2733\";\n      position: absolute;\n      top: -75px;\n      right: 23%;\n      color: #ffffff12;\n      font-size: 300px;\n      line-height: 1;\n      pointer-events: none;\n    }\n\n    .newsletter .eyebrow { color: #d8c99e; }\n    .newsletter .eyebrow::before { background: #e39070; }\n\n    .newsletter h2 {\n      max-width: 450px;\n      font-size: clamp(37px, 4.5vw, 53px);\n    }\n\n    .newsletter-copy {\n      max-width: 390px;\n      margin: 17px 0 0;\n      color: #d5ddd4;\n      font-family: var(--serif);\n      font-size: 16px;\n      line-height: 1.6;\n    }\n\n    .signup-form {\n      position: relative;\n      z-index: 1;\n    }\n\n    .signup-form label {\n      display: block;\n      margin-bottom: 10px;\n      color: #e0e6de;\n      font-size: 11px;\n      font-weight: 700;\n      letter-spacing: .09em;\n      text-transform: uppercase;\n    }\n\n    .input-row {\n      display: flex;\n      border-bottom: 1px solid #d5ddd4a8;\n    }\n\n    .input-row input {\n      width: 100%;\n      min-width: 0;\n      padding: 13px 0;\n      border: 0;\n      outline: none;\n      color: white;\n      background: transparent;\n      font: 14px var(--sans);\n    }\n\n    .input-row input::placeholder { color: #c0ccc1; }\n\n    .input-row button {\n      flex: 0 0 auto;\n      padding: 0 0 0 14px;\n      border: 0;\n      color: #f0c59c;\n      background: transparent;\n      font: 700 12px var(--sans);\n      cursor: pointer;\n    }\n\n    .input-row button span { margin-left: 10px; font-size: 17px; }\n\n    .privacy-note {\n      margin: 11px 0 0;\n      color: #c0ccc1;\n      font-size: 10px;\n    }\n\n    .site-footer {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 20px;\n      padding: 27px 0 31px;\n      color: var(--muted);\n      font-size: 11px;\n    }\n\n    .footer-note { margin: 0; }\n\n    .footer-links {\n      display: flex;\n      gap: 22px;\n    }\n\n    .footer-links a {\n      text-decoration: none;\n    }\n\n    .footer-links a:hover { color: var(--coral); }\n\n    @media (max-width: 800px) {\n      .page-shell { width: min(100% - 40px, 620px); }\n      .hero {\n        grid-template-columns: 1fr;\n        gap: 15px;\n        padding: 67px 0 55px;\n      }\n      .hero-art { min-height: 390px; }\n      .sun { right: calc(50% - 170px); }\n      .art-caption { right: 8%; }\n      .books-grid { gap: 16px; }\n      .mini-cover { height: 260px; }\n      .mini-cover-inner { width: 155px; height: 220px; padding: 18px 16px; }\n      .mini-cover-inner strong { font-size: 27px; }\n      .newsletter { padding: 45px 35px; gap: 32px; }\n    }\n\n    @media (max-width: 600px) {\n      .page-shell { width: calc(100% - 36px); }\n      .site-header { min-height: 72px; }\n      .wordmark { font-size: 11px; }\n      .nav-links { gap: 15px; font-size: 12px; }\n      .nav-links a:not(.nav-cta) { display: none; }\n      .nav-links .nav-cta { padding: 10px 12px; }\n      h1 { font-size: clamp(54px, 15vw, 76px); }\n      .hero-copy { font-size: 17px; }\n      .hero-note { display: block; margin: 15px 0 0; }\n      .hero-art { min-height: 350px; }\n      .sun { width: 290px; height: 290px; right: calc(50% - 145px); }\n      .book { width: 220px; height: 310px; }\n      .book-title { font-size: 36px; }\n      .section-heading { align-items: start; flex-direction: column; gap: 19px; }\n      .catalogue { padding: 60px 0 66px; }\n      .books-grid { grid-template-columns: 1fr; gap: 30px; }\n      .mini-cover { height: 310px; }\n      .mini-cover-inner { width: 180px; height: 250px; }\n      .newsletter { grid-template-columns: 1fr; gap: 31px; padding: 39px 25px; }\n      .newsletter::after { right: -50px; }\n      .site-footer { align-items: start; flex-direction: column; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      html { scroll-behavior: auto; }\n      *, *::before, *::after { transition-duration: .01ms !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"page-shell\">\n    <header class=\"site-header\">\n      <a class=\"wordmark\" href=\"#\" aria-label=\"Fieldnote Poetry home\">\n        <span class=\"mark\" aria-hidden=\"true\">f</span>\n        Fieldnote Poetry\n      </a>\n      <nav class=\"nav-links\" aria-label=\"Main navigation\">\n        <a href=\"#books\">Books</a>\n        <a href=\"#about\">Our story</a>\n        <a class=\"nav-cta\" href=\"#newsletter\">A note from us <span aria-hidden=\"true\">\u2197</span></a>\n      </nav>\n    </header>\n\n    <main>\n      <section class=\"hero\" id=\"about\">\n        <div>\n          <p class=\"eyebrow\">Independent poetry, thoughtfully made</p>\n          <h1>A little more<br>room for <em>wonder.</em></h1>\n          <p class=\"hero-copy\">\n            We publish poems that make you look twice: small, beautifully made books\n            for the moments that ask us to pay attention.\n          </p>\n          <a class=\"button\" href=\"#books\">Find your next read <span class=\"arrow\" aria-hidden=\"true\">\u2197</span></a>\n          <p class=\"hero-note\">Made slowly, read anywhere.</p>\n        </div>\n\n        <div class=\"hero-art\" aria-label=\"Featured poetry collection, The Shape of Small Things\">\n          <div class=\"sun\" aria-hidden=\"true\"></div>\n          <span class=\"little-star\" aria-hidden=\"true\">\u2733</span>\n          <div class=\"book book-feature\">\n            <span class=\"book-kicker\">Fieldnote Poetry \u00b7 07</span>\n            <p class=\"book-title\">The Shape<br>of <em>Small</em><br>Things</p>\n            <div class=\"cover-illustration\" aria-hidden=\"true\"></div>\n            <p class=\"book-author\">Mara Bell</p>\n          </div>\n          <span class=\"art-caption\">A new collection by Mara Bell</span>\n        </div>\n      </section>\n\n      <section class=\"catalogue section-rule\" id=\"books\">\n        <div class=\"section-heading\">\n          <div>\n            <p class=\"eyebrow\">A few good places to begin</p>\n            <h2>Books for keeping.</h2>\n          </div>\n          <a class=\"text-link\" href=\"#newsletter\">See the whole catalogue <span aria-hidden=\"true\">\u2192</span></a>\n        </div>\n\n        <div class=\"books-grid\">\n          <article class=\"book-card\">\n            <div class=\"mini-cover\">\n              <div class=\"mini-cover-inner cover-one\">\n                <small>Fieldnote Poetry \u00b7 07</small>\n                <strong>The Shape<br>of <em>Small</em><br>Things</strong>\n                <span class=\"cover-byline\">Mara Bell</span>\n              </div>\n            </div>\n            <div class=\"book-meta\">\n              <div>\n                <h3>The Shape of Small Things</h3>\n                <p>Mara Bell \u00b7 New collection</p>\n              </div>\n              <span class=\"format\">Paperback</span>\n            </div>\n          </article>\n\n          <article class=\"book-card\">\n            <div class=\"mini-cover\">\n              <div class=\"mini-cover-inner cover-two\">\n                <small>Fieldnote Poetry \u00b7 06</small>\n                <strong>Weather<br>for <em>Walking</em></strong>\n                <span class=\"cover-byline\">Jonah Reed</span>\n              </div>\n            </div>\n            <div class=\"book-meta\">\n              <div>\n                <h3>Weather for Walking</h3>\n                <p>Jonah Reed \u00b7 Poems</p>\n              </div>\n              <span class=\"format\">Paperback</span>\n            </div>\n          </article>\n\n          <article class=\"book-card\">\n            <div class=\"mini-cover\">\n              <div class=\"mini-cover-inner cover-three\">\n                <small>Fieldnote Poetry \u00b7 05</small>\n                <strong>Notes<br>from the<br><em>Low Tide</em></strong>\n                <span class=\"cover-byline\">Asha Wynn</span>\n              </div>\n            </div>\n            <div class=\"book-meta\">\n              <div>\n                <h3>Notes from the Low Tide</h3>\n                <p>Asha Wynn \u00b7 Poems</p>\n              </div>\n              <span class=\"format\">Paperback</span>\n            </div>\n          </article>\n        </div>\n      </section>\n\n      <section class=\"newsletter\" id=\"newsletter\">\n        <div>\n          <p class=\"eyebrow\">A letter, now and then</p>\n          <h2>Good words, straight to your inbox.</h2>\n          <p class=\"newsletter-copy\">\n            New poems, small press news, and the occasional reading list.\n            Sent with care, never clutter.\n          </p>\n        </div>\n        <form class=\"signup-form\" action=\"#\" method=\"post\">\n          <label for=\"email\">Your email address</label>\n          <div class=\"input-row\">\n            <input id=\"email\" name=\"email\" type=\"email\" placeholder=\"you@example.com\" autocomplete=\"email\" required>\n            <button type=\"submit\">Count me in <span aria-hidden=\"true\">\u2192</span></button>\n          </div>\n          <p class=\"privacy-note\">A quiet little newsletter. Unsubscribe whenever you like.</p>\n        </form>\n      </section>\n    </main>\n\n    <footer class=\"site-footer\">\n      <p class=\"footer-note\">\u00a9 2025 Fieldnote Poetry \u00b7 Made with care, wherever we are.</p>\n      <nav class=\"footer-links\" aria-label=\"Footer navigation\">\n        <a href=\"#about\">About</a>\n        <a href=\"mailto:hello@fieldnotepoetry.example\">Contact</a>\n        <a href=\"#newsletter\">Instagram</a>\n      </nav>\n    </footer>\n  </div>\n</body>\n</html>\n"}