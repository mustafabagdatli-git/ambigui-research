{"brief": "B5", "model": "anthropic/claude-haiku-5.5", "i": 0, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Walk-In Sexual Health Clinic | Confidential Testing &amp; Care</title>\n  <meta name=\"description\" content=\"Walk in any time during opening hours for confidential sexual health testing, treatment, contraception and vaccines. No appointment needed.\">\n  <style>\n    :root {\n      --teal-900: #0b3b3c;\n      --teal-700: #125f60;\n      --teal-600: #17797a;\n      --teal-100: #d9f0ef;\n      --teal-50:  #eff9f8;\n      --coral-600: #c2410c;\n      --coral-100: #ffe8dc;\n      --ink: #1d2b2b;\n      --ink-soft: #4a5b5b;\n      --line: #d5e3e2;\n      --white: #ffffff;\n      --radius: 14px;\n      --shadow: 0 10px 30px rgba(11, 59, 60, 0.08);\n      --font: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n    }\n\n    *, *::before, *::after { box-sizing: border-box; }\n\n    html { scroll-behavior: smooth; }\n\n    body {\n      margin: 0;\n      font-family: var(--font);\n      color: var(--ink);\n      background: var(--white);\n      line-height: 1.6;\n      font-size: 17px;\n    }\n\n    img, svg { display: block; max-width: 100%; }\n\n    a { color: var(--teal-700); }\n\n    a:focus-visible, button:focus-visible, summary:focus-visible {\n      outline: 3px solid var(--coral-600);\n      outline-offset: 3px;\n      border-radius: 4px;\n    }\n\n    .skip-link {\n      position: absolute;\n      left: -9999px;\n      top: 8px;\n      background: var(--white);\n      padding: 10px 16px;\n      z-index: 100;\n      border-radius: 8px;\n      box-shadow: var(--shadow);\n    }\n    .skip-link:focus { left: 8px; }\n\n    .container {\n      width: min(1120px, 92%);\n      margin-inline: auto;\n    }\n\n    h1, h2, h3 {\n      font-family: var(--font);\n      color: var(--teal-900);\n      line-height: 1.2;\n      margin: 0 0 0.5em;\n      letter-spacing: -0.01em;\n    }\n    h1 { font-size: clamp(2.2rem, 4.5vw, 3.4rem); font-weight: 750; }\n    h2 { font-size: clamp(1.7rem, 3vw, 2.3rem); font-weight: 700; }\n    h3 { font-size: 1.15rem; font-weight: 650; }\n\n    p { margin: 0 0 1em; }\n\n    .eyebrow {\n      display: inline-block;\n      text-transform: uppercase;\n      letter-spacing: 0.08em;\n      font-size: 0.8rem;\n      font-weight: 700;\n      color: var(--teal-700);\n      background: var(--teal-100);\n      padding: 6px 12px;\n      border-radius: 999px;\n      margin-bottom: 1rem;\n    }\n\n    .section { padding: 5rem 0; }\n    .section--tint { background: var(--teal-50); }\n\n    .section-head { max-width: 680px; margin-bottom: 2.5rem; }\n    .section-head p { color: var(--ink-soft); font-size: 1.05rem; }\n\n    /* Buttons */\n    .btn {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: 0.5rem;\n      font: inherit;\n      font-weight: 650;\n      text-decoration: none;\n      padding: 0.85rem 1.4rem;\n      border-radius: 999px;\n      border: 2px solid transparent;\n      cursor: pointer;\n      transition: background-color .2s, color .2s, border-color .2s, transform .1s;\n      white-space: nowrap;\n    }\n    .btn:active { transform: translateY(1px); }\n\n    .btn--primary { background: var(--teal-700); color: var(--white); }\n    .btn--primary:hover { background: var(--teal-900); }\n\n    .btn--ghost { background: transparent; color: var(--teal-900); border-color: var(--teal-700); }\n    .btn--ghost:hover { background: var(--teal-100); }\n\n    .btn--light { background: var(--white); color: var(--teal-900); }\n    .btn--light:hover { background: var(--teal-100); }\n\n    /* Header */\n    .site-header {\n      position: sticky;\n      top: 0;\n      z-index: 50;\n      background: rgba(255,255,255,0.96);\n      backdrop-filter: blur(8px);\n      border-bottom: 1px solid var(--line);\n    }\n    .nav {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 1rem;\n      padding: 0.9rem 0;\n    }\n    .brand {\n      display: flex;\n      align-items: center;\n      gap: 0.6rem;\n      text-decoration: none;\n      color: var(--teal-900);\n      font-weight: 750;\n      font-size: 1.05rem;\n    }\n    .brand-mark {\n      width: 34px; height: 34px;\n      border-radius: 10px;\n      background: var(--teal-700);\n      display: grid;\n      place-items: center;\n    }\n    .nav-links {\n      display: flex;\n      gap: 1.4rem;\n      list-style: none;\n      margin: 0;\n      padding: 0;\n    }\n    .nav-links a {\n      color: var(--ink);\n      text-decoration: none;\n      font-weight: 500;\n      font-size: 0.95rem;\n    }\n    .nav-links a:hover { color: var(--teal-700); text-decoration: underline; }\n    .nav-cta { display: flex; align-items: center; gap: 0.8rem; }\n    .nav-phone { font-size: 0.95rem; color: var(--ink-soft); text-decoration: none; }\n\n    /* Hero */\n    .hero {\n      background:\n        radial-gradient(circle at 90% 10%, var(--teal-100) 0, transparent 40%),\n        linear-gradient(180deg, #f7fcfc 0%, var(--white) 100%);\n      padding: 4.5rem 0 4rem;\n    }\n    .hero-grid {\n      display: grid;\n      grid-template-columns: 1.15fr 0.85fr;\n      gap: 3rem;\n      align-items: center;\n    }\n    .hero p.lead {\n      font-size: 1.2rem;\n      color: var(--ink-soft);\n      max-width: 36rem;\n    }\n    .hero-actions {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 0.8rem;\n      margin: 1.8rem 0 2rem;\n    }\n    .reassure {\n      list-style: none;\n      padding: 0;\n      margin: 0;\n      display: grid;\n      gap: 0.6rem;\n      color: var(--ink);\n    }\n    .reassure li {\n      display: flex;\n      gap: 0.6rem;\n      align-items: flex-start;\n    }\n    .reassure svg { flex: 0 0 auto; margin-top: 4px; color: var(--teal-600); }\n\n    .status-card {\n      background: var(--white);\n      border: 1px solid var(--line);\n      border-radius: var(--radius);\n      box-shadow: var(--shadow);\n      padding: 1.6rem;\n    }\n    .status-top {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      margin-bottom: 1rem;\n    }\n    .status-badge {\n      display: inline-flex;\n      align-items: center;\n      gap: 0.45rem;\n      background: #e3f6ea;\n      color: #14532d;\n      font-weight: 650;\n      font-size: 0.9rem;\n      padding: 0.35rem 0.8rem;\n      border-radius: 999px;\n    }\n    .status-badge::before {\n      content: \"\";\n      width: 9px; height: 9px;\n      border-radius: 50%;\n      background: #16a34a;\n      box-shadow: 0 0 0 4px rgba(22,163,74,0.18);\n    }\n    .status-card h3 { margin-bottom: 0.3rem; }\n    .status-card .muted { color: var(--ink-soft); font-size: 0.95rem; margin-bottom: 1.2rem; }\n    .queue-row {\n      display: flex;\n      justify-content: space-between;\n      padding: 0.75rem 0;\n      border-top: 1px solid var(--line);\n      font-size: 0.97rem;\n    }\n    .queue-row:first-of-type { border-top: 0; }\n    .queue-row span:last-child { font-weight: 650; color: var(--teal-900); }\n    .status-card .note {\n      margin: 1rem 0 0;\n      font-size: 0.88rem;\n      color: var(--ink-soft);\n      background: var(--teal-50);\n      border-radius: 10px;\n      padding: 0.7rem 0.9rem;\n    }\n\n    /* Services */\n    .services {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 1.25rem;\n    }\n    .service {\n      background: var(--white);\n      border: 1px solid var(--line);\n      border-radius: var(--radius);\n      padding: 1.6rem;\n      transition: transform .2s, box-shadow .2s;\n    }\n    .service:hover { transform: translateY(-3px); box-shadow: var(--shadow); }\n    .icon {\n      width: 46px; height: 46px;\n      border-radius: 12px;\n      background: var(--teal-100);\n      color: var(--teal-700);\n      display: grid;\n      place-items: center;\n      margin-bottom: 1rem;\n    }\n    .service p { color: var(--ink-soft); font-size: 0.97rem; margin: 0; }\n\n    /* Steps */\n    .steps {\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      gap: 1.25rem;\n      counter-reset: step;\n      list-style: none;\n      padding: 0;\n      margin: 0;\n    }\n    .steps li {\n      position: relative;\n      background: var(--white);\n      border-radius: var(--radius);\n      padding: 1.6rem 1.4rem;\n      border: 1px solid var(--line);\n    }\n    .steps li::before {\n      counter-increment: step;\n      content: counter(step);\n      display: grid;\n      place-items: center;\n      width: 36px; height: 36px;\n      border-radius: 50%;\n      background: var(--teal-700);\n      color: var(--white);\n      font-weight: 700;\n      margin-bottom: 0.9rem;\n    }\n    .steps p { color: var(--ink-soft); font-size: 0.95rem; margin: 0; }\n\n    /* Hours & location */\n    .info-grid {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 2rem;\n      align-items: start;\n    }\n    table.hours {\n      width: 100%;\n      border-collapse: collapse;\n      background: var(--white);\n      border-radius: var(--radius);\n      overflow: hidden;\n      box-shadow: var(--shadow);\n    }\n    table.hours caption {\n      text-align: left;\n      font-weight: 700;\n      color: var(--teal-900);\n      font-size: 1.1rem;\n      padding-bottom: 0.8rem;\n      caption-side: top;\n    }\n    table.hours th, table.hours td {\n      text-align: left;\n      padding: 0.9rem 1.2rem;\n      border-bottom: 1px solid var(--line);\n    }\n    table.hours tr:last-child th, table.hours tr:last-child td { border-bottom: 0; }\n    table.hours td { text-align: right; color: var(--ink-soft); }\n    table.hours tr.today th, table.hours tr.today td {\n      background: var(--teal-50);\n      color: var(--teal-900);\n      font-weight: 650;\n    }\n\n    .address-card {\n      background: var(--teal-900);\n      color: var(--white);\n      border-radius: var(--radius);\n      padding: 2rem;\n    }\n    .address-card h3 { color: var(--white); }\n    .address-card p { color: #cfe7e6; }\n    .address-card a { color: var(--white); }\n    .address-card .btn { margin-top: 0.6rem; }\n    .address-list { list-style: none; padding: 0; margin: 1.2rem 0; display: grid; gap: 0.9rem; }\n    .address-list li { display: flex; gap: 0.7rem; align-items: flex-start; }\n    .address-list svg { flex: 0 0 auto; margin-top: 3px; }\n\n    /* Privacy */\n    .privacy {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 3rem;\n      align-items: center;\n    }\n    .privacy-points { display: grid; gap: 1rem; }\n    .point {\n      display: flex;\n      gap: 1rem;\n      padding: 1.2rem 1.4rem;\n      border-radius: var(--radius);\n      border: 1px solid var(--line);\n      background: var(--white);\n    }\n    .point h3 { margin-bottom: 0.2rem; font-size: 1.02rem; }\n    .point p { margin: 0; color: var(--ink-soft); font-size: 0.95rem; }\n\n    /* Pricing */\n    .price-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 1.25rem;\n    }\n    .price {\n      background: var(--white);\n      border: 1px solid var(--line);\n      border-radius: var(--radius);\n      padding: 1.6rem;\n    }\n    .price .tag {\n      font-size: 0.8rem;\n      font-weight: 700;\n      text-transform: uppercase;\n      letter-spacing: 0.06em;\n      color: var(--teal-700);\n    }\n    .price .amount {\n      font-size: 1.9rem;\n      font-weight: 750;\n      color: var(--teal-900);\n      margin: 0.3rem 0;\n    }\n    .price p { color: var(--ink-soft); font-size: 0.95rem; margin: 0; }\n    .fine-print { font-size: 0.9rem; color: var(--ink-soft); margin-top: 1.2rem; }\n\n    /* FAQ */\n    .faq { max-width: 780px; }\n    details {\n      border-bottom: 1px solid var(--line);\n      padding: 1.1rem 0;\n    }\n    details:first-child { border-top: 1px solid var(--line); }\n    summary {\n      cursor: pointer;\n      font-weight: 650;\n      color: var(--teal-900);\n      list-style: none;\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      gap: 1rem;\n      font-size: 1.05rem;\n    }\n    summary::-webkit-details-marker { display: none; }\n    summary::after {\n      content: \"+\";\n      font-size: 1.5rem;\n      line-height: 1;\n      color: var(--teal-700);\n      transition: transform .2s;\n    }\n    details[open] summary::after { transform: rotate(45deg); }\n    details p {\n      color: var(--ink-soft);\n      margin: 0.8rem 0 0;\n      padding-right: 2rem;\n    }\n\n    /* Urgent banner */\n    .urgent {\n      background: var(--coral-100);\n      border-left: 5px solid var(--coral-600);\n      border-radius: 10px;\n      padding: 1.1rem 1.4rem;\n      display: flex;\n      gap: 0.9rem;\n      align-items: flex-start;\n      color: #7c2d12;\n      font-size: 0.97rem;\n    }\n    .urgent strong { color: #7c2d12; }\n    .urgent svg { flex: 0 0 auto; margin-top: 2px; color: var(--coral-600); }\n\n    /* CTA band */\n    .cta-band {\n      background: linear-gradient(120deg, var(--teal-700), var(--teal-900));\n      color: var(--white);\n      padding: 4rem 0;\n    }\n    .cta-band .container {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 2rem;\n      flex-wrap: wrap;\n    }\n    .cta-band h2 { color: var(--white); margin: 0 0 0.4rem; }\n    .cta-band p { color: #d4ecea; margin: 0; }\n\n    /* Footer */\n    footer {\n      background: #082d2e;\n      color: #b9d3d2;\n      padding: 3rem 0 2rem;\n      font-size: 0.93rem;\n    }\n    .footer-grid {\n      display: grid;\n      grid-template-columns: 2fr 1fr 1fr;\n      gap: 2rem;\n      margin-bottom: 2rem;\n    }\n    footer h4 {\n      color: var(--white);\n      margin: 0 0 0.8rem;\n      font-size: 0.95rem;\n    }\n    footer ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.45rem; }\n    footer a { color: #b9d3d2; text-decoration: none; }\n    footer a:hover { color: var(--white); text-decoration: underline; }\n    .disclaimer {\n      border-top: 1px solid rgba(255,255,255,0.12);\n      padding-top: 1.4rem;\n      font-size: 0.85rem;\n      color: #8fb0af;\n    }\n\n    /* Responsive */\n    @media (max-width: 960px) {\n      .hero-grid, .info-grid, .privacy { grid-template-columns: 1fr; }\n      .services { grid-template-columns: repeat(2, 1fr); }\n      .steps { grid-template-columns: repeat(2, 1fr); }\n      .price-grid { grid-template-columns: 1fr; }\n      .nav-links { display: none; }\n      .footer-grid { grid-template-columns: 1fr 1fr; }\n    }\n\n    @media (max-width: 620px) {\n      body { font-size: 16px; }\n      .section { padding: 3.5rem 0; }\n      .services, .steps { grid-template-columns: 1fr; }\n      .nav-phone { display: none; }\n      .footer-grid { grid-template-columns: 1fr; }\n      .hero { padding-top: 3rem; }\n      .btn { width: 100%; }\n      .hero-actions { flex-direction: column; }\n      .nav-cta .btn { padding: 0.6rem 1rem; width: auto; font-size: 0.9rem; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      html { scroll-behavior: auto; }\n      * { transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n\n  <a class=\"skip-link\" href=\"#main\">Skip to content</a>\n\n  <!-- Header -->\n  <header class=\"site-header\">\n    <div class=\"container nav\">\n      <a href=\"#top\" class=\"brand\" aria-label=\"Harbour Sexual Health Walk-In Clinic home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 21s-7-4.35-7-10a4 4 0 0 1 7-2.65A4 4 0 0 1 19 11c0 5.65-7 10-7 10z\"/></svg>\n        </span>\n        Harbour Sexual Health\n      </a>\n\n      <nav aria-label=\"Main\">\n        <ul class=\"nav-links\">\n          <li><a href=\"#services\">Services</a></li>\n          <li><a href=\"#how\">How it works</a></li>\n          <li><a href=\"#hours\">Hours &amp; location</a></li>\n          <li><a href=\"#privacy\">Privacy</a></li>\n          <li><a href=\"#faq\">FAQ</a></li>\n        </ul>\n      </nav>\n\n      <div class=\"nav-cta\">\n        <a class=\"nav-phone\" href=\"tel:+15555550100\">(555) 555-0100</a>\n        <a class=\"btn btn--primary\" href=\"#hours\">Walk in today</a>\n      </div>\n    </div>\n  </header>\n\n  <main id=\"main\">\n\n    <!-- Hero -->\n    <section class=\"hero\" id=\"top\">\n      <div class=\"container hero-grid\">\n        <div>\n          <span class=\"eyebrow\">No appointment needed</span>\n          <h1>Sexual health care, when you need it.</h1>\n          <p class=\"lead\">Walk in during opening hours for confidential testing, treatment, contraception and vaccines. Our team is non-judgemental, and we'll talk you through every step.</p>\n\n          <div class=\"hero-actions\">\n            <a class=\"btn btn--primary\" href=\"#hours\">See today's hours</a>\n            <a class=\"btn btn--ghost\" href=\"#services\">Explore services</a>\n          </div>\n\n          <ul class=\"reassure\">\n            <li>\n              <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><polyline points=\"20 6 9 17 4 12\"/></svg>\n              <span>Confidential care. We never share your information without your consent.</span>\n            </li>\n            <li>\n              <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><polyline points=\"20 6 9 17 4 12\"/></svg>\n              <span>Many tests give same-day or next-day results.</span>\n            </li>\n            <li>\n              <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><polyline points=\"20 6 9 17 4 12\"/></svg>\n              <span>Costs explained upfront, before any test is done.</span>\n            </li>\n          </ul>\n        </div>\n\n        <aside class=\"status-card\" aria-labelledby=\"status-title\">\n          <div class=\"status-top\">\n            <span class=\"status-badge\">Open now</span>\n          </div>\n          <h3 id=\"status-title\">Walk-in waiting times</h3>\n          <p class=\"muted\">Typical wait based on the last hour. Times change, so arriving early helps.</p>\n\n          <div class=\"queue-row\"><span>Testing &amp; check-ups</span><span>About 20 min</span></div>\n          <div class=\"queue-row\"><span>Contraception &amp; emergency pill</span><span>About 15 min</span></div>\n          <div class=\"queue-row\"><span>Vaccines</span><span>About 10 min</span></div>\n\n          <p class=\"note\">Closing today at <strong>7:00 pm</strong>. The last walk-in is taken 30 minutes before closing.</p>\n        </aside>\n      </div>\n    </section>\n\n    <!-- Services -->\n    <section class=\"section\" id=\"services\" aria-labelledby=\"services-title\">\n      <div class=\"container\">\n        <div class=\"section-head\">\n          <span class=\"eyebrow\">Services</span>\n          <h2 id=\"services-title\">Everything under one roof</h2>\n          <p>Whether you're getting a routine check, have symptoms, or need advice, we can help. Ask us about anything not listed here.</p>\n        </div>\n\n        <div class=\"services\">\n          <article class=\"service\">\n            <div class=\"icon\" aria-hidden=\"true\">\n              <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 3h6M10 3v6.5L4.8 18.2A2 2 0 0 0 6.5 21h11a2 2 0 0 0 1.7-2.8L14 9.5V3\"/></svg>\n            </div>\n            <h3>STI testing</h3>\n            <p>Full or targeted screening for chlamydia, gonorrhoea, syphilis, herpes, trichomonas and more. Choose swabs, urine or blood tests.</p>\n          </article>\n\n          <article class=\"service\">\n            <div class=\"icon\" aria-hidden=\"true\">\n              <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 2v6M9 5h6M5 22l4-9 4 4 6-10\"/></svg>\n            </div>\n            <h3>HIV testing &amp; PrEP</h3>\n            <p>Rapid and lab-based HIV tests. Ask us about PrEP, a daily or on-demand medicine that helps prevent HIV.</p>\n          </article>\n\n          <article class=\"service\">\n            <div class=\"icon\" aria-hidden=\"true\">\n              <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 8v4l2.5 2.5\"/></svg>\n            </div>\n            <h3>Emergency contraception</h3>\n            <p>Available same day if you've had unprotected sex or your method failed. The earlier you come in, the better it works.</p>\n          </article>\n\n          <article class=\"service\">\n            <div class=\"icon\" aria-hidden=\"true\">\n              <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"5\" y=\"3\" width=\"14\" height=\"18\" rx=\"3\"/><path d=\"M9 8h6M9 12h6M9 16h3\"/></svg>\n            </div>\n            <h3>Contraception options</h3>\n            <p>Pills, patches, implants, injections, IUDs and condoms. We'll help you pick what fits your body and your life.</p>\n          </article>\n\n          <article class=\"service\">\n            <div class=\"icon\" aria-hidden=\"true\">\n              <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8z\"/></svg>\n            </div>\n            <h3>Symptom assessment</h3>\n            <p>Itching, discharge, pain, sores, rashes or unusual bleeding. We examine, test and treat where needed.</p>\n          </article>\n\n          <article class=\"service\">\n            <div class=\"icon\" aria-hidden=\"true\">\n              <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 8h1a4 4 0 0 1 0 8h-1M3 8h15v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4z\"/></svg>\n            </div>\n            <h3>Vaccines</h3>\n            <p>HPV, hepatitis A and B, and mpox vaccines, depending on eligibility. Ask us what's recommended for you.</p>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <!-- How it works -->\n    <section class=\"section section--tint\" id=\"how\" aria-labelledby=\"how-title\">\n      <div class=\"container\">\n        <div class=\"section-head\">\n          <span class=\"eyebrow\">How it works</span>\n          <h2 id=\"how-title\">Your visit, step by step</h2>\n          <p>Most visits take 30 to 45 minutes from check-in to leaving.</p>\n        </div>\n\n        <ol class=\"steps\">\n          <li>\n            <h3>Check in</h3>\n            <p>Tell reception your name or a nickname. You don't need ID or insurance to be seen.</p>\n          </li>\n          <li>\n            <h3>Private consultation</h3>\n            <p>Talk with a nurse or clinician in a private room about your concerns and history.</p>\n          </li>\n          <li>\n            <h3>Test or treat</h3>\n            <p>Get the tests or care you need. You can ask questions and decline anything at any point.</p>\n          </li>\n          <li>\n            <h3>Results &amp; next steps</h3>\n            <p>We contact you by your preferred method and you can leave with a clear plan.</p>\n          </li>\n        </ol>\n      </div>\n    </section>\n\n    <!-- Hours & location -->\n    <section class=\"section\" id=\"hours\" aria-labelledby=\"hours-title\">\n      <div class=\"container info-grid\">\n        <div>\n          <span class=\"eyebrow\">Hours</span>\n          <h2 id=\"hours-title\">Walk in any time we're open</h2>\n          <p>No booking required. If you need a specific time or a longer appointment, you can also call ahead.</p>\n\n          <table class=\"hours\">\n            <caption>Opening hours</caption>\n            <tbody>\n              <tr><th scope=\"row\">Monday</th><td>9:00 am \u2013 7:00 pm</td></tr>\n              <tr><th scope=\"row\">Tuesday</th><td>9:00 am \u2013 7:00 pm</td></tr>\n              <tr class=\"today\"><th scope=\"row\">Wednesday (today)</th><td>9:00 am \u2013 7:00 pm</td></tr>\n              <tr><th scope=\"row\">Thursday</th><td>9:00 am \u2013 7:00 pm</td></tr>\n              <tr><th scope=\"row\">Friday</th><td>9:00 am \u2013 5:00 pm</td></tr>\n              <tr><th scope=\"row\">Saturday</th><td>10:00 am \u2013 2:00 pm</td></tr>\n              <tr><th scope=\"row\">Sunday</th><td>Closed</td></tr>\n            </tbody>\n          </table>\n        </div>\n\n        <div class=\"address-card\">\n          <h3>Find us</h3>\n          <p>Ground floor, Suite 2<br>128 Riverside Avenue<br>Harbour City, ST 00000</p>\n\n          <ul class=\"address-list\">\n            <li>\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#9fd3d0\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z\"/></svg>\n              <span><a href=\"tel:+15555550100\">(555) 555-0100</a></span>\n            </li>\n            <li>\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#9fd3d0\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/></svg>\n              <span>Step-free access. Accessible toilet on site. Parking at the rear of the building.</span>\n            </li>\n            <li>\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#9fd3d0\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 12a9 9 0 1 0 18 0 9 9 0 0 0-18 0\"/><path d=\"M12 7v5l3 2\"/></svg>\n              <span>Close to the Riverside Station (5 min walk). Bus routes 4 and 9 stop outside.</span>\n            </li>\n          </ul>\n\n          <a class=\"btn btn--light\" href=\"#\">Get directions</a>\n        </div>\n      </div>\n    </section>\n\n    <!-- Privacy -->\n    <section class=\"section section--tint\" id=\"privacy\" aria-labelledby=\"privacy-title\">\n      <div class=\"container privacy\">\n        <div>\n          <span class=\"eyebrow\">Privacy</span>\n          <h2 id=\"privacy-title\">Your privacy is our priority</h2>\n          <p>We know that sexual health can feel personal. Every part of our service is designed to keep your information safe and your visit discreet.</p>\n          <p>Tell us your preferred name and contact details, and we'll use them. Nothing is shared with your employer, family or insurer without your permission.</p>\n        </div>\n\n        <div class=\"privacy-points\">\n          <div class=\"point\">\n            <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#17797a\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"4\" y=\"11\" width=\"16\" height=\"10\" rx=\"2\"/><path d=\"M8 11V7a4 4 0 0 1 8 0v4\"/></svg>\n            <div>\n              <h3>Discreet communication</h3>\n              <p>Results and reminders can be sent by text, call or letter. We'll ask what you prefer and what is safe for you.</p>\n            </div>\n          </div>\n          <div class=\"point\">\n            <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#17797a\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M23 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8\"/></svg>\n            <div>\n              <h3>Anonymous testing available</h3>\n              <p>Some tests can be done without giving your name. Ask reception for details.</p>\n            </div>\n          </div>\n          <div class=\"point\">\n            <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#17797a\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/></svg>\n            <div>\n              <h3>Private records</h3>\n              <p>Your notes are stored securely and are only visible to clinical staff involved in your care.</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Pricing -->\n    <section class=\"section\" aria-labelledby=\"price-title\">\n      <div class=\"container\">\n        <div class=\"section-head\">\n          <span class=\"eyebrow\">Costs</span>\n          <h2 id=\"price-title\">Clear, upfront pricing</h2>\n          <p>We'll tell you the cost before anything is done. You can decide what to go ahead with.</p>\n        </div>\n\n        <div class=\"price-grid\">\n          <div class=\"price\">\n            <span class=\"tag\">Low-cost</span>\n            <div class=\"amount\">From $25</div>\n            <p>Standard STI screening panels and most contraception consultations.</p>\n          </div>\n          <div class=\"price\">\n            <span class=\"tag\">Free</span>\n            <div class=\"amount\">$0</div>\n            <p>Rapid HIV tests, condoms, and some vaccines or treatments funded locally. Ask us if you qualify.</p>\n          </div>\n          <div class=\"price\">\n            <span class=\"tag\">Varies</span>\n            <div class=\"amount\">Quoted</div>\n            <p>Complex consultations, PrEP and other medication. We'll confirm costs and any alternatives.</p>\n          </div>\n        </div>\n        <p class=\"fine-print\">Prices are indicative and may change. We don't turn anyone away because they can't pay. Ask at reception about concession options.</p>\n      </div>\n    </section>\n\n    <!-- FAQ -->\n    <section class=\"section section--tint\" id=\"faq\" aria-labelledby=\"faq-title\">\n      <div class=\"container\">\n        <div class=\"section-head\">\n          <span class=\"eyebrow\">Questions</span>\n          <h2 id=\"faq-title\">Frequently asked questions</h2>\n        </div>\n\n        <div class=\"faq\">\n          <details>\n            <summary>Do I need an appointment?</summary>\n            <p>No. You can walk in during opening hours. If you'd like a specific time, or need a longer consultation, you can call ahead and we'll arrange it.</p>\n          </details>\n\n          <details>\n            <summary>Who can come in?</summary>\n            <p>Anyone, of any age, gender, sexual orientation or background. You don't need a referral or ID to be seen.</p>\n          </details>\n\n          <details>\n            <summary>How long do test results take?</summary>\n            <p>Rapid HIV and some STI tests give same-day results. Lab tests usually take 2 to 7 days. We'll tell you the timeframe for your specific tests and how we'll contact you.</p>\n          </details>\n\n          <details>\n            <summary>Will you tell my parents, partner or doctor?</summary>\n            <p>No, not without your consent. If you're under 16, we follow local confidentiality rules and will explain them before your consultation. Our staff are trained to protect your information.</p>\n          </details>\n\n          <details>\n            <summary>Do I need to undress for an examination?</summary>\n            <p>Only if it's needed for your care. You're always in control. You can ask for a chaperone, bring a companion into the room, or stop at any time.</p>\n          </details>\n\n          <details>\n            <summary>Can I come in if I've been sexually assaulted?</summary>\n            <p>Yes. Please come in or call us as soon as you feel able. We can check your health, offer emergency contraception and post-exposure HIV prevention where appropriate, and help you find support. If you're in immediate danger, call your local emergency number.</p>\n          </details>\n\n          <details>\n            <summary>What should I bring?</summary>\n            <p>A list of any medicines you take, your contact details, and any questions you have. You don't need to bring a sample or prepare anything specific for most tests. Ask us if you have questions about a particular test.</p>\n          </details>\n        </div>\n      </div>\n    </section>\n\n    <!-- Urgent notice -->\n    <section class=\"section\" aria-label=\"Urgent care information\">\n      <div class=\"container\">\n        <div class=\"urgent\" role=\"note\">\n          <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z\"/><line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"/><line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"/></svg>\n          <div>\n            <strong>Not sure if it's an emergency?</strong>\n            If you have severe pain, heavy bleeding, trouble breathing, a high fever, or feel very unwell, call your local emergency number or go to the nearest emergency department straight away.\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- CTA band -->\n    <section class=\"cta-band\" aria-labelledby=\"cta-title\">\n      <div class=\"container\">\n        <div>\n          <h2 id=\"cta-title\">Ready when you are.</h2>\n          <p>Come in today or call us with any questions. We're here to help.</p>\n        </div>\n        <div style=\"display:flex; gap:0.8rem; flex-wrap:wrap;\">\n          <a class=\"btn btn--light\" href=\"#hours\">View opening hours</a>\n          <a class=\"btn btn--ghost\" href=\"tel:+15555550100\" style=\"color:#fff;border-color:#fff;\">Call (555) 555-0100</a>\n        </div>\n      </div>\n    </section>\n\n  </main>\n\n  <!-- Footer -->\n  <footer>\n    <div class=\"container\">\n      <div class=\"footer-grid\">\n        <div>\n          <h4>Harbour Sexual Health Walk-In Clinic</h4>\n          <p>Confidential, inclusive sexual health care for everyone. Walk in during opening hours, no appointment needed.</p>\n          <p>Ground floor, Suite 2, 128 Riverside Avenue, Harbour City, ST 00000</p>\n        </div>\n\n        <nav aria-label=\"Footer\">\n          <h4>Services</h4>\n          <ul>\n            <li><a href=\"#services\">STI testing</a></li>\n            <li><a href=\"#services\">HIV testing &amp; PrEP</a></li>\n            <li><a href=\"#services\">Contraception</a></li>\n            <li><a href=\"#services\">Vaccines</a></li>\n          </ul>\n        </nav>\n\n        <nav aria-label=\"Footer information\">\n          <h4>Information</h4>\n          <ul>\n            <li><a href=\"#hours\">Hours &amp; location</a></li>\n            <li><a href=\"#privacy\">Privacy notice</a></li>\n            <li><a href=\"#faq\">FAQ</a></li>\n            <li><a href=\"#\">Accessibility</a></li>\n          </ul>\n        </nav>\n      </div>\n\n      <div class=\"disclaimer\">\n        <p>This website provides general information and does not replace individual medical advice. If you are in crisis or need urgent care, call your local emergency number. &copy; 2025 Harbour Sexual Health Walk-In Clinic. All rights reserved.</p>\n      </div>\n    </div>\n  </footer>\n\n</body>\n</html>\n"}