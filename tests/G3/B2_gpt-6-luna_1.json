{"brief": "B2", "model": "openai/gpt-6-luna", "i": 1, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#f8f7f1\">\n  <title>Wonderlab \u2014 Big discoveries for curious kids</title>\n  <style>\n    :root {\n      --ink: #182b49;\n      --muted: #59677a;\n      --cream: #f8f7f1;\n      --white: #fff;\n      --coral: #ff705d;\n      --teal: #48c8bd;\n      --yellow: #ffd560;\n      --blue: #5277e7;\n      --line: #e6e5de;\n      --radius: 24px;\n      --shadow: 0 18px 50px rgba(24, 43, 73, .10);\n    }\n\n    * { box-sizing: border-box; }\n    html { scroll-behavior: smooth; }\n    body {\n      margin: 0;\n      color: var(--ink);\n      background: var(--cream);\n      font-family: ui-rounded, \"Avenir Next\", Avenir, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      line-height: 1.55;\n    }\n    a { color: inherit; text-decoration: none; }\n    button, a { -webkit-tap-highlight-color: transparent; }\n    .wrap { width: min(1160px, calc(100% - 48px)); margin-inline: auto; }\n\n    .announcement {\n      padding: 10px 20px;\n      color: var(--ink);\n      background: var(--yellow);\n      text-align: center;\n      font-size: .88rem;\n      font-weight: 750;\n      letter-spacing: .01em;\n    }\n    .announcement a { text-decoration: underline; text-underline-offset: 3px; }\n\n    header {\n      position: relative;\n      z-index: 2;\n      background: rgba(248, 247, 241, .94);\n      border-bottom: 1px solid rgba(24, 43, 73, .07);\n    }\n    .nav {\n      min-height: 78px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 28px;\n    }\n    .brand {\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      font-size: 1.35rem;\n      font-weight: 900;\n      letter-spacing: -.06em;\n    }\n    .brand-mark {\n      width: 38px;\n      height: 38px;\n      display: grid;\n      place-items: center;\n      color: var(--ink);\n      background: var(--teal);\n      border-radius: 13px 13px 13px 5px;\n      transform: rotate(-5deg);\n    }\n    .brand-mark svg { transform: rotate(5deg); }\n    .nav-links { display: flex; align-items: center; gap: 30px; }\n    .nav-links a { font-size: .94rem; font-weight: 700; }\n    .nav-links a:hover { color: #4665cf; }\n    .button {\n      min-height: 48px;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      padding: 0 22px;\n      border: 0;\n      border-radius: 999px;\n      color: var(--white);\n      background: var(--ink);\n      font: inherit;\n      font-size: .94rem;\n      font-weight: 800;\n      transition: transform .2s ease, box-shadow .2s ease;\n    }\n    .button:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(24,43,73,.18); }\n    .button.coral { background: var(--coral); color: #291e2a; }\n    .button.small { min-height: 42px; padding-inline: 18px; }\n\n    .hero { padding: 58px 0 72px; overflow: hidden; }\n    .hero-grid {\n      display: grid;\n      grid-template-columns: 1.02fr .98fr;\n      align-items: center;\n      gap: 38px;\n    }\n    .eyebrow {\n      display: inline-flex;\n      align-items: center;\n      gap: 9px;\n      margin: 0 0 18px;\n      color: #4665cf;\n      font-size: .78rem;\n      font-weight: 900;\n      letter-spacing: .13em;\n      text-transform: uppercase;\n    }\n    .eyebrow::before {\n      content: \"\";\n      width: 22px;\n      height: 3px;\n      border-radius: 5px;\n      background: var(--coral);\n    }\n    h1, h2, h3, p { margin-top: 0; }\n    h1 {\n      max-width: 620px;\n      margin-bottom: 20px;\n      font-size: clamp(3.1rem, 6.7vw, 5.6rem);\n      line-height: .98;\n      letter-spacing: -.075em;\n    }\n    h1 span { color: #5277e7; }\n    .hero-copy {\n      max-width: 480px;\n      margin-bottom: 28px;\n      color: var(--muted);\n      font-size: 1.12rem;\n    }\n    .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }\n    .text-link {\n      padding: 12px 8px;\n      font-weight: 800;\n      text-decoration: underline;\n      text-decoration-color: var(--teal);\n      text-decoration-thickness: 3px;\n      text-underline-offset: 5px;\n    }\n    .hero-note { margin-top: 22px; color: var(--muted); font-size: .9rem; }\n    .hero-note strong { color: var(--ink); }\n\n    .hero-art {\n      position: relative;\n      min-height: 440px;\n      display: grid;\n      place-items: center;\n      isolation: isolate;\n    }\n    .art-sun {\n      position: absolute;\n      z-index: -1;\n      width: min(390px, 84%);\n      aspect-ratio: 1;\n      top: 22px;\n      right: 7%;\n      background: var(--yellow);\n      border-radius: 44% 56% 49% 51% / 49% 40% 60% 51%;\n      transform: rotate(-9deg);\n    }\n    .art-blob {\n      position: absolute;\n      z-index: -2;\n      width: 83%;\n      height: 72%;\n      left: 2%;\n      bottom: 0;\n      background: #d9f1e8;\n      border-radius: 48% 52% 27% 31% / 33% 42% 58% 67%;\n      transform: rotate(7deg);\n    }\n    .hero-svg { width: min(100%, 520px); filter: drop-shadow(0 16px 16px rgba(24,43,73,.12)); }\n    .sticker {\n      position: absolute;\n      display: grid;\n      place-items: center;\n      width: 86px;\n      height: 86px;\n      border-radius: 50%;\n      font-size: 1.8rem;\n      box-shadow: var(--shadow);\n      transform: rotate(9deg);\n    }\n    .sticker.star { top: 8%; left: 2%; background: var(--coral); }\n    .sticker.planet { right: 1%; bottom: 10%; background: var(--white); transform: rotate(-10deg); }\n\n    .trust-row {\n      display: flex;\n      flex-wrap: wrap;\n      justify-content: center;\n      gap: 12px 34px;\n      padding: 22px 0;\n      border-top: 1px solid var(--line);\n      border-bottom: 1px solid var(--line);\n      color: var(--muted);\n      font-size: .9rem;\n      font-weight: 700;\n      text-align: center;\n    }\n    .trust-row span { display: inline-flex; align-items: center; gap: 8px; }\n    .trust-row b { color: var(--ink); }\n\n    section.content { padding: 88px 0; }\n    .section-head {\n      display: flex;\n      align-items: end;\n      justify-content: space-between;\n      gap: 28px;\n      margin-bottom: 32px;\n    }\n    .section-head h2 {\n      max-width: 560px;\n      margin-bottom: 0;\n      font-size: clamp(2.2rem, 4vw, 3.4rem);\n      line-height: 1.04;\n      letter-spacing: -.065em;\n    }\n    .section-head p { max-width: 350px; margin-bottom: 3px; color: var(--muted); }\n\n    .explore-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }\n    .explore-card {\n      min-height: 310px;\n      display: flex;\n      flex-direction: column;\n      overflow: hidden;\n      border: 1px solid rgba(24,43,73,.06);\n      border-radius: var(--radius);\n      background: var(--white);\n      box-shadow: 0 8px 24px rgba(24,43,73,.04);\n      transition: transform .2s ease, box-shadow .2s ease;\n    }\n    .explore-card:hover { transform: translateY(-5px); box-shadow: var(--shadow); }\n    .card-art { min-height: 160px; display: grid; place-items: center; }\n    .card-art svg { width: 150px; height: 130px; }\n    .card-art.teal { background: #d9f3ee; }\n    .card-art.pink { background: #ffe1da; }\n    .card-art.lilac { background: #e8e6ff; }\n    .card-body { padding: 22px 24px 24px; }\n    .card-body h3 { margin-bottom: 7px; font-size: 1.28rem; letter-spacing: -.035em; }\n    .card-body p { margin-bottom: 0; color: var(--muted); font-size: .94rem; }\n\n    .visit-band {\n      position: relative;\n      display: grid;\n      grid-template-columns: 1fr auto;\n      align-items: center;\n      gap: 28px;\n      overflow: hidden;\n      padding: 42px 48px;\n      border-radius: 30px;\n      background: var(--ink);\n      color: var(--white);\n    }\n    .visit-band::after {\n      content: \"\u2733\";\n      position: absolute;\n      right: 250px;\n      bottom: -68px;\n      color: rgba(72,200,189,.17);\n      font-size: 240px;\n      line-height: 1;\n      pointer-events: none;\n    }\n    .visit-band .eyebrow { color: var(--teal); }\n    .visit-band h2 {\n      max-width: 620px;\n      margin-bottom: 10px;\n      font-size: clamp(2rem, 4vw, 3.2rem);\n      line-height: 1.04;\n      letter-spacing: -.06em;\n    }\n    .visit-band p { max-width: 560px; margin-bottom: 0; color: #c8d1df; }\n    .visit-band .button { position: relative; z-index: 1; white-space: nowrap; }\n\n    .quote-section { padding: 86px 0 96px; text-align: center; }\n    .quote-section .eyebrow { justify-content: center; }\n    blockquote {\n      max-width: 800px;\n      margin: 0 auto 18px;\n      font-size: clamp(1.65rem, 3.5vw, 2.65rem);\n      line-height: 1.2;\n      font-weight: 850;\n      letter-spacing: -.05em;\n    }\n    .quote-by { color: var(--muted); font-size: .95rem; }\n\n    footer { padding: 30px 0; border-top: 1px solid var(--line); }\n    .footer-row { display: flex; align-items: center; justify-content: space-between; gap: 20px; }\n    .footer-row p { margin: 0; color: var(--muted); font-size: .88rem; }\n    .footer-links { display: flex; gap: 20px; font-size: .88rem; font-weight: 700; }\n\n    @media (max-width: 800px) {\n      .nav-links { gap: 16px; }\n      .nav-links a:not(.button) { display: none; }\n      .hero-grid { grid-template-columns: 1fr; gap: 10px; }\n      .hero { padding-top: 46px; }\n      .hero-art { min-height: 370px; }\n      .section-head { align-items: start; flex-direction: column; }\n      .explore-grid { grid-template-columns: 1fr 1fr; }\n      .explore-card:last-child { grid-column: 1 / -1; }\n      .visit-band { grid-template-columns: 1fr; padding: 36px; }\n      .visit-band .button { justify-self: start; }\n    }\n    @media (max-width: 540px) {\n      .wrap { width: min(100% - 32px, 1160px); }\n      .announcement { font-size: .78rem; }\n      .nav { min-height: 68px; }\n      .brand { font-size: 1.2rem; }\n      .nav .button { min-height: 40px; padding-inline: 14px; font-size: .85rem; }\n      h1 { font-size: clamp(3rem, 15vw, 4.5rem); }\n      .hero-art { min-height: 300px; }\n      .sticker { width: 62px; height: 62px; font-size: 1.4rem; }\n      section.content { padding: 64px 0; }\n      .explore-grid { grid-template-columns: 1fr; }\n      .explore-card:last-child { grid-column: auto; }\n      .explore-card { min-height: 0; }\n      .visit-band { padding: 30px 24px; border-radius: 24px; }\n      .visit-band::after { right: -30px; }\n      .footer-row { align-items: flex-start; flex-direction: column; }\n    }\n    @media (prefers-reduced-motion: reduce) {\n      *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"announcement\">\n    Little scientists, big summer energy \u2014 <a href=\"#visit\">see what\u2019s on this week</a>\n  </div>\n\n  <header>\n    <div class=\"wrap nav\">\n      <a class=\"brand\" href=\"#\" aria-label=\"Wonderlab home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M9 3h6M10 3v6l-5.2 8.3A2.4 2.4 0 0 0 6.8 21h10.4a2.4 2.4 0 0 0 2-3.7L14 9V3\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            <path d=\"M8 15h8M10 12h4\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n          </svg>\n        </span>\n        wonderlab\n      </a>\n      <nav class=\"nav-links\" aria-label=\"Main navigation\">\n        <a href=\"#discover\">Explore</a>\n        <a href=\"#visit\">Plan your visit</a>\n        <a href=\"#about\">Our story</a>\n        <a class=\"button small\" href=\"#visit\">Get tickets <span aria-hidden=\"true\">\u2197</span></a>\n      </nav>\n    </div>\n  </header>\n\n  <main>\n    <section class=\"hero\">\n      <div class=\"wrap hero-grid\">\n        <div>\n          <p class=\"eyebrow\">A hands-on science museum</p>\n          <h1>Curiosity looks <span>good</span> on you.</h1>\n          <p class=\"hero-copy\">A whole world of big questions, joyful experiments, and \u201ccan I do it again?\u201d moments\u2014for kids and their grown-ups.</p>\n          <div class=\"hero-actions\">\n            <a class=\"button coral\" href=\"#visit\">Plan your wonder day <span aria-hidden=\"true\">\u2192</span></a>\n            <a class=\"text-link\" href=\"#discover\">Take a peek around</a>\n          </div>\n          <p class=\"hero-note\"><strong>Ages 2\u201312</strong> \u00b7 Open every day \u00b7 Downtown Discovery District</p>\n        </div>\n\n        <div class=\"hero-art\" aria-label=\"Illustration of a child exploring science\">\n          <div class=\"art-sun\"></div>\n          <div class=\"art-blob\"></div>\n          <span class=\"sticker star\" aria-hidden=\"true\">\u2726</span>\n          <span class=\"sticker planet\" aria-hidden=\"true\">\ud83e\ude90</span>\n          <svg class=\"hero-svg\" viewBox=\"0 0 520 430\" role=\"img\" aria-labelledby=\"hero-title\">\n            <title id=\"hero-title\">A young scientist makes a colorful bubbling experiment</title>\n            <ellipse cx=\"270\" cy=\"388\" rx=\"170\" ry=\"19\" fill=\"#182B49\" opacity=\".12\"/>\n            <!-- floating bubbles -->\n            <circle cx=\"115\" cy=\"119\" r=\"13\" fill=\"#48C8BD\"/>\n            <circle cx=\"403\" cy=\"101\" r=\"9\" fill=\"#FF705D\"/>\n            <circle cx=\"438\" cy=\"174\" r=\"15\" fill=\"#5277E7\"/>\n            <path d=\"M89 194c9-14 17-14 26 0s17 14 26 0\" fill=\"none\" stroke=\"#5277E7\" stroke-width=\"6\" stroke-linecap=\"round\"/>\n            <!-- coat -->\n            <path d=\"M175 220c8-31 33-50 78-50 45 0 70 19 79 50l25 141H149l26-141Z\" fill=\"#5277E7\"/>\n            <path d=\"m235 174 19 26 20-26-10-24h-20l-9 24Z\" fill=\"#FF705D\"/>\n            <path d=\"M253 200v159\" stroke=\"#DCE4FF\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n            <circle cx=\"254\" cy=\"250\" r=\"4\" fill=\"#FFD560\"/>\n            <circle cx=\"254\" cy=\"285\" r=\"4\" fill=\"#FFD560\"/>\n            <!-- head and hair -->\n            <path d=\"M195 114c0-44 27-72 65-72s66 28 66 72v33c0 40-29 70-66 70s-65-30-65-70v-33Z\" fill=\"#F2B68F\"/>\n            <path d=\"M191 126c-12-53 12-97 68-97 42 0 71 29 70 77-19-4-35-17-43-37-20 23-54 34-95 33v24Z\" fill=\"#182B49\"/>\n            <path d=\"M191 126c-4 21-2 42 7 57-20-5-31-22-29-43 1-14 9-23 22-26Z\" fill=\"#182B49\"/>\n            <path d=\"M328 121c14 3 22 14 20 30-2 16-12 28-26 31 8-19 9-39 6-61Z\" fill=\"#182B49\"/>\n            <!-- face -->\n            <path d=\"M224 137h1m66 0h1\" stroke=\"#182B49\" stroke-width=\"7\" stroke-linecap=\"round\"/>\n            <path d=\"M248 161c8 8 17 8 25 0\" fill=\"none\" stroke=\"#B75B55\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n            <circle cx=\"209\" cy=\"157\" r=\"9\" fill=\"#ED8F7F\" opacity=\".65\"/>\n            <circle cx=\"307\" cy=\"157\" r=\"9\" fill=\"#ED8F7F\" opacity=\".65\"/>\n            <!-- arms -->\n            <path d=\"M178 236c-27 17-43 39-47 66-2 14 8 23 20 17l48-42\" fill=\"#F2B68F\"/>\n            <path d=\"M326 235c29 12 49 33 57 60 4 13-5 24-18 20l-57-31\" fill=\"#F2B68F\"/>\n            <!-- beaker -->\n            <path d=\"M111 296h67l-8 59c-1 8-7 13-15 13h-22c-8 0-14-5-15-13l-7-59Z\" fill=\"#fff\" stroke=\"#182B49\" stroke-width=\"5\" stroke-linejoin=\"round\"/>\n            <path d=\"M117 329c15-8 35 8 55-1l-4 27c-1 6-5 9-12 9h-21c-6 0-10-4-11-10l-7-25Z\" fill=\"#48C8BD\"/>\n            <path d=\"M119 296v-12h51v12\" fill=\"none\" stroke=\"#182B49\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n            <circle cx=\"137\" cy=\"321\" r=\"4\" fill=\"#fff\"/><circle cx=\"153\" cy=\"338\" r=\"3\" fill=\"#fff\"/>\n            <!-- shoes -->\n            <path d=\"M157 357h46v19h-58c0-11 4-17 12-19Zm112 0h45c8 2 13 8 13 19h-62v-19Z\" fill=\"#FF705D\"/>\n            <path d=\"M150 377h53m66 0h58\" stroke=\"#182B49\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n            <!-- stars -->\n            <path d=\"m390 248 5 11 12 1-9 8 3 12-11-7-10 7 3-12-9-8 12-1 4-11Z\" fill=\"#FFD560\"/>\n            <path d=\"m115 218 4 8 9 1-7 6 2 9-8-5-8 5 2-9-7-6 9-1 4-8Z\" fill=\"#FF705D\"/>\n          </svg>\n        </div>\n      </div>\n    </section>\n\n    <div class=\"wrap trust-row\" aria-label=\"Museum highlights\">\n      <span>\u2726 <b>100+</b> things to touch</span>\n      <span>\u2726 Built for curious minds</span>\n      <span>\u2726 Big fun for little scientists</span>\n    </div>\n\n    <section class=\"content\" id=\"discover\">\n      <div class=\"wrap\">\n        <div class=\"section-head\">\n          <div>\n            <p class=\"eyebrow\">Pick a path, any path</p>\n            <h2>Wonder is around every corner.</h2>\n          </div>\n          <p>There\u2019s no \u201cright\u201d way to explore. Follow your questions, try something surprising, and see where the day takes you.</p>\n        </div>\n\n        <div class=\"explore-grid\">\n          <article class=\"explore-card\">\n            <div class=\"card-art teal\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 150 130\" fill=\"none\">\n                <path d=\"M42 22h66M50 22v32L28 98c-5 8 1 18 10 18h74c9 0 15-10 10-18L100 54V22\" fill=\"#fff\" stroke=\"#182B49\" stroke-width=\"5\" stroke-linejoin=\"round\"/>\n                <path d=\"M38 86c16-10 27 8 43-1 13-7 23-2 34 3l8 12c3 5 0 11-7 11H40c-6 0-10-6-7-11l5-14Z\" fill=\"#48C8BD\"/>\n                <circle cx=\"60\" cy=\"82\" r=\"5\" fill=\"#FFD560\"/><circle cx=\"86\" cy=\"96\" r=\"4\" fill=\"#fff\"/>\n                <path d=\"M61 53h28\" stroke=\"#182B49\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n                <circle cx=\"113\" cy=\"32\" r=\"8\" fill=\"#FF705D\"/><circle cx=\"29\" cy=\"49\" r=\"5\" fill=\"#5277E7\"/>\n              </svg>\n            </div>\n            <div class=\"card-body\">\n              <h3>Messy discoveries</h3>\n              <p>Mix, fizz, splash, and ask \u201cwhat happens if\u2026?\u201d in our brilliant little lab.</p>\n            </div>\n          </article>\n\n          <article class=\"explore-card\">\n            <div class=\"card-art pink\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 150 130\" fill=\"none\">\n                <path d=\"M76 18 88 56l39 1-31 23 12 37-32-23-32 23 12-37-31-23 39-1 12-38Z\" fill=\"#FFD560\" stroke=\"#182B49\" stroke-width=\"5\" stroke-linejoin=\"round\"/>\n                <circle cx=\"76\" cy=\"74\" r=\"18\" fill=\"#FF705D\" stroke=\"#182B49\" stroke-width=\"5\"/>\n                <path d=\"m26 27 6 13 14 1-11 9 4 14-13-8-12 8 4-14-11-9 14-1 5-13Zm101 49 5 10 11 1-8 7 3 11-11-6-9 6 3-11-9-7 12-1 3-10Z\" fill=\"#5277E7\"/>\n                <path d=\"M36 109h10m66-88h8\" stroke=\"#182B49\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n              </svg>\n            </div>\n            <div class=\"card-body\">\n              <h3>Out-of-this-world</h3>\n              <p>Get hands-on with the stars, planets, and wonderfully weird space stuff.</p>\n            </div>\n          </article>\n\n          <article class=\"explore-card\">\n            <div class=\"card-art lilac\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 150 130\" fill=\"none\">\n                <path d=\"M75 110c-25-20-47-38-47-61 0-14 10-24 23-24 11 0 19 7 24 17 5-10 13-17 24-17 13 0 23 10 23 24 0 23-22 41-47 61Z\" fill=\"#48C8BD\" stroke=\"#182B49\" stroke-width=\"5\" stroke-linejoin=\"round\"/>\n                <path d=\"M52 35c-7 11-10 22-10 34m56-34c7 11 10 22 10 34\" stroke=\"#fff\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n                <circle cx=\"63\" cy=\"68\" r=\"6\" fill=\"#FF705D\"/><circle cx=\"88\" cy=\"68\" r=\"6\" fill=\"#FFD560\"/>\n                <path d=\"M68 88c5 5 10 5 15 0\" stroke=\"#182B49\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n                <path d=\"m23 44-10-6m124 6 10-6M75 13V5\" stroke=\"#5277E7\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n              </svg>\n            </div>\n            <div class=\"card-body\">\n              <h3>Body detective</h3>\n              <p>Discover the amazing machine you are, from wiggly muscles to a beating heart.</p>\n            </div>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"wrap\" id=\"visit\">\n      <div class=\"visit-band\">\n        <div>\n          <p class=\"eyebrow\">Make a day of it</p>\n          <h2>More \u201cwow!\u201d per square foot.</h2>\n          <p>Come for an hour or stay until closing. Little explorers under 2 get in free, and grown-ups are part of the fun.</p>\n        </div>\n        <a class=\"button coral\" href=\"mailto:hello@wonderlab.example\">Get tickets <span aria-hidden=\"true\">\u2192</span></a>\n      </div>\n    </section>\n\n    <section class=\"quote-section\" id=\"about\">\n      <div class=\"wrap\">\n        <p class=\"eyebrow\">The Wonderlab feeling</p>\n        <blockquote>\u201cWe came for an hour. We stayed for four. My kid hasn\u2019t stopped talking about the bubbles.\u201d</blockquote>\n        <p class=\"quote-by\">\u2014 Jamie, Wonderlab grown-up</p>\n      </div>\n    </section>\n  </main>\n\n  <footer>\n    <div class=\"wrap footer-row\">\n      <a class=\"brand\" href=\"#\" aria-label=\"Wonderlab home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\u2733</span> wonderlab\n      </a>\n      <p>Made for curious kids & the people who love them.</p>\n      <div class=\"footer-links\">\n        <a href=\"#visit\">Hours & tickets</a>\n        <a href=\"mailto:hello@wonderlab.example\">Contact</a>\n      </div>\n    </div>\n  </footer>\n</body>\n</html>\n"}