{"brief": "B4", "model": "anthropic/claude-haiku-5.5", "i": 0, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Wren Hollow Press \u2014 Poetry in Small Editions</title>\n  <meta name=\"description\" content=\"Wren Hollow Press publishes poetry in small, hand-finished editions. Browse the catalogue, read samples, and find out how to submit.\">\n  <style>\n    :root {\n      --paper: #f5f0e6;\n      --paper-deep: #ebe3d3;\n      --ink: #1f1b16;\n      --muted: #6a6256;\n      --rule: #d6ccba;\n      --oxblood: #7a2e2a;\n      --oxblood-dark: #5d221f;\n      --moss: #3e4a3b;\n      --serif: \"Iowan Old Style\", \"Palatino Linotype\", Palatino, \"Book Antiqua\", Georgia, \"Times New Roman\", serif;\n      --sans: \"Helvetica Neue\", Helvetica, Arial, system-ui, sans-serif;\n      --max: 1120px;\n    }\n\n    *, *::before, *::after { box-sizing: border-box; }\n\n    html { scroll-behavior: smooth; }\n\n    body {\n      margin: 0;\n      background: var(--paper);\n      color: var(--ink);\n      font-family: var(--serif);\n      font-size: 1.0625rem;\n      line-height: 1.6;\n      -webkit-font-smoothing: antialiased;\n    }\n\n    img, svg { display: block; max-width: 100%; }\n\n    a { color: inherit; }\n\n    :focus-visible {\n      outline: 2px solid var(--oxblood);\n      outline-offset: 3px;\n    }\n\n    .wrap {\n      width: min(100% - 3rem, var(--max));\n      margin-inline: auto;\n    }\n\n    .eyebrow {\n      font-family: var(--sans);\n      font-size: 0.75rem;\n      letter-spacing: 0.18em;\n      text-transform: uppercase;\n      color: var(--muted);\n      margin: 0 0 1rem;\n    }\n\n    h1, h2, h3 {\n      font-weight: 400;\n      line-height: 1.1;\n      margin: 0;\n      letter-spacing: -0.01em;\n    }\n\n    h2 {\n      font-size: clamp(2rem, 4vw, 2.75rem);\n      margin-bottom: 1rem;\n    }\n\n    h3 { font-size: 1.35rem; }\n\n    p { margin: 0 0 1rem; }\n\n    .section { padding: clamp(4rem, 9vw, 7rem) 0; }\n\n    .rule {\n      border: 0;\n      border-top: 1px solid var(--rule);\n      margin: 0;\n    }\n\n    /* Buttons */\n    .btn {\n      display: inline-block;\n      font-family: var(--sans);\n      font-size: 0.9rem;\n      letter-spacing: 0.04em;\n      text-decoration: none;\n      padding: 0.8rem 1.4rem;\n      border: 1px solid var(--ink);\n      color: var(--ink);\n      background: transparent;\n      cursor: pointer;\n      transition: background-color .2s, color .2s, border-color .2s;\n    }\n    .btn:hover { background: var(--ink); color: var(--paper); }\n    .btn--solid { background: var(--ink); color: var(--paper); }\n    .btn--solid:hover { background: var(--oxblood); border-color: var(--oxblood); }\n    .link {\n      font-family: var(--sans);\n      font-size: 0.9rem;\n      text-decoration: underline;\n      text-underline-offset: 4px;\n      text-decoration-thickness: 1px;\n    }\n    .link:hover { color: var(--oxblood); }\n\n    /* Header */\n    .site-header {\n      position: sticky;\n      top: 0;\n      z-index: 10;\n      background: color-mix(in srgb, var(--paper) 92%, transparent);\n      backdrop-filter: blur(6px);\n      border-bottom: 1px solid var(--rule);\n    }\n    .site-header .wrap {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      height: 72px;\n      gap: 1.5rem;\n    }\n    .brand {\n      text-decoration: none;\n      display: flex;\n      flex-direction: column;\n      line-height: 1;\n    }\n    .brand__name {\n      font-size: 1.25rem;\n      letter-spacing: 0.02em;\n    }\n    .brand__sub {\n      font-family: var(--sans);\n      font-size: 0.6rem;\n      letter-spacing: 0.3em;\n      text-transform: uppercase;\n      color: var(--muted);\n      margin-top: 0.35rem;\n    }\n    .nav {\n      display: flex;\n      align-items: center;\n      gap: 2rem;\n    }\n    .nav a {\n      font-family: var(--sans);\n      font-size: 0.9rem;\n      text-decoration: none;\n      color: var(--ink);\n    }\n    .nav a:hover { color: var(--oxblood); }\n    .nav .btn { padding: 0.55rem 1rem; }\n\n    .menu-toggle {\n      display: none;\n      background: none;\n      border: 1px solid var(--ink);\n      font-family: var(--sans);\n      font-size: 0.85rem;\n      padding: 0.45rem 0.85rem;\n      cursor: pointer;\n      color: var(--ink);\n    }\n\n    /* Hero */\n    .hero { padding: clamp(4rem, 10vw, 8rem) 0 clamp(4rem, 8vw, 6rem); }\n    .hero__grid {\n      display: grid;\n      grid-template-columns: 1.15fr 0.85fr;\n      gap: clamp(2rem, 5vw, 5rem);\n      align-items: center;\n    }\n    .hero h1 {\n      font-size: clamp(2.8rem, 6.4vw, 5rem);\n      max-width: 13ch;\n    }\n    .hero h1 em {\n      font-style: italic;\n      color: var(--oxblood);\n    }\n    .hero__lede {\n      font-size: 1.2rem;\n      color: var(--muted);\n      max-width: 40ch;\n      margin: 1.5rem 0 2.25rem;\n    }\n    .hero__actions {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 0.9rem 1.25rem;\n      align-items: center;\n    }\n\n    .hero__card {\n      position: relative;\n      background: var(--paper-deep);\n      border: 1px solid var(--rule);\n      padding: clamp(2rem, 4vw, 3rem);\n      box-shadow: 10px 10px 0 var(--rule);\n    }\n    .hero__card blockquote {\n      margin: 0;\n      font-style: italic;\n      font-size: 1.2rem;\n      line-height: 1.75;\n    }\n    .hero__card blockquote p { margin: 0; }\n    .hero__card figcaption {\n      margin-top: 1.5rem;\n      font-family: var(--sans);\n      font-size: 0.8rem;\n      letter-spacing: 0.06em;\n      color: var(--muted);\n    }\n    .hero__card .ornament {\n      width: 48px;\n      margin-bottom: 1.5rem;\n      color: var(--oxblood);\n    }\n\n    /* Book covers (pure CSS/SVG, no external images) */\n    .cover {\n      position: relative;\n      aspect-ratio: 2 / 3;\n      width: 100%;\n      padding: 1.5rem 1.25rem 1.25rem 1.6rem;\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      color: var(--paper);\n      box-shadow: 0 1px 0 rgba(0,0,0,.2), 8px 10px 22px -10px rgba(31,27,22,.45);\n      overflow: hidden;\n    }\n    .cover::before {\n      /* spine */\n      content: \"\";\n      position: absolute;\n      left: 0; top: 0; bottom: 0;\n      width: 0.6rem;\n      background: rgba(0,0,0,.18);\n      box-shadow: inset -1px 0 0 rgba(255,255,255,.08);\n    }\n    .cover__title {\n      font-size: clamp(1.25rem, 2.4vw, 1.75rem);\n      line-height: 1.05;\n      margin: 0;\n    }\n    .cover__author {\n      font-family: var(--sans);\n      font-size: 0.68rem;\n      letter-spacing: 0.22em;\n      text-transform: uppercase;\n      opacity: .85;\n    }\n    .cover__mark {\n      width: 42%;\n      opacity: .75;\n      align-self: center;\n    }\n    .cover--1 { background: linear-gradient(160deg, #8a3430, #5d221f); }\n    .cover--2 { background: linear-gradient(170deg, #3e4a3b, #242c23); }\n    .cover--3 { background: linear-gradient(165deg, #d9c9a6, #bfa982); color: var(--ink); }\n    .cover--4 { background: linear-gradient(175deg, #2d3a4a, #18202a); }\n    .cover--5 { background: linear-gradient(160deg, #b5673f, #7d4126); }\n    .cover--6 { background: linear-gradient(170deg, #e7dcc4, #cfc2a4); color: var(--ink); }\n\n    /* Featured */\n    .featured {\n      background: var(--paper-deep);\n      border-top: 1px solid var(--rule);\n      border-bottom: 1px solid var(--rule);\n    }\n    .featured__grid {\n      display: grid;\n      grid-template-columns: minmax(200px, 320px) 1fr;\n      gap: clamp(2rem, 6vw, 6rem);\n      align-items: center;\n    }\n    .featured .cover { max-width: 320px; }\n    .featured__meta {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 0.5rem 1.5rem;\n      font-family: var(--sans);\n      font-size: 0.85rem;\n      color: var(--muted);\n      margin: 1.25rem 0 2rem;\n    }\n    .featured__meta span + span::before {\n      content: \"\u00b7\";\n      margin-right: 1.5rem;\n    }\n    .featured h2 { font-size: clamp(2.2rem, 4.5vw, 3.4rem); }\n    .featured .by {\n      font-style: italic;\n      color: var(--muted);\n      margin-bottom: 1.5rem;\n    }\n    .featured .excerpt {\n      border-left: 2px solid var(--oxblood);\n      padding: 0.25rem 0 0.25rem 1.5rem;\n      margin: 2rem 0;\n      font-size: 1.1rem;\n      font-style: italic;\n      max-width: 46ch;\n    }\n\n    /* Catalogue */\n    .section-head {\n      display: flex;\n      justify-content: space-between;\n      align-items: flex-end;\n      gap: 2rem;\n      flex-wrap: wrap;\n      margin-bottom: 3rem;\n    }\n    .section-head p { color: var(--muted); max-width: 42ch; margin: 0; }\n\n    .catalogue {\n      display: grid;\n      grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));\n      gap: 3rem 2.25rem;\n      list-style: none;\n      padding: 0;\n      margin: 0;\n    }\n    .book { display: flex; flex-direction: column; }\n    .book .cover { margin-bottom: 1.25rem; }\n    .book h3 { margin-bottom: 0.35rem; }\n    .book__author {\n      font-family: var(--sans);\n      font-size: 0.85rem;\n      color: var(--muted);\n      margin-bottom: 0.75rem;\n    }\n    .book__desc {\n      font-size: 0.95rem;\n      color: var(--muted);\n      margin-bottom: 1rem;\n    }\n    .tag {\n      font-family: var(--sans);\n      font-size: 0.7rem;\n      letter-spacing: 0.12em;\n      text-transform: uppercase;\n      border: 1px solid var(--rule);\n      padding: 0.2rem 0.55rem;\n      align-self: flex-start;\n      margin-top: auto;\n      color: var(--moss);\n    }\n    .tag--sold { color: var(--muted); }\n\n    /* Quote band */\n    .band {\n      background: var(--ink);\n      color: var(--paper);\n      padding: clamp(4rem, 9vw, 6.5rem) 0;\n      text-align: center;\n    }\n    .band blockquote {\n      margin: 0 auto;\n      max-width: 28ch;\n      font-size: clamp(1.7rem, 3.8vw, 2.6rem);\n      line-height: 1.3;\n      font-style: italic;\n    }\n    .band cite {\n      display: block;\n      margin-top: 1.75rem;\n      font-family: var(--sans);\n      font-style: normal;\n      font-size: 0.75rem;\n      letter-spacing: 0.2em;\n      text-transform: uppercase;\n      opacity: .65;\n    }\n\n    /* Submissions */\n    .submit__grid {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: clamp(2rem, 6vw, 6rem);\n    }\n    .status {\n      display: inline-flex;\n      align-items: center;\n      gap: 0.6rem;\n      font-family: var(--sans);\n      font-size: 0.9rem;\n      margin-bottom: 1.5rem;\n    }\n    .status::before {\n      content: \"\";\n      width: 9px;\n      height: 9px;\n      border-radius: 50%;\n      background: var(--moss);\n      box-shadow: 0 0 0 4px color-mix(in srgb, var(--moss) 18%, transparent);\n    }\n    .status--closed::before { background: var(--oxblood); box-shadow: 0 0 0 4px color-mix(in srgb, var(--oxblood) 18%, transparent); }\n    dl.guidelines {\n      margin: 0;\n      font-family: var(--sans);\n      font-size: 0.95rem;\n    }\n    dl.guidelines > div {\n      display: grid;\n      grid-template-columns: 9.5rem 1fr;\n      gap: 1rem;\n      padding: 1rem 0;\n      border-top: 1px solid var(--rule);\n    }\n    dl.guidelines > div:last-child { border-bottom: 1px solid var(--rule); }\n    dl.guidelines dt {\n      font-size: 0.72rem;\n      letter-spacing: 0.16em;\n      text-transform: uppercase;\n      color: var(--muted);\n      padding-top: 0.2rem;\n    }\n    dl.guidelines dd { margin: 0; }\n\n    /* About */\n    .about {\n      background: var(--paper-deep);\n      border-top: 1px solid var(--rule);\n    }\n    .about__grid {\n      display: grid;\n      grid-template-columns: 1fr 1.4fr;\n      gap: clamp(2rem, 6vw, 6rem);\n      align-items: start;\n    }\n    .about__body { font-size: 1.1rem; }\n    .about__body p:first-child::first-letter {\n      float: left;\n      font-size: 4.2rem;\n      line-height: .9;\n      padding: .45rem .6rem 0 0;\n      color: var(--oxblood);\n    }\n    .facts {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 1.5rem;\n      margin-top: 2.5rem;\n      font-family: var(--sans);\n    }\n    .facts strong {\n      display: block;\n      font-family: var(--serif);\n      font-size: 2.4rem;\n      font-weight: 400;\n      color: var(--oxblood);\n      line-height: 1;\n      margin-bottom: .4rem;\n    }\n    .facts span { font-size: .85rem; color: var(--muted); }\n\n    /* Newsletter */\n    .subscribe { text-align: center; }\n    .subscribe p { color: var(--muted); }\n    .subscribe__form {\n      display: flex;\n      max-width: 520px;\n      margin: 2rem auto 0;\n      border-bottom: 1px solid var(--ink);\n    }\n    .subscribe__form input {\n      flex: 1;\n      min-width: 0;\n      background: transparent;\n      border: 0;\n      padding: 0.9rem 0.25rem;\n      font: inherit;\n      color: var(--ink);\n    }\n    .subscribe__form input::placeholder { color: var(--muted); opacity: .8; }\n    .subscribe__form input:focus { outline: none; }\n    .subscribe__form button {\n      background: none;\n      border: 0;\n      font-family: var(--sans);\n      font-size: 0.9rem;\n      letter-spacing: 0.04em;\n      padding: 0 0.25rem 0 1rem;\n      cursor: pointer;\n      color: var(--oxblood);\n    }\n    .subscribe__form button:hover { text-decoration: underline; }\n    .subscribe__note {\n      font-family: var(--sans);\n      font-size: 0.8rem;\n      margin-top: 1rem;\n      min-height: 1.2em;\n    }\n\n    /* Footer */\n    .site-footer {\n      border-top: 1px solid var(--rule);\n      padding: 3rem 0 2.5rem;\n      font-family: var(--sans);\n      font-size: 0.85rem;\n      color: var(--muted);\n    }\n    .site-footer .wrap {\n      display: flex;\n      flex-wrap: wrap;\n      justify-content: space-between;\n      gap: 2rem;\n    }\n    .site-footer ul {\n      list-style: none;\n      padding: 0;\n      margin: 0;\n      display: flex;\n      gap: 1.5rem;\n      flex-wrap: wrap;\n    }\n    .site-footer a { color: var(--ink); text-decoration: none; }\n    .site-footer a:hover { color: var(--oxblood); }\n    .colophon {\n      width: 100%;\n      margin-top: 1rem;\n      font-size: 0.78rem;\n      opacity: .85;\n    }\n\n    /* Responsive */\n    @media (max-width: 900px) {\n      .hero__grid,\n      .featured__grid,\n      .submit__grid,\n      .about__grid { grid-template-columns: 1fr; }\n      .hero__card { max-width: 520px; }\n      .featured .cover { max-width: 260px; }\n    }\n\n    @media (max-width: 760px) {\n      .menu-toggle { display: inline-block; }\n      .nav {\n        display: none;\n        position: absolute;\n        top: 72px;\n        left: 0;\n        right: 0;\n        flex-direction: column;\n        align-items: stretch;\n        gap: 0;\n        background: var(--paper);\n        border-bottom: 1px solid var(--rule);\n      }\n      .nav.is-open { display: flex; }\n      .nav a {\n        padding: 1rem 1.5rem;\n        border-top: 1px solid var(--rule);\n      }\n      .nav .btn { margin: 1rem 1.5rem; text-align: center; }\n      .site-header .wrap { position: relative; }\n      .facts { grid-template-columns: 1fr; }\n      dl.guidelines > div { grid-template-columns: 1fr; gap: .35rem; }\n    }\n\n    @media (max-width: 480px) {\n      .subscribe__form { flex-direction: column; border-bottom: 0; gap: .75rem; }\n      .subscribe__form input { border-bottom: 1px solid var(--ink); }\n      .subscribe__form button { padding: .75rem 0; text-align: left; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      html { scroll-behavior: auto; }\n      * { transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n\n  <!-- Header -->\n  <header class=\"site-header\">\n    <div class=\"wrap\">\n      <a class=\"brand\" href=\"#top\" aria-label=\"Wren Hollow Press home\">\n        <span class=\"brand__name\">Wren Hollow</span>\n        <span class=\"brand__sub\">Press \u00b7 Est. 2014</span>\n      </a>\n\n      <button class=\"menu-toggle\" aria-expanded=\"false\" aria-controls=\"primary-nav\">Menu</button>\n\n      <nav class=\"nav\" id=\"primary-nav\" aria-label=\"Primary\">\n        <a href=\"#catalogue\">Catalogue</a>\n        <a href=\"#submit\">Submit</a>\n        <a href=\"#about\">About</a>\n        <a class=\"btn\" href=\"#subscribe\">Subscribe</a>\n      </nav>\n    </div>\n  </header>\n\n  <main id=\"top\">\n\n    <!-- Hero -->\n    <section class=\"hero\">\n      <div class=\"wrap hero__grid\">\n        <div>\n          <p class=\"eyebrow\">Poetry \u00b7 Small editions \u00b7 Hand-finished</p>\n          <h1>Books of verse, <em>printed slowly</em>, in runs of two hundred.</h1>\n          <p class=\"hero__lede\">\n            Wren Hollow publishes a handful of collections each year: debut voices,\n            long-form sequences, and translations that take their time. Every book is\n            set in type, sewn by hand, and sent out with a letter.\n          </p>\n          <div class=\"hero__actions\">\n            <a class=\"btn btn--solid\" href=\"#catalogue\">Browse the catalogue</a>\n            <a class=\"link\" href=\"#featured\">Read the new release</a>\n          </div>\n        </div>\n\n        <figure class=\"hero__card\" aria-label=\"Sample poem\">\n          <svg class=\"ornament\" viewBox=\"0 0 48 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" aria-hidden=\"true\">\n            <path d=\"M2 12h16M30 12h16\"/>\n            <circle cx=\"24\" cy=\"12\" r=\"4\"/>\n            <circle cx=\"24\" cy=\"12\" r=\"10\" opacity=\".4\"/>\n          </svg>\n          <blockquote>\n            <p>The lamp was left on for no one.<br>\n            Still the moths came in from the dark,<br>\n            as if the house had said their names<br>\n            and meant them.</p>\n          </blockquote>\n          <figcaption>From <em>Low Water Almanac</em>, poems by Ingrid Adeyemi-Holt</figcaption>\n        </figure>\n      </div>\n    </section>\n\n    <!-- Featured -->\n    <section class=\"section featured\" id=\"featured\" aria-labelledby=\"featured-title\">\n      <div class=\"wrap featured__grid\">\n        <div class=\"cover cover--1\" role=\"img\" aria-label=\"Cover of The Salt Ledger\">\n          <p class=\"cover__author\">Tomas Varga</p>\n          <svg class=\"cover__mark\" viewBox=\"0 0 100 100\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.2\" aria-hidden=\"true\">\n            <circle cx=\"50\" cy=\"50\" r=\"38\"/>\n            <circle cx=\"50\" cy=\"50\" r=\"26\" opacity=\".6\"/>\n            <path d=\"M50 12v76M12 50h76\" opacity=\".35\"/>\n          </svg>\n          <h2 class=\"cover__title\">The Salt Ledger</h2>\n        </div>\n\n        <div>\n          <p class=\"eyebrow\">New this season</p>\n          <h2 id=\"featured-title\">The Salt Ledger</h2>\n          <p class=\"by\">Tomas Varga</p>\n          <p>\n            A sequence of forty-one poems arranged as accounts: what the coast gave,\n            what it kept, and what the family owed the water by the end of the century.\n            Varga writes with a surveyor's patience and a widow's restraint.\n          </p>\n          <p class=\"excerpt\">\n            \"Enter the tide as you would enter a debt: willingly, and with the receipt already folded in your pocket.\"\n          </p>\n          <div class=\"featured__meta\">\n            <span>64 pages</span>\n            <span>Letterpress, cloth spine</span>\n            <span>Edition of 200</span>\n          </div>\n          <div class=\"hero__actions\">\n            <a class=\"btn btn--solid\" href=\"#order\">Order a copy \u00b7 $28</a>\n            <a class=\"link\" href=\"#sample\">Read the first poem</a>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Catalogue -->\n    <section class=\"section\" id=\"catalogue\" aria-labelledby=\"catalogue-title\">\n      <div class=\"wrap\">\n        <div class=\"section-head\">\n          <div>\n            <p class=\"eyebrow\">Catalogue</p>\n            <h2 id=\"catalogue-title\">Recent titles</h2>\n          </div>\n          <p>Every title is in print in a single run. When a run sells out, we do not reprint; the book simply becomes harder to find.</p>\n        </div>\n\n        <ul class=\"catalogue\">\n          <li class=\"book\">\n            <div class=\"cover cover--2\" role=\"img\" aria-label=\"Cover of Low Water Almanac\">\n              <p class=\"cover__author\">Ingrid Adeyemi-Holt</p>\n              <h3 class=\"cover__title\">Low Water Almanac</h3>\n            </div>\n            <h3>Low Water Almanac</h3>\n            <p class=\"book__author\">Ingrid Adeyemi-Holt</p>\n            <p class=\"book__desc\">Poems arranged by the months of a river that no longer floods.</p>\n            <span class=\"tag tag--sold\">Sold out</span>\n          </li>\n\n          <li class=\"book\">\n            <div class=\"cover cover--3\" role=\"img\" aria-label=\"Cover of Orchard, Winter\">\n              <p class=\"cover__author\">Mateo Ruiz Kemp</p>\n              <h3 class=\"cover__title\">Orchard, Winter</h3>\n              <svg class=\"cover__mark\" viewBox=\"0 0 100 100\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.2\" aria-hidden=\"true\">\n                <path d=\"M50 90V40M50 40C30 40 22 25 26 10M50 40C70 40 78 25 74 10M50 58C36 58 30 50 32 42\"/>\n              </svg>\n            </div>\n            <h3>Orchard, Winter</h3>\n            <p class=\"book__author\">Mateo Ruiz Kemp</p>\n            <p class=\"book__desc\">Short lyrics written in the dormant months, after the harvest is over.</p>\n            <span class=\"tag\">Available</span>\n          </li>\n\n          <li class=\"book\">\n            <div class=\"cover cover--4\" role=\"img\" aria-label=\"Cover of Dead Reckoning, Translated\">\n              <p class=\"cover__author\">Translated by Hana Ostrow</p>\n              <h3 class=\"cover__title\">Dead Reckoning</h3>\n            </div>\n            <h3>Dead Reckoning</h3>\n            <p class=\"book__author\">Selected poems of Ond\u0159ej Kulh\u00e1nek, translated by Hana Ostrow</p>\n            <p class=\"book__desc\">The first English selection of a poet who wrote in the margins of ship manifests.</p>\n            <span class=\"tag\">Available</span>\n          </li>\n\n          <li class=\"book\">\n            <div class=\"cover cover--5\" role=\"img\" aria-label=\"Cover of Brick and Bread\">\n              <p class=\"cover__author\">Dara Nwosu</p>\n              <h3 class=\"cover__title\">Brick and Bread</h3>\n            </div>\n            <h3>Brick and Bread</h3>\n            <p class=\"book__author\">Dara Nwosu</p>\n            <p class=\"book__desc\">Poems about a bakery, a demolition, and the people who stood in the dust.</p>\n            <span class=\"tag\">Available</span>\n          </li>\n\n          <li class=\"book\">\n            <div class=\"cover cover--6\" role=\"img\" aria-label=\"Cover of Notes Toward a Quieter House\">\n              <p class=\"cover__author\">Lior Abramovich</p>\n              <h3 class=\"cover__title\">Notes Toward a Quieter House</h3>\n            </div>\n            <h3>Notes Toward a Quieter House</h3>\n            <p class=\"book__author\">Lior Abramovich</p>\n            <p class=\"book__desc\">Domestic poems in prose-length lines, written during a long illness.</p>\n            <span class=\"tag\">Available</span>\n          </li>\n\n          <li class=\"book\">\n            <div class=\"cover cover--1\" role=\"img\" aria-label=\"Cover of Glasswork\">\n              <p class=\"cover__author\">Esme Partridge</p>\n              <h3 class=\"cover__title\">Glasswork</h3>\n            </div>\n            <h3>Glasswork</h3>\n            <p class=\"book__author\">Esme Partridge</p>\n            <p class=\"book__desc\">A debut collection of sonnets that break at the final line.</p>\n            <span class=\"tag\">Available</span>\n          </li>\n        </ul>\n      </div>\n    </section>\n\n    <!-- Quote band -->\n    <section class=\"band\" aria-label=\"Reader response\">\n      <div class=\"wrap\">\n        <blockquote>\n          \"Each book arrived as if someone had carried it across a field to my door.\"\n          <cite>Reader letter, Spring list</cite>\n        </blockquote>\n      </div>\n    </section>\n\n    <!-- Submissions -->\n    <section class=\"section\" id=\"submit\" aria-labelledby=\"submit-title\">\n      <div class=\"wrap submit__grid\">\n        <div>\n          <p class=\"eyebrow\">Submissions</p>\n          <h2 id=\"submit-title\">We are reading for the autumn list.</h2>\n          <p class=\"status\">Open until 30 September</p>\n          <p>\n            We publish four to five books a year and read unsolicited manuscripts\n            in two windows. We are especially interested in book-length work that\n            holds together as a whole, and in poets who have not yet had a full collection.\n          </p>\n          <p>\n            Please send one manuscript at a time. We will reply to every submission,\n            though it may take up to twelve weeks.\n          </p>\n          <a class=\"btn btn--solid\" href=\"mailto:manuscripts@wrenhollow.example?subject=Manuscript%20submission\">Email a manuscript</a>\n        </div>\n\n        <dl class=\"guidelines\">\n          <div>\n            <dt>Length</dt>\n            <dd>48 to 90 pages of poems, excluding front matter</dd>\n          </div>\n          <div>\n            <dt>Format</dt>\n            <dd>Single PDF, 12-point serif, one poem per page where possible</dd>\n          </div>\n          <div>\n            <dt>Cover letter</dt>\n            <dd>Under 300 words. Tell us about the book, not your biography.</dd>\n          </div>\n          <div>\n            <dt>Simultaneous</dt>\n            <dd>Welcome, but please tell us if the manuscript is accepted elsewhere.</dd>\n          </div>\n          <div>\n            <dt>Fee</dt>\n            <dd>None. We do not charge to read.</dd>\n          </div>\n        </dl>\n      </div>\n    </section>\n\n    <!-- About -->\n    <section class=\"section about\" id=\"about\" aria-labelledby=\"about-title\">\n      <div class=\"wrap about__grid\">\n        <div>\n          <p class=\"eyebrow\">About the press</p>\n          <h2 id=\"about-title\">A small house, with a long table.</h2>\n        </div>\n        <div class=\"about__body\">\n          <p>\n            Wren Hollow began in a converted barn with a secondhand Heidelberg press and\n            a list of six poets who had been told, repeatedly, that no one reads poetry anymore.\n            We have since printed a little over fifty books. We still set most of them by hand.\n          </p>\n          <p>\n            Our editors work with every author through several drafts, and we pay\n            contributors a fixed fee rather than royalties, so that each book is\n            finished before it is sold. We keep our runs short on purpose.\n          </p>\n          <div class=\"facts\">\n            <div><strong>52</strong><span>titles in print since 2014</span></div>\n            <div><strong>200</strong><span>copies in a typical run</span></div>\n            <div><strong>3</strong><span>people, one very old press</span></div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Newsletter -->\n    <section class=\"section subscribe\" id=\"subscribe\" aria-labelledby=\"subscribe-title\">\n      <div class=\"wrap\">\n        <p class=\"eyebrow\">Letters from the press</p>\n        <h2 id=\"subscribe-title\">Four letters a year. No more.</h2>\n        <p>New releases, reading dates, and the occasional poem we could not fit into a book.</p>\n\n        <form class=\"subscribe__form\" id=\"subscribe-form\" novalidate>\n          <label for=\"email\" class=\"sr-only\" style=\"position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);\">Email address</label>\n          <input type=\"email\" id=\"email\" name=\"email\" placeholder=\"Your email address\" autocomplete=\"email\" required>\n          <button type=\"submit\">Subscribe</button>\n        </form>\n        <p class=\"subscribe__note\" id=\"subscribe-note\" role=\"status\" aria-live=\"polite\"></p>\n      </div>\n    </section>\n\n  </main>\n\n  <!-- Footer -->\n  <footer class=\"site-footer\">\n    <div class=\"wrap\">\n      <div>\n        <strong style=\"font-family: var(--serif); font-size: 1.1rem; font-weight: 400; color: var(--ink);\">Wren Hollow Press</strong>\n        <p style=\"margin: .35rem 0 0;\">14 Mill Lane, Sowerby Bridge</p>\n      </div>\n      <ul>\n        <li><a href=\"#catalogue\">Catalogue</a></li>\n        <li><a href=\"#submit\">Submit</a></li>\n        <li><a href=\"#about\">About</a></li>\n        <li><a href=\"mailto:hello@wrenhollow.example\">Contact</a></li>\n        <li><a href=\"#top\">Back to top</a></li>\n      </ul>\n      <p class=\"colophon\">Set in Iowan Old Style and printed on Mohawk Superfine. &copy; 2025 Wren Hollow Press.</p>\n    </div>\n  </footer>\n\n  <script>\n    // Mobile navigation toggle\n    (function () {\n      var toggle = document.querySelector('.menu-toggle');\n      var nav = document.getElementById('primary-nav');\n      toggle.addEventListener('click', function () {\n        var open = nav.classList.toggle('is-open');\n        toggle.setAttribute('aria-expanded', String(open));\n      });\n      nav.querySelectorAll('a').forEach(function (link) {\n        link.addEventListener('click', function () {\n          nav.classList.remove('is-open');\n          toggle.setAttribute('aria-expanded', 'false');\n        });\n      });\n    })();\n\n    // Newsletter form (client-side only; connect to your mailing service)\n    (function () {\n      var form = document.getElementById('subscribe-form');\n      var input = document.getElementById('email');\n      var note = document.getElementById('subscribe-note');\n      form.addEventListener('submit', function (e) {\n        e.preventDefault();\n        var value = input.value.trim();\n        if (!value || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(value)) {\n          note.textContent = 'Please enter a valid email address.';\n          note.style.color = 'var(--oxblood)';\n          input.focus();\n          return;\n        }\n        note.textContent = 'Thank you. The next letter is on its way.';\n        note.style.color = 'var(--moss)';\n        form.reset();\n      });\n    })();\n  </script>\n</body>\n</html>\n"}