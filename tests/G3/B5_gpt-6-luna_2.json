n      margin: 1px 0 4px;\n      font-size: .98rem;\n    }\n\n    .visit-steps p {\n      margin: 0;\n      color: var(--muted);\n      font-size: .88rem;\n    }\n\n    .visit-panel {\n      padding: 32px;\n      background: var(--ink);\n      color: white;\n      border-radius: 24px;\n      box-shadow: var(--shadow);\n    }\n\n    .visit-panel .eyebrow { color: #b8d9ca; }\n    .visit-panel .eyebrow::before { background: #ef997f; }\n\n    .visit-panel h3 {\n      margin-bottom: 20px;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: 2rem;\n      font-weight: 500;\n      letter-spacing: -.04em;\n    }\n\n    .hours-list {\n      margin: 0 0 22px;\n      padding: 0;\n      list-style: none;\n    }\n\n    .hours-list li {\n      display: flex;\n      justify-content: space-between;\n      gap: 18px;\n      padding: 10px 0;\n      border-bottom: 1px solid rgba(255, 255, 255, .16);\n      font-size: .9rem;\n    }\n\n    .hours-list span:last-child { color: #c4ddd2; }\n\n    .visit-panel .address {\n      display: flex;\n      align-items: flex-start;\n      gap: 11px;\n      margin: 0 0 20px;\n      color: #e2eee8;\n      font-size: .9rem;\n    }\n\n    .visit-panel .address svg {\n      flex: 0 0 19px;\n      width: 19px;\n      height: 19px;\n      margin-top: 3px;\n      color: #b8d9ca;\n    }\n\n    .panel-note {\n      margin: 16px 0 0;\n      color: #c4d6ce;\n      font-size: .78rem;\n      line-height: 1.5;\n    }\n\n    .panel-actions {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 10px;\n    }\n\n    .panel-actions .button-light {\n      border-color: rgba(255,255,255,.25);\n      background: transparent;\n      color: white;\n    }\n\n    .panel-actions .button-light:hover { background: rgba(255,255,255,.1); }\n\n    .comfort {\n      padding: 75px 0 !important;\n      background: var(--peach);\n    }\n\n    .comfort-inner {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      align-items: center;\n      gap: 65px;\n    }\n\n    .comfort h2 {\n      margin-bottom: 14px;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: clamp(2.3rem, 4vw, 3.35rem);\n      font-weight: 500;\n      letter-spacing: -.055em;\n      line-height: 1.08;\n    }\n\n    .comfort p {\n      margin-bottom: 0;\n      color: #5e5a54;\n    }\n\n    .comfort-quote {\n      padding: 28px 30px;\n      background: rgba(255, 254, 250, .78);\n      border-radius: 20px;\n    }\n\n    .comfort-quote p {\n      margin: 0 0 12px;\n      color: var(--ink);\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: 1.35rem;\n      line-height: 1.4;\n    }\n\n    .comfort-quote span {\n      color: var(--muted);\n      font-size: .84rem;\n    }\n\n    .faq-section { padding-bottom: 90px !important; }\n\n    .faq-list {\n      max-width: 780px;\n      margin: 0 auto;\n      border-top: 1px solid var(--line);\n    }\n\n    details { border-bottom: 1px solid var(--line); }\n\n    summary {\n      position: relative;\n      padding: 20px 40px 20px 0;\n      cursor: pointer;\n      list-style: none;\n      font-weight: 750;\n    }\n\n    summary::-webkit-details-marker { display: none; }\n\n    summary::after {\n      position: absolute;\n      top: 17px;\n      right: 3px;\n      content: \"+\";\n      color: var(--green);\n      font-size: 1.5rem;\n      font-weight: 400;\n    }\n\n    details[open] summary::after { content: \"\u2212\"; }\n\n    details p {\n      max-width: 690px;\n      margin: -2px 0 20px;\n      color: var(--muted);\n      font-size: .93rem;\n    }\n\n    .final-cta {\n      padding: 0 0 90px;\n    }\n\n    .cta-box {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 25px;\n      padding: 38px 42px;\n      background: var(--teal);\n      border-radius: 24px;\n    }\n\n    .cta-box h2 {\n      margin-bottom: 7px;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: clamp(1.9rem, 3vw, 2.6rem);\n      font-weight: 500;\n      letter-spacing: -.05em;\n    }\n\n    .cta-box p {\n      margin: 0;\n      color: var(--muted);\n    }\n\n    footer {\n      padding: 34px 0 24px;\n      background: var(--ink);\n      color: #e9f1ed;\n    }\n\n    .footer-main {\n      display: flex;\n      justify-content: space-between;\n      align-items: flex-start;\n      gap: 35px;\n      padding-bottom: 26px;\n    }\n\n    .footer-brand { color: white; }\n\n    .footer-copy {\n      max-width: 350px;\n      margin: 12px 0 0;\n      color: #bfd0c8;\n      font-size: .85rem;\n    }\n\n    .footer-links {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 18px 24px;\n      padding-top: 8px;\n    }\n\n    .footer-links a {\n      color: #e9f1ed;\n      text-decoration: none;\n      font-size: .86rem;\n    }\n\n    .footer-links a:hover { text-decoration: underline; }\n\n    .footer-bottom {\n      display: flex;\n      flex-wrap: wrap;\n      justify-content: space-between;\n      gap: 8px 20px;\n      padding-top: 18px;\n      border-top: 1px solid rgba(255,255,255,.16);\n      color: #b7cbc2;\n      font-size: .75rem;\n    }\n\n    .footer-bottom p { margin: 0; }\n\n    @media (max-width: 900px) {\n      .hero-grid { gap: 25px; }\n      .hero-art { min-height: 380px; }\n      .info-strip { padding: 22px 19px; }\n      .info-item { padding-inline: 14px; }\n      .visit-grid { gap: 40px; }\n      .comfort-inner { gap: 35px; }\n    }\n\n    @media (max-width: 700px) {\n      .wrap { width: min(100% - 36px, 540px); }\n      .nav { min-height: 70px; }\n      .nav-links { gap: 15px; }\n      .nav-links a:not(.button) { display: none; }\n      .nav-links .button { min-height: 42px; padding: 9px 15px; font-size: .85rem; }\n      .hero { padding: 52px 0 44px; }\n      .hero-grid { grid-template-columns: 1fr; gap: 22px; }\n      h1 { max-width: 550px; font-size: clamp(3rem, 13vw, 4.5rem); }\n      .hero-copy { font-size: 1rem; }\n      .hero-art { min-height: 350px; }\n      .art-blob { width: min(82vw, 350px); }\n      .care-card { width: min(300px, 76%); }\n      .floating-note { right: 2px; bottom: 12px; }\n      .quick-info { margin-top: 0; }\n      .info-strip { grid-template-columns: 1fr; gap: 0; padding: 9px 20px; }\n      .info-item, .info-item:first-child, .info-item:last-child {\n        padding: 14px 0;\n        border-right: 0;\n        border-bottom: 1px solid var(--line);\n      }\n      .info-item:last-child { border-bottom: 0; }\n      section.content-section { padding: 72px 0; }\n      .section-heading { margin-bottom: 32px; }\n      .service-grid { grid-template-columns: 1fr 1fr; gap: 12px; }\n      .service-card { min-height: 0; padding: 20px; }\n      .service-card h3 { font-size: .96rem; }\n      .service-card p { font-size: .85rem; }\n      .visit-grid { grid-template-columns: 1fr; gap: 35px; }\n      .visit-panel { padding: 26px 22px; }\n      .comfort-inner { grid-template-columns: 1fr; gap: 25px; }\n      .comfort { padding: 62px 0 !important; }\n      .cta-box { align-items: flex-start; flex-direction: column; padding: 29px 25px; }\n      .final-cta { padding-bottom: 65px; }\n      .footer-main { flex-direction: column; gap: 20px; }\n    }\n\n    @media (max-width: 420px) {\n      .topbar { font-size: .76rem; }\n      .brand { font-size: 1.04rem; }\n      .brand-mark { width: 33px; height: 33px; }\n      .hero-actions { align-items: stretch; flex-direction: column; }\n      .hero-actions .button { width: 100%; }\n      .service-grid { grid-template-columns: 1fr; }\n      .service-card { padding: 19px; }\n      .panel-actions { flex-direction: column; }\n      .panel-actions .button { width: 100%; }\n      .footer-bottom { flex-direction: column; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      html { scroll-behavior: auto; }\n      *, *::before, *::after {\n        transition-duration: .01ms !important;\n        animation-duration: .01ms !important;\n      }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"topbar\">\n    Walk in for care, no appointment needed.\n    <a href=\"#visit\">See today\u2019s hours</a>\n  </div>\n\n  <header>\n    <div class=\"wrap nav\">\n      <a class=\"brand\" href=\"#\" aria-label=\"Harbor Health home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M12 20s-7-4.35-7-10a4 4 0 0 1 7-2.65A4 4 0 0 1 19 10c0 5.65-7 10-7 10Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            <path d=\"M8.2 12h2l1.1-2.1 1.4 4.2 1.1-2.1h2\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          </svg>\n        </span>\n        Harbor Health\n      </a>\n\n      <nav class=\"nav-links\" aria-label=\"Main navigation\">\n        <a href=\"#care\">Our care</a>\n        <a href=\"#how-it-works\">What to expect</a>\n        <a href=\"#faq\">FAQs</a>\n        <a class=\"button\" href=\"#visit\">Plan your visit</a>\n      </nav>\n    </div>\n  </header>\n\n  <main>\n    <section class=\"hero\">\n      <div class=\"wrap hero-grid\">\n        <div>\n          <p class=\"eyebrow\">Walk-in sexual health clinic</p>\n          <h1>Sexual health, <em>on your terms.</em></h1>\n          <p class=\"hero-copy\">Real answers. Respectful care. Come as you are\u2014we\u2019re here to help you feel informed and supported, without judgment.</p>\n          <div class=\"hero-actions\">\n            <a class=\"button\" href=\"#visit\">\n              Visit us today\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n                <path d=\"M5 12h14m-6-6 6 6-6 6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n            </a>\n            <a class=\"button button-light\" href=\"tel:+12025550147\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n                <path d=\"M7 3H4.8A1.8 1.8 0 0 0 3 4.8C3 13.75 10.25 21 19.2 21a1.8 1.8 0 0 0 1.8-1.8V17l-5-2-1.6 2a14.1 14.1 0 0 1-6.6-6.6L9.8 8.8 7 3Z\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n              Call the clinic\n            </a>\n          </div>\n          <div class=\"reassurance\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n              <path d=\"m5 12 4 4L19 6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            </svg>\n            <span>No appointment needed. Ask us about privacy, cost, and what to expect before your visit.</span>\n          </div>\n        </div>\n\n        <div class=\"hero-art\" aria-hidden=\"true\">\n          <div class=\"art-blob\"></div>\n          <div class=\"art-sun\"></div>\n          <div class=\"care-card\">\n            <div class=\"care-card-top\">\n              <span class=\"mini-mark\">\n                <svg viewBox=\"0 0 24 24\" fill=\"none\">\n                  <path d=\"M12 20s-7-4.35-7-10a4 4 0 0 1 7-2.65A4 4 0 0 1 19 10c0 5.65-7 10-7 10Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n                  <path d=\"M8.2 12h2l1.1-2.1 1.4 4.2 1.1-2.1h2\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n                </svg>\n              </span>\n              <span class=\"card-dots\"><span></span><span></span><span></span></span>\n            </div>\n            <h2>Care that listens first.</h2>\n            <p>Your questions matter. Your choices matter. We\u2019ll take things at your pace.</p>\n            <div class=\"card-line\"></div>\n            <div class=\"card-detail\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\">\n                <path d=\"M12 8v4l3 2m6-2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n              Walk-ins welcome\n            </div>\n          </div>\n          <div class=\"floating-note\">A welcoming space, whatever brings you in.</div>\n        </div>\n      </div>\n    </section>\n\n    <div class=\"wrap quick-info\" aria-label=\"Clinic highlights\">\n      <div class=\"info-strip\">\n        <div class=\"info-item\">\n          <span class=\"info-icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\">\n              <path d=\"M12 21s7-4.35 7-11V5l-7-2-7 2v5c0 6.65 7 11 7 11Z\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              <path d=\"m9 12 2 2 4-4\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            </svg>\n          </span>\n          <div><strong>Respectful, private care</strong><span>We\u2019ll talk through your questions and options.</span></div>\n        </div>\n        <div class=\"info-item\">\n          <span class=\"info-icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\">\n              <path d=\"M12 21s7-4.35 7-11V5l-7-2-7 2v5c0 6.65 7 11 7 11Z\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              <path d=\"M12 8v8m-4-4h8\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/>\n            </svg>\n          </span>\n          <div><strong>Care in one welcoming place</strong><span>Explore services with a caring team.</span></div>\n        </div>\n        <div class=\"info-item\">\n          <span class=\"info-icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\">\n              <path d=\"M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              <circle cx=\"12\" cy=\"10\" r=\"2.5\" stroke=\"currentColor\" stroke-width=\"1.7\"/>\n            </svg>\n          </span>\n          <div><strong>Easy to find</strong><span>Central location with transit nearby.</span></div>\n        </div>\n      </div>\n    </div>\n\n    <section class=\"content-section services\" id=\"care\">\n      <div class=\"wrap\">\n        <div class=\"section-heading\">\n          <p class=\"eyebrow\">Care for you</p>\n          <h2 class=\"section-title\">Here for your questions, big or small.</h2>\n          <p>Start with what\u2019s on your mind. Our team can help you understand your options and find the right next step.</p>\n        </div>\n\n        <div class=\"service-grid\">\n          <article class=\"service-card\">\n            <span class=\"service-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\">\n                <path d=\"M9 3h6m-5 0v6.2L5.5 17a2.7 2.7 0 0 0 2.3 4h8.4a2.7 2.7 0 0 0 2.3-4L14 9.2V3\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n                <path d=\"M8 15h8\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/>\n              </svg>\n            </span>\n            <h3>STI testing & treatment</h3>\n            <p>Talk with us about testing, results, treatment, and what feels right for you.</p>\n          </article>\n\n          <article class=\"service-card\">\n            <span class=\"service-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\">\n                <path d=\"M12 21s7-4.35 7-11V5l-7-2-7 2v5c0 6.65 7 11 7 11Z\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n                <path d=\"M12 8v8m-4-4h8\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/>\n              </svg>\n            </span>\n            <h3>Birth control options</h3>\n            <p>Explore methods, get answers, and choose what works for your life.</p>\n          </article>\n\n          <article class=\"service-card\">\n            <span class=\"service-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\">\n                <path d=\"M12 21s7-4.35 7-11V5l-7-2-7 2v5c0 6.65 7 11 7 11Z\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n                <path d=\"M9 12h6\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/>\n              </svg>\n            </span>\n            <h3>PrEP & HIV prevention</h3>\n            <p>Get information about prevention, testing, and care options.</p>\n          </article>\n\n          <article class=\"service-card\">\n            <span class=\"service-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\">\n                <path d=\"M4 6h16M7 3v6m10-6v6M5 10h14v10H5z\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n                <path d=\"M9 14h2m2 0h2m-6 3h2\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/>\n              </svg>\n            </span>\n            <h3>Pregnancy testing & options</h3>\n            <p>Find a supportive place to talk through questions and next steps.</p>\n          </article>\n\n          <article class=\"service-card\">\n            <span class=\"service-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\">\n                <path d=\"M12 3v18M5.5 6.5l13 11m0-11-13 11\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/>\n                <circle cx=\"12\" cy=\"12\" r=\"9\" stroke=\"currentColor\" stroke-width=\"1.5\"/>\n              </svg>\n            </span>\n            <h3>Vaccines & prevention</h3>\n            <p>Ask our team about recommended vaccines and preventive care.</p>\n          </article>\n\n          <article class=\"service-card\">\n            <span class=\"service-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\">\n                <path d=\"M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 3H20v18H6.5A2.5 2.5 0 0 1 4 18.5v-13A2.5 2.5 0 0 1 6.5 3Z\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n                <path d=\"M8 8h8m-8 4h6\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/>\n              </svg>\n            </span>\n            <h3>Questions & education</h3>\n            <p>Get clear, judgment-free information about sexual health and wellbeing.</p>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"content-section\" id=\"how-it-works\">\n      <div class=\"wrap visit-grid\">\n        <div class=\"visit-intro\">\n          <p class=\"eyebrow\">A visit that works for you</p>\n          <h2>Simple steps.<br>People first.</h2>\n          <p>You don\u2019t need to have it all figured out before you come in. We\u2019ll help you get started.</p>\n\n          <ol class=\"visit-steps\">\n            <li>\n              <span class=\"step-number\">1</span>\n              <div>\n                <h3>Drop by during walk-in hours</h3>\n                <p>No appointment needed. Call ahead to check current availability.</p>\n              </div>\n            </li>\n            <li>\n              <span class=\"step-number\">2</span>\n              <div>\n                <h3>Tell us what you need</h3>\n                <p>Share as much or as little as you like. We\u2019ll listen and answer your questions.</p>\n              </div>\n            </li>\n            <li>\n              <span class=\"step-number\">3</span>\n              <div>\n                <h3>Choose your next step together</h3>\n                <p>Your care plan is a conversation, and your choices are part of it.</p>\n              </div>\n            </li>\n          </ol>\n        </div>\n\n        <aside class=\"visit-panel\" id=\"visit\" aria-labelledby=\"hours-title\">\n          <p class=\"eyebrow\">Come on in</p>\n          <h3 id=\"hours-title\">Walk-in hours</h3>\n          <ul class=\"hours-list\">\n            <li><span>Monday\u2013Thursday</span><span>9:00 am\u20136:00 pm</span></li>\n            <li><span>Friday</span><span>9:00 am\u20134:00 pm</span></li>\n            <li><span>Saturday\u2013Sunday</span><span>Closed</span></li>\n          </ul>\n          <p class=\"address\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n              <path d=\"M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              <circle cx=\"12\" cy=\"10\" r=\"2.5\" stroke=\"currentColor\" stroke-width=\"1.7\"/>\n            </svg>\n            <span>123 Example Street, Suite 200<br>Downtown, Brookside</span>\n          </p>\n          <div class=\"panel-actions\">\n            <a class=\"button\" href=\"tel:+12025550147\">Call (202) 555-0147</a>\n            <a class=\"button button-light\" href=\"https://maps.google.com/?q=123+Example+Street+Brookside\">Get directions</a>\n          </div>\n          <p class=\"panel-note\">Walk-in availability may change during the day. Please call before traveling if you can.</p>\n        </aside>\n      </div>\n    </section>\n\n    <section class=\"content-section comfort\">\n      <div class=\"wrap comfort-inner\">\n        <div>\n          <p class=\"eyebrow\">You belong here</p>\n          <h2>Care without assumptions.</h2>\n          <p>We welcome people of all genders, identities, backgrounds, and relationship experiences. You deserve to be heard and treated with dignity.</p>\n        </div>\n        <div class=\"comfort-quote\">\n          <p>\u201cYou can come in with one question\u2014or a whole list. We\u2019ll meet you where you are.\u201d</p>\n          <span>\u2014 The Harbor Health care team</span>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"content-section faq-section\" id=\"faq\">\n      <div class=\"wrap\">\n        <div class=\"section-heading\">\n          <p class=\"eyebrow\">Good to know</p>\n          <h2 class=\"section-title\">A few common questions.</h2>\n          <p>Have another question? Call us\u2014we\u2019re happy to help you plan your visit.</p>\n        </div>\n\n        <div class=\"faq-list\">\n          <details>\n            <summary>Do I need an appointment?</summary>\n            <p>No appointment is needed during walk-in hours. Availability can change throughout the day, so call ahead if you\u2019re able.</p>\n          </details>\n          <details>\n            <summary>How much will my visit cost?</summary>\n            <p>Costs can depend on the services you need and your circumstances. Call or ask our front desk about fees, insurance, and any reduced-cost options before care.</p>\n          </details>\n          <details>\n            <summary>What should I bring?</summary>\n            <p>You can call ahead to ask what may be helpful for your visit. If you have an insurance card or relevant health information, you may bring it, but you can contact us if you have questions.</p>\n          </details>\n          <details>\n            <summary>Will my visit be confidential?</summary>\n            <p>We handle your information with care. Privacy rules and billing practices can vary based on your age, location, and situation. Ask our team what applies to you before your visit.</p>\n          </details>\n          <details>\n            <summary>Can I come in just to ask a question?</summary>\n            <p>Yes. You\u2019re welcome to talk with our team about sexual health questions, prevention, or possible next steps.</p>\n          </details>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"final-cta\" aria-label=\"Plan a visit\">\n      <div class=\"wrap cta-box\">\n        <div>\n          <h2>Whenever you\u2019re ready, we\u2019re here.</h2>\n          <p>Walk in during clinic hours or call us with a question.</p>\n        </div>\n        <a class=\"button\" href=\"#visit\">See walk-in hours</a>\n      </div>\n    </section>\n  </main>\n\n  <footer>\n    <div class=\"wrap\">\n      <div class=\"footer-main\">\n        <div>\n          <a class=\"brand footer-brand\" href=\"#\">\n            <span class=\"brand-mark\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\">\n                <path d=\"M12 20s-7-4.35-7-10a4 4 0 0 1 7-2.65A4 4 0 0 1 19 10c0 5.65-7 10-7 10Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n                <path d=\"M8.2 12h2l1.1-2.1 1.4 4.2 1.1-2.1h2\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n            </span>\n            Harbor Health\n          </a>\n          <p class=\"footer-copy\">Sexual health care with room for every question. We\u2019re glad you\u2019re here.</p>\n        </div>\n        <nav class=\"footer-links\" aria-label=\"Footer navigation\">\n          <a href=\"#care\">Our care</a>\n          <a href=\"#how-it-works\">What to expect</a>\n          <a href=\"#faq\">FAQs</a>\n          <a href=\"tel:+12025550147\">Call the clinic</a>\n        </nav>\n      </div>\n      <div class=\"footer-bottom\">\n        <p>\u00a9 2025 Harbor Health. All rights reserved.</p>\n        <p>Demo page: replace clinic name, contact details, services, and hours before publishing.</p>\n      </div>\n    </div>\n  </footer>\n</body>\n</html>\n"}