{"brief": "B5", "model": "anthropic/claude-haiku-5.5", "i": 1, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Harbor Sexual Health Clinic | Walk-In Testing & Care</title>\n<meta name=\"description\" content=\"Confidential, walk-in sexual health testing, treatment, and advice. No appointment needed. Free and low-cost options available.\">\n<style>\n  :root {\n    --teal-900: #0d3b3e;\n    --teal-700: #17666a;\n    --teal-500: #2a9d8f;\n    --teal-100: #d9f0ec;\n    --sand-50: #fbf8f3;\n    --sand-100: #f3ede3;\n    --coral-600: #b5523b;\n    --coral-100: #fbe6df;\n    --ink: #1d2b2c;\n    --ink-soft: #4d5e5f;\n    --white: #ffffff;\n    --radius: 14px;\n    --shadow: 0 6px 24px rgba(13, 59, 62, 0.08);\n    --max: 1120px;\n  }\n\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n\n  html { scroll-behavior: smooth; }\n\n  body {\n    font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n    color: var(--ink);\n    background: var(--sand-50);\n    line-height: 1.6;\n    font-size: 17px;\n  }\n\n  img, svg { display: block; max-width: 100%; }\n\n  a { color: var(--teal-700); text-decoration-thickness: 1px; text-underline-offset: 3px; }\n  a:hover { color: var(--teal-900); }\n\n  :focus-visible {\n    outline: 3px solid var(--coral-600);\n    outline-offset: 3px;\n    border-radius: 4px;\n  }\n\n  .skip-link {\n    position: absolute; left: -9999px; top: 8px;\n    background: var(--white); padding: 10px 16px; z-index: 100;\n    border-radius: 8px; box-shadow: var(--shadow);\n  }\n  .skip-link:focus { left: 12px; }\n\n  .container {\n    width: min(100% - 40px, var(--max));\n    margin-inline: auto;\n  }\n\n  section { padding: 88px 0; }\n\n  h1, h2, h3 { line-height: 1.2; color: var(--teal-900); }\n  h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); font-weight: 750; letter-spacing: -0.02em; }\n  h2 { font-size: clamp(1.7rem, 3.5vw, 2.4rem); font-weight: 700; letter-spacing: -0.01em; margin-bottom: 14px; }\n  h3 { font-size: 1.15rem; font-weight: 650; margin-bottom: 8px; }\n\n  .eyebrow {\n    display: inline-block;\n    font-size: 0.8rem;\n    font-weight: 700;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    color: var(--teal-700);\n    background: var(--teal-100);\n    padding: 6px 12px;\n    border-radius: 999px;\n    margin-bottom: 18px;\n  }\n\n  .lead { font-size: 1.12rem; color: var(--ink-soft); max-width: 60ch; }\n\n  .btn {\n    display: inline-flex; align-items: center; justify-content: center; gap: 8px;\n    font: inherit; font-weight: 650; text-decoration: none;\n    padding: 14px 24px; border-radius: 999px; border: 2px solid transparent;\n    cursor: pointer; transition: background .2s, color .2s, border-color .2s, transform .1s;\n    min-height: 48px;\n  }\n  .btn:active { transform: translateY(1px); }\n  .btn-primary { background: var(--teal-700); color: var(--white); }\n  .btn-primary:hover { background: var(--teal-900); color: var(--white); }\n  .btn-outline { background: transparent; color: var(--teal-900); border-color: var(--teal-700); }\n  .btn-outline:hover { background: var(--teal-100); color: var(--teal-900); }\n  .btn-quick {\n    background: var(--coral-100); color: var(--coral-600); border-color: var(--coral-600);\n    font-size: 0.9rem; padding: 10px 16px; min-height: 40px;\n  }\n  .btn-quick:hover { background: var(--coral-600); color: var(--white); }\n\n  /* ---------- Top utility bar ---------- */\n  .utility {\n    background: var(--teal-900);\n    color: #e6f4f1;\n    font-size: 0.88rem;\n  }\n  .utility .container {\n    display: flex; justify-content: space-between; align-items: center; gap: 16px;\n    padding: 8px 0; flex-wrap: wrap;\n  }\n  .utility a { color: #e6f4f1; }\n  .utility .open-now {\n    display: inline-flex; align-items: center; gap: 8px;\n  }\n  .dot {\n    width: 9px; height: 9px; border-radius: 50%; background: #6fe0c4;\n    box-shadow: 0 0 0 3px rgba(111, 224, 196, 0.25);\n  }\n\n  /* ---------- Header ---------- */\n  header.site {\n    position: sticky; top: 0; z-index: 50;\n    background: rgba(251, 248, 243, 0.92);\n    backdrop-filter: blur(8px);\n    border-bottom: 1px solid rgba(13, 59, 62, 0.08);\n  }\n  header.site .container {\n    display: flex; align-items: center; justify-content: space-between;\n    height: 72px; gap: 20px;\n  }\n  .brand {\n    display: flex; align-items: center; gap: 10px;\n    text-decoration: none; color: var(--teal-900); font-weight: 750; font-size: 1.08rem;\n  }\n  .brand small { display: block; font-weight: 500; font-size: 0.75rem; color: var(--ink-soft); letter-spacing: 0.02em; }\n\n  nav.primary ul {\n    list-style: none; display: flex; gap: 28px; align-items: center;\n  }\n  nav.primary a {\n    color: var(--ink); text-decoration: none; font-weight: 500; font-size: 0.97rem;\n  }\n  nav.primary a:hover { color: var(--teal-700); }\n\n  .header-actions { display: flex; align-items: center; gap: 12px; }\n\n  .menu-toggle {\n    display: none;\n    background: none; border: 2px solid var(--teal-700); border-radius: 10px;\n    padding: 8px 12px; color: var(--teal-900); font: inherit; font-weight: 600; cursor: pointer;\n  }\n\n  /* ---------- Hero ---------- */\n  .hero {\n    padding: 72px 0 96px;\n    background:\n      radial-gradient(circle at 90% 10%, var(--teal-100) 0, transparent 40%),\n      radial-gradient(circle at 0% 100%, var(--coral-100) 0, transparent 35%),\n      var(--sand-50);\n  }\n  .hero .grid {\n    display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 56px; align-items: center;\n  }\n  .hero h1 span { color: var(--teal-500); }\n  .hero .lead { margin: 22px 0 32px; }\n  .cta-row { display: flex; gap: 14px; flex-wrap: wrap; }\n\n  .hero-points {\n    list-style: none; display: flex; flex-wrap: wrap; gap: 10px 22px;\n    margin-top: 34px; color: var(--ink-soft); font-size: 0.95rem;\n  }\n  .hero-points li { display: flex; align-items: center; gap: 8px; }\n  .hero-points svg { flex: none; color: var(--teal-500); }\n\n  .hero-art {\n    background: var(--white);\n    border-radius: 28px;\n    box-shadow: var(--shadow);\n    padding: 36px;\n    position: relative;\n  }\n  .status-card {\n    margin-top: 22px;\n    background: var(--sand-100);\n    border-radius: var(--radius);\n    padding: 18px 20px;\n    font-size: 0.95rem;\n  }\n  .status-card strong { color: var(--teal-900); }\n  .status-row { display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px dashed rgba(13,59,62,0.15); }\n  .status-row:last-child { border-bottom: 0; }\n\n  /* ---------- Trust strip ---------- */\n  .trust {\n    background: var(--teal-900); color: #e6f4f1; padding: 26px 0;\n  }\n  .trust .container {\n    display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; text-align: center;\n  }\n  .trust strong { display: block; font-size: 1.5rem; color: var(--white); font-weight: 700; }\n  .trust span { font-size: 0.92rem; opacity: 0.9; }\n\n  /* ---------- Steps ---------- */\n  .steps {\n    display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 48px;\n    counter-reset: step; list-style: none;\n  }\n  .step {\n    background: var(--white); border-radius: var(--radius); padding: 32px 28px;\n    box-shadow: var(--shadow); position: relative;\n  }\n  .step .num {\n    width: 44px; height: 44px; border-radius: 50%;\n    background: var(--teal-100); color: var(--teal-900);\n    display: grid; place-items: center; font-weight: 750; margin-bottom: 18px;\n  }\n  .step p { color: var(--ink-soft); font-size: 0.98rem; }\n\n  /* ---------- Services ---------- */\n  .services { background: var(--white); }\n  .service-grid {\n    display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-top: 48px;\n  }\n  .service {\n    border: 1px solid rgba(13,59,62,0.1); border-radius: var(--radius);\n    padding: 28px; background: var(--sand-50);\n    transition: transform .2s, box-shadow .2s;\n  }\n  .service:hover { transform: translateY(-3px); box-shadow: var(--shadow); }\n  .service .icon {\n    width: 48px; height: 48px; border-radius: 12px; background: var(--teal-100);\n    color: var(--teal-700); display: grid; place-items: center; margin-bottom: 16px;\n  }\n  .service p { color: var(--ink-soft); font-size: 0.97rem; margin-bottom: 12px; }\n  .service .tag {\n    font-size: 0.8rem; font-weight: 650; color: var(--teal-700);\n  }\n  .urgent {\n    margin-top: 40px; display: flex; gap: 18px; align-items: flex-start;\n    background: var(--coral-100); border-radius: var(--radius); padding: 22px 26px;\n    color: #5d2a1d;\n  }\n  .urgent svg { flex: none; color: var(--coral-600); margin-top: 2px; }\n  .urgent strong { color: #5d2a1d; }\n\n  /* ---------- Privacy ---------- */\n  .privacy .grid {\n    display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center;\n  }\n  .privacy ul.checks { list-style: none; margin-top: 24px; display: grid; gap: 16px; }\n  .privacy ul.checks li {\n    display: flex; gap: 14px; align-items: flex-start;\n  }\n  .privacy ul.checks svg { flex: none; color: var(--teal-500); margin-top: 3px; }\n  .privacy ul.checks strong { color: var(--teal-900); display: block; }\n  .privacy ul.checks span { color: var(--ink-soft); font-size: 0.97rem; }\n  .privacy-panel {\n    background: var(--teal-900); color: #e6f4f1; border-radius: 24px; padding: 40px;\n  }\n  .privacy-panel h3 { color: var(--white); font-size: 1.4rem; margin-bottom: 14px; }\n  .privacy-panel p { opacity: 0.9; margin-bottom: 14px; }\n  .privacy-panel .btn-outline { color: var(--white); border-color: #6fe0c4; margin-top: 8px; }\n  .privacy-panel .btn-outline:hover { background: rgba(111,224,196,0.15); color: var(--white); }\n\n  /* ---------- Visit / hours ---------- */\n  .visit { background: var(--sand-100); }\n  .visit .grid {\n    display: grid; grid-template-columns: 1fr 1fr; gap: 28px;\n  }\n  .card {\n    background: var(--white); border-radius: var(--radius); padding: 32px; box-shadow: var(--shadow);\n  }\n  .hours-table { width: 100%; border-collapse: collapse; margin-top: 14px; font-size: 0.98rem; }\n  .hours-table th, .hours-table td {\n    text-align: left; padding: 11px 0; border-bottom: 1px solid rgba(13,59,62,0.1);\n  }\n  .hours-table th { font-weight: 600; color: var(--teal-900); }\n  .hours-table td { text-align: right; color: var(--ink-soft); }\n  .hours-table tr.today th, .hours-table tr.today td { color: var(--teal-700); font-weight: 700; }\n  .card ul.plain { list-style: none; display: grid; gap: 14px; margin-top: 14px; }\n  .card ul.plain li { display: flex; gap: 12px; align-items: flex-start; color: var(--ink-soft); }\n  .card ul.plain svg { flex: none; color: var(--teal-700); margin-top: 3px; }\n  .card ul.plain a { font-weight: 600; }\n  .map-placeholder {\n    margin-top: 20px; border-radius: var(--radius); height: 190px;\n    background:\n      repeating-linear-gradient(0deg, transparent 0 28px, rgba(13,59,62,0.07) 28px 29px),\n      repeating-linear-gradient(90deg, transparent 0 28px, rgba(13,59,62,0.07) 28px 29px),\n      linear-gradient(135deg, var(--teal-100), #eef7f5);\n    display: grid; place-items: center; position: relative; overflow: hidden;\n  }\n  .map-placeholder .pin {\n    background: var(--teal-700); color: white; padding: 8px 14px; border-radius: 999px;\n    font-weight: 600; font-size: 0.9rem; box-shadow: var(--shadow);\n    display: inline-flex; gap: 8px; align-items: center;\n  }\n\n  /* ---------- FAQ ---------- */\n  .faq-wrap { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 56px; }\n  details {\n    background: var(--white); border-radius: 12px; padding: 20px 24px;\n    box-shadow: 0 2px 10px rgba(13,59,62,0.05); margin-bottom: 14px;\n  }\n  details summary {\n    cursor: pointer; font-weight: 650; color: var(--teal-900); list-style: none;\n    display: flex; justify-content: space-between; align-items: center; gap: 16px;\n  }\n  details summary::-webkit-details-marker { display: none; }\n  details summary::after {\n    content: \"+\"; font-size: 1.5rem; line-height: 1; color: var(--teal-700); font-weight: 400;\n    transition: transform .2s;\n  }\n  details[open] summary::after { content: \"\u2212\"; }\n  details p { margin-top: 12px; color: var(--ink-soft); font-size: 0.98rem; }\n\n  /* ---------- Final CTA ---------- */\n  .final-cta {\n    background: linear-gradient(120deg, var(--teal-700), var(--teal-900));\n    color: var(--white); text-align: center; padding: 88px 0;\n  }\n  .final-cta h2 { color: var(--white); }\n  .final-cta p { max-width: 56ch; margin: 0 auto 30px; opacity: 0.92; }\n  .final-cta .btn-primary { background: var(--white); color: var(--teal-900); }\n  .final-cta .btn-primary:hover { background: var(--teal-100); color: var(--teal-900); }\n  .final-cta .btn-outline { color: var(--white); border-color: var(--white); }\n  .final-cta .btn-outline:hover { background: rgba(255,255,255,0.12); color: var(--white); }\n\n  /* ---------- Footer ---------- */\n  footer.site {\n    background: #092c2e; color: #bcd6d2; padding: 60px 0 32px; font-size: 0.92rem;\n  }\n  footer .cols {\n    display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 36px; margin-bottom: 40px;\n  }\n  footer h4 { color: var(--white); font-size: 0.95rem; margin-bottom: 14px; }\n  footer ul { list-style: none; display: grid; gap: 10px; }\n  footer a { color: #bcd6d2; text-decoration: none; }\n  footer a:hover { color: var(--white); text-decoration: underline; }\n  footer .disclaimer {\n    border-top: 1px solid rgba(255,255,255,0.12); padding-top: 24px;\n    font-size: 0.85rem; opacity: 0.85; line-height: 1.65;\n  }\n  footer .disclaimer p + p { margin-top: 10px; }\n\n  /* ---------- Responsive ---------- */\n  @media (max-width: 960px) {\n    section { padding: 68px 0; }\n    .hero .grid, .privacy .grid, .visit .grid, .faq-wrap { grid-template-columns: 1fr; gap: 40px; }\n    .hero-art { order: -1; }\n    .steps, .service-grid { grid-template-columns: 1fr 1fr; }\n    .trust .container { grid-template-columns: 1fr 1fr; }\n    footer .cols { grid-template-columns: 1fr 1fr; }\n  }\n\n  @media (max-width: 720px) {\n    body { font-size: 16px; }\n    nav.primary { display: none; }\n    nav.primary.open {\n      display: block; position: absolute; top: 72px; left: 0; right: 0;\n      background: var(--sand-50); border-bottom: 1px solid rgba(13,59,62,0.1);\n      padding: 16px 20px 24px;\n    }\n    nav.primary.open ul { flex-direction: column; align-items: flex-start; gap: 16px; }\n    .menu-toggle { display: inline-block; }\n    .steps, .service-grid { grid-template-columns: 1fr; }\n    .trust .container { grid-template-columns: 1fr 1fr; }\n    .header-actions .btn-primary { display: none; }\n    .utility .container { justify-content: center; text-align: center; }\n    .card, .privacy-panel { padding: 26px; }\n    footer .cols { grid-template-columns: 1fr; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    * { transition: none !important; scroll-behavior: auto !important; }\n  }\n</style>\n</head>\n<body>\n\n<a class=\"skip-link\" href=\"#main\">Skip to content</a>\n\n<!-- Utility bar -->\n<div class=\"utility\" role=\"region\" aria-label=\"Clinic status\">\n  <div class=\"container\">\n    <span class=\"open-now\"><span class=\"dot\" aria-hidden=\"true\"></span> Walk-ins open today until 6:00 PM</span>\n    <span>Questions? Call <a href=\"tel:+15555550142\">(555) 555-0142</a></span>\n  </div>\n</div>\n\n<!-- Header -->\n<header class=\"site\">\n  <div class=\"container\">\n    <a class=\"brand\" href=\"#top\" aria-label=\"Harbor Sexual Health Clinic home\">\n      <svg width=\"36\" height=\"36\" viewBox=\"0 0 40 40\" aria-hidden=\"true\">\n        <circle cx=\"20\" cy=\"20\" r=\"19\" fill=\"#17666a\"/>\n        <path d=\"M11 24 C15 16, 25 16, 29 24\" stroke=\"#d9f0ec\" stroke-width=\"3\" fill=\"none\" stroke-linecap=\"round\"/>\n        <path d=\"M14 18 L26 18\" stroke=\"#6fe0c4\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n      </svg>\n      <span>Harbor Sexual Health<small>Confidential \u00b7 Walk-in \u00b7 Judgment-free</small></span>\n    </a>\n\n    <nav class=\"primary\" id=\"primary-nav\" aria-label=\"Primary\">\n      <ul>\n        <li><a href=\"#services\">Services</a></li>\n        <li><a href=\"#how-it-works\">Your visit</a></li>\n        <li><a href=\"#privacy\">Privacy</a></li>\n        <li><a href=\"#visit\">Hours & location</a></li>\n        <li><a href=\"#faq\">FAQ</a></li>\n      </ul>\n    </nav>\n\n    <div class=\"header-actions\">\n      <button class=\"btn btn-quick\" type=\"button\" onclick=\"quickExit()\" title=\"Leave this page immediately\">Quick exit</button>\n      <a class=\"btn btn-primary\" href=\"#visit\">Find a location</a>\n      <button class=\"menu-toggle\" type=\"button\" aria-expanded=\"false\" aria-controls=\"primary-nav\" id=\"menuBtn\">Menu</button>\n    </div>\n  </div>\n</header>\n\n<main id=\"main\">\n\n<!-- Hero -->\n<section class=\"hero\" id=\"top\">\n  <div class=\"container grid\">\n    <div>\n      <span class=\"eyebrow\">Walk-in sexual health care</span>\n      <h1>Get tested, get answers, <span>no appointment needed.</span></h1>\n      <p class=\"lead\">\n        Drop in during open hours for STI testing, treatment, contraception, PrEP, and expert advice.\n        Everything is confidential, and you'll be seen by a clinician who won't judge your questions.\n      </p>\n      <div class=\"cta-row\">\n        <a class=\"btn btn-primary\" href=\"#visit\">See today's hours</a>\n        <a class=\"btn btn-outline\" href=\"#how-it-works\">What to expect</a>\n      </div>\n      <ul class=\"hero-points\">\n        <li>\n          <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" aria-hidden=\"true\"><path d=\"M5 12l5 5L20 7\"/></svg>\n          Free and low-cost options\n        </li>\n        <li>\n          <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" aria-hidden=\"true\"><path d=\"M5 12l5 5L20 7\"/></svg>\n          Results in as little as 24 hours*\n        </li>\n        <li>\n          <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" aria-hidden=\"true\"><path d=\"M5 12l5 5L20 7\"/></svg>\n          Open 7 days a week\n        </li>\n      </ul>\n    </div>\n\n    <aside class=\"hero-art\" aria-label=\"Today at a glance\">\n      <svg viewBox=\"0 0 400 220\" role=\"img\" aria-label=\"Illustration of a calm clinic waiting room with a plant and a window\" style=\"width:100%;height:auto\">\n        <rect width=\"400\" height=\"220\" rx=\"18\" fill=\"#f3ede3\"/>\n        <rect x=\"0\" y=\"150\" width=\"400\" height=\"70\" fill=\"#d9f0ec\"/>\n        <rect x=\"260\" y=\"30\" width=\"110\" height=\"110\" rx=\"10\" fill=\"#ffffff\" stroke=\"#17666a\" stroke-width=\"3\"/>\n        <line x1=\"315\" y1=\"30\" x2=\"315\" y2=\"140\" stroke=\"#17666a\" stroke-width=\"3\"/>\n        <line x1=\"260\" y1=\"85\" x2=\"370\" y2=\"85\" stroke=\"#17666a\" stroke-width=\"3\"/>\n        <circle cx=\"90\" cy=\"110\" r=\"38\" fill=\"#2a9d8f\"/>\n        <rect x=\"70\" y=\"140\" width=\"40\" height=\"60\" rx=\"10\" fill=\"#17666a\"/>\n        <path d=\"M150 150 Q160 95 190 90\" stroke=\"#17666a\" stroke-width=\"4\" fill=\"none\"/>\n        <circle cx=\"195\" cy=\"90\" r=\"24\" fill=\"#6fe0c4\"/>\n        <circle cx=\"185\" cy=\"82\" r=\"5\" fill=\"#0d3b3e\"/>\n        <rect x=\"30\" y=\"170\" width=\"20\" height=\"30\" fill=\"#b5523b\" opacity=\"0.6\"/>\n        <rect x=\"290\" y=\"165\" width=\"70\" height=\"8\" rx=\"4\" fill=\"#17666a\"/>\n        <rect x=\"300\" y=\"173\" width=\"6\" height=\"22\" fill=\"#17666a\"/>\n        <rect x=\"350\" y=\"173\" width=\"6\" height=\"22\" fill=\"#17666a\"/>\n        <rect x=\"290\" y=\"130\" width=\"20\" height=\"36\" rx=\"6\" fill=\"#b5523b\"/>\n        <circle cx=\"300\" cy=\"122\" r=\"12\" fill=\"#2a9d8f\" opacity=\"0.4\"/>\n      </svg>\n\n      <div class=\"status-card\">\n        <div class=\"status-row\"><span>Today</span><strong>8:00 AM \u2013 6:00 PM</strong></div>\n        <div class=\"status-row\"><span>Average wait</span><strong>About 25 minutes</strong></div>\n        <div class=\"status-row\"><span>Next walk-in slot</span><strong>Available now</strong></div>\n      </div>\n    </aside>\n  </div>\n</section>\n\n<!-- Trust strip -->\n<div class=\"trust\" aria-label=\"Clinic facts\">\n  <div class=\"container\">\n    <div><strong>7 days</strong><span>open each week</span></div>\n    <div><strong>100%</strong><span>confidential care</span></div>\n    <div><strong>Same day</strong><span>treatment for most STIs</span></div>\n    <div><strong>No ID</strong><span>required to be seen</span></div>\n  </div>\n</div>\n\n<!-- How it works -->\n<section id=\"how-it-works\">\n  <div class=\"container\">\n    <span class=\"eyebrow\">Your visit</span>\n    <h2>Simple, quick, and private</h2>\n    <p class=\"lead\">Most visits take 30 to 60 minutes from check-in to leaving. Here's the whole process.</p>\n\n    <ol class=\"steps\">\n      <li class=\"step\">\n        <div class=\"num\">1</div>\n        <h3>Check in at the front desk</h3>\n        <p>Give a first name or nickname. You don't need insurance or an appointment, and you can ask for a private room at check-in.</p>\n      </li>\n      <li class=\"step\">\n        <div class=\"num\">2</div>\n        <h3>Talk with a clinician</h3>\n        <p>Share what's going on, or what you'd like to prevent. Your clinician will ask about your health history and explain each option before anything is done.</p>\n      </li>\n      <li class=\"step\">\n        <div class=\"num\">3</div>\n        <h3>Test, treat, and take your plan</h3>\n        <p>Get tested or treated on the spot where possible. You'll leave with written next steps, and a way to get your results privately.</p>\n      </li>\n    </ol>\n  </div>\n</section>\n\n<!-- Services -->\n<section class=\"services\" id=\"services\">\n  <div class=\"container\">\n    <span class=\"eyebrow\">Services</span>\n    <h2>Care for every stage of your sexual health</h2>\n    <p class=\"lead\">Whether you're due for routine screening or have a specific concern, we can help.</p>\n\n    <div class=\"service-grid\">\n      <article class=\"service\">\n        <div class=\"icon\" aria-hidden=\"true\">\n          <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.8 3h10.4a2 2 0 0 0 1.8-3l-5-9V3\"/></svg>\n        </div>\n        <h3>STI testing & treatment</h3>\n        <p>Screening for chlamydia, gonorrhea, syphilis, herpes, HPV, trichomoniasis, and more. Many results come back within days, and treatment is available for common infections.</p>\n        <span class=\"tag\">Testing from a simple swab or urine sample</span>\n      </article>\n\n      <article class=\"service\">\n        <div class=\"icon\" aria-hidden=\"true\">\n          <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 21s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.6-7 10-7 10z\"/></svg>\n        </div>\n        <h3>HIV testing & PrEP</h3>\n        <p>Rapid HIV testing with results during your visit. Ask about PrEP, a daily pill or long-acting injection that greatly reduces the risk of HIV infection.</p>\n        <span class=\"tag\">Rapid results on-site</span>\n      </article>\n\n      <article class=\"service\">\n        <div class=\"icon\" aria-hidden=\"true\">\n          <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/></svg>\n        </div>\n        <h3>Emergency contraception</h3>\n        <p>Same-day access to emergency contraception and guidance on the options available to you. Time matters, so come in as soon as you can.</p>\n        <span class=\"tag\">Most effective when taken sooner</span>\n      </article>\n\n      <article class=\"service\">\n        <div class=\"icon\" aria-hidden=\"true\">\n          <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"5\" y=\"3\" width=\"14\" height=\"18\" rx=\"3\"/><path d=\"M9 8h6M9 12h6M9 16h3\"/></svg>\n        </div>\n        <h3>Contraception options</h3>\n        <p>Pills, patches, rings, injections, implants, IUDs, and condoms. We'll help you compare options and find the method that fits your body and your life.</p>\n        <span class=\"tag\">Same-day starts available</span>\n      </article>\n\n      <article class=\"service\">\n        <div class=\"icon\" aria-hidden=\"true\">\n          <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 12h16M12 4v16\"/><circle cx=\"12\" cy=\"12\" r=\"9\"/></svg>\n        </div>\n        <h3>Vaccinations</h3>\n        <p>Protection against HPV and hepatitis B, plus catch-up doses where they're recommended. We'll check your records and tell you what's due.</p>\n        <span class=\"tag\">Ask about eligibility</span>\n      </article>\n\n      <article class=\"service\">\n        <div class=\"icon\" aria-hidden=\"true\">\n          <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"/></svg>\n        </div>\n        <h3>Questions & support</h3>\n        <p>Concerns about symptoms, sexual function, pain, consent, or relationships. There are no silly questions, and our staff will take your concerns seriously.</p>\n        <span class=\"tag\">Advice from a clinician, not a referral line</span>\n      </article>\n    </div>\n\n    <div class=\"urgent\" role=\"note\">\n      <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M12 9v4M12 17h.01M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z\"/></svg>\n      <div>\n        <strong>Possible exposure to HIV in the last 72 hours?</strong><br>\n        Post-exposure prophylaxis (PEP) can reduce the risk of infection, but it must be started quickly. Walk in right away, or call us. If you're outside clinic hours, go to the nearest emergency department.\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- Privacy -->\n<section class=\"privacy\" id=\"privacy\">\n  <div class=\"container grid\">\n    <div>\n      <span class=\"eyebrow\">Your privacy</span>\n      <h2>Discreet by design</h2>\n      <p class=\"lead\">We know that privacy matters. Here's how we protect it, from the moment you walk in to long after your visit.</p>\n\n      <ul class=\"checks\">\n        <li>\n          <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" aria-hidden=\"true\"><path d=\"M5 12l5 5L20 7\"/></svg>\n          <div><strong>Confidential by law</strong><span>Your records are protected, and we won't share your information without your permission except where the law requires it.</span></div>\n        </li>\n        <li>\n          <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" aria-hidden=\"true\"><path d=\"M5 12l5 5L20 7\"/></svg>\n          <div><strong>Use any name you like</strong><span>You can use a preferred name or nickname, and we'll ask about pronouns and identity so you're treated with respect.</span></div>\n        </li>\n        <li>\n          <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" aria-hidden=\"true\"><path d=\"M5 12l5 5L20 7\"/></svg>\n          <div><strong>Discreet communications</strong><span>Choose whether we may text, call, or leave a voicemail, and we'll keep messages neutral.</span></div>\n        </li>\n        <li>\n          <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" aria-hidden=\"true\"><path d=\"M5 12l5 5L20 7\"/></svg>\n          <div><strong>No insurance billing shows up at home</strong><span>Ask our team about self-pay options and how charges appear on statements.</span></div>\n        </li>\n      </ul>\n    </div>\n\n    <div class=\"privacy-panel\">\n      <h3>Your results are yours to access</h3>\n      <p>Get results by phone, through a secure patient portal, or in person. Tell us which method you prefer and we'll follow it.</p>\n      <p>Not sure how to talk to a partner about testing? Our clinicians can help you plan that conversation, including anonymous notification options in many areas.</p>\n      <a class=\"btn btn-outline\" href=\"#faq\">Read our privacy FAQ</a>\n    </div>\n  </div>\n</section>\n\n<!-- Visit & hours -->\n<section class=\"visit\" id=\"visit\">\n  <div class=\"container\">\n    <span class=\"eyebrow\">Hours & location</span>\n    <h2>Come by when it suits you</h2>\n    <p class=\"lead\">Walk-ins are welcome during all open hours. Arriving early in the day usually means shorter waits.</p>\n\n    <div class=\"grid\" style=\"margin-top:44px\">\n      <div class=\"card\">\n        <h3>Walk-in hours</h3>\n        <table class=\"hours-table\">\n          <tbody>\n            <tr><th scope=\"row\">Monday</th><td>8:00 AM \u2013 6:00 PM</td></tr>\n            <tr><th scope=\"row\">Tuesday</th><td>8:00 AM \u2013 6:00 PM</td></tr>\n            <tr class=\"today\"><th scope=\"row\">Wednesday (today)</th><td>8:00 AM \u2013 6:00 PM</td></tr>\n            <tr><th scope=\"row\">Thursday</th><td>10:00 AM \u2013 8:00 PM</td></tr>\n            <tr><th scope=\"row\">Friday</th><td>8:00 AM \u2013 5:00 PM</td></tr>\n            <tr><th scope=\"row\">Saturday</th><td>9:00 AM \u2013 2:00 PM</td></tr>\n            <tr><th scope=\"row\">Sunday</th><td>Closed</td></tr>\n          </tbody>\n        </table>\n        <p style=\"margin-top:16px;font-size:0.9rem;color:var(--ink-soft)\">Hours may change on public holidays. Check the phone line before you travel.</p>\n      </div>\n\n      <div class=\"card\">\n        <h3>Find us</h3>\n        <ul class=\"plain\">\n          <li>\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z\"/><circle cx=\"12\" cy=\"10\" r=\"2.5\"/></svg>\n            <span>412 Harbor Street, Suite 2B<br>Riverside, ST 00000<br>Ground floor, with a separate entrance from the parking lot</span>\n          </li>\n          <li>\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z\"/></svg>\n            <span><a href=\"tel:+15555550142\">(555) 555-0142</a> \u00b7 Text a question: (555) 555-0143</span>\n          </li>\n          <li>\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><rect x=\"3\" y=\"7\" width=\"18\" height=\"13\" rx=\"2\"/><path d=\"M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2\"/></svg>\n            <span>Wheelchair accessible, gender-neutral restrooms, and interpreter services available on request</span>\n          </li>\n          <li>\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M3 12h18M12 3v18\"/><circle cx=\"12\" cy=\"12\" r=\"9\"/></svg>\n            <span>Near the Riverside Transit Center (Bus lines 4, 12, and 19). Free street parking after 6 PM.</span>\n          </li>\n        </ul>\n        <div class=\"map-placeholder\" aria-hidden=\"true\">\n          <span class=\"pin\">\n            <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><path d=\"M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z\"/></svg>\n            Harbor Sexual Health\n          </span>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- FAQ -->\n<section id=\"faq\">\n  <div class=\"container faq-wrap\">\n    <div>\n      <span class=\"eyebrow\">Common questions</span>\n      <h2>Answers before you come in</h2>\n      <p class=\"lead\">Still wondering about something? Call or text us and we'll answer it without judgment.</p>\n      <a class=\"btn btn-outline\" href=\"tel:+15555550142\" style=\"margin-top:24px\">Call (555) 555-0142</a>\n    </div>\n\n    <div>\n      <details open>\n        <summary>Do I need an appointment?</summary>\n        <p>No. Walk-ins are welcome during all open hours. If you'd rather have a set time, you can book online or by phone, but it's never required.</p>\n      </details>\n      <details>\n        <summary>Will my insurance be billed, and will my family find out?</summary>\n        <p>We'll tell you what your insurance covers before anything is billed. You can also choose to pay privately. Insurance statements may list services, so ask our team how billing is handled for your plan. We never contact employers or family members.</p>\n      </details>\n      <details>\n        <summary>How long do test results take?</summary>\n        <p>Rapid HIV tests give results during your visit. Many STI tests return in 1 to 3 days, and some tests, like certain cultures, can take longer. We'll tell you the timeline for each test and how you'll be notified.</p>\n      </details>\n      <details>\n        <summary>What if I can't afford care?</summary>\n        <p>We offer sliding-scale fees and free testing for those who qualify. Tell the front desk you need financial help. No one is turned away because of inability to pay.</p>\n      </details>\n      <details>\n        <summary>Do I need to undress or have a pelvic exam?</summary>\n        <p>Not always. Many testing options use urine or swab samples. If an exam is needed, we'll explain why, ask for your consent at each step, and let you stop at any time. You can also bring a support person to your appointment if you'd like.</p>\n      </details>\n      <details>\n        <summary>I'm under 18. Can I still be seen?</summary>\n        <p>Yes. Young people can access many sexual health services confidentially. Age-of-consent and reporting rules vary by location, so our clinicians will explain what stays private and what doesn't before your visit.</p>\n      </details>\n      <details>\n        <summary>Can you help if I've been hurt or pressured?</summary>\n        <p>Yes. We can offer testing, treatment, emergency contraception, and PEP where appropriate, along with referrals to local support services. You control what you share and what happens next.</p>\n      </details>\n    </div>\n  </div>\n</section>\n\n<!-- Final CTA -->\n<section class=\"final-cta\">\n  <div class=\"container\">\n    <h2>Ready when you are</h2>\n    <p>You don't need a reason, a referral, or a plan. Stop by during open hours and we'll take it from there.</p>\n    <div class=\"cta-row\" style=\"justify-content:center\">\n      <a class=\"btn btn-primary\" href=\"#visit\">Find today's hours</a>\n      <a class=\"btn btn-outline\" href=\"tel:+15555550142\">Call us</a>\n    </div>\n  </div>\n</section>\n\n</main>\n\n<!-- Footer -->\n<footer class=\"site\">\n  <div class=\"container\">\n    <div class=\"cols\">\n      <div>\n        <h4>Harbor Sexual Health Clinic</h4>\n        <p>Confidential, walk-in sexual health care for people of every age, gender, and background.</p>\n        <p style=\"margin-top:14px\">412 Harbor Street, Suite 2B<br>Riverside, ST 00000</p>\n      </div>\n      <div>\n        <h4>Services</h4>\n        <ul>\n          <li><a href=\"#services\">STI testing</a></li>\n          <li><a href=\"#services\">HIV testing & PrEP</a></li>\n          <li><a href=\"#services\">Contraception</a></li>\n          <li><a href=\"#services\">Emergency contraception</a></li>\n          <li><a href=\"#services\">Vaccinations</a></li>\n        </ul>\n      </div>\n      <div>\n        <h4>Visit</h4>\n        <ul>\n          <li><a href=\"#visit\">Hours</a></li>\n          <li><a href=\"#visit\">Directions</a></li>\n          <li><a href=\"#faq\">FAQ</a></li>\n          <li><a href=\"#privacy\">Privacy policy</a></li>\n        </ul>\n      </div>\n      <div>\n        <h4>Contact</h4>\n        <ul>\n          <li><a href=\"tel:+15555550142\">(555) 555-0142</a></li>\n          <li><a href=\"tel:+15555550143\">Text: (555) 555-0143</a></li>\n          <li><a href=\"#faq\">Accessibility</a></li>\n          <li><a href=\"#faq\">Careers</a></li>\n        </ul>\n      </div>\n    </div>\n\n    <div class=\"disclaimer\">\n      <p>This website provides general information and does not replace a consultation with a licensed clinician. In an emergency, call your local emergency number or go to the nearest emergency department.</p>\n      <p>*Turnaround times vary by test and lab. We'll confirm the timeline for your specific tests during your visit.</p>\n      <p>&copy; 2025 Harbor Sexual Health Clinic. All rights reserved.</p>\n    </div>\n  </div>\n</footer>\n\n<script>\n  // Mobile menu toggle\n  (function () {\n    var btn = document.getElementById('menuBtn');\n    var nav = document.getElementById('primary-nav');\n    btn.addEventListener('click', function () {\n      var open = nav.classList.toggle('open');\n      btn.setAttribute('aria-expanded', open ? 'true' : 'false');\n    });\n    nav.querySelectorAll('a').forEach(function (a) {\n      a.addEventListener('click', function () {\n        nav.classList.remove('open');\n        btn.setAttribute('aria-expanded', 'false');\n      });\n    });\n  })();\n\n  // Quick exit: leaves the page immediately and replaces history entry\n  function quickExit() {\n    window.location.replace('https://www.google.com');\n  }\n</script>\n\n</body>\n</html>\n"}