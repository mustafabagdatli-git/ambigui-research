{"brief": "B1", "model": "z-ai/glm-5.3-flashx", "i": 3, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Schofield &amp; Sons \u2014 Plumbers in Leeds since 1987</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Archivo:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --paper:#F6F1E7;\n    --paper-2:#EFE7D7;\n    --ink:#1C2B30;\n    --ink-soft:#41535A;\n    --copper:#B4551F;\n    --copper-dark:#8E3F14;\n    --brass:#D9A24A;\n    --line:#D8CCB6;\n  }\n  *{margin:0;padding:0;box-sizing:border-box}\n  html{scroll-behavior:smooth}\n  body{\n    font-family:'Archivo',sans-serif;\n    background:var(--paper);\n    color:var(--ink);\n    line-height:1.6;\n    overflow-x:hidden;\n  }\n  ::selection{background:var(--copper);color:var(--paper)}\n  h1,h2,h3,.serif{font-family:'Fraunces',serif}\n\n  .wrap{max-width:1160px;margin:0 auto;padding:0 28px}\n\n  /* ---------- reveal on scroll ---------- */\n  .rv{opacity:0;transform:translateY(22px);transition:opacity .7s ease,transform .7s ease}\n  .rv.in{opacity:1;transform:none}\n\n  /* ---------- header ---------- */\n  header{\n    position:sticky;top:0;z-index:50;\n    background:rgba(246,241,231,.92);\n    backdrop-filter:blur(8px);\n    border-bottom:1px solid var(--line);\n  }\n  .nav{display:flex;align-items:center;justify-content:space-between;height:74px}\n  .brand{display:flex;align-items:center;gap:12px;text-decoration:none;color:var(--ink)}\n  .brand .mark{width:40px;height:40px;flex:none}\n  .brand b{font-family:'Fraunces',serif;font-size:1.15rem;font-weight:700;letter-spacing:.01em;display:block;line-height:1.1}\n  .brand span{font-size:.7rem;letter-spacing:.18em;text-transform:uppercase;color:var(--copper);font-weight:600}\n  nav.links{display:flex;gap:30px}\n  nav.links a{\n    color:var(--ink-soft);text-decoration:none;font-size:.92rem;font-weight:500;\n    position:relative;padding:4px 0;\n  }\n  nav.links a::after{\n    content:\"\";position:absolute;left:0;bottom:0;height:2px;width:0;background:var(--copper);transition:width .25s;\n  }\n  nav.links a:hover{color:var(--ink)}\n  nav.links a:hover::after{width:100%}\n  .call-btn{\n    display:inline-flex;align-items:center;gap:9px;\n    background:var(--copper);color:var(--paper);text-decoration:none;\n    padding:11px 20px;border-radius:999px;font-weight:600;font-size:.92rem;\n    border:1px solid var(--copper-dark);\n    transition:background .2s,transform .15s;\n  }\n  .call-btn:hover{background:var(--copper-dark);transform:translateY(-1px)}\n  .call-btn svg{width:15px;height:15px}\n\n  /* ---------- hero ---------- */\n  .hero{padding:84px 0 0;position:relative}\n  .hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:40px;align-items:center}\n  .eyebrow{\n    display:inline-flex;align-items:center;gap:10px;\n    font-size:.78rem;letter-spacing:.2em;text-transform:uppercase;\n    color:var(--copper);font-weight:600;margin-bottom:22px;\n  }\n  .eyebrow::before{content:\"\";width:34px;height:2px;background:var(--copper)}\n  .hero h1{\n    font-size:clamp(2.5rem,5.4vw,4.3rem);\n    font-weight:600;line-height:1.06;letter-spacing:-.01em;\n    margin-bottom:24px;\n  }\n  .hero h1 em{font-style:italic;color:var(--copper)}\n  .hero p.lede{font-size:1.13rem;color:var(--ink-soft);max-width:33em;margin-bottom:34px}\n  .hero-ctas{display:flex;gap:16px;flex-wrap:wrap;align-items:center}\n  .btn-primary{\n    background:var(--ink);color:var(--paper);text-decoration:none;\n    padding:15px 28px;border-radius:999px;font-weight:600;font-size:1rem;\n    display:inline-flex;align-items:center;gap:10px;transition:background .2s,transform .15s;\n  }\n  .btn-primary:hover{background:var(--copper);transform:translateY(-2px)}\n  .btn-ghost{\n    color:var(--ink);text-decoration:none;font-weight:600;font-size:1rem;\n    border-bottom:2px solid var(--copper);padding-bottom:3px;\n    transition:color .2s;\n  }\n  .btn-ghost:hover{color:var(--copper)}\n\n  /* the dripping tap illustration */\n  .tap-stage{position:relative;display:flex;justify-content:center;padding:10px 0 0}\n  .drip{\n    animation:drip 2.2s cubic-bezier(.55,0,.85,.4) infinite;\n    transform-origin:center;\n  }\n  @keyframes drip{\n    0%{opacity:0;transform:translateY(0) scaleY(.5)}\n    12%{opacity:1}\n    70%{opacity:1;transform:translateY(58px) scaleY(1.35)}\n    82%{opacity:0;transform:translateY(64px) scaleY(.6)}\n    100%{opacity:0;transform:translateY(64px)}\n  }\n  .puddle{\n    animation:puddle 2.2s ease-out infinite;\n    transform-origin:center;\n  }\n  @keyframes puddle{\n    0%,60%{opacity:0;transform:scale(.2)}\n    72%{opacity:.9;transform:scale(1)}\n    100%{opacity:0;transform:scale(1.25)}\n  }\n  .handle-turn{animation:turn 6s ease-in-out infinite;transform-origin:118px 74px}\n  @keyframes turn{0%,20%{transform:rotate(0)}35%,65%{transform:rotate(-38deg)}80%,100%{transform:rotate(0)}}\n  .flow-line{stroke-dasharray:6 10;animation:flow 1.1s linear infinite}\n  @keyframes flow{to{stroke-dashoffset:-16}}\n\n  /* trust strip */\n  .trust{\n    margin-top:64px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);\n    background:var(--paper-2);\n  }\n  .trust-in{\n    display:flex;justify-content:space-between;flex-wrap:wrap;\n    padding:18px 0;gap:14px;\n  }\n  .trust-in div{\n    display:flex;align-items:center;gap:10px;font-size:.9rem;font-weight:500;color:var(--ink-soft);\n  }\n  .trust-in svg{width:17px;height:17px;color:var(--copper);flex:none}\n  .trust-in b{color:var(--ink)}\n\n  /* ---------- pipe divider ---------- */\n  .pipe-divider{display:block;width:100%;height:44px;color:var(--copper)}\n\n  /* ---------- services ---------- */\n  section{padding:88px 0}\n  .sec-head{max-width:620px;margin-bottom:52px}\n  .sec-head .kicker{\n    font-size:.78rem;letter-spacing:.2em;text-transform:uppercase;\n    color:var(--copper);font-weight:600;display:block;margin-bottom:14px;\n  }\n  .sec-head h2{font-size:clamp(1.9rem,3.4vw,2.7rem);font-weight:600;line-height:1.12}\n  .sec-head p{color:var(--ink-soft);margin-top:14px;font-size:1.05rem}\n\n  .ledger{border-top:1px solid var(--ink)}\n  .row{\n    display:grid;grid-template-columns:70px 1fr 1.1fr auto;gap:24px;align-items:baseline;\n    padding:26px 10px;border-bottom:1px solid var(--line);\n    text-decoration:none;color:inherit;position:relative;\n    transition:background .2s,padding-left .25s;\n  }\n  .row:hover{background:var(--paper-2);padding-left:22px}\n  .row .num{font-family:'Fraunces',serif;font-style:italic;color:var(--copper);font-size:1.05rem}\n  .row h3{font-size:1.35rem;font-weight:600}\n  .row p{color:var(--ink-soft);font-size:.95rem}\n  .row .arrow{\n    width:34px;height:34px;border:1.5px solid var(--ink);border-radius:50%;\n    display:flex;align-items:center;justify-content:center;align-self:center;\n    transition:background .2s,color .2s,transform .25s;flex:none;\n  }\n  .row:hover .arrow{background:var(--copper);border-color:var(--copper);color:var(--paper);transform:translateX(4px)}\n  .row .arrow svg{width:14px;height:14px}\n\n  /* ---------- family / about ---------- */\n  .about{background:var(--ink);color:var(--paper)}\n  .about .kicker{color:var(--brass)}\n  .about-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:64px;align-items:center}\n  .about h2{font-size:clamp(1.9rem,3.4vw,2.7rem);font-weight:600;line-height:1.14;margin-bottom:20px}\n  .about p{color:#B9C4C6;margin-bottom:16px;font-size:1.02rem}\n  .about p strong{color:var(--paper)}\n  .sig{font-family:'Fraunces',serif;font-style:italic;font-size:1.5rem;color:var(--brass);margin-top:26px}\n  .sig small{display:block;font-family:'Archivo',sans-serif;font-style:normal;font-size:.8rem;letter-spacing:.15em;text-transform:uppercase;color:#8FA0A4;margin-top:4px}\n\n  .note-card{\n    background:var(--paper);color:var(--ink);\n    padding:38px 34px;transform:rotate(-1.6deg);\n    box-shadow:10px 14px 0 rgba(0,0,0,.25);\n    position:relative;max-width:420px;margin:0 auto;\n  }\n  .note-card::before{\n    content:\"\";position:absolute;top:-14px;left:50%;transform:translateX(-50%) rotate(2deg);\n    width:110px;height:28px;background:rgba(180,85,31,.35);border:1px solid rgba(180,85,31,.25);\n  }\n  .note-card p{color:var(--ink);font-family:'Fraunces',serif;font-size:1.15rem;line-height:1.5;margin:0}\n  .stats{\n    display:grid;grid-template-columns:1fr 1fr;gap:0;margin-top:34px;\n    border:1px solid var(--line);\n  }\n  .stat{padding:22px 24px;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}\n  .stat:nth-child(2n){border-right:none}\n  .stat:nth-child(n+3){border-bottom:none}\n  .stat b{font-family:'Fraunces',serif;font-size:2rem;color:var(--copper);display:block;line-height:1.1}\n  .stat span{font-size:.85rem;color:var(--ink-soft)}\n\n  /* ---------- quotes ---------- */\n  .quote-box{max-width:820px;margin:0 auto;text-align:center;position:relative;min-height:240px}\n  .quote-box .qmark{\n    font-family:'Fraunces',serif;font-size:5rem;line-height:.5;color:var(--copper);display:block;margin-bottom:26px;\n  }\n  blockquote{\n    font-family:'Fraunces',serif;font-size:clamp(1.35rem,2.6vw,1.9rem);\n    font-weight:400;line-height:1.4;transition:opacity .3s;\n  }\n  .cite{margin-top:24px;font-size:.9rem;color:var(--ink-soft);transition:opacity .3s}\n  .cite b{color:var(--copper);text-transform:uppercase;letter-spacing:.12em;font-size:.78rem}\n  .q-dots{display:flex;gap:10px;justify-content:center;margin-top:34px}\n  .q-dots button{\n    width:12px;height:12px;border-radius:50%;border:1.5px solid var(--copper);\n    background:transparent;cursor:pointer;padding:0;transition:background .2s;\n  }\n  .q-dots button.on{background:var(--copper)}\n\n  /* ---------- areas ---------- */\n  .areas{background:var(--paper-2);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}\n  .cluster{display:flex;flex-wrap:wrap;gap:12px;align-items:baseline;max-width:900px}\n  .cluster span{\n    font-family:'Fraunces',serif;color:var(--ink);\n    padding:6px 16px;border:1px solid var(--line);border-radius:999px;background:var(--paper);\n    transition:border-color .2s,color .2s;cursor:default;\n  }\n  .cluster span:hover{border-color:var(--copper);color:var(--copper)}\n  .cluster span.big{font-size:1.5rem;font-weight:600;border-color:var(--ink)}\n  .cluster span.md{font-size:1.15rem}\n  .cluster small{color:var(--ink-soft);font-size:.9rem;margin-left:6px}\n\n  /* ---------- emergency band ---------- */\n  .emergency{background:var(--copper);color:var(--paper);text-align:center}\n  .emergency .kicker{\n    font-size:.78rem;letter-spacing:.24em;text-transform:uppercase;font-weight:600;\n    display:inline-flex;align-items:center;gap:10px;margin-bottom:18px;\n  }\n  .emergency .kicker::before,.emergency .kicker::after{content:\"\";width:30px;height:1.5px;background:var(--paper)}\n  .emergency h2{font-size:clamp(2rem,4.4vw,3.4rem);font-weight:600;line-height:1.1;margin-bottom:14px}\n  .emergency p{opacity:.9;max-width:34em;margin:0 auto 32px;font-size:1.08rem}\n  .emergency .big-tel{\n    font-family:'Fraunces',serif;font-size:clamp(1.8rem,4vw,2.8rem);font-weight:700;\n    color:var(--paper);text-decoration:none;display:inline-flex;align-items:center;gap:16px;\n    border-bottom:3px solid var(--paper);padding-bottom:6px;transition:opacity .2s;\n  }\n  .emergency .big-tel:hover{opacity:.8}\n  .emergency .big-tel svg{width:.8em;height:.8em}\n\n  /* ---------- footer ---------- */\n  footer{background:var(--ink);color:#8FA0A4;padding:56px 0 34px;font-size:.9rem}\n  .foot-grid{display:flex;justify-content:space-between;gap:40px;flex-wrap:wrap;padding-bottom:34px;border-bottom:1px solid #2E4148}\n  footer .brand b{color:var(--paper)}\n  footer h4{color:var(--paper);font-family:'Archivo',sans-serif;font-size:.78rem;letter-spacing:.18em;text-transform:uppercase;margin-bottom:14px}\n  footer ul{list-style:none}\n  footer li{margin-bottom:8px}\n  footer a{color:#8FA0A4;text-decoration:none;transition:color .2s}\n  footer a:hover{color:var(--brass)}\n  .foot-base{display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;padding-top:24px;font-size:.8rem}\n\n  /* ---------- responsive ---------- */\n  @media(max-width:900px){\n    .hero-grid,.about-grid{grid-template-columns:1fr}\n    .tap-stage{order:-1;max-width:300px;margin:0 auto}\n    nav.links{display:none}\n    .row{grid-template-columns:44px 1fr;gap:8px 18px}\n    .row p{grid-column:2}\n    .row .arrow{display:none}\n  }\n</style>\n</head>\n<body>\n\n<!-- ======= HEADER ======= -->\n<header>\n  <div class=\"wrap nav\">\n    <a class=\"brand\" href=\"#top\">\n      <svg class=\"mark\" viewBox=\"0 0 40 40\" fill=\"none\">\n        <circle cx=\"20\" cy=\"20\" r=\"18.5\" stroke=\"#B4551F\" stroke-width=\"2.4\"/>\n        <path d=\"M13 12v7a7 7 0 0 0 14 0v-7\" stroke=\"#1C2B30\" stroke-width=\"2.6\" stroke-linecap=\"round\"/>\n        <path d=\"M20 26v6\" stroke=\"#1C2B30\" stroke-width=\"2.6\" stroke-linecap=\"round\"/>\n        <path d=\"M16 32h8\" stroke=\"#B4551F\" stroke-width=\"2.6\" stroke-linecap=\"round\"/>\n      </svg>\n      <span>\n        <b>Schofield &amp; Sons</b>\n        <span>Plumbers \u00b7 Leeds</span>\n      </span>\n    </a>\n    <nav class=\"links\">\n      <a href=\"#services\">Services</a>\n      <a href=\"#family\">Our Family</a>\n      <a href=\"#reviews\">Reviews</a>\n      <a href=\"#areas\">Areas</a>\n    </nav>\n    <a class=\"call-btn\" href=\"tel:01131234567\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.13.96.36 1.9.7 2.8a2 2 0 0 1-.45 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.45c.9.34 1.84.57 2.8.7a2 2 0 0 1 1.7 2.05z\"/></svg>\n      0113 123 4567\n    </a>\n  </div>\n</header>\n\n<!-- ======= HERO ======= -->\n<section class=\"hero\" id=\"top\" style=\"padding-bottom:0\">\n  <div class=\"wrap hero-grid\">\n    <div>\n      <span class=\"eyebrow\">Family-run since 1987</span>\n      <h1>Fixed properly, by people who <em>answer the phone.</em></h1>\n      <p class=\"lede\">Three generations of Schofields have kept Leeds flowing \u2014 from a dripping tap in Headingley to a full boiler refit in Roundhay. No call centres, no subcontractors, no fuss.</p>\n      <div class=\"hero-ctas\">\n        <a class=\"btn-primary\" href=\"tel:01131234567\">\n          Book a visit\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n        </a>\n        <a class=\"btn-ghost\" href=\"#services\">See what we do</a>\n      </div>\n    </div>\n\n    <!-- The dripping tap -->\n    <div class=\"tap-stage\" aria-hidden=\"true\">\n      <svg viewBox=\"0 0 240 250\" width=\"280\">\n        <!-- pipes behind -->\n        <path d=\"M118 12 v34\" stroke=\"#D8CCB6\" stroke-width=\"10\"/>\n        <path d=\"M118 12 v34\" stroke=\"#B4551F\" stroke-width=\"4\" class=\"flow-line\"/>\n        <!-- handle -->\n        <g class=\"handle-turn\">\n          <rect x=\"112\" y=\"44\" width=\"12\" height=\"26\" rx=\"4\" fill=\"#B4551F\"/>\n          <rect x=\"88\" y=\"66\" width=\"60\" height=\"12\" rx=\"6\" fill=\"#8E3F14\"/>\n          <circle cx=\"118\" cy=\"72\" r=\"6\" fill=\"#D9A24A\"/>\n        </g>\n        <!-- tap body -->\n        <path d=\"M118 78 v22 h34 a14 14 0 0 1 14 14 v18 h-16 v-12 a4 4 0 0 0-4-4 h-28 v-38 z\" fill=\"#1C2B30\"/>\n        <rect x=\"146\" y=\"128\" width=\"22\" height=\"8\" rx=\"3\" fill=\"#8E3F14\"/>\n        <!-- spout outline highlight -->\n        <path d=\"M124 84 v10 h28 a10 10 0 0 1 10 10 v14\" stroke=\"#3E525A\" stroke-width=\"2.5\" fill=\"none\" stroke-linecap=\"round\"/>\n        <!-- droplet -->\n        <g class=\"drip\">\n          <path d=\"M157 150 c-5 8 -7 11 -7 15 a7 7 0 0 0 14 0 c0-4 -2-7 -7-15z\" fill=\"#B4551F\"/>\n        </g>\n        <!-- puddle -->\n        <ellipse class=\"puddle\" cx=\"157\" cy=\"222\" rx=\"20\" ry=\"5\" fill=\"none\" stroke=\"#B4551F\" stroke-width=\"2.5\"/>\n        <!-- basin edge -->\n        <path d=\"M60 236 h200\" stroke=\"#1C2B30\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n        <path d=\"M60 236 h200\" stroke=\"#D9A24A\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-dasharray=\"2 8\"/>\n      </svg>\n    </div>\n  </div>\n\n  <!-- trust strip -->\n  <div class=\"trust\">\n    <div class=\"wrap trust-in\">\n      <div>\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/><path d=\"M9 12l2 2 4-4\"/></svg>\n        <span><b>Gas Safe</b> registered</span>\n      </div>\n      <div>\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 2l3 6.3 7 .9-5 4.9 1.2 6.9L12 17.8 5.8 21l1.2-6.9-5-4.9 7-.9z\"/></svg>\n        <span><b>5.0 rating</b> \u00b7 300+ reviews</span>\n      </div>\n      <div>\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 6v6l4 2\"/></svg>\n        <span><b>38 years</b> on the tools</span>\n      </div>\n      <div>\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\"/></svg>\n        <span><b>Fixed price</b> quotes, always</span>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ======= SERVICES ======= -->\n<section id=\"services\">\n  <div class=\"wrap\">\n    <div class=\"sec-head rv\">\n      <span class=\"kicker\">What we do</span>\n      <h2>One number for everything water touches.</h2>\n      <p>From a two-minute job to a full bathroom rip-out \u2014 quoted clearly before we lift a spanner.</p>\n    </div>\n\n    <div class=\"ledger rv\">\n      <a class=\"row\" href=\"tel:01131234567\">\n        <span class=\"num\">01</span>\n        <h3>Emergency call-outs</h3>\n        <p>Burst pipes, no water, flooding \u2014 we aim to be with you within the hour, anywhere in Leeds.</p>\n        <span class=\"arrow\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></span>\n      </a>\n      <a class=\"row\" href=\"tel:01131234567\">\n        <span class=\"num\">02</span>\n        <h3>Boilers &amp; heating</h3>\n        <p>Servicing, repairs and full replacements. We fit what your home needs, not what earns us the biggest margin.</p>\n        <span class=\"arrow\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></span>\n      </a>\n      <a class=\"row\" href=\"tel:01131234567\">\n        <span class=\"num\">03</span>\n        <h3>Bathrooms &amp; kitchens</h3>\n        <p>Design to tiling, one trusted crew start to finish. We've done hundreds across LS postcodes.</p>\n        <span class=\"arrow\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></span>\n      </a>\n      <a class=\"row\" href=\"tel:01131234567\">\n        <span class=\"num\">04</span>\n        <h3>Leaks &amp; pipework</h3>\n        <p>Trace and access, re-piping, radiator balancing \u2014 the fiddly jobs other firms walk away from.</p>\n        <span class=\"arrow\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></span>\n      </a>\n      <a class=\"row\" href=\"tel:01131234567\">\n        <span class=\"num\">05</span>\n        <h3>Landlord certificates</h3>\n        <p>Gas safety records and compliance checks, with reminders so you never miss a renewal date.</p>\n        <span class=\"arrow\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></span>\n      </a>\n    </div>\n  </div>\n</section>\n\n<!-- ======= FAMILY ======= -->\n<section class=\"about\" id=\"family\">\n  <div class=\"wrap about-grid\">\n    <div class=\"rv\">\n      <span class=\"kicker\" style=\"color:var(--brass);display:block;margin-bottom:14px;font-size:.78rem;letter-spacing:.2em;text-transform:uppercase;font-weight:600\">Our family</span>\n      <h2>Dad taught me. His dad taught him.</h2>\n      <p>Ken Schofield started out with a van, a toolbox and a borrowed phone line in 1987. His son <strong>Tom runs the jobs now</strong>, and grandson Alfie is serving his apprenticeship \u2014 third Schofield on the tools.</p>\n      <p>We've deliberately stayed small. When you ring, you talk to <strong>someone whose name is on the van</strong>. When we quote, that's the price. When we leave, it works \u2014 or we come back for free.</p>\n      <p class=\"sig\">\"Do it as if it were your own mum's house.\"<small>\u2014 Ken Schofield, founder, still says it weekly</small></p>\n    </div>\n    <div class=\"rv\">\n      <div class=\"note-card\">\n        <p>Mr Schofield arrived in 40 minutes on a Sunday, fixed the burst pipe in the loft, and wouldn't take a penny extra for the weekend. Who does that anymore?</p>\n        <div class=\"stats\">\n          <div class=\"stat\"><b>38</b><span>years in Leeds</span></div>\n          <div class=\"stat\"><b>12k+</b><span>jobs completed</span></div>\n          <div class=\"stat\"><b>3</b><span>generations</span></div>\n          <div class=\"stat\"><b>1</b><span>number to ring</span></div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ======= REVIEWS ======= -->\n<section id=\"reviews\">\n  <div class=\"wrap\">\n    <div class=\"sec-head rv\" style=\"text-align:center;margin-left:auto;margin-right:auto\">\n      <span class=\"kicker\">Word of mouth</span>\n      <h2>Leeds has been kind to us.</h2>\n    </div>\n    <div class=\"quote-box rv\">\n      <span class=\"qmark\">&ldquo;</span>\n      <blockquote id=\"qtext\">Arrived within the hour on a Sunday, fixed the leak, hoovered up after himself, and the price matched the quote to the penny. I've already given his number to three neighbours.</blockquote>\n      <div class=\"cite\" id=\"qcite\"><b>Sarah M.</b> \u00b7 Chapel Allerton \u00b7 Emergency call-out</div>\n      <div class=\"q-dots\" id=\"qdots\">\n        <button class=\"on\" aria-label=\"Review 1\"></button>\n        <button aria-label=\"Review 2\"></button>\n        <button aria-label=\"Review 3\"></button>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ======= AREAS ======= -->\n<section class=\"areas\" id=\"areas\">\n  <div class=\"wrap\">\n    <div class=\"sec-head rv\">\n      <span class=\"kicker\">Where we work</span>\n      <h2>All of Leeds, and a bit beyond.</h2>\n    </div>\n    <div class=\"cluster rv\">\n      <span class=\"big\">Headingley</span>\n      <span class=\"md\">Chapel Allerton</span>\n      <span>Roundhay</span>\n      <span class=\"md\">Meanwood</span>\n      <span>Kirkstall</span>\n      <span class=\"big\">Horsforth</span>\n      <span>Alwoodley</span>\n      <span class=\"md\">Morley</span>\n      <span>Pudsey</span>\n      <span class=\"md\">Garforth</span>\n      <span>Rothwell</span>\n      <span>Adel</span>\n      <span class=\"md\">Otley</span>\n      <span>Wetherby</span>\n      <small>\u2026and everywhere in between. If you're near, just ask.</small>\n    </div>\n  </div>\n</section>\n\n<!-- ======= EMERGENCY ======= -->\n<section class=\"emergency\">\n  <div class=\"wrap\">\n    <span class=\"kicker\">Day or night</span>\n    <h2>Water doesn't wait for Monday morning.</h2>\n    <p>Burst pipe at 3am? Boiler dead on Christmas Eve? Ring the number below \u2014 a Schofield picks up, not a machine.</p>\n    <a class=\"big-tel\" href=\"tel:01131234567\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.13.96.36 1.9.7 2.8a2 2 0 0 1-.45 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.45c.9.34 1.84.57 2.8.7a2 2 0 0 1 1.7 2.05z\"/></svg>\n      0113 123 4567\n    </a>\n  </div>\n</section>\n\n<!-- ======= FOOTER ======= -->\n<footer>\n  <div class=\"wrap\">\n    <div class=\"foot-grid\">\n      <div>\n        <a class=\"brand\" href=\"#top\" style=\"margin-bottom:16px\">\n          <svg class=\"mark\" viewBox=\"0 0 40 40\" fill=\"none\">\n            <circle cx=\"20\" cy=\"20\" r=\"18.5\" stroke=\"#D9A24A\" stroke-width=\"2.4\"/>\n            <path d=\"M13 12v7a7 7 0 0 0 14 0v-7\" stroke=\"#F6F1E7\" stroke-width=\"2.6\" stroke-linecap=\"round\"/>\n            <path d=\"M20 26v6\" stroke=\"#F6F1E7\" stroke-width=\"2.6\" stroke-linecap=\"round\"/>\n            <path d=\"M16 32h8\" stroke=\"#D9A24A\" stroke-width=\"2.6\" stroke-linecap=\"round\"/>\n          </svg>\n          <span><b>Schofield &amp; Sons</b><span style=\"color:var(--brass)\">Plumbers \u00b7 Leeds</span></span>\n        </a>\n        <p style=\"max-width:26em\">Independent family plumbers and heating engineers, serving Leeds and surroundings since 1987. Gas Safe registered \u00b7 Reg. no. 512944.</p>\n      </div>\n      <div>\n        <h4>Services</h4>\n        <ul>\n          <li><a href=\"#services\">Emergency call-outs</a></li>\n          <li><a href=\"#services\">Boilers &amp; heating</a></li>\n          <li><a href=\"#services\">Bathrooms</a></li>\n          <li><a href=\"#services\">Landlord certificates</a></li>\n        </ul>\n      </div>\n      <div>\n        <h4>Company</h4>\n        <ul>\n          <li><a href=\"#family\">Our family</a></li>\n          <li><a href=\"#reviews\">Reviews</a></li>\n          <li><a href=\"#areas\">Areas covered</a></li>\n        </ul>\n      </div>\n      <div>\n        <h4>Get in touch</h4>\n        <ul>\n          <li><a href=\"tel:01131234567\">0113 123 4567</a></li>\n          <li><a href=\"mailto:hello@schofieldandsons.co.uk\">hello@schofieldandsons.co.uk</a></li>\n          <li>Unit 4, Kirkstall Works<br>Leeds LS4 2AZ</li>\n        </ul>\n      </div>\n    </div>\n    <div class=\"foot-base\">\n      <span>\u00a9 2025 Schofield &amp; Sons Ltd. All rights reserved.</span>\n      <span>Mon\u2013Fri 8\u20136 \u00b7 Emergencies 24/7</span>\n    </div>\n  </div>\n</footer>\n\n<script>\n  // rotating reviews\n  const quotes=[\n    {t:\"Arrived within the hour on a Sunday, fixed the leak, hoovered up after himself, and the price matched the quote to the penny. I've already given his number to three neighbours.\",c:\"<b>Sarah M.</b> \u00b7 Chapel Allerton \u00b7 Emergency call-out\"},\n    {t:\"Tom talked us out of a new boiler we didn't need and serviced the old one instead. An honest plumber \u2014 I thought they were extinct.\",c:\"<b>David R.</b> \u00b7 Horsforth \u00b7 Boiler service\"},\n    {t:\"Full bathroom refit, start to finish, eleven days. They laid dust sheets everywhere, turned up when they said they would, and it looks superb a year on.\",c:\"<b>Priya K.</b> \u00b7 Roundhay \u00b7 Bathroom refit\"}\n  ];\n  const qtext=document.getElementById('qtext'),qcite=document.getElementById('qcite'),dots=[...document.getElementById('qdots').children];\n  let qi=0,timer;\n  function show(i){\n    qi=i;\n    qtext.style.opacity=0;qcite.style.opacity=0;\n    setTimeout(()=>{\n      qtext.textContent=quotes[i].t;qcite.innerHTML=quotes[i].c;\n      qtext.style.opacity=1;qcite.style.opacity=1;\n    },250);\n    dots.forEach((d,j)=>d.classList.toggle('on',j===i));\n  }\n  dots.forEach((d,i)=>d.addEventListener('click',()=>{show(i);clearInterval(timer);timer=setInterval(()=>show((qi+1)%3),6000);}));\n  timer=setInterval(()=>show((qi+1)%3),6000);\n\n  // scroll reveal\n  const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}}),{threshold:.15});\n  document.querySelectorAll('.rv').forEach(el=>io.observe(el));\n</script>\n</body>\n</html>\n"}