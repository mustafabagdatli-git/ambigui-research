{"brief": "B4", "model": "openai/gpt-6-luna", "i": 1, "finish": "stop", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#f5f1e8\">\n  <title>Small Hours Press \u2014 Poetry for the in-between</title>\n  <style>\n    :root {\n      --paper: #f5f1e8;\n      --ink: #202a24;\n      --green: #30483b;\n      --muted: #74796e;\n      --coral: #bd694e;\n      --line: #d9d5ca;\n      --serif: Georgia, \"Times New Roman\", serif;\n      --sans: \"Avenir Next\", Avenir, \"Segoe UI\", sans-serif;\n    }\n\n    * { box-sizing: border-box; }\n\n    html { scroll-behavior: smooth; }\n\n    body {\n      margin: 0;\n      background: var(--paper);\n      color: var(--ink);\n      font-family: var(--sans);\n      -webkit-font-smoothing: antialiased;\n    }\n\n    a { color: inherit; }\n\n    .announcement {\n      padding: 10px 20px;\n      background: var(--green);\n      color: #f7f3e9;\n      text-align: center;\n      font-size: 11px;\n      letter-spacing: .12em;\n      text-transform: uppercase;\n    }\n\n    .announcement a {\n      margin-left: 8px;\n      text-decoration-thickness: 1px;\n      text-underline-offset: 3px;\n    }\n\n    .site-header {\n      width: min(1200px, calc(100% - 64px));\n      margin: 0 auto;\n      min-height: 86px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      border-bottom: 1px solid var(--line);\n    }\n\n    .wordmark {\n      display: inline-flex;\n      align-items: center;\n      gap: 12px;\n      text-decoration: none;\n    }\n\n    .mark {\n      width: 35px;\n      height: 35px;\n      display: grid;\n      place-items: center;\n      border: 1px solid var(--green);\n      border-radius: 50%;\n      color: var(--green);\n      font-family: var(--serif);\n      font-size: 22px;\n      line-height: 1;\n    }\n\n    .wordmark-text {\n      font-family: var(--serif);\n      font-size: 19px;\n      line-height: 1.05;\n      letter-spacing: -.02em;\n    }\n\n    .wordmark-text small {\n      display: block;\n      margin-top: 4px;\n      color: var(--muted);\n      font-family: var(--sans);\n      font-size: 9px;\n      letter-spacing: .2em;\n      text-transform: uppercase;\n    }\n\n    nav {\n      display: flex;\n      align-items: center;\n      gap: 32px;\n      font-size: 12px;\n      letter-spacing: .06em;\n    }\n\n    nav a {\n      text-decoration: none;\n      transition: color .2s ease;\n    }\n\n    nav a:hover { color: var(--coral); }\n\n    nav .nav-cta {\n      padding: 12px 17px;\n      border: 1px solid var(--green);\n      border-radius: 2px;\n    }\n\n    .hero {\n      width: min(1200px, calc(100% - 64px));\n      min-height: 590px;\n      margin: 0 auto;\n      display: grid;\n      grid-template-columns: 1.05fr .95fr;\n      align-items: center;\n      gap: 50px;\n      padding: 58px 0 70px;\n    }\n\n    .eyebrow {\n      display: flex;\n      align-items: center;\n      gap: 11px;\n      margin: 0 0 22px;\n      color: var(--coral);\n      font-size: 10px;\n      font-weight: 600;\n      letter-spacing: .2em;\n      text-transform: uppercase;\n    }\n\n    .eyebrow::before {\n      content: \"\";\n      width: 27px;\n      height: 1px;\n      background: currentColor;\n    }\n\n    h1, h2, h3, p { margin-top: 0; }\n\n    h1 {\n      max-width: 620px;\n      margin-bottom: 22px;\n      font-family: var(--serif);\n      font-size: clamp(54px, 7vw, 92px);\n      font-weight: 400;\n      line-height: .98;\n      letter-spacing: -.065em;\n    }\n\n    h1 em {\n      color: var(--green);\n      font-weight: 400;\n    }\n\n    .hero-copy {\n      max-width: 430px;\n      margin-bottom: 30px;\n      color: #62695f;\n      font-family: var(--serif);\n      font-size: 18px;\n      line-height: 1.65;\n    }\n\n    .button {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: 18px;\n      padding: 15px 20px;\n      background: var(--green);\n      color: #fffdf6;\n      font-size: 11px;\n      letter-spacing: .1em;\n      text-decoration: none;\n      text-transform: uppercase;\n      transition: background .2s ease, transform .2s ease;\n    }\n\n    .button:hover {\n      background: #24382d;\n      transform: translateY(-2px);\n    }\n\n    .button span { font-size: 16px; }\n\n    .hero-art {\n      min-height: 440px;\n      position: relative;\n      display: grid;\n      place-items: center;\n      overflow: hidden;\n      background:\n        radial-gradient(ellipse at 67% 30%, rgba(216, 173, 124, .35), transparent 35%),\n        #e8e2d5;\n    }\n\n    .hero-art::before,\n    .hero-art::after {\n      content: \"\";\n      position: absolute;\n      width: 240px;\n      height: 240px;\n      border: 1px solid rgba(48, 72, 59, .18);\n      border-radius: 50%;\n    }\n\n    .hero-art::before { transform: translate(-105px, 110px); }\n    .hero-art::after { transform: translate(120px, -100px); }\n\n    .cover {\n      z-index: 1;\n      width: 245px;\n      height: 340px;\n      position: relative;\n      padding: 27px 25px;\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      background: #a95e46;\n      color: #f6ead6;\n      box-shadow: 18px 22px 35px rgba(40, 43, 33, .18);\n      transform: rotate(-5deg);\n    }\n\n    .cover::before {\n      content: \"\";\n      position: absolute;\n      inset: 10px;\n      border: 1px solid rgba(246, 234, 214, .5);\n    }\n\n    .cover-top, .cover-title, .cover-author { position: relative; }\n\n    .cover-top {\n      font-size: 8px;\n      letter-spacing: .2em;\n      text-transform: uppercase;\n    }\n\n    .cover-title {\n      margin: 0;\n      font-family: var(--serif);\n      font-size: 42px;\n      font-weight: 400;\n      line-height: .9;\n      letter-spacing: -.06em;\n    }\n\n    .cover-title em { font-weight: 400; }\n\n    .cover-author {\n      font-size: 9px;\n      letter-spacing: .16em;\n      text-transform: uppercase;\n    }\n\n    .art-note {\n      position: absolute;\n      right: 25px;\n      bottom: 23px;\n      color: var(--muted);\n      font-family: var(--serif);\n      font-size: 12px;\n      font-style: italic;\n    }\n\n    .section {\n      border-top: 1px solid var(--line);\n    }\n\n    .section-inner {\n      width: min(1200px, calc(100% - 64px));\n      margin: 0 auto;\n      padding: 78px 0;\n    }\n\n    .featured {\n      display: grid;\n      grid-template-columns: .7fr 1.3fr;\n      gap: 80px;\n      align-items: start;\n    }\n\n    .section-kicker {\n      margin: 5px 0 14px;\n      color: var(--coral);\n      font-size: 10px;\n      letter-spacing: .2em;\n      text-transform: uppercase;\n    }\n\n    .section-title {\n      margin: 0;\n      font-family: var(--serif);\n      font-size: clamp(34px, 4vw, 49px);\n      font-weight: 400;\n      line-height: 1.04;\n      letter-spacing: -.045em;\n    }\n\n    .featured-content {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 42px;\n      align-items: center;\n    }\n\n    .featured-content h3 {\n      margin-bottom: 10px;\n      font-family: var(--serif);\n      font-size: 28px;\n      font-weight: 400;\n      letter-spacing: -.03em;\n    }\n\n    .featured-content p {\n      color: #686e64;\n      font-family: var(--serif);\n      font-size: 16px;\n      line-height: 1.7;\n    }\n\n    .text-link {\n      display: inline-block;\n      margin-top: 7px;\n      color: var(--green);\n      font-size: 10px;\n      letter-spacing: .13em;\n      text-decoration: none;\n      text-transform: uppercase;\n      border-bottom: 1px solid var(--green);\n      padding-bottom: 5px;\n    }\n\n    .poem-card {\n      min-height: 230px;\n      padding: 29px;\n      background: #e8e2d5;\n      display: flex;\n      flex-direction: column;\n      justify-content: center;\n    }\n\n    .poem-card blockquote {\n      margin: 0;\n      color: var(--green);\n      font-family: var(--serif);\n      font-size: 21px;\n      line-height: 1.5;\n    }\n\n    .poem-card cite {\n      margin-top: 17px;\n      color: var(--muted);\n      font-size: 9px;\n      font-style: normal;\n      letter-spacing: .14em;\n      text-transform: uppercase;\n    }\n\n    .about {\n      background: var(--green);\n      color: #f4f0e6;\n    }\n\n    .about .section-inner {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 80px;\n      align-items: center;\n    }\n\n    .about .section-kicker { color: #d59a7b; }\n\n    .about-copy {\n      max-width: 500px;\n      color: #d8ded4;\n      font-family: var(--serif);\n      font-size: 18px;\n      line-height: 1.7;\n    }\n\n    .about .text-link {\n      color: #f4f0e6;\n      border-color: #f4f0e6;\n    }\n\n    .newsletter {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 50px;\n      align-items: center;\n    }\n\n    .newsletter p {\n      max-width: 420px;\n      margin: 14px 0 0;\n      color: #686e64;\n      font-family: var(--serif);\n      font-size: 16px;\n      line-height: 1.6;\n    }\n\n    .signup-form {\n      display: flex;\n      border-bottom: 1px solid var(--ink);\n    }\n\n    .signup-form input {\n      width: 100%;\n      min-width: 0;\n      padding: 15px 5px;\n      border: 0;\n      outline: 0;\n      background: transparent;\n      color: var(--ink);\n      font: inherit;\n      font-size: 13px;\n    }\n\n    .signup-form input::placeholder { color: #85897f; }\n\n    .signup-form button {\n      flex: 0 0 auto;\n      padding: 0 5px 0 15px;\n      border: 0;\n      background: transparent;\n      color: var(--green);\n      font: inherit;\n      font-size: 10px;\n      letter-spacing: .12em;\n      text-transform: uppercase;\n      cursor: pointer;\n    }\n\n    footer {\n      border-top: 1px solid var(--line);\n    }\n\n    .footer-inner {\n      width: min(1200px, calc(100% - 64px));\n      min-height: 85px;\n      margin: 0 auto;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 20px;\n      color: var(--muted);\n      font-size: 10px;\n      letter-spacing: .08em;\n    }\n\n    .footer-links {\n      display: flex;\n      gap: 22px;\n    }\n\n    .footer-links a { text-decoration: none; }\n\n    @media (max-width: 760px) {\n      .site-header, .hero, .section-inner, .footer-inner {\n        width: min(100% - 40px, 560px);\n      }\n\n      .site-header { min-height: 72px; }\n\n      nav { gap: 15px; }\n      nav a:not(.nav-cta) { display: none; }\n\n      .hero {\n        grid-template-columns: 1fr;\n        gap: 34px;\n        padding: 55px 0 48px;\n      }\n\n      h1 { font-size: clamp(56px, 15vw, 78px); }\n\n      .hero-art { min-height: 380px; }\n      .cover { transform: rotate(-4deg) scale(.9); }\n\n      .section-inner { padding: 58px 0; }\n\n      .featured,\n      .about .section-inner,\n      .newsletter {\n        grid-template-columns: 1fr;\n        gap: 30px;\n      }\n\n      .featured-content { grid-template-columns: 1fr; gap: 25px; }\n      .poem-card { min-height: 190px; }\n\n      .footer-inner {\n        padding: 22px 0;\n        align-items: flex-start;\n        flex-direction: column;\n      }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      html { scroll-behavior: auto; }\n      *, *::before, *::after { transition-duration: .01ms !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"announcement\">\n    Our spring list is here <a href=\"#books\">Meet the new voices \u2192</a>\n  </div>\n\n  <header class=\"site-header\">\n    <a class=\"wordmark\" href=\"#\" aria-label=\"Small Hours Press home\">\n      <span class=\"mark\" aria-hidden=\"true\">s</span>\n      <span class=\"wordmark-text\">small hours<small>poetry press</small></span>\n    </a>\n    <nav aria-label=\"Main navigation\">\n      <a href=\"#books\">Books</a>\n      <a href=\"#about\">Our story</a>\n      <a href=\"#newsletter\">Notes from us</a>\n      <a class=\"nav-cta\" href=\"#books\">Browse the list</a>\n    </nav>\n  </header>\n\n  <main>\n    <section class=\"hero\" aria-labelledby=\"hero-title\">\n      <div>\n        <p class=\"eyebrow\">Independent poetry, made with care</p>\n        <h1 id=\"hero-title\">For the words that <em>stay</em> with you.</h1>\n        <p class=\"hero-copy\">\n          Small Hours is an independent press for poems with mud on their boots\n          and stars in their pockets. Books to keep close, and pass along.\n        </p>\n        <a class=\"button\" href=\"#books\">Find your next read <span aria-hidden=\"true\">\u2192</span></a>\n      </div>\n\n      <div class=\"hero-art\" aria-label=\"A featured poetry book, The Shape of Rain\">\n        <div class=\"cover\">\n          <span class=\"cover-top\">Small Hours Press \u00b7 014</span>\n          <p class=\"cover-title\">The<br>Shape<br><em>of Rain</em></p>\n          <span class=\"cover-author\">Mara Ellison</span>\n        </div>\n        <span class=\"art-note\">A new collection for spring</span>\n      </div>\n    </section>\n\n    <section class=\"section\" id=\"books\">\n      <div class=\"section-inner featured\">\n        <div>\n          <p class=\"section-kicker\">Just released</p>\n          <h2 class=\"section-title\">A little room<br>to feel it all.</h2>\n        </div>\n\n        <div class=\"featured-content\">\n          <div>\n            <h3>The Shape of Rain</h3>\n            <p>\n              Mara Ellison writes toward the places where weather meets memory.\n              These are tender, clear-eyed poems about starting over, paying\n              attention, and finding your way home.\n            </p>\n            <a class=\"text-link\" href=\"#newsletter\">Discover the collection&nbsp; \u2192</a>\n          </div>\n          <div class=\"poem-card\">\n            <blockquote>\n              \u201cSome days the sky opens<br>\n              just enough to let<br>\n              the garden breathe.\u201d\n            </blockquote>\n            <cite>From \u201cAfter the Dry Spell\u201d</cite>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section about\" id=\"about\">\n      <div class=\"section-inner\">\n        <div>\n          <p class=\"section-kicker\">A small press with a big heart</p>\n          <h2 class=\"section-title\">Good poems<br>make good company.</h2>\n        </div>\n        <div>\n          <p class=\"about-copy\">\n            We publish a handful of singular voices each year: work that feels\n            alive, generous, and a little unexpected. Based in a book-filled\n            room by the sea, we believe a poem can make the everyday feel new.\n          </p>\n          <a class=\"text-link\" href=\"#newsletter\">A little more about us&nbsp; \u2192</a>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section\" id=\"newsletter\">\n      <div class=\"section-inner newsletter\">\n        <div>\n          <p class=\"section-kicker\">The occasional letter</p>\n          <h2 class=\"section-title\">A poem in your inbox?</h2>\n          <p>New books, favorite lines, and notes from our little corner of the world. No noise, just the good stuff.</p>\n        </div>\n        <form class=\"signup-form\" action=\"#\" method=\"post\">\n          <label for=\"email\" class=\"visually-hidden\">Your email address</label>\n          <input id=\"email\" type=\"email\" name=\"email\" placeholder=\"Your email address\" required>\n          <button type=\"submit\">Count me in&nbsp; \u2192</button>\n        </form>\n      </div>\n    </section>\n  </main>\n\n  <footer>\n    <div class=\"footer-inner\">\n      <span>\u00a9 2025 Small Hours Press \u00b7 Made slowly, read often.</span>\n      <div class=\"footer-links\">\n        <a href=\"#about\">Contact</a>\n        <a href=\"#books\">Instagram</a>\n        <a href=\"#newsletter\">Newsletter</a>\n      </div>\n    </div>\n  </footer>\n\n  <style>\n    .visually-hidden {\n      position: absolute;\n      width: 1px;\n      height: 1px;\n      padding: 0;\n      margin: -1px;\n      overflow: hidden;\n      clip: rect(0, 0, 0, 0);\n      white-space: nowrap;\n      border: 0;\n    }\n  </style>\n</body>\n</html>\n"}