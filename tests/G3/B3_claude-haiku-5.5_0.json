{"brief": "B3", "model": "anthropic/claude-haiku-5.5", "i": 0, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Tessera: The Open-Source Database for Data Engineers</title>\n<meta name=\"description\" content=\"Tessera is an open-source, columnar database built for data engineers. Ingest streams, evolve schemas, time-travel over history, and query with SQL or Python.\">\n<style>\n  :root {\n    --bg: #0b0d12;\n    --bg-elev: #12151c;\n    --bg-card: #161a23;\n    --border: #252b38;\n    --border-strong: #343c4d;\n    --text: #e6e9f0;\n    --text-dim: #9aa3b5;\n    --text-faint: #6b7385;\n    --accent: #2dd4bf;\n    --accent-2: #818cf8;\n    --accent-3: #f59e0b;\n    --danger: #f87171;\n    --grad: linear-gradient(135deg, #2dd4bf 0%, #818cf8 100%);\n    --radius: 14px;\n    --radius-sm: 8px;\n    --mono: ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace;\n    --sans: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n  }\n\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  html { scroll-behavior: smooth; }\n  body {\n    font-family: var(--sans);\n    background: var(--bg);\n    color: var(--text);\n    line-height: 1.6;\n    -webkit-font-smoothing: antialiased;\n    overflow-x: hidden;\n  }\n  a { color: inherit; text-decoration: none; }\n  img, svg { display: block; max-width: 100%; }\n  code, pre, .mono { font-family: var(--mono); }\n\n  .container { width: min(1180px, 92%); margin: 0 auto; }\n  section { padding: 110px 0; position: relative; }\n  .section-head { text-align: center; max-width: 720px; margin: 0 auto 64px; }\n  .eyebrow {\n    display: inline-block;\n    font-family: var(--mono);\n    font-size: 12px;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    color: var(--accent);\n    margin-bottom: 14px;\n  }\n  h1, h2, h3 { letter-spacing: -0.02em; line-height: 1.15; }\n  h2 { font-size: clamp(30px, 4vw, 44px); margin-bottom: 16px; }\n  h3 { font-size: 19px; margin-bottom: 8px; }\n  .lead { color: var(--text-dim); font-size: 18px; }\n  .gradient-text {\n    background: var(--grad);\n    -webkit-background-clip: text;\n    background-clip: text;\n    color: transparent;\n  }\n\n  /* Buttons */\n  .btn {\n    display: inline-flex; align-items: center; gap: 8px;\n    padding: 12px 22px;\n    border-radius: 10px;\n    font-weight: 600; font-size: 15px;\n    border: 1px solid transparent;\n    cursor: pointer;\n    transition: transform .15s ease, background .2s ease, border-color .2s ease, box-shadow .2s ease;\n    white-space: nowrap;\n  }\n  .btn:hover { transform: translateY(-1px); }\n  .btn-primary {\n    background: var(--accent);\n    color: #04201c;\n    box-shadow: 0 8px 30px -8px rgba(45, 212, 191, .55);\n  }\n  .btn-primary:hover { background: #5eead4; }\n  .btn-ghost {\n    background: transparent;\n    color: var(--text);\n    border-color: var(--border-strong);\n  }\n  .btn-ghost:hover { border-color: var(--text-dim); background: rgba(255,255,255,.03); }\n  .btn-sm { padding: 8px 14px; font-size: 14px; }\n\n  /* Nav */\n  header.nav {\n    position: sticky; top: 0; z-index: 50;\n    backdrop-filter: saturate(160%) blur(12px);\n    background: rgba(11, 13, 18, .72);\n    border-bottom: 1px solid var(--border);\n  }\n  .nav-inner {\n    display: flex; align-items: center; justify-content: space-between;\n    height: 68px;\n  }\n  .brand { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 18px; }\n  .brand small {\n    font-family: var(--mono); font-size: 11px; font-weight: 500;\n    color: var(--text-faint); border: 1px solid var(--border);\n    padding: 2px 6px; border-radius: 6px;\n  }\n  .nav-links { display: flex; gap: 30px; color: var(--text-dim); font-size: 15px; }\n  .nav-links a:hover { color: var(--text); }\n  .nav-actions { display: flex; gap: 12px; align-items: center; }\n  .stars {\n    display: inline-flex; align-items: center; gap: 6px;\n    font-family: var(--mono); font-size: 13px; color: var(--text-dim);\n    padding: 7px 12px; border: 1px solid var(--border); border-radius: 8px;\n  }\n\n  /* Hero */\n  .hero { padding: 90px 0 80px; overflow: hidden; }\n  .hero::before {\n    content: \"\"; position: absolute; inset: 0; z-index: -1;\n    background:\n      radial-gradient(700px 380px at 15% -10%, rgba(45,212,191,.18), transparent 70%),\n      radial-gradient(600px 380px at 90% 10%, rgba(129,140,248,.18), transparent 70%);\n  }\n  .hero-grid {\n    display: grid; grid-template-columns: 1.02fr 1fr; gap: 60px; align-items: center;\n  }\n  .pill {\n    display: inline-flex; align-items: center; gap: 10px;\n    padding: 6px 14px 6px 8px; border-radius: 999px;\n    border: 1px solid var(--border-strong); background: var(--bg-elev);\n    font-size: 13px; color: var(--text-dim); margin-bottom: 26px;\n  }\n  .pill b {\n    background: var(--accent); color: #04201c; font-size: 11px;\n    padding: 2px 8px; border-radius: 999px; font-weight: 700;\n  }\n  .hero h1 { font-size: clamp(40px, 5.6vw, 66px); margin-bottom: 22px; }\n  .hero p.sub { font-size: 19px; color: var(--text-dim); max-width: 560px; margin-bottom: 36px; }\n  .hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 30px; }\n\n  .install {\n    display: flex; align-items: center; justify-content: space-between; gap: 12px;\n    background: var(--bg-elev); border: 1px solid var(--border);\n    border-radius: var(--radius-sm); padding: 12px 14px 12px 18px;\n    max-width: 520px; font-family: var(--mono); font-size: 14px; color: var(--text-dim);\n  }\n  .install .prompt { color: var(--accent); margin-right: 8px; }\n  .copy-btn {\n    background: var(--bg-card); color: var(--text-dim);\n    border: 1px solid var(--border-strong); border-radius: 6px;\n    padding: 6px 12px; font-size: 12px; font-family: var(--sans); cursor: pointer;\n    transition: color .2s, border-color .2s;\n  }\n  .copy-btn:hover { color: var(--text); border-color: var(--text-dim); }\n\n  .hero-meta { display: flex; gap: 26px; margin-top: 28px; color: var(--text-faint); font-size: 14px; flex-wrap: wrap; }\n  .hero-meta span::before { content: \"\u2713 \"; color: var(--accent); }\n\n  /* Window mock */\n  .window {\n    background: var(--bg-elev);\n    border: 1px solid var(--border-strong);\n    border-radius: var(--radius);\n    box-shadow: 0 40px 80px -30px rgba(0,0,0,.8), 0 0 0 1px rgba(255,255,255,.02) inset;\n    overflow: hidden;\n  }\n  .window-bar {\n    display: flex; align-items: center; gap: 8px;\n    padding: 12px 16px; border-bottom: 1px solid var(--border);\n    background: #0f1218;\n  }\n  .dot { width: 11px; height: 11px; border-radius: 50%; background: #2a3140; }\n  .dot:nth-child(1) { background: #ff5f57; }\n  .dot:nth-child(2) { background: #febc2e; }\n  .dot:nth-child(3) { background: #28c840; }\n  .window-title { margin-left: 10px; font-family: var(--mono); font-size: 12px; color: var(--text-faint); }\n  .window-body { padding: 22px; font-family: var(--mono); font-size: 13.5px; line-height: 1.75; }\n  .tok-k { color: var(--accent-2); }\n  .tok-f { color: var(--accent); }\n  .tok-s { color: #fca5a5; }\n  .tok-n { color: var(--accent-3); }\n  .tok-c { color: var(--text-faint); font-style: italic; }\n  .tok-p { color: var(--text); }\n  .result {\n    margin-top: 14px; border-top: 1px dashed var(--border-strong); padding-top: 14px;\n    font-size: 12.5px;\n  }\n  .result table { width: 100%; border-collapse: collapse; }\n  .result th, .result td { text-align: left; padding: 6px 10px; border-bottom: 1px solid var(--border); }\n  .result th { color: var(--text-faint); font-weight: 500; }\n  .result td.num { color: var(--accent); text-align: right; }\n  .result th.num { text-align: right; }\n  .result-meta { color: var(--text-faint); margin-top: 10px; font-size: 12px; }\n\n  /* Trust strip */\n  .trust { padding: 40px 0; border-block: 1px solid var(--border); background: var(--bg-elev); }\n  .trust-label { text-align: center; font-size: 13px; color: var(--text-faint); letter-spacing: .08em; text-transform: uppercase; margin-bottom: 22px; }\n  .trust-row { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px 38px; }\n  .trust-row span {\n    font-family: var(--mono); font-size: 15px; color: var(--text-dim); font-weight: 600; opacity: .85;\n  }\n\n  /* Features */\n  .features-grid {\n    display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;\n  }\n  .feature {\n    background: var(--bg-card); border: 1px solid var(--border);\n    border-radius: var(--radius); padding: 30px;\n    transition: border-color .25s, transform .25s;\n    position: relative; overflow: hidden;\n  }\n  .feature:hover { border-color: var(--border-strong); transform: translateY(-3px); }\n  .feature::after {\n    content: \"\"; position: absolute; inset: 0; opacity: 0; transition: opacity .3s;\n    background: radial-gradient(400px 200px at var(--x,50%) 0%, rgba(45,212,191,.09), transparent 70%);\n    pointer-events: none;\n  }\n  .feature:hover::after { opacity: 1; }\n  .icon {\n    width: 44px; height: 44px; border-radius: 11px;\n    display: grid; place-items: center; margin-bottom: 20px;\n    background: rgba(45,212,191,.1); border: 1px solid rgba(45,212,191,.25);\n  }\n  .icon.purple { background: rgba(129,140,248,.1); border-color: rgba(129,140,248,.25); }\n  .icon.amber { background: rgba(245,158,11,.1); border-color: rgba(245,158,11,.25); }\n  .icon svg { width: 22px; height: 22px; }\n  .feature p { color: var(--text-dim); font-size: 15px; }\n  .feature code {\n    font-size: 12.5px; background: #0f1218; border: 1px solid var(--border);\n    padding: 1px 6px; border-radius: 5px; color: var(--accent);\n  }\n\n  /* Code tabs */\n  .split {\n    display: grid; grid-template-columns: .85fr 1.15fr; gap: 60px; align-items: center;\n  }\n  .split ul { list-style: none; margin-top: 28px; display: grid; gap: 16px; }\n  .split li { display: flex; gap: 14px; color: var(--text-dim); }\n  .split li strong { color: var(--text); display: block; margin-bottom: 2px; }\n  .split li::before {\n    content: \"\"; flex: 0 0 8px; height: 8px; border-radius: 50%; margin-top: 8px;\n    background: var(--grad);\n  }\n  .tabs { display: flex; gap: 6px; padding: 6px; background: #0f1218; border-bottom: 1px solid var(--border); }\n  .tab {\n    background: none; border: none; color: var(--text-faint);\n    font-family: var(--mono); font-size: 13px; padding: 8px 14px; border-radius: 7px; cursor: pointer;\n  }\n  .tab[aria-selected=\"true\"] { background: var(--bg-card); color: var(--text); }\n  .tab:hover { color: var(--text); }\n  .code-panel { display: none; }\n  .code-panel.active { display: block; }\n  .code-panel pre {\n    padding: 24px; font-family: var(--mono); font-size: 13.5px; line-height: 1.75;\n    overflow-x: auto; color: var(--text-dim);\n  }\n\n  /* Architecture */\n  .arch {\n    background: var(--bg-elev); border: 1px solid var(--border);\n    border-radius: var(--radius); padding: 40px; overflow-x: auto;\n  }\n  .arch svg { width: 100%; min-width: 760px; height: auto; }\n  .arch text { font-family: var(--sans); }\n  .arch .label { fill: var(--text); font-size: 15px; font-weight: 600; }\n  .arch .sublabel { fill: var(--text-faint); font-size: 12px; font-family: var(--mono); }\n  .flow { stroke: var(--border-strong); stroke-width: 1.5; fill: none; stroke-dasharray: 6 6; animation: dash 1.5s linear infinite; }\n  @keyframes dash { to { stroke-dashoffset: -24; } }\n\n  /* Benchmarks */\n  .bench { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; }\n  .bench-card {\n    background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 32px;\n  }\n  .bench-card h3 { margin-bottom: 4px; }\n  .bench-card .desc { color: var(--text-faint); font-size: 14px; margin-bottom: 26px; }\n  .bar-row { margin-bottom: 18px; }\n  .bar-head { display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 8px; color: var(--text-dim); }\n  .bar-head b { color: var(--text); font-family: var(--mono); font-weight: 600; }\n  .bar-track { height: 10px; background: #0f1218; border-radius: 999px; overflow: hidden; border: 1px solid var(--border); }\n  .bar-fill {\n    height: 100%; width: 0; border-radius: 999px; background: var(--grad);\n    transition: width 1.2s cubic-bezier(.2,.7,.2,1);\n  }\n  .bar-fill.muted { background: #343c4d; }\n  .bench-note { margin-top: 22px; font-size: 13px; color: var(--text-faint); text-align: center; }\n\n  /* Testimonials */\n  .quotes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }\n  .quote {\n    background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius);\n    padding: 28px; display: flex; flex-direction: column; justify-content: space-between; gap: 24px;\n  }\n  .quote p { color: var(--text-dim); font-size: 15.5px; }\n  .quote p::before { content: \"\\201C\"; color: var(--accent); font-size: 28px; line-height: 0; vertical-align: -10px; margin-right: 4px; }\n  .who { display: flex; align-items: center; gap: 12px; }\n  .avatar {\n    width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center;\n    font-weight: 700; font-size: 14px; color: #0b0d12; background: var(--grad);\n  }\n  .who strong { display: block; font-size: 14.5px; }\n  .who span { font-size: 13px; color: var(--text-faint); }\n\n  /* Steps */\n  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; counter-reset: step; }\n  .step {\n    padding: 30px; border-radius: var(--radius); border: 1px solid var(--border);\n    background: linear-gradient(180deg, var(--bg-card), var(--bg-elev));\n  }\n  .step-num {\n    font-family: var(--mono); font-size: 13px; color: var(--accent); margin-bottom: 18px;\n    display: inline-block; padding: 3px 9px; border: 1px solid rgba(45,212,191,.3); border-radius: 6px;\n  }\n  .step p { color: var(--text-dim); font-size: 15px; margin-bottom: 16px; }\n  .step pre {\n    font-family: var(--mono); font-size: 12.5px; background: #0b0d12; border: 1px solid var(--border);\n    border-radius: 8px; padding: 12px 14px; color: var(--text-dim); overflow-x: auto;\n  }\n\n  /* Community */\n  .community { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }\n  .stat {\n    text-align: center; padding: 30px 20px; border: 1px solid var(--border);\n    border-radius: var(--radius); background: var(--bg-card);\n  }\n  .stat .num { font-size: 38px; font-weight: 800; letter-spacing: -0.02em; }\n  .stat .lbl { color: var(--text-faint); font-size: 14px; margin-top: 4px; }\n\n  /* CTA */\n  .cta {\n    text-align: center; border-radius: 22px; padding: 80px 30px; position: relative; overflow: hidden;\n    border: 1px solid var(--border-strong);\n    background:\n      radial-gradient(600px 300px at 50% 0%, rgba(45,212,191,.22), transparent 70%),\n      radial-gradient(500px 300px at 50% 100%, rgba(129,140,248,.2), transparent 70%),\n      var(--bg-elev);\n  }\n  .cta h2 { margin-bottom: 14px; }\n  .cta p { color: var(--text-dim); margin-bottom: 34px; font-size: 18px; }\n  .cta .hero-ctas { justify-content: center; margin-bottom: 0; }\n\n  /* Footer */\n  footer { border-top: 1px solid var(--border); padding: 70px 0 40px; color: var(--text-dim); font-size: 14.5px; }\n  .foot-grid { display: grid; grid-template-columns: 2fr repeat(3, 1fr); gap: 40px; margin-bottom: 50px; }\n  .foot-grid p { color: var(--text-faint); margin-top: 14px; max-width: 300px; }\n  footer h4 { color: var(--text); font-size: 14px; margin-bottom: 16px; }\n  footer ul { list-style: none; display: grid; gap: 10px; }\n  footer ul a:hover { color: var(--text); }\n  .foot-bottom {\n    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 14px;\n    padding-top: 28px; border-top: 1px solid var(--border); color: var(--text-faint); font-size: 13px;\n  }\n  .license { font-family: var(--mono); }\n\n  /* Responsive */\n  @media (max-width: 1000px) {\n    .hero-grid, .split { grid-template-columns: 1fr; }\n    .features-grid, .quotes, .steps { grid-template-columns: 1fr 1fr; }\n    .community { grid-template-columns: 1fr 1fr; }\n    .nav-links { display: none; }\n  }\n  @media (max-width: 680px) {\n    section { padding: 80px 0; }\n    .features-grid, .quotes, .steps, .bench { grid-template-columns: 1fr; }\n    .stars { display: none; }\n    .foot-grid { grid-template-columns: 1fr 1fr; }\n    .cta { padding: 60px 22px; }\n    .hero { padding-top: 60px; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; }\n  }\n</style>\n</head>\n<body>\n\n<!-- Navigation -->\n<header class=\"nav\">\n  <div class=\"container nav-inner\">\n    <a href=\"#\" class=\"brand\">\n      <svg width=\"28\" height=\"28\" viewBox=\"0 0 28 28\" aria-hidden=\"true\">\n        <defs>\n          <linearGradient id=\"lg\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n            <stop offset=\"0\" stop-color=\"#2dd4bf\"/>\n            <stop offset=\"1\" stop-color=\"#818cf8\"/>\n          </linearGradient>\n        </defs>\n        <rect x=\"2\" y=\"2\" width=\"11\" height=\"11\" rx=\"2.5\" fill=\"url(#lg)\"/>\n        <rect x=\"15\" y=\"2\" width=\"11\" height=\"11\" rx=\"2.5\" fill=\"url(#lg)\" opacity=\".55\"/>\n        <rect x=\"2\" y=\"15\" width=\"11\" height=\"11\" rx=\"2.5\" fill=\"url(#lg)\" opacity=\".55\"/>\n        <rect x=\"15\" y=\"15\" width=\"11\" height=\"11\" rx=\"2.5\" fill=\"url(#lg)\"/>\n      </svg>\n      Tessera <small>v2.4</small>\n    </a>\n    <nav class=\"nav-links\" aria-label=\"Primary\">\n      <a href=\"#features\">Features</a>\n      <a href=\"#developers\">Developers</a>\n      <a href=\"#architecture\">Architecture</a>\n      <a href=\"#benchmarks\">Benchmarks</a>\n      <a href=\"#community\">Community</a>\n    </nav>\n    <div class=\"nav-actions\">\n      <a class=\"stars\" href=\"#\" aria-label=\"Star on GitHub\">\n        <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77 5.82 21l1.18-6.88-5-4.87 6.91-1.01L12 2z\"/></svg>\n        Star \u00b7 18.4k\n      </a>\n      <a class=\"btn btn-primary btn-sm\" href=\"#start\">Get started</a>\n    </div>\n  </div>\n</header>\n\n<!-- Hero -->\n<section class=\"hero\" style=\"padding-bottom: 80px;\">\n  <div class=\"container hero-grid\">\n    <div>\n      <div class=\"pill\"><b>NEW</b> Native Iceberg writes and exactly-once Kafka ingest are now GA</div>\n      <h1>The open-source database <span class=\"gradient-text\">built for data engineers.</span></h1>\n      <p class=\"sub\">Tessera is a columnar, embeddable database that treats pipelines as first-class citizens. Ingest streams, evolve schemas safely, roll back bad loads, and query everything with SQL or Python. Apache 2.0, forever.</p>\n\n      <div class=\"hero-ctas\">\n        <a href=\"#start\" class=\"btn btn-primary\">\n          Install in 60 seconds\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n        </a>\n        <a href=\"#\" class=\"btn btn-ghost\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M12 .5a11.5 11.5 0 00-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 015.78 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.18 1.83 1.18 3.09 0 4.42-2.7 5.4-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0012 .5z\"/></svg>\n          View on GitHub\n        </a>\n      </div>\n\n      <div class=\"install\" role=\"group\" aria-label=\"Install command\">\n        <span><span class=\"prompt\">$</span>pip install tessera-db</span>\n        <button class=\"copy-btn\" data-copy=\"pip install tessera-db\" type=\"button\">Copy</button>\n      </div>\n\n      <div class=\"hero-meta\">\n        <span>Apache 2.0 license</span>\n        <span>No cluster required</span>\n        <span>Parquet &amp; Iceberg compatible</span>\n      </div>\n    </div>\n\n    <!-- Window mock -->\n    <div class=\"window\" aria-label=\"Example query in Tessera\">\n      <div class=\"window-bar\">\n        <span class=\"dot\"></span><span class=\"dot\"></span><span class=\"dot\"></span>\n        <span class=\"window-title\">pipeline.sql : tessera shell</span>\n      </div>\n      <div class=\"window-body\">\n        <div><span class=\"tok-c\">-- Incremental load with schema drift handling</span></div>\n        <div><span class=\"tok-k\">MERGE INTO</span> <span class=\"tok-p\">warehouse.orders</span> <span class=\"tok-k\">AS</span> t</div>\n        <div><span class=\"tok-k\">USING</span> <span class=\"tok-f\">stream</span>(<span class=\"tok-p\">kafka.order_events</span>) <span class=\"tok-k\">AS</span> s</div>\n        <div>&nbsp;&nbsp;<span class=\"tok-k\">ON</span> t.order_id = s.order_id</div>\n        <div><span class=\"tok-k\">WHEN MATCHED THEN</span> <span class=\"tok-f\">UPDATE</span> <span class=\"tok-k\">SET</span> <span class=\"tok-p\">*</span></div>\n        <div><span class=\"tok-k\">WHEN NOT MATCHED THEN</span> <span class=\"tok-f\">INSERT</span> <span class=\"tok-p\">*</span>;</div>\n        <div style=\"margin-top:10px;\"><span class=\"tok-c\">-- Compare against yesterday's snapshot</span></div>\n        <div><span class=\"tok-k\">SELECT</span> region, <span class=\"tok-f\">SUM</span>(amount) <span class=\"tok-k\">AS</span> revenue</div>\n        <div><span class=\"tok-k\">FROM</span> warehouse.orders <span class=\"tok-k\">AS OF</span> <span class=\"tok-s\">'2024-06-01 00:00'</span></div>\n        <div><span class=\"tok-k\">GROUP BY</span> region <span class=\"tok-k\">ORDER BY</span> revenue <span class=\"tok-k\">DESC</span>;</div>\n\n        <div class=\"result\">\n          <table>\n            <thead><tr><th>region</th><th class=\"num\">revenue</th></tr></thead>\n            <tbody>\n              <tr><td>eu-west</td><td class=\"num\">1,284,930</td></tr>\n              <tr><td>us-east</td><td class=\"num\">1,102,418</td></tr>\n              <tr><td>ap-south</td><td class=\"num\">402,077</td></tr>\n            </tbody>\n          </table>\n          <div class=\"result-meta\">3 rows \u00b7 41 ms \u00b7 scanned 2.3 GB of 18.7 GB via zone maps</div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- Trust strip -->\n<div class=\"trust\">\n  <div class=\"container\">\n    <div class=\"trust-label\">Plays nicely with the tools you already run</div>\n    <div class=\"trust-row\">\n      <span>dbt</span><span>Airflow</span><span>Dagster</span><span>Prefect</span><span>Kafka</span><span>Spark</span><span>DuckDB</span><span>Iceberg</span><span>Debezium</span>\n    </div>\n  </div>\n</div>\n\n<!-- Features -->\n<section id=\"features\">\n  <div class=\"container\">\n    <div class=\"section-head\">\n      <span class=\"eyebrow\">Why Tessera</span>\n      <h2>Everything a pipeline needs. Nothing it doesn't.</h2>\n      <p class=\"lead\">Tessera collapses the stack between ingestion and analytics so you spend less time babysitting infrastructure and more time shipping data products.</p>\n    </div>\n\n    <div class=\"features-grid\">\n      <article class=\"feature\">\n        <div class=\"icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2dd4bf\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><ellipse cx=\"12\" cy=\"5\" rx=\"8\" ry=\"3\"/><path d=\"M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5\"/><path d=\"M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3\"/></svg>\n        </div>\n        <h3>Columnar by default</h3>\n        <p>Vectorized execution over Parquet-backed storage with zone maps and adaptive compression. Scans only the bytes a query needs.</p>\n      </article>\n\n      <article class=\"feature\" style=\"--x:30%\">\n        <div class=\"icon purple\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#818cf8\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M3 12h4l3-8 4 16 3-8h4\"/></svg>\n        </div>\n        <h3>Streaming ingest, exactly once</h3>\n        <p>Native Kafka, Kinesis, and CDC connectors with transactional commits. Replays and retries never create duplicate rows.</p>\n      </article>\n\n      <article class=\"feature\" style=\"--x:70%\">\n        <div class=\"icon amber\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#f59e0b\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M3 3v6h6\"/><path d=\"M3.5 15a9 9 0 102.1-9.4L3 9\"/></svg>\n        </div>\n        <h3>Time travel &amp; rollback</h3>\n        <p>Every commit is a snapshot. Query any past state with <code>AS OF</code> or revert a bad backfill in one statement.</p>\n      </article>\n\n      <article class=\"feature\">\n        <div class=\"icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2dd4bf\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M4 6h16M4 12h10M4 18h6\"/><circle cx=\"19\" cy=\"12\" r=\"2\"/><circle cx=\"16\" cy=\"18\" r=\"2\"/></svg>\n        </div>\n        <h3>Schema evolution without fear</h3>\n        <p>Add, rename, or widen columns with compatibility checks. Breaking changes are blocked before they reach downstream consumers.</p>\n      </article>\n\n      <article class=\"feature\" style=\"--x:50%\">\n        <div class=\"icon purple\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#818cf8\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><polyline points=\"8 7 3 12 8 17\"/><polyline points=\"16 7 21 12 16 17\"/><line x1=\"14\" y1=\"4\" x2=\"10\" y2=\"20\"/></svg>\n        </div>\n        <h3>SQL and Python, one engine</h3>\n        <p>Use plain SQL, a DataFrame API, or drop into Python UDFs. The same plan runs locally, in CI, and in production.</p>\n      </article>\n\n      <article class=\"feature\">\n        <div class=\"icon amber\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#f59e0b\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"6\" rx=\"1.5\"/><rect x=\"3\" y=\"14\" width=\"18\" height=\"6\" rx=\"1.5\"/><circle cx=\"7\" cy=\"7\" r=\".5\" fill=\"#f59e0b\"/><circle cx=\"7\" cy=\"17\" r=\".5\" fill=\"#f59e0b\"/></svg>\n        </div>\n        <h3>Embed or deploy anywhere</h3>\n        <p>Run in-process like SQLite, as a single binary on a VM, or as a distributed cluster on Kubernetes. Your data stays in your buckets.</p>\n      </article>\n    </div>\n  </div>\n</section>\n\n<!-- Developer experience -->\n<section id=\"developers\" style=\"background: var(--bg-elev); border-block: 1px solid var(--border);\">\n  <div class=\"container split\">\n    <div>\n      <span class=\"eyebrow\">Developer experience</span>\n      <h2>Written by engineers who have been paged at 3&nbsp;a.m.</h2>\n      <p class=\"lead\">Tessera ships with the ergonomics you want from a modern tool: fast feedback, clear errors, and sane defaults.</p>\n      <ul>\n        <li><div><strong>Typed Python client</strong>Full type hints, async support, and first-class pandas, Polars, and Arrow interop.</div></li>\n        <li><div><strong>Local-first workflow</strong>Test pipelines on a laptop against the same engine that runs in production.</div></li>\n        <li><div><strong>Observability built in</strong>OpenTelemetry traces and per-query cost metrics exposed out of the box.</div></li>\n      </ul>\n    </div>\n\n    <div class=\"window\">\n      <div class=\"tabs\" role=\"tablist\" aria-label=\"Code examples\">\n        <button class=\"tab\" role=\"tab\" aria-selected=\"true\" data-tab=\"py\">python</button>\n        <button class=\"tab\" role=\"tab\" aria-selected=\"false\" data-tab=\"cli\">cli</button>\n        <button class=\"tab\" role=\"tab\" aria-selected=\"false\" data-tab=\"yaml\">pipeline.yaml</button>\n      </div>\n\n      <div class=\"code-panel active\" data-panel=\"py\" role=\"tabpanel\">\n<pre><span class=\"tok-k\">import</span> tessera <span class=\"tok-k\">as</span> ts\n<span class=\"tok-k\">import</span> polars <span class=\"tok-k\">as</span> pl\n\ndb = ts.connect(<span class=\"tok-s\">\"s3://acme-lake/warehouse\"</span>)\n\n<span class=\"tok-c\"># Stream from Kafka into a table with an explicit contract</span>\n<span class=\"tok-p\">orders</span> = db.table(<span class=\"tok-s\">\"orders\"</span>, schema={\n    <span class=\"tok-s\">\"order_id\"</span>: ts.Int64(primary_key=<span class=\"tok-n\">True</span>),\n    <span class=\"tok-s\">\"region\"</span>: ts.String(),\n    <span class=\"tok-s\">\"amount\"</span>: ts.Decimal(12, 2),\n})\n\nstream = db.stream(<span class=\"tok-s\">\"kafka://orders.v2\"</span>, group=<span class=\"tok-s\">\"etl-prod\"</span>)\n<span class=\"tok-k\">for</span> batch <span class=\"tok-k\">in</span> stream.batches(max_rows=<span class=\"tok-n\">50_000</span>):\n    orders.merge(batch, on=<span class=\"tok-s\">\"order_id\"</span>)   <span class=\"tok-c\"># exactly-once commit</span>\n\n<span class=\"tok-c\"># Pull results straight into a DataFrame</span>\ndf = db.sql(<span class=\"tok-s\">\"SELECT region, sum(amount) FROM orders GROUP BY 1\"</span>).pl()\n<span class=\"tok-f\">print</span>(df)\n</pre>\n      </div>\n\n      <div class=\"code-panel\" data-panel=\"cli\" role=\"tabpanel\">\n<pre><span class=\"tok-c\"># Create a database and import a Parquet folder</span>\n<span class=\"tok-p\">$</span> tessera init ./analytics\n<span class=\"tok-p\">$</span> tessera import ./exports/*.parquet --into raw.events\n\n<span class=\"tok-c\"># Inspect schema history and roll back a bad load</span>\n<span class=\"tok-p\">$</span> tessera log raw.events\n<span class=\"tok-p\">$</span> tessera rollback raw.events --to snap_01HZX8Q3\n\n<span class=\"tok-c\"># Run the test suite that ships with your repo</span>\n<span class=\"tok-p\">$</span> tessera test --fail-fast\n  <span class=\"tok-n\">\u2713</span> not_null(order_id)            <span class=\"tok-c\">12ms</span>\n  <span class=\"tok-n\">\u2713</span> unique(order_id)              <span class=\"tok-c\">48ms</span>\n  <span class=\"tok-n\">\u2713</span> accepted_values(status)       <span class=\"tok-c\">9ms</span>\n  <span class=\"tok-n\">3 passed</span>, 0 failed\n</pre>\n      </div>\n\n      <div class=\"code-panel\" data-panel=\"yaml\" role=\"tabpanel\">\n<pre><span class=\"tok-k\">name</span>: <span class=\"tok-p\">daily_orders</span>\n<span class=\"tok-k\">source</span>:\n  <span class=\"tok-k\">kind</span>: <span class=\"tok-p\">kafka</span>\n  <span class=\"tok-k\">topic</span>: <span class=\"tok-p\">orders.v2</span>\n<span class=\"tok-k\">transform</span>: <span class=\"tok-s\">models/orders_clean.sql</span>\n<span class=\"tok-k\">target</span>:\n  <span class=\"tok-k\">table</span>: <span class=\"tok-p\">warehouse.orders</span>\n  <span class=\"tok-k\">mode</span>: <span class=\"tok-p\">merge</span>\n  <span class=\"tok-k\">key</span>: [<span class=\"tok-p\">order_id</span>]\n<span class=\"tok-k\">schedule</span>: <span class=\"tok-s\">\"*/15 * * * *\"</span>\n<span class=\"tok-k\">on_schema_change</span>: <span class=\"tok-p\">fail</span>\n<span class=\"tok-k\">tests</span>:\n  - <span class=\"tok-p\">not_null: order_id</span>\n  - <span class=\"tok-p\">freshness: { max_lag: 20m }</span>\n</pre>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- Architecture -->\n<section id=\"architecture\">\n  <div class=\"container\">\n    <div class=\"section-head\">\n      <span class=\"eyebrow\">Architecture</span>\n      <h2>One engine from source to dashboard.</h2>\n      <p class=\"lead\">Ingestion, storage, transformation, and serving share a single catalog and transaction log. No glue jobs, no drifting copies.</p>\n    </div>\n\n    <div class=\"arch\">\n      <svg viewBox=\"0 0 960 300\" role=\"img\" aria-label=\"Architecture diagram: sources flow into ingest, then storage, then query engine, then consumers\">\n        <defs>\n          <linearGradient id=\"archg\" x1=\"0\" x2=\"1\">\n            <stop offset=\"0\" stop-color=\"#2dd4bf\" stop-opacity=\".25\"/>\n            <stop offset=\"1\" stop-color=\"#818cf8\" stop-opacity=\".25\"/>\n          </linearGradient>\n          <marker id=\"arrow\" markerWidth=\"8\" markerHeight=\"8\" refX=\"7\" refY=\"4\" orient=\"auto\">\n            <path d=\"M0,0 L8,4 L0,8 z\" fill=\"#343c4d\"/>\n          </marker>\n        </defs>\n\n        <!-- Sources -->\n        <g>\n          <rect x=\"20\" y=\"40\" width=\"170\" height=\"54\" rx=\"10\" fill=\"#161a23\" stroke=\"#343c4d\"/>\n          <text x=\"105\" y=\"66\" text-anchor=\"middle\" class=\"label\">Kafka / Kinesis</text>\n          <text x=\"105\" y=\"82\" text-anchor=\"middle\" class=\"sublabel\">event streams</text>\n\n          <rect x=\"20\" y=\"120\" width=\"170\" height=\"54\" rx=\"10\" fill=\"#161a23\" stroke=\"#343c4d\"/>\n          <text x=\"105\" y=\"146\" text-anchor=\"middle\" class=\"label\">Postgres / MySQL</text>\n          <text x=\"105\" y=\"162\" text-anchor=\"middle\" class=\"sublabel\">CDC via Debezium</text>\n\n          <rect x=\"20\" y=\"200\" width=\"170\" height=\"54\" rx=\"10\" fill=\"#161a23\" stroke=\"#343c4d\"/>\n          <text x=\"105\" y=\"226\" text-anchor=\"middle\" class=\"label\">SaaS APIs &amp; Files</text>\n          <text x=\"105\" y=\"242\" text-anchor=\"middle\" class=\"sublabel\">Parquet, CSV, JSON</text>\n        </g>\n\n        <!-- Ingest -->\n        <rect x=\"250\" y=\"40\" width=\"170\" height=\"214\" rx=\"12\" fill=\"url(#archg)\" stroke=\"#2dd4bf\" stroke-opacity=\".5\"/>\n        <text x=\"335\" y=\"90\" text-anchor=\"middle\" class=\"label\">Ingest</text>\n        <text x=\"335\" y=\"112\" text-anchor=\"middle\" class=\"sublabel\">schema contracts</text>\n        <text x=\"335\" y=\"128\" text-anchor=\"middle\" class=\"sublabel\">exactly-once commits</text>\n        <text x=\"335\" y=\"144\" text-anchor=\"middle\" class=\"sublabel\">backpressure</text>\n\n        <!-- Storage -->\n        <rect x=\"480\" y=\"40\" width=\"170\" height=\"214\" rx=\"12\" fill=\"#161a23\" stroke=\"#818cf8\" stroke-opacity=\".6\"/>\n        <text x=\"565\" y=\"90\" text-anchor=\"middle\" class=\"label\">Storage</text>\n        <text x=\"565\" y=\"112\" text-anchor=\"middle\" class=\"sublabel\">Parquet on S3 / GCS</text>\n        <text x=\"565\" y=\"128\" text-anchor=\"middle\" class=\"sublabel\">transaction log</text>\n        <text x=\"565\" y=\"144\" text-anchor=\"middle\" class=\"sublabel\">snapshots \u00b7 time travel</text>\n\n        <!-- Query -->\n        <rect x=\"710\" y=\"40\" width=\"230\" height=\"214\" rx=\"12\" fill=\"#161a23\" stroke=\"#343c4d\"/>\n        <text x=\"825\" y=\"90\" text-anchor=\"middle\" class=\"label\">Query engine</text>\n        <text x=\"825\" y=\"112\" text-anchor=\"middle\" class=\"sublabel\">vectorized SQL</text>\n        <text x=\"825\" y=\"128\" text-anchor=\"middle\" class=\"sublabel\">zone-map pruning</text>\n        <text x=\"825\" y=\"144\" text-anchor=\"middle\" class=\"sublabel\">materialized views</text>\n\n        <!-- Flows -->\n        <path class=\"flow\" d=\"M190 67 C220 67, 220 120, 250 120\" marker-end=\"url(#arrow)\"/>\n        <path class=\"flow\" d=\"M190 147 L250 147\" marker-end=\"url(#arrow)\"/>\n        <path class=\"flow\" d=\"M190 227 C220 227, 220 175, 250 175\" marker-end=\"url(#arrow)\"/>\n        <path class=\"flow\" d=\"M420 147 L480 147\" marker-end=\"url(#arrow)\"/>\n        <path class=\"flow\" d=\"M650 147 L710 147\" marker-end=\"url(#arrow)\"/>\n\n        <!-- Consumers -->\n        <text x=\"825\" y=\"282\" text-anchor=\"middle\" class=\"sublabel\" fill=\"#6b7385\">\u2192 dbt \u00b7 BI tools \u00b7 notebooks \u00b7 ML feature stores \u00b7 reverse ETL</text>\n      </svg>\n    </div>\n  </div>\n</section>\n\n<!-- Benchmarks -->\n<section id=\"benchmarks\" style=\"background: var(--bg-elev); border-block: 1px solid var(--border);\">\n  <div class=\"container\">\n    <div class=\"section-head\">\n      <span class=\"eyebrow\">Performance</span>\n      <h2>Fast where it matters. Reproducible by design.</h2>\n      <p class=\"lead\">Every number below comes from the public benchmark harness in the repository. Run it yourself on your own hardware.</p>\n    </div>\n\n    <div class=\"bench\">\n      <div class=\"bench-card\">\n        <h3>TPC-H SF100 query time</h3>\n        <div class=\"desc\">Geometric mean across 22 queries \u00b7 lower is better</div>\n\n        <div class=\"bar-row\" data-width=\"18\">\n          <div class=\"bar-head\"><span>Tessera</span><b>18.2 s</b></div>\n          <div class=\"bar-track\"><div class=\"bar-fill\"></div></div>\n        </div>\n        <div class=\"bar-row\" data-width=\"31\">\n          <div class=\"bar-head\"><span>DuckDB</span><b>31.0 s</b></div>\n          <div class=\"bar-track\"><div class=\"bar-fill muted\"></div></div>\n        </div>\n        <div class=\"bar-row\" data-width=\"47\">\n          <div class=\"bar-head\"><span>Trino</span><b>46.8 s</b></div>\n          <div class=\"bar-track\"><div class=\"bar-fill muted\"></div></div>\n        </div>\n        <div class=\"bar-row\" data-width=\"100\">\n          <div class=\"bar-head\"><span>Legacy Hive</span><b>99.6 s</b></div>\n          <div class=\"bar-track\"><div class=\"bar-fill muted\"></div></div>\n        </div>\n      </div>\n\n      <div class=\"bench-card\">\n        <h3>Streaming ingest throughput</h3>\n        <div class=\"desc\">Rows per second per node, exactly-once mode \u00b7 higher is better</div>\n\n        <div class=\"bar-row\" data-width=\"100\">\n          <div class=\"bar-head\"><span>Tessera</span><b>1.42 M/s</b></div>\n          <div class=\"bar-track\"><div class=\"bar-fill\"></div></div>\n        </div>\n        <div class=\"bar-row\" data-width=\"58\">\n          <div class=\"bar-head\"><span>Kafka Connect + Iceberg sink</span><b>820 k/s</b></div>\n          <div class=\"bar-track\"><div class=\"bar-fill muted\"></div></div>\n        </div>\n        <div class=\"bar-row\" data-width=\"34\">\n          <div class=\"bar-head\"><span>Spark Structured Streaming</span><b>485 k/s</b></div>\n          <div class=\"bar-track\"><div class=\"bar-fill muted\"></div></div>\n        </div>\n      </div>\n    </div>\n\n    <p class=\"bench-note\">Hardware: 16 vCPU, 64 GiB RAM, NVMe local cache, us-east-1 S3. Full configs and raw results are in <a href=\"#\" style=\"color: var(--accent);\">/benchmarks</a>.</p>\n  </div>\n</section>\n\n<!-- Testimonials -->\n<section id=\"community\">\n  <div class=\"container\">\n    <div class=\"section-head\">\n      <span class=\"eyebrow\">Community</span>\n      <h2>Trusted by teams who ship data every day.</h2>\n    </div>\n\n    <div class=\"quotes\">\n      <figure class=\"quote\">\n        <p>We replaced three services and a nightly Airflow DAG with one Tessera pipeline. Rollbacks went from a half-day incident to a single command.</p>\n        <figcaption class=\"who\">\n          <span class=\"avatar\">MR</span>\n          <div><strong>Maya Rodriguez</strong><span>Staff Data Engineer, Lumen Health</span></div>\n        </figcaption>\n      </figure>\n      <figure class=\"quote\">\n        <p>The schema compatibility checks alone paid for the migration. Our upstream teams can't silently break dashboards anymore.</p>\n        <figcaption class=\"who\">\n          <span class=\"avatar\">JK</span>\n          <div><strong>Jonas Keller</strong><span>Head of Data Platform, Brightline Logistics</span></div>\n        </figcaption>\n      </figure>\n      <figure class=\"quote\">\n        <p>I run the whole stack on a laptop for development and the same binary in prod. Local-to-cloud parity finally feels real.</p>\n        <figcaption class=\"who\">\n          <span class=\"avatar\">AS</span>\n          <div><strong>Amara Osei</strong><span>Analytics Engineer, independent</span></div>\n        </figcaption>\n      </figure>\n    </div>\n\n    <div class=\"community\" style=\"margin-top: 80px;\">\n      <div class=\"stat\"><div class=\"num gradient-text\">18.4k</div><div class=\"lbl\">GitHub stars</div></div>\n      <div class=\"stat\"><div class=\"num gradient-text\">340+</div><div class=\"lbl\">Contributors</div></div>\n      <div class=\"stat\"><div class=\"num gradient-text\">2.1M</div><div class=\"lbl\">Monthly installs</div></div>\n      <div class=\"stat\"><div class=\"num gradient-text\">60+</div><div class=\"lbl\">Connectors</div></div>\n    </div>\n  </div>\n</section>\n\n<!-- Get started -->\n<section id=\"start\" style=\"background: var(--bg-elev); border-block: 1px solid var(--border);\">\n  <div class=\"container\">\n    <div class=\"section-head\">\n      <span class=\"eyebrow\">Get started</span>\n      <h2>From zero to a queryable table in three steps.</h2>\n    </div>\n\n    <div class=\"steps\">\n      <div class=\"step\">\n        <span class=\"step-num\">01 \u00b7 INSTALL</span>\n        <h3>Install the engine</h3>\n        <p>Grab the single binary or the Python package. No JVM, no cluster, no Docker required.</p>\n        <pre>pip install tessera-db\n# or\ncurl -sSL get.tessera.dev | sh</pre>\n      </div>\n      <div class=\"step\">\n        <span class=\"step-num\">02 \u00b7 CONNECT</span>\n        <h3>Point it at your data</h3>\n        <p>Create a warehouse on local disk or object storage, then import what you already have.</p>\n        <pre>tessera init ./lake\ntessera import ./exports --into raw.events</pre>\n      </div>\n      <div class=\"step\">\n        <span class=\"step-num\">03 \u00b7 QUERY</span>\n        <h3>Ship your first model</h3>\n        <p>Write SQL, add tests, and schedule it. Your pipeline is versioned in git from the start.</p>\n        <pre>tessera run models/\ntessera test\ntessera serve --port 8080</pre>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- Final CTA -->\n<section style=\"padding-top: 0;\">\n  <div class=\"container\">\n    <div class=\"cta\">\n      <h2>Own your data stack. <span class=\"gradient-text\">Keep your data.</span></h2>\n      <p>Open source under Apache 2.0. No seat licenses, no usage meter, no lock-in.</p>\n      <div class=\"hero-ctas\">\n        <a href=\"#start\" class=\"btn btn-primary\">Get started free</a>\n        <a href=\"#\" class=\"btn btn-ghost\">Read the docs</a>\n        <a href=\"#\" class=\"btn btn-ghost\">Join Discord</a>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- Footer -->\n<footer>\n  <div class=\"container\">\n    <div class=\"foot-grid\">\n      <div>\n        <a href=\"#\" class=\"brand\">\n          <svg width=\"24\" height=\"24\" viewBox=\"0 0 28 28\" aria-hidden=\"true\">\n            <rect x=\"2\" y=\"2\" width=\"11\" height=\"11\" rx=\"2.5\" fill=\"#2dd4bf\"/>\n            <rect x=\"15\" y=\"2\" width=\"11\" height=\"11\" rx=\"2.5\" fill=\"#2dd4bf\" opacity=\".55\"/>\n            <rect x=\"2\" y=\"15\" width=\"11\" height=\"11\" rx=\"2.5\" fill=\"#2dd4bf\" opacity=\".55\"/>\n            <rect x=\"15\" y=\"15\" width=\"11\" height=\"11\" rx=\"2.5\" fill=\"#2dd4bf\"/>\n          </svg>\n          Tessera\n        </a>\n        <p>An open-source database for the data engineering lifecycle. Maintained by a community of engineers.</p>\n      </div>\n      <div>\n        <h4>Product</h4>\n        <ul>\n          <li><a href=\"#features\">Features</a></li>\n          <li><a href=\"#architecture\">Architecture</a></li>\n          <li><a href=\"#benchmarks\">Benchmarks</a></li>\n          <li><a href=\"#\">Roadmap</a></li>\n        </ul>\n      </div>\n      <div>\n        <h4>Developers</h4>\n        <ul>\n          <li><a href=\"#\">Documentation</a></li>\n          <li><a href=\"#\">Python API</a></li>\n          <li><a href=\"#\">Connectors</a></li>\n          <li><a href=\"#\">Changelog</a></li>\n        </ul>\n      </div>\n      <div>\n        <h4>Community</h4>\n        <ul>\n          <li><a href=\"#\">GitHub</a></li>\n          <li><a href=\"#\">Discord</a></li>\n          <li><a href=\"#\">Contributing</a></li>\n          <li><a href=\"#\">Code of conduct</a></li>\n        </ul>\n      </div>\n    </div>\n    <div class=\"foot-bottom\">\n      <span>\u00a9 2025 Tessera contributors. Released under the Apache License 2.0.</span>\n      <span class=\"license\">Governed by an open foundation \u00b7 Security \u00b7 Privacy</span>\n    </div>\n  </div>\n</footer>\n\n<script>\n  // Tabs for code examples\n  (function () {\n    const tabs = document.querySelectorAll('.tab');\n    const panels = document.querySelectorAll('.code-panel');\n    tabs.forEach(tab => {\n      tab.addEventListener('click', () => {\n        const target = tab.dataset.tab;\n        tabs.forEach(t => t.setAttribute('aria-selected', t === tab ? 'true' : 'false'));\n        panels.forEach(p => p.classList.toggle('active', p.dataset.panel === target));\n      });\n    });\n  })();\n\n  // Copy-to-clipboard buttons\n  document.querySelectorAll('.copy-btn').forEach(btn => {\n    btn.addEventListener('click', async () => {\n      const text = btn.dataset.copy;\n      try {\n        await navigator.clipboard.writeText(text);\n      } catch (e) {\n        const ta = document.createElement('textarea');\n        ta.value = text;\n        document.body.appendChild(ta);\n        ta.select();\n        document.execCommand('copy');\n        ta.remove();\n      }\n      const original = btn.textContent;\n      btn.textContent = 'Copied';\n      setTimeout(() => (btn.textContent = original), 1600);\n    });\n  });\n\n  // Animate benchmark bars when they scroll into view\n  (function () {\n    const bars = document.querySelectorAll('.bar-row');\n    const io = new IntersectionObserver(entries => {\n      entries.forEach(entry => {\n        if (entry.isIntersecting) {\n          const row = entry.target;\n          const fill = row.querySelector('.bar-fill');\n          fill.style.width = row.dataset.width + '%';\n          io.unobserve(row);\n        }\n      });\n    }, { threshold: 0.3 });\n    bars.forEach(b => io.observe(b));\n  })();\n\n  // Subtle spotlight effect on feature cards\n  document.querySelectorAll('.feature').forEach(card => {\n    card.addEventListener('mousemove', e => {\n      const r = card.getBoundingClientRect();\n      card.style.setProperty('--x', ((e.clientX - r.left) / r.width * 100) + '%');\n    });\n  });\n</script>\n</body>\n</html>\n"}