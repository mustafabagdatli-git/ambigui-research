{"brief": "B3", "model": "anthropic/claude-haiku-5.5", "i": 2, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Tessera \u00b7 The open-source database for data engineers</title>\n<meta name=\"description\" content=\"Tessera is an open-source, columnar database built for data engineers. Streaming ingest, schema evolution, time travel, and SQL + Python in one engine.\">\n<style>\n  :root {\n    --bg: #0b0d12;\n    --bg-elev: #12151c;\n    --bg-card: #161a23;\n    --border: #232836;\n    --border-strong: #2e3446;\n    --text: #e6e9f0;\n    --text-dim: #9aa3b5;\n    --text-faint: #6b7385;\n    --accent: #5eead4;\n    --accent-2: #818cf8;\n    --accent-warm: #fbbf24;\n    --accent-ink: #052e28;\n    --code-bg: #0a0c11;\n    --radius: 14px;\n    --radius-sm: 8px;\n    --max: 1160px;\n    --mono: ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace;\n    --sans: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n  }\n\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  html { scroll-behavior: smooth; }\n  body {\n    font-family: var(--sans);\n    background: var(--bg);\n    color: var(--text);\n    line-height: 1.6;\n    -webkit-font-smoothing: antialiased;\n    overflow-x: hidden;\n  }\n  a { color: inherit; text-decoration: none; }\n  img, svg { display: block; max-width: 100%; }\n  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 4px; }\n\n  .container { width: min(var(--max), 92%); margin: 0 auto; }\n  .eyebrow {\n    font-family: var(--mono);\n    font-size: 0.78rem;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    color: var(--accent);\n    margin-bottom: 1rem;\n  }\n  h1, h2, h3 { line-height: 1.15; letter-spacing: -0.02em; }\n  h1 { font-size: clamp(2.6rem, 6vw, 4.4rem); font-weight: 750; }\n  h2 { font-size: clamp(1.9rem, 3.6vw, 2.8rem); font-weight: 700; }\n  h3 { font-size: 1.15rem; font-weight: 650; letter-spacing: -0.01em; }\n  .lead { font-size: clamp(1.05rem, 1.6vw, 1.22rem); color: var(--text-dim); max-width: 60ch; }\n  .section { padding: clamp(4.5rem, 9vw, 7.5rem) 0; position: relative; }\n  .section-head { max-width: 680px; margin-bottom: 3.5rem; }\n  .section-head p { color: var(--text-dim); margin-top: 1rem; font-size: 1.05rem; }\n  .divider { border: 0; border-top: 1px solid var(--border); }\n\n  /* Buttons */\n  .btn {\n    display: inline-flex; align-items: center; gap: 0.5rem;\n    padding: 0.85rem 1.35rem;\n    border-radius: 999px;\n    font-weight: 600; font-size: 0.98rem;\n    border: 1px solid transparent;\n    cursor: pointer;\n    transition: transform .15s ease, background .15s ease, border-color .15s ease, color .15s ease;\n    white-space: nowrap;\n  }\n  .btn:hover { transform: translateY(-1px); }\n  .btn-primary { background: var(--accent); color: var(--accent-ink); }\n  .btn-primary:hover { background: #7af3dd; }\n  .btn-ghost { border-color: var(--border-strong); color: var(--text); background: rgba(255,255,255,0.02); }\n  .btn-ghost:hover { border-color: var(--text-dim); background: rgba(255,255,255,0.05); }\n  .btn-sm { padding: 0.55rem 1rem; font-size: 0.88rem; }\n\n  /* Nav */\n  header.nav {\n    position: sticky; top: 0; z-index: 50;\n    backdrop-filter: saturate(160%) blur(14px);\n    -webkit-backdrop-filter: saturate(160%) blur(14px);\n    background: rgba(11,13,18,0.72);\n    border-bottom: 1px solid var(--border);\n  }\n  .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 66px; gap: 1rem; }\n  .brand { display: flex; align-items: center; gap: 0.6rem; font-weight: 700; font-size: 1.1rem; letter-spacing: -0.01em; }\n  .nav-links { display: flex; gap: 1.8rem; font-size: 0.94rem; color: var(--text-dim); }\n  .nav-links a:hover { color: var(--text); }\n  .nav-actions { display: flex; gap: 0.6rem; align-items: center; }\n  .badge-stars {\n    font-family: var(--mono); font-size: 0.8rem; color: var(--text-dim);\n    border: 1px solid var(--border-strong); border-radius: 999px; padding: 0.35rem 0.7rem;\n  }\n\n  /* Hero */\n  .hero { padding: clamp(4rem, 9vw, 6.5rem) 0 clamp(4rem, 8vw, 6rem); position: relative; overflow: hidden; }\n  .hero::before {\n    content: \"\"; position: absolute; inset: -20% -10% auto; height: 720px; z-index: -1;\n    background:\n      radial-gradient(closest-side at 22% 30%, rgba(94,234,212,0.18), transparent 70%),\n      radial-gradient(closest-side at 78% 20%, rgba(129,140,248,0.20), transparent 70%);\n    filter: blur(20px);\n  }\n  .hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 4rem; align-items: center; }\n  .hero h1 span { background: linear-gradient(120deg, var(--accent), var(--accent-2)); -webkit-background-clip: text; background-clip: text; color: transparent; }\n  .hero .lead { margin: 1.5rem 0 2.2rem; }\n  .cta-row { display: flex; flex-wrap: wrap; gap: 0.8rem; }\n\n  .install {\n    margin-top: 2rem;\n    display: flex; align-items: center; justify-content: space-between; gap: 1rem;\n    background: var(--code-bg); border: 1px solid var(--border-strong);\n    border-radius: var(--radius-sm); padding: 0.7rem 0.7rem 0.7rem 1rem;\n    font-family: var(--mono); font-size: 0.92rem; max-width: 520px;\n  }\n  .install code { color: var(--text-dim); overflow-x: auto; white-space: nowrap; }\n  .install code b { color: var(--accent); font-weight: 500; }\n  .copy-btn {\n    background: var(--bg-card); color: var(--text-dim); border: 1px solid var(--border-strong);\n    border-radius: 6px; padding: 0.35rem 0.7rem; font: inherit; font-size: 0.8rem; cursor: pointer;\n  }\n  .copy-btn:hover { color: var(--text); border-color: var(--text-dim); }\n  .hero-meta { margin-top: 1.4rem; font-size: 0.88rem; color: var(--text-faint); display: flex; gap: 1.2rem; flex-wrap: wrap; }\n  .hero-meta span::before { content: \"\u2713 \"; color: var(--accent); }\n\n  /* Terminal mock */\n  .terminal {\n    background: var(--bg-elev); border: 1px solid var(--border-strong); border-radius: var(--radius);\n    box-shadow: 0 30px 80px -20px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.02) inset;\n    overflow: hidden;\n  }\n  .term-bar { display: flex; align-items: center; gap: 0.45rem; padding: 0.8rem 1rem; border-bottom: 1px solid var(--border); background: var(--bg-card); }\n  .dot { width: 11px; height: 11px; border-radius: 50%; background: #2c3140; }\n  .dot:nth-child(1) { background: #f87171; } .dot:nth-child(2) { background: #fbbf24; } .dot:nth-child(3) { background: #4ade80; }\n  .term-title { margin-left: auto; margin-right: auto; font-family: var(--mono); font-size: 0.78rem; color: var(--text-faint); }\n  .term-body { padding: 1.3rem 1.4rem; font-family: var(--mono); font-size: 0.86rem; line-height: 1.75; color: var(--text-dim); overflow-x: auto; }\n  .k { color: var(--accent-2); } .s { color: #a7f3d0; } .n { color: var(--accent-warm); } .c { color: var(--text-faint); }\n  .result { margin-top: 1rem; border-top: 1px dashed var(--border-strong); padding-top: 1rem; }\n  .result table { width: 100%; border-collapse: collapse; font-size: 0.84rem; }\n  .result th, .result td { text-align: left; padding: 0.35rem 0.5rem; }\n  .result th { color: var(--text-faint); font-weight: 500; border-bottom: 1px solid var(--border); }\n  .result td { color: var(--text); }\n  .result .ok { color: #4ade80; }\n  .result .footer-line { color: var(--text-faint); margin-top: 0.6rem; font-size: 0.8rem; }\n\n  /* Logo strip */\n  .strip { border-block: 1px solid var(--border); padding: 1.8rem 0; background: var(--bg-elev); }\n  .strip-inner { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem 2.5rem; flex-wrap: wrap; }\n  .strip p { font-size: 0.88rem; color: var(--text-faint); white-space: nowrap; }\n  .chips { display: flex; flex-wrap: wrap; gap: 0.6rem 1.8rem; font-family: var(--mono); font-size: 0.92rem; color: var(--text-dim); }\n  .chips span { opacity: 0.75; transition: opacity .2s; }\n  .chips span:hover { opacity: 1; color: var(--text); }\n\n  /* Features */\n  .features { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; }\n  .card {\n    background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius);\n    padding: 1.8rem; transition: border-color .2s, transform .2s;\n  }\n  .card:hover { border-color: var(--border-strong); transform: translateY(-2px); }\n  .icon {\n    width: 42px; height: 42px; border-radius: 10px; display: grid; place-items: center; margin-bottom: 1.2rem;\n    background: rgba(94,234,212,0.08); border: 1px solid rgba(94,234,212,0.22); color: var(--accent);\n  }\n  .icon.violet { background: rgba(129,140,248,0.09); border-color: rgba(129,140,248,0.25); color: var(--accent-2); }\n  .icon.amber { background: rgba(251,191,36,0.08); border-color: rgba(251,191,36,0.25); color: var(--accent-warm); }\n  .card p { color: var(--text-dim); font-size: 0.96rem; margin-top: 0.55rem; }\n\n  /* Architecture */\n  .arch {\n    background: var(--bg-elev); border: 1px solid var(--border); border-radius: var(--radius);\n    padding: clamp(1.5rem, 3vw, 2.5rem);\n  }\n  .arch svg { width: 100%; height: auto; }\n  .arch-caption { margin-top: 1rem; font-size: 0.9rem; color: var(--text-faint); text-align: center; }\n\n  /* Tabs */\n  .split { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 3.5rem; align-items: start; }\n  .tab-list { display: flex; flex-direction: column; gap: 0.5rem; margin-top: 2rem; }\n  .tab-btn {\n    text-align: left; background: transparent; border: 1px solid transparent; border-radius: var(--radius-sm);\n    padding: 1rem 1.2rem; color: var(--text-dim); cursor: pointer; font: inherit; transition: all .2s;\n  }\n  .tab-btn strong { display: block; color: var(--text); font-size: 1rem; margin-bottom: 0.2rem; }\n  .tab-btn:hover { background: rgba(255,255,255,0.02); }\n  .tab-btn[aria-selected=\"true\"] { background: var(--bg-card); border-color: var(--border-strong); }\n  .tab-panel { display: none; }\n  .tab-panel.active { display: block; }\n  .code-block {\n    background: var(--code-bg); border: 1px solid var(--border-strong); border-radius: var(--radius);\n    font-family: var(--mono); font-size: 0.875rem; line-height: 1.75; color: var(--text-dim);\n    overflow: hidden;\n  }\n  .code-block .head { display: flex; justify-content: space-between; align-items: center; padding: 0.7rem 1rem; border-bottom: 1px solid var(--border); font-size: 0.8rem; color: var(--text-faint); background: var(--bg-elev); }\n  .code-block pre { padding: 1.2rem 1.4rem; overflow-x: auto; }\n\n  /* Stats */\n  .stats { display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; background: var(--bg-card); }\n  .stat { padding: 2.2rem 1.6rem; border-right: 1px solid var(--border); }\n  .stat:last-child { border-right: 0; }\n  .stat .num { font-size: clamp(2rem, 3.5vw, 2.8rem); font-weight: 750; letter-spacing: -0.03em; background: linear-gradient(120deg, var(--text), var(--accent)); -webkit-background-clip: text; background-clip: text; color: transparent; }\n  .stat .label { color: var(--text-dim); font-size: 0.92rem; margin-top: 0.4rem; }\n  .stat-note { margin-top: 1rem; font-size: 0.82rem; color: var(--text-faint); }\n\n  /* Steps */\n  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; counter-reset: step; }\n  .step { position: relative; padding: 2rem 1.8rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-card); }\n  .step::before {\n    counter-increment: step; content: \"0\" counter(step);\n    font-family: var(--mono); font-size: 0.85rem; color: var(--accent);\n    display: block; margin-bottom: 1rem;\n  }\n  .step p { color: var(--text-dim); font-size: 0.96rem; margin-top: 0.5rem; }\n\n  /* Principles */\n  .principles { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.2rem; }\n  .principle { display: flex; gap: 1.1rem; padding: 1.6rem; border-radius: var(--radius); border: 1px solid var(--border); }\n  .principle h3 { margin-bottom: 0.3rem; }\n  .principle p { color: var(--text-dim); font-size: 0.95rem; }\n  .principle .mark { font-family: var(--mono); color: var(--accent-warm); font-size: 0.9rem; padding-top: 0.2rem; }\n\n  /* CTA */\n  .final-cta {\n    position: relative; text-align: center; padding: clamp(4rem, 8vw, 6rem) 2rem; border-radius: 24px;\n    border: 1px solid var(--border-strong); overflow: hidden;\n    background:\n      radial-gradient(60% 80% at 50% 0%, rgba(94,234,212,0.16), transparent 70%),\n      radial-gradient(50% 70% at 50% 100%, rgba(129,140,248,0.16), transparent 70%),\n      var(--bg-elev);\n  }\n  .final-cta h2 { max-width: 18ch; margin: 0 auto; }\n  .final-cta p { color: var(--text-dim); margin: 1.2rem auto 2.2rem; max-width: 52ch; }\n  .final-cta .cta-row { justify-content: center; }\n\n  /* Footer */\n  footer { border-top: 1px solid var(--border); padding: 3.5rem 0 2.5rem; color: var(--text-faint); font-size: 0.9rem; }\n  .foot-grid { display: grid; grid-template-columns: 1.6fr repeat(3, 1fr); gap: 2.5rem; }\n  .foot-grid h4 { color: var(--text); font-size: 0.85rem; margin-bottom: 0.9rem; font-weight: 600; }\n  .foot-grid ul { list-style: none; display: grid; gap: 0.55rem; }\n  .foot-grid a:hover { color: var(--text); }\n  .foot-bottom { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; font-family: var(--mono); font-size: 0.8rem; }\n\n  /* Responsive */\n  @media (max-width: 1000px) {\n    .hero-grid, .split { grid-template-columns: 1fr; gap: 3rem; }\n    .features { grid-template-columns: repeat(2, 1fr); }\n    .stats { grid-template-columns: repeat(2, 1fr); }\n    .stat:nth-child(2) { border-right: 0; }\n    .stat:nth-child(-n+2) { border-bottom: 1px solid var(--border); }\n    .nav-links { display: none; }\n    .foot-grid { grid-template-columns: 1fr 1fr; }\n  }\n  @media (max-width: 680px) {\n    .features, .steps, .principles { grid-template-columns: 1fr; }\n    .strip p { white-space: normal; }\n    .badge-stars { display: none; }\n    .stats { grid-template-columns: 1fr; }\n    .stat { border-right: 0; border-bottom: 1px solid var(--border); }\n    .stat:last-child { border-bottom: 0; }\n    .install { font-size: 0.8rem; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    html { scroll-behavior: auto; }\n    *, *::before, *::after { transition: none !important; animation: none !important; }\n  }\n</style>\n</head>\n<body>\n\n<!-- NAV -->\n<header class=\"nav\">\n  <div class=\"container nav-inner\">\n    <a href=\"#top\" class=\"brand\" aria-label=\"Tessera home\">\n      <svg width=\"28\" height=\"28\" viewBox=\"0 0 28 28\" aria-hidden=\"true\">\n        <defs>\n          <linearGradient id=\"g1\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n            <stop offset=\"0\" stop-color=\"#5eead4\"/>\n            <stop offset=\"1\" stop-color=\"#818cf8\"/>\n          </linearGradient>\n        </defs>\n        <rect x=\"2\" y=\"2\" width=\"11\" height=\"11\" rx=\"3\" fill=\"url(#g1)\"/>\n        <rect x=\"15\" y=\"2\" width=\"11\" height=\"11\" rx=\"3\" fill=\"url(#g1)\" opacity=\"0.55\"/>\n        <rect x=\"2\" y=\"15\" width=\"11\" height=\"11\" rx=\"3\" fill=\"url(#g1)\" opacity=\"0.55\"/>\n        <rect x=\"15\" y=\"15\" width=\"11\" height=\"11\" rx=\"3\" fill=\"url(#g1)\"/>\n      </svg>\n      Tessera\n    </a>\n    <nav class=\"nav-links\" aria-label=\"Primary\">\n      <a href=\"#features\">Features</a>\n      <a href=\"#architecture\">Architecture</a>\n      <a href=\"#developers\">Developers</a>\n      <a href=\"#benchmarks\">Benchmarks</a>\n      <a href=\"#community\">Community</a>\n    </nav>\n    <div class=\"nav-actions\">\n      <span class=\"badge-stars\" aria-label=\"GitHub stars\">\u2605 12.4k</span>\n      <a href=\"#quickstart\" class=\"btn btn-primary btn-sm\">Get started</a>\n    </div>\n  </div>\n</header>\n\n<main id=\"top\">\n\n<!-- HERO -->\n<section class=\"hero\">\n  <div class=\"container hero-grid\">\n    <div>\n      <p class=\"eyebrow\">Open source \u00b7 Apache 2.0</p>\n      <h1>The database built for <span>data pipelines</span>, not dashboards.</h1>\n      <p class=\"lead\">Tessera is a columnar, open-source database for the people who move, transform, and trust data. Stream in, evolve schemas safely, query with SQL or Python, and time-travel when something breaks at 2 a.m.</p>\n      <div class=\"cta-row\">\n        <a href=\"#quickstart\" class=\"btn btn-primary\">Install Tessera</a>\n        <a href=\"#developers\" class=\"btn btn-ghost\">Read the docs</a>\n      </div>\n\n      <div class=\"install\" role=\"group\" aria-label=\"Install command\">\n        <code><b>$</b> pip install tessera-db</code>\n        <button class=\"copy-btn\" type=\"button\" data-copy=\"pip install tessera-db\">Copy</button>\n      </div>\n\n      <div class=\"hero-meta\">\n        <span>Runs locally or on object storage</span>\n        <span>No vendor lock-in</span>\n        <span>Self-host or managed</span>\n      </div>\n    </div>\n\n    <div class=\"terminal\" role=\"img\" aria-label=\"Example terminal session running a SQL query against a Tessera table\">\n      <div class=\"term-bar\">\n        <span class=\"dot\"></span><span class=\"dot\"></span><span class=\"dot\"></span>\n        <span class=\"term-title\">tessera shell \u2014 orders_stream</span>\n      </div>\n      <div class=\"term-body\">\n<span class=\"c\">-- Ingest from Kafka, deduplicate, and materialize in one statement</span>\n<span class=\"k\">CREATE</span> <span class=\"k\">MATERIALIZED VIEW</span> daily_revenue <span class=\"k\">AS</span>\n<span class=\"k\">SELECT</span> date_trunc(<span class=\"s\">'day'</span>, event_ts) <span class=\"k\">AS</span> day,\n       region,\n       <span class=\"k\">sum</span>(amount) <span class=\"k\">AS</span> revenue\n  <span class=\"k\">FROM</span> kafka.orders\n <span class=\"k\">QUALIFY</span> row_number() <span class=\"k\">OVER</span> (<span class=\"k\">PARTITION BY</span> order_id <span class=\"k\">ORDER BY</span> ingested_at <span class=\"k\">DESC</span>) = <span class=\"n\">1</span>\n <span class=\"k\">GROUP BY</span> <span class=\"n\">1</span>, <span class=\"n\">2</span>;\n\n<span class=\"c\">-- Time travel: what did we report yesterday?</span>\n<span class=\"k\">SELECT</span> * <span class=\"k\">FROM</span> daily_revenue <span class=\"k\">AS OF</span> <span class=\"s\">'2025-01-14 00:00'</span> <span class=\"k\">LIMIT</span> <span class=\"n\">3</span>;\n\n        <div class=\"result\">\n          <table>\n            <thead><tr><th>day</th><th>region</th><th>revenue</th></tr></thead>\n            <tbody>\n              <tr><td>2025-01-13</td><td>eu-west</td><td>184,210.55</td></tr>\n              <tr><td>2025-01-13</td><td>us-east</td><td>402,987.10</td></tr>\n              <tr><td>2025-01-13</td><td>ap-south</td><td>96,440.00</td></tr>\n            </tbody>\n          </table>\n          <p class=\"footer-line\"><span class=\"ok\">\u2713</span> 3 rows \u00b7 18 ms \u00b7 snapshot 0x9f3c\u2026</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- INTEGRATIONS STRIP -->\n<section class=\"strip\" aria-label=\"Integrations\">\n  <div class=\"container strip-inner\">\n    <p>Plugs into the stack you already run</p>\n    <div class=\"chips\">\n      <span>Airflow</span><span>Dagster</span><span>dbt</span><span>Spark</span><span>Kafka</span><span>Flink</span><span>Iceberg</span><span>Parquet</span><span>DuckDB</span>\n    </div>\n  </div>\n</section>\n\n<!-- FEATURES -->\n<section class=\"section\" id=\"features\">\n  <div class=\"container\">\n    <div class=\"section-head\">\n      <p class=\"eyebrow\">Features</p>\n      <h2>Everything a pipeline needs. Nothing it doesn't.</h2>\n      <p>Tessera collapses the ingest, storage, and serving layers into one engine so your team stops gluing five systems together.</p>\n    </div>\n\n    <div class=\"features\">\n      <article class=\"card\">\n        <div class=\"icon\" aria-hidden=\"true\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 12h10M10 6l6 6-6 6\"/><circle cx=\"20\" cy=\"12\" r=\"1.5\"/></svg>\n        </div>\n        <h3>Streaming ingest</h3>\n        <p>Consume Kafka, Kinesis, and Pub/Sub directly. Exactly-once semantics with checkpointed offsets, no extra connector service to operate.</p>\n      </article>\n\n      <article class=\"card\">\n        <div class=\"icon violet\" aria-hidden=\"true\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><ellipse cx=\"12\" cy=\"5\" rx=\"8\" ry=\"3\"/><path d=\"M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6\"/></svg>\n        </div>\n        <h3>Schema evolution, safely</h3>\n        <p>Add, rename, and widen columns without rewriting history. Breaking changes are caught at write time with a clear diff, not discovered in a downstream report.</p>\n      </article>\n\n      <article class=\"card\">\n        <div class=\"icon amber\" aria-hidden=\"true\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/></svg>\n        </div>\n        <h3>Time travel &amp; rollback</h3>\n        <p>Every commit is a snapshot. Query any past state with <code>AS OF</code>, diff two versions, or roll a table back in a single command.</p>\n      </article>\n\n      <article class=\"card\">\n        <div class=\"icon violet\" aria-hidden=\"true\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16\"/></svg>\n        </div>\n        <h3>SQL and Python, one engine</h3>\n        <p>Write standard SQL, or drop into a DataFrame API that compiles to the same plan. Notebooks, dbt models, and scheduled jobs all share one catalog.</p>\n      </article>\n\n      <article class=\"card\">\n        <div class=\"icon\" aria-hidden=\"true\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 7l9-4 9 4-9 4-9-4zM3 12l9 4 9-4M3 17l9 4 9-4\"/></svg>\n        </div>\n        <h3>Storage you control</h3>\n        <p>Keep data on local disk, S3, GCS, or Azure Blob. Tessera separates compute from storage, so scaling is a config change, not a migration.</p>\n      </article>\n\n      <article class=\"card\">\n        <div class=\"icon amber\" aria-hidden=\"true\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 18h4l3-8 4 12 3-6h4\"/></svg>\n        </div>\n        <h3>Observability built in</h3>\n        <p>Freshness, row-count drift, and null-rate metrics are emitted automatically as OpenTelemetry traces and metrics. Alert on bad data before stakeholders do.</p>\n      </article>\n    </div>\n  </div>\n</section>\n\n<hr class=\"divider\">\n\n<!-- ARCHITECTURE -->\n<section class=\"section\" id=\"architecture\">\n  <div class=\"container\">\n    <div class=\"section-head\">\n      <p class=\"eyebrow\">Architecture</p>\n      <h2>One engine between your sources and your storage.</h2>\n      <p>Tessera sits where your ETL tools used to be. Sources write in, the core manages metadata and compaction, and open formats land in your own buckets.</p>\n    </div>\n\n    <div class=\"arch\">\n      <svg viewBox=\"0 0 960 340\" role=\"img\" aria-labelledby=\"arch-title arch-desc\">\n        <title id=\"arch-title\">Tessera architecture</title>\n        <desc id=\"arch-desc\">Sources such as Kafka, Postgres and APIs feed into the Tessera core, which connects to SQL and Python clients and writes Parquet files to object storage.</desc>\n        <defs>\n          <linearGradient id=\"core\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n            <stop offset=\"0\" stop-color=\"#5eead4\" stop-opacity=\"0.16\"/>\n            <stop offset=\"1\" stop-color=\"#818cf8\" stop-opacity=\"0.16\"/>\n          </linearGradient>\n          <marker id=\"arrow\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\">\n            <path d=\"M0 0 L10 5 L0 10 z\" fill=\"#6b7385\"/>\n          </marker>\n          <marker id=\"arrowA\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\">\n            <path d=\"M0 0 L10 5 L0 10 z\" fill=\"#5eead4\"/>\n          </marker>\n        </defs>\n\n        <!-- Sources -->\n        <g font-family=\"ui-monospace, Menlo, Consolas, monospace\" font-size=\"13\">\n          <rect x=\"30\" y=\"40\" width=\"190\" height=\"56\" rx=\"10\" fill=\"#161a23\" stroke=\"#2e3446\"/>\n          <text x=\"125\" y=\"74\" text-anchor=\"middle\" fill=\"#e6e9f0\">Kafka topics</text>\n          <rect x=\"30\" y=\"122\" width=\"190\" height=\"56\" rx=\"10\" fill=\"#161a23\" stroke=\"#2e3446\"/>\n          <text x=\"125\" y=\"156\" text-anchor=\"middle\" fill=\"#e6e9f0\">Postgres CDC</text>\n          <rect x=\"30\" y=\"204\" width=\"190\" height=\"56\" rx=\"10\" fill=\"#161a23\" stroke=\"#2e3446\"/>\n          <text x=\"125\" y=\"238\" text-anchor=\"middle\" fill=\"#e6e9f0\">REST / Webhooks</text>\n          <text x=\"125\" y=\"20\" text-anchor=\"middle\" fill=\"#6b7385\" font-size=\"11\" letter-spacing=\"2\">SOURCES</text>\n        </g>\n\n        <!-- Arrows sources -> core -->\n        <g stroke=\"#5eead4\" stroke-width=\"1.6\" fill=\"none\" marker-end=\"url(#arrowA)\" opacity=\"0.85\">\n          <path d=\"M222 68 C 300 68, 320 130, 380 150\"/>\n          <path d=\"M222 150 L 380 170\"/>\n          <path d=\"M222 232 C 300 232, 320 200, 380 190\"/>\n        </g>\n\n        <!-- Core -->\n        <rect x=\"385\" y=\"60\" width=\"200\" height=\"220\" rx=\"16\" fill=\"url(#core)\" stroke=\"#5eead4\" stroke-opacity=\"0.45\"/>\n        <text x=\"485\" y=\"94\" text-anchor=\"middle\" font-family=\"system-ui, sans-serif\" font-size=\"17\" font-weight=\"700\" fill=\"#e6e9f0\">Tessera core</text>\n        <g font-family=\"ui-monospace, Menlo, Consolas, monospace\" font-size=\"12\" fill=\"#9aa3b5\" text-anchor=\"middle\">\n          <text x=\"485\" y=\"130\">ingest workers</text>\n          <text x=\"485\" y=\"160\">query planner</text>\n          <text x=\"485\" y=\"190\">snapshot catalog</text>\n          <text x=\"485\" y=\"220\">compaction</text>\n          <text x=\"485\" y=\"250\">observability</text>\n        </g>\n\n        <!-- Core -> clients -->\n        <g stroke=\"#818cf8\" stroke-width=\"1.6\" fill=\"none\" marker-end=\"url(#arrow)\">\n          <path d=\"M590 130 L 680 70\"/>\n          <path d=\"M590 170 L 680 170\"/>\n        </g>\n\n        <!-- Clients -->\n        <g font-family=\"ui-monospace, Menlo, Consolas, monospace\" font-size=\"13\">\n          <rect x=\"690\" y=\"40\" width=\"240\" height=\"56\" rx=\"10\" fill=\"#161a23\" stroke=\"#2e3446\"/>\n          <text x=\"810\" y=\"74\" text-anchor=\"middle\" fill=\"#e6e9f0\">SQL clients \u00b7 BI</text>\n          <rect x=\"690\" y=\"142\" width=\"240\" height=\"56\" rx=\"10\" fill=\"#161a23\" stroke=\"#2e3446\"/>\n          <text x=\"810\" y=\"176\" text-anchor=\"middle\" fill=\"#e6e9f0\">Python \u00b7 dbt \u00b7 notebooks</text>\n          <text x=\"810\" y=\"20\" text-anchor=\"middle\" fill=\"#6b7385\" font-size=\"11\" letter-spacing=\"2\">CLIENTS</text>\n        </g>\n\n        <!-- Storage -->\n        <g stroke=\"#6b7385\" stroke-width=\"1.6\" fill=\"none\" marker-end=\"url(#arrow)\">\n          <path d=\"M485 280 L 485 300\"/>\n        </g>\n        <rect x=\"335\" y=\"304\" width=\"300\" height=\"46\" rx=\"10\" fill=\"#161a23\" stroke=\"#fbbf24\" stroke-opacity=\"0.5\"/>\n        <text x=\"485\" y=\"333\" text-anchor=\"middle\" font-family=\"ui-monospace, Menlo, Consolas, monospace\" font-size=\"13\" fill=\"#fde68a\">Parquet on S3 / GCS / local disk</text>\n      </svg>\n      <p class=\"arch-caption\">Compute scales independently from storage. Every table is an open Parquet dataset you can read with any tool.</p>\n    </div>\n  </div>\n</section>\n\n<hr class=\"divider\">\n\n<!-- DEVELOPER EXPERIENCE -->\n<section class=\"section\" id=\"developers\">\n  <div class=\"container split\">\n    <div>\n      <p class=\"eyebrow\">Developer experience</p>\n      <h2>Feels like the tools you already know.</h2>\n      <p class=\"lead\" style=\"margin-top:1rem;\">Use the CLI, a Python client, or plain SQL. Every interface talks to the same catalog, so a table created in a notebook is immediately visible to your scheduled job.</p>\n\n      <div class=\"tab-list\" role=\"tablist\" aria-label=\"Code examples\">\n        <button class=\"tab-btn\" role=\"tab\" aria-selected=\"true\" aria-controls=\"panel-python\" id=\"tab-python\" data-tab=\"python\">\n          <strong>Python</strong>Build a streaming pipeline in 15 lines.\n        </button>\n        <button class=\"tab-btn\" role=\"tab\" aria-selected=\"false\" aria-controls=\"panel-sql\" id=\"tab-sql\" tabindex=\"-1\" data-tab=\"sql\">\n          <strong>SQL</strong>Declare tables, constraints, and quality checks.\n        </button>\n        <button class=\"tab-btn\" role=\"tab\" aria-selected=\"false\" aria-controls=\"panel-cli\" id=\"tab-cli\" tabindex=\"-1\" data-tab=\"cli\">\n          <strong>CLI</strong>Branch, diff, and roll back data like code.\n        </button>\n      </div>\n    </div>\n\n    <div>\n      <div class=\"code-block\">\n        <div class=\"head\"><span id=\"code-label\">pipeline.py</span><span>tessera \u2265 0.9</span></div>\n\n        <div class=\"tab-panel active\" id=\"panel-python\" role=\"tabpanel\" aria-labelledby=\"tab-python\">\n<pre><span class=\"k\">import</span> tessera <span class=\"k\">as</span> ts\n\ndb = ts.connect(<span class=\"s\">\"s3://acme-lake/warehouse\"</span>)\n\norders = db.stream(<span class=\"s\">\"kafka://orders.v2\"</span>, key=<span class=\"s\">\"order_id\"</span>)\n\nclean = (\n    orders\n    .filter(ts.col(<span class=\"s\">\"amount\"</span>) &gt; <span class=\"n\">0</span>)\n    .dedupe(<span class=\"s\">\"order_id\"</span>, keep=<span class=\"s\">\"latest\"</span>)\n    .with_column(<span class=\"s\">\"day\"</span>, ts.col(<span class=\"s\">\"event_ts\"</span>).date())\n)\n\n<span class=\"k\">with</span> db.checkpoint(<span class=\"s\">\"orders_clean\"</span>, quality=[\n    ts.expect.not_null(<span class=\"s\">\"order_id\"</span>),\n    ts.expect.freshness(<span class=\"s\">\"15m\"</span>),\n]) <span class=\"k\">as</span> job:\n    job.write(clean)</pre>\n        </div>\n\n        <div class=\"tab-panel\" id=\"panel-sql\" role=\"tabpanel\" aria-labelledby=\"tab-sql\">\n<pre><span class=\"c\">-- Declarative table with built-in data contracts</span>\n<span class=\"k\">CREATE TABLE</span> orders_clean (\n    order_id   <span class=\"k\">STRING</span>  <span class=\"k\">PRIMARY KEY</span>,\n    amount     <span class=\"k\">DECIMAL</span>(12,2) <span class=\"k\">CHECK</span> (amount &gt; <span class=\"n\">0</span>),\n    region     <span class=\"k\">STRING</span>  <span class=\"k\">NOT NULL</span>,\n    event_ts   <span class=\"k\">TIMESTAMP</span>\n)\n<span class=\"k\">WITH</span> (\n    partition_by = <span class=\"s\">'date(event_ts)'</span>,\n    freshness_sla = <span class=\"s\">'15 minutes'</span>\n);\n\n<span class=\"c\">-- Evolve safely: additive changes apply instantly</span>\n<span class=\"k\">ALTER TABLE</span> orders_clean <span class=\"k\">ADD COLUMN</span> channel <span class=\"k\">STRING</span>;</pre>\n        </div>\n\n        <div class=\"tab-panel\" id=\"panel-cli\" role=\"tabpanel\" aria-labelledby=\"tab-cli\">\n<pre><span class=\"c\"># Create an isolated branch of production data</span>\n$ tessera branch create fix-revenue-logic --from main\n\n<span class=\"c\"># Run your transforms against the branch</span>\n$ tessera run --branch fix-revenue-logic\n\n<span class=\"c\"># Compare the results before anyone sees them</span>\n$ tessera diff main fix-revenue-logic --table daily_revenue\n  <span class=\"ok\">+ 0 rows added   ~ 12 rows changed   - 0 rows removed</span>\n\n<span class=\"c\"># Merge when it looks right, or roll back instantly</span>\n$ tessera merge fix-revenue-logic\n$ tessera rollback daily_revenue --to <span class=\"s\">\"2025-01-14T00:00Z\"</span></pre>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- BENCHMARKS / STATS -->\n<section class=\"section\" id=\"benchmarks\" style=\"padding-top:0;\">\n  <div class=\"container\">\n    <div class=\"section-head\">\n      <p class=\"eyebrow\">Performance</p>\n      <h2>Fast enough to stop thinking about it.</h2>\n      <p>Measured on a single node with TPC-H SF100 and a 50-million-event-per-hour streaming workload. Full methodology and reproduction scripts live in the repo.</p>\n    </div>\n\n    <div class=\"stats\">\n      <div class=\"stat\">\n        <div class=\"num\">4.2\u00d7</div>\n        <div class=\"label\">faster ingest than a typical Kafka\u2192warehouse connector chain</div>\n      </div>\n      <div class=\"stat\">\n        <div class=\"num\">&lt; 30s</div>\n        <div class=\"label\">end-to-end freshness at p99 under sustained load</div>\n      </div>\n      <div class=\"stat\">\n        <div class=\"num\">0</div>\n        <div class=\"label\">duplicate rows after replays in our fault-injection suite</div>\n      </div>\n      <div class=\"stat\">\n        <div class=\"num\">Apache 2.0</div>\n        <div class=\"label\">permissive license, no usage-based gating on core features</div>\n      </div>\n    </div>\n    <p class=\"stat-note\">Benchmarks are reproducible with <code>make bench</code>. Results vary by hardware and workload.</p>\n  </div>\n</section>\n\n<hr class=\"divider\">\n\n<!-- QUICKSTART -->\n<section class=\"section\" id=\"quickstart\">\n  <div class=\"container\">\n    <div class=\"section-head\">\n      <p class=\"eyebrow\">Quickstart</p>\n      <h2>From install to first query in under five minutes.</h2>\n    </div>\n\n    <div class=\"steps\">\n      <div class=\"step\">\n        <h3>Install</h3>\n        <p>Grab the binary with pip, Homebrew, Docker, or a single curl. No JVM, no cluster required to start.</p>\n      </div>\n      <div class=\"step\">\n        <h3>Connect a source</h3>\n        <p>Point Tessera at a Kafka topic, a Postgres replica, or a folder of Parquet files. Schemas are inferred and versioned.</p>\n      </div>\n      <div class=\"step\">\n        <h3>Query and ship</h3>\n        <p>Write SQL or Python, schedule it with your existing orchestrator, and watch freshness and quality in one dashboard.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<hr class=\"divider\">\n\n<!-- PRINCIPLES -->\n<section class=\"section\">\n  <div class=\"container\">\n    <div class=\"section-head\">\n      <p class=\"eyebrow\">Why open source</p>\n      <h2>Your data infrastructure should be inspectable.</h2>\n      <p>Pipelines run critical business logic. We think you should be able to read every line of the engine that runs it.</p>\n    </div>\n\n    <div class=\"principles\">\n      <div class=\"principle\">\n        <span class=\"mark\">01</span>\n        <div>\n          <h3>Open formats, always</h3>\n          <p>Data is stored as Parquet with an open table spec. If you ever leave, your files walk out the door with you.</p>\n        </div>\n      </div>\n      <div class=\"principle\">\n        <span class=\"mark\">02</span>\n        <div>\n          <h3>No paywalled core</h3>\n          <p>Ingest, time travel, quality checks, and the CLI are all in the Apache 2.0 release. Enterprise add-ons are optional.</p>\n        </div>\n      </div>\n      <div class=\"principle\">\n        <span class=\"mark\">03</span>\n        <div>\n          <h3>Governed by the community</h3>\n          <p>Design decisions happen in public RFCs. Maintainers from three companies sit on the steering committee.</p>\n        </div>\n      </div>\n      <div class=\"principle\">\n        <span class=\"mark\">04</span>\n        <div>\n          <h3>Auditable by default</h3>\n          <p>Every query plan, schema change, and merge is logged to an append-only audit trail you can export and verify.</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- FINAL CTA -->\n<section class=\"section\" id=\"community\" style=\"padding-top:0;\">\n  <div class=\"container\">\n    <div class=\"final-cta\">\n      <p class=\"eyebrow\">Join the community</p>\n      <h2>Build the pipelines you'd be proud to be paged for.</h2>\n      <p>Star the repo, open an issue, or pick up a \"good first issue.\" Tessera is only as good as the people who run it.</p>\n      <div class=\"cta-row\">\n        <a href=\"#quickstart\" class=\"btn btn-primary\">Install Tessera</a>\n        <a href=\"#top\" class=\"btn btn-ghost\">\u2605 Star on GitHub</a>\n        <a href=\"#top\" class=\"btn btn-ghost\">Join Discord</a>\n      </div>\n    </div>\n  </div>\n</section>\n\n</main>\n\n<!-- FOOTER -->\n<footer>\n  <div class=\"container\">\n    <div class=\"foot-grid\">\n      <div>\n        <a href=\"#top\" class=\"brand\" style=\"margin-bottom:1rem;\">\n          <svg width=\"24\" height=\"24\" viewBox=\"0 0 28 28\" aria-hidden=\"true\">\n            <rect x=\"2\" y=\"2\" width=\"11\" height=\"11\" rx=\"3\" fill=\"#5eead4\"/>\n            <rect x=\"15\" y=\"2\" width=\"11\" height=\"11\" rx=\"3\" fill=\"#5eead4\" opacity=\"0.55\"/>\n            <rect x=\"2\" y=\"15\" width=\"11\" height=\"11\" rx=\"3\" fill=\"#5eead4\" opacity=\"0.55\"/>\n            <rect x=\"15\" y=\"15\" width=\"11\" height=\"11\" rx=\"3\" fill=\"#5eead4\"/>\n          </svg>\n          Tessera\n        </a>\n        <p style=\"max-width:32ch;\">An open-source columnar database for data engineers. Maintained in public.</p>\n      </div>\n      <div>\n        <h4>Product</h4>\n        <ul>\n          <li><a href=\"#features\">Features</a></li>\n          <li><a href=\"#architecture\">Architecture</a></li>\n          <li><a href=\"#benchmarks\">Benchmarks</a></li>\n          <li><a href=\"#top\">Roadmap</a></li>\n        </ul>\n      </div>\n      <div>\n        <h4>Developers</h4>\n        <ul>\n          <li><a href=\"#developers\">Documentation</a></li>\n          <li><a href=\"#quickstart\">Quickstart</a></li>\n          <li><a href=\"#top\">API reference</a></li>\n          <li><a href=\"#top\">Changelog</a></li>\n        </ul>\n      </div>\n      <div>\n        <h4>Community</h4>\n        <ul>\n          <li><a href=\"#top\">GitHub</a></li>\n          <li><a href=\"#top\">Discord</a></li>\n          <li><a href=\"#top\">Contributing</a></li>\n          <li><a href=\"#top\">Code of conduct</a></li>\n        </ul>\n      </div>\n    </div>\n    <div class=\"foot-bottom\">\n      <span>\u00a9 2025 Tessera contributors \u00b7 Apache 2.0</span>\n      <span>Built with open formats</span>\n    </div>\n  </div>\n</footer>\n\n<script>\n  // Copy-to-clipboard for the install command\n  document.querySelectorAll('[data-copy]').forEach(function (btn) {\n    btn.addEventListener('click', function () {\n      var text = btn.getAttribute('data-copy');\n      var done = function () {\n        var original = btn.textContent;\n        btn.textContent = 'Copied';\n        setTimeout(function () { btn.textContent = original; }, 1500);\n      };\n      if (navigator.clipboard) {\n        navigator.clipboard.writeText(text).then(done, done);\n      } else {\n        done();\n      }\n    });\n  });\n\n  // Developer experience tabs (with arrow-key navigation)\n  (function () {\n    var tabs = Array.prototype.slice.call(document.querySelectorAll('[role=\"tab\"]'));\n    var panels = {\n      python: document.getElementById('panel-python'),\n      sql: document.getElementById('panel-sql'),\n      cli: document.getElementById('panel-cli')\n    };\n    var labels = { python: 'pipeline.py', sql: 'schema.sql', cli: 'terminal' };\n    var label = document.getElementById('code-label');\n\n    function select(tab) {\n      var key = tab.getAttribute('data-tab');\n      tabs.forEach(function (t) {\n        var active = t === tab;\n        t.setAttribute('aria-selected', active ? 'true' : 'false');\n        t.tabIndex = active ? 0 : -1;\n      });\n      Object.keys(panels).forEach(function (k) {\n        panels[k].classList.toggle('active', k === key);\n      });\n      label.textContent = labels[key];\n      tab.focus();\n    }\n\n    tabs.forEach(function (tab, i) {\n      tab.addEventListener('click', function () { select(tab); });\n      tab.addEventListener('keydown', function (e) {\n        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {\n          e.preventDefault(); select(tabs[(i + 1) % tabs.length]);\n        } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {\n          e.preventDefault(); select(tabs[(i - 1 + tabs.length) % tabs.length]);\n        }\n      });\n    });\n  })();\n</script>\n</body>\n</html>\n"}