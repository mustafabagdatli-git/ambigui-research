{"brief": "B4", "model": "openai/gpt-6-luna", "i": 3, "finish": "stop", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#f6f2e9\">\n  <title>Low Tide Press \u2014 Poetry for the in-between</title>\n  <style>\n    :root {\n      --paper: #f6f2e9;\n      --ink: #252820;\n      --muted: #696b60;\n      --line: #d8d3c7;\n      --green: #364638;\n      --rust: #ba573c;\n      --serif: Georgia, \"Times New Roman\", serif;\n      --sans: \"Helvetica Neue\", Helvetica, Arial, sans-serif;\n    }\n\n    * { box-sizing: border-box; }\n\n    html { scroll-behavior: smooth; }\n\n    body {\n      margin: 0;\n      background: var(--paper);\n      color: var(--ink);\n      font-family: var(--sans);\n      -webkit-font-smoothing: antialiased;\n    }\n\n    a { color: inherit; }\n\n    .wrap {\n      width: min(1160px, calc(100% - 64px));\n      margin: 0 auto;\n    }\n\n    .topline {\n      padding: 11px 20px;\n      background: var(--green);\n      color: #f6f2e9;\n      text-align: center;\n      font-size: 10px;\n      letter-spacing: .16em;\n      text-transform: uppercase;\n    }\n\n    header {\n      border-bottom: 1px solid var(--line);\n    }\n\n    .nav {\n      min-height: 82px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 30px;\n    }\n\n    .brand {\n      display: inline-flex;\n      align-items: center;\n      gap: 11px;\n      color: var(--ink);\n      text-decoration: none;\n      font-size: 12px;\n      font-weight: 700;\n      letter-spacing: .17em;\n      line-height: 1.15;\n      text-transform: uppercase;\n    }\n\n    .brand-mark {\n      width: 27px;\n      height: 27px;\n      position: relative;\n      display: inline-block;\n      border: 1px solid var(--rust);\n      border-radius: 50%;\n    }\n\n    .brand-mark::before,\n    .brand-mark::after {\n      content: \"\";\n      position: absolute;\n      left: 5px;\n      right: 5px;\n      height: 1px;\n      background: var(--rust);\n      transform: rotate(-35deg);\n    }\n\n    .brand-mark::before { top: 10px; }\n    .brand-mark::after { top: 15px; }\n\n    .nav-links {\n      display: flex;\n      align-items: center;\n      gap: 31px;\n    }\n\n    .nav-links a {\n      color: var(--muted);\n      text-decoration: none;\n      font-size: 12px;\n      transition: color .2s ease;\n    }\n\n    .nav-links a:hover { color: var(--rust); }\n\n    .nav-links .nav-cta {\n      padding: 12px 17px;\n      border: 1px solid var(--ink);\n      color: var(--ink);\n    }\n\n    .nav-links .nav-cta:hover {\n      background: var(--ink);\n      color: var(--paper);\n    }\n\n    .hero {\n      min-height: 590px;\n      padding: 75px 0 86px;\n      display: grid;\n      grid-template-columns: 1.05fr .95fr;\n      align-items: center;\n      gap: 50px;\n    }\n\n    .eyebrow {\n      margin: 0 0 23px;\n      color: var(--rust);\n      font-size: 10px;\n      font-weight: 700;\n      letter-spacing: .2em;\n      text-transform: uppercase;\n    }\n\n    h1, h2, h3, p { margin-top: 0; }\n\n    h1 {\n      max-width: 580px;\n      margin-bottom: 25px;\n      font-family: var(--serif);\n      font-size: clamp(54px, 7.2vw, 91px);\n      font-weight: 400;\n      letter-spacing: -.055em;\n      line-height: .96;\n    }\n\n    h1 em {\n      color: var(--rust);\n      font-weight: 400;\n    }\n\n    .hero-copy {\n      max-width: 410px;\n      margin-bottom: 30px;\n      color: var(--muted);\n      font-family: var(--serif);\n      font-size: 18px;\n      line-height: 1.65;\n    }\n\n    .text-link {\n      display: inline-flex;\n      align-items: center;\n      gap: 13px;\n      color: var(--ink);\n      text-decoration: none;\n      font-size: 11px;\n      font-weight: 700;\n      letter-spacing: .12em;\n      text-transform: uppercase;\n    }\n\n    .text-link::after {\n      content: \"\u2197\";\n      color: var(--rust);\n      font-size: 17px;\n      transition: transform .2s ease;\n    }\n\n    .text-link:hover::after { transform: translate(3px, -3px); }\n\n    .feature-art {\n      min-height: 420px;\n      position: relative;\n      display: grid;\n      place-items: center;\n      overflow: hidden;\n      background: #e9e5d9;\n    }\n\n    .feature-art::before {\n      content: \"\";\n      position: absolute;\n      width: 310px;\n      height: 310px;\n      top: 40px;\n      right: -65px;\n      border: 1px solid rgba(54, 70, 56, .25);\n      border-radius: 50%;\n    }\n\n    .feature-art::after {\n      content: \"\";\n      position: absolute;\n      width: 230px;\n      height: 230px;\n      bottom: -125px;\n      left: -45px;\n      border: 1px solid rgba(186, 87, 60, .4);\n      border-radius: 50%;\n    }\n\n    .book {\n      width: 237px;\n      height: 337px;\n      position: relative;\n      z-index: 1;\n      padding: 28px 25px;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: space-between;\n      overflow: hidden;\n      background: #65745d;\n      color: #f4efdf;\n      box-shadow: 15px 18px 28px rgba(34, 39, 31, .19);\n      transform: rotate(-4deg);\n    }\n\n    .book::before {\n      content: \"\";\n      position: absolute;\n      width: 180px;\n      height: 180px;\n      top: 80px;\n      left: 28px;\n      border: 1px solid rgba(244, 239, 223, .65);\n      border-radius: 50%;\n    }\n\n    .book::after {\n      content: \"\";\n      position: absolute;\n      width: 1px;\n      height: 230px;\n      top: 55px;\n      left: 118px;\n      background: rgba(244, 239, 223, .55);\n      transform: rotate(42deg);\n    }\n\n    .book-kicker,\n    .book-author,\n    .book-title { position: relative; z-index: 1; }\n\n    .book-kicker {\n      align-self: flex-start;\n      font-size: 8px;\n      letter-spacing: .18em;\n      text-transform: uppercase;\n    }\n\n    .book-title {\n      margin: auto 0;\n      max-width: 190px;\n      font-family: var(--serif);\n      font-size: 35px;\n      font-weight: 400;\n      letter-spacing: -.04em;\n      line-height: .98;\n      text-align: center;\n    }\n\n    .book-author {\n      font-size: 9px;\n      letter-spacing: .16em;\n      text-transform: uppercase;\n    }\n\n    .art-caption {\n      position: absolute;\n      right: 23px;\n      bottom: 20px;\n      z-index: 2;\n      color: var(--muted);\n      font-size: 9px;\n      letter-spacing: .12em;\n      text-transform: uppercase;\n    }\n\n    .featured {\n      padding: 72px 0 78px;\n      border-top: 1px solid var(--line);\n      border-bottom: 1px solid var(--line);\n    }\n\n    .section-heading {\n      display: flex;\n      align-items: end;\n      justify-content: space-between;\n      gap: 25px;\n      margin-bottom: 35px;\n    }\n\n    .section-heading h2 {\n      margin: 0;\n      font-family: var(--serif);\n      font-size: clamp(35px, 4vw, 49px);\n      font-weight: 400;\n      letter-spacing: -.04em;\n    }\n\n    .section-heading .eyebrow { margin-bottom: 12px; }\n\n    .feature-row {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 70px;\n      align-items: center;\n    }\n\n    .feature-note {\n      padding: 35px 0;\n    }\n\n    .feature-note blockquote {\n      max-width: 490px;\n      margin: 0 0 27px;\n      font-family: var(--serif);\n      font-size: clamp(26px, 3.2vw, 39px);\n      letter-spacing: -.025em;\n      line-height: 1.23;\n    }\n\n    .feature-note blockquote em { color: var(--rust); }\n\n    .byline {\n      margin-bottom: 22px;\n      color: var(--muted);\n      font-size: 11px;\n      letter-spacing: .13em;\n      text-transform: uppercase;\n    }\n\n    .feature-description {\n      max-width: 430px;\n      margin-bottom: 25px;\n      color: var(--muted);\n      font-family: var(--serif);\n      font-size: 16px;\n      line-height: 1.7;\n    }\n\n    .poem-card {\n      min-height: 280px;\n      padding: 42px;\n      display: flex;\n      flex-direction: column;\n      justify-content: center;\n      background: #e9e5d9;\n      color: var(--green);\n    }\n\n    .poem-card p {\n      margin: 0;\n      font-family: var(--serif);\n      font-size: clamp(18px, 2vw, 23px);\n      line-height: 1.58;\n    }\n\n    .poem-card small {\n      margin-top: 27px;\n      color: var(--muted);\n      font-size: 9px;\n      letter-spacing: .17em;\n      text-transform: uppercase;\n    }\n\n    .about {\n      padding: 82px 0;\n      display: grid;\n      grid-template-columns: .75fr 1.25fr;\n      gap: 75px;\n      align-items: start;\n    }\n\n    .about h2 {\n      max-width: 390px;\n      margin: 0;\n      font-family: var(--serif);\n      font-size: clamp(38px, 5vw, 59px);\n      font-weight: 400;\n      letter-spacing: -.045em;\n      line-height: 1.03;\n    }\n\n    .about-copy {\n      max-width: 520px;\n      padding-top: 9px;\n    }\n\n    .about-copy p {\n      color: var(--muted);\n      font-family: var(--serif);\n      font-size: 17px;\n      line-height: 1.75;\n    }\n\n    .about-copy p:last-of-type { margin-bottom: 25px; }\n\n    .newsletter {\n      padding: 59px 0;\n      background: var(--green);\n      color: var(--paper);\n    }\n\n    .newsletter-inner {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 35px;\n    }\n\n    .newsletter .eyebrow {\n      margin-bottom: 12px;\n      color: #d8a18e;\n    }\n\n    .newsletter h2 {\n      max-width: 520px;\n      margin: 0;\n      font-family: var(--serif);\n      font-size: clamp(30px, 4vw, 43px);\n      font-weight: 400;\n      letter-spacing: -.035em;\n      line-height: 1.1;\n    }\n\n    .newsletter-link {\n      flex: 0 0 auto;\n      padding: 15px 19px;\n      border: 1px solid rgba(246, 242, 233, .7);\n      color: var(--paper);\n      text-decoration: none;\n      font-size: 10px;\n      font-weight: 700;\n      letter-spacing: .12em;\n      text-transform: uppercase;\n      transition: background .2s, color .2s;\n    }\n\n    .newsletter-link:hover {\n      background: var(--paper);\n      color: var(--green);\n    }\n\n    footer {\n      padding: 25px 0;\n      color: var(--muted);\n      font-size: 10px;\n      letter-spacing: .08em;\n    }\n\n    .footer-inner {\n      display: flex;\n      justify-content: space-between;\n      gap: 20px;\n    }\n\n    footer a {\n      text-decoration: none;\n      border-bottom: 1px solid var(--line);\n    }\n\n    @media (max-width: 760px) {\n      .wrap { width: min(100% - 40px, 560px); }\n\n      .nav {\n        min-height: 72px;\n        gap: 15px;\n      }\n\n      .nav-links { gap: 15px; }\n      .nav-links a { font-size: 11px; }\n      .nav-links a:nth-child(2) { display: none; }\n      .nav-links .nav-cta { padding: 10px 12px; }\n\n      .hero {\n        min-height: auto;\n        padding: 59px 0 65px;\n        grid-template-columns: 1fr;\n        gap: 40px;\n      }\n\n      .feature-art { min-height: 370px; }\n      .book { transform: rotate(-3deg) scale(.92); }\n\n      .featured { padding: 57px 0; }\n      .section-heading { align-items: start; flex-direction: column; }\n      .feature-row { grid-template-columns: 1fr; gap: 15px; }\n      .feature-note { padding: 10px 0; }\n      .poem-card { min-height: 250px; padding: 30px; }\n\n      .about {\n        padding: 63px 0;\n        grid-template-columns: 1fr;\n        gap: 25px;\n      }\n\n      .newsletter-inner {\n        align-items: flex-start;\n        flex-direction: column;\n      }\n\n      .footer-inner { flex-direction: column; gap: 9px; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      html { scroll-behavior: auto; }\n      *, *::before, *::after {\n        transition-duration: .01ms !important;\n        animation-duration: .01ms !important;\n      }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"topline\">Independent poetry, made slowly \u00b7 Based in the Pacific Northwest</div>\n\n  <header>\n    <nav class=\"nav wrap\" aria-label=\"Main navigation\">\n      <a class=\"brand\" href=\"#\" aria-label=\"Low Tide Press home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\"></span>\n        <span>Low Tide<br>Press</span>\n      </a>\n      <div class=\"nav-links\">\n        <a href=\"#books\">Books</a>\n        <a href=\"#about\">Our story</a>\n        <a class=\"nav-cta\" href=\"#letters\">Get our letters</a>\n      </div>\n    </nav>\n  </header>\n\n  <main>\n    <section class=\"hero wrap\" aria-labelledby=\"hero-title\">\n      <div>\n        <p class=\"eyebrow\">A small press for the in-between</p>\n        <h1 id=\"hero-title\">Poems for a <em>closer</em> kind of looking.</h1>\n        <p class=\"hero-copy\">\n          We make thoughtful books of poetry for the ordinary hours, the changing seasons,\n          and everything we\u2019re still learning how to name.\n        </p>\n        <a class=\"text-link\" href=\"#books\">Find your next read</a>\n      </div>\n\n      <div class=\"feature-art\" role=\"img\" aria-label=\"A green poetry book cover with a fine-line circle design\">\n        <div class=\"book\" aria-hidden=\"true\">\n          <span class=\"book-kicker\">Low Tide Press</span>\n          <span class=\"book-title\">The Weather<br>Inside</span>\n          <span class=\"book-author\">Mara Bell</span>\n        </div>\n        <span class=\"art-caption\">New poetry \u00b7 Spring 2025</span>\n      </div>\n    </section>\n\n    <section class=\"featured\" id=\"books\" aria-labelledby=\"books-title\">\n      <div class=\"wrap\">\n        <div class=\"section-heading\">\n          <div>\n            <p class=\"eyebrow\">Just published</p>\n            <h2 id=\"books-title\">A book to keep close.</h2>\n          </div>\n          <a class=\"text-link\" href=\"mailto:hello@lowtidepress.com\">Order a copy</a>\n        </div>\n\n        <div class=\"feature-row\">\n          <div class=\"feature-note\">\n            <p class=\"byline\">The Weather Inside \u00b7 Mara Bell</p>\n            <blockquote>\u201cSome days the light arrives as if it has been <em>looking for you.</em>\u201d</blockquote>\n            <p class=\"feature-description\">\n              In her tender, clear-eyed debut, Mara Bell finds the extraordinary tucked\n              inside the everyday: a kitchen at dusk, a long drive home, the first warm\n              morning after winter.\n            </p>\n            <a class=\"text-link\" href=\"mailto:hello@lowtidepress.com\">Read more about the book</a>\n          </div>\n\n          <div class=\"poem-card\">\n            <p>\n              By evening, the window holds<br>\n              the last of the blue.<br>\n              I stand here a little longer,<br>\n              not asking it to stay.\n            </p>\n            <small>From \u201cSmall Hours\u201d \u00b7 Mara Bell</small>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"about wrap\" id=\"about\" aria-labelledby=\"about-title\">\n      <div>\n        <p class=\"eyebrow\">A note from the press</p>\n        <h2 id=\"about-title\">Small books.<br>Wide-open worlds.</h2>\n      </div>\n      <div class=\"about-copy\">\n        <p>\n          Low Tide is an independent poetry press drawn to voices that make us pause.\n          We publish a handful of books each year, giving every one the time, care, and\n          good paper it deserves.\n        </p>\n        <p>\n          Our list is curious, generous, and a little unruly\u2014poems to read on a walk,\n          pass to a friend, or leave open on the table.\n        </p>\n        <a class=\"text-link\" href=\"mailto:hello@lowtidepress.com\">Say hello</a>\n      </div>\n    </section>\n\n    <section class=\"newsletter\" id=\"letters\" aria-labelledby=\"letters-title\">\n      <div class=\"newsletter-inner wrap\">\n        <div>\n          <p class=\"eyebrow\">A letter now and then</p>\n          <h2 id=\"letters-title\">New poems, new books, and notes from the shore.</h2>\n        </div>\n        <a class=\"newsletter-link\" href=\"mailto:hello@lowtidepress.com?subject=Please%20add%20me%20to%20the%20Low%20Tide%20letters\">\n          Join the mailing list\n        </a>\n      </div>\n    </section>\n  </main>\n\n  <footer>\n    <div class=\"footer-inner wrap\">\n      <span>\u00a9 2025 Low Tide Press</span>\n      <span>Made with care, in small editions \u00b7 <a href=\"mailto:hello@lowtidepress.com\">Get in touch</a></span>\n    </div>\n  </footer>\n</body>\n</html>\n"}