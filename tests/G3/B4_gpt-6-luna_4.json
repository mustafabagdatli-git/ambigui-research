{"brief": "B4", "model": "openai/gpt-6-luna", "i": 4, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#f4f0e7\">\n  <title>Small Hours Press \u2014 Poetry for the in-between</title>\n  <style>\n    :root {\n      --paper: #f4f0e7;\n      --ink: #25271f;\n      --muted: #716f63;\n      --red: #a44632;\n      --line: #d9d2c3;\n      --sage: #c9cbb7;\n      --serif: Georgia, \"Times New Roman\", serif;\n      --sans: \"Helvetica Neue\", Helvetica, Arial, sans-serif;\n    }\n\n    * { box-sizing: border-box; }\n\n    html { scroll-behavior: smooth; }\n\n    body {\n      margin: 0;\n      background: var(--paper);\n      color: var(--ink);\n      font-family: var(--sans);\n      -webkit-font-smoothing: antialiased;\n    }\n\n    a { color: inherit; text-decoration: none; }\n\n    .wrap {\n      width: min(1160px, calc(100% - 64px));\n      margin: 0 auto;\n    }\n\n    .topline {\n      border-bottom: 1px solid var(--line);\n      font-size: 10px;\n      letter-spacing: .16em;\n      text-transform: uppercase;\n    }\n\n    .topline .wrap {\n      display: flex;\n      justify-content: space-between;\n      padding: 11px 0;\n    }\n\n    header {\n      border-bottom: 1px solid var(--line);\n    }\n\n    .nav {\n      min-height: 82px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 24px;\n    }\n\n    .brand {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      font-family: var(--serif);\n      font-size: 24px;\n      letter-spacing: -.04em;\n      white-space: nowrap;\n    }\n\n    .brand-mark {\n      width: 30px;\n      height: 30px;\n      border: 1px solid var(--red);\n      color: var(--red);\n      display: grid;\n      place-items: center;\n      font-size: 17px;\n      line-height: 1;\n      transform: rotate(-8deg);\n    }\n\n    .nav-links {\n      display: flex;\n      align-items: center;\n      gap: 34px;\n      font-size: 11px;\n      letter-spacing: .13em;\n      text-transform: uppercase;\n    }\n\n    .nav-links a { transition: color .2s; }\n    .nav-links a:hover { color: var(--red); }\n\n    .nav-links .subscribe-link {\n      border: 1px solid var(--ink);\n      padding: 12px 16px;\n    }\n\n    .hero {\n      min-height: 590px;\n      padding: 72px 0 78px;\n      display: grid;\n      grid-template-columns: 1.05fr .95fr;\n      align-items: center;\n      gap: 44px;\n    }\n\n    .eyebrow {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      margin-bottom: 24px;\n      color: var(--red);\n      font-size: 10px;\n      font-weight: 600;\n      letter-spacing: .19em;\n      text-transform: uppercase;\n    }\n\n    .eyebrow::before {\n      content: \"\";\n      width: 32px;\n      height: 1px;\n      background: currentColor;\n    }\n\n    h1, h2, h3, p { margin-top: 0; }\n\n    h1 {\n      max-width: 600px;\n      margin-bottom: 23px;\n      font-family: var(--serif);\n      font-weight: 400;\n      font-size: clamp(56px, 7.5vw, 96px);\n      line-height: .91;\n      letter-spacing: -.065em;\n    }\n\n    h1 em {\n      color: var(--red);\n      font-weight: 400;\n    }\n\n    .hero-copy {\n      max-width: 410px;\n      margin-bottom: 30px;\n      color: var(--muted);\n      font-family: var(--serif);\n      font-size: 19px;\n      line-height: 1.55;\n    }\n\n    .button {\n      display: inline-flex;\n      align-items: center;\n      gap: 22px;\n      padding: 15px 18px;\n      background: var(--ink);\n      color: var(--paper);\n      font-size: 10px;\n      letter-spacing: .15em;\n      text-transform: uppercase;\n      transition: background .2s, transform .2s;\n    }\n\n    .button:hover {\n      background: var(--red);\n      transform: translateY(-2px);\n    }\n\n    .button span { font-size: 17px; line-height: 10px; }\n\n    .hero-art {\n      position: relative;\n      min-height: 420px;\n      display: grid;\n      place-items: center;\n    }\n\n    .sun {\n      position: absolute;\n      top: 12%;\n      right: 7%;\n      width: 82px;\n      height: 82px;\n      border-radius: 50%;\n      background: #d9a47c;\n    }\n\n    .book {\n      position: relative;\n      z-index: 1;\n      width: min(300px, 72%);\n      aspect-ratio: .72;\n      padding: 30px 25px;\n      background: #34433c;\n      color: #f4e9d3;\n      box-shadow: 18px 20px 0 rgba(37, 39, 31, .13);\n      transform: rotate(-5deg);\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      overflow: hidden;\n    }\n\n    .book::before, .book::after {\n      content: \"\";\n      position: absolute;\n      border: 1px solid rgba(235, 220, 187, .35);\n      border-radius: 50%;\n      width: 270px;\n      height: 270px;\n      left: 50%;\n      top: 50%;\n      transform: translate(-50%, -50%);\n    }\n\n    .book::after {\n      width: 190px;\n      height: 190px;\n      border-color: rgba(235, 220, 187, .52);\n    }\n\n    .book-small, .book-title, .book-author, .book-rule {\n      position: relative;\n      z-index: 2;\n    }\n\n    .book-small {\n      font-size: 8px;\n      letter-spacing: .2em;\n      text-transform: uppercase;\n    }\n\n    .book-title {\n      max-width: 220px;\n      margin: auto 0;\n      font-family: var(--serif);\n      font-size: clamp(32px, 4vw, 47px);\n      line-height: .93;\n      letter-spacing: -.05em;\n    }\n\n    .book-title em { color: #e5a17d; }\n\n    .book-rule {\n      width: 34px;\n      height: 1px;\n      margin-bottom: 12px;\n      background: #e5a17d;\n    }\n\n    .book-author {\n      font-size: 9px;\n      letter-spacing: .16em;\n      text-transform: uppercase;\n    }\n\n    .art-caption {\n      position: absolute;\n      right: 0;\n      bottom: 12px;\n      color: var(--muted);\n      font-family: var(--serif);\n      font-size: 13px;\n      font-style: italic;\n    }\n\n    .ticker {\n      overflow: hidden;\n      border-top: 1px solid var(--line);\n      border-bottom: 1px solid var(--line);\n      color: var(--red);\n    }\n\n    .ticker-inner {\n      display: flex;\n      justify-content: space-between;\n      gap: 30px;\n      padding: 16px 0;\n      white-space: nowrap;\n      font-family: var(--serif);\n      font-size: 16px;\n      font-style: italic;\n    }\n\n    .ticker-inner span::after {\n      content: \"\u2733\";\n      margin-left: 30px;\n      color: #b8a990;\n      font-size: 12px;\n      font-style: normal;\n    }\n\n    .section {\n      padding: 100px 0;\n    }\n\n    .section-heading {\n      display: flex;\n      justify-content: space-between;\n      align-items: end;\n      gap: 24px;\n      margin-bottom: 42px;\n    }\n\n    .section-heading h2 {\n      max-width: 530px;\n      margin: 0;\n      font-family: var(--serif);\n      font-size: clamp(36px, 5vw, 58px);\n      font-weight: 400;\n      line-height: .98;\n      letter-spacing: -.05em;\n    }\n\n    .text-link {\n      flex: 0 0 auto;\n      padding-bottom: 7px;\n      border-bottom: 1px solid var(--red);\n      color: var(--red);\n      font-size: 10px;\n      letter-spacing: .14em;\n      text-transform: uppercase;\n    }\n\n    .books-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 28px;\n    }\n\n    .book-card { min-width: 0; }\n\n    .cover {\n      position: relative;\n      min-height: 340px;\n      margin-bottom: 20px;\n      padding: 25px;\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      overflow: hidden;\n      color: #f7f0df;\n    }\n\n    .cover::before, .cover::after {\n      content: \"\";\n      position: absolute;\n      pointer-events: none;\n    }\n\n    .cover-one { background: #a84d37; }\n    .cover-one::before {\n      width: 220px; height: 220px; border: 1px solid rgba(255,255,255,.45);\n      border-radius: 50%; right: -40px; bottom: -32px;\n    }\n    .cover-one::after {\n      width: 160px; height: 160px; border: 1px solid rgba(255,255,255,.35);\n      border-radius: 50%; right: -10px; bottom: -2px;\n    }\n\n    .cover-two { background: #596758; }\n    .cover-two::before {\n      width: 1px; height: 150%; left: 50%; top: -20%;\n      background: rgba(255,255,255,.55); transform: rotate(32deg);\n    }\n    .cover-two::after {\n      width: 190px; height: 190px; border: 1px solid rgba(255,255,255,.4);\n      border-radius: 50%; left: -45px; top: 85px;\n    }\n\n    .cover-three { background: #d8b98f; color: #30372f; }\n    .cover-three::before {\n      width: 150px; height: 220px; border: 1px solid rgba(48,55,47,.52);\n      border-radius: 50%; right: 25px; top: 40px; transform: rotate(35deg);\n    }\n    .cover-three::after {\n      width: 150px; height: 220px; border: 1px solid rgba(48,55,47,.52);\n      border-radius: 50%; right: 25px; top: 40px; transform: rotate(-35deg);\n    }\n\n    .cover-label, .cover-name {\n      position: relative;\n      z-index: 1;\n      font-size: 8px;\n      letter-spacing: .19em;\n      text-transform: uppercase;\n    }\n\n    .cover-name {\n      max-width: 210px;\n      font-family: var(--serif);\n      font-size: 35px;\n      line-height: .95;\n      letter-spacing: -.05em;\n      text-transform: none;\n    }\n\n    .book-card h3 {\n      margin-bottom: 5px;\n      font-family: var(--serif);\n      font-size: 23px;\n      font-weight: 400;\n      letter-spacing: -.03em;\n    }\n\n    .book-card p {\n      margin-bottom: 0;\n      color: var(--muted);\n      font-size: 12px;\n    }\n\n    .manifesto {\n      background: #e8e3d8;\n      padding: 92px 0 96px;\n    }\n\n    .manifesto-grid {\n      display: grid;\n      grid-template-columns: .7fr 1.3fr;\n      gap: 80px;\n      align-items: start;\n    }\n\n    .manifesto-kicker {\n      color: var(--red);\n      font-size: 10px;\n      letter-spacing: .17em;\n      text-transform: uppercase;\n    }\n\n    .manifesto blockquote {\n      margin: 0;\n      max-width: 790px;\n      font-family: var(--serif);\n      font-size: clamp(29px, 4.2vw, 48px);\n      line-height: 1.14;\n      letter-spacing: -.04em;\n    }\n\n    .manifesto blockquote em {\n      color: var(--red);\n      font-weight: 400;\n    }\n\n    .manifesto p {\n      max-width: 470px;\n      margin: 27px 0 0;\n      color: var(--muted);\n      font-size: 13px;\n      line-height: 1.8;\n    }\n\n    .newsletter {\n      padding: 90px 0;\n      border-bottom: 1px solid var(--line);\n      text-align: center;\n    }\n\n    .newsletter .eyebrow { justify-content: center; }\n\n    .newsletter h2 {\n      max-width: 620px;\n      margin: 0 auto 16px;\n      font-family: var(--serif);\n      font-size: clamp(39px, 6vw, 68px);\n      font-weight: 400;\n      line-height: .98;\n      letter-spacing: -.055em;\n    }\n\n    .newsletter > .wrap > p {\n      max-width: 420px;\n      margin: 0 auto 28px;\n      color: var(--muted);\n      font-family: var(--serif);\n      font-size: 17px;\n      line-height: 1.5;\n    }\n\n    form {\n      display: flex;\n      width: min(440px, 100%);\n      margin: 0 auto;\n      border-bottom: 1px solid var(--ink);\n    }\n\n    input[type=\"email\"] {\n      flex: 1;\n      min-width: 0;\n      padding: 14px 4px;\n      border: 0;\n      outline: 0;\n      background: transparent;\n      color: var(--ink);\n      font: 13px var(--sans);\n    }\n\n    input::placeholder { color: #888477; }\n\n    form button {\n      border: 0;\n      background: transparent;\n      color: var(--red);\n      cursor: pointer;\n      font: 10px var(--sans);\n      letter-spacing: .13em;\n      text-transform: uppercase;\n    }\n\n    footer { padding: 28px 0 35px; }\n\n    .footer-row {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 20px;\n      color: var(--muted);\n      font-size: 10px;\n      letter-spacing: .08em;\n    }\n\n    .footer-brand {\n      color: var(--ink);\n      font-family: var(--serif);\n      font-size: 18px;\n      letter-spacing: -.03em;\n    }\n\n    .footer-links { display: flex; gap: 22px; }\n    .footer-links a:hover { color: var(--red); }\n\n    @media (max-width: 760px) {\n      .wrap { width: min(100% - 40px, 560px); }\n      .topline .wrap { font-size: 8px; }\n      .nav { min-height: 70px; }\n      .brand { font-size: 21px; }\n      .nav-links { gap: 15px; }\n      .nav-links a:not(.subscribe-link) { display: none; }\n      .nav-links .subscribe-link { padding: 10px 12px; }\n\n      .hero {\n        min-height: auto;\n        padding: 66px 0 56px;\n        grid-template-columns: 1fr;\n        gap: 20px;\n      }\n\n      .hero-art { min-height: 390px; }\n      .book { width: 245px; }\n      .sun { right: 12%; }\n      .art-caption { right: 8px; bottom: 0; }\n\n      .ticker-inner {\n        justify-content: flex-start;\n        width: max-content;\n        animation: drift 24s linear infinite;\n      }\n\n      @keyframes drift { to { transform: translateX(-25%); } }\n\n      .section { padding: 72px 0; }\n      .section-heading { align-items: start; flex-direction: column; margin-bottom: 30px; }\n      .books-grid { grid-template-columns: 1fr 1fr; gap: 30px 16px; }\n      .cover { min-height: 270px; padding: 18px; }\n      .cover-name { font-size: 29px; }\n      .manifesto { padding: 70px 0; }\n      .manifesto-grid { grid-template-columns: 1fr; gap: 25px; }\n      .newsletter { padding: 72px 0; }\n      .footer-row { flex-wrap: wrap; }\n    }\n\n    @media (max-width: 430px) {\n      .topline .wrap span:last-child { display: none; }\n      .books-grid { grid-template-columns: 1fr; }\n      .cover { min-height: 360px; }\n      .footer-row { align-items: flex-start; flex-direction: column; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"topline\">\n    <div class=\"wrap\">\n      <span>Independent poetry, made with care</span>\n      <span>Brooklyn \u00b7 Est. 2014</span>\n    </div>\n  </div>\n\n  <header>\n    <nav class=\"nav wrap\" aria-label=\"Main navigation\">\n      <a class=\"brand\" href=\"#\" aria-label=\"Small Hours Press home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\u2733</span>\n        Small Hours Press\n      </a>\n      <div class=\"nav-links\">\n        <a href=\"#books\">Books</a>\n        <a href=\"#about\">About</a>\n        <a href=\"#newsletter\">Notes from us</a>\n        <a class=\"subscribe-link\" href=\"#newsletter\">Stay in the loop \u2197</a>\n      </div>\n    </nav>\n  </header>\n\n  <main>\n    <section class=\"hero wrap\">\n      <div>\n        <div class=\"eyebrow\">A little room for poetry</div>\n        <h1>For the hours<br>that <em>stay</em> with you.</h1>\n        <p class=\"hero-copy\">\n          We publish poems that make a home in the mind: tender, unruly,\n          and alive to the strange beauty of being here.\n        </p>\n        <a class=\"button\" href=\"#books\">Meet our books <span>\u2192</span></a>\n      </div>\n\n      <div class=\"hero-art\" aria-label=\"Featured poetry book, The Shape of Listening\">\n        <div class=\"sun\" aria-hidden=\"true\"></div>\n        <div class=\"book\">\n          <div class=\"book-small\">Small Hours Press \u00b7 Poetry</div>\n          <div class=\"book-title\">The Shape<br>of <em>Listening</em></div>\n          <div>\n            <div class=\"book-rule\"></div>\n            <div class=\"book-author\">Mara Bell</div>\n          </div>\n        </div>\n        <div class=\"art-caption\">Our spring title, 2025</div>\n      </div>\n    </section>\n\n    <div class=\"ticker\" aria-label=\"Our publishing values\">\n      <div class=\"ticker-inner wrap\">\n        <span>Small books, wide worlds</span>\n        <span>Words worth keeping</span>\n        <span>Made slowly, read closely</span>\n        <span>Small books, wide worlds</span>\n      </div>\n    </div>\n\n    <section class=\"section wrap\" id=\"books\">\n      <div class=\"section-heading\">\n        <div>\n          <div class=\"eyebrow\">From our shelves</div>\n          <h2>Poems to keep<br>within reach.</h2>\n        </div>\n        <a class=\"text-link\" href=\"#newsletter\">See all titles \u2197</a>\n      </div>\n\n      <div class=\"books-grid\">\n        <article class=\"book-card\">\n          <div class=\"cover cover-one\">\n            <div class=\"cover-label\">Small Hours \u00b7 014</div>\n            <div class=\"cover-name\">The Shape<br>of Listening</div>\n            <div class=\"cover-label\">Mara Bell</div>\n          </div>\n          <h3>The Shape of Listening</h3>\n          <p>Mara Bell &nbsp;\u00b7&nbsp; New poetry</p>\n        </article>\n\n        <article class=\"book-card\">\n          <div class=\"cover cover-two\">\n            <div class=\"cover-label\">Small Hours \u00b7 013</div>\n            <div class=\"cover-name\">A Field<br>Guide to Rain</div>\n            <div class=\"cover-label\">Jonah Reed</div>\n          </div>\n          <h3>A Field Guide to Rain</h3>\n          <p>Jonah Reed &nbsp;\u00b7&nbsp; Poems</p>\n        </article>\n\n        <article class=\"book-card\">\n          <div class=\"cover cover-three\">\n            <div class=\"cover-label\">Small Hours \u00b7 012</div>\n            <div class=\"cover-name\">What the<br>Light Keeps</div>\n            <div class=\"cover-label\">Nina Sol</div>\n          </div>\n          <h3>What the Light Keeps</h3>\n          <p>Nina Sol &nbsp;\u00b7&nbsp; Poems</p>\n        </article>\n      </div>\n    </section>\n\n    <section class=\"manifesto\" id=\"about\">\n      <div class=\"manifesto-grid wrap\">\n        <div class=\"manifesto-kicker\">A note on why we\u2019re here</div>\n        <div>\n          <blockquote>\n            \u201cA poem can make a small space feel <em>large enough</em> to live in.\u201d\n          </blockquote>\n          <p>\n            Small Hours is an independent poetry press for readers who like to\n            linger. We work with generous writers and thoughtful makers to bring\n            singular voices into the world\u2014one carefully made book at a time.\n          </p>\n          <a class=\"text-link\" href=\"#newsletter\">A little more about us \u2197</a>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"newsletter\" id=\"newsletter\">\n      <div class=\"wrap\">\n        <div class=\"eyebrow\">A letter, now and then</div>\n        <h2>Good words for your inbox.</h2>\n        <p>New books, favorite lines, and occasional notes from the press. Never noise.</p>\n        <form action=\"#\" method=\"post\">\n          <label for=\"email\" class=\"sr-only\" style=\"position:absolute;left:-9999px\">Your email address</label>\n          <input id=\"email\" type=\"email\" name=\"email\" placeholder=\"Your email address\" required>\n          <button type=\"submit\">Count me in&nbsp; \u2192</button>\n        </form>\n      </div>\n    </section>\n  </main>\n\n  <footer>\n    <div class=\"footer-row wrap\">\n      <a class=\"footer-brand\" href=\"#\">Small Hours Press</a>\n      <span>Independent by nature. Poetry by heart.</span>\n      <div class=\"footer-links\">\n        <a href=\"#books\">Books</a>\n        <a href=\"#about\">About</a>\n        <a href=\"mailto:hello@smallhourspress.com\">Contact</a>\n        <a href=\"#\">Instagram</a>\n      </div>\n      <span>\u00a9 2025 Small Hours Press</span>\n    </div>\n  </footer>\n</body>\n</html>\n"}