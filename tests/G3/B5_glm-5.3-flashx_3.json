{"brief": "B5", "model": "z-ai/glm-5.3-flashx", "i": 3, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Riverside Sexual Health Clinic \u2014 Walk-In Care, Confidential & Free</title>\n<style>\n  :root{\n    --teal:#0e6b6b;\n    --teal-dark:#0a4d4d;\n    --coral:#e8705f;\n    --cream:#faf7f2;\n    --ink:#22333b;\n    --soft:#eef4f4;\n  }\n  *{margin:0;padding:0;box-sizing:border-box;}\n  body{\n    font-family:Georgia,'Times New Roman',serif;\n    color:var(--ink);\n    background:var(--cream);\n    line-height:1.65;\n  }\n  .sans{font-family:'Helvetica Neue',Arial,sans-serif;}\n\n  /* Top bar */\n  .topbar{\n    background:var(--teal-dark);\n    color:#fff;\n    text-align:center;\n    padding:.5rem 1rem;\n    font-size:.85rem;\n    letter-spacing:.03em;\n    font-family:'Helvetica Neue',Arial,sans-serif;\n  }\n\n  /* Header */\n  header{\n    background:#fff;\n    border-bottom:3px solid var(--teal);\n    padding:1rem 5%;\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    flex-wrap:wrap;\n    gap:1rem;\n  }\n  .logo{display:flex;align-items:center;gap:.7rem;}\n  .logo-mark{\n    width:44px;height:44px;border-radius:50%;\n    background:var(--teal);\n    display:flex;align-items:center;justify-content:center;\n    color:#fff;font-weight:bold;font-size:1.3rem;\n    font-family:'Helvetica Neue',Arial,sans-serif;\n  }\n  .logo-text h1{font-size:1.25rem;color:var(--teal-dark);font-weight:normal;}\n  .logo-text span{font-size:.78rem;color:#6b7a80;font-family:'Helvetica Neue',Arial,sans-serif;letter-spacing:.08em;text-transform:uppercase;}\n  nav a{\n    text-decoration:none;\n    color:var(--ink);\n    margin-left:1.5rem;\n    font-family:'Helvetica Neue',Arial,sans-serif;\n    font-size:.95rem;\n  }\n  nav a:hover{color:var(--teal);}\n  nav .cta{\n    background:var(--coral);color:#fff;\n    padding:.55rem 1.2rem;border-radius:30px;\n  }\n  nav .cta:hover{background:#d05a49;color:#fff;}\n\n  /* Hero */\n  .hero{\n    background:linear-gradient(135deg,var(--teal) 0%,var(--teal-dark) 100%);\n    color:#fff;\n    padding:4.5rem 5%;\n    display:grid;\n    grid-template-columns:repeat(auto-fit,minmax(320px,1fr));\n    gap:3rem;\n    align-items:center;\n  }\n  .hero h2{font-size:clamp(1.8rem,4vw,2.8rem);font-weight:normal;line-height:1.2;}\n  .hero h2 em{color:#ffd9d2;font-style:italic;}\n  .hero p{margin:1.2rem 0 2rem;max-width:34rem;font-size:1.08rem;opacity:.92;}\n  .hero-badges{display:flex;gap:1rem;flex-wrap:wrap;margin-top:2rem;}\n  .badge{\n    background:rgba(255,255,255,.12);\n    border:1px solid rgba(255,255,255,.3);\n    border-radius:10px;padding:.7rem 1.1rem;\n    font-family:'Helvetica Neue',Arial,sans-serif;\n    font-size:.85rem;\n  }\n  .badge strong{display:block;font-size:1rem;}\n\n  /* Walk-in card */\n  .walkin-card{\n    background:#fff;color:var(--ink);\n    border-radius:14px;padding:2rem;\n    max-width:420px;justify-self:center;\n    box-shadow:0 20px 50px rgba(0,0,0,.25);\n    width:100%;\n  }\n  .walkin-card h3{color:var(--teal-dark);font-size:1.3rem;margin-bottom:.3rem;font-weight:normal;}\n  .walkin-card .open-now{\n    display:inline-block;background:#e2f4e6;color:#1d7a34;\n    font-family:'Helvetica Neue',Arial,sans-serif;\n    font-size:.8rem;padding:.25rem .8rem;border-radius:20px;margin-bottom:1.2rem;\n  }\n  .walkin-card ul{list-style:none;font-family:'Helvetica Neue',Arial,sans-serif;font-size:.95rem;}\n  .walkin-card li{display:flex;justify-content:space-between;padding:.5rem 0;border-bottom:1px dashed #dde5e5;}\n  .walkin-card li span:last-child{font-weight:bold;}\n  .walkin-card .address{margin-top:1rem;font-size:.9rem;color:#5a6b71;font-style:italic;}\n  .walkin-card .phone{\n    display:block;text-align:center;margin-top:1.3rem;\n    background:var(--teal);color:#fff;text-decoration:none;\n    padding:.8rem;border-radius:8px;\n    font-family:'Helvetica Neue',Arial,sans-serif;\n  }\n  .walkin-card .phone:hover{background:var(--teal-dark);}\n\n  /* Sections */\n  section{padding:4rem 5%;}\n  .section-title{text-align:center;max-width:42rem;margin:0 auto 3rem;}\n  .section-title h2{font-size:2rem;font-weight:normal;color:var(--teal-dark);}\n  .section-title p{color:#5a6b71;margin-top:.6rem;}\n\n  /* Services */\n  .services{background:#fff;}\n  .grid{\n    display:grid;\n    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));\n    gap:1.5rem;\n    max-width:1100px;margin:0 auto;\n  }\n  .card{\n    background:var(--soft);\n    border-radius:12px;padding:1.8rem;\n    border-top:4px solid var(--teal);\n    transition:transform .2s;\n  }\n  .card:hover{transform:translateY(-4px);}\n  .card .icon{font-size:1.8rem;}\n  .card h3{color:var(--teal-dark);margin:.7rem 0 .5rem;font-weight:normal;font-size:1.15rem;}\n  .card p{font-size:.93rem;color:#4a5b61;}\n\n  /* Confidential strip */\n  .confidential{\n    background:var(--ink);color:#fff;\n    text-align:center;\n    display:grid;\n    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));\n    gap:2rem;\n  }\n  .confidential .item strong{display:block;font-size:1.6rem;color:#8fd4d4;margin-bottom:.3rem;font-family:'Helvetica Neue',Arial,sans-serif;}\n  .confidential .item span{font-size:.92rem;opacity:.85;}\n\n  /* Steps */\n  .steps{background:var(--soft);}\n  .steps-list{max-width:800px;margin:0 auto;}\n  .step{display:flex;gap:1.4rem;margin-bottom:2rem;align-items:flex-start;}\n  .step-num{\n    flex-shrink:0;width:48px;height:48px;border-radius:50%;\n    background:var(--coral);color:#fff;\n    display:flex;align-items:center;justify-content:center;\n    font-family:'Helvetica Neue',Arial,sans-serif;font-size:1.2rem;font-weight:bold;\n  }\n  .step h3{font-weight:normal;color:var(--teal-dark);margin-bottom:.2rem;}\n  .step p{font-size:.95rem;color:#4a5b61;}\n\n  /* FAQ */\n  .faq{background:#fff;}\n  details{\n    max-width:760px;margin:0 auto 1rem;\n    border:1px solid #dde5e5;border-radius:10px;\n    padding:1rem 1.4rem;background:var(--cream);\n  }\n  summary{cursor:pointer;font-weight:bold;color:var(--teal-dark);font-size:1.02rem;}\n  details p{margin-top:.7rem;font-size:.95rem;color:#4a5b61;}\n\n  /* Final CTA */\n  .final{\n    background:linear-gradient(135deg,var(--teal) 0%,var(--teal-dark) 100%);\n    color:#fff;text-align:center;\n  }\n  .final h2{font-size:2rem;font-weight:normal;margin-bottom:1rem;}\n  .final p{max-width:38rem;margin:0 auto 2rem;opacity:.92;}\n  .btn-big{\n    display:inline-block;background:var(--coral);color:#fff;\n    text-decoration:none;padding:1rem 2.5rem;border-radius:40px;\n    font-family:'Helvetica Neue',Arial,sans-serif;font-size:1.05rem;\n  }\n  .btn-big:hover{background:#d05a49;}\n  .final .note{font-size:.85rem;margin-top:1.2rem;opacity:.75;font-style:italic;}\n\n  /* Footer */\n  footer{\n    background:var(--ink);color:#c8d2d5;\n    padding:2.5rem 5%;\n    font-size:.88rem;\n    font-family:'Helvetica Neue',Arial,sans-serif;\n    display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:2rem;\n  }\n  footer h4{color:#fff;margin-bottom:.6rem;font-weight:normal;}\n  footer a{color:#8fd4d4;text-decoration:none;}\n  footer a:hover{text-decoration:underline;}\n  .footer-bottom{\n    grid-column:1/-1;border-top:1px solid #3a4a50;\n    padding-top:1.2rem;text-align:center;font-size:.8rem;color:#8a999e;\n  }\n</style>\n</head>\n<body>\n\n<div class=\"topbar\">No appointment needed \u00b7 Free &amp; confidential \u00b7 Judgement-free care for everyone</div>\n\n<header>\n  <div class=\"logo\">\n    <div class=\"logo-mark\">+</div>\n    <div class=\"logo-text\">\n      <h1>Riverside Sexual Health Clinic</h1>\n      <span>Walk-in \u00b7 Confidential \u00b7 Free</span>\n    </div>\n  </div>\n  <nav class=\"sans\">\n    <a href=\"#services\">Services</a>\n    <a href=\"#visit\">Your Visit</a>\n    <a href=\"#faq\">FAQ</a>\n    <a href=\"#visit\" class=\"cta\">Plan Your Visit</a>\n  </nav>\n</header>\n\n<!-- HERO -->\n<div class=\"hero\">\n  <div>\n    <h2>Your sexual health, <em>taken seriously.</em><br>No judgement. No appointment. No cost.</h2>\n    <p>Whether you need a routine STI test, contraception, or just someone to talk to \u2014 our doors are open. Walk in, be seen, and leave with answers the same day.</p>\n    <div class=\"hero-badges sans\">\n      <div class=\"badge\"><strong>Free</strong>All core services</div>\n      <div class=\"badge\"><strong>Confidential</strong>Private records</div>\n      <div class=\"badge\"><strong>All welcome</strong>Every body, every identity</div>\n    </div>\n  </div>\n\n  <div class=\"walkin-card\">\n    <h3>Walk-In Hours</h3>\n    <span class=\"open-now sans\">\u25cf Open now \u2014 no appointment needed</span>\n    <ul>\n      <li><span>Monday \u2013 Thursday</span><span>9am \u2013 7pm</span></li>\n      <li><span>Friday</span><span>9am \u2013 5pm</span></li>\n      <li><span>Saturday</span><span>10am \u2013 2pm</span></li>\n      <li><span>Sunday</span><span>Closed</span></li>\n    </ul>\n    <p class=\"address\">142 Riverbend Avenue, Suite 3 \u2014 near Central Transit Station</p>\n    <a class=\"phone\" href=\"tel:+15550142800\">Call us: (555) 014-2800</a>\n  </div>\n</div>\n\n<!-- SERVICES -->\n<section class=\"services\" id=\"services\">\n  <div class=\"section-title\">\n    <h2>What we offer</h2>\n    <p>Comprehensive sexual health care under one roof \u2014 always free and always confidential.</p>\n  </div>\n  <div class=\"grid\">\n    <div class=\"card\">\n      <div class=\"icon\">\ud83e\uddea</div>\n      <h3>STI &amp; HIV Testing</h3>\n      <p>Rapid HIV results in 20 minutes. Full STI screens with same-week results, sent discreetly by your preferred contact method.</p>\n    </div>\n    <div class=\"card\">\n      <div class=\"icon\">\ud83d\udc8a</div>\n      <h3>Contraception</h3>\n      <p>Pills, implants, IUDs, injections, and emergency contraception \u2014 with honest counselling to help you choose what's right for you.</p>\n    </div>\n    <div class=\"card\">\n      <div class=\"icon\">\ud83d\udee1\ufe0f</div>\n      <h3>PrEP &amp; PEP</h3>\n      <p>HIV prevention medication, started the same day you walk in. Ongoing monitoring and free supply for eligible patients.</p>\n    </div>\n    <div class=\"card\">\n      <div class=\"icon\">\ud83d\udc89</div>\n      <h3>Vaccinations</h3>\n      <p>HPV and hepatitis A &amp; B vaccines available on-site for all eligible ages.</p>\n    </div>\n    <div class=\"card\">\n      <div class=\"icon\">\ud83e\ude7a</div>\n      <h3>Treatment &amp; Care</h3>\n      <p>If something comes back positive, we treat it \u2014 most infections are cured same day, and we'll support you through partner notification if you'd like help.</p>\n    </div>\n    <div class=\"card\">\n      <div class=\"icon\">\ud83d\udcac</div>\n      <h3>Counselling &amp; Advice</h3>\n      <p>Questions about sex, relationships, or your body? Our nurses offer private, judgement-free conversations \u2014 no question is too awkward.</p>\n    </div>\n  </div>\n</section>\n\n<!-- CONFIDENTIAL STRIP -->\n<section class=\"confidential\">\n  <div class=\"item\"><strong>100%</strong><span>Confidential \u2014 records never shared without your consent</span></div>\n  <div class=\"item\"><strong>$0</strong><span>No cost for testing, treatment, or contraception</span></div>\n  <div class=\"item\"><strong>&lt;45 min</strong><span>Average wait time from door to consultation</span></div>\n  <div class=\"item\"><strong>Every identity</strong><span>LGBTQ+ affirming, interpreter services available</span></div>\n</section>\n\n<!-- YOUR VISIT -->\n<section class=\"steps\" id=\"visit\">\n  <div class=\"section-title\">\n    <h2>Your visit, step by step</h2>\n    <p>No paperwork nightmares, no awkward waiting rooms. Here's exactly what to expect.</p>\n  </div>\n  <div class=\"steps-list\">\n    <div class=\"step\">\n      <div class=\"step-num\">1</div>\n      <div>\n        <h3>Walk in &amp; check in</h3>\n        <p>Give a first name and a contact method \u2014 that's all we need. ID and insurance are never required.</p>\n      </div>\n    </div>\n    <div class=\"step\">\n      <div class=\"step-num\">2</div>\n      <div>\n        <h3>Quick private chat</h3>\n        <p>A nurse will take you to a private room to talk about what brought you in and what tests make sense.</p>\n      </div>\n    </div>\n    <div class=\"step\">\n      <div class=\"step-num\">3</div>\n      <div>\n        <h3>Testing, done comfortably</h3>\n        <p>Most tests are simple swabs or a small blood sample. Rapid HIV results while you wait.</p>\n      </div>\n    </div>\n    <div class=\"step\">\n      <div class=\"step-num\">4</div>\n      <div>\n        <h3>Results &amp; next steps</h3>\n        <p>Treatment on the spot if needed, and a clear plan before you leave. We'll follow up discreetly if you choose.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- FAQ -->\n<section class=\"faq\" id=\"faq\">\n  <div class=\"section-title\">\n    <h2>Common questions</h2>\n  </div>\n  <details>\n    <summary>Do I really not need an appointment?</summary>\n    <p>Correct \u2014 just walk in during opening hours. Busy periods (weekday evenings) may mean a short wait, but you'll always be seen.</p>\n  </details>\n  <details>\n    <summary>Will anyone find out I was here?</summary>\n    <p>No. Your records are confidential and we will never contact you without permission. We can even communicate only through a code word or a discreet text if you prefer.</p>\n  </details>\n  <details>\n    <summary>How old do I have to be?</summary>\n    <p>We serve people of all ages. In most regions, sexual health services are available confidentially to young people \u2014 our staff can explain exactly how privacy works for you.</p>\n  </details>\n  <details>\n    <summary>Do I need insurance or ID?</summary>\n    <p>No. All our core services are completely free, and you can use any name you're comfortable with.</p>\n  </details>\n  <details>\n    <summary>How long do results take?</summary>\n    <p>Rapid HIV tests: about 20 minutes. Full STI panels: usually 3\u20135 days, delivered by your chosen contact method.</p>\n  </details>\n</section>\n\n<!-- FINAL CTA -->\n<section class=\"final\">\n  <h2>The hardest part is walking through the door.<br>We'll take care of the rest.</h2>\n  <p>Testing is quick, treatment is free, and you'll be treated with respect from the moment you arrive.</p>\n  <a class=\"btn-big\" href=\"#visit\">Get directions &amp; hours</a>\n  <p class=\"note\">In a urgent situation? Call (555) 014-2800 \u2014 a nurse is available 24/7 for urgent advice.</p>\n</section>\n\n<footer>\n  <div>\n    <h4>Visit us</h4>\n    142 Riverbend Avenue, Suite 3<br>\n    Mon\u2013Thu 9\u20137 \u00b7 Fri 9\u20135 \u00b7 Sat 10\u20132<br>\n    Wheelchair accessible\n  </div>\n  <div>\n    <h4>Contact</h4>\n    <a href=\"tel:+15550142800\">(555) 014-2800</a><br>\n    <a href=\"mailto:hello@riversidesh.example\">hello@riversidesh.example</a><br>\n    24/7 nurse advice line\n  </div>\n  <div>\n    <h4>Accessibility</h4>\n    Interpretation services in 12+ languages<br>\n    Step-free entrance &amp; accessible restrooms<br>\n    Service animals welcome\n  </div>\n  <div class=\"footer-bottom\">\n    Riverside Sexual Health Clinic is a community health service. This page is for general information and is not a substitute for medical advice. In an emergency, call your local emergency number.\n  </div>\n</footer>\n\n</body>\n</html>\n"}