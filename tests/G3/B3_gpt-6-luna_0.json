{"brief": "B3", "model": "openai/gpt-6-luna", "i": 0, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <meta name=\"description\" content=\"Kiln is the open-source analytical database built for data engineers.\">\n  <title>Kiln \u2014 Open-source analytics database</title>\n  <style>\n    :root {\n      color-scheme: dark;\n      --bg: #101311;\n      --surface: #171b18;\n      --surface-raised: #1d231f;\n      --line: #2a322d;\n      --text: #f0f3ed;\n      --muted: #a0aaa1;\n      --lime: #c4f46a;\n      --lime-dark: #9fd64a;\n      --mono: \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace;\n      --sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n    }\n\n    * { box-sizing: border-box; }\n\n    html { scroll-behavior: smooth; }\n\n    body {\n      margin: 0;\n      background: var(--bg);\n      color: var(--text);\n      font-family: var(--sans);\n      -webkit-font-smoothing: antialiased;\n    }\n\n    a { color: inherit; text-decoration: none; }\n\n    .container {\n      width: min(1160px, calc(100% - 48px));\n      margin: 0 auto;\n    }\n\n    .site-header {\n      height: 76px;\n      border-bottom: 1px solid rgba(255,255,255,.07);\n      display: flex;\n      align-items: center;\n    }\n\n    .nav {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 28px;\n    }\n\n    .brand {\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      font-weight: 700;\n      letter-spacing: -.04em;\n      font-size: 21px;\n    }\n\n    .brand-mark {\n      width: 28px;\n      height: 28px;\n      color: var(--lime);\n      display: grid;\n      place-items: center;\n    }\n\n    .nav-links {\n      display: flex;\n      align-items: center;\n      gap: 30px;\n      color: #b5beb6;\n      font-size: 13px;\n    }\n\n    .nav-links a:hover { color: var(--text); }\n\n    .nav-actions {\n      display: flex;\n      align-items: center;\n      gap: 14px;\n    }\n\n    .github-link {\n      display: inline-flex;\n      align-items: center;\n      gap: 7px;\n      font-size: 13px;\n      color: #c4ccc4;\n    }\n\n    .button {\n      min-height: 42px;\n      padding: 0 17px;\n      border-radius: 7px;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: 9px;\n      font-size: 13px;\n      font-weight: 650;\n      transition: transform .18s ease, background .18s ease, border-color .18s ease;\n    }\n\n    .button:hover { transform: translateY(-1px); }\n\n    .button-primary {\n      background: var(--lime);\n      color: #17200f;\n    }\n\n    .button-primary:hover { background: #d4ff83; }\n\n    .button-secondary {\n      border: 1px solid #3a443d;\n      color: var(--text);\n      background: rgba(255,255,255,.02);\n    }\n\n    .button-secondary:hover { border-color: #637066; }\n\n    .hero {\n      padding: 86px 0 93px;\n      overflow: hidden;\n      position: relative;\n    }\n\n    .hero::before {\n      content: \"\";\n      position: absolute;\n      width: 700px;\n      height: 560px;\n      right: -140px;\n      top: -180px;\n      background: radial-gradient(ellipse, rgba(145, 190, 79, .09), transparent 67%);\n      pointer-events: none;\n    }\n\n    .hero-grid {\n      display: grid;\n      grid-template-columns: .93fr 1.07fr;\n      align-items: center;\n      gap: 64px;\n      position: relative;\n    }\n\n    .eyebrow {\n      display: inline-flex;\n      align-items: center;\n      gap: 9px;\n      color: var(--lime);\n      text-transform: uppercase;\n      letter-spacing: .12em;\n      font-size: 10px;\n      font-weight: 700;\n    }\n\n    .eyebrow-dot {\n      width: 7px;\n      height: 7px;\n      border-radius: 50%;\n      background: var(--lime);\n      box-shadow: 0 0 12px rgba(196,244,106,.55);\n    }\n\n    h1 {\n      max-width: 540px;\n      margin: 22px 0 20px;\n      font-size: clamp(48px, 6vw, 72px);\n      line-height: .99;\n      letter-spacing: -.065em;\n      font-weight: 620;\n    }\n\n    h1 span { color: var(--lime); }\n\n    .hero-copy {\n      max-width: 475px;\n      color: #aab4ab;\n      font-size: 16px;\n      line-height: 1.75;\n      margin: 0;\n    }\n\n    .hero-buttons {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 11px;\n      margin-top: 30px;\n    }\n\n    .install-line {\n      margin-top: 20px;\n      color: #738076;\n      font-family: var(--mono);\n      font-size: 11px;\n      display: flex;\n      align-items: center;\n      gap: 9px;\n    }\n\n    .install-line code { color: #c5cec5; }\n\n    .terminal {\n      border: 1px solid #303a33;\n      border-radius: 12px;\n      background: #141815;\n      box-shadow: 0 32px 90px rgba(0,0,0,.4), 0 0 0 1px rgba(255,255,255,.015) inset;\n      overflow: hidden;\n      transform: perspective(1100px) rotateY(-3deg) rotateX(1deg);\n    }\n\n    .terminal-top {\n      height: 46px;\n      padding: 0 17px;\n      border-bottom: 1px solid #2a322d;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      background: #191e1a;\n    }\n\n    .window-controls { display: flex; gap: 6px; }\n\n    .window-controls i {\n      width: 7px;\n      height: 7px;\n      border-radius: 50%;\n      background: #4a554c;\n    }\n\n    .window-controls i:first-child { background: #8b6258; }\n    .window-controls i:nth-child(2) { background: #938253; }\n    .window-controls i:nth-child(3) { background: #63805c; }\n\n    .terminal-label {\n      color: #8b978d;\n      font-family: var(--mono);\n      font-size: 10px;\n      letter-spacing: .02em;\n    }\n\n    .live-pill {\n      color: var(--lime);\n      font-size: 9px;\n      font-family: var(--mono);\n      display: flex;\n      align-items: center;\n      gap: 6px;\n    }\n\n    .live-pill::before {\n      content: \"\";\n      width: 5px;\n      height: 5px;\n      border-radius: 50%;\n      background: var(--lime);\n    }\n\n    .query-area {\n      padding: 22px 22px 19px;\n      font-family: var(--mono);\n      font-size: 11px;\n      line-height: 1.9;\n      color: #b8c2b9;\n      min-height: 190px;\n    }\n\n    .line-no {\n      display: inline-block;\n      width: 24px;\n      color: #536056;\n      user-select: none;\n    }\n\n    .sql-key { color: #c7ee79; }\n    .sql-fn { color: #8bd7c0; }\n    .sql-string { color: #e5b987; }\n    .sql-comment { color: #637168; }\n\n    .run-row {\n      border-top: 1px solid #28312b;\n      padding: 11px 22px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      color: #8d9a90;\n      font: 10px var(--mono);\n    }\n\n    .run-status {\n      display: inline-flex;\n      align-items: center;\n      gap: 7px;\n      color: #c2d0c3;\n    }\n\n    .run-status strong { color: var(--lime); font-weight: 500; }\n\n    .result {\n      background: #171c18;\n      border-top: 1px solid #28312b;\n      padding: 17px 22px 20px;\n    }\n\n    .result-head {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      margin-bottom: 18px;\n    }\n\n    .result-title {\n      font-size: 10px;\n      color: #d3dbd2;\n      font-family: var(--mono);\n    }\n\n    .result-meta {\n      color: #78847a;\n      font: 9px var(--mono);\n    }\n\n    .chart {\n      height: 87px;\n      display: flex;\n      align-items: end;\n      gap: 8px;\n      position: relative;\n      padding: 0 2px;\n      background: repeating-linear-gradient(to bottom, transparent 0 21px, rgba(255,255,255,.045) 22px);\n    }\n\n    .bar {\n      flex: 1;\n      background: linear-gradient(180deg, #b9eb68, #6a9d3e);\n      border-radius: 3px 3px 0 0;\n      opacity: .84;\n      min-width: 5px;\n    }\n\n    .chart-labels {\n      display: flex;\n      justify-content: space-between;\n      color: #68746b;\n      font: 8px var(--mono);\n      padding-top: 8px;\n    }\n\n    .trust-strip {\n      border-top: 1px solid rgba(255,255,255,.07);\n      border-bottom: 1px solid rgba(255,255,255,.07);\n      padding: 21px 0;\n    }\n\n    .trust-inner {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 24px;\n    }\n\n    .trust-label {\n      color: #778279;\n      text-transform: uppercase;\n      letter-spacing: .1em;\n      font-size: 9px;\n      font-weight: 700;\n      white-space: nowrap;\n    }\n\n    .trust-items {\n      display: flex;\n      align-items: center;\n      justify-content: space-around;\n      gap: 36px;\n      flex: 1;\n      color: #8f9a90;\n      font-size: 13px;\n      font-weight: 600;\n      letter-spacing: -.02em;\n    }\n\n    .trust-items span { opacity: .82; }\n\n    .section {\n      padding: 102px 0;\n    }\n\n    .section-heading {\n      max-width: 640px;\n      margin-bottom: 45px;\n    }\n\n    .section-heading h2 {\n      margin: 15px 0 14px;\n      font-size: clamp(34px, 4vw, 48px);\n      line-height: 1.08;\n      letter-spacing: -.055em;\n      font-weight: 580;\n    }\n\n    .section-heading p {\n      color: var(--muted);\n      font-size: 15px;\n      line-height: 1.7;\n      max-width: 560px;\n      margin: 0;\n    }\n\n    .features {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 14px;\n    }\n\n    .feature-card {\n      min-height: 224px;\n      padding: 25px 24px;\n      border: 1px solid var(--line);\n      border-radius: 9px;\n      background: linear-gradient(145deg, rgba(255,255,255,.025), rgba(255,255,255,.005));\n    }\n\n    .feature-icon {\n      width: 37px;\n      height: 37px;\n      display: grid;\n      place-items: center;\n      border: 1px solid #39463b;\n      border-radius: 8px;\n      color: var(--lime);\n      margin-bottom: 23px;\n    }\n\n    .feature-card h3 {\n      margin: 0 0 9px;\n      font-size: 15px;\n      letter-spacing: -.02em;\n      font-weight: 620;\n    }\n\n    .feature-card p {\n      color: #98a39a;\n      font-size: 12px;\n      line-height: 1.7;\n      margin: 0;\n    }\n\n    .code-section {\n      background: #151a16;\n      border-top: 1px solid rgba(255,255,255,.06);\n      border-bottom: 1px solid rgba(255,255,255,.06);\n    }\n\n    .code-grid {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      align-items: center;\n      gap: 70px;\n    }\n\n    .code-grid .section-heading { margin: 0; }\n\n    .code-grid .section-heading h2 { max-width: 460px; }\n\n    .code-card {\n      border: 1px solid #303a33;\n      border-radius: 9px;\n      overflow: hidden;\n      background: #101411;\n    }\n\n    .code-card-top {\n      height: 43px;\n      padding: 0 16px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      color: #8c988e;\n      border-bottom: 1px solid #29322b;\n      font: 10px var(--mono);\n    }\n\n    .code-card pre {\n      margin: 0;\n      padding: 21px 20px;\n      overflow: auto;\n      color: #c6d0c7;\n      font: 11px/1.9 var(--mono);\n    }\n\n    .code-card .prompt { color: var(--lime); }\n    .code-card .comment { color: #67746a; }\n    .code-card .value { color: #e9bf8f; }\n    .code-card .keyword { color: #9bd8c2; }\n\n    .open-source {\n      text-align: center;\n      padding: 89px 0 92px;\n    }\n\n    .open-source .eyebrow { justify-content: center; }\n\n    .open-source h2 {\n      margin: 16px auto 14px;\n      max-width: 700px;\n      font-size: clamp(36px, 5vw, 56px);\n      line-height: 1.05;\n      letter-spacing: -.06em;\n      font-weight: 580;\n    }\n\n    .open-source p {\n      color: var(--muted);\n      max-width: 510px;\n      margin: 0 auto;\n      font-size: 14px;\n      line-height: 1.7;\n    }\n\n    .open-source .hero-buttons { justify-content: center; }\n\n    .site-footer {\n      border-top: 1px solid rgba(255,255,255,.08);\n      padding: 23px 0;\n      color: #778279;\n      font-size: 11px;\n    }\n\n    .footer-inner {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 20px;\n    }\n\n    .footer-brand {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      color: #c1cbc1;\n      font-weight: 650;\n    }\n\n    .footer-links {\n      display: flex;\n      gap: 22px;\n    }\n\n    .footer-links a:hover { color: var(--text); }\n\n    @media (max-width: 900px) {\n      .hero-grid { gap: 38px; }\n      .trust-items { gap: 18px; }\n      .code-grid { gap: 38px; }\n    }\n\n    @media (max-width: 720px) {\n      .container { width: min(100% - 36px, 540px); }\n      .site-header { height: 66px; }\n      .nav-links, .github-link { display: none; }\n      .nav-actions .button { min-height: 38px; padding: 0 12px; }\n      .hero { padding: 62px 0 65px; }\n      .hero-grid, .code-grid { grid-template-columns: 1fr; }\n      .hero-grid { gap: 42px; }\n      .terminal { transform: none; }\n      .hero-copy { font-size: 15px; }\n      .trust-inner { align-items: flex-start; flex-direction: column; }\n      .trust-items { width: 100%; flex-wrap: wrap; justify-content: space-between; }\n      .section { padding: 72px 0; }\n      .features { grid-template-columns: 1fr; }\n      .feature-card { min-height: auto; }\n      .feature-icon { margin-bottom: 17px; }\n      .code-grid { gap: 32px; }\n      .open-source { padding: 72px 0; }\n      .footer-inner { align-items: flex-start; flex-direction: column; }\n      .footer-links { flex-wrap: wrap; gap: 15px; }\n    }\n\n    @media (max-width: 420px) {\n      h1 { font-size: 48px; }\n      .hero-buttons .button { flex: 1; }\n      .query-area { padding: 17px 13px; font-size: 9px; }\n      .result { padding-left: 14px; padding-right: 14px; }\n      .trust-items { font-size: 11px; }\n    }\n  </style>\n</head>\n<body>\n  <header class=\"site-header\">\n    <div class=\"container nav\">\n      <a class=\"brand\" href=\"#\" aria-label=\"Kiln home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg width=\"28\" height=\"28\" viewBox=\"0 0 28 28\" fill=\"none\">\n            <path d=\"M14 2.8 24 8.4v11.2L14 25.2 4 19.6V8.4L14 2.8Z\" stroke=\"currentColor\" stroke-width=\"1.7\"/>\n            <path d=\"M9 17.5V10.5M19 10.5 13 14l6 3.5\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          </svg>\n        </span>\n        kiln\n      </a>\n\n      <nav class=\"nav-links\" aria-label=\"Main navigation\">\n        <a href=\"#features\">Why Kiln</a>\n        <a href=\"#workflow\">How it works</a>\n        <a href=\"#community\">Community</a>\n        <a href=\"#docs\">Docs</a>\n      </nav>\n\n      <div class=\"nav-actions\">\n        <a class=\"github-link\" href=\"#community\" aria-label=\"View Kiln on GitHub\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\">\n            <path d=\"M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.53v-2.08c-3.1.67-3.75-1.32-3.75-1.32-.5-1.29-1.23-1.63-1.23-1.63-1.01-.69.08-.68.08-.68 1.12.08 1.7 1.15 1.7 1.15.99 1.69 2.59 1.2 3.22.92.1-.72.39-1.2.7-1.47-2.47-.28-5.06-1.23-5.06-5.5 0-1.22.44-2.21 1.15-2.99-.12-.28-.5-1.42.11-2.95 0 0 .94-.3 3.06 1.14a10.7 10.7 0 0 1 5.57 0c2.12-1.44 3.05-1.14 3.05-1.14.61 1.53.23 2.67.12 2.95.71.78 1.14 1.77 1.14 2.99 0 4.28-2.6 5.22-5.08 5.49.4.35.75 1.02.75 2.06V22c0 .29.2.63.76.53A11.1 11.1 0 0 0 12 .9Z\"/>\n          </svg>\n          GitHub\n        </a>\n        <a class=\"button button-primary\" href=\"#docs\">Get started <span aria-hidden=\"true\">\u2197</span></a>\n      </div>\n    </div>\n  </header>\n\n  <main>\n    <section class=\"hero\">\n      <div class=\"container hero-grid\">\n        <div>\n          <div class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> Open-source analytics database</div>\n          <h1>Make your data work <span>harder.</span></h1>\n          <p class=\"hero-copy\">\n            Kiln is the fast, open-source analytical database built for data engineers.\n            Turn raw events into reliable answers\u2014with the tools and control you already trust.\n          </p>\n          <div class=\"hero-buttons\">\n            <a class=\"button button-primary\" href=\"#docs\">Start building <span aria-hidden=\"true\">\u2192</span></a>\n            <a class=\"button button-secondary\" href=\"#workflow\">Explore the engine</a>\n          </div>\n          <div class=\"install-line\">\n            <span aria-hidden=\"true\">\u203a</span>\n            <code>docker run kiln/kiln:latest</code>\n            <span>\u00b7</span>\n            <span>MIT licensed</span>\n          </div>\n        </div>\n\n        <div class=\"terminal\" aria-label=\"Kiln SQL query and analytics preview\">\n          <div class=\"terminal-top\">\n            <div class=\"window-controls\" aria-hidden=\"true\"><i></i><i></i><i></i></div>\n            <div class=\"terminal-label\">analytics.sql</div>\n            <div class=\"live-pill\">LIVE</div>\n          </div>\n          <div class=\"query-area\">\n            <div><span class=\"line-no\">01</span><span class=\"sql-comment\">-- events, at the speed of thought</span></div>\n            <div><span class=\"line-no\">02</span><span class=\"sql-key\">SELECT</span> date_trunc(<span class=\"sql-string\">'hour'</span>, created_at) <span class=\"sql-key\">AS</span> hour,</div>\n            <div><span class=\"line-no\">03</span>       <span class=\"sql-fn\">countIf</span>(event = <span class=\"sql-string\">'signup'</span>) <span class=\"sql-key\">AS</span> signups</div>\n            <div><span class=\"line-no\">04</span><span class=\"sql-key\">FROM</span> product_events</div>\n            <div><span class=\"line-no\">05</span><span class=\"sql-key\">WHERE</span> created_at &gt; now() - <span class=\"sql-key\">INTERVAL</span> <span class=\"sql-string\">\"7 days\"</span></div>\n            <div><span class=\"line-no\">06</span><span class=\"sql-key\">GROUP BY</span> hour <span class=\"sql-key\">ORDER BY</span> hour;</div>\n          </div>\n          <div class=\"run-row\">\n            <span class=\"run-status\"><strong>\u2713</strong> Query complete</span>\n            <span>184 ms&nbsp;&nbsp;\u00b7&nbsp;&nbsp;2.4M rows scanned</span>\n          </div>\n          <div class=\"result\">\n            <div class=\"result-head\">\n              <span class=\"result-title\">signups \u00b7 last 7 days</span>\n              <span class=\"result-meta\">1,248,903 rows</span>\n            </div>\n            <div class=\"chart\" aria-hidden=\"true\">\n              <span class=\"bar\" style=\"height:28%\"></span>\n              <span class=\"bar\" style=\"height:41%\"></span>\n              <span class=\"bar\" style=\"height:35%\"></span>\n              <span class=\"bar\" style=\"height:55%\"></span>\n              <span class=\"bar\" style=\"height:47%\"></span>\n              <span class=\"bar\" style=\"height:62%\"></span>\n              <span class=\"bar\" style=\"height:52%\"></span>\n              <span class=\"bar\" style=\"height:70%\"></span>\n              <span class=\"bar\" style=\"height:57%\"></span>\n              <span class=\"bar\" style=\"height:77%\"></span>\n              <span class=\"bar\" style=\"height:64%\"></span>\n              <span class=\"bar\" style=\"height:88%\"></span>\n              <span class=\"bar\" style=\"height:72%\"></span>\n              <span class=\"bar\" style=\"height:95%\"></span>\n              <span class=\"bar\" style=\"height:81%\"></span>\n              <span class=\"bar\" style=\"height:100%\"></span>\n            </div>\n            <div class=\"chart-labels\"><span>MON</span><span>TUE</span><span>WED</span><span>THU</span><span>FRI</span><span>SAT</span><span>SUN</span></div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"trust-strip\" aria-label=\"Built for your data stack\">\n      <div class=\"container trust-inner\">\n        <div class=\"trust-label\">Fits right into your stack</div>\n        <div class=\"trust-items\">\n          <span>dbt</span>\n          <span>Apache Kafka</span>\n          <span>Airbyte</span>\n          <span>Python</span>\n          <span>PostgreSQL</span>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section\" id=\"features\">\n      <div class=\"container\">\n        <div class=\"section-heading\">\n          <div class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> Built for the real world</div>\n          <h2>Less plumbing. More signal.</h2>\n          <p>Keep your workflows familiar and your architecture yours. Kiln gives your team a powerful analytical core without adding another black box.</p>\n        </div>\n\n        <div class=\"features\">\n          <article class=\"feature-card\">\n            <div class=\"feature-icon\" aria-hidden=\"true\">\n              <svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M4 18V6m0 12h16M8 15l3-4 3 2 5-7\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            </div>\n            <h3>Fast where it counts</h3>\n            <p>Columnar execution and smart data skipping keep analytical queries snappy\u2014even as your event volume grows.</p>\n          </article>\n\n          <article class=\"feature-card\">\n            <div class=\"feature-icon\" aria-hidden=\"true\">\n              <svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 3v4m0 10v4M3 12h4m10 0h4M5.64 5.64l2.83 2.83m7.06 7.06 2.83 2.83m0-12.72-2.83 2.83m-7.06 7.06-2.83 2.83\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/><circle cx=\"12\" cy=\"12\" r=\"3\" stroke=\"currentColor\" stroke-width=\"1.6\"/></svg>\n            </div>\n            <h3>SQL you already know</h3>\n            <p>Write expressive SQL, connect familiar tools, and get from raw tables to useful answers with less ceremony.</p>\n          </article>\n\n          <article class=\"feature-card\">\n            <div class=\"feature-icon\" aria-hidden=\"true\">\n              <svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 3 4.5 7v5.5c0 4.2 3.2 7.1 7.5 8.5 4.3-1.4 7.5-4.3 7.5-8.5V7L12 3Z\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"/><path d=\"m9 12 2 2 4-4\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            </div>\n            <h3>Your infrastructure, your rules</h3>\n            <p>Run it where you need it: on your laptop, in your cloud, or alongside the rest of your data platform.</p>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section code-section\" id=\"workflow\">\n      <div class=\"container code-grid\">\n        <div class=\"section-heading\">\n          <div class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> A smaller learning curve</div>\n          <h2>From first query to production pipeline.</h2>\n          <p>Spin up a local instance, load a dataset, and start exploring. Kiln is designed to make the path from experimentation to production feel natural.</p>\n          <div class=\"hero-buttons\">\n            <a class=\"button button-secondary\" href=\"#docs\">Read the quickstart <span aria-hidden=\"true\">\u2192</span></a>\n          </div>\n        </div>\n\n        <div class=\"code-card\" aria-label=\"Example command line setup\">\n          <div class=\"code-card-top\">\n            <span>terminal</span>\n            <span>quickstart.sh</span>\n          </div>\n          <pre><span class=\"comment\"># Start Kiln locally</span>\n<span class=\"prompt\">$</span> docker run -p 8080:8080 kiln/kiln\n\n<span class=\"comment\"># Load a sample dataset</span>\n<span class=\"prompt\">$</span> kiln ingest ./events.parquet\n\n<span class=\"comment\"># Ask your data a question</span>\n<span class=\"prompt\">$</span> kiln query <span class=\"value\">\"SELECT count(*) FROM events\"</span>\n<span class=\"keyword\">\u2514\u2500</span> 18,420,391 rows \u00b7 92 ms</pre>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"open-source\" id=\"community\">\n      <div class=\"container\">\n        <div class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> Open by design</div>\n        <h2>Built in the open.<br>Better together.</h2>\n        <p>Kiln is shaped by the people building with it. Read the code, share what you\u2019re working on, and help make data infrastructure a little less complicated.</p>\n        <div class=\"hero-buttons\">\n          <a class=\"button button-primary\" href=\"#github\">Explore on GitHub <span aria-hidden=\"true\">\u2197</span></a>\n          <a class=\"button button-secondary\" href=\"#docs\">Read the docs</a>\n        </div>\n      </div>\n    </section>\n  </main>\n\n  <footer class=\"site-footer\" id=\"docs\">\n    <div class=\"container footer-inner\">\n      <div class=\"footer-brand\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 28 28\" fill=\"none\"><path d=\"M14 2.8 24 8.4v11.2L14 25.2 4 19.6V8.4L14 2.8Z\" stroke=\"currentColor\" stroke-width=\"1.7\"/><path d=\"M9 17.5V10.5M19 10.5 13 14l6 3.5\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n        </span>\n        kiln <span style=\"font-weight:400;color:#758078;\">\u00b7 Open-source analytics</span>\n      </div>\n      <div class=\"footer-links\">\n        <a href=\"#docs\">Documentation</a>\n        <a href=\"#community\" id=\"github\">GitHub</a>\n        <a href=\"#features\">License</a>\n        <span>\u00a9 2025 Kiln contributors</span>\n      </div>\n    </div>\n  </footer>\n</body>\n</html>\n"}