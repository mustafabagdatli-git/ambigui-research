{"brief": "B5", "model": "anthropic/claude-haiku-5.5", "i": 4, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Riverside Sexual Health Walk-In Clinic | Confidential Testing, No Appointment Needed</title>\n  <meta name=\"description\" content=\"Walk in for confidential sexual health testing, contraception, PrEP, and treatment. No appointment needed. Judgment-free care.\">\n  <style>\n    :root {\n      --teal-900: #0b3b3c;\n      --teal-700: #14625f;\n      --teal-500: #2a9d8f;\n      --teal-100: #d9efec;\n      --teal-50:  #eef8f6;\n      --coral:    #e76f51;\n      --coral-dark:#c75a3d;\n      --ink:      #1d2b2a;\n      --muted:    #566b69;\n      --line:     #d6e3e1;\n      --white:    #ffffff;\n      --radius:   14px;\n      --shadow:   0 10px 30px rgba(11, 59, 60, 0.10);\n    }\n\n    *, *::before, *::after { box-sizing: border-box; }\n\n    html { scroll-behavior: smooth; }\n\n    body {\n      margin: 0;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n      color: var(--ink);\n      background: var(--white);\n      line-height: 1.6;\n      font-size: 17px;\n    }\n\n    img, svg { display: block; max-width: 100%; }\n\n    a { color: var(--teal-700); }\n    a:focus-visible, button:focus-visible, summary:focus-visible {\n      outline: 3px solid var(--coral);\n      outline-offset: 3px;\n      border-radius: 4px;\n    }\n\n    .container {\n      width: min(1120px, 92%);\n      margin-inline: auto;\n    }\n\n    h1, h2, h3 {\n      line-height: 1.2;\n      color: var(--teal-900);\n      margin: 0 0 0.5em;\n    }\n    h1 { font-size: clamp(2.2rem, 5vw, 3.5rem); letter-spacing: -0.02em; }\n    h2 { font-size: clamp(1.7rem, 3.2vw, 2.4rem); letter-spacing: -0.01em; }\n    h3 { font-size: 1.2rem; }\n\n    p { margin: 0 0 1em; }\n\n    .eyebrow {\n      display: inline-block;\n      font-size: 0.8rem;\n      font-weight: 700;\n      letter-spacing: 0.12em;\n      text-transform: uppercase;\n      color: var(--teal-700);\n      background: var(--teal-100);\n      padding: 0.35em 0.8em;\n      border-radius: 999px;\n      margin-bottom: 1rem;\n    }\n\n    .section { padding: clamp(3.5rem, 8vw, 6rem) 0; }\n    .section-alt { background: var(--teal-50); }\n\n    .section-head {\n      max-width: 680px;\n      margin-bottom: 2.5rem;\n    }\n    .section-head p { color: var(--muted); font-size: 1.05rem; }\n\n    /* Buttons */\n    .btn {\n      display: inline-flex;\n      align-items: center;\n      gap: 0.5rem;\n      font: inherit;\n      font-weight: 700;\n      text-decoration: none;\n      border: 2px solid transparent;\n      border-radius: 999px;\n      padding: 0.85em 1.6em;\n      cursor: pointer;\n      transition: transform 0.15s ease, background 0.2s ease, color 0.2s ease;\n      white-space: nowrap;\n    }\n    .btn:hover { transform: translateY(-1px); }\n    .btn-primary { background: var(--coral); color: var(--white); }\n    .btn-primary:hover { background: var(--coral-dark); }\n    .btn-outline { background: transparent; color: var(--teal-700); border-color: var(--teal-700); }\n    .btn-outline:hover { background: var(--teal-700); color: var(--white); }\n    .btn-light { background: var(--white); color: var(--teal-900); }\n    .btn-light:hover { background: var(--teal-100); }\n    .btn svg { width: 18px; height: 18px; flex: none; }\n\n    /* Top utility bar */\n    .utility-bar {\n      background: var(--teal-900);\n      color: #cfe9e6;\n      font-size: 0.85rem;\n      padding: 0.5rem 0;\n    }\n    .utility-bar .container {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      gap: 1rem;\n      flex-wrap: wrap;\n    }\n    .utility-bar a { color: var(--white); text-decoration: none; font-weight: 600; }\n    .utility-bar a:hover { text-decoration: underline; }\n\n    /* Header */\n    header.site-header {\n      position: sticky;\n      top: 0;\n      z-index: 50;\n      background: rgba(255,255,255,0.96);\n      backdrop-filter: blur(8px);\n      border-bottom: 1px solid var(--line);\n    }\n    .nav {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 1.5rem;\n      padding: 0.9rem 0;\n    }\n    .brand {\n      display: flex;\n      align-items: center;\n      gap: 0.6rem;\n      text-decoration: none;\n      color: var(--teal-900);\n      font-weight: 800;\n      font-size: 1.05rem;\n    }\n    .brand small {\n      display: block;\n      font-weight: 500;\n      font-size: 0.75rem;\n      color: var(--muted);\n      letter-spacing: 0.02em;\n    }\n    .nav-links {\n      display: flex;\n      gap: 1.6rem;\n      list-style: none;\n      margin: 0;\n      padding: 0;\n    }\n    .nav-links a {\n      text-decoration: none;\n      color: var(--ink);\n      font-weight: 600;\n      font-size: 0.95rem;\n    }\n    .nav-links a:hover { color: var(--teal-700); }\n    .nav-cta { display: flex; gap: 0.75rem; align-items: center; }\n\n    /* Hero */\n    .hero {\n      position: relative;\n      overflow: hidden;\n      background:\n        radial-gradient(circle at 85% 20%, rgba(42,157,143,0.18), transparent 45%),\n        radial-gradient(circle at 10% 90%, rgba(231,111,81,0.12), transparent 40%),\n        linear-gradient(180deg, var(--teal-50), var(--white));\n      padding: clamp(3.5rem, 8vw, 6.5rem) 0 clamp(3rem, 6vw, 5rem);\n    }\n    .hero-grid {\n      display: grid;\n      grid-template-columns: 1.15fr 0.85fr;\n      gap: 3rem;\n      align-items: center;\n    }\n    .hero h1 span { color: var(--teal-500); }\n    .hero-lede {\n      font-size: 1.2rem;\n      color: var(--muted);\n      max-width: 540px;\n      margin-bottom: 2rem;\n    }\n    .hero-actions {\n      display: flex;\n      gap: 0.9rem;\n      flex-wrap: wrap;\n      margin-bottom: 1.8rem;\n    }\n    .hero-badges {\n      list-style: none;\n      padding: 0;\n      margin: 0;\n      display: flex;\n      flex-wrap: wrap;\n      gap: 0.6rem 1.4rem;\n      font-size: 0.95rem;\n      color: var(--teal-900);\n      font-weight: 600;\n    }\n    .hero-badges li {\n      display: flex;\n      align-items: center;\n      gap: 0.4rem;\n    }\n    .hero-badges svg { width: 18px; height: 18px; color: var(--teal-500); }\n\n    /* Hero status card */\n    .status-card {\n      background: var(--white);\n      border-radius: 20px;\n      box-shadow: var(--shadow);\n      padding: 1.8rem;\n      border: 1px solid var(--line);\n    }\n    .status-head {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      margin-bottom: 1rem;\n    }\n    .status-head h3 { margin: 0; font-size: 1.05rem; }\n    .pill-open {\n      display: inline-flex;\n      align-items: center;\n      gap: 0.4rem;\n      background: #e3f6ec;\n      color: #1d6b3f;\n      font-weight: 700;\n      font-size: 0.8rem;\n      padding: 0.35em 0.8em;\n      border-radius: 999px;\n    }\n    .pill-open::before {\n      content: \"\";\n      width: 8px; height: 8px;\n      border-radius: 50%;\n      background: #22a05b;\n      box-shadow: 0 0 0 3px rgba(34,160,91,0.25);\n    }\n    .queue {\n      background: var(--teal-50);\n      border-radius: var(--radius);\n      padding: 1.1rem 1.2rem;\n      margin-bottom: 1.2rem;\n    }\n    .queue-row {\n      display: flex;\n      justify-content: space-between;\n      font-size: 0.95rem;\n      margin-bottom: 0.4rem;\n    }\n    .queue-row strong { color: var(--teal-900); }\n    .meter {\n      height: 8px;\n      background: var(--line);\n      border-radius: 999px;\n      overflow: hidden;\n    }\n    .meter span {\n      display: block;\n      height: 100%;\n      width: 35%;\n      background: linear-gradient(90deg, var(--teal-500), var(--teal-700));\n      border-radius: 999px;\n    }\n    .status-card ul {\n      list-style: none;\n      padding: 0;\n      margin: 0 0 1.2rem;\n      font-size: 0.95rem;\n    }\n    .status-card li {\n      padding: 0.55rem 0;\n      border-bottom: 1px dashed var(--line);\n      display: flex;\n      justify-content: space-between;\n      gap: 1rem;\n    }\n    .status-card li:last-child { border-bottom: 0; }\n    .status-card li span:last-child { color: var(--muted); white-space: nowrap; }\n    .status-card .btn { width: 100%; justify-content: center; }\n\n    /* Trust strip */\n    .trust-strip {\n      border-bottom: 1px solid var(--line);\n      background: var(--white);\n    }\n    .trust-items {\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      gap: 1.5rem;\n      padding: 1.8rem 0;\n    }\n    .trust-item {\n      display: flex;\n      gap: 0.8rem;\n      align-items: flex-start;\n    }\n    .trust-icon {\n      flex: none;\n      width: 42px; height: 42px;\n      border-radius: 12px;\n      background: var(--teal-100);\n      color: var(--teal-700);\n      display: grid;\n      place-items: center;\n    }\n    .trust-icon svg { width: 22px; height: 22px; }\n    .trust-item strong { display: block; color: var(--teal-900); font-size: 0.98rem; }\n    .trust-item span { font-size: 0.88rem; color: var(--muted); }\n\n    /* Services */\n    .services-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 1.25rem;\n    }\n    .card {\n      background: var(--white);\n      border: 1px solid var(--line);\n      border-radius: var(--radius);\n      padding: 1.6rem;\n      transition: box-shadow 0.2s ease, transform 0.2s ease;\n    }\n    .card:hover {\n      box-shadow: var(--shadow);\n      transform: translateY(-2px);\n    }\n    .card .icon {\n      width: 48px; height: 48px;\n      border-radius: 14px;\n      background: var(--teal-100);\n      color: var(--teal-700);\n      display: grid;\n      place-items: center;\n      margin-bottom: 1rem;\n    }\n    .card .icon svg { width: 24px; height: 24px; }\n    .card p { color: var(--muted); font-size: 0.97rem; margin-bottom: 0.8rem; }\n    .card .tag {\n      font-size: 0.8rem;\n      font-weight: 600;\n      color: var(--teal-700);\n    }\n\n    /* How it works */\n    .steps {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 1.5rem;\n      counter-reset: step;\n      list-style: none;\n      padding: 0;\n      margin: 0;\n    }\n    .step {\n      position: relative;\n      background: var(--white);\n      border-radius: var(--radius);\n      padding: 2rem 1.6rem 1.6rem;\n      border: 1px solid var(--line);\n    }\n    .step::before {\n      counter-increment: step;\n      content: counter(step);\n      position: absolute;\n      top: -18px;\n      left: 1.6rem;\n      width: 40px; height: 40px;\n      border-radius: 50%;\n      background: var(--coral);\n      color: var(--white);\n      font-weight: 800;\n      display: grid;\n      place-items: center;\n      box-shadow: 0 4px 12px rgba(231,111,81,0.35);\n    }\n    .step p { color: var(--muted); margin: 0; font-size: 0.97rem; }\n\n    /* Privacy band */\n    .privacy {\n      background: var(--teal-900);\n      color: #d9efec;\n    }\n    .privacy h2, .privacy h3 { color: var(--white); }\n    .privacy-grid {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 3rem;\n      align-items: start;\n    }\n    .privacy-list {\n      list-style: none;\n      padding: 0;\n      margin: 0;\n      display: grid;\n      gap: 1.1rem;\n    }\n    .privacy-list li {\n      display: flex;\n      gap: 0.9rem;\n      align-items: flex-start;\n    }\n    .privacy-list svg {\n      flex: none;\n      width: 22px; height: 22px;\n      color: #7fd6c8;\n      margin-top: 3px;\n    }\n    .privacy-list strong { color: var(--white); display: block; }\n    .privacy-list span { font-size: 0.95rem; color: #b8d9d5; }\n    .privacy .btn-outline { color: var(--white); border-color: var(--white); }\n    .privacy .btn-outline:hover { background: var(--white); color: var(--teal-900); }\n\n    /* Hours & location */\n    .info-grid {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 2rem;\n    }\n    .hours-table {\n      width: 100%;\n      border-collapse: collapse;\n      background: var(--white);\n      border-radius: var(--radius);\n      overflow: hidden;\n      border: 1px solid var(--line);\n    }\n    .hours-table th, .hours-table td {\n      text-align: left;\n      padding: 0.95rem 1.2rem;\n      border-bottom: 1px solid var(--line);\n      font-size: 0.97rem;\n    }\n    .hours-table tr:last-child th, .hours-table tr:last-child td { border-bottom: 0; }\n    .hours-table th { color: var(--teal-900); font-weight: 700; width: 45%; }\n    .hours-table td { color: var(--muted); }\n    .hours-table tr.today { background: var(--teal-50); }\n    .hours-table tr.today th::after {\n      content: \"Today\";\n      margin-left: 0.6rem;\n      font-size: 0.72rem;\n      background: var(--teal-500);\n      color: var(--white);\n      padding: 0.15em 0.6em;\n      border-radius: 999px;\n      vertical-align: middle;\n    }\n    .hours-note { font-size: 0.88rem; color: var(--muted); margin-top: 0.8rem; }\n\n    .location-card {\n      background: var(--white);\n      border: 1px solid var(--line);\n      border-radius: var(--radius);\n      padding: 2rem;\n    }\n    .location-card address {\n      font-style: normal;\n      font-size: 1.05rem;\n      margin-bottom: 1.2rem;\n    }\n    .location-card .contact-line {\n      display: flex;\n      gap: 0.6rem;\n      align-items: center;\n      margin-bottom: 0.6rem;\n      font-weight: 600;\n    }\n    .location-card .contact-line svg { width: 18px; height: 18px; color: var(--teal-700); flex: none; }\n    .map-art {\n      margin-top: 1.4rem;\n      border-radius: 12px;\n      background:\n        linear-gradient(135deg, rgba(42,157,143,0.15) 25%, transparent 25%) -20px 0/40px 40px,\n        linear-gradient(225deg, rgba(42,157,143,0.15) 25%, transparent 25%) -20px 0/40px 40px,\n        var(--teal-50);\n      height: 150px;\n      position: relative;\n      border: 1px solid var(--line);\n    }\n    .map-art svg { position: absolute; inset: 0; width: 100%; height: 100%; }\n\n    /* FAQ */\n    .faq { max-width: 820px; }\n    .faq details {\n      border-bottom: 1px solid var(--line);\n      padding: 1.1rem 0;\n    }\n    .faq details:first-of-type { border-top: 1px solid var(--line); }\n    .faq summary {\n      cursor: pointer;\n      list-style: none;\n      font-weight: 700;\n      color: var(--teal-900);\n      font-size: 1.07rem;\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      gap: 1rem;\n    }\n    .faq summary::-webkit-details-marker { display: none; }\n    .faq summary::after {\n      content: \"+\";\n      font-size: 1.5rem;\n      line-height: 1;\n      color: var(--teal-500);\n      transition: transform 0.2s ease;\n    }\n    .faq details[open] summary::after { transform: rotate(45deg); }\n    .faq details p {\n      margin: 0.9rem 0 0;\n      color: var(--muted);\n      padding-right: 2rem;\n    }\n\n    /* Urgent note */\n    .urgent {\n      background: #fff4ef;\n      border: 1px solid #f6c9b8;\n      border-radius: var(--radius);\n      padding: 1.2rem 1.4rem;\n      display: flex;\n      gap: 1rem;\n      align-items: flex-start;\n      font-size: 0.95rem;\n      color: #7a3520;\n      margin-top: 2rem;\n    }\n    .urgent svg { flex: none; width: 24px; height: 24px; color: var(--coral-dark); }\n\n    /* Final CTA */\n    .final-cta {\n      background: linear-gradient(135deg, var(--teal-700), var(--teal-900));\n      color: var(--white);\n      text-align: center;\n      padding: clamp(3.5rem, 7vw, 5rem) 0;\n    }\n    .final-cta h2 { color: var(--white); }\n    .final-cta p { color: #cfe9e6; max-width: 560px; margin: 0 auto 2rem; font-size: 1.1rem; }\n\n    /* Footer */\n    footer {\n      background: #082c2d;\n      color: #a9c9c5;\n      padding: 3rem 0 2rem;\n      font-size: 0.92rem;\n    }\n    .footer-grid {\n      display: grid;\n      grid-template-columns: 2fr 1fr 1fr;\n      gap: 2.5rem;\n      margin-bottom: 2rem;\n    }\n    footer h4 {\n      color: var(--white);\n      margin: 0 0 0.8rem;\n      font-size: 0.95rem;\n    }\n    footer ul { list-style: none; padding: 0; margin: 0; }\n    footer li { margin-bottom: 0.5rem; }\n    footer a { color: #cfe9e6; text-decoration: none; }\n    footer a:hover { text-decoration: underline; }\n    .footer-legal {\n      border-top: 1px solid rgba(255,255,255,0.1);\n      padding-top: 1.5rem;\n      font-size: 0.82rem;\n      color: #7fa3a0;\n    }\n\n    .quick-exit {\n      position: fixed;\n      bottom: 1rem;\n      left: 1rem;\n      z-index: 60;\n      background: var(--white);\n      color: var(--teal-900);\n      border: 1px solid var(--line);\n      box-shadow: var(--shadow);\n      font-weight: 700;\n      font-size: 0.85rem;\n      padding: 0.6em 1em;\n      border-radius: 999px;\n      text-decoration: none;\n    }\n    .quick-exit:hover { background: var(--teal-50); }\n\n    /* Responsive */\n    @media (max-width: 960px) {\n      .hero-grid, .privacy-grid, .info-grid { grid-template-columns: 1fr; }\n      .services-grid { grid-template-columns: repeat(2, 1fr); }\n      .trust-items { grid-template-columns: repeat(2, 1fr); }\n      .nav-links { display: none; }\n      .footer-grid { grid-template-columns: 1fr 1fr; }\n    }\n\n    @media (max-width: 640px) {\n      body { font-size: 16px; }\n      .services-grid, .steps { grid-template-columns: 1fr; }\n      .trust-items { grid-template-columns: 1fr; }\n      .nav-cta .btn-outline { display: none; }\n      .hero-actions .btn { width: 100%; justify-content: center; }\n      .footer-grid { grid-template-columns: 1fr; }\n      .hours-table th { width: 50%; }\n      .quick-exit { bottom: 0.6rem; left: 0.6rem; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      html { scroll-behavior: auto; }\n      *, *::before, *::after { transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n\n  <!-- Utility bar -->\n  <div class=\"utility-bar\">\n    <div class=\"container\">\n      <span>Open today until 8:00 PM &middot; No appointment needed</span>\n      <a href=\"tel:+15555550123\">Call (555) 555-0123</a>\n    </div>\n  </div>\n\n  <!-- Header -->\n  <header class=\"site-header\">\n    <div class=\"container nav\">\n      <a href=\"#top\" class=\"brand\" aria-label=\"Riverside Sexual Health Clinic home\">\n        <svg width=\"36\" height=\"36\" viewBox=\"0 0 36 36\" aria-hidden=\"true\">\n          <rect width=\"36\" height=\"36\" rx=\"10\" fill=\"#14625f\"/>\n          <path d=\"M18 9c-3.5 0-6 2.6-6 6 0 4.5 6 12 6 12s6-7.5 6-12c0-3.4-2.5-6-6-6zm0 8.2a2.2 2.2 0 1 1 0-4.4 2.2 2.2 0 0 1 0 4.4z\" fill=\"#fff\"/>\n        </svg>\n        <span>Riverside Sexual Health<small>Walk-in clinic</small></span>\n      </a>\n\n      <ul class=\"nav-links\">\n        <li><a href=\"#services\">Services</a></li>\n        <li><a href=\"#how-it-works\">How it works</a></li>\n        <li><a href=\"#privacy\">Privacy</a></li>\n        <li><a href=\"#visit\">Hours &amp; location</a></li>\n        <li><a href=\"#faq\">FAQ</a></li>\n      </ul>\n\n      <div class=\"nav-cta\">\n        <a href=\"#visit\" class=\"btn btn-outline\">Find us</a>\n        <a href=\"#visit\" class=\"btn btn-primary\">Walk in today</a>\n      </div>\n    </div>\n  </header>\n\n  <main id=\"top\">\n\n    <!-- Hero -->\n    <section class=\"hero\">\n      <div class=\"container hero-grid\">\n        <div>\n          <span class=\"eyebrow\">Confidential &middot; Judgment-free &middot; Walk-in</span>\n          <h1>Walk in. <span>We'll take it from here.</span></h1>\n          <p class=\"hero-lede\">\n            Testing, treatment, contraception, and prevention care for everyone, at any age and in any relationship.\n            No appointment, no referral, and no insurance required to get started.\n          </p>\n          <div class=\"hero-actions\">\n            <a href=\"#visit\" class=\"btn btn-primary\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n              Walk in today\n            </a>\n            <a href=\"#services\" class=\"btn btn-outline\">Browse services</a>\n          </div>\n          <ul class=\"hero-badges\">\n            <li>\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg>\n              No appointment needed\n            </li>\n            <li>\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg>\n              Private, confidential visits\n            </li>\n            <li>\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg>\n              Sliding-scale fees\n            </li>\n          </ul>\n        </div>\n\n        <aside class=\"status-card\" aria-label=\"Current clinic status\">\n          <div class=\"status-head\">\n            <h3>Clinic status</h3>\n            <span class=\"pill-open\">Open now</span>\n          </div>\n          <div class=\"queue\">\n            <div class=\"queue-row\"><span>Estimated wait</span><strong>About 15 minutes</strong></div>\n            <div class=\"meter\" role=\"img\" aria-label=\"Clinic is currently about 35 percent busy\"><span></span></div>\n          </div>\n          <ul>\n            <li><span>Front desk</span><span>8:00 AM \u2013 8:00 PM</span></li>\n            <li><span>Test results</span><span>Within 1\u20133 business days</span></li>\n            <li><span>Emergency PEP</span><span>Walk in same day</span></li>\n          </ul>\n          <a href=\"#visit\" class=\"btn btn-primary\">Get directions</a>\n        </aside>\n      </div>\n    </section>\n\n    <!-- Trust strip -->\n    <section class=\"trust-strip\" aria-label=\"Why people choose us\">\n      <div class=\"container trust-items\">\n        <div class=\"trust-item\">\n          <div class=\"trust-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><rect x=\"5\" y=\"11\" width=\"14\" height=\"10\" rx=\"2\"/><path d=\"M8 11V7a4 4 0 0 1 8 0v4\"/></svg>\n          </div>\n          <div><strong>Your privacy is protected</strong><span>Records are never shared without consent.</span></div>\n        </div>\n        <div class=\"trust-item\">\n          <div class=\"trust-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/></svg>\n          </div>\n          <div><strong>Seen the same day</strong><span>Most walk-ins are seen within the hour.</span></div>\n        </div>\n        <div class=\"trust-item\">\n          <div class=\"trust-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M12 3 4 6v6c0 4.5 3.4 8.2 8 9 4.6-.8 8-4.5 8-9V6z\"/><path d=\"m9 12 2 2 4-4\"/></svg>\n          </div>\n          <div><strong>Licensed clinicians</strong><span>Care guided by current medical guidelines.</span></div>\n        </div>\n        <div class=\"trust-item\">\n          <div class=\"trust-icon\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M12 21s-7-4.4-7-10a7 7 0 0 1 14 0c0 5.6-7 10-7 10z\"/><circle cx=\"12\" cy=\"11\" r=\"2.5\"/></svg>\n          </div>\n          <div><strong>Inclusive care</strong><span>Welcoming to all genders, orientations, and identities.</span></div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Services -->\n    <section class=\"section\" id=\"services\">\n      <div class=\"container\">\n        <div class=\"section-head\">\n          <span class=\"eyebrow\">Services</span>\n          <h2>Everything you need, in one visit</h2>\n          <p>From a routine check-up to urgent same-day care, our team can help with the full range of sexual and reproductive health needs.</p>\n        </div>\n\n        <div class=\"services-grid\">\n          <article class=\"card\">\n            <div class=\"icon\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M9 3h6M10 3v5.5L5 18a3 3 0 0 0 2.6 4.5h8.8A3 3 0 0 0 19 18l-5-9.5V3\"/></svg>\n            </div>\n            <h3>STI testing &amp; treatment</h3>\n            <p>Confidential screening for chlamydia, gonorrhea, syphilis, herpes, trichomoniasis, and more, with treatment on the spot when possible.</p>\n            <span class=\"tag\">Symptomatic or not</span>\n          </article>\n\n          <article class=\"card\">\n            <div class=\"icon\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M12 21s-7-4.4-7-10a7 7 0 0 1 14 0c0 5.6-7 10-7 10z\"/><path d=\"M12 8v4m-2-2h4\"/></svg>\n            </div>\n            <h3>HIV testing &amp; PrEP</h3>\n            <p>Rapid HIV testing and daily or on-demand PrEP to prevent HIV, with ongoing monitoring and refill support.</p>\n            <span class=\"tag\">Rapid results available</span>\n          </article>\n\n          <article class=\"card\">\n            <div class=\"icon\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M12 3v18M5 8l14 8M5 16l14-8\" opacity=\"0\"/><circle cx=\"12\" cy=\"12\" r=\"8\"/><path d=\"M12 8v8M8 12h8\"/></svg>\n            </div>\n            <h3>Emergency PEP</h3>\n            <p>Possible exposure to HIV? Post-exposure prophylaxis works best when started within 72 hours. Walk in right away.</p>\n            <span class=\"tag\">Start within 72 hours</span>\n          </article>\n\n          <article class=\"card\">\n            <div class=\"icon\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><rect x=\"5\" y=\"4\" width=\"14\" height=\"16\" rx=\"3\"/><path d=\"M9 9h6M9 13h6M9 17h3\"/></svg>\n            </div>\n            <h3>Birth control</h3>\n            <p>Pills, patches, rings, injections, and IUD consultations. We'll help you find an option that fits your body and life.</p>\n            <span class=\"tag\">Same-day starts</span>\n          </article>\n\n          <article class=\"card\">\n            <div class=\"icon\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M4 12h4l2-5 4 10 2-5h4\"/></svg>\n            </div>\n            <h3>Emergency contraception</h3>\n            <p>Need the morning-after pill? We can provide it at the visit, and advise on the most effective option for your timeline.</p>\n            <span class=\"tag\">No judgment, no waiting</span>\n          </article>\n\n          <article class=\"card\">\n            <div class=\"icon\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"m12 3 8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z\"/><path d=\"m9 12 2 2 4-4\"/></svg>\n            </div>\n            <h3>Vaccinations</h3>\n            <p>Protection against HPV, hepatitis A and B, and mpox, based on your age, history, and risk factors.</p>\n            <span class=\"tag\">Ask about eligibility</span>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <!-- How it works -->\n    <section class=\"section section-alt\" id=\"how-it-works\">\n      <div class=\"container\">\n        <div class=\"section-head\">\n          <span class=\"eyebrow\">How it works</span>\n          <h2>Three simple steps</h2>\n          <p>You don't need to book ahead, bring paperwork, or explain yourself at the door. Here's what to expect.</p>\n        </div>\n\n        <ol class=\"steps\">\n          <li class=\"step\">\n            <h3>Walk in and check in</h3>\n            <p>Tell the front desk you're here for sexual health care. You can use a first name or nickname, and you'll sign a short form on a tablet.</p>\n          </li>\n          <li class=\"step\">\n            <h3>Talk with a clinician</h3>\n            <p>A private conversation about your concerns, history, and goals. Ask anything. There are no wrong questions here.</p>\n          </li>\n          <li class=\"step\">\n            <h3>Get tested and go</h3>\n            <p>Testing and treatment happen at the same visit whenever possible. You'll leave with a plan, prescriptions if needed, and a follow-up date.</p>\n          </li>\n        </ol>\n      </div>\n    </section>\n\n    <!-- Privacy -->\n    <section class=\"section privacy\" id=\"privacy\">\n      <div class=\"container privacy-grid\">\n        <div>\n          <span class=\"eyebrow\" style=\"background: rgba(255,255,255,0.12); color: #cfe9e6;\">Your privacy</span>\n          <h2>Discreet by design</h2>\n          <p style=\"color:#b8d9d5; font-size:1.05rem;\">We know that walking through a clinic door can feel big. We've built every part of the visit around your comfort and confidentiality.</p>\n          <a href=\"#visit\" class=\"btn btn-outline\" style=\"margin-top:0.8rem;\">Plan your visit</a>\n        </div>\n\n        <ul class=\"privacy-list\">\n          <li>\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg>\n            <div>\n              <strong>Discreet entrance and waiting area</strong>\n              <span>Unmarked signage on the building, and a waiting room with no names called aloud.</span>\n            </div>\n          </li>\n          <li>\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg>\n            <div>\n              <strong>Nothing is shared without your consent</strong>\n              <span>Your records are protected under medical privacy law and never released without your written permission.</span>\n            </div>\n          </li>\n          <li>\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg>\n            <div>\n              <strong>Discreet billing and results</strong>\n              <span>Plain-brown-envelope billing and private result notifications by text, phone, or portal.</span>\n            </div>\n          </li>\n          <li>\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg>\n            <div>\n              <strong>Minors and young people welcome</strong>\n              <span>Our clinicians will explain what confidential care looks like for your age and location.</span>\n            </div>\n          </li>\n        </ul>\n      </div>\n    </section>\n\n    <!-- Hours & location -->\n    <section class=\"section\" id=\"visit\">\n      <div class=\"container\">\n        <div class=\"section-head\">\n          <span class=\"eyebrow\">Visit us</span>\n          <h2>Hours &amp; location</h2>\n          <p>Walk-ins are welcome during all open hours. Arriving earlier in the day usually means a shorter wait.</p>\n        </div>\n\n        <div class=\"info-grid\">\n          <div>\n            <table class=\"hours-table\">\n              <caption class=\"sr-only\" style=\"position:absolute;left:-9999px;\">Clinic hours by day</caption>\n              <tbody>\n                <tr><th scope=\"row\">Monday</th><td>8:00 AM \u2013 8:00 PM</td></tr>\n                <tr><th scope=\"row\">Tuesday</th><td>8:00 AM \u2013 8:00 PM</td></tr>\n                <tr class=\"today\"><th scope=\"row\">Wednesday</th><td>8:00 AM \u2013 8:00 PM</td></tr>\n                <tr><th scope=\"row\">Thursday</th><td>8:00 AM \u2013 8:00 PM</td></tr>\n                <tr><th scope=\"row\">Friday</th><td>9:00 AM \u2013 5:00 PM</td></tr>\n                <tr><th scope=\"row\">Saturday</th><td>10:00 AM \u2013 2:00 PM</td></tr>\n                <tr><th scope=\"row\">Sunday</th><td>Closed</td></tr>\n              </tbody>\n            </table>\n            <p class=\"hours-note\">Holiday hours may vary. Check our phone line or social channels before visiting.</p>\n          </div>\n\n          <div class=\"location-card\">\n            <address>\n              <strong>Riverside Sexual Health Clinic</strong><br>\n              1420 Maple Avenue, Suite 200<br>\n              Riverside, ST 00000\n            </address>\n\n            <div class=\"contact-line\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z\"/></svg>\n              <a href=\"tel:+15555550123\">(555) 555-0123</a>\n            </div>\n            <div class=\"contact-line\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"m3 7 9 6 9-6\"/></svg>\n              <a href=\"mailto:care@riversidesh.example\">care@riversidesh.example</a>\n            </div>\n            <div class=\"contact-line\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M4 4h16v12H7l-3 3z\"/></svg>\n              <a href=\"#\">Text us (confidential)</a>\n            </div>\n\n            <div class=\"map-art\" role=\"img\" aria-label=\"Simplified map showing the clinic location on Maple Avenue\">\n              <svg viewBox=\"0 0 400 150\" preserveAspectRatio=\"none\" aria-hidden=\"true\">\n                <path d=\"M0 110 Q120 60 220 90 T400 50\" stroke=\"#a8d8d1\" stroke-width=\"10\" fill=\"none\"/>\n                <path d=\"M60 0 L90 150 M250 0 L230 150\" stroke=\"#d6e3e1\" stroke-width=\"6\" fill=\"none\"/>\n                <path d=\"M0 40 L400 60\" stroke=\"#d6e3e1\" stroke-width=\"6\" fill=\"none\"/>\n                <rect x=\"268\" y=\"48\" width=\"18\" height=\"18\" rx=\"3\" fill=\"#e76f51\"/>\n                <circle cx=\"277\" cy=\"57\" r=\"22\" fill=\"none\" stroke=\"#e76f51\" stroke-opacity=\"0.4\" stroke-width=\"2\"/>\n              </svg>\n            </div>\n            <p style=\"margin:1rem 0 0;font-size:0.92rem;color:var(--muted);\">\n              Free street parking and a bike rack at the entrance. Accessible via the Maple Ave bus, stop 14.\n            </p>\n          </div>\n        </div>\n\n        <div class=\"urgent\" role=\"note\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z\"/></svg>\n          <div>\n            <strong>Medical emergency?</strong> This clinic is not an emergency department. If you have severe pain, heavy bleeding, trouble breathing, or signs of a serious reaction, call your local emergency number or go to the nearest emergency room right away.\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- FAQ -->\n    <section class=\"section section-alt\" id=\"faq\">\n      <div class=\"container\">\n        <div class=\"section-head\">\n          <span class=\"eyebrow\">Questions</span>\n          <h2>Frequently asked</h2>\n        </div>\n\n        <div class=\"faq\">\n          <details open>\n            <summary>Do I really not need an appointment?</summary>\n            <p>Correct. Walk in during open hours and our front desk will check you in. If the waiting room is busy, you'll be given an estimated wait time. If you'd prefer a specific time, you can also book online or by phone.</p>\n          </details>\n          <details>\n            <summary>Do I need insurance or ID?</summary>\n            <p>No insurance is required. We offer sliding-scale fees and accept most major plans. You don't need to show ID to be seen, though we may ask for a name or nickname for our records.</p>\n          </details>\n          <details>\n            <summary>Will my parents or partner find out about my visit?</summary>\n            <p>We keep your visit confidential. Explanations of benefits from insurance can sometimes reach the policyholder, so let us know if you'd like us to use a private billing method. We'll go over this with you before your visit.</p>\n          </details>\n          <details>\n            <summary>How long do test results take?</summary>\n            <p>Some rapid tests, including HIV and syphilis, can give results during your visit. Lab-based tests usually take 1 to 3 business days. We'll contact you by your preferred method and never leave sensitive details on a voicemail unless you've said that's okay.</p>\n          </details>\n          <details>\n            <summary>I think I was exposed to HIV. What should I do?</summary>\n            <p>Come in as soon as possible. PEP, a short course of medication, is most effective when started within 72 hours of exposure. Our clinicians will assess your situation and can start treatment the same day if you qualify.</p>\n          </details>\n          <details>\n            <summary>Can I get care if I'm not sexually active yet, or I'm under 18?</summary>\n            <p>Yes. Young people can access many services confidentially depending on local law. Our team will explain what's available for your age when you check in.</p>\n          </details>\n          <details>\n            <summary>What if I have symptoms but I'm not sure what they are?</summary>\n            <p>Come in anyway. Many STIs cause no symptoms, and many symptoms have ordinary causes. Our clinicians see questions like this every day and will help you figure it out.</p>\n          </details>\n        </div>\n      </div>\n    </section>\n\n    <!-- Final CTA -->\n    <section class=\"final-cta\">\n      <div class=\"container\">\n        <h2>Ready when you are</h2>\n        <p>Whether you have a question, a concern, or simply want peace of mind, we're here. Come in today.</p>\n        <div class=\"hero-actions\" style=\"justify-content:center;\">\n          <a href=\"#visit\" class=\"btn btn-primary\">Walk in today</a>\n          <a href=\"tel:+15555550123\" class=\"btn btn-light\">Call (555) 555-0123</a>\n        </div>\n      </div>\n    </section>\n\n  </main>\n\n  <!-- Footer -->\n  <footer>\n    <div class=\"container\">\n      <div class=\"footer-grid\">\n        <div>\n          <h4>Riverside Sexual Health Clinic</h4>\n          <p style=\"max-width:380px;\">A walk-in clinic providing confidential, nonjudgmental sexual and reproductive health care to everyone.</p>\n          <p style=\"margin-top:1rem;\">1420 Maple Avenue, Suite 200<br>Riverside, ST 00000</p>\n        </div>\n        <div>\n          <h4>Services</h4>\n          <ul>\n            <li><a href=\"#services\">STI testing</a></li>\n            <li><a href=\"#services\">HIV testing &amp; PrEP</a></li>\n            <li><a href=\"#services\">Emergency PEP</a></li>\n            <li><a href=\"#services\">Birth control</a></li>\n            <li><a href=\"#services\">Vaccinations</a></li>\n          </ul>\n        </div>\n        <div>\n          <h4>Patients</h4>\n          <ul>\n            <li><a href=\"#visit\">Hours &amp; location</a></li>\n            <li><a href=\"#faq\">FAQ</a></li>\n            <li><a href=\"#privacy\">Privacy notice</a></li>\n            <li><a href=\"#\">Patient portal</a></li>\n            <li><a href=\"#\">Accessibility</a></li>\n          </ul>\n        </div>\n      </div>\n\n      <div class=\"footer-legal\">\n        <p>This website provides general information and is not a substitute for medical advice. Call or visit the clinic for personal guidance. For medical emergencies, call your local emergency number.</p>\n        <p>&copy; 2025 Riverside Sexual Health Clinic. All rights reserved.</p>\n      </div>\n    </div>\n  </footer>\n\n  <a href=\"https://www.google.com\" class=\"quick-exit\" aria-label=\"Quick exit: leave this site immediately\">Quick exit</a>\n\n</body>\n</html>\n"}