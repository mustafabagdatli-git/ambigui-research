{"brief": "B5", "model": "z-ai/glm-5.3-flashx", "i": 4, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Meridian Health \u2014 Walk-in Sexual Health Clinic</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Karla:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --green:#1e3a2f;\n    --green-deep:#152921;\n    --cream:#faf6ee;\n    --cream-2:#f2ecdf;\n    --apricot:#e8a06b;\n    --apricot-soft:#f6d9bf;\n    --ink:#22302a;\n    --muted:#5d6b62;\n    --radius:20px;\n  }\n  *{margin:0;padding:0;box-sizing:border-box}\n  html{scroll-behavior:smooth}\n  body{\n    font-family:'Karla',sans-serif;\n    background:var(--cream);\n    color:var(--ink);\n    line-height:1.6;\n    -webkit-font-smoothing:antialiased;\n  }\n  h1,h2,h3{font-family:'Fraunces',serif;font-weight:500;line-height:1.12;letter-spacing:-.01em}\n  .wrap{max-width:1120px;margin:0 auto;padding:0 24px}\n  .btn{\n    display:inline-block;padding:15px 28px;border-radius:999px;\n    font-weight:700;font-size:16px;text-decoration:none;cursor:pointer;\n    border:none;transition:transform .18s ease, box-shadow .18s ease;\n  }\n  .btn:hover{transform:translateY(-2px)}\n  .btn-solid{background:var(--green);color:var(--cream)}\n  .btn-solid:hover{box-shadow:0 10px 24px rgba(30,58,47,.25)}\n  .btn-light{background:var(--cream);color:var(--green)}\n  .btn-light:hover{box-shadow:0 10px 24px rgba(0,0,0,.15)}\n  .tag{\n    display:inline-block;font-size:13px;font-weight:700;letter-spacing:.12em;\n    text-transform:uppercase;color:var(--green);background:var(--apricot-soft);\n    padding:7px 16px;border-radius:999px;\n  }\n\n  /* ---------- header ---------- */\n  header{\n    position:sticky;top:0;z-index:50;\n    background:rgba(250,246,238,.9);backdrop-filter:blur(10px);\n    border-bottom:1px solid rgba(30,58,47,.1);\n  }\n  .nav{display:flex;align-items:center;justify-content:space-between;height:72px}\n  .logo{display:flex;align-items:center;gap:10px;font-family:'Fraunces',serif;font-size:22px;font-weight:600;color:var(--green);text-decoration:none}\n  .logo svg{display:block}\n  nav.links{display:flex;gap:32px}\n  nav.links a{color:var(--ink);text-decoration:none;font-weight:600;font-size:15px;position:relative}\n  nav.links a::after{\n    content:\"\";position:absolute;left:0;bottom:-4px;height:2px;width:0;\n    background:var(--apricot);transition:width .2s ease;\n  }\n  nav.links a:hover::after{width:100%}\n  @media(max-width:820px){nav.links{display:none}}\n\n  /* ---------- hero ---------- */\n  .hero{padding:88px 0 96px;position:relative;overflow:hidden}\n  .hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:64px;align-items:center}\n  @media(max-width:900px){.hero-grid{grid-template-columns:1fr}}\n  .hero h1{font-size:clamp(40px,5.4vw,68px);margin:22px 0 24px}\n  .hero h1 em{font-style:italic;color:#b96a35}\n  .hero p.lead{font-size:19px;color:var(--muted);max-width:520px;margin-bottom:36px}\n  .hero-ctas{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:32px}\n  .hero-trust{display:flex;gap:26px;flex-wrap:wrap}\n  .trust-item{display:flex;align-items:center;gap:9px;font-size:14.5px;font-weight:600;color:var(--green)}\n  .trust-item svg{flex-shrink:0}\n\n  /* wait-time card */\n  .wait-card{\n    background:var(--green);color:var(--cream);border-radius:28px;\n    padding:36px 34px;position:relative;overflow:hidden;\n    box-shadow:0 24px 60px rgba(21,41,33,.28);\n  }\n  .wait-card::before{\n    content:\"\";position:absolute;top:-70px;right:-70px;width:220px;height:220px;\n    border-radius:50%;background:rgba(232,160,107,.16);\n  }\n  .wait-card::after{\n    content:\"\";position:absolute;bottom:-90px;left:-50px;width:180px;height:180px;\n    border-radius:50%;background:rgba(232,160,107,.1);\n  }\n  .wait-card .open-dot{display:inline-flex;align-items:center;gap:8px;font-weight:700;font-size:13px;letter-spacing:.1em;text-transform:uppercase;color:var(--apricot)}\n  .pulse{width:9px;height:9px;border-radius:50%;background:var(--apricot);animation:pulse 1.8s ease infinite}\n  @keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(232,160,107,.5)}50%{box-shadow:0 0 0 8px rgba(232,160,107,0)}}\n  .wait-card h3{font-size:24px;margin:14px 0 4px}\n  .wait-time{font-family:'Fraunces',serif;font-size:56px;font-weight:600;color:var(--apricot);line-height:1;margin:10px 0 6px}\n  .wait-label{font-size:14px;color:rgba(250,246,238,.75)}\n  .wait-divider{height:1px;background:rgba(250,246,238,.15);margin:24px 0}\n  .wait-rows{position:relative;z-index:1}\n  .wait-row{display:flex;justify-content:space-between;font-size:14.5px;padding:5px 0}\n  .wait-row span:last-child{font-weight:700;color:var(--apricot-soft)}\n  .wait-foot{margin-top:22px;font-size:13px;color:rgba(250,246,238,.65);position:relative;z-index:1}\n\n  /* ---------- marquee strip ---------- */\n  .strip{background:var(--apricot);color:var(--green-deep);overflow:hidden;padding:14px 0;border-top:1px solid rgba(21,41,33,.15);border-bottom:1px solid rgba(21,41,33,.15)}\n  .strip-track{display:flex;gap:56px;white-space:nowrap;animation:scroll 26s linear infinite;font-weight:700;font-size:15px;letter-spacing:.06em}\n  .strip-track span{display:inline-flex;align-items:center;gap:56px}\n  @keyframes scroll{to{transform:translateX(-50%)}}\n\n  /* ---------- services ---------- */\n  section{padding:96px 0}\n  .sec-head{max-width:640px;margin-bottom:56px}\n  .sec-head h2{font-size:clamp(32px,4vw,46px);margin:18px 0 16px}\n  .sec-head p{color:var(--muted);font-size:17.5px}\n  .svc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}\n  @media(max-width:900px){.svc-grid{grid-template-columns:repeat(2,1fr)}}\n  @media(max-width:600px){.svc-grid{grid-template-columns:1fr}}\n  .svc{\n    background:#fff;border:1px solid rgba(30,58,47,.09);border-radius:var(--radius);\n    padding:30px 28px;transition:transform .2s ease, box-shadow .2s ease;\n  }\n  .svc:hover{transform:translateY(-5px);box-shadow:0 16px 40px rgba(30,58,47,.1)}\n  .svc-icon{\n    width:52px;height:52px;border-radius:14px;background:var(--cream-2);\n    display:flex;align-items:center;justify-content:center;margin-bottom:20px;\n  }\n  .svc h3{font-size:21px;margin-bottom:8px}\n  .svc p{font-size:15px;color:var(--muted)}\n  .svc .note{display:inline-block;margin-top:16px;font-size:13px;font-weight:700;color:#b96a35}\n\n  /* ---------- your visit ---------- */\n  .visit{background:var(--green);color:var(--cream);border-radius:36px;margin:0 24px}\n  .visit .wrap{padding-top:88px;padding-bottom:88px}\n  .visit .sec-head p{color:rgba(250,246,238,.7)}\n  .steps{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}\n  @media(max-width:900px){.steps{grid-template-columns:repeat(2,1fr)}}\n  @media(max-width:600px){.steps{grid-template-columns:1fr}}\n  .step{\n    background:rgba(250,246,238,.06);border:1px solid rgba(250,246,238,.12);\n    border-radius:var(--radius);padding:28px 24px;\n  }\n  .step-num{\n    font-family:'Fraunces',serif;font-size:38px;color:var(--apricot);\n    font-style:italic;line-height:1;margin-bottom:16px;\n  }\n  .step h3{font-size:19px;margin-bottom:8px}\n  .step p{font-size:14.5px;color:rgba(250,246,238,.72)}\n\n  /* ---------- FAQ ---------- */\n  .faq-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:64px;align-items:start}\n  @media(max-width:900px){.faq-grid{grid-template-columns:1fr;gap:32px}}\n  .faq-item{border-bottom:1px solid rgba(30,58,47,.14)}\n  .faq-q{\n    width:100%;background:none;border:none;text-align:left;cursor:pointer;\n    padding:22px 0;display:flex;justify-content:space-between;align-items:center;gap:20px;\n    font-family:'Karla',sans-serif;font-size:17.5px;font-weight:700;color:var(--ink);\n  }\n  .faq-q .chev{transition:transform .25s ease;flex-shrink:0}\n  .faq-item.open .chev{transform:rotate(45deg)}\n  .faq-a{max-height:0;overflow:hidden;transition:max-height .3s ease}\n  .faq-a p{padding:0 40px 22px 0;color:var(--muted);font-size:15.5px}\n  .faq-side h2{font-size:clamp(30px,3.6vw,42px);margin:18px 0 16px}\n  .faq-side p{color:var(--muted);font-size:17px;margin-bottom:28px}\n\n  /* ---------- CTA banner ---------- */\n  .cta{\n    background:var(--apricot-soft);border-radius:36px;text-align:center;\n    padding:80px 32px;margin:0 24px;position:relative;overflow:hidden;\n  }\n  .cta::before{content:\"\";position:absolute;top:-100px;left:50%;transform:translateX(-50%);width:520px;height:520px;border-radius:50%;border:1px solid rgba(185,106,53,.2)}\n  .cta h2{font-size:clamp(30px,4vw,48px);margin-bottom:16px;position:relative}\n  .cta p{color:#7a5433;font-size:18px;max-width:520px;margin:0 auto 32px;position:relative}\n\n  /* ---------- footer ---------- */\n  footer{background:var(--green-deep);color:rgba(250,246,238,.75);padding:72px 0 40px;margin-top:96px}\n  .foot-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:48px;margin-bottom:56px}\n  @media(max-width:820px){.foot-grid{grid-template-columns:1fr}}\n  footer h4{font-family:'Karla',sans-serif;color:var(--cream);font-size:14px;letter-spacing:.1em;text-transform:uppercase;margin-bottom:18px}\n  footer a{color:rgba(250,246,238,.75);text-decoration:none;display:block;padding:5px 0;font-size:15px}\n  footer a:hover{color:var(--apricot)}\n  .foot-logo{display:flex;align-items:center;gap:10px;font-family:'Fraunces',serif;font-size:22px;color:var(--cream);margin-bottom:16px}\n  .foot-bottom{border-top:1px solid rgba(250,246,238,.12);padding-top:28px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:13.5px;color:rgba(250,246,238,.5)}\n\n  /* reveal animation */\n  .reveal{opacity:0;transform:translateY(24px);transition:opacity .6s ease, transform .6s ease}\n  .reveal.in{opacity:1;transform:none}\n</style>\n</head>\n<body>\n\n<header>\n  <div class=\"wrap nav\">\n    <a class=\"logo\" href=\"#\">\n      <svg width=\"30\" height=\"30\" viewBox=\"0 0 30 30\" fill=\"none\">\n        <circle cx=\"15\" cy=\"15\" r=\"13.5\" stroke=\"#1e3a2f\" stroke-width=\"2\"/>\n        <path d=\"M15 5.5C15 5.5 21 10 21 15.5C21 19 18.3 21.5 15 21.5C11.7 21.5 9 19 9 15.5C9 10 15 5.5 15 5.5Z\" fill=\"#e8a06b\"/>\n      </svg>\n      Meridian Health\n    </a>\n    <nav class=\"links\">\n      <a href=\"#services\">Services</a>\n      <a href=\"#visit\">Your Visit</a>\n      <a href=\"#faq\">FAQs</a>\n      <a href=\"#contact\">Contact</a>\n    </nav>\n    <a class=\"btn btn-solid\" style=\"padding:11px 22px;font-size:15px\" href=\"#contact\">Plan your visit</a>\n  </div>\n</header>\n\n<!-- HERO -->\n<section class=\"hero\">\n  <div class=\"wrap hero-grid\">\n    <div>\n      <span class=\"tag\">Walk in today \u2014 no appointment needed</span>\n      <h1>Getting tested should be <em>simple,</em> private &amp; judgement-free.</h1>\n      <p class=\"lead\">Meridian is a walk-in sexual health clinic in the heart of the city. Free and confidential testing, treatment and advice \u2014 most results back within 48 hours.</p>\n      <div class=\"hero-ctas\">\n        <a class=\"btn btn-solid\" href=\"#contact\">Find the clinic</a>\n        <a class=\"btn\" style=\"background:transparent;color:var(--green);border:2px solid var(--green);padding:13px 26px\" href=\"#services\">Browse services</a>\n      </div>\n      <div class=\"hero-trust\">\n        <div class=\"trust-item\">\n          <svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\"><path d=\"M3 9.5L7 13.5L15 4.5\" stroke=\"#1e3a2f\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          Free &amp; confidential\n        </div>\n        <div class=\"trust-item\">\n          <svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\"><circle cx=\"9\" cy=\"9\" r=\"7\" stroke=\"#1e3a2f\" stroke-width=\"2\"/><path d=\"M9 5.5V9L11.5 11\" stroke=\"#1e3a2f\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg>\n          Open 7 days\n        </div>\n        <div class=\"trust-item\">\n          <svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\"><path d=\"M9 15.5C9 15.5 2.5 11.5 2.5 7A3.8 3.8 0 019 4.4 3.8 3.8 0 0115.5 7c0 4.5-6.5 8.5-6.5 8.5z\" stroke=\"#1e3a2f\" stroke-width=\"2\" stroke-linejoin=\"round\"/></svg>\n          No referral needed\n        </div>\n      </div>\n    </div>\n\n    <aside class=\"wait-card\">\n      <span class=\"open-dot\"><span class=\"pulse\"></span> Open now \u00b7 closes 8:00 pm</span>\n      <h3>Current wait time</h3>\n      <div class=\"wait-time\">~15 min</div>\n      <div class=\"wait-label\">Updated live, every 10 minutes</div>\n      <div class=\"wait-divider\"></div>\n      <div class=\"wait-rows\">\n        <div class=\"wait-row\"><span>Mon \u2013 Fri</span><span>8am \u2013 8pm</span></div>\n        <div class=\"wait-row\"><span>Saturday</span><span>9am \u2013 5pm</span></div>\n        <div class=\"wait-row\"><span>Sunday</span><span>10am \u2013 3pm</span></div>\n      </div>\n      <p class=\"wait-foot\">142 Cedar Lane, Riverside \u00b7 Free parking &amp; step-free access</p>\n    </aside>\n  </div>\n</section>\n\n<!-- STRIP -->\n<div class=\"strip\" aria-hidden=\"true\">\n  <div class=\"strip-track\">\n    <span>Confidential testing \u2726 Judgement-free care \u2726 Results in 48 hrs \u2726 Free condoms \u2726 PrEP &amp; PEP \u2726 Walk-ins welcome \u2726</span>\n    <span>Confidential testing \u2726 Judgement-free care \u2726 Results in 48 hrs \u2726 Free condoms \u2726 PrEP &amp; PEP \u2726 Walk-ins welcome \u2726</span>\n  </div>\n</div>\n\n<!-- SERVICES -->\n<section id=\"services\">\n  <div class=\"wrap\">\n    <div class=\"sec-head reveal\">\n      <span class=\"tag\">What we offer</span>\n      <h2>Everything under one roof, on your terms.</h2>\n      <p>No lectures, no paperwork mountains. Tell us what you came for and we'll take care of the rest \u2014 usually in a single visit.</p>\n    </div>\n    <div class=\"svc-grid\">\n      <div class=\"svc reveal\">\n        <div class=\"svc-icon\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 26 26\" fill=\"none\"><path d=\"M4 14l4-8 5 14 4-9 2 3h3\" stroke=\"#1e3a2f\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></div>\n        <h3>STI &amp; HIV testing</h3>\n        <p>Full screening panels with a quick swab, urine sample or blood draw. Same-day rapid HIV results available.</p>\n        <span class=\"note\">Results in 48 hrs</span>\n      </div>\n      <div class=\"svc reveal\">\n        <div class=\"svc-icon\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 26 26\" fill=\"none\"><rect x=\"4\" y=\"6\" width=\"18\" height=\"14\" rx=\"7\" stroke=\"#1e3a2f\" stroke-width=\"2.2\"/><path d=\"M9 13h8\" stroke=\"#e8a06b\" stroke-width=\"2.4\" stroke-linecap=\"round\"/></svg></div>\n        <h3>Contraception</h3>\n        <p>Pills, implants, IUD fitting and emergency contraception \u2014 no referral, no waiting list, advice without pressure.</p>\n        <span class=\"note\">Same-day fitting</span>\n      </div>\n      <div class=\"svc reveal\">\n        <div class=\"svc-icon\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 26 26\" fill=\"none\"><path d=\"M13 22s-8-4.5-8-10.5A4.7 4.7 0 0113 8.6 4.7 4.7 0 0121 11.5C21 17.5 13 22 13 22z\" stroke=\"#1e3a2f\" stroke-width=\"2.2\" stroke-linejoin=\"round\"/></svg></div>\n        <h3>PrEP &amp; PEP</h3>\n        <p>HIV prevention medication, started the same day you walk in. PEP is most effective within 72 hours \u2014 come straight to us.</p>\n        <span class=\"note\">Urgent? Come now</span>\n      </div>\n      <div class=\"svc reveal\">\n        <div class=\"svc-icon\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 26 26\" fill=\"none\"><circle cx=\"13\" cy=\"13\" r=\"9\" stroke=\"#1e3a2f\" stroke-width=\"2.2\"/><path d=\"M9 15c1.2 1.4 2.5 2 4 2s2.8-.6 4-2\" stroke=\"#e8a06b\" stroke-width=\"2.2\" stroke-linecap=\"round\"/></svg></div>\n        <h3>Treatment &amp; follow-up</h3>\n        <p>If something comes back positive, we treat most infections on the spot and handle partner notification discreetly if you'd like help.</p>\n        <span class=\"note\">On-site pharmacy</span>\n      </div>\n      <div class=\"svc reveal\">\n        <div class=\"svc-icon\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 26 26\" fill=\"none\"><path d=\"M5 20c2-6 4-6 6-3s4 3 6-3 4-6 4-6\" stroke=\"#1e3a2f\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"5\" cy=\"20\" r=\"1.8\" fill=\"#e8a06b\"/></svg></div>\n        <h3>Advice &amp; counselling</h3>\n        <p>Questions about sex, relationships, or a worry that's been sitting on your mind? Our nurses are here to listen \u2014 never to judge.</p>\n        <span class=\"note\">Free, always</span>\n      </div>\n      <div class=\"svc reveal\">\n        <div class=\"svc-icon\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 26 26\" fill=\"none\"><path d=\"M13 4v18M4 13h18\" stroke=\"#1e3a2f\" stroke-width=\"2.2\" stroke-linecap=\"round\"/><circle cx=\"13\" cy=\"13\" r=\"4\" stroke=\"#e8a06b\" stroke-width=\"2.2\"/></svg></div>\n        <h3>Vaccinations</h3>\n        <p>HPV and hepatitis B vaccines available at every visit \u2014 including catch-up doses if you missed them at school.</p>\n        <span class=\"note\">Walk-in friendly</span>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- YOUR VISIT -->\n<div class=\"visit\" id=\"visit\">\n  <div class=\"wrap\">\n    <div class=\"sec-head reveal\">\n      <span class=\"tag\" style=\"background:rgba(232,160,107,.2);color:var(--apricot)\">Your visit</span>\n      <h2 style=\"color:var(--cream)\">Four easy steps. About 30 minutes.</h2>\n      <p>Nobody enjoys clinic visits \u2014 we've streamlined ours so you're in and out with clear answers.</p>\n    </div>\n    <div class=\"steps\">\n      <div class=\"step reveal\">\n        <div class=\"step-num\">01</div>\n        <h3>Walk in</h3>\n        <p>Grab a number at reception. No name required if you prefer to stay anonymous \u2014 we'll use a code instead.</p>\n      </div>\n      <div class=\"step reveal\">\n        <div class=\"step-num\">02</div>\n        <h3>Quick chat</h3>\n        <p>A nurse asks a few private questions to work out which tests make sense for you. You can skip anything.</p>\n      </div>\n      <div class=\"step reveal\">\n        <div class=\"step-num\">03</div>\n        <h3>Simple tests</h3>\n        <p>Usually a swab, urine sample or small blood draw \u2014 often self-taken. It's quicker and easier than you'd think.</p>\n      </div>\n      <div class=\"step reveal\">\n        <div class=\"step-num\">04</div>\n        <h3>Get answers</h3>\n        <p>Some results same day, the rest by text within 48 hours. Treatment, if needed, is free and starts right away.</p>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- FAQ -->\n<section id=\"faq\">\n  <div class=\"wrap faq-grid\">\n    <div class=\"faq-side reveal\">\n      <span class=\"tag\">Good to know</span>\n      <h2>The questions everyone asks but few say out loud.</h2>\n      <p>There's no such thing as an awkward question here. If it's not covered below, just ask us at the desk.</p>\n      <a class=\"btn btn-solid\" href=\"#contact\">Still unsure? Come say hi</a>\n    </div>\n    <div class=\"faq-list reveal\">\n      <div class=\"faq-item\">\n        <button class=\"faq-q\">Is it really confidential?\n          <svg class=\"chev\" width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\"><path d=\"M9 2v14M2 9h14\" stroke=\"#b96a35\" stroke-width=\"2.4\" stroke-linecap=\"round\"/></svg>\n        </button>\n        <div class=\"faq-a\"><p>Yes. Your records are kept separately from your main medical file, and we never contact your GP or anyone else without your permission. You can even register under a coded name.</p></div>\n      </div>\n      <div class=\"faq-item\">\n        <button class=\"faq-q\">How much does it cost?\n          <svg class=\"chev\" width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\"><path d=\"M9 2v14M2 9h14\" stroke=\"#b96a35\" stroke-width=\"2.4\" stroke-linecap=\"round\"/></svg>\n        </button>\n        <div class=\"faq-a\"><p>Testing, treatment, contraception and counselling are all free. Vaccinations are free for eligible groups \u2014 reception can check in about a minute.</p></div>\n      </div>\n      <div class=\"faq-item\">\n        <button class=\"faq-q\">Do I need to see symptoms to get tested?\n          <svg class=\"chev\" width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\"><path d=\"M9 2v14M2 9h14\" stroke=\"#b96a35\" stroke-width=\"2.4\" stroke-linecap=\"round\"/></svg>\n        </button>\n        <div class=\"faq-a\"><p>Not at all \u2014 most infections show no symptoms at all. Many of our visitors come in for routine screening between partners, and that's exactly the right thing to do.</p></div>\n      </div>\n      <div class=\"faq-item\">\n        <button class=\"faq-q\">Can I bring someone with me?\n          <svg class=\"chev\" width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\"><path d=\"M9 2v14M2 9h14\" stroke=\"#b96a35\" stroke-width=\"2.4\" stroke-linecap=\"round\"/></svg>\n        </button>\n        <div class=\"faq-a\"><p>Absolutely. Bring a partner, friend or family member \u2014 they can stay with you for as much or as little of the visit as you like.</p></div>\n      </div>\n      <div class=\"faq-item\">\n        <button class=\"faq-q\">What if I'm under 18?\n          <svg class=\"chev\" width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\"><path d=\"M9 2v14M2 9h14\" stroke=\"#b96a35\" stroke-width=\"2.4\" stroke-linecap=\"round\"/></svg>\n        </button>\n        <div class=\"faq-a\"><p>You're just as welcome. The service is fully confidential at any age, and our staff are experienced in supporting younger visitors with sensitivity and care.</p></div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- CTA -->\n<div class=\"cta\" id=\"contact\">\n  <h2>The hardest part is the doorway.<br>We'll handle the rest.</h2>\n  <p>No phone call to make, no form to fill in. Just walk in during opening hours \u2014 we'll take it from there.</p>\n  <a class=\"btn btn-solid\" href=\"#\" onclick=\"this.textContent='\ud83d\udccd 142 Cedar Lane, Riverside';return false;\">Tap for directions</a>\n</div>\n\n<!-- FOOTER -->\n<footer>\n  <div class=\"wrap\">\n    <div class=\"foot-grid\">\n      <div>\n        <div class=\"foot-logo\">\n          <svg width=\"28\" height=\"28\" viewBox=\"0 0 30 30\" fill=\"none\">\n            <circle cx=\"15\" cy=\"15\" r=\"13.5\" stroke=\"#faf6ee\" stroke-width=\"2\"/>\n            <path d=\"M15 5.5C15 5.5 21 10 21 15.5C21 19 18.3 21.5 15 21.5C11.7 21.5 9 19 9 15.5C9 10 15 5.5 15 5.5Z\" fill=\"#e8a06b\"/>\n          </svg>\n          Meridian Health\n        </div>\n        <p style=\"font-size:15px;max-width:340px\">A community sexual health clinic offering free, confidential, judgement-free care \u2014 seven days a week.</p>\n      </div>\n      <div>\n        <h4>Visit us</h4>\n        <p style=\"font-size:15px\">142 Cedar Lane, Riverside<br>Open Mon\u2013Fri 8\u20138, Sat 9\u20135, Sun 10\u20133</p>\n        <a href=\"tel:+15550142\" style=\"margin-top:10px\">Call (555) 0142</a>\n      </div>\n      <div>\n        <h4>Urgent help</h4>\n        <p style=\"font-size:15px\">Think you've been exposed to HIV? PEP works best within 72 hours \u2014 come straight in, any day.</p>\n      </div>\n    </div>\n    <div class=\"foot-bottom\">\n      <span>\u00a9 2025 Meridian Health Clinic. Your privacy, always.</span>\n      <span>All services free &amp; confidential</span>\n    </div>\n  </div>\n</footer>\n\n<script>\n  // FAQ accordion\n  document.querySelectorAll('.faq-q').forEach(btn=>{\n    btn.addEventListener('click',()=>{\n      const item=btn.parentElement, ans=item.querySelector('.faq-a'), open=item.classList.contains('open');\n      document.querySelectorAll('.faq-item.open').forEach(i=>{\n        i.classList.remove('open'); i.querySelector('.faq-a').style.maxHeight=null;\n      });\n      if(!open){ item.classList.add('open'); ans.style.maxHeight=ans.scrollHeight+'px'; }\n    });\n  });\n  // Scroll reveal\n  const obs=new IntersectionObserver(es=>es.forEach(e=>{\n    if(e.isIntersecting){e.target.classList.add('in');obs.unobserve(e.target);}\n  }),{threshold:.12});\n  document.querySelectorAll('.reveal').forEach(el=>obs.observe(el));\n</script>\n</body>\n</html>\n"}