{"brief": "B3", "model": "openai/gpt-6-luna", "i": 2, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <meta name=\"theme-color\" content=\"#101411\" />\n  <title>Foundry \u2014 The open database for data engineers</title>\n  <style>\n    :root {\n      color-scheme: dark;\n      --bg: #101411;\n      --bg-soft: #151b17;\n      --panel: #19211c;\n      --panel-2: #1d2821;\n      --line: rgba(233, 242, 230, .11);\n      --text: #f0f3e9;\n      --muted: #a3aea2;\n      --green: #c5f277;\n      --green-dark: #94c84a;\n      --mono: \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace;\n      --sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n    }\n\n    * { box-sizing: border-box; }\n\n    html { scroll-behavior: smooth; }\n\n    body {\n      margin: 0;\n      background:\n        radial-gradient(ellipse at 77% 5%, rgba(141, 189, 78, .10), transparent 36rem),\n        var(--bg);\n      color: var(--text);\n      font-family: var(--sans);\n      -webkit-font-smoothing: antialiased;\n    }\n\n    a { color: inherit; text-decoration: none; }\n    button { font: inherit; }\n\n    .shell {\n      width: min(1160px, calc(100% - 48px));\n      margin: 0 auto;\n    }\n\n    .announcement {\n      border-bottom: 1px solid var(--line);\n      color: #cad2c4;\n      text-align: center;\n      padding: 10px 20px;\n      font-size: 12px;\n      letter-spacing: .02em;\n    }\n\n    .announcement span {\n      color: var(--green);\n      font-family: var(--mono);\n      margin-right: 8px;\n    }\n\n    .announcement a {\n      color: var(--text);\n      margin-left: 8px;\n      text-decoration: underline;\n      text-decoration-color: rgba(240, 243, 233, .35);\n      text-underline-offset: 3px;\n    }\n\n    header {\n      height: 76px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      border-bottom: 1px solid var(--line);\n    }\n\n    .brand {\n      display: inline-flex;\n      align-items: center;\n      gap: 11px;\n      font-size: 17px;\n      font-weight: 700;\n      letter-spacing: -.04em;\n    }\n\n    .brand-mark {\n      width: 30px;\n      height: 30px;\n      display: grid;\n      place-items: center;\n      color: var(--bg);\n      background: var(--green);\n      border-radius: 9px;\n    }\n\n    .brand-mark svg { width: 19px; height: 19px; }\n\n    nav {\n      display: flex;\n      align-items: center;\n      gap: 32px;\n      color: #bdc6ba;\n      font-size: 13px;\n    }\n\n    nav a:hover, .text-link:hover { color: var(--green); }\n\n    .nav-actions { display: flex; align-items: center; gap: 18px; }\n\n    .github-link {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      color: #c6cec2;\n      font-size: 13px;\n    }\n\n    .github-link svg { width: 17px; height: 17px; }\n\n    .button {\n      border: 1px solid transparent;\n      border-radius: 7px;\n      padding: 11px 16px;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: 9px;\n      font-size: 13px;\n      font-weight: 650;\n      transition: transform .18s ease, background .18s ease, border-color .18s ease;\n    }\n\n    .button:hover { transform: translateY(-1px); }\n\n    .button-primary {\n      color: #172013;\n      background: var(--green);\n    }\n\n    .button-primary:hover { background: #d4ff8b; }\n\n    .button-outline {\n      color: var(--text);\n      border-color: rgba(237, 245, 230, .18);\n      background: rgba(255,255,255,.025);\n    }\n\n    .button-outline:hover { border-color: rgba(197, 242, 119, .55); }\n\n    .hero {\n      display: grid;\n      grid-template-columns: 1fr 1.02fr;\n      align-items: center;\n      gap: 70px;\n      min-height: 610px;\n      padding: 76px 0 90px;\n    }\n\n    .eyebrow {\n      display: inline-flex;\n      align-items: center;\n      gap: 9px;\n      color: var(--green);\n      font: 11px var(--mono);\n      text-transform: uppercase;\n      letter-spacing: .12em;\n      margin-bottom: 23px;\n    }\n\n    .eyebrow::before {\n      content: \"\";\n      display: block;\n      width: 23px;\n      height: 1px;\n      background: var(--green);\n    }\n\n    h1 {\n      font-size: clamp(44px, 5.3vw, 68px);\n      line-height: .99;\n      letter-spacing: -.07em;\n      margin: 0;\n      max-width: 580px;\n      font-weight: 650;\n    }\n\n    h1 em {\n      color: var(--green);\n      font-style: normal;\n    }\n\n    .hero-copy {\n      max-width: 470px;\n      color: var(--muted);\n      font-size: 16px;\n      line-height: 1.7;\n      margin: 24px 0 28px;\n    }\n\n    .hero-actions { display: flex; align-items: center; gap: 12px; }\n\n    .hero-note {\n      margin-top: 17px;\n      color: #778277;\n      font: 11px var(--mono);\n    }\n\n    .hero-note span { color: #a6b69b; }\n\n    .product-window {\n      position: relative;\n      border: 1px solid rgba(233, 242, 230, .15);\n      border-radius: 12px;\n      background: #151c17;\n      box-shadow: 0 28px 90px rgba(0,0,0,.37), 0 0 60px rgba(154, 202, 89, .07);\n      overflow: hidden;\n      transform: perspective(1200px) rotateY(-3deg) rotateX(1deg);\n    }\n\n    .window-top {\n      height: 43px;\n      padding: 0 15px;\n      display: flex;\n      align-items: center;\n      gap: 7px;\n      border-bottom: 1px solid var(--line);\n      color: #899487;\n      font: 10px var(--mono);\n    }\n\n    .dot { width: 7px; height: 7px; border-radius: 50%; background: #536054; }\n    .dot:first-child { background: #db765f; }\n    .dot:nth-child(2) { background: #d7b65f; }\n    .dot:nth-child(3) { background: #7eac63; }\n\n    .window-title {\n      margin-left: auto;\n      margin-right: auto;\n      transform: translateX(-18px);\n      color: #9ea99c;\n    }\n\n    .app-body { display: grid; grid-template-columns: 148px 1fr; min-height: 365px; }\n\n    .sidebar {\n      border-right: 1px solid var(--line);\n      padding: 18px 11px;\n      background: rgba(255,255,255,.012);\n    }\n\n    .side-label {\n      padding: 0 8px 10px;\n      color: #667367;\n      font: 9px var(--mono);\n      text-transform: uppercase;\n      letter-spacing: .12em;\n    }\n\n    .side-item {\n      color: #929e91;\n      font-size: 10px;\n      padding: 8px;\n      margin-bottom: 3px;\n      border-radius: 5px;\n      display: flex;\n      align-items: center;\n      gap: 8px;\n    }\n\n    .side-item.active {\n      color: var(--green);\n      background: rgba(197, 242, 119, .09);\n    }\n\n    .side-icon {\n      width: 11px;\n      height: 11px;\n      border: 1px solid currentColor;\n      border-radius: 3px;\n      opacity: .8;\n    }\n\n    .workspace { padding: 21px 21px 18px; min-width: 0; }\n\n    .workspace-head {\n      display: flex;\n      align-items: flex-start;\n      justify-content: space-between;\n      margin-bottom: 18px;\n    }\n\n    .workspace-head h3 {\n      margin: 0 0 5px;\n      font-size: 13px;\n      letter-spacing: -.02em;\n    }\n\n    .workspace-head p {\n      margin: 0;\n      color: #758174;\n      font: 9px var(--mono);\n    }\n\n    .live {\n      border: 1px solid rgba(197,242,119,.2);\n      color: var(--green);\n      padding: 5px 7px;\n      border-radius: 4px;\n      font: 8px var(--mono);\n      text-transform: uppercase;\n      letter-spacing: .07em;\n    }\n\n    .metric-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }\n\n    .metric {\n      border: 1px solid var(--line);\n      background: rgba(255,255,255,.018);\n      border-radius: 6px;\n      padding: 10px;\n    }\n\n    .metric-label { color: #798578; font: 8px var(--mono); }\n    .metric-value { margin-top: 8px; font: 17px var(--mono); color: #e9eee4; }\n    .metric-change { margin-top: 4px; color: var(--green); font: 8px var(--mono); }\n\n    .chart-card {\n      margin-top: 10px;\n      padding: 12px 11px 7px;\n      border: 1px solid var(--line);\n      border-radius: 6px;\n      height: 145px;\n      position: relative;\n    }\n\n    .chart-top {\n      display: flex;\n      justify-content: space-between;\n      color: #879385;\n      font: 8px var(--mono);\n    }\n\n    .chart-top strong { color: #d5ddd1; font-weight: 400; }\n    .chart-svg { width: 100%; height: 100px; margin-top: 5px; overflow: visible; }\n\n    .query {\n      margin-top: 10px;\n      padding: 11px 12px;\n      border: 1px solid var(--line);\n      border-radius: 6px;\n      background: #121814;\n      color: #9aa598;\n      font: 9px/1.7 var(--mono);\n      white-space: nowrap;\n      overflow: hidden;\n    }\n\n    .query .kw { color: #c6ed84; }\n    .query .fn { color: #8ec9d7; }\n    .query .str { color: #dba878; }\n\n    .float-tag {\n      position: absolute;\n      right: -24px;\n      bottom: 48px;\n      background: #d1f38e;\n      color: #27351d;\n      border-radius: 7px;\n      padding: 11px 13px;\n      box-shadow: 0 12px 30px rgba(0,0,0,.3);\n      font: 10px var(--mono);\n      transform: rotate(2deg);\n    }\n\n    .float-tag strong { display: block; font-size: 14px; margin-bottom: 3px; }\n\n    .trusted {\n      border-top: 1px solid var(--line);\n      border-bottom: 1px solid var(--line);\n      padding: 25px 0;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 20px;\n    }\n\n    .trusted-label {\n      color: #748074;\n      font: 10px var(--mono);\n      text-transform: uppercase;\n      letter-spacing: .11em;\n    }\n\n    .trust-list {\n      display: flex;\n      align-items: center;\n      gap: clamp(20px, 5vw, 60px);\n      color: #8d988b;\n      font-size: 14px;\n      font-weight: 650;\n      letter-spacing: -.04em;\n    }\n\n    .trust-list span:nth-child(2) { font-family: Georgia, serif; font-style: italic; }\n    .trust-list span:nth-child(3) { letter-spacing: .12em; font-size: 11px; }\n    .trust-list span:nth-child(4) { font-weight: 800; }\n\n    section { scroll-margin-top: 30px; }\n\n    .features { padding: 103px 0 105px; }\n\n    .section-intro {\n      display: flex;\n      justify-content: space-between;\n      align-items: end;\n      gap: 40px;\n      margin-bottom: 40px;\n    }\n\n    .section-kicker {\n      color: var(--green);\n      font: 10px var(--mono);\n      text-transform: uppercase;\n      letter-spacing: .13em;\n      margin-bottom: 15px;\n    }\n\n    h2 {\n      font-size: clamp(31px, 4vw, 43px);\n      line-height: 1.08;\n      letter-spacing: -.055em;\n      margin: 0;\n      font-weight: 600;\n    }\n\n    .section-intro p {\n      max-width: 350px;\n      color: var(--muted);\n      font-size: 14px;\n      line-height: 1.7;\n      margin: 0 0 3px;\n    }\n\n    .feature-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 12px;\n    }\n\n    .feature-card {\n      min-height: 212px;\n      padding: 24px;\n      border: 1px solid var(--line);\n      border-radius: 8px;\n      background: linear-gradient(145deg, rgba(255,255,255,.025), rgba(255,255,255,.008));\n    }\n\n    .feature-icon {\n      width: 35px;\n      height: 35px;\n      display: grid;\n      place-items: center;\n      border-radius: 8px;\n      border: 1px solid rgba(197,242,119,.21);\n      color: var(--green);\n      margin-bottom: 27px;\n    }\n\n    .feature-icon svg { width: 17px; height: 17px; }\n\n    .feature-card h3 {\n      font-size: 15px;\n      letter-spacing: -.02em;\n      margin: 0 0 9px;\n    }\n\n    .feature-card p {\n      color: #929d91;\n      font-size: 12px;\n      line-height: 1.65;\n      margin: 0;\n      max-width: 290px;\n    }\n\n    .code-section {\n      background: #151c17;\n      border-top: 1px solid var(--line);\n      border-bottom: 1px solid var(--line);\n      padding: 82px 0;\n    }\n\n    .code-layout {\n      display: grid;\n      grid-template-columns: .88fr 1.12fr;\n      gap: 76px;\n      align-items: center;\n    }\n\n    .code-copy p {\n      color: var(--muted);\n      font-size: 14px;\n      line-height: 1.75;\n      margin: 18px 0 24px;\n      max-width: 400px;\n    }\n\n    .text-link {\n      color: var(--green);\n      font-size: 13px;\n      font-weight: 600;\n    }\n\n    .text-link span { margin-left: 7px; }\n\n    .code-window {\n      border: 1px solid rgba(233,242,230,.14);\n      border-radius: 9px;\n      background: #101511;\n      overflow: hidden;\n      box-shadow: 0 22px 60px rgba(0,0,0,.2);\n    }\n\n    .code-head {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 13px 16px;\n      border-bottom: 1px solid var(--line);\n      color: #829080;\n      font: 10px var(--mono);\n    }\n\n    .code-head .copy { color: #728071; }\n\n    pre {\n      margin: 0;\n      padding: 20px 22px 24px;\n      overflow: auto;\n      color: #bac5b8;\n      font: 11px/1.85 var(--mono);\n    }\n\n    .line-no { color: #586558; display: inline-block; width: 24px; user-select: none; }\n    .code-key { color: #c7ef83; }\n    .code-blue { color: #8dccd6; }\n    .code-orange { color: #e0ac77; }\n    .code-comment { color: #647263; }\n\n    .bottom-cta {\n      padding: 96px 0 102px;\n      text-align: center;\n      background: radial-gradient(ellipse at center, rgba(160, 207, 91, .09), transparent 55%);\n    }\n\n    .bottom-cta h2 { max-width: 640px; margin: 0 auto; }\n    .bottom-cta p { color: var(--muted); font-size: 14px; margin: 17px 0 25px; }\n    .bottom-cta .hero-actions { justify-content: center; }\n\n    footer {\n      border-top: 1px solid var(--line);\n      padding: 24px 0;\n      color: #758174;\n      font-size: 11px;\n    }\n\n    .footer-inner { display: flex; justify-content: space-between; align-items: center; }\n    .footer-brand { display: flex; align-items: center; gap: 9px; color: #b5beb1; font-weight: 650; }\n    .footer-brand .brand-mark { width: 22px; height: 22px; border-radius: 6px; }\n    .footer-brand .brand-mark svg { width: 14px; height: 14px; }\n    .footer-links { display: flex; gap: 22px; }\n    .footer-links a:hover { color: var(--green); }\n\n    @media (max-width: 900px) {\n      .hero { grid-template-columns: 1fr; gap: 52px; padding-top: 65px; }\n      .hero-content { max-width: 650px; }\n      .product-window { max-width: 650px; width: 100%; margin: 0 auto; transform: none; }\n      .float-tag { right: -10px; }\n      .code-layout { gap: 40px; }\n      .trusted { align-items: flex-start; flex-direction: column; }\n    }\n\n    @media (max-width: 650px) {\n      .shell { width: min(100% - 36px, 540px); }\n      header { height: 66px; }\n      nav { display: none; }\n      .github-link { display: none; }\n      .nav-actions { gap: 0; }\n      .announcement { font-size: 10px; }\n      .hero { min-height: unset; padding: 58px 0 65px; gap: 42px; }\n      h1 { font-size: clamp(43px, 13vw, 60px); }\n      .hero-copy { font-size: 14px; }\n      .hero-actions { flex-wrap: wrap; }\n      .button { padding: 11px 13px; }\n      .app-body { grid-template-columns: 105px 1fr; min-height: 340px; }\n      .sidebar { padding: 15px 7px; }\n      .side-item { font-size: 9px; gap: 6px; padding: 7px 5px; }\n      .workspace { padding: 16px 11px; }\n      .metric { padding: 7px; }\n      .metric-value { font-size: 13px; }\n      .metric-label, .metric-change { font-size: 7px; }\n      .chart-card { height: 128px; padding: 10px 7px 5px; }\n      .chart-svg { height: 85px; }\n      .query { font-size: 8px; }\n      .float-tag { right: 7px; bottom: 16px; padding: 8px 10px; }\n      .float-tag strong { font-size: 12px; }\n      .trust-list { gap: 22px; flex-wrap: wrap; font-size: 12px; }\n      .features { padding: 72px 0; }\n      .section-intro { display: block; }\n      .section-intro p { margin-top: 16px; }\n      .feature-grid { grid-template-columns: 1fr; }\n      .feature-card { min-height: 185px; }\n      .feature-icon { margin-bottom: 20px; }\n      .code-section { padding: 68px 0; }\n      .code-layout { grid-template-columns: 1fr; gap: 30px; }\n      pre { padding: 16px; font-size: 9px; }\n      .bottom-cta { padding: 75px 0; }\n      .footer-inner { align-items: flex-start; flex-direction: column; gap: 17px; }\n      .footer-links { gap: 16px; flex-wrap: wrap; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      html { scroll-behavior: auto; }\n      *, *::before, *::after { transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"announcement\">\n    <span>\u2733</span> Foundry 2.4 is here \u2014 faster ingestion, smarter indexing\n    <a href=\"#features\">See what\u2019s new \u2192</a>\n  </div>\n\n  <header class=\"shell\">\n    <a class=\"brand\" href=\"#\" aria-label=\"Foundry home\">\n      <span class=\"brand-mark\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\">\n          <path d=\"M5 7.5 12 4l7 3.5-7 3.5L5 7.5Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/>\n          <path d=\"M5 12l7 3.5 7-3.5M5 16.5 12 20l7-3.5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </svg>\n      </span>\n      foundry\n    </a>\n\n    <nav aria-label=\"Main navigation\">\n      <a href=\"#features\">Why Foundry</a>\n      <a href=\"#developers\">Developers</a>\n      <a href=\"#community\">Community</a>\n      <a href=\"#docs\">Docs</a>\n    </nav>\n\n    <div class=\"nav-actions\">\n      <a class=\"github-link\" href=\"#community\" aria-label=\"GitHub\">\n        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\">\n          <path d=\"M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.08c-3.1.68-3.76-1.31-3.76-1.31-.5-1.28-1.24-1.62-1.24-1.62-1.01-.69.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15 1 .1.77 2.12 3.94 1.5.1-.72.39-1.21.7-1.49-2.48-.28-5.09-1.24-5.09-5.52 0-1.22.44-2.21 1.15-2.99-.12-.28-.5-1.42.11-2.95 0 0 .94-.3 3.05 1.14a10.62 10.62 0 0 1 5.55 0c2.11-1.44 3.04-1.14 3.04-1.14.61 1.53.23 2.67.12 2.95.71.78 1.14 1.77 1.14 2.99 0 4.29-2.61 5.23-5.1 5.5.4.35.76 1.03.76 2.08v3.07c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z\"/>\n        </svg>\n        GitHub\n      </a>\n      <a class=\"button button-primary\" href=\"#get-started\">Get started <span aria-hidden=\"true\">\u2197</span></a>\n    </div>\n  </header>\n\n  <main>\n    <section class=\"hero shell\">\n      <div class=\"hero-content\">\n        <div class=\"eyebrow\">The database built for your data stack</div>\n        <h1>Your data.<br />Your rules.<br /><em>At any scale.</em></h1>\n        <p class=\"hero-copy\">\n          Meet the open-source database that keeps up with your pipelines.\n          Query, transform, and serve your data without handing over the keys.\n        </p>\n        <div class=\"hero-actions\">\n          <a class=\"button button-primary\" href=\"#get-started\">Start building <span aria-hidden=\"true\">\u2192</span></a>\n          <a class=\"button button-outline\" href=\"#developers\">Explore the docs</a>\n        </div>\n        <div class=\"hero-note\"><span>$</span> docker run -d foundrydb/foundry:latest</div>\n      </div>\n\n      <div class=\"product-window\" aria-label=\"Preview of the Foundry database console\">\n        <div class=\"window-top\">\n          <span class=\"dot\"></span><span class=\"dot\"></span><span class=\"dot\"></span>\n          <span class=\"window-title\">foundry / analytics / overview</span>\n        </div>\n        <div class=\"app-body\">\n          <aside class=\"sidebar\">\n            <div class=\"side-label\">Workspace</div>\n            <div class=\"side-item active\"><span class=\"side-icon\"></span>Overview</div>\n            <div class=\"side-item\"><span class=\"side-icon\"></span>SQL editor</div>\n            <div class=\"side-item\"><span class=\"side-icon\"></span>Pipelines</div>\n            <div class=\"side-item\"><span class=\"side-icon\"></span>Tables</div>\n            <div class=\"side-item\"><span class=\"side-icon\"></span>Monitoring</div>\n            <div class=\"side-label\" style=\"margin-top:20px\">Connections</div>\n            <div class=\"side-item\"><span class=\"side-icon\"></span>warehouse_prod</div>\n            <div class=\"side-item\"><span class=\"side-icon\"></span>events_stream</div>\n          </aside>\n          <div class=\"workspace\">\n            <div class=\"workspace-head\">\n              <div>\n                <h3>Good morning, Alex</h3>\n                <p>Here\u2019s what\u2019s happening with your data.</p>\n              </div>\n              <div class=\"live\">\u25cf system healthy</div>\n            </div>\n            <div class=\"metric-row\">\n              <div class=\"metric\">\n                <div class=\"metric-label\">ROWS PROCESSED</div>\n                <div class=\"metric-value\">8.42M</div>\n                <div class=\"metric-change\">\u2197 12.8%</div>\n              </div>\n              <div class=\"metric\">\n                <div class=\"metric-label\">QUERY LATENCY</div>\n                <div class=\"metric-value\">24<span style=\"font-size:10px\">ms</span></div>\n                <div class=\"metric-change\">\u2198 8.3%</div>\n              </div>\n              <div class=\"metric\">\n                <div class=\"metric-label\">ACTIVE JOBS</div>\n                <div class=\"metric-value\">16</div>\n                <div class=\"metric-change\" style=\"color:#a5b19f\">all running</div>\n              </div>\n            </div>\n            <div class=\"chart-card\">\n              <div class=\"chart-top\"><strong>Ingestion throughput</strong><span>Last 24 hours\u3000\u2304</span></div>\n              <svg class=\"chart-svg\" viewBox=\"0 0 440 100\" preserveAspectRatio=\"none\" aria-hidden=\"true\">\n                <defs>\n                  <linearGradient id=\"fill\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\">\n                    <stop offset=\"0\" stop-color=\"#b9ed70\" stop-opacity=\".24\"/>\n                    <stop offset=\"1\" stop-color=\"#b9ed70\" stop-opacity=\"0\"/>\n                  </linearGradient>\n                </defs>\n                <path d=\"M0 78H440M0 52H440M0 26H440\" stroke=\"#29342b\" stroke-width=\"1\"/>\n                <path d=\"M0 71 C22 65 24 73 43 59 S67 65 82 52 S109 60 127 43 S151 48 167 39 S193 48 211 33 S235 46 251 29 S275 39 292 21 S317 36 334 25 S359 30 376 15 S402 28 418 12 L440 17 V100 H0Z\" fill=\"url(#fill)\"/>\n                <path d=\"M0 71 C22 65 24 73 43 59 S67 65 82 52 S109 60 127 43 S151 48 167 39 S193 48 211 33 S235 46 251 29 S275 39 292 21 S317 36 334 25 S359 30 376 15 S402 28 418 12 L440 17\" fill=\"none\" stroke=\"#c5f277\" stroke-width=\"2\"/>\n                <circle cx=\"418\" cy=\"12\" r=\"3.2\" fill=\"#d8ff9c\"/>\n              </svg>\n            </div>\n            <div class=\"query\"><span class=\"kw\">SELECT</span> <span class=\"fn\">date_trunc</span>(<span class=\"str\">'hour'</span>, created_at), <span class=\"fn\">count</span>(*)<br /> <span class=\"kw\">FROM</span> events <span class=\"kw\">WHERE</span> created_at &gt; <span class=\"fn\">now</span>() - <span class=\"str\">interval '24 hours'</span></div>\n          </div>\n        </div>\n        <div class=\"float-tag\"><strong>99.99%</strong> pipeline uptime</div>\n      </div>\n    </section>\n\n    <div class=\"shell trusted\" aria-label=\"Used by teams at\">\n      <div class=\"trusted-label\">Built in the open.<br />Trusted in production.</div>\n      <div class=\"trust-list\">\n        <span>\u25c8 northstar</span>\n        <span>fieldnotes</span>\n        <span>LOOM</span>\n        <span>\u25b3 vertex</span>\n        <span>evergreen</span>\n      </div>\n    </div>\n\n    <section class=\"features shell\" id=\"features\">\n      <div class=\"section-intro\">\n        <div>\n          <div class=\"section-kicker\">Powerful by default</div>\n          <h2>Less plumbing.<br />More building.</h2>\n        </div>\n        <p>Everything your data team needs to move from raw events to reliable answers\u2014without stitching together a dozen tools.</p>\n      </div>\n      <div class=\"feature-grid\">\n        <article class=\"feature-card\">\n          <div class=\"feature-icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M4 5h16M4 12h10M4 19h16M17 9l3 3-3 3\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          </div>\n          <h3>SQL that feels like home</h3>\n          <p>Use familiar SQL, powerful functions, and a query planner built to keep complex workloads moving.</p>\n        </article>\n        <article class=\"feature-card\">\n          <div class=\"feature-icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M5 7.5 12 4l7 3.5-7 3.5-7-3.5ZM5 12l7 3.5 7-3.5M5 16.5 12 20l7-3.5\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linejoin=\"round\"/></svg>\n          </div>\n          <h3>Streaming, without the sprawl</h3>\n          <p>Ingest events in real time and join them with historical data in one dependable place.</p>\n        </article>\n        <article class=\"feature-card\">\n          <div class=\"feature-icon\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 3 5 6v5c0 4.6 2.9 8.4 7 10 4.1-1.6 7-5.4 7-10V6l-7-3Z\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linejoin=\"round\"/><path d=\"m9 12 2 2 4-4\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          </div>\n          <h3>Open source. No surprises.</h3>\n          <p>Self-host it, inspect every line, and keep ownership of your data. Your infrastructure, your call.</p>\n        </article>\n      </div>\n    </section>\n\n    <section class=\"code-section\" id=\"developers\">\n      <div class=\"shell code-layout\">\n        <div class=\"code-copy\">\n          <div class=\"section-kicker\">Made for the way you work</div>\n          <h2>From first query<br />to full pipeline.</h2>\n          <p>Go from zero to your first live dataset in minutes. Foundry fits into your existing stack and stays out of your way.</p>\n          <a class=\"text-link\" href=\"#docs\">Read the quickstart <span>\u2192</span></a>\n        </div>\n        <div class=\"code-window\">\n          <div class=\"code-head\"><span>quickstart.sql</span><span class=\"copy\">SQL</span></div>\n          <pre><span class=\"line-no\">1</span><span class=\"code-comment\">-- Create a table for incoming events</span>\n<span class=\"line-no\">2</span><span class=\"code-key\">CREATE TABLE</span> product_events (\n<span class=\"line-no\">3</span>  event_id   <span class=\"code-blue\">UUID</span>,\n<span class=\"line-no\">4</span>  user_id    <span class=\"code-blue\">STRING</span>,\n<span class=\"line-no\">5</span>  event_name <span class=\"code-blue\">STRING</span>,\n<span class=\"line-no\">6</span>  created_at <span class=\"code-blue\">TIMESTAMP</span>\n<span class=\"line-no\">7</span>);\n<span class=\"line-no\">8</span>\n<span class=\"line-no\">9</span><span class=\"code-key\">SELECT</span> event_name, <span class=\"code-orange\">COUNT</span>(*) <span class=\"code-key\">AS</span> total\n<span class=\"line-no\">10</span><span class=\"code-key\">FROM</span> product_events\n<span class=\"line-no\">11</span><span class=\"code-key\">WHERE</span> created_at &gt; <span class=\"code-orange\">NOW</span>() - <span class=\"code-orange\">INTERVAL</span> <span class=\"code-blue\">'1 day'</span>\n<span class=\"line-no\">12</span><span class=\"code-key\">GROUP BY</span> event_name\n<span class=\"line-no\">13</span><span class=\"code-key\">ORDER BY</span> total <span class=\"code-key\">DESC</span>;</pre>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"bottom-cta\" id=\"get-started\">\n      <div class=\"shell\">\n        <div class=\"section-kicker\">Your next query starts here</div>\n        <h2>Build on data you can<br />actually call your own.</h2>\n        <p>Open source, production ready, and made for the people who move data.</p>\n        <div class=\"hero-actions\">\n          <a class=\"button button-primary\" href=\"#docs\">Get started for free <span aria-hidden=\"true\">\u2192</span></a>\n          <a class=\"button button-outline\" href=\"#community\">Join the community</a>\n        </div>\n      </div>\n    </section>\n  </main>\n\n  <footer id=\"community\">\n    <div class=\"shell footer-inner\">\n      <a class=\"footer-brand\" href=\"#\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M5 7.5 12 4l7 3.5-7 3.5L5 7.5ZM5 12l7 3.5 7-3.5M5 16.5 12 20l7-3.5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/></svg>\n        </span>\n        foundry <span style=\"color:#647064;font-weight:400\">\u00a9 2025</span>\n      </a>\n      <div class=\"footer-links\" id=\"docs\">\n        <a href=\"#features\">Product</a>\n        <a href=\"#developers\">Documentation</a>\n        <a href=\"#community\">GitHub</a>\n        <a href=\"#community\">Community</a>\n        <a href=\"#community\">Status</a>\n      </div>\n    </div>\n  </footer>\n</body>\n</html>\n"}