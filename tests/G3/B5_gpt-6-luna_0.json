{"brief": "B5", "model": "openai/gpt-6-luna", "i": 0, "finish": "stop", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#f7f6ef\">\n  <meta name=\"description\" content=\"Walk-in sexual health care in a welcoming, respectful setting.\">\n  <title>Kindred Health \u2014 Walk-in Sexual Health Care</title>\n  <!-- Replace the sample clinic details and hours with verified information before publishing. -->\n  <style>\n    :root {\n      --ink: #173b35;\n      --muted: #536862;\n      --green: #28594e;\n      --green-dark: #1b463e;\n      --mint: #e5eee7;\n      --cream: #f7f6ef;\n      --white: #fffefa;\n      --coral: #ed896e;\n      --line: #dce3dc;\n      --shadow: 0 18px 50px rgba(25, 59, 51, .09);\n      --radius: 22px;\n    }\n\n    * { box-sizing: border-box; }\n    html { scroll-behavior: smooth; }\n    body {\n      margin: 0;\n      background: var(--cream);\n      color: var(--ink);\n      font: 16px/1.6 system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n    }\n    a { color: inherit; }\n    a:focus-visible, summary:focus-visible {\n      outline: 3px solid var(--coral);\n      outline-offset: 4px;\n      border-radius: 4px;\n    }\n    .wrap { width: min(1120px, calc(100% - 40px)); margin-inline: auto; }\n    .skip-link {\n      position: absolute; left: 12px; top: -60px; z-index: 10;\n      padding: 10px 14px; background: var(--white); color: var(--ink);\n    }\n    .skip-link:focus { top: 12px; }\n\n    header { padding: 20px 0; }\n    .nav {\n      display: flex; align-items: center; justify-content: space-between; gap: 24px;\n    }\n    .brand {\n      display: inline-flex; align-items: center; gap: 10px;\n      text-decoration: none; font-size: 1.15rem; font-weight: 800; letter-spacing: -.04em;\n    }\n    .brand-mark {\n      width: 36px; height: 36px; display: grid; place-items: center;\n      border-radius: 50%; background: var(--green); color: white;\n    }\n    .brand-mark svg { width: 21px; height: 21px; }\n    nav { display: flex; align-items: center; gap: 28px; }\n    nav a { text-decoration: none; color: var(--muted); font-size: .94rem; font-weight: 650; }\n    nav a:hover { color: var(--green-dark); }\n    .nav-cta, .button {\n      display: inline-flex; justify-content: center; align-items: center; gap: 9px;\n      min-height: 48px; padding: 0 20px; border-radius: 999px;\n      background: var(--green); color: white; text-decoration: none;\n      font-weight: 750; border: 2px solid var(--green); transition: .2s ease;\n    }\n    .nav-cta:hover, .button:hover { background: var(--green-dark); border-color: var(--green-dark); }\n    .button.secondary { color: var(--green); background: transparent; }\n    .button.secondary:hover { color: white; background: var(--green); }\n\n    .hero { padding: 48px 0 74px; }\n    .hero-grid {\n      display: grid; grid-template-columns: 1.04fr .96fr; gap: 64px; align-items: center;\n    }\n    .eyebrow {\n      display: inline-flex; align-items: center; gap: 8px;\n      color: var(--green); text-transform: uppercase; font-size: .76rem;\n      font-weight: 800; letter-spacing: .12em;\n    }\n    .eyebrow::before {\n      content: \"\"; width: 8px; height: 8px; background: var(--coral); border-radius: 50%;\n    }\n    h1, h2, h3, p { margin-top: 0; }\n    h1 {\n      max-width: 650px; margin: 18px 0;\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: clamp(3rem, 6vw, 5.3rem); line-height: .99; letter-spacing: -.055em;\n      font-weight: 500;\n    }\n    .hero-copy { max-width: 520px; color: var(--muted); font-size: 1.13rem; }\n    .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }\n    .reassurance {\n      display: flex; align-items: center; gap: 10px; margin-top: 22px;\n      color: var(--muted); font-size: .9rem;\n    }\n    .reassurance svg { color: var(--green); flex: 0 0 auto; }\n\n    .hero-art {\n      min-height: 390px; position: relative; display: grid; place-items: center;\n      overflow: hidden; border-radius: 42% 42% 25px 25px; background: var(--mint);\n    }\n    .sun {\n      position: absolute; width: 220px; height: 220px; border-radius: 50%;\n      background: #f4c3a9; right: 12%; top: 13%; opacity: .85;\n    }\n    .art-ring {\n      position: absolute; width: 330px; height: 330px; border: 1px solid rgba(40,89,78,.2);\n      border-radius: 50%; transform: rotate(-24deg);\n    }\n    .art-ring::after {\n      content: \"\"; position: absolute; right: 23px; top: 36px; width: 15px; height: 15px;\n      border-radius: 50%; background: var(--green);\n    }\n    .plant {\n      position: absolute; bottom: 0; left: 8%; width: 100px; height: 160px;\n      border-left: 5px solid var(--green); border-radius: 50%;\n      transform: rotate(-17deg);\n    }\n    .plant::before, .plant::after {\n      content: \"\"; position: absolute; width: 55px; height: 27px;\n      border-radius: 100% 0 100% 0; background: #71947c;\n    }\n    .plant::before { left: -50px; top: 50px; transform: rotate(-26deg); }\n    .plant::after { left: 0; top: 95px; transform: rotate(18deg) scaleX(-1); }\n    .care-card {\n      position: relative; z-index: 1; width: min(310px, 78%); padding: 28px;\n      border-radius: 24px; background: var(--white); box-shadow: var(--shadow);\n      transform: rotate(2deg);\n    }\n    .care-card .mini-label { color: var(--green); font-size: .75rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }\n    .care-card h2 { margin: 10px 0 8px; font: 500 2rem/1.1 Georgia, serif; letter-spacing: -.03em; }\n    .care-card p { margin: 0; color: var(--muted); font-size: .95rem; }\n    .card-check {\n      display: inline-grid; place-items: center; width: 40px; height: 40px;\n      margin-bottom: 15px; border-radius: 50%; background: var(--mint); color: var(--green);\n    }\n\n    .quick-info {\n      display: grid; grid-template-columns: repeat(3, 1fr);\n      margin-top: -1px; background: var(--green); color: white; border-radius: var(--radius);\n      padding: 25px 30px;\n    }\n    .quick-item { display: flex; gap: 14px; align-items: center; padding: 4px 22px; }\n    .quick-item + .quick-item { border-left: 1px solid rgba(255,255,255,.25); }\n    .quick-item svg { flex: 0 0 auto; color: #f3bd9e; }\n    .quick-item strong { display: block; font-size: .98rem; }\n    .quick-item span { display: block; color: #dce8e1; font-size: .88rem; }\n\n    section.content-section { padding: 88px 0; }\n    .section-heading { max-width: 640px; margin-bottom: 34px; }\n    .section-heading h2 {\n      margin: 12px 0; font: 500 clamp(2.3rem, 4vw, 3.5rem)/1.06 Georgia, serif;\n      letter-spacing: -.045em;\n    }\n    .section-heading p { color: var(--muted); font-size: 1.04rem; }\n    .service-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }\n    .service-card {\n      padding: 24px 22px; background: var(--white); border: 1px solid var(--line);\n      border-radius: 18px; min-height: 210px;\n    }\n    .service-icon {\n      display: grid; place-items: center; width: 44px; height: 44px; margin-bottom: 24px;\n      border-radius: 14px; color: var(--green); background: var(--mint);\n    }\n    .service-icon svg { width: 22px; height: 22px; }\n    .service-card h3 { margin-bottom: 8px; font-size: 1.04rem; }\n    .service-card p { margin: 0; color: var(--muted); font-size: .91rem; }\n    .note { margin: 20px 0 0; color: var(--muted); font-size: .88rem; }\n\n    .visit {\n      padding: 58px; display: grid; grid-template-columns: 1fr 1fr; gap: 50px;\n      align-items: center; border-radius: 28px; background: #e9eee4;\n    }\n    .visit h2 { margin: 12px 0; font: 500 clamp(2.2rem, 4vw, 3.3rem)/1.05 Georgia, serif; letter-spacing: -.045em; }\n    .visit p { color: var(--muted); }\n    .visit-details { display: grid; gap: 14px; }\n    .detail {\n      padding: 18px 20px; background: var(--white); border-radius: 15px;\n      display: flex; gap: 14px; align-items: flex-start;\n    }\n    .detail svg { flex: 0 0 auto; color: var(--green); margin-top: 2px; }\n    .detail strong { display: block; font-size: .92rem; }\n    .detail span { display: block; color: var(--muted); font-size: .9rem; }\n    .hours { margin-top: 5px; width: 100%; border-collapse: collapse; }\n    .hours td { padding: 3px 0; color: var(--muted); font-size: .88rem; }\n    .hours td:last-child { text-align: right; color: var(--ink); font-weight: 650; }\n\n    .steps-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }\n    .step { padding-top: 20px; border-top: 1px solid var(--line); }\n    .step-number {\n      width: 36px; height: 36px; display: grid; place-items: center; margin-bottom: 18px;\n      border-radius: 50%; background: var(--green); color: white; font-weight: 750;\n    }\n    .step h3 { margin-bottom: 8px; font-size: 1.08rem; }\n    .step p { margin: 0; color: var(--muted); font-size: .95rem; }\n\n    .faq { background: var(--white); }\n    .faq-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 70px; }\n    .faq-list details { padding: 19px 0; border-bottom: 1px solid var(--line); }\n    .faq-list summary {\n      cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 20px;\n      font-weight: 700;\n    }\n    .faq-list summary::-webkit-details-marker { display: none; }\n    .faq-list summary::after { content: \"+\"; color: var(--green); font-size: 1.3rem; line-height: 1; }\n    .faq-list details[open] summary::after { content: \"\u2212\"; }\n    .faq-list details p { margin: 12px 32px 0 0; color: var(--muted); font-size: .94rem; }\n\n    .urgent {\n      display: flex; gap: 16px; align-items: flex-start; margin-top: 54px; padding: 20px 22px;\n      border: 1px solid #e7c6b8; border-radius: 15px; background: #fff7f2;\n    }\n    .urgent svg { flex: 0 0 auto; color: #a64c37; }\n    .urgent p { margin: 0; color: #654c43; font-size: .92rem; }\n    .urgent strong { color: #56372e; }\n\n    footer { padding: 30px 0; border-top: 1px solid var(--line); color: var(--muted); font-size: .87rem; }\n    .footer-inner { display: flex; justify-content: space-between; gap: 20px; align-items: center; }\n    footer a { color: var(--green); font-weight: 650; }\n\n    @media (max-width: 850px) {\n      nav { gap: 15px; }\n      nav a { font-size: .86rem; }\n      .hero-grid { gap: 32px; }\n      .service-grid { grid-template-columns: repeat(2, 1fr); }\n      .visit { padding: 38px; gap: 28px; }\n      .quick-info { padding: 20px 12px; }\n      .quick-item { padding: 4px 14px; }\n    }\n    @media (max-width: 650px) {\n      .wrap { width: min(100% - 32px, 520px); }\n      header { padding: 14px 0; }\n      .nav { flex-wrap: wrap; }\n      nav { order: 3; width: 100%; justify-content: space-between; gap: 10px; padding-top: 7px; }\n      nav a { font-size: .82rem; }\n      .nav-cta { min-height: 42px; padding: 0 14px; font-size: .88rem; }\n      .hero { padding: 34px 0 48px; }\n      .hero-grid { grid-template-columns: 1fr; gap: 32px; }\n      h1 { font-size: clamp(3rem, 14vw, 4.5rem); }\n      .hero-copy { font-size: 1.03rem; }\n      .hero-art { min-height: 310px; }\n      .sun { width: 180px; height: 180px; }\n      .art-ring { width: 270px; height: 270px; }\n      .quick-info { grid-template-columns: 1fr; gap: 15px; padding: 20px; }\n      .quick-item { padding: 8px 4px; }\n      .quick-item + .quick-item { border-left: 0; border-top: 1px solid rgba(255,255,255,.25); padding-top: 17px; }\n      section.content-section { padding: 62px 0; }\n      .service-grid { gap: 11px; }\n      .service-card { min-height: 0; padding: 18px 15px; }\n      .service-icon { margin-bottom: 17px; }\n      .visit { grid-template-columns: 1fr; padding: 27px 20px; }\n      .steps-grid { grid-template-columns: 1fr; gap: 22px; }\n      .faq-grid { grid-template-columns: 1fr; gap: 14px; }\n      .footer-inner { align-items: flex-start; flex-direction: column; }\n    }\n    @media (max-width: 390px) {\n      .service-grid { grid-template-columns: 1fr; }\n      .hero-actions .button { width: 100%; }\n      nav a { font-size: .76rem; }\n    }\n    @media (prefers-reduced-motion: reduce) {\n      html { scroll-behavior: auto; }\n      *, *::before, *::after { transition-duration: .01ms !important; }\n    }\n  </style>\n</head>\n<body>\n  <a class=\"skip-link\" href=\"#main\">Skip to content</a>\n\n  <header>\n    <div class=\"wrap nav\">\n      <a class=\"brand\" href=\"#top\" aria-label=\"Kindred Health home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M12 20s-7.5-4.6-7.5-10.1A4.1 4.1 0 0 1 12 7.8a4.1 4.1 0 0 1 7.5 2.1C19.5 15.4 12 20 12 20Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/>\n            <path d=\"M8.5 12h7M12 8.5v7\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n          </svg>\n        </span>\n        Kindred Health\n      </a>\n      <nav aria-label=\"Main navigation\">\n        <a href=\"#care\">Care</a>\n        <a href=\"#visit\">Visit us</a>\n        <a href=\"#faq\">FAQs</a>\n      </nav>\n      <a class=\"nav-cta\" href=\"#visit\">Plan your visit <span aria-hidden=\"true\">\u2192</span></a>\n    </div>\n  </header>\n\n  <main id=\"main\">\n    <section class=\"hero\" id=\"top\">\n      <div class=\"wrap hero-grid\">\n        <div>\n          <span class=\"eyebrow\">Walk-in sexual health care</span>\n          <h1>Care that meets you where you are.</h1>\n          <p class=\"hero-copy\">Questions, checkups, or something that doesn\u2019t feel right? Find respectful sexual health care in a welcoming, judgment-free space.</p>\n          <div class=\"hero-actions\">\n            <a class=\"button\" href=\"#visit\">See walk-in hours <span aria-hidden=\"true\">\u2192</span></a>\n            <a class=\"button secondary\" href=\"#care\">Explore our care</a>\n          </div>\n          <div class=\"reassurance\">\n            <svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\">\n              <path d=\"M12 3 19 6v5c0 4.7-3 8-7 10-4-2-7-5.3-7-10V6l7-3Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/>\n              <path d=\"m9 12 2 2 4-4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            </svg>\n            Your questions are welcome here.\n          </div>\n        </div>\n\n        <div class=\"hero-art\" aria-hidden=\"true\">\n          <div class=\"sun\"></div>\n          <div class=\"art-ring\"></div>\n          <div class=\"plant\"></div>\n          <div class=\"care-card\">\n            <span class=\"card-check\">\n              <svg width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\">\n                <path d=\"m5 12 4.5 4.5L19 7\" stroke=\"currentColor\" stroke-width=\"2.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n            </span>\n            <div class=\"mini-label\">A good place to start</div>\n            <h2>Come as you are.</h2>\n            <p>No referral needed. Our team will help you figure out what comes next.</p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <div class=\"wrap\">\n      <div class=\"quick-info\" aria-label=\"Clinic highlights\">\n        <div class=\"quick-item\">\n          <svg aria-hidden=\"true\" width=\"25\" height=\"25\" viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M12 21s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z\" stroke=\"currentColor\" stroke-width=\"1.7\"/>\n            <circle cx=\"12\" cy=\"9\" r=\"2.3\" stroke=\"currentColor\" stroke-width=\"1.7\"/>\n          </svg>\n          <div><strong>Easy to find</strong><span>[Clinic address, City]</span></div>\n        </div>\n        <div class=\"quick-item\">\n          <svg aria-hidden=\"true\" width=\"25\" height=\"25\" viewBox=\"0 0 24 24\" fill=\"none\">\n            <circle cx=\"12\" cy=\"12\" r=\"9\" stroke=\"currentColor\" stroke-width=\"1.7\"/>\n            <path d=\"M12 7v5l3.5 2\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/>\n          </svg>\n          <div><strong>Walk-ins welcome</strong><span>During listed clinic hours</span></div>\n        </div>\n        <div class=\"quick-item\">\n          <svg aria-hidden=\"true\" width=\"25\" height=\"25\" viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M4 6.5h16M4 12h10M4 17.5h13\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n            <circle cx=\"18\" cy=\"12\" r=\"2\" stroke=\"currentColor\" stroke-width=\"1.7\"/>\n          </svg>\n          <div><strong>Questions are okay</strong><span>We\u2019ll talk through your options</span></div>\n        </div>\n      </div>\n    </div>\n\n    <section class=\"content-section\" id=\"care\">\n      <div class=\"wrap\">\n        <div class=\"section-heading\">\n          <span class=\"eyebrow\">Care, without the awkward</span>\n          <h2>Support for your sexual wellbeing.</h2>\n          <p>We\u2019re here to listen and help you understand your options. Services may vary by day\u2014contact the clinic if you have questions about what\u2019s available.</p>\n        </div>\n        <div class=\"service-grid\">\n          <article class=\"service-card\">\n            <span class=\"service-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M7 4.5h10v15H7zM9.5 8h5M9.5 11.5h5M9.5 15h3\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            </span>\n            <h3>STI testing &amp; information</h3>\n            <p>Talk through testing, prevention, and next steps with a care provider.</p>\n          </article>\n          <article class=\"service-card\">\n            <span class=\"service-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 20s-7-4.4-7-9.5A4 4 0 0 1 12 8.4a4 4 0 0 1 7 2.1c0 5.1-7 9.5-7 9.5Z\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linejoin=\"round\"/><path d=\"M8.5 13h7\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/></svg>\n            </span>\n            <h3>Birth control options</h3>\n            <p>Explore contraception choices and find out what may suit you.</p>\n          </article>\n          <article class=\"service-card\">\n            <span class=\"service-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6 5.6 18.4\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/></svg>\n            </span>\n            <h3>Gender-affirming care</h3>\n            <p>Find respectful support and information for your health journey.</p>\n          </article>\n          <article class=\"service-card\">\n            <span class=\"service-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 21s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z\" stroke=\"currentColor\" stroke-width=\"1.7\"/><path d=\"M12 6.5v5l3 1.8\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/></svg>\n            </span>\n            <h3>Symptoms &amp; concerns</h3>\n            <p>Get care and guidance if something feels different or worrying.</p>\n          </article>\n        </div>\n        <p class=\"note\">Not sure what you need? That\u2019s okay. You can come in with a question and talk it through.</p>\n      </div>\n    </section>\n\n    <section class=\"content-section\" id=\"visit\">\n      <div class=\"wrap visit\">\n        <div>\n          <span class=\"eyebrow\">Your visit</span>\n          <h2>Just walk in.</h2>\n          <p>No referral is needed. Let the front desk know you\u2019re here, and our team will guide you through what happens next. Wait times and same-day availability can vary.</p>\n          <a class=\"button\" href=\"#how-it-works\">What to expect <span aria-hidden=\"true\">\u2192</span></a>\n        </div>\n        <div class=\"visit-details\">\n          <div class=\"detail\">\n            <svg aria-hidden=\"true\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\">\n              <path d=\"M12 21s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z\" stroke=\"currentColor\" stroke-width=\"1.7\"/>\n              <circle cx=\"12\" cy=\"9\" r=\"2.3\" stroke=\"currentColor\" stroke-width=\"1.7\"/>\n            </svg>\n            <div><strong>Find us</strong><span>[Street address, City, State ZIP]</span></div>\n          </div>\n          <div class=\"detail\">\n            <svg aria-hidden=\"true\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\">\n              <circle cx=\"12\" cy=\"12\" r=\"9\" stroke=\"currentColor\" stroke-width=\"1.7\"/>\n              <path d=\"M12 7v5l3 2\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/>\n            </svg>\n            <div style=\"width:100%\">\n              <strong>Sample walk-in hours</strong>\n              <table class=\"hours\" aria-label=\"Sample clinic hours\">\n                <tbody>\n                  <tr><td>Monday\u2013Friday</td><td>9 am\u20135 pm</td></tr>\n                  <tr><td>Saturday\u2013Sunday</td><td>Closed</td></tr>\n                </tbody>\n              </table>\n            </div>\n          </div>\n          <div class=\"detail\">\n            <svg aria-hidden=\"true\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\">\n              <path d=\"M5 4h14v16H5zM8 8h8M8 12h8M8 16h5\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            </svg>\n            <div><strong>Before you come</strong><span>Bring photo ID or insurance details if you have them. Ask us about fees and payment options.</span></div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"content-section\" id=\"how-it-works\">\n      <div class=\"wrap\">\n        <div class=\"section-heading\">\n          <span class=\"eyebrow\">Simple steps</span>\n          <h2>We\u2019ll take it one step at a time.</h2>\n        </div>\n        <div class=\"steps-grid\">\n          <article class=\"step\">\n            <span class=\"step-number\">1</span>\n            <h3>Come by during walk-in hours</h3>\n            <p>Check the hours above before you travel. You can call ahead to ask about availability: [Clinic phone number].</p>\n          </article>\n          <article class=\"step\">\n            <span class=\"step-number\">2</span>\n            <h3>Tell us what\u2019s on your mind</h3>\n            <p>Share as much or as little as you\u2019re comfortable with. We\u2019ll ask a few questions to understand how to help.</p>\n          </article>\n          <article class=\"step\">\n            <span class=\"step-number\">3</span>\n            <h3>Choose next steps together</h3>\n            <p>Your care provider can explain options and answer questions, so you can decide what feels right for you.</p>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"content-section faq\" id=\"faq\">\n      <div class=\"wrap faq-grid\">\n        <div class=\"section-heading\">\n          <span class=\"eyebrow\">Good to know</span>\n          <h2>A few things you might be wondering.</h2>\n          <p>If you have a question that isn\u2019t covered here, give us a call or ask us when you arrive.</p>\n        </div>\n        <div class=\"faq-list\">\n          <details>\n            <summary>Do I need an appointment or referral?</summary>\n            <p>No referral is needed. Walk in during the hours listed above. Wait times and availability may vary, so calling ahead can help you plan.</p>\n          </details>\n          <details>\n            <summary>Will my visit be private?</summary>\n            <p>Your privacy matters. Before care, our team can explain how your information is handled and answer questions about confidentiality, including any limits that may apply.</p>\n          </details>\n          <details>\n            <summary>How much will care cost?</summary>\n            <p>Costs depend on the services you receive and your circumstances. Contact the clinic or ask at check-in about fees, insurance, and available payment options.</p>\n          </details>\n          <details>\n            <summary>What if I\u2019m not sure what kind of care I need?</summary>\n            <p>You don\u2019t need to know before you arrive. Tell us what\u2019s concerning you, and we\u2019ll help you work out an appropriate next step.</p>\n          </details>\n        </div>\n      </div>\n    </section>\n\n    <div class=\"wrap\">\n      <aside class=\"urgent\" aria-label=\"Emergency information\">\n        <svg aria-hidden=\"true\" width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\">\n          <path d=\"M12 3 22 20H2L12 3Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/>\n          <path d=\"M12 9v5M12 17h.01\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n        </svg>\n        <p><strong>Need emergency help?</strong> This clinic is not an emergency service. If you may be in immediate danger or have a life-threatening emergency, call your local emergency number or go to the nearest emergency department.</p>\n      </aside>\n    </div>\n  </main>\n\n  <footer>\n    <div class=\"wrap footer-inner\">\n      <a class=\"brand\" href=\"#top\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">+</span>\n        Kindred Health\n      </a>\n      <span>Kind, respectful care starts with a conversation.</span>\n      <span>Call: <strong>[Clinic phone number]</strong></span>\n    </div>\n  </footer>\n</body>\n</html>\n"}