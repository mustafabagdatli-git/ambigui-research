{"brief": "B5", "model": "z-ai/glm-5.3-flashx", "i": 1, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Marrow Clinic \u2014 Walk-in Sexual Health</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400&family=Karla:wght@400;500;700&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --paper:#FAF4E9;\n    --ink:#1B2A24;\n    --green:#1E4D3E;\n    --green-deep:#14352B;\n    --terra:#D95A36;\n    --terra-soft:#F3D9CE;\n    --line:#D8CCB6;\n    --radius:14px;\n  }\n  *{margin:0;padding:0;box-sizing:border-box}\n  html{scroll-behavior:smooth}\n  body{\n    font-family:'Karla',sans-serif;\n    background:var(--paper);\n    color:var(--ink);\n    line-height:1.6;\n    -webkit-font-smoothing:antialiased;\n  }\n  h1,h2,h3,.serif{font-family:'Fraunces',serif;font-weight:600;letter-spacing:-.01em}\n  a{color:inherit}\n  .wrap{max-width:1120px;margin:0 auto;padding:0 24px}\n  ::selection{background:var(--terra);color:var(--paper)}\n\n  /* ---------- header ---------- */\n  header{\n    position:sticky;top:0;z-index:50;\n    background:rgba(250,244,233,.92);\n    backdrop-filter:blur(8px);\n    border-bottom:1px solid var(--line);\n  }\n  .nav{display:flex;align-items:center;gap:32px;height:72px}\n  .logo{display:flex;align-items:center;gap:10px;font-family:'Fraunces',serif;font-size:22px;font-weight:600;text-decoration:none}\n  .logo svg{display:block}\n  .nav-links{display:flex;gap:26px;margin-left:auto}\n  .nav-links a{text-decoration:none;font-size:15px;font-weight:500;opacity:.8}\n  .nav-links a:hover{opacity:1;color:var(--terra)}\n  .phone{font-size:15px;font-weight:700;text-decoration:none;color:var(--green)}\n  .phone:hover{color:var(--terra)}\n  @media(max-width:760px){.nav-links,.phone{display:none}}\n\n  /* ---------- ticker ---------- */\n  .ticker{\n    background:var(--green);color:var(--paper);\n    overflow:hidden;white-space:nowrap;font-size:13.5px;\n    border-bottom:1px solid var(--green-deep);\n  }\n  .ticker-track{display:inline-block;padding:8px 0;animation:slide 38s linear infinite}\n  .ticker span{margin:0 28px;opacity:.85}\n  .ticker b{color:#F0B9A5;font-weight:700}\n  @keyframes slide{from{transform:translateX(0)}to{transform:translateX(-50%)}}\n\n  /* ---------- hero ---------- */\n  .hero{padding:88px 0 72px;border-bottom:1px solid var(--line);position:relative;overflow:hidden}\n  .hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:56px;align-items:center}\n  @media(max-width:880px){.hero-grid{grid-template-columns:1fr}}\n  .kicker{\n    display:inline-flex;align-items:center;gap:8px;\n    font-size:13px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;\n    color:var(--terra);margin-bottom:22px;\n  }\n  .kicker::before{content:\"\";width:28px;height:2px;background:var(--terra)}\n  .hero h1{font-size:clamp(42px,6vw,72px);line-height:1.04;margin-bottom:24px}\n  .hero h1 em{font-style:italic;font-weight:400;color:var(--green)}\n  .hero p.lede{font-size:19px;max-width:48ch;opacity:.82;margin-bottom:34px}\n  .status-pill{\n    display:inline-flex;align-items:center;gap:10px;\n    background:#fff;border:1px solid var(--line);border-radius:999px;\n    padding:10px 18px;font-size:14.5px;font-weight:700;margin-bottom:30px;\n    box-shadow:0 2px 8px rgba(27,42,36,.06);\n  }\n  .dot{width:9px;height:9px;border-radius:50%;background:#3E9B6C;animation:pulse 2s infinite}\n  .dot.closed{background:var(--terra);animation:none}\n  @keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(62,155,108,.4)}50%{box-shadow:0 0 0 7px rgba(62,155,108,0)}}\n  .btn-row{display:flex;gap:14px;flex-wrap:wrap}\n  .btn{\n    display:inline-block;padding:15px 28px;border-radius:999px;\n    font-family:'Karla',sans-serif;font-weight:700;font-size:16px;\n    text-decoration:none;transition:transform .15s ease,background .15s ease;\n  }\n  .btn:active{transform:scale(.97)}\n  .btn-primary{background:var(--terra);color:#fff}\n  .btn-primary:hover{background:#C24A28}\n  .btn-ghost{border:1.5px solid var(--ink)}\n  .btn-ghost:hover{background:var(--ink);color:var(--paper)}\n  .hero-art{position:relative}\n  .hero-art svg{width:100%;height:auto;display:block}\n\n  /* ---------- services ---------- */\n  section{padding:80px 0}\n  .sec-head{display:flex;align-items:baseline;justify-content:space-between;gap:20px;margin-bottom:44px;flex-wrap:wrap}\n  .sec-head h2{font-size:clamp(30px,4vw,44px)}\n  .sec-head .num{font-family:'Fraunces',serif;font-style:italic;font-weight:400;color:var(--terra);font-size:15px}\n  .svc{border-top:1px solid var(--ink)}\n  .svc-row{\n    display:grid;grid-template-columns:70px 1.2fr 1.6fr 40px;gap:24px;align-items:center;\n    padding:26px 8px;border-bottom:1px solid var(--line);\n    transition:background .18s ease;cursor:default;\n  }\n  .svc-row:hover{background:#fff}\n  .svc-row .idx{font-family:'Fraunces',serif;font-style:italic;color:var(--terra);font-size:18px}\n  .svc-row h3{font-size:23px}\n  .svc-row p{font-size:15px;opacity:.72}\n  .svc-row .arrow{opacity:0;transition:opacity .18s;color:var(--terra);font-size:22px}\n  .svc-row:hover .arrow{opacity:1}\n  @media(max-width:760px){\n    .svc-row{grid-template-columns:44px 1fr;grid-template-rows:auto auto}\n    .svc-row p{grid-column:2}.svc-row .arrow{display:none}\n  }\n\n  /* ---------- visit steps ---------- */\n  .visit{background:var(--green);color:var(--paper)}\n  .visit .sec-head .num{color:#F0B9A5}\n  .steps{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border-top:1px solid rgba(250,244,233,.25)}\n  @media(max-width:880px){.steps{grid-template-columns:1fr 1fr}}\n  @media(max-width:520px){.steps{grid-template-columns:1fr}}\n  .step{padding:34px 26px 10px 0;border-right:1px solid rgba(250,244,233,.25)}\n  .step:last-child{border-right:none}\n  @media(max-width:520px){.step{border-right:none;border-bottom:1px solid rgba(250,244,233,.25);padding-bottom:30px}}\n  .step .big{font-family:'Fraunces',serif;font-size:52px;font-weight:400;font-style:italic;color:#F0B9A5;line-height:1}\n  .step h3{font-size:20px;margin:16px 0 8px}\n  .step p{font-size:15px;opacity:.78}\n\n  /* ---------- privacy ---------- */\n  .privacy-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}\n  @media(max-width:880px){.privacy-grid{grid-template-columns:1fr}}\n  .privacy h2{font-size:clamp(30px,4vw,46px);margin-bottom:22px}\n  .privacy p{font-size:17px;opacity:.82;margin-bottom:16px;max-width:52ch}\n  .pledge{list-style:none}\n  .pledge li{\n    display:flex;gap:16px;padding:18px 0;border-bottom:1px solid var(--line);\n    font-size:16.5px;\n  }\n  .pledge li:first-child{border-top:1px solid var(--ink)}\n  .pledge .tick{color:var(--terra);font-family:'Fraunces',serif;font-style:italic;font-size:20px;flex-shrink:0}\n\n  /* ---------- faq ---------- */\n  details{border-bottom:1px solid var(--line)}\n  details:first-of-type{border-top:1px solid var(--ink)}\n  summary{\n    cursor:pointer;list-style:none;padding:24px 8px;\n    font-family:'Fraunces',serif;font-size:21px;font-weight:600;\n    display:flex;justify-content:space-between;align-items:center;gap:20px;\n    transition:color .15s;\n  }\n  summary::-webkit-details-marker{display:none}\n  summary:hover{color:var(--terra)}\n  summary .plus{font-family:'Karla',sans-serif;font-weight:400;font-size:26px;color:var(--terra);transition:transform .2s}\n  details[open] .plus{transform:rotate(45deg)}\n  details .ans{padding:0 8px 26px;max-width:62ch;font-size:16px;opacity:.82}\n\n  /* ---------- cta + footer ---------- */\n  .cta-band{\n    background:var(--terra);color:#fff;text-align:center;padding:88px 24px;\n  }\n  .cta-band h2{font-size:clamp(34px,5vw,56px);margin-bottom:18px}\n  .cta-band p{opacity:.9;font-size:18px;margin-bottom:34px}\n  .cta-band .btn{background:var(--paper);color:var(--ink)}\n  .cta-band .btn:hover{background:var(--ink);color:var(--paper)}\n  footer{background:var(--green-deep);color:var(--paper);padding:64px 0 40px;font-size:15px}\n  .foot-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:48px;margin-bottom:48px}\n  @media(max-width:760px){.foot-grid{grid-template-columns:1fr}}\n  .foot-grid h4{font-family:'Fraunces',serif;font-size:18px;margin-bottom:14px;color:#F0B9A5}\n  .foot-grid p, .foot-grid li{opacity:.75}\n  .foot-grid ul{list-style:none}\n  .foot-grid li{padding:3px 0}\n  .urgent{\n    border:1px solid rgba(250,244,233,.3);border-radius:var(--radius);\n    padding:18px 22px;font-size:14.5px;background:rgba(217,90,54,.14);\n  }\n  .urgent b{color:#F0B9A5}\n  .copy{border-top:1px solid rgba(250,244,233,.2);padding-top:22px;font-size:13px;opacity:.55;display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px}\n</style>\n</head>\n<body>\n\n<header>\n  <div class=\"wrap nav\">\n    <a class=\"logo\" href=\"#\">\n      <svg width=\"30\" height=\"30\" viewBox=\"0 0 30 30\" fill=\"none\">\n        <rect width=\"30\" height=\"30\" rx=\"9\" fill=\"#1E4D3E\"/>\n        <path d=\"M15 23c-4-3.5-7.5-6.5-7.5-10A4.2 4.2 0 0 1 15 10.4 4.2 4.2 0 0 1 22.5 13c0 3.5-3.5 6.5-7.5 10Z\" fill=\"#D95A36\"/>\n      </svg>\n      Marrow&nbsp;Clinic\n    </a>\n    <nav class=\"nav-links\">\n      <a href=\"#services\">Services</a>\n      <a href=\"#visit\">Your visit</a>\n      <a href=\"#privacy\">Privacy</a>\n      <a href=\"#faq\">FAQ</a>\n    </nav>\n    <a class=\"phone\" href=\"tel:+15550174210\">(555) 017-4210</a>\n  </div>\n</header>\n\n<div class=\"ticker\" aria-hidden=\"true\">\n  <div class=\"ticker-track\" id=\"tickerTrack\">\n    <span>Walk-ins always welcome \u2014 <b>no appointment needed</b></span>\n    <span>Free &amp; confidential <b>STI testing</b></span>\n    <span><b>PrEP</b> started the same day</span>\n    <span>Judgement-free care, <b>every single time</b></span>\n    <span>Most results in <b>under 30 minutes</b></span>\n    <span>Under 25? <b>Everything's free</b></span>\n  </div>\n</div>\n\n<section class=\"hero\">\n  <div class=\"wrap hero-grid\">\n    <div>\n      <span class=\"kicker\">Walk-in sexual health clinic</span>\n      <h1>Answers today.<br><em>Zero judgement</em> always.</h1>\n      <p class=\"lede\">Testing, treatment, contraception and PrEP \u2014 no appointment, no referral, no lecture. Walk in, be seen, walk out with clarity.</p>\n      <div class=\"status-pill\" id=\"statusPill\">\n        <span class=\"dot\" id=\"statusDot\"></span>\n        <span id=\"statusText\">Checking today's hours\u2026</span>\n      </div>\n      <div class=\"btn-row\">\n        <a class=\"btn btn-primary\" href=\"#visit\">Plan your visit</a>\n        <a class=\"btn btn-ghost\" href=\"tel:+15550174210\">Call the clinic</a>\n      </div>\n    </div>\n    <div class=\"hero-art\" aria-hidden=\"true\">\n      <svg viewBox=\"0 0 420 400\" fill=\"none\">\n        <circle cx=\"215\" cy=\"200\" r=\"165\" fill=\"#1E4D3E\"/>\n        <path d=\"M215 322c-52-45-97-84-97-129a54 54 0 0 1 97-32 54 54 0 0 1 97 32c0 45-45 84-97 129Z\" fill=\"#FAF4E9\"/>\n        <path d=\"M160 193h40l14-30 20 62 16-42 10 20h42\" stroke=\"#D95A36\" stroke-width=\"7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        <circle cx=\"62\" cy=\"72\" r=\"14\" fill=\"#D95A36\"/>\n        <circle cx=\"372\" cy=\"330\" r=\"20\" fill=\"#F3D9CE\"/>\n        <path d=\"M340 40l16 34 34 16-34 16-16 34-16-34-34-16 34-16 16-34Z\" fill=\"#F0B9A5\"/>\n      </svg>\n    </div>\n  </div>\n</section>\n\n<section id=\"services\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <h2>What we do</h2>\n      <span class=\"num\">( 01 \u2014 everything is free or low-cost )</span>\n    </div>\n    <div class=\"svc\">\n      <div class=\"svc-row\">\n        <span class=\"idx\">/01</span>\n        <h3>STI &amp; HIV testing</h3>\n        <p>Swab, blood or urine \u2014 your choice where possible. Rapid HIV results in under a minute; most others within 30 minutes.</p>\n        <span class=\"arrow\">\u2192</span>\n      </div>\n      <div class=\"svc-row\">\n        <span class=\"idx\">/02</span>\n        <h3>Treatment &amp; prescriptions</h3>\n        <p>Diagnosed today, treated today. We dispense most common treatments on-site so you don't need a second stop.</p>\n        <span class=\"arrow\">\u2192</span>\n      </div>\n      <div class=\"svc-row\">\n        <span class=\"idx\">/03</span>\n        <h3>Contraception</h3>\n        <p>Pills, implants, IUDs and emergency contraception \u2014 fitted, prescribed or handed over, with honest advice on every option.</p>\n        <span class=\"arrow\">\u2192</span>\n      </div>\n      <div class=\"svc-row\">\n        <span class=\"idx\">/04</span>\n        <h3>PrEP &amp; PEP</h3>\n        <p>Start PrEP the same day you walk in. Need PEP after a possible exposure? Come straight here \u2014 any day, any hour we're open.</p>\n        <span class=\"arrow\">\u2192</span>\n      </div>\n      <div class=\"svc-row\">\n        <span class=\"idx\">/05</span>\n        <h3>Vaccines &amp; check-ups</h3>\n        <p>HPV, hepatitis A &amp; B and mpox vaccination, plus routine sexual health reviews \u2014 because prevention beats a waiting room.</p>\n        <span class=\"arrow\">\u2192</span>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"visit\" id=\"visit\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <h2>Your visit, step by step</h2>\n      <span class=\"num\">( 02 \u2014 about 40 minutes, door to door )</span>\n    </div>\n    <div class=\"steps\">\n      <div class=\"step\">\n        <div class=\"big\">i.</div>\n        <h3>Walk in</h3>\n        <p>No appointment, no paperwork from your GP. Give a first name \u2014 that's genuinely all we need at the desk.</p>\n      </div>\n      <div class=\"step\">\n        <div class=\"big\">ii.</div>\n        <h3>Tell us what matters</h3>\n        <p>A private chat with a nurse about what you'd like checked, tested or discussed. You steer the whole conversation.</p>\n      </div>\n      <div class=\"step\">\n        <div class=\"big\">iii.</div>\n        <h3>Quick, gentle testing</h3>\n        <p>Most samples are self-taken. Results are explained in plain language before you leave whenever we can.</p>\n      </div>\n      <div class=\"step\">\n        <div class=\"big\">iv.</div>\n        <h3>Treated &amp; done</h3>\n        <p>Medication on-site, a plan in writing, and free follow-up by text or call if anything needs another look.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section id=\"privacy\">\n  <div class=\"wrap privacy-grid\">\n    <div class=\"privacy\">\n      <h2>Private isn't a promise here. It's the design.</h2>\n      <p>We built this clinic so you never have to wonder who knows you came. Separate entrance, unmarked records, and staff who'd rather lose their jobs than your trust.</p>\n      <p>If you're under 25, everything \u2014 testing, treatment, contraception \u2014 is completely free, and you don't need to tell a parent to use it.</p>\n    </div>\n    <ul class=\"pledge\">\n      <li><span class=\"tick\">\u2713</span>Discreet street-level entrance \u2014 no waiting-room overlap with other services</li>\n      <li><span class=\"tick\">\u2713</span>Records never shared without your written consent</li>\n      <li><span class=\"tick\">\u2713</span>We never call or text unless you tell us it's safe to</li>\n      <li><span class=\"tick\">\u2713</span>Confidential for everyone, including under-25s</li>\n      <li><span class=\"tick\">\u2713</span>Translation and interpreting available on request</li>\n    </ul>\n  </div>\n</section>\n\n<section id=\"faq\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <h2>Questions people actually ask</h2>\n      <span class=\"num\">( 03 \u2014 no question is too awkward )</span>\n    </div>\n    <details>\n      <summary>Do I really not need an appointment? <span class=\"plus\">+</span></summary>\n      <div class=\"ans\">Really. Walk in during opening hours and you'll be seen the same visit. Busiest times are lunch and after 4pm \u2014 mornings are quickest.</div>\n    </details>\n    <details>\n      <summary>Will it show up anywhere my family could see? <span class=\"plus\">+</span></summary>\n      <div class=\"ans\">No. We don't send letters, emails or bills. Records stay inside the clinic and are only shared with other providers if you sign for it.</div>\n    </details>\n    <details>\n      <summary>How much does it cost? <span class=\"plus\">+</span></summary>\n      <div class=\"ans\">Testing, contraception and advice are free for everyone under 25 and for people on low income. Otherwise, a standard visit is a flat $20 \u2014 testing and consultation included, no surprise extras.</div>\n    </details>\n    <details>\n      <summary>I think I was exposed to HIV last night. What do I do? <span class=\"plus\">+</span></summary>\n      <div class=\"ans\">Come in now \u2014 PEP works best within 24 hours and must start within 72. If we're closed, go to any emergency department and say you need PEP. You do not need to explain more than that.</div>\n    </details>\n    <details>\n      <summary>Do I have to be examined? <span class=\"plus\">+</span></summary>\n      <div class=\"ans\">Rarely, and never without asking first. Most tests use swabs or urine you take yourself in private. You can pause or stop anything at any point.</div>\n    </details>\n  </div>\n</section>\n\n<div class=\"cta-band\">\n  <h2>Come in today.<br>Leave lighter.</h2>\n  <p>Open six days a week \u00b7 42 Marrow Lane \u00b7 no appointment, ever</p>\n  <a class=\"btn\" href=\"tel:+15550174210\">Call us: (555) 017-4210</a>\n</div>\n\n<footer>\n  <div class=\"wrap\">\n    <div class=\"foot-grid\">\n      <div>\n        <h4>Marrow Clinic</h4>\n        <p>42 Marrow Lane, Old Quarter<br>Walk-in only \u2014 we don't take bookings, and that's the point.</p>\n        <p style=\"margin-top:14px\">Mon\u2013Fri \u00b7 8:30 \u2013 19:00<br>Saturday \u00b7 10:00 \u2013 16:00<br>Sunday \u00b7 closed</p>\n      </div>\n      <div>\n        <h4>Good to know</h4>\n        <ul>\n          <li>Free under-25 care</li>\n          <li>Wheelchair accessible</li>\n          <li>Interpreters on request</li>\n          <li>Trans- and queer-competent care</li>\n        </ul>\n      </div>\n      <div>\n        <h4>Urgent help</h4>\n        <div class=\"urgent\"><b>PEP is time-critical.</b> If we're closed, go to any A&amp;E or call the 24-hour sexual health line: <b>0800 555 0199</b>.</div>\n      </div>\n    </div>\n    <div class=\"copy\">\n      <span>\u00a9 2025 Marrow Clinic \u00b7 Confidential sexual health for everyone</span>\n      <span>Not a substitute for emergency care</span>\n    </div>\n  </div>\n</footer>\n\n<script>\n  // Live open/closed status from the visitor's real clock\n  (function(){\n    var now = new Date();\n    var day = now.getDay();           // 0 Sun \u2026 6 Sat\n    var mins = now.getHours()*60 + now.getMinutes();\n    var open  = (day===0) ? null : (day===6 ? 600 : 510);  // Sat 10:00, else 8:30\n    var close = (day===0) ? null : (day===6 ? 960 : 1140); // Sat 16:00, else 19:00\n    var dot = document.getElementById('statusDot'),\n        txt = document.getElementById('statusText');\n    if(open!==null && mins>=open && mins<close){\n      var left = close-mins;\n      var until = Math.floor(left/60) ? (Math.floor(left/60)+'h '+String(left%60).padStart(2,'0')+'m') : (left+' min');\n      txt.textContent = 'Open now \u2014 closes in ' + until + ' \u00b7 current wait \u2248 20 min';\n    } else {\n      dot.classList.add('closed');\n      txt.textContent = day===0 ? 'Closed today \u2014 open Monday 8:30' : 'Currently closed \u2014 see hours below';\n    }\n    // duplicate ticker content for a seamless loop\n    var t = document.getElementById('tickerTrack');\n    t.innerHTML += t.innerHTML;\n  })();\n</script>\n</body>\n</html>\n"}