{"brief": "B4", "model": "anthropic/claude-haiku-5.5", "i": 4, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Fallow House Press | Small Books of Poetry</title>\n<meta name=\"description\" content=\"Fallow House Press publishes eleven small books of poetry a year, made slowly and with care.\">\n<style>\n  :root {\n    --paper: #f5f0e6;\n    --paper-deep: #ebe3d3;\n    --ink: #1f1c18;\n    --ink-soft: #5a5148;\n    --oxblood: #7a2e2a;\n    --sage: #56634f;\n    --rule: #d6cbb8;\n    --serif: \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, \"Times New Roman\", serif;\n    --measure: 68ch;\n  }\n\n  *, *::before, *::after { box-sizing: border-box; }\n\n  html { scroll-behavior: smooth; }\n\n  body {\n    margin: 0;\n    font-family: var(--serif);\n    font-size: 1.125rem;\n    line-height: 1.6;\n    color: var(--ink);\n    background: var(--paper);\n  }\n\n  img, svg { display: block; max-width: 100%; }\n\n  a { color: inherit; }\n\n  a:focus-visible, button:focus-visible, input:focus-visible {\n    outline: 2px solid var(--oxblood);\n    outline-offset: 3px;\n  }\n\n  .skip-link {\n    position: absolute;\n    left: -9999px;\n    top: 0;\n    background: var(--ink);\n    color: var(--paper);\n    padding: .5rem 1rem;\n    z-index: 100;\n  }\n  .skip-link:focus { left: 1rem; top: 1rem; }\n\n  .wrap {\n    width: min(1120px, 92%);\n    margin-inline: auto;\n  }\n\n  /* ---------- Header ---------- */\n  header.site {\n    position: sticky;\n    top: 0;\n    z-index: 50;\n    background: color-mix(in srgb, var(--paper) 92%, transparent);\n    backdrop-filter: blur(6px);\n    border-bottom: 1px solid var(--rule);\n  }\n\n  .nav {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 1.5rem;\n    padding: 1rem 0;\n    flex-wrap: wrap;\n  }\n\n  .brand {\n    display: flex;\n    align-items: center;\n    gap: .75rem;\n    text-decoration: none;\n  }\n\n  .brand-name {\n    font-size: 1.25rem;\n    font-weight: 700;\n    letter-spacing: .02em;\n    line-height: 1.1;\n  }\n\n  .brand-name small {\n    display: block;\n    font-size: .7rem;\n    font-weight: 400;\n    letter-spacing: .18em;\n    text-transform: uppercase;\n    color: var(--ink-soft);\n  }\n\n  .nav ul {\n    list-style: none;\n    display: flex;\n    gap: 1.5rem;\n    margin: 0;\n    padding: 0;\n    flex-wrap: wrap;\n  }\n\n  .nav ul a {\n    text-decoration: none;\n    font-size: .95rem;\n    letter-spacing: .04em;\n    padding-bottom: .15rem;\n    border-bottom: 1px solid transparent;\n    transition: border-color .2s;\n  }\n\n  .nav ul a:hover { border-bottom-color: var(--oxblood); }\n\n  /* ---------- Buttons ---------- */\n  .btn {\n    display: inline-block;\n    font: inherit;\n    font-size: .95rem;\n    letter-spacing: .06em;\n    text-decoration: none;\n    padding: .75rem 1.4rem;\n    border: 1px solid var(--ink);\n    background: var(--ink);\n    color: var(--paper);\n    cursor: pointer;\n    transition: background .2s, color .2s;\n  }\n\n  .btn:hover { background: transparent; color: var(--ink); }\n\n  .btn.ghost {\n    background: transparent;\n    color: var(--ink);\n  }\n  .btn.ghost:hover { background: var(--ink); color: var(--paper); }\n\n  /* ---------- Hero ---------- */\n  .hero {\n    padding: clamp(3.5rem, 9vw, 7.5rem) 0 clamp(3rem, 7vw, 5.5rem);\n  }\n\n  .hero-grid {\n    display: grid;\n    grid-template-columns: 1.15fr .85fr;\n    gap: clamp(2rem, 5vw, 4.5rem);\n    align-items: center;\n  }\n\n  .eyebrow {\n    font-size: .8rem;\n    letter-spacing: .22em;\n    text-transform: uppercase;\n    color: var(--oxblood);\n    margin: 0 0 1.25rem;\n  }\n\n  h1 {\n    font-size: clamp(2.6rem, 6vw, 4.6rem);\n    line-height: 1.02;\n    font-weight: 400;\n    letter-spacing: -.01em;\n    margin: 0 0 1.5rem;\n  }\n\n  h1 em { color: var(--oxblood); }\n\n  .lede {\n    font-size: clamp(1.1rem, 2vw, 1.3rem);\n    color: var(--ink-soft);\n    max-width: 34ch;\n    margin: 0 0 2.25rem;\n  }\n\n  .cta-row {\n    display: flex;\n    gap: .9rem;\n    flex-wrap: wrap;\n  }\n\n  .poem-card {\n    background: var(--paper-deep);\n    border: 1px solid var(--rule);\n    padding: clamp(1.75rem, 4vw, 2.75rem);\n    position: relative;\n    box-shadow: 0 1px 0 var(--rule), 12px 12px 0 -1px var(--paper-deep);\n  }\n\n  .poem-card::before {\n    content: \"\";\n    position: absolute;\n    inset: 10px;\n    border: 1px solid var(--rule);\n    pointer-events: none;\n  }\n\n  .poem-card .poem {\n    font-style: italic;\n    font-size: 1.05rem;\n    line-height: 1.75;\n    margin: 0;\n    white-space: pre-line;\n  }\n\n  .poem-card footer {\n    margin-top: 1.5rem;\n    font-size: .85rem;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n    color: var(--ink-soft);\n  }\n\n  /* ---------- Sections ---------- */\n  section.block {\n    padding: clamp(3.5rem, 8vw, 6rem) 0;\n    border-top: 1px solid var(--rule);\n  }\n\n  .section-head {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-end;\n    gap: 1.5rem;\n    flex-wrap: wrap;\n    margin-bottom: 2.75rem;\n  }\n\n  h2 {\n    font-size: clamp(2rem, 4vw, 2.8rem);\n    font-weight: 400;\n    line-height: 1.1;\n    margin: 0;\n  }\n\n  .section-head p {\n    margin: 0;\n    max-width: 36ch;\n    color: var(--ink-soft);\n  }\n\n  /* ---------- Catalogue ---------- */\n  .books {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));\n    gap: 2.25rem 1.75rem;\n    list-style: none;\n    padding: 0;\n    margin: 0;\n  }\n\n  .book {\n    display: flex;\n    flex-direction: column;\n  }\n\n  .cover {\n    aspect-ratio: 2 / 3;\n    padding: 1.4rem 1.25rem;\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    color: var(--paper);\n    box-shadow: 6px 8px 0 -2px var(--ink);\n    margin-bottom: 1.25rem;\n    position: relative;\n    overflow: hidden;\n  }\n\n  .cover::after {\n    content: \"\";\n    position: absolute;\n    left: 14px;\n    top: 0;\n    bottom: 0;\n    width: 1px;\n    background: rgba(255,255,255,.25);\n  }\n\n  .cover .c-title {\n    font-size: 1.55rem;\n    line-height: 1.1;\n    margin: 0;\n  }\n\n  .cover .c-author {\n    font-size: .8rem;\n    letter-spacing: .16em;\n    text-transform: uppercase;\n    opacity: .9;\n  }\n\n  .cover .c-mark {\n    font-size: .7rem;\n    letter-spacing: .2em;\n    text-transform: uppercase;\n    opacity: .75;\n  }\n\n  .c-oxblood { background: linear-gradient(160deg, #8c3a33, #5c211e); }\n  .c-sage    { background: linear-gradient(160deg, #6b7a63, #3f4a3a); }\n  .c-ochre   { background: linear-gradient(160deg, #b08a4a, #6e5427); }\n  .c-slate   { background: linear-gradient(160deg, #4f5b66, #2b333b); }\n\n  .book h3 {\n    font-size: 1.2rem;\n    font-weight: 400;\n    margin: 0 0 .2rem;\n  }\n\n  .book .meta {\n    font-size: .9rem;\n    color: var(--ink-soft);\n    margin: 0 0 .9rem;\n  }\n\n  .book .row {\n    margin-top: auto;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    font-size: .95rem;\n    border-top: 1px solid var(--rule);\n    padding-top: .75rem;\n  }\n\n  .book .row a {\n    text-decoration: none;\n    border-bottom: 1px solid var(--oxblood);\n    color: var(--oxblood);\n  }\n\n  .tag {\n    display: inline-block;\n    font-size: .72rem;\n    letter-spacing: .14em;\n    text-transform: uppercase;\n    color: var(--sage);\n    border: 1px solid var(--sage);\n    padding: .15rem .5rem;\n    margin-bottom: .6rem;\n    align-self: flex-start;\n  }\n\n  /* ---------- Stats ---------- */\n  .stats {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\n    gap: 2rem;\n    text-align: left;\n  }\n\n  .stat-num {\n    font-size: clamp(2.5rem, 5vw, 3.5rem);\n    line-height: 1;\n    color: var(--oxblood);\n    margin: 0 0 .5rem;\n  }\n\n  .stat-label {\n    margin: 0;\n    font-size: .95rem;\n    color: var(--ink-soft);\n    max-width: 22ch;\n  }\n\n  /* ---------- About ---------- */\n  .about {\n    display: grid;\n    grid-template-columns: .9fr 1.1fr;\n    gap: clamp(2rem, 6vw, 5rem);\n    align-items: start;\n  }\n\n  .about blockquote {\n    margin: 0;\n    font-size: clamp(1.5rem, 3vw, 2rem);\n    line-height: 1.3;\n    font-style: italic;\n    padding-left: 1.5rem;\n    border-left: 2px solid var(--oxblood);\n  }\n\n  .about p {\n    max-width: var(--measure);\n    margin: 0 0 1.1rem;\n  }\n\n  .about .sign {\n    font-size: .9rem;\n    letter-spacing: .06em;\n    color: var(--ink-soft);\n    margin-top: 1.5rem;\n  }\n\n  /* ---------- Submissions ---------- */\n  .submit {\n    background: var(--ink);\n    color: var(--paper);\n    border-top: none;\n  }\n\n  .submit h2 { color: var(--paper); }\n  .submit .section-head p { color: #c9bfae; }\n  .submit .eyebrow { color: #d9a39c; }\n\n  .steps {\n    list-style: none;\n    counter-reset: step;\n    padding: 0;\n    margin: 0;\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\n    gap: 2rem;\n  }\n\n  .steps li {\n    counter-increment: step;\n    border-top: 1px solid #47413a;\n    padding-top: 1.25rem;\n  }\n\n  .steps li::before {\n    content: counter(step, decimal-leading-zero);\n    display: block;\n    font-size: .85rem;\n    letter-spacing: .15em;\n    color: #d9a39c;\n    margin-bottom: .6rem;\n  }\n\n  .steps h3 {\n    font-weight: 400;\n    font-size: 1.25rem;\n    margin: 0 0 .5rem;\n  }\n\n  .steps p {\n    margin: 0;\n    color: #c9bfae;\n    font-size: 1rem;\n  }\n\n  .submit .btn {\n    background: var(--paper);\n    color: var(--ink);\n    border-color: var(--paper);\n    margin-top: 3rem;\n  }\n  .submit .btn:hover { background: transparent; color: var(--paper); }\n\n  .deadline {\n    margin-top: 1rem;\n    font-size: .95rem;\n    color: #c9bfae;\n  }\n\n  /* ---------- Newsletter ---------- */\n  .letter {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 3rem;\n    align-items: center;\n  }\n\n  .letter p { margin: 0; color: var(--ink-soft); max-width: 42ch; }\n\n  form.signup {\n    display: flex;\n    gap: 0;\n    max-width: 480px;\n  }\n\n  form.signup input {\n    flex: 1;\n    min-width: 0;\n    font: inherit;\n    padding: .8rem 1rem;\n    border: 1px solid var(--ink);\n    border-right: none;\n    background: transparent;\n    color: var(--ink);\n  }\n\n  form.signup input::placeholder { color: #8b8072; }\n\n  form.signup button {\n    font: inherit;\n    padding: .8rem 1.3rem;\n    border: 1px solid var(--ink);\n    background: var(--ink);\n    color: var(--paper);\n    cursor: pointer;\n    letter-spacing: .05em;\n  }\n\n  form.signup button:hover { background: var(--oxblood); border-color: var(--oxblood); }\n\n  .form-note {\n    font-size: .9rem;\n    min-height: 1.4em;\n    margin: .6rem 0 0;\n    color: var(--sage);\n  }\n\n  /* ---------- Footer ---------- */\n  footer.site {\n    border-top: 1px solid var(--rule);\n    padding: 2.5rem 0 3rem;\n    font-size: .92rem;\n    color: var(--ink-soft);\n  }\n\n  .foot {\n    display: flex;\n    justify-content: space-between;\n    gap: 2rem;\n    flex-wrap: wrap;\n  }\n\n  .foot ul {\n    list-style: none;\n    padding: 0;\n    margin: 0;\n    display: flex;\n    gap: 1.25rem;\n    flex-wrap: wrap;\n  }\n\n  .foot a { text-decoration: none; }\n  .foot a:hover { color: var(--oxblood); text-decoration: underline; }\n\n  /* ---------- Responsive ---------- */\n  @media (max-width: 860px) {\n    .hero-grid,\n    .about,\n    .letter {\n      grid-template-columns: 1fr;\n    }\n    .poem-card { max-width: 520px; }\n  }\n\n  @media (max-width: 520px) {\n    body { font-size: 1.05rem; }\n    .nav ul { gap: 1rem; }\n    form.signup { flex-direction: column; }\n    form.signup input { border-right: 1px solid var(--ink); border-bottom: none; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    html { scroll-behavior: auto; }\n    * { transition: none !important; }\n  }\n</style>\n</head>\n<body>\n\n<a class=\"skip-link\" href=\"#catalogue\">Skip to catalogue</a>\n\n<header class=\"site\">\n  <div class=\"wrap nav\">\n    <a class=\"brand\" href=\"#top\" aria-label=\"Fallow House Press home\">\n      <svg width=\"34\" height=\"34\" viewBox=\"0 0 34 34\" aria-hidden=\"true\">\n        <rect x=\"1\" y=\"1\" width=\"32\" height=\"32\" fill=\"none\" stroke=\"#1f1c18\" stroke-width=\"1.2\"/>\n        <path d=\"M8 26 L17 8 L26 26\" fill=\"none\" stroke=\"#7a2e2a\" stroke-width=\"1.6\"/>\n        <line x1=\"11.5\" y1=\"19\" x2=\"22.5\" y2=\"19\" stroke=\"#1f1c18\" stroke-width=\"1.2\"/>\n      </svg>\n      <span class=\"brand-name\">Fallow House<small>Poetry Press \u00b7 Est. 2014</small></span>\n    </a>\n\n    <nav aria-label=\"Primary\">\n      <ul>\n        <li><a href=\"#catalogue\">Books</a></li>\n        <li><a href=\"#about\">About</a></li>\n        <li><a href=\"#submit\">Submit</a></li>\n        <li><a href=\"#letter\">Newsletter</a></li>\n      </ul>\n    </nav>\n  </div>\n</header>\n\n<main id=\"top\">\n\n  <!-- Hero -->\n  <section class=\"hero\">\n    <div class=\"wrap hero-grid\">\n      <div>\n        <p class=\"eyebrow\">Small books of poetry, made slowly</p>\n        <h1>Poems that <em>take their time</em> with you.</h1>\n        <p class=\"lede\">\n          Fallow House publishes eleven small books a year: chapbooks and debut collections\n          printed in runs of five hundred, bound by hand, and kept in print for as long as\n          people keep reading them.\n        </p>\n        <div class=\"cta-row\">\n          <a class=\"btn\" href=\"#catalogue\">Browse the catalogue</a>\n          <a class=\"btn ghost\" href=\"#submit\">Send a manuscript</a>\n        </div>\n      </div>\n\n      <figure class=\"poem-card\" style=\"margin:0\">\n        <blockquote style=\"margin:0\">\n          <p class=\"poem\">The orchard forgets its apples\nin the second week of frost,\nand still the ladder leans\nagainst the wall where the light was.\n\nWe keep the gate half open.\nWe keep the bread on the sill.\nWhatever comes up the lane\nwill have to knock like a neighbor.</p>\n        </blockquote>\n        <footer>From <em>Winter Ladder</em> \u00b7 Mara Quist</footer>\n      </figure>\n    </div>\n  </section>\n\n  <!-- Catalogue -->\n  <section class=\"block\" id=\"catalogue\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <div>\n          <p class=\"eyebrow\">Spring &amp; Autumn 2025</p>\n          <h2>The catalogue</h2>\n        </div>\n        <p>Every title is edited over at least a year and set by hand in a single typeface. Samples are free to read in full online.</p>\n      </div>\n\n      <ul class=\"books\">\n        <li class=\"book\">\n          <div class=\"cover c-oxblood\" aria-hidden=\"true\">\n            <span class=\"c-mark\">Chapbook No. 31</span>\n            <div>\n              <p class=\"c-title\">Winter Ladder</p>\n              <p class=\"c-author\">Mara Quist</p>\n            </div>\n          </div>\n          <span class=\"tag\">New</span>\n          <h3>Winter Ladder</h3>\n          <p class=\"meta\">Mara Quist \u00b7 48 pp \u00b7 Paperback</p>\n          <div class=\"row\"><span>$14</span><a href=\"#\">Read a sample</a></div>\n        </li>\n\n        <li class=\"book\">\n          <div class=\"cover c-sage\" aria-hidden=\"true\">\n            <span class=\"c-mark\">Debut Collection</span>\n            <div>\n              <p class=\"c-title\">The Salt Index</p>\n              <p class=\"c-author\">Desmond Achebe-Ray</p>\n            </div>\n          </div>\n          <span class=\"tag\">Debut</span>\n          <h3>The Salt Index</h3>\n          <p class=\"meta\">Desmond Achebe-Ray \u00b7 92 pp \u00b7 Paperback</p>\n          <div class=\"row\"><span>$18</span><a href=\"#\">Read a sample</a></div>\n        </li>\n\n        <li class=\"book\">\n          <div class=\"cover c-ochre\" aria-hidden=\"true\">\n            <span class=\"c-mark\">Chapbook No. 32</span>\n            <div>\n              <p class=\"c-title\">Letters to a Lighthouse Keeper</p>\n              <p class=\"c-author\">Juno Ferreira</p>\n            </div>\n          </div>\n          <span class=\"tag\">Forthcoming</span>\n          <h3>Letters to a Lighthouse Keeper</h3>\n          <p class=\"meta\">Juno Ferreira \u00b7 36 pp \u00b7 Hand-stitched</p>\n          <div class=\"row\"><span>$12</span><a href=\"#\">Preorder</a></div>\n        </li>\n\n        <li class=\"book\">\n          <div class=\"cover c-slate\" aria-hidden=\"true\">\n            <span class=\"c-mark\">Backlist</span>\n            <div>\n              <p class=\"c-title\">Field Notes for the Unmapped</p>\n              <p class=\"c-author\">Ines Oduya</p>\n            </div>\n          </div>\n          <span class=\"tag\">Bestseller</span>\n          <h3>Field Notes for the Unmapped</h3>\n          <p class=\"meta\">Ines Oduya \u00b7 120 pp \u00b7 Paperback</p>\n          <div class=\"row\"><span>$20</span><a href=\"#\">Read a sample</a></div>\n        </li>\n      </ul>\n    </div>\n  </section>\n\n  <!-- Stats -->\n  <section class=\"block\" aria-label=\"Press at a glance\">\n    <div class=\"wrap stats\">\n      <div>\n        <p class=\"stat-num\">112</p>\n        <p class=\"stat-label\">Books published since 2014</p>\n      </div>\n      <div>\n        <p class=\"stat-num\">38</p>\n        <p class=\"stat-label\">Debut poets brought into print</p>\n      </div>\n      <div>\n        <p class=\"stat-num\">500</p>\n        <p class=\"stat-label\">Copies in a typical first run</p>\n      </div>\n      <div>\n        <p class=\"stat-num\">4%</p>\n        <p class=\"stat-label\">Of submissions accepted each year</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- About -->\n  <section class=\"block\" id=\"about\">\n    <div class=\"wrap about\">\n      <blockquote>\n        \"A small press can afford to wait for the poem to finish.\"\n      </blockquote>\n      <div>\n        <p>\n          Fallow House began in a rented room above a bakery with a secondhand letterpress\n          and a shelf of borrowed type. We still set our books that way, with fewer\n          machines and more patience.\n        </p>\n        <p>\n          We believe poetry is read slowly, often aloud, and often more than once. So we\n          make books you can hold in one hand, with margins wide enough for a pencil and\n          covers that do not shout. Each title is edited collaboratively, proofed by at\n          least two readers, and priced to be bought on a whim.\n        </p>\n        <p>\n          We are a worker-run cooperative of four. We pay poets a fixed fee and a share of\n          sales, and we never ask for a reading fee.\n        </p>\n        <p class=\"sign\">\u2014 Tom\u00e1s Brenner &amp; the Fallow House editors</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- Submissions -->\n  <section class=\"block submit\" id=\"submit\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <div>\n          <p class=\"eyebrow\">Open reading period</p>\n          <h2>Send us your manuscript</h2>\n        </div>\n        <p>We read for chapbooks (20\u201336 pages) and debut collections (60\u201390 pages) in two windows each year. Reading is free, always.</p>\n      </div>\n\n      <ol class=\"steps\">\n        <li>\n          <h3>Prepare your manuscript</h3>\n          <p>Submit 20 to 90 pages of poems in a single PDF, with a short cover letter and a one-paragraph bio.</p>\n        </li>\n        <li>\n          <h3>Use our form</h3>\n          <p>Our submission manager keeps your work private. You will receive a confirmation within minutes.</p>\n        </li>\n        <li>\n          <h3>Wait with us</h3>\n          <p>Every manuscript is read by at least two editors. Expect a decision within 14 to 16 weeks.</p>\n        </li>\n        <li>\n          <h3>Make a book</h3>\n          <p>Accepted poets join a three-month editing process, a launch reading, and a royalty agreement.</p>\n        </li>\n      </ol>\n\n      <a class=\"btn\" href=\"#\">Open the submission form</a>\n      <p class=\"deadline\">Next window closes <strong>March 31</strong>. Previously rejected manuscripts are welcome after twelve months.</p>\n    </div>\n  </section>\n\n  <!-- Newsletter -->\n  <section class=\"block\" id=\"letter\">\n    <div class=\"wrap letter\">\n      <div>\n        <h2 style=\"margin-bottom:1rem\">Letters from the press</h2>\n        <p>Once a season: new titles, a poem from the archive, and notes on what we are reading. No more than four emails a year.</p>\n      </div>\n      <div>\n        <form class=\"signup\" id=\"signup\" novalidate>\n          <label for=\"email\" class=\"sr-only\" style=\"position:absolute;left:-9999px\">Email address</label>\n          <input type=\"email\" id=\"email\" name=\"email\" placeholder=\"you@example.com\" required autocomplete=\"email\">\n          <button type=\"submit\">Subscribe</button>\n        </form>\n        <p class=\"form-note\" id=\"form-note\" role=\"status\" aria-live=\"polite\"></p>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer class=\"site\">\n  <div class=\"wrap foot\">\n    <div>\n      <strong style=\"font-weight:400;color:var(--ink)\">Fallow House Press</strong><br>\n      14 Millwright Lane, Second Floor<br>\n      Portland, OR \u00b7 hello@fallowhouse.example\n    </div>\n    <ul>\n      <li><a href=\"#catalogue\">Catalogue</a></li>\n      <li><a href=\"#about\">About</a></li>\n      <li><a href=\"#submit\">Submissions</a></li>\n      <li><a href=\"#\">Distribution</a></li>\n      <li><a href=\"#\">Contact</a></li>\n    </ul>\n    <p style=\"margin:0\">\u00a9 2025 Fallow House Press. All rights to the poems belong to the poets.</p>\n  </div>\n</footer>\n\n<script>\n  (function () {\n    var form = document.getElementById('signup');\n    var input = document.getElementById('email');\n    var note = document.getElementById('form-note');\n\n    form.addEventListener('submit', function (e) {\n      e.preventDefault();\n      var value = input.value.trim();\n      if (!value || input.validity.typeMismatch || !input.checkValidity()) {\n        note.textContent = 'Please enter a valid email address.';\n        input.focus();\n        return;\n      }\n      note.textContent = 'Thank you. Your first letter arrives at the end of the season.';\n      form.reset();\n    });\n  })();\n</script>\n\n</body>\n</html>\n"}