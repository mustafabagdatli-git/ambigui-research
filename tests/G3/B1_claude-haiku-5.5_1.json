{"brief": "B1", "model": "anthropic/claude-haiku-5.5", "i": 1, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en-GB\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Hartley Family Plumbing | Trusted Plumbers in Leeds</title>\n<meta name=\"description\" content=\"Family-run plumbers in Leeds. Gas Safe registered, 24/7 emergency call-outs, fixed-price quotes and boiler, bathroom and drainage work across LS postcodes.\">\n<style>\n  :root {\n    --navy: #14273e;\n    --navy-2: #1d3857;\n    --copper: #c26a2e;\n    --copper-d: #a4551d;\n    --teal: #2a7f80;\n    --cream: #faf6f0;\n    --sand: #f1e8da;\n    --ink: #223040;\n    --muted: #5b6878;\n    --white: #ffffff;\n    --line: #e4dccf;\n    --radius: 14px;\n    --shadow: 0 10px 30px rgba(20, 39, 62, .12);\n  }\n\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  html { scroll-behavior: smooth; }\n  body {\n    font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n    color: var(--ink);\n    background: var(--cream);\n    line-height: 1.6;\n    font-size: 16px;\n  }\n  img, svg { display: block; max-width: 100%; }\n  a { color: inherit; }\n  h1, h2, h3 { font-family: Georgia, \"Times New Roman\", serif; line-height: 1.2; color: var(--navy); }\n  h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); font-weight: 700; }\n  h2 { font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 700; margin-bottom: .75rem; }\n  h3 { font-size: 1.2rem; margin-bottom: .4rem; }\n  p { color: var(--muted); }\n  .container { width: min(1140px, 92%); margin: 0 auto; }\n  section { padding: 5.5rem 0; }\n  .eyebrow {\n    display: inline-block;\n    text-transform: uppercase;\n    letter-spacing: .14em;\n    font-size: .78rem;\n    font-weight: 700;\n    color: var(--copper);\n    margin-bottom: .6rem;\n  }\n  .section-intro { max-width: 620px; margin-bottom: 3rem; }\n\n  /* Buttons */\n  .btn {\n    display: inline-flex; align-items: center; gap: .5rem;\n    padding: .85rem 1.5rem;\n    border-radius: 999px;\n    font-weight: 700; text-decoration: none;\n    border: 2px solid transparent;\n    cursor: pointer; font-size: 1rem;\n    transition: transform .15s ease, background .2s ease, color .2s ease;\n  }\n  .btn:hover { transform: translateY(-2px); }\n  .btn-primary { background: var(--copper); color: var(--white); }\n  .btn-primary:hover { background: var(--copper-d); }\n  .btn-outline { border-color: var(--navy); color: var(--navy); background: transparent; }\n  .btn-outline:hover { background: var(--navy); color: var(--white); }\n  .btn-light { background: var(--white); color: var(--navy); }\n  .btn-light:hover { background: var(--sand); }\n  .btn svg { width: 18px; height: 18px; }\n\n  /* Header */\n  header {\n    position: sticky; top: 0; z-index: 50;\n    background: rgba(250, 246, 240, .95);\n    backdrop-filter: blur(8px);\n    border-bottom: 1px solid var(--line);\n  }\n  .nav {\n    display: flex; align-items: center; justify-content: space-between;\n    height: 76px;\n  }\n  .logo { display: flex; align-items: center; gap: .6rem; text-decoration: none; }\n  .logo-mark {\n    width: 40px; height: 40px; border-radius: 10px;\n    background: var(--navy); display: grid; place-items: center;\n  }\n  .logo-text { font-family: Georgia, serif; font-weight: 700; color: var(--navy); font-size: 1.15rem; line-height: 1.1; }\n  .logo-text small { display: block; font-family: system-ui, sans-serif; font-weight: 600; font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }\n  .nav-links { display: flex; gap: 1.8rem; list-style: none; }\n  .nav-links a { text-decoration: none; font-weight: 600; font-size: .95rem; color: var(--navy); }\n  .nav-links a:hover { color: var(--copper); }\n  .nav-cta { display: flex; align-items: center; gap: 1rem; }\n  .nav-phone { font-weight: 700; color: var(--navy); text-decoration: none; white-space: nowrap; }\n  .menu-toggle {\n    display: none; background: none; border: 0; cursor: pointer; padding: .4rem;\n  }\n  .menu-toggle span { display: block; width: 24px; height: 2px; background: var(--navy); margin: 5px 0; }\n\n  /* Hero */\n  .hero {\n    background:\n      radial-gradient(circle at 85% 20%, rgba(42,127,128,.18), transparent 40%),\n      radial-gradient(circle at 10% 90%, rgba(194,106,46,.14), transparent 40%),\n      var(--cream);\n    padding: 5rem 0 4.5rem;\n  }\n  .hero-grid {\n    display: grid; grid-template-columns: 1.1fr .9fr; gap: 4rem; align-items: center;\n  }\n  .hero p.lead { font-size: 1.15rem; margin: 1.25rem 0 2rem; max-width: 540px; }\n  .hero-actions { display: flex; flex-wrap: wrap; gap: .9rem; }\n  .badges { display: flex; flex-wrap: wrap; gap: .6rem 1.2rem; margin-top: 2.2rem; }\n  .badge {\n    display: flex; align-items: center; gap: .45rem;\n    font-size: .9rem; font-weight: 600; color: var(--navy);\n  }\n  .badge svg { width: 20px; height: 20px; color: var(--teal); flex-shrink: 0; }\n\n  .booking-card {\n    background: var(--white);\n    border-radius: 20px;\n    box-shadow: var(--shadow);\n    padding: 2rem;\n    border: 1px solid var(--line);\n    position: relative;\n  }\n  .booking-card .status {\n    display: inline-flex; align-items: center; gap: .4rem;\n    background: #e5f3f2; color: var(--teal);\n    font-weight: 700; font-size: .8rem; padding: .3rem .7rem; border-radius: 999px;\n  }\n  .status .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--teal); box-shadow: 0 0 0 4px rgba(42,127,128,.2); }\n  .booking-card h3 { font-size: 1.4rem; margin: 1rem 0 .3rem; }\n  .slot-list { list-style: none; margin: 1.2rem 0; display: grid; gap: .6rem; }\n  .slot {\n    display: flex; justify-content: space-between; align-items: center;\n    padding: .8rem 1rem; border: 1px solid var(--line); border-radius: 10px;\n    font-weight: 600; color: var(--navy); font-size: .95rem;\n  }\n  .slot.taken { opacity: .45; text-decoration: line-through; }\n  .slot.picked { border-color: var(--copper); background: #fdf3ea; }\n  .slot span:last-child { font-size: .8rem; color: var(--muted); font-weight: 600; }\n  .booking-card .note { font-size: .85rem; color: var(--muted); border-top: 1px dashed var(--line); padding-top: 1rem; }\n  .float-tag {\n    position: absolute; right: -14px; bottom: -18px;\n    background: var(--navy); color: var(--white);\n    padding: .8rem 1.1rem; border-radius: 12px; box-shadow: var(--shadow);\n    font-size: .85rem; line-height: 1.35;\n  }\n  .float-tag strong { display: block; font-size: 1.05rem; color: #ffd9bd; }\n\n  /* Trust strip */\n  .strip { background: var(--navy); color: var(--white); padding: 1.6rem 0; }\n  .strip-inner { display: flex; flex-wrap: wrap; justify-content: space-around; gap: 1rem; text-align: center; }\n  .strip-item strong { display: block; font-family: Georgia, serif; font-size: 1.9rem; color: #ffd9bd; }\n  .strip-item span { font-size: .85rem; letter-spacing: .05em; opacity: .85; }\n\n  /* Services */\n  .services { background: var(--white); }\n  .service-grid {\n    display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.4rem;\n  }\n  .service {\n    border: 1px solid var(--line); border-radius: var(--radius);\n    padding: 1.8rem; background: var(--cream);\n    transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;\n  }\n  .service:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-color: transparent; }\n  .icon-wrap {\n    width: 52px; height: 52px; border-radius: 14px;\n    background: var(--navy); color: var(--white);\n    display: grid; place-items: center; margin-bottom: 1.1rem;\n  }\n  .icon-wrap.copper { background: var(--copper); }\n  .icon-wrap.teal { background: var(--teal); }\n  .icon-wrap svg { width: 26px; height: 26px; }\n  .service p { font-size: .95rem; }\n  .service .from { display: inline-block; margin-top: .9rem; font-weight: 700; font-size: .85rem; color: var(--copper); }\n  .emergency-banner {\n    margin-top: 2.5rem;\n    background: linear-gradient(120deg, var(--copper), var(--copper-d));\n    color: var(--white); border-radius: var(--radius);\n    padding: 2rem 2.5rem;\n    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem;\n  }\n  .emergency-banner h3 { color: var(--white); font-size: 1.5rem; margin: 0 0 .25rem; }\n  .emergency-banner p { color: rgba(255,255,255,.9); }\n  .emergency-banner .btn-light { color: var(--copper-d); }\n\n  /* Family */\n  .family-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 4.5rem; align-items: center; }\n  .portrait {\n    aspect-ratio: 4/5;\n    border-radius: 24px;\n    background:\n      linear-gradient(160deg, var(--teal) 0%, var(--navy) 100%);\n    position: relative; overflow: hidden;\n    box-shadow: var(--shadow);\n    display: flex; flex-direction: column; justify-content: flex-end; padding: 2rem; color: var(--white);\n  }\n  .portrait::before {\n    content: \"\"; position: absolute; inset: 0;\n    background: repeating-linear-gradient(45deg, rgba(255,255,255,.04) 0 14px, transparent 14px 28px);\n  }\n  .portrait .est {\n    position: absolute; top: 2rem; left: 2rem;\n    font-family: Georgia, serif; font-size: 3.4rem; font-weight: 700; color: #ffd9bd; opacity: .9; line-height: 1;\n  }\n  .portrait .est small { display: block; font-family: system-ui, sans-serif; font-size: .75rem; letter-spacing: .15em; text-transform: uppercase; color: var(--white); opacity: .8; margin-top: .4rem; }\n  .portrait blockquote { font-family: Georgia, serif; font-style: italic; font-size: 1.2rem; position: relative; z-index: 1; }\n  .portrait cite { font-style: normal; font-size: .85rem; opacity: .8; display: block; margin-top: .6rem; }\n  .values { list-style: none; margin: 1.8rem 0 2rem; display: grid; gap: 1.1rem; }\n  .values li { display: flex; gap: 1rem; }\n  .values .icon-wrap { margin: 0; flex-shrink: 0; width: 44px; height: 44px; border-radius: 12px; }\n  .values .icon-wrap svg { width: 22px; height: 22px; }\n  .values h3 { margin-bottom: .15rem; font-size: 1.05rem; }\n  .values p { font-size: .95rem; }\n\n  /* Process */\n  .process { background: var(--sand); }\n  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; counter-reset: step; }\n  .step {\n    background: var(--white); border-radius: var(--radius); padding: 2rem 1.6rem;\n    position: relative; border-top: 4px solid var(--copper);\n  }\n  .step-num {\n    font-family: Georgia, serif; font-size: 2.6rem; font-weight: 700; color: var(--copper); opacity: .35; line-height: 1; margin-bottom: .6rem;\n  }\n  .step p { font-size: .93rem; }\n\n  /* Reviews */\n  .reviews-head { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1.5rem; margin-bottom: 3rem; }\n  .rating { display: flex; align-items: center; gap: .75rem; background: var(--white); padding: .9rem 1.2rem; border-radius: 12px; border: 1px solid var(--line); }\n  .rating strong { font-family: Georgia, serif; font-size: 1.8rem; color: var(--navy); }\n  .stars { color: var(--copper); letter-spacing: 2px; font-size: 1.05rem; }\n  .review-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; }\n  .review {\n    background: var(--white); border-radius: var(--radius); padding: 2rem; border: 1px solid var(--line);\n    display: flex; flex-direction: column;\n  }\n  .review p.text { color: var(--ink); font-size: .98rem; flex: 1; margin: .8rem 0 1.4rem; }\n  .reviewer { display: flex; align-items: center; gap: .8rem; }\n  .avatar {\n    width: 44px; height: 44px; border-radius: 50%;\n    display: grid; place-items: center; font-weight: 700; color: var(--white); font-size: .95rem;\n  }\n  .reviewer strong { display: block; color: var(--navy); font-size: .95rem; }\n  .reviewer span { font-size: .8rem; color: var(--muted); }\n\n  /* Areas & pricing */\n  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }\n  .areas { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1.5rem; }\n  .areas span {\n    background: var(--white); border: 1px solid var(--line);\n    padding: .5rem 1rem; border-radius: 999px; font-size: .9rem; font-weight: 600; color: var(--navy);\n  }\n  .pricing { background: var(--white); border-radius: 20px; border: 1px solid var(--line); overflow: hidden; box-shadow: var(--shadow); }\n  .pricing-head { background: var(--navy); color: var(--white); padding: 1.5rem 2rem; }\n  .pricing-head h3 { color: var(--white); margin: 0; }\n  .pricing-head p { color: rgba(255,255,255,.75); font-size: .9rem; margin-top: .25rem; }\n  .price-row {\n    display: flex; justify-content: space-between; align-items: center;\n    padding: 1rem 2rem; border-bottom: 1px solid var(--line); font-size: .97rem;\n  }\n  .price-row:last-child { border-bottom: 0; }\n  .price-row strong { color: var(--navy); }\n  .price-row em { font-style: normal; font-weight: 700; color: var(--copper); }\n  .pricing-foot { padding: 1.2rem 2rem; font-size: .85rem; background: var(--cream); color: var(--muted); }\n\n  /* Contact */\n  .contact { background: var(--navy); color: var(--white); }\n  .contact h2, .contact h3 { color: var(--white); }\n  .contact p { color: rgba(255,255,255,.78); }\n  .contact .eyebrow { color: #ffb88a; }\n  .contact-grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: 4rem; }\n  .contact-info ul { list-style: none; margin-top: 2rem; display: grid; gap: 1.4rem; }\n  .contact-info li { display: flex; gap: 1rem; }\n  .contact-info .icon-wrap { background: rgba(255,255,255,.1); margin: 0; flex-shrink: 0; width: 46px; height: 46px; }\n  .contact-info strong { display: block; color: var(--white); }\n  .contact-info span, .contact-info a { color: rgba(255,255,255,.78); font-size: .95rem; text-decoration: none; }\n  .contact-info a:hover { color: #ffb88a; }\n  .form {\n    background: var(--white); border-radius: 20px; padding: 2.4rem; color: var(--ink);\n    box-shadow: 0 20px 50px rgba(0,0,0,.25);\n  }\n  .form h3 { color: var(--navy); margin-bottom: .3rem; }\n  .form > p { font-size: .92rem; margin-bottom: 1.5rem; }\n  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }\n  .field { margin-bottom: 1rem; display: flex; flex-direction: column; }\n  .field label { font-size: .85rem; font-weight: 700; color: var(--navy); margin-bottom: .35rem; }\n  .field input, .field select, .field textarea {\n    font: inherit; font-size: .95rem; color: var(--ink);\n    padding: .75rem .9rem; border: 1.5px solid var(--line); border-radius: 10px;\n    background: var(--cream); transition: border-color .2s, box-shadow .2s;\n  }\n  .field textarea { min-height: 110px; resize: vertical; }\n  .field input:focus, .field select:focus, .field textarea:focus {\n    outline: none; border-color: var(--teal); box-shadow: 0 0 0 4px rgba(42,127,128,.15); background: var(--white);\n  }\n  .form .btn { width: 100%; justify-content: center; font-size: 1.05rem; }\n  .form-small { font-size: .8rem; text-align: center; margin-top: .9rem; color: var(--muted); }\n  .form-success {\n    display: none; text-align: center; padding: 2rem 0;\n  }\n  .form-success svg { width: 56px; height: 56px; color: var(--teal); margin: 0 auto 1rem; }\n  .form-success h3 { margin-bottom: .4rem; }\n\n  /* Footer */\n  footer { background: #0e1d2f; color: rgba(255,255,255,.7); padding: 3rem 0 1.5rem; font-size: .9rem; }\n  .foot-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 2.5rem; margin-bottom: 2.5rem; }\n  footer h4 { color: var(--white); font-family: system-ui, sans-serif; font-size: .95rem; margin-bottom: .9rem; }\n  footer ul { list-style: none; display: grid; gap: .5rem; }\n  footer a { text-decoration: none; color: rgba(255,255,255,.7); }\n  footer a:hover { color: #ffb88a; }\n  footer .logo-text { color: var(--white); }\n  footer .logo-text small { color: rgba(255,255,255,.5); }\n  .foot-bottom {\n    border-top: 1px solid rgba(255,255,255,.1); padding-top: 1.5rem;\n    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; font-size: .82rem;\n  }\n\n  /* Mobile sticky call bar */\n  .mobile-call {\n    display: none;\n    position: fixed; bottom: 0; left: 0; right: 0; z-index: 60;\n    background: var(--copper); color: var(--white); text-align: center;\n    padding: .95rem; font-weight: 700; text-decoration: none;\n    box-shadow: 0 -6px 20px rgba(0,0,0,.15);\n  }\n\n  /* Responsive */\n  @media (max-width: 960px) {\n    .hero-grid, .family-grid, .split, .contact-grid { grid-template-columns: 1fr; gap: 3rem; }\n    .steps { grid-template-columns: repeat(2, 1fr); }\n    .review-grid { grid-template-columns: 1fr 1fr; }\n    .foot-grid { grid-template-columns: 1fr 1fr; }\n    .portrait { aspect-ratio: 16/10; }\n    .float-tag { right: 10px; }\n  }\n  @media (max-width: 760px) {\n    section { padding: 4rem 0; }\n    .nav-links, .nav-phone { display: none; }\n    .menu-toggle { display: block; }\n    .nav-links.open {\n      display: flex; flex-direction: column; gap: 0;\n      position: absolute; top: 76px; left: 0; right: 0;\n      background: var(--cream); border-bottom: 1px solid var(--line); padding: .5rem 0;\n    }\n    .nav-links.open a { display: block; padding: .9rem 4%; }\n    .review-grid { grid-template-columns: 1fr; }\n    .form-row { grid-template-columns: 1fr; }\n    .steps { grid-template-columns: 1fr; }\n    .emergency-banner { padding: 1.8rem; }\n    .mobile-call { display: block; }\n    body { padding-bottom: 52px; }\n    .foot-grid { grid-template-columns: 1fr; }\n    .price-row, .pricing-head, .pricing-foot { padding-left: 1.3rem; padding-right: 1.3rem; }\n  }\n</style>\n</head>\n<body>\n\n<!-- Header -->\n<header>\n  <nav class=\"container nav\" aria-label=\"Main navigation\">\n    <a href=\"#top\" class=\"logo\" id=\"top\">\n      <span class=\"logo-mark\" aria-hidden=\"true\">\n        <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\">\n          <path d=\"M12 2.5C9 7 6 10.6 6 14.3a6 6 0 0 0 12 0C18 10.6 15 7 12 2.5z\" fill=\"#ffd9bd\"/>\n        </svg>\n      </span>\n      <span class=\"logo-text\">Hartley<br>Family Plumbing<small>Leeds \u00b7 Est. 1994</small></span>\n    </a>\n\n    <ul class=\"nav-links\" id=\"navLinks\">\n      <li><a href=\"#services\">Services</a></li>\n      <li><a href=\"#family\">Our Family</a></li>\n      <li><a href=\"#reviews\">Reviews</a></li>\n      <li><a href=\"#pricing\">Pricing</a></li>\n      <li><a href=\"#contact\">Contact</a></li>\n    </ul>\n\n    <div class=\"nav-cta\">\n      <a href=\"tel:01130000000\" class=\"nav-phone\">0113 000 0000</a>\n      <a href=\"#contact\" class=\"btn btn-primary\" style=\"padding:.6rem 1.1rem;font-size:.92rem;\">Book a visit</a>\n      <button class=\"menu-toggle\" id=\"menuToggle\" aria-label=\"Toggle menu\" aria-expanded=\"false\">\n        <span></span><span></span><span></span>\n      </button>\n    </div>\n  </nav>\n</header>\n\n<!-- Hero -->\n<section class=\"hero\">\n  <div class=\"container hero-grid\">\n    <div>\n      <span class=\"eyebrow\">Family-run since 1994</span>\n      <h1>Leeds plumbing, done properly by a family you can trust.</h1>\n      <p class=\"lead\">From a burst pipe at 2am to a new bathroom in time for Christmas, the Hartley team has looked after Leeds homes for three generations. Gas Safe registered, honest quotes, and we turn up when we say we will.</p>\n      <div class=\"hero-actions\">\n        <a href=\"tel:01130000000\" class=\"btn btn-primary\">\n          <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z\"/></svg>\n          Call 0113 000 0000\n        </a>\n        <a href=\"#contact\" class=\"btn btn-outline\">Book online</a>\n      </div>\n      <div class=\"badges\">\n        <span class=\"badge\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"><path d=\"M12 2l8 3v6c0 5-3.5 9-8 11-4.5-2-8-6-8-11V5l8-3z\"/><path d=\"M9 12l2 2 4-4\"/></svg>\n          Gas Safe registered\n        </span>\n        <span class=\"badge\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/></svg>\n          24/7 emergency cover\n        </span>\n        <span class=\"badge\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"><path d=\"M5 12l5 5L20 7\"/></svg>\n          Fixed-price quotes\n        </span>\n      </div>\n    </div>\n\n    <div style=\"position:relative;\">\n      <div class=\"booking-card\" aria-label=\"Example booking availability\">\n        <span class=\"status\"><span class=\"dot\"></span> Engineers available today</span>\n        <h3>Book your visit</h3>\n        <p style=\"font-size:.9rem;\">Choose a time that suits you. Your engineer will text when they're 30 minutes away.</p>\n        <ul class=\"slot-list\">\n          <li class=\"slot taken\"><span>8am \u2013 10am</span><span>Booked</span></li>\n          <li class=\"slot picked\"><span>12pm \u2013 2pm</span><span>Selected</span></li>\n          <li class=\"slot\"><span>2pm \u2013 4pm</span><span>Available</span></li>\n          <li class=\"slot\"><span>4pm \u2013 6pm</span><span>Available</span></li>\n        </ul>\n        <p class=\"note\">Emergency leaks? Call us directly on <strong>0113 000 0000</strong> and we'll dispatch the nearest engineer.</p>\n      </div>\n      <div class=\"float-tag\">\n        <strong>4.9 / 5 rating</strong>\n        from 600+ Leeds reviews\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- Trust strip -->\n<div class=\"strip\">\n  <div class=\"container strip-inner\">\n    <div class=\"strip-item\"><strong>30+</strong><span>Years in Leeds</span></div>\n    <div class=\"strip-item\"><strong>12,000+</strong><span>Jobs completed</span></div>\n    <div class=\"strip-item\"><strong>3</strong><span>Generations of plumbers</span></div>\n    <div class=\"strip-item\"><strong>1 yr</strong><span>Guarantee on all labour</span></div>\n  </div>\n</div>\n\n<!-- Services -->\n<section class=\"services\" id=\"services\">\n  <div class=\"container\">\n    <span class=\"eyebrow\">What we do</span>\n    <h2>Everything your home's water and heating need</h2>\n    <p class=\"section-intro\">Small repairs, major installs and everything in between. Every job is quoted before we start, and nothing is done without your say-so.</p>\n\n    <div class=\"service-grid\">\n      <article class=\"service\">\n        <div class=\"icon-wrap copper\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 2.5C9 7 6 10.6 6 14.3a6 6 0 0 0 12 0C18 10.6 15 7 12 2.5z\"/></svg>\n        </div>\n        <h3>Emergency call-outs</h3>\n        <p>Burst pipes, flooding and no-hot-water emergencies. We aim to reach most Leeds addresses within two hours, day or night.</p>\n        <span class=\"from\">Call-outs from \u00a395</span>\n      </article>\n\n      <article class=\"service\">\n        <div class=\"icon-wrap\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"4\" y=\"3\" width=\"16\" height=\"18\" rx=\"2\"/><circle cx=\"12\" cy=\"12\" r=\"3.5\"/><path d=\"M8 7h.01M16 7h.01\"/></svg>\n        </div>\n        <h3>Boiler repair & servicing</h3>\n        <p>All major brands. Annual services, breakdown repairs and boiler replacements, with a clear fixed price before any work begins.</p>\n        <span class=\"from\">Annual service from \u00a389</span>\n      </article>\n\n      <article class=\"service\">\n        <div class=\"icon-wrap teal\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 12h16v3a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5v-3z\"/><path d=\"M7 12V6a2 2 0 0 1 4 0M9 17v2M15 17v2\"/></svg>\n        </div>\n        <h3>Bathroom installs</h3>\n        <p>Full bathroom refits from start to finish, including tiling referrals, showers, underfloor heating and accessible bathroom adaptations.</p>\n        <span class=\"from\">Free design consultation</span>\n      </article>\n\n      <article class=\"service\">\n        <div class=\"icon-wrap\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 9h18M5 9v10h14V9M9 4h6\"/><path d=\"M12 13v4\"/></svg>\n        </div>\n        <h3>Drain clearing</h3>\n        <p>Blocked sinks, slow showers and sewer problems. Jetting and CCTV drain surveys so we fix the cause, not just the symptom.</p>\n        <span class=\"from\">Unblocking from \u00a379</span>\n      </article>\n\n      <article class=\"service\">\n        <div class=\"icon-wrap teal\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 5h16v4H4zM6 9v10M18 9v10M10 13h4\"/></svg>\n        </div>\n        <h3>Central heating</h3>\n        <p>Cold radiators, airlocks, magnetic filters and full system power flushes to keep your heating efficient and your bills down.</p>\n        <span class=\"from\">Power flush from \u00a3350</span>\n      </article>\n\n      <article class=\"service\">\n        <div class=\"icon-wrap copper\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><ellipse cx=\"12\" cy=\"6\" rx=\"7\" ry=\"3\"/><path d=\"M5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6\"/><path d=\"M5 12c0 1.7 3.1 3 7 3s7-1.3 7-3\"/></svg>\n        </div>\n        <h3>Hot water cylinders</h3>\n        <p>Unvented and vented cylinder installs, replacements and repairs, with same-week availability for most of Leeds.</p>\n        <span class=\"from\">Installs from \u00a3950</span>\n      </article>\n    </div>\n\n    <div class=\"emergency-banner\">\n      <div>\n        <h3>Water coming through the ceiling right now?</h3>\n        <p>Turn off your stopcock if you can, then call us. We'll talk you through it while we send someone out.</p>\n      </div>\n      <a href=\"tel:01130000000\" class=\"btn btn-light\">Call 0113 000 0000</a>\n    </div>\n  </div>\n</section>\n\n<!-- Family -->\n<section id=\"family\">\n  <div class=\"container family-grid\">\n    <div class=\"portrait\" role=\"img\" aria-label=\"Illustrated panel reading Est. 1994 for the Hartley family\">\n      <div class=\"est\">1994<small>Founded in Headingley</small></div>\n      <blockquote>\"We've never once left a job half-finished, and we're not starting now.\"</blockquote>\n      <cite>\u2014 Margaret Hartley, founder</cite>\n    </div>\n\n    <div>\n      <span class=\"eyebrow\">Meet the family</span>\n      <h2>Your neighbours, not a faceless call centre</h2>\n      <p>Margaret started the business with one van and a toolbox in 1994. Today her son Daniel runs day-to-day operations, and her granddaughter Priya leads our bathroom and heating design team. Most of our engineers grew up within a few miles of the homes they now service.</p>\n\n      <ul class=\"values\">\n        <li>\n          <span class=\"icon-wrap copper\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 12l5 5L20 7\"/></svg></span>\n          <div><h3>Honest quotes, in writing</h3><p>You'll know the full cost before the first pipe is touched. If the job changes, we ask first.</p></div>\n        </li>\n        <li>\n          <span class=\"icon-wrap teal\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21c1-4 4-6 8-6s7 2 8 6\"/></svg></span>\n          <div><h3>The same engineer, every visit</h3><p>Where possible, you'll see the same friendly face from start to finish, with a named engineer on every booking.</p></div>\n        </li>\n        <li>\n          <span class=\"icon-wrap\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 2l8 3v6c0 5-3.5 9-8 11-4.5-2-8-6-8-11V5l8-3z\"/></svg></span>\n          <div><h3>Fully insured and certified</h3><p>Gas Safe, WaterSafe and City & Guilds qualified, with \u00a35m public liability cover.</p></div>\n        </li>\n      </ul>\n    </div>\n  </div>\n</section>\n\n<!-- Process -->\n<section class=\"process\">\n  <div class=\"container\">\n    <span class=\"eyebrow\">How it works</span>\n    <h2>From first call to finished job</h2>\n    <p class=\"section-intro\">No call centres, no surprise invoices. Here's exactly what happens when you get in touch.</p>\n\n    <div class=\"steps\">\n      <div class=\"step\">\n        <div class=\"step-num\">01</div>\n        <h3>Get in touch</h3>\n        <p>Call us or book online. Real people answer the phone, usually within three rings.</p>\n      </div>\n      <div class=\"step\">\n        <div class=\"step-num\">02</div>\n        <h3>We visit & quote</h3>\n        <p>An engineer arrives in your chosen slot, diagnoses the fault and gives you a fixed written price.</p>\n      </div>\n      <div class=\"step\">\n        <div class=\"step-num\">03</div>\n        <h3>We do the work</h3>\n        <p>Once you approve, we get it done, tidy up after ourselves and leave the property spotless.</p>\n      </div>\n      <div class=\"step\">\n        <div class=\"step-num\">04</div>\n        <h3>Guaranteed</h3>\n        <p>Every job carries a 12-month labour guarantee and a certificate for your records.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- Reviews -->\n<section id=\"reviews\">\n  <div class=\"container\">\n    <div class=\"reviews-head\">\n      <div>\n        <span class=\"eyebrow\">Reviews</span>\n        <h2 style=\"margin-bottom:0;\">Leeds homeowners say it best</h2>\n      </div>\n      <div class=\"rating\">\n        <strong>4.9</strong>\n        <div>\n          <div class=\"stars\" aria-label=\"5 out of 5 stars\">\u2605\u2605\u2605\u2605\u2605</div>\n          <span style=\"font-size:.85rem;color:var(--muted);\">Based on 600+ verified reviews</span>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"review-grid\">\n      <article class=\"review\">\n        <div class=\"stars\">\u2605\u2605\u2605\u2605\u2605</div>\n        <p class=\"text\">\"Our boiler packed in on the coldest night of the year. Daniel was at our door in Headingley within the hour, had it running by lunchtime and explained every part he'd replaced. Couldn't ask for more.\"</p>\n        <div class=\"reviewer\">\n          <div class=\"avatar\" style=\"background:var(--copper);\">SR</div>\n          <div><strong>Sarah R.</strong><span>Headingley \u00b7 Boiler repair</span></div>\n        </div>\n      </article>\n\n      <article class=\"review\">\n        <div class=\"stars\">\u2605\u2605\u2605\u2605\u2605</div>\n        <p class=\"text\">\"Had our tired 1980s bathroom gutted and rebuilt in ten days. Priya talked us through the layout, the quote matched the final invoice to the penny and the place was spotless at the end.\"</p>\n        <div class=\"reviewer\">\n          <div class=\"avatar\" style=\"background:var(--teal);\">MK</div>\n          <div><strong>Mark K.</strong><span>Roundhay \u00b7 Bathroom install</span></div>\n        </div>\n      </article>\n\n      <article class=\"review\">\n        <div class=\"stars\">\u2605\u2605\u2605\u2605\u2605</div>\n        <p class=\"text\">\"Found us at 11pm with a burst pipe under the kitchen sink. Calm, quick and no drama. Our landlord was impressed, and so were we. We've used them for everything since.\"</p>\n        <div class=\"reviewer\">\n          <div class=\"avatar\" style=\"background:var(--navy);\">AL</div>\n          <div><strong>Aisha L.</strong><span>Chapel Allerton \u00b7 Emergency</span></div>\n        </div>\n      </article>\n    </div>\n  </div>\n</section>\n\n<!-- Areas & pricing -->\n<section style=\"background:var(--sand);\" id=\"pricing\">\n  <div class=\"container split\">\n    <div>\n      <span class=\"eyebrow\">Where we work</span>\n      <h2>Covering all of Leeds and the surrounding area</h2>\n      <p>We're based in Headingley and our engineers are out across the city every day. If you're not sure we cover your street, give us a ring.</p>\n      <div class=\"areas\">\n        <span>Headingley</span><span>Roundhay</span><span>Chapel Allerton</span><span>Horsforth</span>\n        <span>Pudsey</span><span>Kirkstall</span><span>Morley</span><span>Garforth</span>\n        <span>Moortown</span><span>Harehills</span><span>Otley</span><span>Wetherby</span>\n        <span>Adel</span><span>Bramley</span><span>Beeston</span><span>Rothwell</span>\n      </div>\n      <p style=\"margin-top:1.5rem;font-size:.92rem;\">Postcodes covered: LS1\u2013LS29 and selected WF and BD areas.</p>\n    </div>\n\n    <div class=\"pricing\">\n      <div class=\"pricing-head\">\n        <h3>Typical starting prices</h3>\n        <p>Final prices are always confirmed in writing before work starts.</p>\n      </div>\n      <div class=\"price-row\"><strong>Emergency call-out (day)</strong><em>from \u00a395</em></div>\n      <div class=\"price-row\"><strong>Emergency call-out (night)</strong><em>from \u00a3140</em></div>\n      <div class=\"price-row\"><strong>Annual boiler service</strong><em>from \u00a389</em></div>\n      <div class=\"price-row\"><strong>Sink or drain unblocking</strong><em>from \u00a379</em></div>\n      <div class=\"price-row\"><strong>Radiator power flush</strong><em>from \u00a3350</em></div>\n      <div class=\"price-row\"><strong>Tap replacement (fitted)</strong><em>from \u00a3120</em></div>\n      <div class=\"pricing-foot\">Prices include VAT for standard domestic work. Parts charged at cost with no markup.</div>\n    </div>\n  </div>\n</section>\n\n<!-- Contact -->\n<section class=\"contact\" id=\"contact\">\n  <div class=\"container contact-grid\">\n    <div class=\"contact-info\">\n      <span class=\"eyebrow\">Get in touch</span>\n      <h2>Book your visit today</h2>\n      <p>Fill in the form and we'll call you back within the hour during opening times. For emergencies, always call straight away.</p>\n\n      <ul>\n        <li>\n          <span class=\"icon-wrap\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" width=\"22\" height=\"22\"><path d=\"M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z\"/></svg></span>\n          <div><strong>Phone (24/7)</strong><a href=\"tel:01130000000\">0113 000 0000</a></div>\n        </li>\n        <li>\n          <span class=\"icon-wrap\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" width=\"22\" height=\"22\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"M3 7l9 6 9-6\"/></svg></span>\n          <div><strong>Email</strong><a href=\"mailto:hello@hartleyplumbing.example\">hello@hartleyplumbing.example</a></div>\n        </li>\n        <li>\n          <span class=\"icon-wrap\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" width=\"22\" height=\"22\"><path d=\"M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z\"/><circle cx=\"12\" cy=\"10\" r=\"2.5\"/></svg></span>\n          <div><strong>Workshop & office</strong><span>14 Otley Road, Headingley, Leeds LS6 3PN</span></div>\n        </li>\n        <li>\n          <span class=\"icon-wrap\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" width=\"22\" height=\"22\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/></svg></span>\n          <div><strong>Opening hours</strong><span>Mon\u2013Fri 7am\u20137pm \u00b7 Sat 8am\u20134pm<br>Emergencies 24/7, 365 days a year</span></div>\n        </li>\n      </ul>\n    </div>\n\n    <div class=\"form\" id=\"formWrap\">\n      <form id=\"bookingForm\" novalidate>\n        <h3>Request a callback or visit</h3>\n        <p>Tell us a little about the job and we'll get back to you.</p>\n\n        <div class=\"form-row\">\n          <div class=\"field\">\n            <label for=\"name\">Full name</label>\n            <input id=\"name\" name=\"name\" type=\"text\" required placeholder=\"Jane Smith\" autocomplete=\"name\">\n          </div>\n          <div class=\"field\">\n            <label for=\"phone\">Phone number</label>\n            <input id=\"phone\" name=\"phone\" type=\"tel\" required placeholder=\"07700 900000\" autocomplete=\"tel\">\n          </div>\n        </div>\n\n        <div class=\"field\">\n          <label for=\"postcode\">Postcode</label>\n          <input id=\"postcode\" name=\"postcode\" type=\"text\" required placeholder=\"LS6 1AB\" autocomplete=\"postal-code\">\n        </div>\n\n        <div class=\"field\">\n          <label for=\"service\">What do you need help with?</label>\n          <select id=\"service\" name=\"service\" required>\n            <option value=\"\">Select a service</option>\n            <option>Emergency leak or burst pipe</option>\n            <option>Boiler repair or service</option>\n            <option>Bathroom installation</option>\n            <option>Drain clearing</option>\n            <option>Central heating</option>\n            <option>Hot water cylinder</option>\n            <option>Something else</option>\n          </select>\n        </div>\n\n        <div class=\"field\">\n          <label for=\"details\">Brief description <span style=\"font-weight:400;color:var(--muted);\">(optional)</span></label>\n          <textarea id=\"details\" name=\"details\" placeholder=\"e.g. Radiators in the front room are cold, boiler shows code F22...\"></textarea>\n        </div>\n\n        <button type=\"submit\" class=\"btn btn-primary\">Request my callback</button>\n        <p class=\"form-small\">We'll never share your details. Standard call-out fee applies if you're not happy with the quote.</p>\n      </form>\n\n      <div class=\"form-success\" id=\"formSuccess\" role=\"status\" aria-live=\"polite\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M8 12l3 3 5-6\"/></svg>\n        <h3>Thanks, we've got it.</h3>\n        <p>One of the family will call you back within the hour during opening times.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- Footer -->\n<footer>\n  <div class=\"container\">\n    <div class=\"foot-grid\">\n      <div>\n        <a href=\"#top\" class=\"logo\" style=\"margin-bottom:1rem;\">\n          <span class=\"logo-mark\" aria-hidden=\"true\" style=\"background:var(--copper);\">\n            <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 2.5C9 7 6 10.6 6 14.3a6 6 0 0 0 12 0C18 10.6 15 7 12 2.5z\" fill=\"#fff\"/></svg>\n          </span>\n          <span class=\"logo-text\">Hartley<br>Family Plumbing<small>Leeds \u00b7 Est. 1994</small></span>\n        </a>\n        <p style=\"max-width:300px;margin-top:1rem;\">Family-run plumbers and heating engineers serving Leeds for over 30 years.</p>\n      </div>\n      <div>\n        <h4>Services</h4>\n        <ul>\n          <li><a href=\"#services\">Emergency call-outs</a></li>\n          <li><a href=\"#services\">Boiler repair</a></li>\n          <li><a href=\"#services\">Bathroom installs</a></li>\n          <li><a href=\"#services\">Drain clearing</a></li>\n          <li><a href=\"#services\">Central heating</a></li>\n        </ul>\n      </div>\n      <div>\n        <h4>Company</h4>\n        <ul>\n          <li><a href=\"#family\">About us</a></li>\n          <li><a href=\"#reviews\">Reviews</a></li>\n          <li><a href=\"#pricing\">Pricing</a></li>\n          <li><a href=\"#\">Careers</a></li>\n          <li><a href=\"#\">Privacy policy</a></li>\n        </ul>\n      </div>\n      <div>\n        <h4>Contact</h4>\n        <ul>\n          <li><a href=\"tel:01130000000\">0113 000 0000</a></li>\n          <li><a href=\"mailto:hello@hartleyplumbing.example\">Email us</a></li>\n          <li>14 Otley Road, Headingley<br>Leeds LS6 3PN</li>\n        </ul>\n      </div>\n    </div>\n\n    <div class=\"foot-bottom\">\n      <span>\u00a9 <span id=\"year\">2025</span> Hartley Family Plumbing Ltd. Registered in England & Wales.</span>\n      <span>Gas Safe Reg No. 000000 \u00b7 WaterSafe Approved \u00b7 Fully insured</span>\n    </div>\n  </div>\n</footer>\n\n<!-- Mobile sticky call button -->\n<a href=\"tel:01130000000\" class=\"mobile-call\">Call now \u00b7 0113 000 0000</a>\n\n<script>\n  // Mobile menu\n  const toggle = document.getElementById('menuToggle');\n  const navLinks = document.getElementById('navLinks');\n  toggle.addEventListener('click', () => {\n    const open = navLinks.classList.toggle('open');\n    toggle.setAttribute('aria-expanded', open);\n  });\n  navLinks.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {\n    navLinks.classList.remove('open');\n    toggle.setAttribute('aria-expanded', 'false');\n  }));\n\n  // Booking form (front-end only)\n  const form = document.getElementById('bookingForm');\n  form.addEventListener('submit', (e) => {\n    e.preventDefault();\n    const invalid = [...form.querySelectorAll('[required]')].find(f => !f.value.trim());\n    if (invalid) {\n      invalid.focus();\n      invalid.style.borderColor = 'var(--copper)';\n      return;\n    }\n    form.style.display = 'none';\n    document.getElementById('formSuccess').style.display = 'block';\n  });\n\n  // Footer year\n  document.getElementById('year').textContent = new Date().getFullYear();\n</script>\n\n</body>\n</html>\n"}