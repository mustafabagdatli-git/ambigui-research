{"brief": "B3", "model": "openai/gpt-6-luna", "i": 4, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"description\" content=\"Morrow is the open-source database built for modern data engineering teams.\">\n  <title>Morrow \u2014 A database for data engineers</title>\n  <style>\n    :root {\n      color-scheme: light;\n      --ink: #182321;\n      --muted: #66716d;\n      --paper: #f7f7f2;\n      --line: #e4e7df;\n      --green: #c8f169;\n      --green-dark: #9dc944;\n      --forest: #152522;\n      --white: #fff;\n      --mono: \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace;\n      --sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n    }\n\n    * { box-sizing: border-box; }\n\n    html { scroll-behavior: smooth; }\n\n    body {\n      margin: 0;\n      color: var(--ink);\n      background: var(--paper);\n      font-family: var(--sans);\n      -webkit-font-smoothing: antialiased;\n    }\n\n    a { color: inherit; text-decoration: none; }\n\n    .container {\n      width: min(1160px, calc(100% - 48px));\n      margin: 0 auto;\n    }\n\n    .topbar {\n      height: 76px;\n      display: flex;\n      align-items: center;\n      border-bottom: 1px solid rgba(24, 35, 33, .08);\n    }\n\n    .nav {\n      width: min(1320px, calc(100% - 48px));\n      margin: 0 auto;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 32px;\n    }\n\n    .brand {\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      font-size: 19px;\n      font-weight: 760;\n      letter-spacing: -.06em;\n    }\n\n    .brand-mark {\n      width: 28px;\n      height: 28px;\n      border-radius: 9px;\n      display: grid;\n      place-items: center;\n      background: var(--forest);\n      color: var(--green);\n    }\n\n    .brand-mark svg { width: 17px; height: 17px; }\n\n    .nav-links {\n      display: flex;\n      align-items: center;\n      gap: 34px;\n      margin-left: auto;\n      color: #53605b;\n      font-size: 13px;\n      font-weight: 550;\n    }\n\n    .nav-links a:hover { color: var(--ink); }\n\n    .nav-actions {\n      display: flex;\n      align-items: center;\n      gap: 20px;\n      font-size: 13px;\n      font-weight: 650;\n    }\n\n    .github-link {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      color: var(--ink);\n    }\n\n    .github-link svg { width: 16px; height: 16px; }\n\n    .button {\n      min-height: 44px;\n      padding: 0 18px;\n      border-radius: 7px;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: 9px;\n      background: var(--green);\n      color: var(--ink);\n      font-size: 13px;\n      font-weight: 750;\n      transition: transform .18s ease, background .18s ease;\n    }\n\n    .button:hover {\n      background: #d5fa88;\n      transform: translateY(-1px);\n    }\n\n    .button-dark {\n      background: var(--forest);\n      color: var(--white);\n    }\n\n    .button-dark:hover { background: #263c36; }\n\n    .button svg { width: 15px; height: 15px; }\n\n    .hero {\n      padding: 76px 0 84px;\n      overflow: hidden;\n    }\n\n    .hero-grid {\n      display: grid;\n      grid-template-columns: .91fr 1.09fr;\n      align-items: center;\n      gap: 72px;\n    }\n\n    .eyebrow {\n      display: inline-flex;\n      align-items: center;\n      gap: 9px;\n      color: #53605b;\n      font-family: var(--mono);\n      font-size: 11px;\n      letter-spacing: .06em;\n      text-transform: uppercase;\n    }\n\n    .eyebrow-dot {\n      width: 7px;\n      height: 7px;\n      border-radius: 50%;\n      background: #80b832;\n      box-shadow: 0 0 0 4px rgba(128, 184, 50, .14);\n    }\n\n    h1 {\n      max-width: 590px;\n      margin: 22px 0 20px;\n      font-size: clamp(44px, 5.5vw, 70px);\n      line-height: .99;\n      letter-spacing: -.075em;\n      font-weight: 680;\n    }\n\n    h1 span { color: #73807a; }\n\n    .hero-copy {\n      max-width: 480px;\n      margin: 0;\n      color: #606c66;\n      font-size: 17px;\n      line-height: 1.65;\n      letter-spacing: -.02em;\n    }\n\n    .hero-buttons {\n      display: flex;\n      align-items: center;\n      flex-wrap: wrap;\n      gap: 12px;\n      margin-top: 30px;\n    }\n\n    .text-link {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      padding: 12px 7px;\n      color: #35423d;\n      font-size: 13px;\n      font-weight: 700;\n    }\n\n    .text-link:hover { color: #719b2d; }\n\n    .hero-note {\n      display: flex;\n      align-items: center;\n      gap: 9px;\n      margin-top: 21px;\n      color: #78817c;\n      font-size: 11px;\n    }\n\n    .hero-note svg { width: 14px; height: 14px; color: #77857c; }\n\n    .product-window {\n      position: relative;\n      min-height: 438px;\n      padding: 13px;\n      border: 1px solid rgba(255,255,255,.11);\n      border-radius: 15px;\n      background:\n        radial-gradient(ellipse at 85% 4%, rgba(115, 171, 96, .13), transparent 39%),\n        #172421;\n      box-shadow: 0 28px 70px rgba(31, 47, 39, .16);\n      color: #e4e9df;\n    }\n\n    .window-top {\n      height: 38px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 0 10px 10px;\n      border-bottom: 1px solid rgba(255,255,255,.09);\n    }\n\n    .window-dots { display: flex; gap: 5px; }\n    .window-dots i {\n      width: 7px;\n      height: 7px;\n      border-radius: 50%;\n      background: #50625a;\n    }\n\n    .window-title {\n      color: #829089;\n      font-family: var(--mono);\n      font-size: 10px;\n    }\n\n    .window-status {\n      display: flex;\n      align-items: center;\n      gap: 6px;\n      color: #a9c989;\n      font-family: var(--mono);\n      font-size: 9px;\n    }\n\n    .window-status i {\n      width: 6px;\n      height: 6px;\n      background: #9ad65b;\n      border-radius: 50%;\n    }\n\n    .dashboard {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 10px;\n      padding: 12px 0 0;\n    }\n\n    .dash-card {\n      min-height: 111px;\n      padding: 15px;\n      border: 1px solid rgba(255,255,255,.08);\n      border-radius: 8px;\n      background: rgba(255,255,255,.035);\n    }\n\n    .dash-label {\n      color: #8f9e96;\n      font-family: var(--mono);\n      font-size: 9px;\n      letter-spacing: .05em;\n      text-transform: uppercase;\n    }\n\n    .metric {\n      margin-top: 11px;\n      color: #f0f2e9;\n      font-size: 26px;\n      font-weight: 620;\n      letter-spacing: -.06em;\n    }\n\n    .metric small {\n      margin-left: 5px;\n      color: #9ac96a;\n      font-family: var(--mono);\n      font-size: 10px;\n      font-weight: 500;\n      letter-spacing: 0;\n    }\n\n    .chart {\n      height: 35px;\n      display: flex;\n      align-items: end;\n      gap: 5px;\n      margin-top: 9px;\n    }\n\n    .chart span {\n      flex: 1;\n      min-width: 4px;\n      border-radius: 2px 2px 0 0;\n      background: linear-gradient(180deg, #b9e777, #638c49);\n      opacity: .86;\n    }\n\n    .chart span:nth-child(1) { height: 31%; }\n    .chart span:nth-child(2) { height: 48%; }\n    .chart span:nth-child(3) { height: 39%; }\n    .chart span:nth-child(4) { height: 62%; }\n    .chart span:nth-child(5) { height: 52%; }\n    .chart span:nth-child(6) { height: 78%; }\n    .chart span:nth-child(7) { height: 68%; }\n    .chart span:nth-child(8) { height: 100%; }\n    .chart span:nth-child(9) { height: 82%; }\n    .chart span:nth-child(10) { height: 94%; }\n\n    .query-card {\n      grid-column: 1 / -1;\n      min-height: 201px;\n      padding: 14px 15px 11px;\n      border: 1px solid rgba(255,255,255,.08);\n      border-radius: 8px;\n      background: rgba(8, 16, 14, .34);\n    }\n\n    .query-head {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      padding-bottom: 11px;\n      border-bottom: 1px solid rgba(255,255,255,.08);\n      color: #91a097;\n      font-family: var(--mono);\n      font-size: 9px;\n    }\n\n    .query-head span:last-child { color: #a7c883; }\n\n    pre {\n      margin: 13px 0 0;\n      color: #c8d2c9;\n      font-family: var(--mono);\n      font-size: 11px;\n      line-height: 1.8;\n      white-space: pre-wrap;\n    }\n\n    .kw { color: #a8d773; }\n    .fn { color: #e5c98e; }\n    .id { color: #8fbdcf; }\n    .comment { color: #73847a; }\n\n    .query-result {\n      display: flex;\n      justify-content: space-between;\n      margin-top: 10px;\n      padding-top: 9px;\n      border-top: 1px solid rgba(255,255,255,.08);\n      color: #83938a;\n      font-family: var(--mono);\n      font-size: 9px;\n    }\n\n    .query-result strong { color: #b9d994; font-weight: 500; }\n\n    .trust {\n      padding: 22px 0 26px;\n      border-top: 1px solid var(--line);\n      border-bottom: 1px solid var(--line);\n    }\n\n    .trust-inner {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 30px;\n    }\n\n    .trust-label {\n      color: #818a84;\n      font-family: var(--mono);\n      font-size: 10px;\n      letter-spacing: .06em;\n      text-transform: uppercase;\n    }\n\n    .trust-items {\n      display: flex;\n      align-items: center;\n      gap: clamp(24px, 5vw, 64px);\n      color: #627069;\n      font-size: 14px;\n      font-weight: 690;\n      letter-spacing: -.04em;\n    }\n\n    .trust-items span { white-space: nowrap; }\n    .trust-items span:nth-child(2) { font-family: var(--mono); font-size: 12px; }\n    .trust-items span:nth-child(3) { font-style: italic; }\n    .trust-items span:nth-child(4) { letter-spacing: .08em; font-size: 12px; }\n\n    .section { padding: 105px 0; }\n\n    .section-heading {\n      display: flex;\n      align-items: end;\n      justify-content: space-between;\n      gap: 36px;\n      margin-bottom: 43px;\n    }\n\n    .section-kicker {\n      margin-bottom: 13px;\n      color: #748079;\n      font-family: var(--mono);\n      font-size: 10px;\n      letter-spacing: .08em;\n      text-transform: uppercase;\n    }\n\n    h2 {\n      max-width: 570px;\n      margin: 0;\n      font-size: clamp(34px, 4.2vw, 48px);\n      line-height: 1.06;\n      letter-spacing: -.065em;\n      font-weight: 650;\n    }\n\n    .section-intro {\n      max-width: 340px;\n      margin: 0 0 3px;\n      color: #6b7771;\n      font-size: 14px;\n      line-height: 1.7;\n    }\n\n    .features {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 14px;\n    }\n\n    .feature {\n      min-height: 230px;\n      padding: 25px;\n      border: 1px solid var(--line);\n      border-radius: 9px;\n      background: rgba(255,255,255,.44);\n    }\n\n    .feature-icon {\n      width: 38px;\n      height: 38px;\n      display: grid;\n      place-items: center;\n      margin-bottom: 28px;\n      border-radius: 9px;\n      background: #eaf1dc;\n      color: #526c31;\n    }\n\n    .feature-icon svg { width: 19px; height: 19px; }\n\n    .feature h3 {\n      margin: 0 0 9px;\n      font-size: 16px;\n      letter-spacing: -.035em;\n    }\n\n    .feature p {\n      max-width: 290px;\n      margin: 0;\n      color: #707a74;\n      font-size: 13px;\n      line-height: 1.7;\n    }\n\n    .workflow-section {\n      padding: 85px 0;\n      background: #eaf0e4;\n    }\n\n    .workflow-grid {\n      display: grid;\n      grid-template-columns: .83fr 1.17fr;\n      align-items: center;\n      gap: 78px;\n    }\n\n    .workflow-copy h2 { max-width: 440px; }\n\n    .workflow-copy p {\n      max-width: 425px;\n      margin: 19px 0 25px;\n      color: #66736b;\n      font-size: 14px;\n      line-height: 1.75;\n    }\n\n    .pipeline {\n      position: relative;\n      padding: 24px;\n      border: 1px solid rgba(24,35,33,.1);\n      border-radius: 11px;\n      background: rgba(255,255,255,.61);\n    }\n\n    .pipeline-label {\n      margin-bottom: 18px;\n      color: #718078;\n      font-family: var(--mono);\n      font-size: 9px;\n      letter-spacing: .08em;\n      text-transform: uppercase;\n    }\n\n    .pipeline-row {\n      display: grid;\n      grid-template-columns: 1fr 28px 1fr 28px 1fr;\n      align-items: center;\n      gap: 7px;\n    }\n\n    .pipeline-node {\n      min-height: 86px;\n      padding: 15px 12px;\n      border: 1px solid #e1e7dc;\n      border-radius: 7px;\n      background: #fbfcf8;\n    }\n\n    .node-top {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      margin-bottom: 12px;\n      font-size: 11px;\n      font-weight: 700;\n    }\n\n    .node-icon {\n      width: 21px;\n      height: 21px;\n      display: grid;\n      place-items: center;\n      border-radius: 5px;\n      background: #eaf1dc;\n      color: #55723b;\n      font-size: 11px;\n    }\n\n    .node-meta {\n      color: #859089;\n      font-family: var(--mono);\n      font-size: 8px;\n    }\n\n    .pipe-arrow {\n      color: #9cac8e;\n      font-size: 18px;\n      text-align: center;\n    }\n\n    .pipeline-foot {\n      display: flex;\n      justify-content: space-between;\n      margin-top: 18px;\n      padding-top: 14px;\n      border-top: 1px solid #e3e9de;\n      color: #77837b;\n      font-family: var(--mono);\n      font-size: 9px;\n    }\n\n    .pipeline-foot strong { color: #64823f; font-weight: 600; }\n\n    .code-section { padding: 105px 0; }\n\n    .code-grid {\n      display: grid;\n      grid-template-columns: .85fr 1.15fr;\n      align-items: center;\n      gap: 70px;\n    }\n\n    .code-copy h2 { max-width: 450px; }\n\n    .code-copy p {\n      max-width: 410px;\n      margin: 18px 0 22px;\n      color: #68756e;\n      font-size: 14px;\n      line-height: 1.75;\n    }\n\n    .code-panel {\n      overflow: hidden;\n      border-radius: 10px;\n      background: #172421;\n      box-shadow: 0 22px 55px rgba(31, 47, 39, .13);\n      color: #d9e1d8;\n    }\n\n    .code-panel-header {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 15px 19px;\n      border-bottom: 1px solid rgba(255,255,255,.09);\n      color: #8d9a92;\n      font-family: var(--mono);\n      font-size: 10px;\n    }\n\n    .code-panel-header span:last-child {\n      color: #b8d895;\n      font-size: 9px;\n    }\n\n    .code-panel pre {\n      padding: 13px 20px 21px;\n      font-size: 11px;\n      line-height: 2;\n    }\n\n    .closing {\n      padding: 68px 0;\n      background: var(--forest);\n      color: #f4f5ee;\n    }\n\n    .closing-inner {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 40px;\n    }\n\n    .closing h2 {\n      max-width: 620px;\n      font-size: clamp(34px, 4.3vw, 50px);\n    }\n\n    .closing p {\n      margin: 14px 0 0;\n      color: #aab7ad;\n      font-size: 14px;\n    }\n\n    .closing-actions {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 11px;\n    }\n\n    .closing .button-dark {\n      border: 1px solid rgba(255,255,255,.18);\n      background: transparent;\n    }\n\n    .closing .button-dark:hover { background: rgba(255,255,255,.08); }\n\n    footer {\n      padding: 24px 0;\n      background: var(--forest);\n      color: #91a097;\n    }\n\n    .footer-inner {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      gap: 24px;\n      padding-top: 21px;\n      border-top: 1px solid rgba(255,255,255,.12);\n      font-size: 11px;\n    }\n\n    .footer-links { display: flex; gap: 24px; }\n    .footer-links a:hover { color: #e7eee7; }\n\n    @media (max-width: 900px) {\n      .hero-grid { gap: 38px; }\n      .workflow-grid, .code-grid { gap: 42px; }\n      .nav-links { gap: 20px; }\n      .trust-inner { align-items: flex-start; flex-direction: column; gap: 17px; }\n    }\n\n    @media (max-width: 700px) {\n      .container, .nav { width: min(100% - 36px, 540px); }\n      .topbar { height: 66px; }\n      .nav-links, .github-link { display: none; }\n      .nav-actions { margin-left: auto; }\n      .nav-actions .button { min-height: 39px; padding: 0 13px; }\n      .hero { padding: 58px 0 61px; }\n      .hero-grid, .workflow-grid, .code-grid { grid-template-columns: 1fr; }\n      .hero-grid { gap: 42px; }\n      .hero-copy { font-size: 15px; }\n      .product-window { min-height: auto; }\n      .section { padding: 76px 0; }\n      .section-heading { display: block; margin-bottom: 30px; }\n      .section-intro { margin-top: 16px; }\n      .features { grid-template-columns: 1fr; }\n      .feature { min-height: auto; }\n      .feature-icon { margin-bottom: 20px; }\n      .workflow-section { padding: 70px 0; }\n      .workflow-grid, .code-grid { gap: 36px; }\n      .pipeline { padding: 16px; }\n      .pipeline-row { grid-template-columns: 1fr; gap: 7px; }\n      .pipeline-node { min-height: auto; }\n      .node-top { margin-bottom: 7px; }\n      .pipe-arrow { transform: rotate(90deg); height: 16px; line-height: 16px; }\n      .closing { padding: 55px 0; }\n      .closing-inner { align-items: flex-start; flex-direction: column; }\n      .footer-inner { align-items: flex-start; flex-direction: column; }\n    }\n\n    @media (max-width: 420px) {\n      .hero-buttons { align-items: stretch; flex-direction: column; }\n      .hero-buttons .button, .hero-buttons .text-link { justify-content: center; }\n      .trust-items { width: 100%; flex-wrap: wrap; gap: 17px 25px; }\n      .dashboard { gap: 7px; }\n      .dash-card { padding: 11px; }\n      .metric { font-size: 22px; }\n      pre { font-size: 9px; }\n      .query-card { padding: 12px; }\n      .footer-links { flex-wrap: wrap; gap: 12px 18px; }\n    }\n  </style>\n</head>\n<body>\n  <header class=\"topbar\">\n    <nav class=\"nav\" aria-label=\"Main navigation\">\n      <a class=\"brand\" href=\"#\" aria-label=\"Morrow home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 20 20\" fill=\"none\">\n            <path d=\"M3 5.2 10 2l7 3.2v9.6L10 18l-7-3.2V5.2Z\" stroke=\"currentColor\" stroke-width=\"1.6\"/>\n            <path d=\"m3.5 5.5 6.5 3 6.5-3M10 8.7v8.5\" stroke=\"currentColor\" stroke-width=\"1.6\"/>\n          </svg>\n        </span>\n        morrow\n      </a>\n\n      <div class=\"nav-links\">\n        <a href=\"#features\">Product</a>\n        <a href=\"#workflow\">How it works</a>\n        <a href=\"#docs\">Docs</a>\n        <a href=\"#community\">Community</a>\n      </div>\n\n      <div class=\"nav-actions\">\n        <a class=\"github-link\" href=\"https://github.com/\" aria-label=\"Visit GitHub\">\n          <svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\">\n            <path d=\"M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.1c-3.1.68-3.76-1.32-3.76-1.32-.5-1.29-1.24-1.63-1.24-1.63-1.01-.69.08-.68.08-.68 1.12.08 1.7 1.15 1.7 1.15.99 1.69 2.6 1.2 3.23.92.1-.72.39-1.2.7-1.48-2.48-.28-5.09-1.24-5.09-5.52 0-1.22.44-2.21 1.15-2.99-.12-.28-.5-1.42.11-2.95 0 0 .94-.3 3.06 1.14a10.6 10.6 0 0 1 5.57 0c2.12-1.44 3.05-1.14 3.05-1.14.61 1.53.23 2.67.12 2.95.71.78 1.14 1.77 1.14 2.99 0 4.29-2.62 5.23-5.11 5.51.4.35.75 1.02.75 2.06v3.09c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z\"/>\n          </svg>\n          GitHub\n        </a>\n        <a class=\"button\" href=\"#get-started\">Get started <span aria-hidden=\"true\">\u2197</span></a>\n      </div>\n    </nav>\n  </header>\n\n  <main>\n    <section class=\"hero\">\n      <div class=\"container hero-grid\">\n        <div>\n          <div class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> Open source. Built for the data layer.</div>\n          <h1>Your data stack,<br><span>minus the duct tape.</span></h1>\n          <p class=\"hero-copy\">\n            Meet the open-source database that brings your pipelines, analytics, and SQL together\u2014without adding another black box.\n          </p>\n          <div class=\"hero-buttons\">\n            <a class=\"button\" href=\"#get-started\">Start building <span aria-hidden=\"true\">\u2192</span></a>\n            <a class=\"text-link\" href=\"#docs\">Explore the docs <span aria-hidden=\"true\">\u2197</span></a>\n          </div>\n          <div class=\"hero-note\">\n            <svg viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\">\n              <path d=\"M10 2.5 16 5v4.6c0 3.7-2.6 6.4-6 7.9-3.4-1.5-6-4.2-6-7.9V5l6-2.5Z\" stroke=\"currentColor\" stroke-width=\"1.4\"/>\n              <path d=\"m7.4 9.8 1.7 1.7 3.6-3.8\" stroke=\"currentColor\" stroke-width=\"1.4\"/>\n            </svg>\n            Apache 2.0 \u00b7 Your infrastructure, your rules\n          </div>\n        </div>\n\n        <div class=\"product-window\" aria-label=\"Morrow database dashboard preview\">\n          <div class=\"window-top\">\n            <div class=\"window-dots\" aria-hidden=\"true\"><i></i><i></i><i></i></div>\n            <div class=\"window-title\">morrow / analytics</div>\n            <div class=\"window-status\"><i></i> ALL SYSTEMS GO</div>\n          </div>\n\n          <div class=\"dashboard\">\n            <div class=\"dash-card\">\n              <div class=\"dash-label\">Rows processed</div>\n              <div class=\"metric\">8.42B <small>\u2197 18.6%</small></div>\n              <div class=\"chart\" aria-hidden=\"true\">\n                <span></span><span></span><span></span><span></span><span></span>\n                <span></span><span></span><span></span><span></span><span></span>\n              </div>\n            </div>\n            <div class=\"dash-card\">\n              <div class=\"dash-label\">Query latency \u00b7 p95</div>\n              <div class=\"metric\">42<small>ms</small></div>\n              <div class=\"chart\" aria-hidden=\"true\">\n                <span></span><span></span><span></span><span></span><span></span>\n                <span></span><span></span><span></span><span></span><span></span>\n              </div>\n            </div>\n\n            <div class=\"query-card\">\n              <div class=\"query-head\">\n                <span>QUERY EDITOR / 01</span>\n                <span>\u25cf RUNNING</span>\n              </div>\n              <pre><span class=\"comment\">-- daily active accounts, last 30 days</span>\n<span class=\"kw\">SELECT</span> <span class=\"fn\">date_trunc</span>(<span class=\"id\">'day'</span>, event_time) <span class=\"kw\">AS</span> day,\n       <span class=\"fn\">count_distinct</span>(account_id) <span class=\"kw\">AS</span> active_accounts\n<span class=\"kw\">FROM</span> <span class=\"id\">events.app_activity</span>\n<span class=\"kw\">WHERE</span> event_time &gt; <span class=\"fn\">now</span>() - <span class=\"id\">INTERVAL '30 days'</span>\n<span class=\"kw\">GROUP BY</span> 1 <span class=\"kw\">ORDER BY</span> 1;</pre>\n              <div class=\"query-result\">\n                <span>30 rows returned \u00b7 42 ms</span>\n                <strong>Results updated just now</strong>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"trust\" aria-label=\"Built for engineering teams\">\n      <div class=\"container trust-inner\">\n        <div class=\"trust-label\">Fits right into your stack</div>\n        <div class=\"trust-items\">\n          <span>dbt</span>\n          <span>\u25b8 AIRFLOW</span>\n          <span>Kafka</span>\n          <span>DUCKDB</span>\n          <span>+ your tools</span>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section\" id=\"features\">\n      <div class=\"container\">\n        <div class=\"section-heading\">\n          <div>\n            <div class=\"section-kicker\">Less plumbing. More progress.</div>\n            <h2>The data layer that lets you get back to the data.</h2>\n          </div>\n          <p class=\"section-intro\">\n            Built around the way data teams actually work: open formats, familiar SQL, and infrastructure you can understand.\n          </p>\n        </div>\n\n        <div class=\"features\">\n          <article class=\"feature\">\n            <div class=\"feature-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M4 6h16M4 12h10M4 18h16M17 9l3 3-3 3\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            </div>\n            <h3>One place for every workload</h3>\n            <p>Bring batch jobs, streaming data, and interactive queries together instead of stitching together another stack.</p>\n          </article>\n\n          <article class=\"feature\">\n            <div class=\"feature-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M5 19V9m7 10V5m7 14v-7\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/><path d=\"M3 19h18\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg>\n            </div>\n            <h3>Fast where it counts</h3>\n            <p>Columnar execution and smart pruning make large analytical queries feel a lot less like waiting around.</p>\n          </article>\n\n          <article class=\"feature\">\n            <div class=\"feature-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 3 4.5 6v5.5c0 4.1 3 7.4 7.5 9.5 4.5-2.1 7.5-5.4 7.5-9.5V6L12 3Z\" stroke=\"currentColor\" stroke-width=\"1.6\"/><path d=\"m9 12 2 2 4-4\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            </div>\n            <h3>Open by design</h3>\n            <p>Self-host, inspect the code, and keep your data in open formats. No mystery layers or lock-in surprises.</p>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"workflow-section\" id=\"workflow\">\n      <div class=\"container workflow-grid\">\n        <div class=\"workflow-copy\">\n          <div class=\"section-kicker\">Fits your workflow</div>\n          <h2>From raw events to ready-to-query.</h2>\n          <p>\n            Keep the tools your team already loves. Morrow sits in the middle, so data can move from source to insight without a maze of one-off connectors.\n          </p>\n          <a class=\"text-link\" href=\"#docs\">See how it works <span aria-hidden=\"true\">\u2192</span></a>\n        </div>\n\n        <div class=\"pipeline\" aria-label=\"Example data pipeline\">\n          <div class=\"pipeline-label\">A simpler path through your data stack</div>\n          <div class=\"pipeline-row\">\n            <div class=\"pipeline-node\">\n              <div class=\"node-top\"><span class=\"node-icon\">\u2197</span> Ingest</div>\n              <div class=\"node-meta\">events \u00b7 files \u00b7 streams</div>\n            </div>\n            <div class=\"pipe-arrow\" aria-hidden=\"true\">\u2192</div>\n            <div class=\"pipeline-node\">\n              <div class=\"node-top\"><span class=\"node-icon\">\u25c8</span> Morrow</div>\n              <div class=\"node-meta\">store \u00b7 transform \u00b7 query</div>\n            </div>\n            <div class=\"pipe-arrow\" aria-hidden=\"true\">\u2192</div>\n            <div class=\"pipeline-node\">\n              <div class=\"node-top\"><span class=\"node-icon\">\u2301</span> Build</div>\n              <div class=\"node-meta\">models \u00b7 metrics \u00b7 apps</div>\n            </div>\n          </div>\n          <div class=\"pipeline-foot\">\n            <span>Open formats, end to end</span>\n            <strong>YOUR DATA STAYS YOURS \u2713</strong>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"code-section\" id=\"docs\">\n      <div class=\"container code-grid\">\n        <div class=\"code-copy\">\n          <div class=\"section-kicker\">SQL first. No ceremony.</div>\n          <h2>Feels familiar from the first query.</h2>\n          <p>\n            Get productive with SQL you already know, then grow into pipelines and automation as your data needs evolve.\n          </p>\n          <a class=\"text-link\" href=\"#get-started\">Read the quickstart <span aria-hidden=\"true\">\u2197</span></a>\n        </div>\n\n        <div class=\"code-panel\">\n          <div class=\"code-panel-header\">\n            <span>quickstart.sql</span>\n            <span>READY TO RUN</span>\n          </div>\n          <pre><span class=\"comment\">-- Create a table from a data file</span>\n<span class=\"kw\">CREATE TABLE</span> events\n<span class=\"kw\">AS SELECT</span> *\n<span class=\"kw\">FROM</span> <span class=\"fn\">read_parquet</span>(<span class=\"id\">'./data/events/*.parquet'</span>);\n\n<span class=\"comment\">-- Query it right away</span>\n<span class=\"kw\">SELECT</span> event_type, <span class=\"fn\">count</span>(*) <span class=\"kw\">AS</span> total\n<span class=\"kw\">FROM</span> events\n<span class=\"kw\">GROUP BY</span> event_type\n<span class=\"kw\">ORDER BY</span> total <span class=\"kw\">DESC</span>;</pre>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"closing\" id=\"get-started\">\n      <div class=\"container closing-inner\">\n        <div>\n          <h2>Build a data stack you can actually explain.</h2>\n          <p>Open source, SQL-native, and ready for your next pipeline.</p>\n        </div>\n        <div class=\"closing-actions\">\n          <a class=\"button\" href=\"https://github.com/\">Explore on GitHub <span aria-hidden=\"true\">\u2197</span></a>\n          <a class=\"button button-dark\" href=\"#docs\">Read the docs</a>\n        </div>\n      </div>\n    </section>\n  </main>\n\n  <footer id=\"community\">\n    <div class=\"container footer-inner\">\n      <a class=\"brand\" href=\"#\" aria-label=\"Morrow home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 20 20\" fill=\"none\">\n            <path d=\"M3 5.2 10 2l7 3.2v9.6L10 18l-7-3.2V5.2Z\" stroke=\"currentColor\" stroke-width=\"1.6\"/>\n            <path d=\"m3.5 5.5 6.5 3 6.5-3M10 8.7v8.5\" stroke=\"currentColor\" stroke-width=\"1.6\"/>\n          </svg>\n        </span>\n        morrow\n      </a>\n      <span>Open source, built in the open. \u00a9 2025 Morrow contributors.</span>\n      <div class=\"footer-links\">\n        <a href=\"#docs\">Documentation</a>\n        <a href=\"https://github.com/\">GitHub</a>\n        <a href=\"#community\">Community</a>\n      </div>\n    </div>\n  </footer>\n</body>\n</html>\n"}