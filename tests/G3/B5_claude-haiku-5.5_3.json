{"brief": "B5", "model": "anthropic/claude-haiku-5.5", "i": 3, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Harbor Sexual Health Clinic | Walk-In Testing, Care & Prevention</title>\n  <meta name=\"description\" content=\"Walk in any time during open hours for confidential STI testing, HIV testing, PrEP, contraception, and sexual health care. No appointment needed.\">\n  <style>\n    :root {\n      --teal-900: #0b3b3c;\n      --teal-700: #17686a;\n      --teal-500: #2a9d8f;\n      --teal-100: #d9f0ec;\n      --sand-50: #fbf8f3;\n      --sand-100: #f4eee4;\n      --coral-500: #e76f51;\n      --coral-100: #fde7de;\n      --ink: #1e2a2b;\n      --ink-soft: #4b5b5c;\n      --line: #e2dcd0;\n      --white: #ffffff;\n      --radius: 14px;\n      --shadow: 0 6px 24px rgba(11, 59, 60, 0.08);\n    }\n\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n\n    html { scroll-behavior: smooth; }\n\n    body {\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n      color: var(--ink);\n      background: var(--sand-50);\n      line-height: 1.6;\n      font-size: 16px;\n    }\n\n    img, svg { display: block; max-width: 100%; }\n\n    a { color: var(--teal-700); }\n    a:focus-visible, button:focus-visible, summary:focus-visible {\n      outline: 3px solid var(--coral-500);\n      outline-offset: 3px;\n      border-radius: 4px;\n    }\n\n    .container {\n      width: min(1120px, 92%);\n      margin-inline: auto;\n    }\n\n    .skip-link {\n      position: absolute;\n      left: -9999px;\n      top: 8px;\n      background: var(--white);\n      padding: 8px 14px;\n      border-radius: 8px;\n      z-index: 100;\n    }\n    .skip-link:focus { left: 8px; }\n\n    /* ---------- Quick exit bar ---------- */\n    .quick-exit {\n      background: var(--teal-900);\n      color: #cfe9e5;\n      font-size: 0.85rem;\n      padding: 6px 0;\n    }\n    .quick-exit .container {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      gap: 12px;\n      flex-wrap: wrap;\n    }\n    .quick-exit a {\n      color: var(--white);\n      font-weight: 600;\n      text-decoration: none;\n      background: var(--coral-500);\n      padding: 4px 12px;\n      border-radius: 999px;\n    }\n    .quick-exit a:hover { background: #d65d40; }\n\n    /* ---------- Header ---------- */\n    header.site-header {\n      background: var(--white);\n      border-bottom: 1px solid var(--line);\n      position: sticky;\n      top: 0;\n      z-index: 50;\n    }\n    .nav {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 14px 0;\n      gap: 16px;\n    }\n    .brand {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      font-weight: 700;\n      font-size: 1.1rem;\n      color: var(--teal-900);\n      text-decoration: none;\n    }\n    .brand small {\n      display: block;\n      font-weight: 500;\n      font-size: 0.75rem;\n      color: var(--ink-soft);\n    }\n    .nav-links {\n      display: flex;\n      gap: 22px;\n      list-style: none;\n      align-items: center;\n    }\n    .nav-links a {\n      text-decoration: none;\n      color: var(--ink);\n      font-weight: 500;\n      font-size: 0.95rem;\n    }\n    .nav-links a:hover { color: var(--teal-500); }\n    .nav-cta {\n      background: var(--teal-700);\n      color: var(--white) !important;\n      padding: 10px 18px;\n      border-radius: 999px;\n    }\n    .nav-cta:hover { background: var(--teal-900); }\n\n    /* ---------- Buttons ---------- */\n    .btn {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      padding: 14px 24px;\n      border-radius: 999px;\n      font-weight: 600;\n      font-size: 1rem;\n      text-decoration: none;\n      border: 2px solid transparent;\n      cursor: pointer;\n      transition: background 0.2s, color 0.2s, transform 0.1s;\n    }\n    .btn:active { transform: translateY(1px); }\n    .btn-primary {\n      background: var(--teal-700);\n      color: var(--white);\n    }\n    .btn-primary:hover { background: var(--teal-900); }\n    .btn-outline {\n      background: transparent;\n      border-color: var(--teal-700);\n      color: var(--teal-700);\n    }\n    .btn-outline:hover { background: var(--teal-100); }\n\n    /* ---------- Hero ---------- */\n    .hero {\n      background:\n        radial-gradient(circle at 85% 20%, var(--teal-100) 0, transparent 40%),\n        linear-gradient(180deg, var(--sand-50), var(--sand-100));\n      padding: 72px 0 64px;\n    }\n    .hero-grid {\n      display: grid;\n      grid-template-columns: 1.1fr 0.9fr;\n      gap: 48px;\n      align-items: center;\n    }\n    .eyebrow {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      background: var(--white);\n      border: 1px solid var(--line);\n      padding: 6px 14px;\n      border-radius: 999px;\n      font-size: 0.85rem;\n      font-weight: 600;\n      color: var(--teal-700);\n      margin-bottom: 20px;\n    }\n    .dot {\n      width: 9px; height: 9px;\n      border-radius: 50%;\n      background: #2ecc71;\n      box-shadow: 0 0 0 4px rgba(46, 204, 113, 0.2);\n    }\n    .dot.closed { background: #b0b7b8; box-shadow: 0 0 0 4px rgba(176,183,184,0.25); }\n    h1 {\n      font-size: clamp(2.2rem, 4.5vw, 3.4rem);\n      line-height: 1.12;\n      color: var(--teal-900);\n      letter-spacing: -0.02em;\n      margin-bottom: 18px;\n    }\n    .hero p.lead {\n      font-size: 1.15rem;\n      color: var(--ink-soft);\n      max-width: 36ch;\n      margin-bottom: 28px;\n    }\n    .hero-actions {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 12px;\n      margin-bottom: 26px;\n    }\n    .hero-notes {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 18px;\n      font-size: 0.92rem;\n      color: var(--ink-soft);\n    }\n    .hero-notes span::before {\n      content: \"\u2713 \";\n      color: var(--teal-500);\n      font-weight: 700;\n    }\n\n    .hero-card {\n      background: var(--white);\n      border-radius: 20px;\n      box-shadow: var(--shadow);\n      padding: 28px;\n      border: 1px solid var(--line);\n    }\n    .hero-card h3 {\n      color: var(--teal-900);\n      font-size: 1.15rem;\n      margin-bottom: 14px;\n    }\n    .wait-row {\n      display: flex;\n      justify-content: space-between;\n      padding: 12px 0;\n      border-bottom: 1px dashed var(--line);\n      font-size: 0.95rem;\n    }\n    .wait-row:last-of-type { border-bottom: none; }\n    .wait-row strong { color: var(--teal-700); }\n    .hero-card .fine {\n      margin-top: 16px;\n      font-size: 0.85rem;\n      color: var(--ink-soft);\n    }\n\n    /* ---------- Sections ---------- */\n    section.block { padding: 80px 0; }\n    section.alt { background: var(--white); }\n    .section-head {\n      max-width: 640px;\n      margin-bottom: 44px;\n    }\n    .kicker {\n      text-transform: uppercase;\n      letter-spacing: 0.12em;\n      font-size: 0.78rem;\n      font-weight: 700;\n      color: var(--coral-500);\n      margin-bottom: 10px;\n    }\n    h2 {\n      font-size: clamp(1.7rem, 3vw, 2.3rem);\n      color: var(--teal-900);\n      line-height: 1.2;\n      letter-spacing: -0.01em;\n      margin-bottom: 12px;\n    }\n    .section-head p { color: var(--ink-soft); font-size: 1.05rem; }\n\n    /* ---------- Services ---------- */\n    .services {\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));\n      gap: 20px;\n    }\n    .service {\n      background: var(--sand-50);\n      border: 1px solid var(--line);\n      border-radius: var(--radius);\n      padding: 26px;\n      transition: transform 0.2s, box-shadow 0.2s;\n    }\n    .service:hover {\n      transform: translateY(-3px);\n      box-shadow: var(--shadow);\n    }\n    .icon {\n      width: 48px; height: 48px;\n      border-radius: 12px;\n      background: var(--teal-100);\n      display: grid;\n      place-items: center;\n      margin-bottom: 16px;\n    }\n    .icon svg { width: 26px; height: 26px; stroke: var(--teal-700); fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }\n    .service h3 {\n      font-size: 1.08rem;\n      color: var(--teal-900);\n      margin-bottom: 8px;\n    }\n    .service p { color: var(--ink-soft); font-size: 0.95rem; }\n    .service .tag {\n      display: inline-block;\n      margin-top: 12px;\n      font-size: 0.78rem;\n      font-weight: 600;\n      color: var(--teal-700);\n      background: var(--white);\n      border: 1px solid var(--line);\n      padding: 3px 10px;\n      border-radius: 999px;\n    }\n\n    /* ---------- Steps ---------- */\n    .steps {\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\n      gap: 24px;\n      counter-reset: step;\n      list-style: none;\n    }\n    .steps li {\n      position: relative;\n      padding: 28px 24px 24px;\n      background: var(--white);\n      border-radius: var(--radius);\n      border: 1px solid var(--line);\n    }\n    .steps li::before {\n      counter-increment: step;\n      content: counter(step);\n      display: grid;\n      place-items: center;\n      width: 40px; height: 40px;\n      border-radius: 50%;\n      background: var(--teal-700);\n      color: var(--white);\n      font-weight: 700;\n      margin-bottom: 14px;\n    }\n    .steps h3 { font-size: 1.05rem; color: var(--teal-900); margin-bottom: 6px; }\n    .steps p { color: var(--ink-soft); font-size: 0.95rem; }\n\n    /* ---------- Privacy ---------- */\n    .privacy {\n      background: var(--teal-900);\n      color: #e6f4f1;\n      border-radius: 24px;\n      padding: 56px 48px;\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 48px;\n      align-items: center;\n    }\n    .privacy h2 { color: var(--white); }\n    .privacy .kicker { color: #ffb59e; }\n    .privacy p { color: #bfdcd6; }\n    .privacy-list {\n      list-style: none;\n      display: grid;\n      gap: 16px;\n    }\n    .privacy-list li {\n      display: flex;\n      gap: 14px;\n      background: rgba(255,255,255,0.06);\n      border: 1px solid rgba(255,255,255,0.1);\n      padding: 16px 18px;\n      border-radius: 12px;\n    }\n    .privacy-list strong { display: block; color: var(--white); margin-bottom: 2px; }\n    .privacy-list span { font-size: 0.93rem; color: #bfdcd6; }\n    .privacy-list .check {\n      flex: 0 0 auto;\n      width: 26px; height: 26px;\n      border-radius: 50%;\n      background: var(--teal-500);\n      display: grid;\n      place-items: center;\n      font-weight: 700;\n      color: var(--white);\n      font-size: 0.85rem;\n    }\n\n    /* ---------- Pricing ---------- */\n    .pricing-grid {\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));\n      gap: 20px;\n    }\n    .price-card {\n      background: var(--white);\n      border: 1px solid var(--line);\n      border-radius: var(--radius);\n      padding: 28px;\n      display: flex;\n      flex-direction: column;\n    }\n    .price-card.featured {\n      border: 2px solid var(--teal-500);\n      box-shadow: var(--shadow);\n      position: relative;\n    }\n    .price-card.featured::after {\n      content: \"Most requested\";\n      position: absolute;\n      top: -12px;\n      left: 24px;\n      background: var(--coral-500);\n      color: var(--white);\n      font-size: 0.75rem;\n      font-weight: 700;\n      padding: 4px 10px;\n      border-radius: 999px;\n    }\n    .price-card h3 { color: var(--teal-900); font-size: 1.15rem; }\n    .price { font-size: 2rem; font-weight: 700; color: var(--teal-700); margin: 10px 0 4px; }\n    .price small { font-size: 0.9rem; font-weight: 500; color: var(--ink-soft); }\n    .price-card ul {\n      list-style: none;\n      margin: 14px 0 22px;\n      display: grid;\n      gap: 8px;\n      font-size: 0.95rem;\n      color: var(--ink-soft);\n    }\n    .price-card ul li::before {\n      content: \"\u2022\";\n      color: var(--teal-500);\n      font-weight: 700;\n      margin-right: 8px;\n    }\n    .price-card .btn { margin-top: auto; justify-content: center; }\n    .pricing-note {\n      margin-top: 24px;\n      font-size: 0.9rem;\n      color: var(--ink-soft);\n      background: var(--sand-100);\n      padding: 16px 20px;\n      border-radius: 12px;\n    }\n\n    /* ---------- Who we serve / FAQ ---------- */\n    .faq-wrap {\n      display: grid;\n      grid-template-columns: 0.8fr 1.2fr;\n      gap: 56px;\n      align-items: start;\n    }\n    .faq-wrap aside h2 { margin-bottom: 14px; }\n    .faq-wrap aside p { color: var(--ink-soft); margin-bottom: 20px; }\n    details {\n      background: var(--white);\n      border: 1px solid var(--line);\n      border-radius: 12px;\n      margin-bottom: 12px;\n      overflow: hidden;\n    }\n    details[open] { border-color: var(--teal-500); }\n    summary {\n      cursor: pointer;\n      list-style: none;\n      padding: 18px 22px;\n      font-weight: 600;\n      color: var(--teal-900);\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      gap: 12px;\n    }\n    summary::-webkit-details-marker { display: none; }\n    summary::after {\n      content: \"+\";\n      font-size: 1.4rem;\n      font-weight: 400;\n      color: var(--teal-500);\n      transition: transform 0.2s;\n    }\n    details[open] summary::after { transform: rotate(45deg); }\n    details p {\n      padding: 0 22px 20px;\n      color: var(--ink-soft);\n      font-size: 0.97rem;\n    }\n\n    /* ---------- Visit / Location ---------- */\n    .visit-grid {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 24px;\n    }\n    .info-card {\n      background: var(--white);\n      border: 1px solid var(--line);\n      border-radius: var(--radius);\n      padding: 28px;\n    }\n    .info-card h3 {\n      color: var(--teal-900);\n      margin-bottom: 12px;\n      font-size: 1.1rem;\n    }\n    .hours-table {\n      width: 100%;\n      border-collapse: collapse;\n      font-size: 0.95rem;\n    }\n    .hours-table td {\n      padding: 8px 0;\n      border-bottom: 1px solid var(--line);\n    }\n    .hours-table td:last-child { text-align: right; color: var(--ink-soft); }\n    .hours-table tr.today td { font-weight: 700; color: var(--teal-700); }\n    .hours-table tr:last-child td { border-bottom: none; }\n    .contact-line {\n      display: flex;\n      gap: 12px;\n      align-items: flex-start;\n      margin-bottom: 14px;\n      color: var(--ink-soft);\n    }\n    .contact-line strong { color: var(--ink); display: block; }\n    .map-placeholder {\n      background:\n        repeating-linear-gradient(0deg, transparent 0 22px, rgba(23,104,106,0.08) 22px 23px),\n        repeating-linear-gradient(90deg, transparent 0 22px, rgba(23,104,106,0.08) 22px 23px),\n        var(--teal-100);\n      border-radius: var(--radius);\n      min-height: 220px;\n      position: relative;\n      overflow: hidden;\n    }\n    .map-placeholder .pin {\n      position: absolute;\n      left: 50%;\n      top: 45%;\n      transform: translate(-50%, -100%);\n    }\n    .map-placeholder .label {\n      position: absolute;\n      bottom: 14px;\n      left: 14px;\n      right: 14px;\n      background: var(--white);\n      padding: 12px 14px;\n      border-radius: 10px;\n      font-size: 0.9rem;\n      box-shadow: var(--shadow);\n    }\n\n    /* ---------- Final CTA ---------- */\n    .final-cta {\n      background: linear-gradient(135deg, var(--teal-700), var(--teal-900));\n      color: var(--white);\n      border-radius: 24px;\n      padding: 56px 40px;\n      text-align: center;\n    }\n    .final-cta h2 { color: var(--white); }\n    .final-cta p {\n      color: #cfe9e5;\n      max-width: 56ch;\n      margin: 0 auto 28px;\n      font-size: 1.05rem;\n    }\n    .final-cta .btn-primary {\n      background: var(--white);\n      color: var(--teal-900);\n    }\n    .final-cta .btn-primary:hover { background: var(--teal-100); }\n    .final-cta .btn-outline {\n      border-color: var(--white);\n      color: var(--white);\n    }\n    .final-cta .btn-outline:hover { background: rgba(255,255,255,0.12); }\n    .final-cta .btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }\n\n    /* ---------- Footer ---------- */\n    footer {\n      background: var(--sand-100);\n      border-top: 1px solid var(--line);\n      padding: 56px 0 32px;\n      font-size: 0.9rem;\n      color: var(--ink-soft);\n    }\n    .footer-grid {\n      display: grid;\n      grid-template-columns: 2fr 1fr 1fr 1fr;\n      gap: 32px;\n      margin-bottom: 36px;\n    }\n    footer h4 {\n      color: var(--teal-900);\n      font-size: 0.95rem;\n      margin-bottom: 12px;\n    }\n    footer ul { list-style: none; display: grid; gap: 8px; }\n    footer a { color: var(--ink-soft); text-decoration: none; }\n    footer a:hover { color: var(--teal-700); text-decoration: underline; }\n    .disclaimer {\n      border-top: 1px solid var(--line);\n      padding-top: 24px;\n      font-size: 0.82rem;\n      line-height: 1.55;\n    }\n    .emergency {\n      background: var(--coral-100);\n      border-left: 4px solid var(--coral-500);\n      padding: 14px 18px;\n      border-radius: 8px;\n      color: var(--ink);\n      margin-bottom: 24px;\n      font-size: 0.92rem;\n    }\n\n    /* ---------- Responsive ---------- */\n    @media (max-width: 900px) {\n      .hero-grid,\n      .privacy,\n      .faq-wrap,\n      .visit-grid {\n        grid-template-columns: 1fr;\n      }\n      .privacy { padding: 40px 28px; gap: 32px; }\n      .footer-grid { grid-template-columns: 1fr 1fr; }\n      .nav-links li:not(:last-child) { display: none; }\n    }\n\n    @media (max-width: 560px) {\n      section.block { padding: 60px 0; }\n      .hero { padding: 48px 0; }\n      .footer-grid { grid-template-columns: 1fr; }\n      .final-cta { padding: 40px 22px; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      html { scroll-behavior: auto; }\n      * { transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n\n  <a href=\"#main\" class=\"skip-link\">Skip to content</a>\n\n  <!-- Quick exit bar -->\n  <div class=\"quick-exit\" role=\"region\" aria-label=\"Privacy tools\">\n    <div class=\"container\">\n      <span>Private and confidential. Your visit is never shared without your consent.</span>\n      <a href=\"https://www.google.com\" rel=\"noopener noreferrer\">Quick exit</a>\n    </div>\n  </div>\n\n  <!-- Header -->\n  <header class=\"site-header\">\n    <div class=\"container nav\">\n      <a href=\"#top\" class=\"brand\" aria-label=\"Harbor Sexual Health Clinic home\">\n        <svg width=\"36\" height=\"36\" viewBox=\"0 0 36 36\" aria-hidden=\"true\">\n          <circle cx=\"18\" cy=\"18\" r=\"18\" fill=\"#17686a\"/>\n          <path d=\"M10 22c2.5-1 4-1 6 0s3.5 1 6 0 3.5-1 4 0\" stroke=\"#d9f0ec\" stroke-width=\"2.4\" fill=\"none\" stroke-linecap=\"round\"/>\n          <path d=\"M18 9v8\" stroke=\"#d9f0ec\" stroke-width=\"2.4\" stroke-linecap=\"round\"/>\n          <circle cx=\"18\" cy=\"9\" r=\"2\" fill=\"#e76f51\"/>\n        </svg>\n        <span>Harbor Sexual Health<small>Walk-in clinic</small></span>\n      </a>\n      <nav aria-label=\"Primary\">\n        <ul class=\"nav-links\">\n          <li><a href=\"#services\">Services</a></li>\n          <li><a href=\"#how-it-works\">How it works</a></li>\n          <li><a href=\"#pricing\">Pricing</a></li>\n          <li><a href=\"#faq\">FAQ</a></li>\n          <li><a href=\"#visit\">Visit us</a></li>\n          <li><a href=\"#visit\" class=\"nav-cta\">Walk in today</a></li>\n        </ul>\n      </nav>\n    </div>\n  </header>\n\n  <main id=\"main\">\n\n    <!-- Hero -->\n    <section class=\"hero\" id=\"top\">\n      <div class=\"container hero-grid\">\n        <div>\n          <div class=\"eyebrow\">\n            <span class=\"dot\" id=\"status-dot\" aria-hidden=\"true\"></span>\n            <span id=\"status-text\">Open now \u00b7 No appointment needed</span>\n          </div>\n          <h1>Walk in. Get tested. Get on with your day.</h1>\n          <p class=\"lead\">Confidential sexual health care for everyone, with no appointment, no judgment, and no pressure. Most visits take under an hour.</p>\n          <div class=\"hero-actions\">\n            <a href=\"#visit\" class=\"btn btn-primary\">Find our hours &rarr;</a>\n            <a href=\"#services\" class=\"btn btn-outline\">See our services</a>\n          </div>\n          <div class=\"hero-notes\">\n            <span>Walk-ins welcome</span>\n            <span>Results in as little as 1 day*</span>\n            <span>Sliding-scale fees</span>\n          </div>\n        </div>\n\n        <aside class=\"hero-card\" aria-label=\"Current wait times\">\n          <h3>Estimated wait times today</h3>\n          <div class=\"wait-row\"><span>STI / HIV testing</span><strong>~15 min</strong></div>\n          <div class=\"wait-row\"><span>PrEP &amp; contraception</span><strong>~20 min</strong></div>\n          <div class=\"wait-row\"><span>Emergency contraception</span><strong>Priority, ~5 min</strong></div>\n          <div class=\"wait-row\"><span>Full visit with clinician</span><strong>~45 min</strong></div>\n          <p class=\"fine\">Wait times are estimates and change throughout the day. If you are in a hurry, call ahead at <strong>(555) 014-2290</strong>.</p>\n        </aside>\n      </div>\n    </section>\n\n    <!-- Services -->\n    <section class=\"block alt\" id=\"services\">\n      <div class=\"container\">\n        <div class=\"section-head\">\n          <div class=\"kicker\">What we offer</div>\n          <h2>Sexual health care, all in one place</h2>\n          <p>Whether you need a routine check-up, a test after a new partner, or support with birth control, our clinicians can help without making you feel rushed or judged.</p>\n        </div>\n\n        <div class=\"services\">\n          <article class=\"service\">\n            <div class=\"icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M9 3h6M10 3v5.5L5 18a2 2 0 0 0 1.7 3h10.6A2 2 0 0 0 19 18l-5-9.5V3\"/><path d=\"M8 14h8\"/></svg>\n            </div>\n            <h3>STI testing</h3>\n            <p>Full panels or targeted tests for chlamydia, gonorrhea, syphilis, herpes, trichomoniasis, and more. Swab, urine, and blood options available.</p>\n            <span class=\"tag\">Same-day options</span>\n          </article>\n\n          <article class=\"service\">\n            <div class=\"icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M12 21s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.6-7 10-7 10z\"/></svg>\n            </div>\n            <h3>HIV testing &amp; PrEP</h3>\n            <p>Rapid HIV testing with results in about 20 minutes. Ask us about PrEP, a daily or on-demand medicine that greatly reduces the risk of HIV.</p>\n            <span class=\"tag\">Rapid results</span>\n          </article>\n\n          <article class=\"service\">\n            <div class=\"icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"8\"/><path d=\"M12 8v4l2.5 2.5\"/></svg>\n            </div>\n            <h3>Emergency contraception</h3>\n            <p>Available same day, no prescription needed for many options. Works best when taken as soon as possible after unprotected sex.</p>\n            <span class=\"tag\">Priority access</span>\n          </article>\n\n          <article class=\"service\">\n            <div class=\"icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M4 12h16M12 4v16\"/><circle cx=\"12\" cy=\"12\" r=\"9\"/></svg>\n            </div>\n            <h3>Contraception</h3>\n            <p>Pills, patches, rings, injections, implants, and IUDs. Our team will help you compare options and find what fits your body and your life.</p>\n            <span class=\"tag\">All methods</span>\n          </article>\n\n          <article class=\"service\">\n            <div class=\"icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M4 19l4-4 3 3 7-9\"/><path d=\"M14 9h6v6\"/></svg>\n            </div>\n            <h3>Post-exposure care (PEP)</h3>\n            <p>If you may have been exposed to HIV in the last 72 hours, come in right away. Treatment is most effective when started quickly.</p>\n            <span class=\"tag\">Urgent care</span>\n          </article>\n\n          <article class=\"service\">\n            <div class=\"icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\"><path d=\"M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6z\"/><path d=\"M15 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6z\"/><path d=\"M3 20c0-3 2.7-5 6-5s6 2 6 5\"/><path d=\"M14 15c3.3 0 7 1.6 7 5\"/></svg>\n            </div>\n            <h3>Care for every body and identity</h3>\n            <p>Inclusive, gender-affirming sexual health care for LGBTQ+ patients, transgender and nonbinary people, and anyone who wants a respectful, informed clinician.</p>\n            <span class=\"tag\">Inclusive care</span>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <!-- How it works -->\n    <section class=\"block\" id=\"how-it-works\">\n      <div class=\"container\">\n        <div class=\"section-head\">\n          <div class=\"kicker\">How it works</div>\n          <h2>Your visit, step by step</h2>\n          <p>No appointment, no referral, and no waiting on hold. Here is what to expect when you walk in.</p>\n        </div>\n\n        <ol class=\"steps\">\n          <li>\n            <h3>Check in at the front desk</h3>\n            <p>Tell us your name or the name you prefer to be called. You can use a nickname or pseudonym.</p>\n          </li>\n          <li>\n            <h3>Quick, private intake</h3>\n            <p>A short questionnaire about your health and reasons for visiting. Skip anything you are not comfortable sharing.</p>\n          </li>\n          <li>\n            <h3>Talk with a clinician</h3>\n            <p>Ask anything. We will explain your options in plain language and only test or treat what you choose.</p>\n          </li>\n          <li>\n            <h3>Get your results</h3>\n            <p>Rapid results may be ready during your visit. Lab results are sent by text, app, or phone, based on your preference.</p>\n          </li>\n        </ol>\n      </div>\n    </section>\n\n    <!-- Privacy -->\n    <section class=\"block\" style=\"padding-top:0;\">\n      <div class=\"container\">\n        <div class=\"privacy\">\n          <div>\n            <div class=\"kicker\">Your privacy</div>\n            <h2>Discreet by design</h2>\n            <p style=\"margin-top:12px;\">We know sexual health is personal. Every part of our clinic is built to protect your privacy, from the waiting room to your results.</p>\n          </div>\n          <ul class=\"privacy-list\">\n            <li>\n              <span class=\"check\" aria-hidden=\"true\">\u2713</span>\n              <div>\n                <strong>Confidential by law</strong>\n                <span>We never share your information with family, employers, or partners without your written permission.</span>\n              </div>\n            </li>\n            <li>\n              <span class=\"check\" aria-hidden=\"true\">\u2713</span>\n              <div>\n                <strong>Discreet billing</strong>\n                <span>Statements are labeled neutrally, and you can request private billing contact details.</span>\n              </div>\n            </li>\n            <li>\n              <span class=\"check\" aria-hidden=\"true\">\u2713</span>\n              <div>\n                <strong>Your choice of contact</strong>\n                <span>Choose text, call, email, or app notifications, and tell us which numbers are safe to use.</span>\n              </div>\n            </li>\n            <li>\n              <span class=\"check\" aria-hidden=\"true\">\u2713</span>\n              <div>\n                <strong>No judgment, ever</strong>\n                <span>Our team is trained in trauma-informed, nonjudgmental care for every patient.</span>\n              </div>\n            </li>\n          </ul>\n        </div>\n      </div>\n    </section>\n\n    <!-- Pricing -->\n    <section class=\"block alt\" id=\"pricing\">\n      <div class=\"container\">\n        <div class=\"section-head\">\n          <div class=\"kicker\">Pricing</div>\n          <h2>Clear costs, no surprises</h2>\n          <p>We offer sliding-scale fees based on income, and we accept most insurance plans. Cost should never stop you from getting care.</p>\n        </div>\n\n        <div class=\"pricing-grid\">\n          <div class=\"price-card\">\n            <h3>Basic STI screen</h3>\n            <div class=\"price\">$30 <small>starting price</small></div>\n            <ul>\n              <li>Chlamydia and gonorrhea test</li>\n              <li>Results in 2 to 5 days</li>\n              <li>Sliding scale available</li>\n            </ul>\n            <a href=\"#visit\" class=\"btn btn-outline\">Book a walk-in</a>\n          </div>\n\n          <div class=\"price-card featured\">\n            <h3>Complete sexual health panel</h3>\n            <div class=\"price\">$85 <small>starting price</small></div>\n            <ul>\n              <li>Full STI panel including HIV and syphilis</li>\n              <li>Rapid HIV result available on site</li>\n              <li>Clinician consultation included</li>\n            </ul>\n            <a href=\"#visit\" class=\"btn btn-primary\">Book a walk-in</a>\n          </div>\n\n          <div class=\"price-card\">\n            <h3>PrEP &amp; follow-up</h3>\n            <div class=\"price\">$0 <small>with most insurance</small></div>\n            <ul>\n              <li>Initial consultation and labs</li>\n              <li>Quarterly follow-up visits</li>\n              <li>Help with insurance and assistance programs</li>\n            </ul>\n            <a href=\"#visit\" class=\"btn btn-outline\">Ask about PrEP</a>\n          </div>\n        </div>\n\n        <p class=\"pricing-note\">\n          <strong>No insurance?</strong> You can still be seen. Ask our front desk about the sliding-scale program and our free and low-cost testing options. Prices shown are estimates and may vary based on the tests you choose.\n        </p>\n      </div>\n    </section>\n\n    <!-- FAQ -->\n    <section class=\"block\" id=\"faq\">\n      <div class=\"container faq-wrap\">\n        <aside>\n          <div class=\"kicker\">Questions</div>\n          <h2>Frequently asked</h2>\n          <p>Can't find your answer here? Our team is happy to help by phone, text, or in person.</p>\n          <a href=\"#visit\" class=\"btn btn-outline\">Contact the clinic</a>\n        </aside>\n\n        <div>\n          <details open>\n            <summary>Do I need an appointment?</summary>\n            <p>No. We welcome walk-ins during all open hours. If you prefer a set time, you can book online or call, but it is never required.</p>\n          </details>\n          <details>\n            <summary>Will my parents, partner, or insurance company find out?</summary>\n            <p>We will not share your visit details without your consent. Insurance may send an explanation of benefits to the policyholder. If that is a concern, tell us and we will discuss confidential billing options with you.</p>\n          </details>\n          <details>\n            <summary>Do I need to be sexually active to come in?</summary>\n            <p>No. You can come in for questions, a check-up, contraception, gender-affirming care, or anything else related to your sexual and reproductive health.</p>\n          </details>\n          <details>\n            <summary>I'm under 18. Can I still be seen?</summary>\n            <p>In many cases, yes. Minors can access confidential care for STI testing, contraception, and some other services, depending on local law. Our staff will explain what is possible for you.</p>\n          </details>\n          <details>\n            <summary>How long do test results take?</summary>\n            <p>Rapid HIV tests are usually ready during your visit. Most lab tests take between 1 and 5 days. We will tell you how and when you will receive your results.</p>\n          </details>\n          <details>\n            <summary>What if I have symptoms right now?</summary>\n            <p>Please walk in as soon as you can. Our clinicians will see you promptly. If you have severe pain, heavy bleeding, fever, or trouble breathing, go to the nearest emergency department or call emergency services.</p>\n          </details>\n        </div>\n      </div>\n    </section>\n\n    <!-- Visit -->\n    <section class=\"block alt\" id=\"visit\">\n      <div class=\"container\">\n        <div class=\"section-head\">\n          <div class=\"kicker\">Visit us</div>\n          <h2>Find us and walk in</h2>\n          <p>We are conveniently located near public transit, with accessible entrances and private waiting areas.</p>\n        </div>\n\n        <div class=\"visit-grid\">\n          <div style=\"display:grid; gap:24px;\">\n            <div class=\"info-card\">\n              <h3>Walk-in hours</h3>\n              <table class=\"hours-table\" aria-label=\"Clinic opening hours\">\n                <tbody>\n                  <tr data-day=\"1\"><td>Monday</td><td>8:00 am \u2013 7:00 pm</td></tr>\n                  <tr data-day=\"2\"><td>Tuesday</td><td>8:00 am \u2013 7:00 pm</td></tr>\n                  <tr data-day=\"3\"><td>Wednesday</td><td>8:00 am \u2013 7:00 pm</td></tr>\n                  <tr data-day=\"4\"><td>Thursday</td><td>10:00 am \u2013 8:00 pm</td></tr>\n                  <tr data-day=\"5\"><td>Friday</td><td>8:00 am \u2013 5:00 pm</td></tr>\n                  <tr data-day=\"6\"><td>Saturday</td><td>9:00 am \u2013 2:00 pm</td></tr>\n                  <tr data-day=\"0\"><td>Sunday</td><td>Closed</td></tr>\n                </tbody>\n              </table>\n            </div>\n\n            <div class=\"info-card\">\n              <h3>Contact</h3>\n              <div class=\"contact-line\">\n                <div>\n                  <strong>Address</strong>\n                  120 Harbor Street, Suite 200<br>Your City, ST 00000\n                </div>\n              </div>\n              <div class=\"contact-line\">\n                <div>\n                  <strong>Phone</strong>\n                  <a href=\"tel:+15550142290\">(555) 014-2290</a>\n                </div>\n              </div>\n              <div class=\"contact-line\">\n                <div>\n                  <strong>Text (confidential)</strong>\n                  <a href=\"sms:+15550142291\">(555) 014-2291</a>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"map-placeholder\" role=\"img\" aria-label=\"Placeholder map showing the clinic location\">\n            <svg class=\"pin\" width=\"44\" height=\"56\" viewBox=\"0 0 44 56\" aria-hidden=\"true\">\n              <path d=\"M22 0C10 0 0 9.8 0 22c0 15.5 22 34 22 34s22-18.5 22-34C44 9.8 34 0 22 0z\" fill=\"#e76f51\"/>\n              <circle cx=\"22\" cy=\"22\" r=\"8\" fill=\"#fff\"/>\n            </svg>\n            <div class=\"label\">\n              <strong>Harbor Sexual Health Clinic</strong><br>\n              120 Harbor Street, Suite 200<br>\n              <span style=\"color:#4b5b5c;\">Two blocks from Central Station \u00b7 Free street parking after 5 pm</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Final CTA -->\n    <section class=\"block\">\n      <div class=\"container\">\n        <div class=\"final-cta\">\n          <h2>Ready when you are</h2>\n          <p>Taking care of your sexual health is a sign of self-respect. Come by any time during open hours, or call us with questions before you visit.</p>\n          <div class=\"btns\">\n            <a href=\"#visit\" class=\"btn btn-primary\">Walk in today</a>\n            <a href=\"tel:+15550142290\" class=\"btn btn-outline\">Call (555) 014-2290</a>\n          </div>\n        </div>\n      </div>\n    </section>\n\n  </main>\n\n  <!-- Footer -->\n  <footer>\n    <div class=\"container\">\n      <div class=\"emergency\">\n        <strong>Medical emergency?</strong> If you are having trouble breathing, severe pain, or heavy bleeding, call emergency services or go to the nearest emergency room. Our clinic is not an emergency department.\n      </div>\n\n      <div class=\"footer-grid\">\n        <div>\n          <h4>Harbor Sexual Health Clinic</h4>\n          <p>Confidential, inclusive, walk-in sexual health care.<br>120 Harbor Street, Suite 200, Your City, ST 00000</p>\n        </div>\n        <div>\n          <h4>Services</h4>\n          <ul>\n            <li><a href=\"#services\">STI testing</a></li>\n            <li><a href=\"#services\">HIV testing &amp; PrEP</a></li>\n            <li><a href=\"#services\">Contraception</a></li>\n            <li><a href=\"#services\">Emergency contraception</a></li>\n          </ul>\n        </div>\n        <div>\n          <h4>Patients</h4>\n          <ul>\n            <li><a href=\"#pricing\">Pricing &amp; sliding scale</a></li>\n            <li><a href=\"#faq\">FAQ</a></li>\n            <li><a href=\"#visit\">Hours &amp; location</a></li>\n            <li><a href=\"#\">Patient privacy notice</a></li>\n          </ul>\n        </div>\n        <div>\n          <h4>Support</h4>\n          <ul>\n            <li><a href=\"tel:+15550142290\">(555) 014-2290</a></li>\n            <li><a href=\"#\">Accessibility</a></li>\n            <li><a href=\"#\">Careers</a></li>\n            <li><a href=\"#\">Contact us</a></li>\n          </ul>\n        </div>\n      </div>\n\n      <div class=\"disclaimer\">\n        <p>This website provides general information and is not a substitute for professional medical advice, diagnosis, or treatment. Information about services, pricing, and wait times may change. Insurance acceptance varies by plan. Results timing depends on the test performed. &copy; <span id=\"year\">2025</span> Harbor Sexual Health Clinic. All rights reserved.</p>\n      </div>\n    </div>\n  </footer>\n\n  <script>\n    // Set the copyright year automatically\n    document.getElementById('year').textContent = new Date().getFullYear();\n\n    // Show whether the clinic is open right now, and highlight today's hours\n    (function () {\n      const hours = {\n        0: null,            // Sunday closed\n        1: [8, 19],\n        2: [8, 19],\n        3: [8, 19],\n        4: [10, 20],\n        5: [8, 17],\n        6: [9, 14]\n      };\n      const now = new Date();\n      const day = now.getDay();\n      const hour = now.getHours() + now.getMinutes() / 60;\n\n      const today = document.querySelector('tr[data-day=\"' + day + '\"]');\n      if (today) today.classList.add('today');\n\n      const dot = document.getElementById('status-dot');\n      const text = document.getElementById('status-text');\n      const window_ = hours[day];\n      const isOpen = window_ && hour >= window_[0] && hour < window_[1];\n\n      if (isOpen) {\n        text.textContent = 'Open now \u00b7 No appointment needed';\n      } else {\n        dot.classList.add('closed');\n        text.textContent = 'Currently closed \u00b7 See hours below';\n      }\n    })();\n  </script>\n</body>\n</html>\n"}