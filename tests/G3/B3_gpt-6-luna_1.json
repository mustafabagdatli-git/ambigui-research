{"brief": "B3", "model": "openai/gpt-6-luna", "i": 1, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#101310\">\n  <meta name=\"description\" content=\"Rivet is the open-source database built for data engineers. Fast SQL, simple operations, and your choice of where to run it.\">\n  <title>Rivet \u2014 Data, in motion</title>\n  <style>\n    :root {\n      color-scheme: dark;\n      --bg: #101310;\n      --panel: #171b17;\n      --panel-light: #1d231d;\n      --ink: #f1f3e9;\n      --muted: #a0a89c;\n      --faint: #687165;\n      --line: rgba(226, 238, 215, 0.12);\n      --lime: #c6f36a;\n      --lime-dark: #9acb3e;\n      --orange: #ff996b;\n      --mono: \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace;\n      --sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n    }\n\n    * { box-sizing: border-box; }\n\n    html {\n      scroll-behavior: smooth;\n      scroll-padding-top: 90px;\n    }\n\n    body {\n      margin: 0;\n      background:\n        radial-gradient(ellipse at 72% 5%, rgba(117, 153, 69, 0.11), transparent 34rem),\n        var(--bg);\n      color: var(--ink);\n      font-family: var(--sans);\n      -webkit-font-smoothing: antialiased;\n    }\n\n    a { color: inherit; text-decoration: none; }\n\n    a:focus-visible {\n      outline: 2px solid var(--lime);\n      outline-offset: 4px;\n      border-radius: 4px;\n    }\n\n    .skip-link {\n      position: absolute;\n      top: -60px;\n      left: 16px;\n      z-index: 10;\n      padding: 10px 14px;\n      background: var(--lime);\n      color: #111;\n      border-radius: 6px;\n    }\n\n    .skip-link:focus { top: 16px; }\n\n    .wrap {\n      width: min(1160px, calc(100% - 48px));\n      margin-inline: auto;\n    }\n\n    .topbar {\n      height: 78px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      border-bottom: 1px solid var(--line);\n    }\n\n    .brand {\n      display: inline-flex;\n      align-items: center;\n      gap: 11px;\n      font-size: 18px;\n      font-weight: 720;\n      letter-spacing: -0.055em;\n    }\n\n    .brand-mark {\n      width: 28px;\n      height: 28px;\n      display: grid;\n      place-items: center;\n      border: 1px solid rgba(198, 243, 106, 0.45);\n      border-radius: 8px;\n      color: var(--lime);\n      background: rgba(198, 243, 106, 0.07);\n    }\n\n    .brand-mark svg { display: block; }\n\n    .nav-links {\n      display: flex;\n      align-items: center;\n      gap: 33px;\n      color: #b6bdb1;\n      font-size: 13px;\n    }\n\n    .nav-links a:hover { color: var(--ink); }\n\n    .nav-actions {\n      display: flex;\n      align-items: center;\n      gap: 18px;\n      font-size: 13px;\n    }\n\n    .nav-github { color: #b6bdb1; }\n\n    .button {\n      display: inline-flex;\n      min-height: 44px;\n      align-items: center;\n      justify-content: center;\n      gap: 10px;\n      padding: 0 18px;\n      border: 1px solid transparent;\n      border-radius: 7px;\n      font-size: 13px;\n      font-weight: 650;\n      transition: transform .18s ease, background .18s ease, border-color .18s ease;\n    }\n\n    .button:hover { transform: translateY(-2px); }\n\n    .button-primary {\n      color: #14180f;\n      background: var(--lime);\n    }\n\n    .button-primary:hover { background: #d5ff85; }\n\n    .button-quiet {\n      color: var(--ink);\n      border-color: var(--line);\n      background: rgba(255,255,255,.025);\n    }\n\n    .button-quiet:hover {\n      border-color: rgba(198, 243, 106, .45);\n      background: rgba(198, 243, 106, .06);\n    }\n\n    .hero {\n      position: relative;\n      display: grid;\n      grid-template-columns: 1fr 0.94fr;\n      align-items: center;\n      gap: 62px;\n      min-height: 610px;\n      padding: 82px 0 88px;\n    }\n\n    .hero::before {\n      content: \"\";\n      position: absolute;\n      z-index: -1;\n      top: 44px;\n      right: -190px;\n      width: 670px;\n      height: 510px;\n      opacity: .23;\n      background-image:\n        linear-gradient(rgba(198,243,106,.1) 1px, transparent 1px),\n        linear-gradient(90deg, rgba(198,243,106,.1) 1px, transparent 1px);\n      background-size: 44px 44px;\n      mask-image: radial-gradient(ellipse, black 4%, transparent 69%);\n    }\n\n    .eyebrow {\n      display: inline-flex;\n      align-items: center;\n      gap: 9px;\n      color: var(--lime);\n      font: 11px/1.4 var(--mono);\n      letter-spacing: .11em;\n      text-transform: uppercase;\n    }\n\n    .eyebrow-dot {\n      width: 6px;\n      height: 6px;\n      border-radius: 50%;\n      background: var(--lime);\n      box-shadow: 0 0 12px rgba(198, 243, 106, .7);\n    }\n\n    h1 {\n      max-width: 650px;\n      margin: 23px 0 20px;\n      font-size: clamp(48px, 6vw, 76px);\n      font-weight: 630;\n      line-height: .99;\n      letter-spacing: -.075em;\n    }\n\n    h1 span {\n      color: var(--lime);\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-style: italic;\n      font-weight: 400;\n      letter-spacing: -.065em;\n    }\n\n    .hero-copy {\n      max-width: 490px;\n      margin: 0;\n      color: #aeb6a9;\n      font-size: 16px;\n      line-height: 1.75;\n    }\n\n    .hero-actions {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 11px;\n      margin-top: 29px;\n    }\n\n    .hero-note {\n      display: flex;\n      align-items: center;\n      gap: 9px;\n      margin-top: 20px;\n      color: var(--faint);\n      font: 11px/1.5 var(--mono);\n    }\n\n    .hero-note svg { color: var(--lime); flex: none; }\n\n    .console {\n      position: relative;\n      z-index: 1;\n      overflow: hidden;\n      border: 1px solid rgba(220, 235, 208, .17);\n      border-radius: 12px;\n      background: #131713;\n      box-shadow: 0 28px 100px rgba(0,0,0,.42), 0 0 70px rgba(151, 190, 83, .07);\n      transform: perspective(1100px) rotateY(-4deg) rotateX(2deg);\n    }\n\n    .console-top {\n      display: flex;\n      height: 48px;\n      align-items: center;\n      justify-content: space-between;\n      padding: 0 17px;\n      border-bottom: 1px solid var(--line);\n      color: #838d80;\n      font: 10px var(--mono);\n      letter-spacing: .04em;\n    }\n\n    .window-dots { display: flex; gap: 6px; }\n    .window-dots i {\n      display: block;\n      width: 7px;\n      height: 7px;\n      border-radius: 50%;\n      background: #454d43;\n    }\n    .window-dots i:first-child { background: #ff8064; }\n    .window-dots i:nth-child(2) { background: #e9bd5c; }\n    .window-dots i:nth-child(3) { background: #83c96b; }\n\n    .console-title { margin-left: -26px; }\n    .console-status { color: var(--lime); }\n\n    .query {\n      padding: 25px 25px 20px;\n      font: 12px/1.85 var(--mono);\n      color: #d0d6c9;\n      white-space: nowrap;\n    }\n\n    .line-no {\n      display: inline-block;\n      width: 25px;\n      color: #596255;\n      user-select: none;\n    }\n\n    .kw { color: #c69aff; }\n    .fn { color: #78c8d6; }\n    .str { color: #d6bc75; }\n    .comment { color: #697465; }\n    .lime { color: var(--lime); }\n    .orange { color: var(--orange); }\n\n    .result-head {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 12px 19px;\n      border-top: 1px solid var(--line);\n      border-bottom: 1px solid var(--line);\n      color: #818b7d;\n      font: 9px var(--mono);\n      letter-spacing: .08em;\n      text-transform: uppercase;\n    }\n\n    .result-head strong {\n      color: var(--lime);\n      font-weight: 500;\n      letter-spacing: .03em;\n      text-transform: none;\n    }\n\n    .result-table {\n      width: 100%;\n      border-collapse: collapse;\n      font: 10px var(--mono);\n    }\n\n    .result-table th,\n    .result-table td {\n      padding: 11px 19px;\n      border-bottom: 1px solid rgba(226, 238, 215, .07);\n      text-align: left;\n    }\n\n    .result-table th {\n      color: #727d70;\n      font-size: 9px;\n      font-weight: 400;\n      letter-spacing: .07em;\n      text-transform: uppercase;\n    }\n\n    .result-table td { color: #c3cabe; }\n    .result-table td:first-child { color: var(--lime); }\n    .result-table tr:last-child td { border-bottom: 0; }\n\n    .console-foot {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 11px 19px;\n      border-top: 1px solid var(--line);\n      color: #737d70;\n      font: 9px var(--mono);\n    }\n\n    .console-foot span:last-child { color: #a6b19f; }\n\n    .trust {\n      padding: 25px 0 31px;\n      border-top: 1px solid var(--line);\n      border-bottom: 1px solid var(--line);\n    }\n\n    .trust-inner {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 24px;\n    }\n\n    .trust-label {\n      color: #788174;\n      font: 10px/1.6 var(--mono);\n      letter-spacing: .09em;\n      text-transform: uppercase;\n    }\n\n    .trust-items {\n      display: flex;\n      flex-wrap: wrap;\n      justify-content: flex-end;\n      gap: clamp(20px, 4vw, 54px);\n      color: #929b8e;\n      font-size: 13px;\n      font-weight: 600;\n      letter-spacing: -.02em;\n    }\n\n    .trust-items span:nth-child(2) { font-family: Georgia, serif; font-style: italic; }\n    .trust-items span:nth-child(3) { letter-spacing: .12em; font-size: 11px; }\n    .trust-items span:nth-child(4) { font-weight: 450; }\n\n    .section {\n      padding: 108px 0;\n    }\n\n    .section-heading {\n      display: flex;\n      align-items: flex-end;\n      justify-content: space-between;\n      gap: 35px;\n      margin-bottom: 42px;\n    }\n\n    .section-heading h2 {\n      max-width: 580px;\n      margin: 14px 0 0;\n      font-size: clamp(34px, 4vw, 48px);\n      font-weight: 570;\n      letter-spacing: -.065em;\n      line-height: 1.07;\n    }\n\n    .section-heading p {\n      max-width: 350px;\n      margin: 0 0 3px;\n      color: var(--muted);\n      font-size: 14px;\n      line-height: 1.7;\n    }\n\n    .feature-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 13px;\n    }\n\n    .feature-card {\n      min-height: 230px;\n      padding: 25px;\n      border: 1px solid var(--line);\n      border-radius: 9px;\n      background: linear-gradient(145deg, rgba(255,255,255,.035), rgba(255,255,255,.01));\n      transition: border-color .2s ease, transform .2s ease;\n    }\n\n    .feature-card:hover {\n      transform: translateY(-3px);\n      border-color: rgba(198,243,106,.36);\n    }\n\n    .feature-icon {\n      display: grid;\n      width: 34px;\n      height: 34px;\n      place-items: center;\n      border: 1px solid rgba(198,243,106,.23);\n      border-radius: 8px;\n      color: var(--lime);\n      background: rgba(198,243,106,.06);\n    }\n\n    .feature-card h3 {\n      margin: 24px 0 9px;\n      font-size: 16px;\n      font-weight: 590;\n      letter-spacing: -.025em;\n    }\n\n    .feature-card p {\n      max-width: 290px;\n      margin: 0;\n      color: #959e91;\n      font-size: 13px;\n      line-height: 1.7;\n    }\n\n    .build-section {\n      padding: 0 0 110px;\n    }\n\n    .build-panel {\n      display: grid;\n      grid-template-columns: .92fr 1.08fr;\n      overflow: hidden;\n      border: 1px solid var(--line);\n      border-radius: 12px;\n      background:\n        radial-gradient(ellipse at 0 100%, rgba(198,243,106,.07), transparent 50%),\n        #151915;\n    }\n\n    .build-copy {\n      padding: 48px;\n    }\n\n    .build-copy h2 {\n      margin: 15px 0 14px;\n      font-size: clamp(32px, 4vw, 43px);\n      font-weight: 570;\n      letter-spacing: -.065em;\n      line-height: 1.05;\n    }\n\n    .build-copy p {\n      max-width: 370px;\n      margin: 0;\n      color: var(--muted);\n      font-size: 14px;\n      line-height: 1.7;\n    }\n\n    .build-link {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      margin-top: 25px;\n      color: var(--lime);\n      font-size: 13px;\n      font-weight: 600;\n    }\n\n    .build-link:hover { gap: 12px; }\n\n    .install-card {\n      align-self: center;\n      margin: 28px;\n      overflow: hidden;\n      border: 1px solid rgba(220, 235, 208, .14);\n      border-radius: 9px;\n      background: #0e110e;\n    }\n\n    .install-top {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 13px 17px;\n      border-bottom: 1px solid var(--line);\n      color: #818b7d;\n      font: 10px var(--mono);\n    }\n\n    .install-code {\n      padding: 20px 19px 23px;\n      color: #cdd4c6;\n      font: 11px/2 var(--mono);\n      overflow-x: auto;\n    }\n\n    .install-code .prompt { color: var(--lime); }\n    .install-code .muted { color: #727d70; }\n\n    .manifesto {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      align-items: center;\n      gap: 50px;\n      padding: 34px 0 100px;\n      border-top: 1px solid var(--line);\n    }\n\n    .manifesto h2 {\n      margin: 0;\n      font-size: clamp(32px, 4vw, 43px);\n      font-weight: 560;\n      line-height: 1.1;\n      letter-spacing: -.06em;\n    }\n\n    .manifesto h2 span { color: var(--lime); }\n\n    .manifesto-copy {\n      max-width: 450px;\n      color: #9ba496;\n      font-size: 14px;\n      line-height: 1.8;\n    }\n\n    .manifesto-copy p { margin: 0 0 14px; }\n\n    .license {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      margin-top: 4px;\n      color: #c1c9bc;\n      font: 10px var(--mono);\n    }\n\n    .license svg { color: var(--lime); }\n\n    .cta {\n      position: relative;\n      overflow: hidden;\n      padding: 68px 30px;\n      border: 1px solid rgba(198,243,106,.2);\n      border-radius: 12px;\n      background:\n        radial-gradient(ellipse at 50% 120%, rgba(198,243,106,.16), transparent 60%),\n        #171d15;\n      text-align: center;\n    }\n\n    .cta::before, .cta::after {\n      content: \"\";\n      position: absolute;\n      width: 160px;\n      height: 160px;\n      border: 1px solid rgba(198,243,106,.1);\n      border-radius: 50%;\n      pointer-events: none;\n    }\n\n    .cta::before { top: -105px; left: 13%; }\n    .cta::after { right: 11%; bottom: -115px; width: 210px; height: 210px; }\n\n    .cta h2 {\n      position: relative;\n      margin: 14px 0 12px;\n      font-size: clamp(34px, 5vw, 51px);\n      font-weight: 570;\n      letter-spacing: -.07em;\n    }\n\n    .cta p {\n      position: relative;\n      margin: 0 auto;\n      color: #a0aa99;\n      font-size: 14px;\n    }\n\n    .cta .button { position: relative; margin-top: 25px; }\n\n    footer {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 20px;\n      padding: 28px 0 32px;\n      color: #758072;\n      font-size: 11px;\n    }\n\n    .footer-links { display: flex; gap: 23px; }\n    .footer-links a:hover { color: var(--ink); }\n\n    @media (max-width: 850px) {\n      .nav-links { gap: 19px; }\n      .hero { grid-template-columns: 1fr; gap: 44px; padding-top: 70px; }\n      .hero-copy { max-width: 570px; }\n      .console { width: min(100%, 620px); margin-inline: auto; transform: none; }\n      .trust-inner { align-items: flex-start; flex-direction: column; }\n      .trust-items { justify-content: flex-start; }\n      .build-copy { padding: 36px; }\n    }\n\n    @media (max-width: 620px) {\n      .wrap { width: min(100% - 32px, 1160px); }\n      .topbar { height: 68px; }\n      .nav-links, .nav-github { display: none; }\n      .nav-actions { gap: 0; }\n      .nav-actions .button { min-height: 39px; padding-inline: 13px; }\n      .hero { min-height: auto; padding: 62px 0 58px; }\n      h1 { font-size: clamp(46px, 13vw, 65px); }\n      .hero-copy { font-size: 15px; }\n      .query { padding: 19px 15px 16px; font-size: 10px; }\n      .line-no { width: 20px; }\n      .result-table th, .result-table td { padding: 10px 11px; }\n      .result-table { font-size: 9px; }\n      .console-title { margin-left: 0; }\n      .console-status { display: none; }\n      .trust { padding: 22px 0; }\n      .trust-items { gap: 17px 25px; font-size: 12px; }\n      .section { padding: 75px 0; }\n      .section-heading { display: block; margin-bottom: 28px; }\n      .section-heading p { margin-top: 15px; }\n      .feature-grid { grid-template-columns: 1fr; }\n      .feature-card { min-height: auto; padding: 22px; }\n      .feature-card h3 { margin-top: 18px; }\n      .build-section { padding-bottom: 75px; }\n      .build-panel { grid-template-columns: 1fr; }\n      .build-copy { padding: 30px 25px 10px; }\n      .install-card { margin: 22px; }\n      .manifesto { grid-template-columns: 1fr; gap: 21px; padding: 28px 0 72px; }\n      .cta { padding: 54px 20px; }\n      footer { align-items: flex-start; flex-direction: column; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      *, *::before, *::after {\n        scroll-behavior: auto !important;\n        transition-duration: .01ms !important;\n      }\n    }\n  </style>\n</head>\n<body>\n  <a class=\"skip-link\" href=\"#main\">Skip to content</a>\n\n  <header class=\"wrap topbar\">\n    <a class=\"brand\" href=\"#\" aria-label=\"Rivet home\">\n      <span class=\"brand-mark\" aria-hidden=\"true\">\n        <svg width=\"17\" height=\"17\" viewBox=\"0 0 17 17\" fill=\"none\">\n          <path d=\"M3 3.5h11M3 8.5h8M3 13.5h11\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/>\n          <circle cx=\"12.5\" cy=\"8.5\" r=\"1.5\" fill=\"currentColor\"/>\n        </svg>\n      </span>\n      rivet\n    </a>\n\n    <nav class=\"nav-links\" aria-label=\"Main navigation\">\n      <a href=\"#why-rivet\">Why Rivet</a>\n      <a href=\"#quickstart\">Quickstart</a>\n      <a href=\"#community\">Community</a>\n    </nav>\n\n    <div class=\"nav-actions\">\n      <a class=\"nav-github\" href=\"#community\">GitHub \u2197</a>\n      <a class=\"button button-primary\" href=\"#quickstart\">Get started <span aria-hidden=\"true\">\u2197</span></a>\n    </div>\n  </header>\n\n  <main id=\"main\">\n    <section class=\"wrap hero\" aria-labelledby=\"hero-title\">\n      <div>\n        <div class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> Open source. Engineer approved.</div>\n        <h1 id=\"hero-title\">Move data at the speed of <span>thought.</span></h1>\n        <p class=\"hero-copy\">\n          Meet Rivet: the open-source database for data engineers who would rather build pipelines than babysit them. Fast SQL, dependable workloads, and no black boxes.\n        </p>\n        <div class=\"hero-actions\">\n          <a class=\"button button-primary\" href=\"#quickstart\">Start building <span aria-hidden=\"true\">\u2192</span></a>\n          <a class=\"button button-quiet\" href=\"#why-rivet\">Explore the database</a>\n        </div>\n        <div class=\"hero-note\">\n          <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\" aria-hidden=\"true\">\n            <path d=\"M7 1.5 12 4v3.2c0 2.8-2.1 4.7-5 5.3-2.9-.6-5-2.5-5-5.3V4l5-2.5Z\" stroke=\"currentColor\" stroke-width=\"1.2\"/>\n            <path d=\"m4.8 7 1.4 1.4L9.4 5\" stroke=\"currentColor\" stroke-width=\"1.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          </svg>\n          Apache 2.0 \u00b7 Run it anywhere \u00b7 No vendor lock-in\n        </div>\n      </div>\n\n      <div class=\"console\" aria-label=\"Preview of a SQL query running in Rivet\">\n        <div class=\"console-top\">\n          <span class=\"window-dots\" aria-hidden=\"true\"><i></i><i></i><i></i></span>\n          <span class=\"console-title\">rivet / query.sql</span>\n          <span class=\"console-status\">\u25cf connected</span>\n        </div>\n        <div class=\"query\" aria-label=\"SQL query\">\n          <div><span class=\"line-no\">01</span><span class=\"comment\">-- Find the signal in your event stream</span></div>\n          <div><span class=\"line-no\">02</span><span class=\"kw\">SELECT</span> <span class=\"fn\">date_trunc</span>(<span class=\"str\">'day'</span>, event_time) <span class=\"kw\">AS</span> day,</div>\n          <div><span class=\"line-no\">03</span>       <span class=\"fn\">count</span>(*) <span class=\"kw\">AS</span> events,</div>\n          <div><span class=\"line-no\">04</span>       <span class=\"fn\">approx_percentile</span>(latency_ms, <span class=\"lime\">0.99</span>) <span class=\"kw\">AS</span> p99</div>\n          <div><span class=\"line-no\">05</span><span class=\"kw\">FROM</span> <span class=\"orange\">production.events</span></div>\n          <div><span class=\"line-no\">06</span><span class=\"kw\">WHERE</span> event_time &gt; <span class=\"fn\">now</span>() - <span class=\"str\">INTERVAL '7 days'</span></div>\n          <div><span class=\"line-no\">07</span><span class=\"kw\">GROUP BY</span> <span class=\"lime\">1</span> <span class=\"kw\">ORDER BY</span> <span class=\"lime\">1</span> <span class=\"kw\">DESC</span>;</div>\n        </div>\n        <div class=\"result-head\">\n          <span>Query results</span>\n          <strong>\u2713 42 ms</strong>\n        </div>\n        <table class=\"result-table\">\n          <thead>\n            <tr><th>day</th><th>events</th><th>p99 (ms)</th></tr>\n          </thead>\n          <tbody>\n            <tr><td>2025-04-18</td><td>8,491,202</td><td>42.8</td></tr>\n            <tr><td>2025-04-17</td><td>7,992,410</td><td>39.1</td></tr>\n            <tr><td>2025-04-16</td><td>8,105,774</td><td>41.6</td></tr>\n          </tbody>\n        </table>\n        <div class=\"console-foot\">\n          <span>3 rows returned</span>\n          <span>warehouse \u00b7 us-east-1</span>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"trust\" aria-label=\"Built for teams who move data\">\n      <div class=\"wrap trust-inner\">\n        <div class=\"trust-label\">Fits right into<br>your data stack</div>\n        <div class=\"trust-items\" aria-label=\"Compatible tools\">\n          <span>dbt</span>\n          <span>Airflow</span>\n          <span>SPARK</span>\n          <span>Apache Kafka</span>\n          <span>DuckDB</span>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"wrap section\" id=\"why-rivet\" aria-labelledby=\"why-title\">\n      <div class=\"section-heading\">\n        <div>\n          <div class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> Less plumbing. More progress.</div>\n          <h2 id=\"why-title\">Built around the way data teams actually work.</h2>\n        </div>\n        <p>From first ingest to your busiest production workload, Rivet keeps the sharp edges out of your data stack.</p>\n      </div>\n\n      <div class=\"feature-grid\">\n        <article class=\"feature-card\">\n          <div class=\"feature-icon\" aria-hidden=\"true\">\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\">\n              <path d=\"M2 13.5h3l2.2-6 3.1 8 2.1-5H16\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            </svg>\n          </div>\n          <h3>Fast where it counts</h3>\n          <p>Columnar execution and smart caching get you from raw events to useful answers without the wait.</p>\n        </article>\n\n        <article class=\"feature-card\">\n          <div class=\"feature-icon\" aria-hidden=\"true\">\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\">\n              <path d=\"M9 2v14M2 9h14M4.1 4.1l9.8 9.8m0-9.8-9.8 9.8\" stroke=\"currentColor\" stroke-width=\"1.25\" stroke-linecap=\"round\"/>\n              <circle cx=\"9\" cy=\"9\" r=\"2.4\" fill=\"#171b17\" stroke=\"currentColor\" stroke-width=\"1.3\"/>\n            </svg>\n          </div>\n          <h3>Plays well with your stack</h3>\n          <p>Standard SQL, familiar integrations, and straightforward APIs. Keep the tools your team already loves.</p>\n        </article>\n\n        <article class=\"feature-card\">\n          <div class=\"feature-icon\" aria-hidden=\"true\">\n            <svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\">\n              <path d=\"M9 2.2 15 5v4c0 3.3-2.4 5.7-6 6.8C5.4 14.7 3 12.3 3 9V5l6-2.8Z\" stroke=\"currentColor\" stroke-width=\"1.3\"/>\n              <path d=\"m6.4 9 1.7 1.7 3.6-3.8\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            </svg>\n          </div>\n          <h3>Yours to run, always</h3>\n          <p>Deploy on your cloud, on-prem, or locally. Your data stays yours, and the source stays open.</p>\n        </article>\n      </div>\n    </section>\n\n    <section class=\"wrap build-section\" id=\"quickstart\" aria-labelledby=\"build-title\">\n      <div class=\"build-panel\">\n        <div class=\"build-copy\">\n          <div class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> Up and running in minutes</div>\n          <h2 id=\"build-title\">Your next pipeline starts here.</h2>\n          <p>Spin up a local instance, connect your favorite client, and ship your first query. No account needed to get started.</p>\n          <a class=\"build-link\" href=\"#community\">Read the docs <span aria-hidden=\"true\">\u2192</span></a>\n        </div>\n        <div class=\"install-card\">\n          <div class=\"install-top\">\n            <span>QUICKSTART / TERMINAL</span>\n            <span>LOCAL SETUP</span>\n          </div>\n          <div class=\"install-code\">\n            <div><span class=\"muted\"># Install the Rivet CLI</span></div>\n            <div><span class=\"prompt\">$</span> curl -fsSL rivet.dev/install.sh | sh</div>\n            <br>\n            <div><span class=\"muted\"># Start a local database</span></div>\n            <div><span class=\"prompt\">$</span> rivet init my-warehouse</div>\n            <div><span class=\"prompt\">$</span> rivet dev</div>\n            <br>\n            <div><span class=\"prompt\">\u2713</span> Ready at <span class=\"lime\">localhost:7432</span></div>\n            <div><span class=\"prompt\">\u2713</span> Your SQL editor is waiting</div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"wrap manifesto\" id=\"community\" aria-labelledby=\"community-title\">\n      <h2 id=\"community-title\">The database is open.<br><span>So is the roadmap.</span></h2>\n      <div class=\"manifesto-copy\">\n        <p>Rivet is built in the open, with data engineers in the driver's seat. Read the code, shape what comes next, and make the database better for everyone.</p>\n        <p>Contributions, thoughtful issues, and hard questions are always welcome.</p>\n        <a class=\"license\" href=\"#quickstart\">\n          <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\" aria-hidden=\"true\">\n            <path d=\"m7 1.2 1.4 3 3.3.4-2.4 2.2.6 3.3L7 8.5l-2.9 1.6.6-3.3-2.4-2.2 3.3-.4L7 1.2Z\" stroke=\"currentColor\" stroke-width=\"1.1\" stroke-linejoin=\"round\"/>\n          </svg>\n          Open source under Apache 2.0\n        </a>\n      </div>\n    </section>\n\n    <section class=\"wrap cta\" aria-labelledby=\"cta-title\">\n      <div class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> Make room for better data work</div>\n      <h2 id=\"cta-title\">Ready to put Rivet to work?</h2>\n      <p>Get started locally. Bring your data when you're ready.</p>\n      <a class=\"button button-primary\" href=\"#quickstart\">Build with Rivet <span aria-hidden=\"true\">\u2192</span></a>\n    </section>\n  </main>\n\n  <footer class=\"wrap\">\n    <a class=\"brand\" href=\"#\" aria-label=\"Rivet home\">\n      <span class=\"brand-mark\" aria-hidden=\"true\">\n        <svg width=\"17\" height=\"17\" viewBox=\"0 0 17 17\" fill=\"none\">\n          <path d=\"M3 3.5h11M3 8.5h8M3 13.5h11\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/>\n          <circle cx=\"12.5\" cy=\"8.5\" r=\"1.5\" fill=\"currentColor\"/>\n        </svg>\n      </span>\n      rivet\n    </a>\n    <span>Open source for the people who move data. \u00a9 2025 Rivet</span>\n    <div class=\"footer-links\">\n      <a href=\"#why-rivet\">Docs</a>\n      <a href=\"#community\">GitHub</a>\n      <a href=\"#community\">Community</a>\n    </div>\n  </footer>\n</body>\n</html>\n"}