{"brief": "B2", "model": "z-ai/glm-5.3-flashx", "i": 4, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>\u60f3\u8c61\u79d1\u5b66\u9986 \u00b7 IMAGINE SCIENCE MUSEUM</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Noto+Sans+SC:wght@400;500;700;900&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --paper:#FBF4E6;\n    --ink:#1E2A4A;\n    --coral:#FF5A4E;\n    --sun:#FFC53D;\n    --teal:#0FA3A3;\n    --grape:#6C5CE7;\n    --leaf:#7BC950;\n    --pink:#FF8FB1;\n    --radius:22px;\n  }\n  *{margin:0;padding:0;box-sizing:border-box;}\n  html{scroll-behavior:smooth;}\n  body{\n    background:var(--paper);\n    color:var(--ink);\n    font-family:'Noto Sans SC',sans-serif;\n    overflow-x:hidden;\n  }\n  ::selection{background:var(--sun);color:var(--ink);}\n  h1,h2,h3,.baloo{font-family:'Baloo 2','Noto Sans SC',sans-serif;}\n\n  /* ---------- NAV ---------- */\n  nav{\n    position:fixed;top:0;left:0;right:0;z-index:100;\n    display:flex;align-items:center;justify-content:space-between;\n    padding:14px 4vw;\n    background:rgba(251,244,230,.88);\n    backdrop-filter:blur(8px);\n    border-bottom:3px solid var(--ink);\n  }\n  .logo{display:flex;align-items:center;gap:10px;font-weight:900;font-size:20px;letter-spacing:1px;}\n  .logo-mark{width:38px;height:38px;}\n  nav ul{display:flex;gap:28px;list-style:none;}\n  nav a{color:var(--ink);text-decoration:none;font-weight:700;font-size:15px;position:relative;}\n  nav a::after{content:'';position:absolute;left:0;bottom:-4px;width:0;height:3px;background:var(--coral);border-radius:2px;transition:width .25s;}\n  nav a:hover::after{width:100%;}\n  .nav-cta{\n    background:var(--coral);color:#fff !important;\n    padding:9px 22px;border-radius:999px;border:3px solid var(--ink);\n    box-shadow:3px 3px 0 var(--ink);transition:transform .15s, box-shadow .15s;\n  }\n  .nav-cta:hover{transform:translate(-2px,-2px);box-shadow:5px 5px 0 var(--ink);}\n  .nav-cta::after{display:none;}\n  @media(max-width:820px){nav ul{display:none;}}\n\n  /* ---------- HERO ---------- */\n  .hero{\n    position:relative;min-height:100vh;\n    display:grid;grid-template-columns:1.05fr .95fr;\n    align-items:center;gap:20px;\n    padding:120px 4vw 60px;\n    background:\n      radial-gradient(circle at 12% 20%, rgba(255,197,61,.35) 0 90px, transparent 91px),\n      radial-gradient(circle at 88% 75%, rgba(108,92,231,.18) 0 120px, transparent 121px),\n      var(--paper);\n  }\n  .hero-copy{z-index:2;}\n  .badge{\n    display:inline-flex;align-items:center;gap:8px;\n    background:#fff;border:3px solid var(--ink);border-radius:999px;\n    padding:7px 18px;font-weight:800;font-size:14px;\n    box-shadow:3px 3px 0 var(--sun);margin-bottom:22px;\n  }\n  .badge .dot{width:10px;height:10px;border-radius:50%;background:var(--teal);animation:blink 1.6s infinite;}\n  @keyframes blink{50%{opacity:.3;}}\n  .hero h1{\n    font-size:clamp(42px,6vw,82px);\n    line-height:1.06;font-weight:800;letter-spacing:-1px;\n  }\n  .hero h1 .hl{\n    color:var(--coral);position:relative;white-space:nowrap;\n  }\n  .hero h1 .hl svg{\n    position:absolute;left:0;bottom:-8px;width:100%;height:16px;\n  }\n  .hero p.sub{\n    margin:26px 0 34px;font-size:18px;line-height:1.9;max-width:480px;color:#3d4a6b;\n  }\n  .hero-btns{display:flex;gap:18px;flex-wrap:wrap;}\n  .btn{\n    display:inline-flex;align-items:center;gap:10px;\n    font-family:'Baloo 2','Noto Sans SC',sans-serif;\n    font-size:18px;font-weight:800;padding:15px 32px;\n    border-radius:999px;border:3px solid var(--ink);cursor:pointer;\n    text-decoration:none;transition:transform .15s, box-shadow .15s;\n  }\n  .btn-primary{background:var(--sun);color:var(--ink);box-shadow:4px 4px 0 var(--ink);}\n  .btn-ghost{background:#fff;color:var(--ink);box-shadow:4px 4px 0 transparent;}\n  .btn:hover{transform:translate(-3px,-3px);}\n  .btn-primary:hover{box-shadow:7px 7px 0 var(--ink);}\n  .btn-ghost:hover{box-shadow:4px 4px 0 var(--ink);}\n\n  /* rocket scene */\n  .hero-art{position:relative;height:520px;}\n  .scene-svg{width:100%;height:100%;overflow:visible;}\n  .stars circle{animation:twinkle 3s infinite ease-in-out;}\n  @keyframes twinkle{50%{opacity:.15;}}\n  #rocket{transition:transform 1.6s cubic-bezier(.4,-0.1,.6,1);}\n  #flame{opacity:0;transform-origin:70px 250px;}\n  .launching #flame{opacity:1;animation:flick .1s infinite alternate;}\n  @keyframes flick{from{transform:scaleY(1);}to{transform:scaleY(1.25) scaleX(.85);}}\n  .launching #rocket{animation:lift 2.4s cubic-bezier(.5,-0.2,.7,1) forwards;}\n  @keyframes lift{\n    0%{transform:translateY(0) rotate(0);}\n    12%{transform:translateY(6px) rotate(-2deg);}\n    100%{transform:translateY(-560px) rotate(4deg);}\n  }\n  .orbit-ring{animation:spin 22s linear infinite;transform-origin:340px 220px;}\n  @keyframes spin{to{transform:rotate(360deg);}}\n  .floaty{animation:floaty 5s ease-in-out infinite;}\n  @keyframes floaty{50%{transform:translateY(-14px);}}\n\n  .marquee{\n    border-top:3px solid var(--ink);border-bottom:3px solid var(--ink);\n    background:var(--ink);color:var(--paper);overflow:hidden;white-space:nowrap;\n    padding:12px 0;font-family:'Baloo 2',sans-serif;font-weight:700;font-size:16px;letter-spacing:2px;\n  }\n  .marquee-inner{display:inline-block;animation:scroll 26s linear infinite;}\n  @keyframes scroll{to{transform:translateX(-50%);}}\n  .marquee span{margin:0 26px;}\n  .marquee i{color:var(--sun);font-style:normal;margin-right:26px;}\n\n  /* ---------- SECTIONS ---------- */\n  section{padding:90px 4vw;}\n  .sec-head{max-width:640px;margin-bottom:56px;}\n  .kicker{\n    display:inline-block;font-weight:900;font-size:13px;letter-spacing:3px;\n    color:#fff;background:var(--teal);padding:6px 16px;border-radius:999px;margin-bottom:16px;\n  }\n  .sec-head h2{font-size:clamp(30px,4vw,48px);font-weight:800;line-height:1.15;}\n  .sec-head p{margin-top:14px;color:#3d4a6b;font-size:16.5px;line-height:1.8;}\n\n  /* exhibit halls \u2014 staggered layout, not uniform grid */\n  .halls{display:grid;grid-template-columns:repeat(12,1fr);gap:24px;}\n  .hall{\n    border:3px solid var(--ink);border-radius:var(--radius);background:#fff;\n    padding:30px 28px 26px;position:relative;overflow:hidden;\n    box-shadow:6px 6px 0 var(--ink);transition:transform .2s, box-shadow .2s;\n  }\n  .hall:hover{transform:translate(-4px,-4px);box-shadow:10px 10px 0 var(--ink);}\n  .hall svg{width:74px;height:74px;margin-bottom:18px;}\n  .hall h3{font-size:23px;font-weight:800;margin-bottom:10px;}\n  .hall p{font-size:15px;line-height:1.8;color:#3d4a6b;}\n  .hall .tag{\n    position:absolute;top:22px;right:-34px;transform:rotate(38deg);\n    font-size:12px;font-weight:900;color:#fff;padding:5px 40px;letter-spacing:1px;\n  }\n  .hall .num{\n    position:absolute;bottom:14px;right:20px;\n    font-family:'Baloo 2';font-weight:800;font-size:52px;opacity:.1;\n  }\n  .hall-a{grid-column:span 5;grid-row:span 2;display:flex;flex-direction:column;justify-content:flex-end;min-height:420px;background:var(--sun);}\n  .hall-a .art{flex:1;display:flex;align-items:center;justify-content:center;}\n  .hall-a svg.big{width:200px;height:200px;margin:0;}\n  .hall-b{grid-column:span 4;}\n  .hall-c{grid-column:span 3;background:#E8F6F3;}\n  .hall-d{grid-column:span 3;}\n  .hall-e{grid-column:span 4;background:#FDEDEC;}\n  @media(max-width:900px){\n    .halls{grid-template-columns:1fr;}\n    .hall{grid-column:span 1 !important;grid-row:auto !important;min-height:auto !important;}\n  }\n\n  /* interactive lab */\n  .lab{\n    background:var(--ink);color:var(--paper);border-radius:34px;\n    margin:0 4vw;padding:70px 5vw;\n    display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center;\n    border:3px solid var(--ink);box-shadow:10px 10px 0 var(--sun);\n  }\n  .lab .kicker{background:var(--coral);}\n  .lab h2{font-size:clamp(28px,3.6vw,44px);color:#fff;}\n  .lab p{margin:18px 0 0;color:#b9c2dd;line-height:1.9;font-size:16px;}\n  .mixer{\n    background:rgba(255,255,255,.06);border:3px solid rgba(255,255,255,.25);\n    border-radius:26px;padding:30px;text-align:center;\n  }\n  .flask-wrap{height:230px;display:flex;align-items:center;justify-content:center;}\n  #liquid{transition:fill .4s;}\n  .sliders{display:flex;flex-direction:column;gap:16px;margin-top:12px;}\n  .slider-row{display:flex;align-items:center;gap:14px;font-weight:700;font-size:14px;}\n  .slider-row label{width:70px;text-align:right;}\n  input[type=range]{\n    flex:1;-webkit-appearance:none;appearance:none;height:10px;border-radius:99px;\n    background:rgba(255,255,255,.2);outline:none;cursor:pointer;\n  }\n  input[type=range]::-webkit-slider-thumb{\n    -webkit-appearance:none;width:24px;height:24px;border-radius:50%;\n    background:var(--sun);border:3px solid #fff;cursor:grab;\n  }\n  #mixName{font-family:'Baloo 2';font-weight:800;font-size:20px;color:var(--sun);margin-top:16px;min-height:28px;}\n  @media(max-width:900px){.lab{grid-template-columns:1fr;}}\n\n  /* visit info */\n  .visit-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}\n  .visit-card{\n    border:3px solid var(--ink);border-radius:var(--radius);background:#fff;\n    padding:30px;box-shadow:6px 6px 0 var(--ink);\n  }\n  .visit-card .ic{\n    width:56px;height:56px;border-radius:16px;display:flex;align-items:center;justify-content:center;\n    border:3px solid var(--ink);margin-bottom:18px;\n  }\n  .visit-card h3{font-size:20px;margin-bottom:10px;}\n  .visit-card p, .visit-card li{font-size:15px;line-height:1.9;color:#3d4a6b;}\n  .visit-card ul{list-style:none;}\n  .visit-card li::before{content:'\u25b8 ';color:var(--coral);font-weight:900;}\n  @media(max-width:900px){.visit-grid{grid-template-columns:1fr;}}\n\n  /* CTA band */\n  .cta-band{\n    margin:0 4vw 90px;background:var(--coral);border:3px solid var(--ink);\n    border-radius:34px;padding:70px 6vw;text-align:center;color:#fff;\n    box-shadow:10px 10px 0 var(--ink);position:relative;overflow:hidden;\n  }\n  .cta-band h2{font-size:clamp(28px,4vw,46px);color:#fff;}\n  .cta-band p{margin:16px auto 32px;max-width:520px;font-size:17px;line-height:1.8;color:#ffe3e0;}\n  .btn-white{background:#fff;color:var(--coral);box-shadow:4px 4px 0 var(--ink);}\n  .confetti{position:absolute;border-radius:50%;animation:fall linear infinite;top:-20px;}\n  @keyframes fall{to{transform:translateY(480px) rotate(720deg);}}\n\n  footer{\n    background:var(--ink);color:#aeb8d6;padding:60px 4vw 30px;\n    border-top:3px solid var(--ink);\n  }\n  .foot-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:40px;max-width:1200px;margin:0 auto;}\n  footer h4{color:#fff;font-size:16px;margin-bottom:16px;font-family:'Baloo 2','Noto Sans SC';}\n  footer li{list-style:none;margin-bottom:10px;font-size:14px;}\n  footer a{color:#aeb8d6;text-decoration:none;}\n  footer a:hover{color:var(--sun);}\n  .foot-bottom{\n    max-width:1200px;margin:50px auto 0;padding-top:24px;\n    border-top:1px solid rgba(255,255,255,.15);\n    display:flex;justify-content:space-between;font-size:13px;flex-wrap:wrap;gap:10px;\n  }\n  @media(max-width:800px){.foot-grid{grid-template-columns:1fr 1fr;}}\n</style>\n</head>\n<body>\n\n<!-- ============ NAV ============ -->\n<nav>\n  <div class=\"logo\">\n    <svg class=\"logo-mark\" viewBox=\"0 0 40 40\"><circle cx=\"20\" cy=\"20\" r=\"8\" fill=\"#FF5A4E\" stroke=\"#1E2A4A\" stroke-width=\"3\"/><ellipse cx=\"20\" cy=\"20\" rx=\"18\" ry=\"7\" fill=\"none\" stroke=\"#0FA3A3\" stroke-width=\"3\" transform=\"rotate(-25 20 20)\"/><circle cx=\"34\" cy=\"13\" r=\"3.5\" fill=\"#FFC53D\" stroke=\"#1E2A4A\" stroke-width=\"2.5\"/></svg>\n    \u60f3\u8c61\u79d1\u5b66\u9986\n  </div>\n  <ul>\n    <li><a href=\"#halls\">\u5c55\u5385</a></li>\n    <li><a href=\"#lab\">\u5b9e\u9a8c\u5ba4</a></li>\n    <li><a href=\"#visit\">\u53c2\u89c2\u4fe1\u606f</a></li>\n    <li><a href=\"#\" class=\"nav-cta\">\u9884\u7ea6\u95e8\u7968</a></li>\n  </ul>\n</nav>\n\n<!-- ============ HERO ============ -->\n<header class=\"hero\" id=\"top\">\n  <div class=\"hero-copy\">\n    <div class=\"badge\"><span class=\"dot\"></span> \u4eca\u65e5\u5f00\u9986 \u00b7 9:00 \u2013 17:30</div>\n    <h1>\u8ba9\u6bcf\u4e2a\u5b69\u5b50<br>\u90fd\u6210\u4e3a<span class=\"hl\">\u5c0f\u5c0f\u79d1\u5b66\u5bb6<svg viewBox=\"0 0 200 16\" preserveAspectRatio=\"none\"><path d=\"M4 12 Q 50 2 100 10 T 196 8\" fill=\"none\" stroke=\"#FFC53D\" stroke-width=\"6\" stroke-linecap=\"round\"/></svg></span></h1>\n    <p class=\"sub\">\u5728\u60f3\u8c61\u79d1\u5b66\u9986\uff0c\u79d1\u5b66\u4e0d\u662f\u8bfe\u672c\u4e0a\u7684\u516c\u5f0f\uff0c\u800c\u662f\u4e00\u573a\u53ef\u4ee5\u89e6\u6478\u3001\u53ef\u4ee5\u62c6\u89e3\u3001\u53ef\u4ee5\u5f04\u5f97\u5230\u5904\u90fd\u662f\u7684\u5927\u5192\u9669\u3002\u56db\u5927\u4e3b\u9898\u5c55\u5385\u3001200+ \u4e92\u52a8\u88c5\u7f6e\uff0c\u7b49\u4e00\u4e2a\u597d\u5947\u7684\u4f60\u3002</p>\n    <div class=\"hero-btns\">\n      <a class=\"btn btn-primary\" href=\"#\" onclick=\"return false;\">\u9884\u7ea6\u53c2\u89c2\u95e8\u7968</a>\n      <button class=\"btn btn-ghost\" id=\"launchBtn\">\ud83d\ude80 \u53d1\u5c04\u706b\u7bad</button>\n    </div>\n  </div>\n\n  <div class=\"hero-art\" id=\"scene\">\n    <svg class=\"scene-svg\" viewBox=\"0 0 680 520\">\n      <!-- stars -->\n      <g class=\"stars\" fill=\"#1E2A4A\">\n        <circle cx=\"60\" cy=\"60\" r=\"3\"><animate attributeName=\"opacity\" values=\"1;.2;1\" dur=\"2.4s\" repeatCount=\"indefinite\"/></circle>\n        <circle cx=\"600\" cy=\"80\" r=\"4\"><animate attributeName=\"opacity\" values=\".2;1;.2\" dur=\"3.1s\" repeatCount=\"indefinite\"/></circle>\n        <circle cx=\"500\" cy=\"30\" r=\"2.5\"><animate attributeName=\"opacity\" values=\"1;.3;1\" dur=\"2s\" repeatCount=\"indefinite\"/></circle>\n        <circle cx=\"120\" cy=\"200\" r=\"2.5\"><animate attributeName=\"opacity\" values=\".3;1;.3\" dur=\"2.8s\" repeatCount=\"indefinite\"/></circle>\n        <circle cx=\"640\" cy=\"320\" r=\"3\"><animate attributeName=\"opacity\" values=\"1;.2;1\" dur=\"3.4s\" repeatCount=\"indefinite\"/></circle>\n        <circle cx=\"40\" cy=\"380\" r=\"3.5\"><animate attributeName=\"opacity\" values=\".2;1;.2\" dur=\"2.2s\" repeatCount=\"indefinite\"/></circle>\n        <circle cx=\"250\" cy=\"40\" r=\"2.5\"><animate attributeName=\"opacity\" values=\"1;.2;1\" dur=\"3s\" repeatCount=\"indefinite\"/></circle>\n      </g>\n\n      <!-- planet with ring -->\n      <g class=\"floaty\">\n        <circle cx=\"340\" cy=\"220\" r=\"70\" fill=\"#FFC53D\" stroke=\"#1E2A4A\" stroke-width=\"4\"/>\n        <circle cx=\"315\" cy=\"200\" r=\"14\" fill=\"#FF5A4E\" opacity=\".85\"/>\n        <circle cx=\"365\" cy=\"245\" r=\"9\" fill=\"#0FA3A3\" opacity=\".85\"/>\n        <ellipse class=\"orbit-ring\" cx=\"340\" cy=\"220\" rx=\"118\" ry=\"34\" fill=\"none\" stroke=\"#6C5CE7\" stroke-width=\"5\" stroke-dasharray=\"14 10\"/>\n        <circle cx=\"458\" cy=\"220\" r=\"11\" fill=\"#FF8FB1\" stroke=\"#1E2A4A\" stroke-width=\"3.5\"/>\n      </g>\n\n      <!-- cloud -->\n      <g transform=\"translate(80,430)\" fill=\"#fff\" stroke=\"#1E2A4A\" stroke-width=\"4\">\n        <ellipse cx=\"50\" cy=\"30\" rx=\"48\" ry=\"22\"/><ellipse cx=\"95\" cy=\"22\" rx=\"34\" ry=\"20\"/><ellipse cx=\"10\" cy=\"35\" rx=\"26\" ry=\"16\"/>\n      </g>\n\n      <!-- rocket -->\n      <g id=\"rocket\">\n        <g transform=\"translate(70,150)\">\n          <!-- flame -->\n          <g id=\"flame\">\n            <path d=\"M70 105 Q 55 135 70 165 Q 85 135 70 105\" fill=\"#FFC53D\" stroke=\"#FF5A4E\" stroke-width=\"3\"/>\n            <path d=\"M70 110 Q 62 130 70 150 Q 78 130 70 110\" fill=\"#FF5A4E\"/>\n          </g>\n          <!-- body -->\n          <path d=\"M70 0 Q 105 45 105 100 L 35 100 Q 35 45 70 0\" fill=\"#fff\" stroke=\"#1E2A4A\" stroke-width=\"4\"/>\n          <circle cx=\"70\" cy=\"55\" r=\"16\" fill=\"#0FA3A3\" stroke=\"#1E2A4A\" stroke-width=\"4\"/>\n          <path d=\"M35 72 L 8 108 L 35 100 Z\" fill=\"#FF5A4E\" stroke=\"#1E2A4A\" stroke-width=\"4\"/>\n          <path d=\"M105 72 L 132 108 L 105 100 Z\" fill=\"#FF5A4E\" stroke=\"#1E2A4A\" stroke-width=\"4\"/>\n          <rect x=\"35\" y=\"100\" width=\"70\" height=\"14\" rx=\"4\" fill=\"#FF5A4E\" stroke=\"#1E2A4A\" stroke-width=\"4\"/>\n        </g>\n      </g>\n\n      <!-- squiggle -->\n      <path d=\"M480 460 q 20 -18 40 0 t 40 0 t 40 0\" fill=\"none\" stroke=\"#1E2A4A\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n    </svg>\n  </div>\n</header>\n\n<!-- ============ MARQUEE ============ -->\n<div class=\"marquee\">\n  <div class=\"marquee-inner\" id=\"marquee\">\n    <span>\u4e3a\u4ec0\u4e48\u5929\u7a7a\u662f\u84dd\u8272\u7684<i>\u2726</i></span><span>\u6050\u9f99\u4e3a\u4ec0\u4e48\u4e0d\u5237\u7259<i>\u2726</i></span><span>\u706b\u5c71\u4f1a\u6253\u55dd\u5417<i>\u2726</i></span><span>\u6708\u4eae\u4e0a\u80fd\u8df3\u591a\u9ad8<i>\u2726</i></span><span>\u8682\u8681\u6709\u51e0\u53cc\u978b\u5b50<i>\u2726</i></span><span>\u5f69\u8679\u53ef\u4ee5\u6478\u5417<i>\u2726</i></span>\n  </div>\n</div>\n\n<!-- ============ HALLS ============ -->\n<section id=\"halls\">\n  <div class=\"sec-head\">\n    <span class=\"kicker\">\u56db\u5927\u5c55\u5385</span>\n    <h2>\u6bcf\u4e00\u5c42\u697c\uff0c\u90fd\u662f\u4e00\u4e2a\u65b0\u7684\u5b87\u5b99</h2>\n    <p>\u4ece\u5fae\u89c2\u7684\u539f\u5b50\u5230\u6d69\u701a\u7684\u661f\u7a7a\uff0c\u4ece\u6050\u9f99\u65f6\u4ee3\u5230\u673a\u5668\u4eba\u672a\u6765\u2014\u2014\u6211\u4eec\u4e3a\u5b69\u5b50\u8bbe\u8ba1\u4e86\u5b8c\u6574\u7684\u63a2\u7d22\u8def\u7ebf\u3002</p>\n  </div>\n  <div class=\"halls\">\n    <div class=\"hall hall-a\">\n      <span class=\"tag\" style=\"background:var(--coral)\">\u4eba\u6c14 TOP</span>\n      <div class=\"art\">\n        <svg class=\"big\" viewBox=\"0 0 120 120\">\n          <circle cx=\"60\" cy=\"60\" r=\"26\" fill=\"#FF5A4E\" stroke=\"#1E2A4A\" stroke-width=\"4\"/>\n          <ellipse cx=\"60\" cy=\"60\" rx=\"52\" ry=\"20\" fill=\"none\" stroke=\"#1E2A4A\" stroke-width=\"4\" transform=\"rotate(-30 60 60)\"/>\n          <ellipse cx=\"60\" cy=\"60\" rx=\"52\" ry=\"20\" fill=\"none\" stroke=\"#1E2A4A\" stroke-width=\"4\" transform=\"rotate(30 60 60)\"/>\n          <circle cx=\"104\" cy=\"42\" r=\"6\" fill=\"#0FA3A3\" stroke=\"#1E2A4A\" stroke-width=\"3\"/>\n        </svg>\n      </div>\n      <h3>\u5b87\u5b99\u63a2\u7d22\u9986</h3>\n      <p>\u94bb\u8fdb 1:1 \u590d\u523b\u7684\u592a\u7a7a\u8231\uff0c\u9a7e\u9a76\u6a21\u62df\u98de\u8239\u7a7f\u8d8a\u5c0f\u884c\u661f\u5e26\uff0c\u518d\u8eba\u4e0a\u5f15\u529b\u6ed1\u68af\u4f53\u9a8c\"\u4ece\u6708\u7403\u56de\u5bb6\"\u7684\u611f\u89c9\u3002\u665a\u4e0a\u8fd8\u6709\u771f\u6b63\u7684\u5929\u6587\u89c2\u6d4b\u53f0\u3002</p>\n      <span class=\"num\">01</span>\n    </div>\n    <div class=\"hall hall-b\">\n      <svg viewBox=\"0 0 80 80\"><path d=\"M32 10 h16 v14 l14 30 a10 10 0 0 1 -9 15 h-26 a10 10 0 0 1 -9 -15 l14 -30 z\" fill=\"#0FA3A3\" stroke=\"#1E2A4A\" stroke-width=\"4\"/><path d=\"M20 52 h40\" stroke=\"#1E2A4A\" stroke-width=\"3\"/><circle cx=\"34\" cy=\"60\" r=\"4\" fill=\"#FFC53D\"/><circle cx=\"48\" cy=\"57\" r=\"3\" fill=\"#FF5A4E\"/></svg>\n      <h3>\u75af\u72c2\u5b9e\u9a8c\u5ba4</h3>\n      <p>\u7a7f\u6234\u597d\u5c0f\u767d\u888d\uff0c\u6bcf\u5929 6 \u573a\u73b0\u573a\u79d1\u5b66\u79c0\uff1a\u5927\u8c61\u7259\u818f\u3001\u6db2\u6001\u6c2e\u51b0\u6dc7\u6dcb\u3001\u770b\u4e0d\u89c1\u7684\u73bb\u7483\u7403\u2026\u2026</p>\n      <span class=\"num\">02</span>\n    </div>\n    <div class=\"hall hall-c\">\n      <svg viewBox=\"0 0 80 80\"><circle cx=\"40\" cy=\"40\" r=\"26\" fill=\"#7BC950\" stroke=\"#1E2A4A\" stroke-width=\"4\"/><path d=\"M40 30 v22 M30 40 h20\" stroke=\"#1E2A4A\" stroke-width=\"4\" stroke-linecap=\"round\"/><path d=\"M20 62 q-6 8 -10 8 M60 62 q6 8 10 8\" stroke=\"#1E2A4A\" stroke-width=\"4\" fill=\"none\" stroke-linecap=\"round\"/></svg>\n      <h3>\u751f\u547d\u5947\u5999\u5c4b</h3>\n      <p>\u7528\u5de8\u578b\u653e\u5927\u955c\u770b\u8682\u8681\u642c\u5bb6\uff0c\u94bb\u8fdb\"\u4eba\u4f53\u96a7\u9053\"\u542c\u5fc3\u8df3\u6253\u9f13\u3002</p>\n      <span class=\"num\">03</span>\n    </div>\n    <div class=\"hall hall-d\">\n      <svg viewBox=\"0 0 80 80\"><rect x=\"16\" y=\"26\" width=\"48\" height=\"38\" rx=\"8\" fill=\"#6C5CE7\" stroke=\"#1E2A4A\" stroke-width=\"4\"/><circle cx=\"32\" cy=\"44\" r=\"5\" fill=\"#fff\" stroke=\"#1E2A4A\" stroke-width=\"3\"/><circle cx=\"48\" cy=\"44\" r=\"5\" fill=\"#fff\" stroke=\"#1E2A4A\" stroke-width=\"3\"/><path d=\"M32 56 q8 6 16 0\" stroke=\"#1E2A4A\" stroke-width=\"3\" fill=\"none\" stroke-linecap=\"round\"/><path d=\"M28 26 v-8 M52 26 v-8\" stroke=\"#1E2A4A\" stroke-width=\"4\" stroke-linecap=\"round\"/></svg>\n      <h3>\u673a\u5668\u4eba\u672a\u6765\u57ce</h3>\n      <p>\u548c\u4f1a\u753b\u753b\u673a\u68b0\u81c2\u6bd4\u4e00\u6bd4\uff0c\u518d\u7528\u79ef\u6728\u7f16\u7a0b\u5c5e\u4e8e\u4f60\u7684\u7b2c\u4e00\u53f0\u673a\u5668\u4eba\u3002</p>\n      <span class=\"num\">04</span>\n    </div>\n    <div class=\"hall hall-e\">\n      <svg viewBox=\"0 0 80 80\"><path d=\"M40 12 L48 32 L70 34 L53 48 L58 70 L40 58 L22 70 L27 48 L10 34 L32 32 Z\" fill=\"#FFC53D\" stroke=\"#1E2A4A\" stroke-width=\"4\" stroke-linejoin=\"round\"/></svg>\n      <h3>\u672c\u5468\u7279\u5c55 \u00b7 \u6050\u9f99\u590d\u6d3b\u8ba1\u5212</h3>\n      <p>1:1 \u5927\u5c0f\u7684\u9738\u738b\u9f99\u9aa8\u67b6\u4f1a\"\u6d3b\"\u8fc7\u6765\uff01AR \u6295\u5f71 + \u771f\u5b9e\u5316\u77f3\u89e6\u6478\u533a\uff0c\u4ec5\u5f00\u653e\u81f3 6 \u6708 30 \u65e5\uff0c\u522b\u9519\u8fc7\u3002</p>\n      <span class=\"num\">\u2605</span>\n    </div>\n  </div>\n</section>\n\n<!-- ============ LAB ============ -->\n<div class=\"lab\" id=\"lab\">\n  <div>\n    <span class=\"kicker\">\u7ebf\u4e0a\u5c0f\u5b9e\u9a8c</span>\n    <h2>\u5148\u5728\u7ebf\u4e0a\u73a9\u4e00\u6b21\u989c\u8272\u9b54\u6cd5</h2>\n    <p>\u8fd9\u662f\u75af\u72c2\u5b9e\u9a8c\u5ba4\u6700\u53d7\u6b22\u8fce\u7684\u5b9e\u9a8c\u4e4b\u4e00\u2014\u2014\u4e09\u539f\u8272\u6df7\u5408\u3002\u62d6\u52a8\u6ed1\u5757\uff0c\u770b\u770b\u7ea2\u3001\u9ec4\u3001\u84dd\u4e09\u79cd\u989c\u6599\u76f8\u9047\u4f1a\u53d1\u751f\u4ec0\u4e48\uff1f\u5230\u9986\u540e\uff0c\u4f60\u53ef\u4ee5\u5728\u771f\u5b9e\u7684\u5b9e\u9a8c\u53f0\u4e0a\u4eb2\u624b\u8c03\u51fa\u5c5e\u4e8e\u81ea\u5df1\u7684\u989c\u8272\uff0c\u5e76\u628a\u5b83\u5370\u5728\u7eaa\u5ff5 T \u6064\u4e0a\u5e26\u56de\u5bb6\u3002</p>\n  </div>\n  <div class=\"mixer\">\n    <div class=\"flask-wrap\">\n      <svg viewBox=\"0 0 140 230\" width=\"180\">\n        <path id=\"liquid\" d=\"M38 100 L38 180 Q38 210 70 210 Q102 210 102 180 L102 100 Z\" fill=\"#4A90D9\"/>\n        <path d=\"M38 100 L38 180 Q38 210 70 210 Q102 210 102 180 L102 100 L102 88 L38 88 Z\" fill=\"none\" stroke=\"#FBF4E6\" stroke-width=\"6\"/>\n        <rect x=\"30\" y=\"78\" width=\"80\" height=\"16\" rx=\"6\" fill=\"#FBF4E6\"/>\n        <circle cx=\"62\" cy=\"160\" r=\"6\" fill=\"rgba(255,255,255,.5)\"/>\n        <circle cx=\"82\" cy=\"175\" r=\"4\" fill=\"rgba(255,255,255,.5)\"/>\n        <circle cx=\"55\" cy=\"185\" r=\"3\" fill=\"rgba(255,255,255,.5)\"/>\n      </svg>\n    </div>\n    <div class=\"sliders\">\n      <div class=\"slider-row\"><label>\ud83d\udd34 \u7ea2</label><input type=\"range\" id=\"sr\" min=\"0\" max=\"255\" value=\"74\"></div>\n      <div class=\"slider-row\"><label>\ud83d\udfe1 \u9ec4</label><input type=\"range\" id=\"sg\" min=\"0\" max=\"255\" value=\"144\"></div>\n      <div class=\"slider-row\"><label>\ud83d\udd35 \u84dd</label><input type=\"range\" id=\"sb\" min=\"0\" max=\"255\" value=\"217\"></div>\n    </div>\n    <div id=\"mixName\">\u8c03\u51fa\u4f60\u4e13\u5c5e\u7684\u989c\u8272\uff01</div>\n  </div>\n</div>\n\n<!-- ============ VISIT ============ -->\n<section id=\"visit\">\n  <div class=\"sec-head\">\n    <span class=\"kicker\" style=\"background:var(--grape)\">\u53c2\u89c2\u4fe1\u606f</span>\n    <h2>\u89c4\u5212\u4f60\u7684\u79d1\u5b66\u9986\u4e4b\u65c5</h2>\n  </div>\n  <div class=\"visit-grid\">\n    <div class=\"visit-card\">\n      <div class=\"ic\" style=\"background:#E8F6F3\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 28 28\"><circle cx=\"14\" cy=\"14\" r=\"10\" fill=\"none\" stroke=\"#0FA3A3\" stroke-width=\"3\"/><path d=\"M14 8 v6 l4 3\" stroke=\"#0FA3A3\" stroke-width=\"3\" fill=\"none\" stroke-linecap=\"round\"/></svg></div>\n      <h3>\u5f00\u653e\u65f6\u95f4</h3>\n      <ul>\n        <li>\u5468\u4e8c\u81f3\u5468\u4e94\uff1a9:00 \u2013 17:30</li>\n        <li>\u5468\u672b\u53ca\u8282\u5047\u65e5\uff1a9:00 \u2013 19:00</li>\n        <li>\u6bcf\u5468\u4e00\u95ed\u9986\u68c0\u4fee</li>\n      </ul>\n    </div>\n    <div class=\"visit-card\">\n      <div class=\"ic\" style=\"background:#FDEDEC\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 28 28\"><rect x=\"4\" y=\"6\" width=\"20\" height=\"17\" rx=\"3\" fill=\"none\" stroke=\"#FF5A4E\" stroke-width=\"3\"/><path d=\"M4 12 h20 M9 6 v-3 M19 6 v-3\" stroke=\"#FF5A4E\" stroke-width=\"3\" stroke-linecap=\"round\"/></svg></div>\n      <h3>\u95e8\u7968\u4ef7\u683c</h3>\n      <ul>\n        <li>\u513f\u7ae5\uff083\u201314 \u5c81\uff09\uff1a\u00a5 60</li>\n        <li>\u6210\u4eba\u966a\u540c\u7968\uff1a\u00a5 80</li>\n        <li>3 \u5c81\u4ee5\u4e0b & \u751f\u65e5\u5f53\u5929\uff1a\u514d\u8d39</li>\n      </ul>\n    </div>\n    <div class=\"visit-card\">\n      <div class=\"ic\" style=\"background:#FFF3D6\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 28 28\"><path d=\"M14 3 L17 11 L25 11.5 L19 16.5 L21 24 L14 20 L7 24 L9 16.5 L3 11.5 L11 11 Z\" fill=\"none\" stroke=\"#E0A400\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/></svg></div>\n      <h3>\u8d34\u5fc3\u670d\u52a1</h3>\n      <ul>\n        <li>\u5168\u9986\u6bcd\u5a74\u5ba4 & \u65e0\u969c\u788d\u901a\u9053</li>\n        <li>\u514d\u8d39\u5bc4\u5b58\u63a8\u8f66\u548c\u884c\u674e</li>\n        <li>\u79d1\u5b66\u8001\u5e08\u5168\u7a0b\u5de1\u573a\u7b54\u7591</li>\n      </ul>\n    </div>\n  </div>\n</section>\n\n<!-- ============ CTA ============ -->\n<div class=\"cta-band\" id=\"cta\">\n  <h2>\u597d\u5947\u5fc3\uff0c\u662f\u6700\u597d\u7684\u95e8\u7968</h2>\n  <p>\u672c\u5468\u9884\u7ea6\u8fd8\u80fd\u89e3\u9501\u9690\u85cf\u4efb\u52a1\u5361\u2014\u2014\u96c6\u9f50\u56db\u679a\u5c55\u5385\u5370\u7ae0\uff0c\u5151\u6362\u795e\u79d8\u7684\u79d1\u5b66\u5bb6\u5fbd\u7ae0\uff01</p>\n  <a class=\"btn btn-white\" href=\"#\" onclick=\"return false;\">\u7acb\u5373\u9884\u7ea6 \u00b7 \u5468\u672b\u573a\u6b21\u6240\u5269\u4e0d\u591a</a>\n</div>\n\n<!-- ============ FOOTER ============ -->\n<footer>\n  <div class=\"foot-grid\">\n    <div>\n      <h4>\u60f3\u8c61\u79d1\u5b66\u9986</h4>\n      <p style=\"font-size:14px;line-height:1.9;\">\u4e00\u5ea7\u4e3a\u5b69\u5b50\u800c\u5efa\u7684\u79d1\u5b66\u4e50\u56ed\u3002<br>\u5730\u5740\uff1a\u68a6\u60f3\u5927\u9053 42 \u53f7 \u00b7 \u60f3\u8c61\u516c\u56ed\u4e1c\u95e8<br>\u7535\u8bdd\uff1a400-123-4567</p>\n    </div>\n    <div>\n      <h4>\u63a2\u7d22</h4>\n      <ul><li><a href=\"#halls\">\u5c55\u5385\u5bfc\u89c8</a></li><li><a href=\"#lab\">\u5b9e\u9a8c\u5ba4</a></li><li><a href=\"#\">\u7279\u5c55\u65e5\u5386</a></li></ul>\n    </div>\n    <div>\n      <h4>\u53c2\u89c2</h4>\n      <ul><li><a href=\"#\">\u8d2d\u7968\u9884\u7ea6</a></li><li><a href=\"#visit\">\u4ea4\u901a\u6307\u5f15</a></li><li><a href=\"#\">\u56e2\u4f53\u9884\u7ea6</a></li></ul>\n    </div>\n    <div>\n      <h4>\u5173\u4e8e</h4>\n      <ul><li><a href=\"#\">\u6211\u4eec\u7684\u6545\u4e8b</a></li><li><a href=\"#\">\u52a0\u5165\u6211\u4eec</a></li><li><a href=\"#\">\u5fd7\u613f\u8005\u8ba1\u5212</a></li></ul>\n    </div>\n  </div>\n  <div class=\"foot-bottom\">\n    <span>\u00a9 2025 \u60f3\u8c61\u79d1\u5b66\u9986 IMAGINE SCIENCE MUSEUM</span>\n    <span>\u4e3a\u6240\u6709 3 \u2013 14 \u5c81\u7684\u597d\u5947\u5fc3\u670d\u52a1 \u2726</span>\n  </div>\n</footer>\n\n<script>\n  // rocket launch\n  document.getElementById('launchBtn').addEventListener('click', function(){\n    const scene = document.getElementById('scene');\n    if(scene.classList.contains('launching')) return;\n    scene.classList.add('launching');\n    setTimeout(()=>scene.classList.remove('launching'), 2500);\n  });\n\n  // color mixer\n  const sr=document.getElementById('sr'), sg=document.getElementById('sg'), sb=document.getElementById('sb');\n  const liquid=document.getElementById('liquid'), mixName=document.getElementById('mixName');\n  function names(r,g,b){\n    if(r>180&&g>180&&b<120) return '\u9999\u8549\u9ec4\u8272\uff01\u50cf\u5927\u4fbf\u4e00\u6837\u7684\u79d1\u5b66';\n    if(r<80&&g<80&&b>180) return '\u6df1\u6d77\u84dd\u2014\u2014\u9cb8\u9c7c\u6700\u559c\u6b22\u7684\u989c\u8272';\n    if(r>180&&g<80&&b<80) return '\u6d88\u9632\u8f66\u7ea2\uff01';\n    if(r>180&&g>180&&b>180) return '\u51e0\u4e4e\u53d8\u767d\u4e86\uff1f\u989c\u6599\u4e0d\u662f\u8fd9\u6837\u6df7\u5408\u7684\u54e6';\n    if(r<70&&g<70&&b<70) return '\u795e\u79d8\u7684\u9ed1\u2026\u2026\u628a\u6240\u6709\u989c\u8272\u90fd\u5438\u8d70\u4e86';\n    if(r>g&&g>b) return '\u6a59\u8272\u7684\u843d\u65e5';\n    if(g>r&&b>r) return '\u9752\u8272\u7684\u6e56\u6c34';\n    if(r>b&&b>g) return '\u8461\u8404\u7d2b';\n    if(g>b&&r>b) return '\u62b9\u8336\u7eff';\n    return '\u72ec\u4e00\u65e0\u4e8c\u7684\u79d1\u5b66\u8272\uff01';\n  }\n  function update(){\n    const r=+sr.value,g=+sg.value,b=+sb.value;\n    const hex='#'+[r,g,b].map(v=>v.toString(16).padStart(2,'0')).join('');\n    liquid.setAttribute('fill',hex);\n    mixName.textContent=names(r,g,b);\n  }\n  [sr,sg,sb].forEach(s=>s.addEventListener('input',update));\n  update();\n\n  // marquee duplicate for seamless loop\n  const mq=document.getElementById('marquee');\n  mq.innerHTML+=mq.innerHTML;\n\n  // confetti in CTA band\n  const band=document.getElementById('cta');\n  const colors=['#FFC53D','#0FA3A3','#6C5CE7','#7BC950','#FF8FB1'];\n  for(let i=0;i<18;i++){\n    const c=document.createElement('span');\n    c.className='confetti';\n    const s=6+Math.random()*8;\n    c.style.cssText=`left:${Math.random()*100}%;width:${s}px;height:${s}px;background:${colors[i%5]};animation-duration:${4+Math.random()*4}s;animation-delay:${-Math.random()*6}s;opacity:.85;`;\n    band.appendChild(c);\n  }\n</script>\n</body>\n</html>\n"}