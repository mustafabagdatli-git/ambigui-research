  .float-card { right: -8px; }\n    }\n\n    @media (max-width: 720px) {\n      .container { width: min(100% - 36px, 540px); }\n      .topbar-inner { justify-content: center; }\n      .topbar-note { display: none; }\n      .nav { min-height: 70px; }\n      .nav-links { display: none; }\n      .nav > .button { min-height: 42px; padding-inline: 13px; font-size: 12px; }\n      .brand-name { font-size: 14px; }\n      .brand-mark { width: 39px; height: 39px; }\n\n      .hero { padding: 58px 0 50px; }\n      .hero-grid { grid-template-columns: 1fr; gap: 28px; }\n      h1 { max-width: 540px; font-size: clamp(42px, 11vw, 58px); letter-spacing: -2.5px; }\n      .hero-copy { font-size: 15px; }\n      .hero-art { min-height: 330px; }\n      .art-backdrop { height: 295px; }\n      .illustration { width: min(100%, 420px); }\n      .float-card { right: 0; bottom: 8px; }\n\n      .proof-inner { grid-template-columns: 1fr 1fr; gap: 18px 10px; }\n      .proof-item { justify-content: flex-start; font-size: 12px; }\n\n      section.content-section { padding: 66px 0; }\n      .services-grid { grid-template-columns: 1fr 1fr; }\n      .service-card { min-height: 205px; padding: 20px; }\n\n      .emergency { padding-bottom: 66px; }\n      .emergency-panel { align-items: flex-start; flex-direction: column; padding: 25px; }\n      .emergency-copy { align-items: flex-start; }\n      .emergency h2 { font-size: 21px; }\n\n      .about-grid { grid-template-columns: 1fr; gap: 36px; }\n      .about-visual { min-height: 300px; }\n      .about-copy { order: -1; }\n\n      .reviews-grid { grid-template-columns: 1fr; }\n      .review-card { padding: 22px; }\n\n      .areas-inner { align-items: flex-start; flex-direction: column; padding: 24px; }\n      .area-tags { justify-content: flex-start; }\n\n      .contact-grid { grid-template-columns: 1fr; gap: 28px; }\n      .contact-section { padding: 62px 0; }\n      .footer-inner { align-items: flex-start; flex-direction: column; }\n    }\n\n    @media (max-width: 440px) {\n      .container { width: calc(100% - 30px); }\n      .nav > .button { padding-inline: 11px; }\n      .hero-actions { align-items: stretch; flex-direction: column; }\n      .hero-actions .button { width: 100%; }\n      .trust-line { gap: 11px 14px; }\n      .hero-art { min-height: 280px; }\n      .illustration-top { padding: 13px 15px 9px; }\n      .services-grid { grid-template-columns: 1fr; }\n      .service-card { min-height: auto; }\n      .about-points { grid-template-columns: 1fr; }\n      .emergency-copy { gap: 13px; }\n      .emergency-icon { width: 45px; height: 45px; }\n      .emergency .button { width: 100%; }\n      .footer-links { gap: 14px; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      html { scroll-behavior: auto; }\n      *, *::before, *::after {\n        transition-duration: .01ms !important;\n        animation-duration: .01ms !important;\n      }\n    }\n  </style>\n</head>\n<body>\n  <a class=\"skip-link\" href=\"#main\">Skip to content</a>\n\n  <div class=\"topbar\">\n    <div class=\"container topbar-inner\">\n      <span class=\"topbar-note\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\">\n          <path d=\"M12 21s7-4.5 7-11a7 7 0 1 0-14 0c0 6.5 7 11 7 11Z\"/><circle cx=\"12\" cy=\"10\" r=\"2.3\"/>\n        </svg>\n        Proudly serving Leeds and nearby communities\n      </span>\n      <a class=\"topbar-link\" href=\"tel:+441135550184\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\">\n          <path d=\"M5 4h4l2 5-2.5 1.8a15 15 0 0 0 4.7 4.7L15 13l5 2v4a1 1 0 0 1-1 1C10 20 4 14 4 5a1 1 0 0 1 1-1Z\"/>\n        </svg>\n        Need a plumber? Call 0113 555 0184\n      </a>\n    </div>\n  </div>\n\n  <header>\n    <nav class=\"container nav\" aria-label=\"Main navigation\">\n      <a class=\"brand\" href=\"#\" aria-label=\"North and Sons Plumbing home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 32 32\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <path d=\"M7 7v9a5 5 0 0 0 5 5h8a5 5 0 0 0 5-5v-3\"/>\n            <path d=\"M4 7h6M4 4v6M22 7h6M25 4v6\"/>\n            <path d=\"M20 23c0 2.2 1.6 4 3.5 4s3.5-1.8 3.5-4c0-1.7-3.5-5.5-3.5-5.5S20 21.3 20 23Z\"/>\n          </svg>\n        </span>\n        <span>\n          <span class=\"brand-name\">North &amp; Sons</span>\n          <span class=\"brand-sub\">Plumbing \u00b7 Leeds</span>\n        </span>\n      </a>\n\n      <div class=\"nav-links\">\n        <a href=\"#services\">Services</a>\n        <a href=\"#about\">About us</a>\n        <a href=\"#reviews\">Reviews</a>\n        <a href=\"#areas\">Areas we cover</a>\n      </div>\n\n      <a class=\"button\" href=\"#contact\">\n        Get a free quote\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\">\n          <path d=\"M5 12h14M13 6l6 6-6 6\"/>\n        </svg>\n      </a>\n    </nav>\n  </header>\n\n  <main id=\"main\">\n    <section class=\"hero\">\n      <div class=\"container hero-grid\">\n        <div>\n          <p class=\"eyebrow\">Your local family plumbers</p>\n          <h1>Good people.<br><span>Great plumbing.</span></h1>\n          <p class=\"hero-copy\">\n            From a dripping tap to a full bathroom refresh, we bring honest advice,\n            tidy workmanship and a friendly face to homes across Leeds.\n          </p>\n          <div class=\"hero-actions\">\n            <a class=\"button\" href=\"tel:+441135550184\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\">\n                <path d=\"M5 4h4l2 5-2.5 1.8a15 15 0 0 0 4.7 4.7L15 13l5 2v4a1 1 0 0 1-1 1C10 20 4 14 4 5a1 1 0 0 1 1-1Z\"/>\n              </svg>\n              Call 0113 555 0184\n            </a>\n            <a class=\"button button-light\" href=\"#services\">Explore our services</a>\n          </div>\n          <div class=\"trust-line\" aria-label=\"Our promises\">\n            <span><i class=\"check\" aria-hidden=\"true\">\u2713</i> Fully insured</span>\n            <span><i class=\"check\" aria-hidden=\"true\">\u2713</i> Clear, upfront quotes</span>\n            <span><i class=\"check\" aria-hidden=\"true\">\u2713</i> Work guaranteed</span>\n          </div>\n        </div>\n\n        <div class=\"hero-art\" aria-label=\"Illustration of a friendly plumber fixing a sink\">\n          <div class=\"art-backdrop\"></div>\n          <div class=\"illustration\">\n            <div class=\"illustration-top\">\n              <span>A friendly face on your doorstep</span>\n              <span class=\"live-dot\">Leeds local</span>\n            </div>\n            <svg viewBox=\"0 0 520 340\" role=\"img\" aria-hidden=\"true\">\n              <rect width=\"520\" height=\"340\" fill=\"#F8FBF8\"/>\n              <circle cx=\"410\" cy=\"69\" r=\"32\" fill=\"#E8F4EF\"/>\n              <circle cx=\"77\" cy=\"270\" r=\"47\" fill=\"#EEF5F0\"/>\n              <path d=\"M0 282c78-25 147-22 224-6s168 18 296-7v71H0v-58Z\" fill=\"#DCEBE3\"/>\n              <path d=\"M142 123h245v142H142z\" fill=\"#fff\" stroke=\"#DCE6E0\" stroke-width=\"3\"/>\n              <path d=\"M172 163h185v17H172z\" rx=\"8\" fill=\"#E9F1ED\"/>\n              <path d=\"M167 181h198l-17 33H185l-18-33Z\" fill=\"#B9D8CD\"/>\n              <path d=\"M186 214h162v44H186z\" fill=\"#F6F8F5\"/>\n              <path d=\"M238 151v-18c0-12 8-20 19-20h20\" fill=\"none\" stroke=\"#137D78\" stroke-width=\"9\" stroke-linecap=\"round\"/>\n              <path d=\"M274 113v15\" fill=\"none\" stroke=\"#137D78\" stroke-width=\"9\" stroke-linecap=\"round\"/>\n              <path d=\"M252 224h36v34h-36z\" fill=\"#E9F1ED\"/>\n              <path d=\"M260 224v34M280 224v34\" stroke=\"#D3DFD9\" stroke-width=\"2\"/>\n              <!-- plumber -->\n              <path d=\"M65 280c4-42 18-68 53-74 35 6 51 32 54 74H65Z\" fill=\"#137D78\"/>\n              <path d=\"M90 208c0-28 11-46 29-46 19 0 30 18 30 46l-14 20h-31l-14-20Z\" fill=\"#F1B98E\"/>\n              <path d=\"M85 178c4-24 19-37 37-37s33 13 37 37l-14-7-10-13-10 10-19 2-11 11-10-3Z\" fill=\"#102C3A\"/>\n              <path d=\"M101 190c5 3 9 3 14 0M127 190c5 3 9 3 14 0\" fill=\"none\" stroke=\"#704E40\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n              <path d=\"M111 205c7 6 15 6 22 0\" fill=\"none\" stroke=\"#A95749\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n              <path d=\"m91 221 28 24 30-24 17 59H75l16-59Z\" fill=\"#fff\"/>\n              <path d=\"m119 245 10 35h-20l10-35Z\" fill=\"#F2A65A\"/>\n              <path d=\"M77 260 51 278M165 259l24-19\" stroke=\"#F1B98E\" stroke-width=\"11\" stroke-linecap=\"round\"/>\n              <path d=\"m182 232 13-11 11 12-12 14-12-15Z\" fill=\"#F2A65A\"/>\n              <path d=\"M201 232c5 0 8 4 8 8v12\" fill=\"none\" stroke=\"#137D78\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n              <path d=\"M209 252v18\" stroke=\"#137D78\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n              <circle cx=\"209\" cy=\"275\" r=\"5\" fill=\"#137D78\"/>\n              <!-- small sparkle -->\n              <path d=\"m425 170 5 13 13 5-13 5-5 13-5-13-13-5 13-5 5-13Z\" fill=\"#F2A65A\"/>\n              <path d=\"m74 91 4 10 10 4-10 4-4 10-4-10-10-4 10-4 4-10Z\" fill=\"#F2A65A\" opacity=\".8\"/>\n            </svg>\n          </div>\n          <div class=\"float-card\">\n            <span class=\"float-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                <path d=\"M12 3 14.5 8.5 20.5 9l-4.5 4 1.3 6-5.3-3-5.3 3 1.3-6-4.5-4 6-.5L12 3Z\"/>\n              </svg>\n            </span>\n            <span><strong>Small job or big job</strong><small>We\u2019re happy to help</small></span>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <div class=\"proof\" aria-label=\"Why choose us\">\n      <div class=\"container proof-inner\">\n        <div class=\"proof-item\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\">\n            <path d=\"M12 3 19 6v5c0 5-3.4 8.4-7 10-3.6-1.6-7-5-7-10V6l7-3Z\"/><path d=\"m9 12 2 2 4-4\"/>\n          </svg>\n          Fully insured\n        </div>\n        <div class=\"proof-item\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\">\n            <path d=\"M4 7h16M4 12h16M4 17h10\"/><circle cx=\"18\" cy=\"17\" r=\"3\"/>\n          </svg>\n          No-nonsense pricing\n        </div>\n        <div class=\"proof-item\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\">\n            <path d=\"M12 3v3M5.6 5.6l2.1 2.1M3 12h3m-.4 6.4 2.1-2.1M12 21v-3m6.4.4-2.1-2.1M21 12h-3\"/><circle cx=\"12\" cy=\"12\" r=\"5\"/>\n          </svg>\n          Local, family-run team\n        </div>\n        <div class=\"proof-item\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\">\n            <path d=\"M3 12a9 9 0 1 0 2.6-6.4L3 8\"/><path d=\"M3 3v5h5M12 7v5l3 2\"/>\n          </svg>\n          We turn up when we say\n        </div>\n      </div>\n    </div>\n\n    <section class=\"content-section\" id=\"services\">\n      <div class=\"container\">\n        <div class=\"section-heading\">\n          <p class=\"eyebrow\">How we can help</p>\n          <h2>Everything plumbing, done properly.</h2>\n          <p>Practical help for the everyday jobs and the bigger plans. Just tell us what you need.</p>\n        </div>\n\n        <div class=\"services-grid\">\n          <article class=\"service-card\">\n            <span class=\"service-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                <path d=\"M4 9h16M6 9v10h12V9M9 5v4m6-4v4M9 19v2m6-2v2\"/>\n                <path d=\"M9 13h6\"/>\n              </svg>\n            </span>\n            <h3>Bathrooms &amp; wet rooms</h3>\n            <p>From a small refresh to a whole new bathroom, we\u2019ll help make your space work beautifully.</p>\n          </article>\n\n          <article class=\"service-card\">\n            <span class=\"service-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                <path d=\"M4 12h16v8H4zM6 12V8a6 6 0 0 1 12 0v4M8 16h.01M12 16h.01M16 16h.01\"/>\n              </svg>\n            </span>\n            <h3>Boilers &amp; heating</h3>\n            <p>Installation, repairs and servicing to help keep your home warm and your system running well.</p>\n          </article>\n\n          <article class=\"service-card\">\n            <span class=\"service-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                <path d=\"M12 3s6 7 6 12a6 6 0 0 1-12 0c0-5 6-12 6-12Z\"/><path d=\"M9 16a3 3 0 0 0 3 3\"/>\n              </svg>\n            </span>\n            <h3>Leaks &amp; repairs</h3>\n            <p>Leaking pipe, faulty tap or a toilet that won\u2019t behave? We\u2019ll find the issue and put it right.</p>\n          </article>\n\n          <article class=\"service-card\">\n            <span class=\"service-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                <path d=\"M5 20h14M7 20V8h10v12M9 8V5h6v3M10 12h4M10 16h4\"/>\n              </svg>\n            </span>\n            <h3>Kitchen plumbing</h3>\n            <p>Sink, tap and appliance connections fitted with care, so everything is ready for everyday life.</p>\n          </article>\n\n          <article class=\"service-card\">\n            <span class=\"service-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                <path d=\"M4 13h16M6 13V7h12v6M8 13v6m8-6v6M8 7V4h8v3\"/>\n              </svg>\n            </span>\n            <h3>Radiators &amp; pipework</h3>\n            <p>New radiators, moved pipework and those little improvements that make a room feel right.</p>\n          </article>\n\n          <article class=\"service-card\">\n            <span class=\"service-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                <path d=\"M12 3v18M5 7h14M7 7v4a5 5 0 0 0 10 0V7\"/><path d=\"M8 17h8\"/>\n              </svg>\n            </span>\n            <h3>Emergency call-outs</h3>\n            <p>When something goes wrong, give us a ring. We\u2019ll talk you through the next steps and arrange help.</p>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"emergency\" aria-label=\"Emergency plumbing help\">\n      <div class=\"container\">\n        <div class=\"emergency-panel\">\n          <div class=\"emergency-copy\">\n            <span class=\"emergency-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                <path d=\"M12 3 2.8 19h18.4L12 3Z\"/><path d=\"M12 9v4m0 3h.01\"/>\n              </svg>\n            </span>\n            <div>\n              <h2>Plumbing problem? Let\u2019s get it sorted.</h2>\n              <p>Call us and speak to a real person about what\u2019s going on.</p>\n            </div>\n          </div>\n          <a class=\"button\" href=\"tel:+441135550184\">\n            Call 0113 555 0184\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\">\n              <path d=\"M5 4h4l2 5-2.5 1.8a15 15 0 0 0 4.7 4.7L15 13l5 2v4a1 1 0 0 1-1 1C10 20 4 14 4 5a1 1 0 0 1 1-1Z\"/>\n            </svg>\n          </a>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"content-section about-section\" id=\"about\">\n      <div class=\"container about-grid\">\n        <div class=\"about-visual\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 300 280\" fill=\"none\">\n            <path d=\"M51 132 150 49l99 83v111H51V132Z\" fill=\"#fff\" stroke=\"#102C3A\" stroke-width=\"7\" stroke-linejoin=\"round\"/>\n            <path d=\"M30 137 150 36l120 101\" stroke=\"#137D78\" stroke-width=\"13\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            <path d=\"M126 243v-66a24 24 0 0 1 48 0v66\" fill=\"#DCEBE3\" stroke=\"#102C3A\" stroke-width=\"6\"/>\n            <path d=\"M77 153h44v42H77z\" fill=\"#E8F4EF\" stroke=\"#102C3A\" stroke-width=\"5\"/>\n            <path d=\"M99 153v42m-22-21h44\" stroke=\"#102C3A\" stroke-width=\"4\"/>\n            <path d=\"M213 153h30v42h-30z\" fill=\"#E8F4EF\" stroke=\"#102C3A\" stroke-width=\"5\"/>\n            <path d=\"M174 120h22v28h-22z\" fill=\"#F2A65A\"/>\n            <path d=\"M180 120V99h10v21\" stroke=\"#102C3A\" stroke-width=\"5\" stroke-linejoin=\"round\"/>\n            <path d=\"M179 133h12\" stroke=\"#fff\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n          </svg>\n          <span class=\"about-note\">A proper local team, right here in Leeds</span>\n        </div>\n\n        <div class=\"about-copy\">\n          <p class=\"eyebrow\">A little about us</p>\n          <h2>Family values. Work you can rely on.</h2>\n          <p>\n            We\u2019re a family-run plumbing team who believe good service starts with listening.\n            We\u2019ll explain what needs doing, give you a clear quote and treat your home with care\n            from the first hello to the final tidy-up.\n          </p>\n          <ul class=\"about-points\">\n            <li><i class=\"check\" aria-hidden=\"true\">\u2713</i> Friendly, familiar faces</li>\n            <li><i class=\"check\" aria-hidden=\"true\">\u2713</i> Respect for your home</li>\n            <li><i class=\"check\" aria-hidden=\"true\">\u2713</i> Straightforward advice</li>\n            <li><i class=\"check\" aria-hidden=\"true\">\u2713</i> Quality parts and work</li>\n          </ul>\n          <a class=\"button\" href=\"#contact\">\n            Get to know us\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\">\n              <path d=\"M5 12h14M13 6l6 6-6 6\"/>\n            </svg>\n          </a>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"content-section reviews-section\" id=\"reviews\">\n      <div class=\"container\">\n        <div class=\"section-heading\">\n          <p class=\"eyebrow\">Kind words from customers</p>\n          <h2>Good work gets talked about.</h2>\n          <p>We\u2019re proud when local customers recommend us to their friends and neighbours.</p>\n        </div>\n\n        <div class=\"reviews-grid\">\n          <article class=\"review-card\">\n            <div class=\"stars\" aria-label=\"5 out of 5 stars\">\u2605\u2605\u2605\u2605\u2605</div>\n            <blockquote>\u201cLovely people, great communication and a really tidy job. Everything was explained before they started.\u201d</blockquote>\n            <div class=\"reviewer\">\n              <span class=\"avatar\" aria-hidden=\"true\">JM</span>\n              <span><strong>Jo M.</strong><small>Headingley, Leeds</small></span>\n            </div>\n          </article>\n\n          <article class=\"review-card\">\n            <div class=\"stars\" aria-label=\"5 out of 5 stars\">\u2605\u2605\u2605\u2605\u2605</div>\n            <blockquote>\u201cThey sorted a leak quickly and were honest about what did\u2014and didn\u2019t\u2014need replacing. Would happily call again.\u201d</blockquote>\n            <div class=\"reviewer\">\n              <span class=\"avatar\" aria-hidden=\"true\">RK</span>\n              <span><strong>Ravi K.</strong><small>Chapel Allerton, Leeds</small></span>\n            </div>\n          </article>\n\n          <article class=\"review-card\">\n            <div class=\"stars\" aria-label=\"5 out of 5 stars\">\u2605\u2605\u2605\u2605\u2605</div>\n            <blockquote>\u201cOur new bathroom looks brilliant. The team were considerate, on time and left everything spotless.\u201d</blockquote>\n            <div class=\"reviewer\">\n              <span class=\"avatar\" aria-hidden=\"true\">ST</span>\n              <span><strong>Sarah T.</strong><small>Roundhay, Leeds</small></span>\n            </div>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"content-section areas-section\" id=\"areas\">\n      <div class=\"container\">\n        <div class=\"areas-inner\">\n          <div>\n            <h2>Local knowledge. Leeds-wide service.</h2>\n            <p>Based in Leeds and happy to travel to nearby areas.</p>\n          </div>\n          <div class=\"area-tags\" aria-label=\"Areas we cover\">\n            <span>Headingley</span>\n            <span>Roundhay</span>\n            <span>Chapel Allerton</span>\n            <span>Horsforth</span>\n            <span>Morley</span>\n            <span>Leeds city centre</span>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"contact-section\" id=\"contact\">\n    