{"brief": "B6", "model": "openai/gpt-6-luna", "i": 2, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <meta name=\"theme-color\" content=\"#f4f0e7\" />\n  <title>Sidewalk \u2014 Skate Shop & Lessons</title>\n  <style>\n    :root {\n      --paper: #f4f0e7;\n      --ink: #1d211c;\n      --muted: #686b62;\n      --orange: #f15a32;\n      --lime: #d9ed75;\n      --line: rgba(29, 33, 28, .18);\n      --display: Impact, Haettenschweiler, \"Arial Narrow Bold\", sans-serif;\n      --body: \"Arial\", \"Helvetica Neue\", sans-serif;\n    }\n\n    * { box-sizing: border-box; }\n    html { scroll-behavior: smooth; }\n    body {\n      margin: 0;\n      background: var(--paper);\n      color: var(--ink);\n      font-family: var(--body);\n      -webkit-font-smoothing: antialiased;\n    }\n    a { color: inherit; text-decoration: none; }\n    button, a { -webkit-tap-highlight-color: transparent; }\n    .wrap { width: min(1180px, calc(100% - 48px)); margin: 0 auto; }\n\n    .announcement {\n      background: var(--ink);\n      color: var(--paper);\n      text-align: center;\n      padding: 10px 16px;\n      font-size: 11px;\n      font-weight: 700;\n      letter-spacing: .12em;\n      text-transform: uppercase;\n    }\n    .announcement span { color: var(--lime); }\n\n    header {\n      border-bottom: 1px solid var(--line);\n      position: relative;\n      z-index: 2;\n    }\n    .nav {\n      min-height: 76px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 28px;\n    }\n    .brand {\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      font-weight: 900;\n      font-size: 20px;\n      letter-spacing: -.06em;\n      text-transform: uppercase;\n      white-space: nowrap;\n    }\n    .brand-mark {\n      width: 31px;\n      height: 31px;\n      display: grid;\n      place-items: center;\n      background: var(--orange);\n      border-radius: 50%;\n      transform: rotate(-12deg);\n    }\n    .brand-mark svg { width: 20px; }\n    .nav-links {\n      display: flex;\n      gap: 32px;\n      align-items: center;\n      color: #41443e;\n      font-size: 13px;\n      font-weight: 700;\n    }\n    .nav-links a:hover { color: var(--orange); }\n    .nav-cta, .button {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: 10px;\n      border: 0;\n      background: var(--ink);\n      color: var(--paper);\n      padding: 14px 19px;\n      font: 700 12px var(--body);\n      letter-spacing: .08em;\n      text-transform: uppercase;\n      transition: transform .2s, background .2s;\n    }\n    .nav-cta:hover, .button:hover { background: var(--orange); transform: translateY(-2px); }\n    .button.light { background: var(--paper); color: var(--ink); }\n    .button.light:hover { background: var(--lime); }\n    .arrow { font-size: 17px; line-height: 0; }\n\n    .hero { padding: 34px 0 64px; }\n    .hero-grid {\n      min-height: 570px;\n      display: grid;\n      grid-template-columns: 1fr 1.02fr;\n      background: var(--orange);\n      overflow: hidden;\n      position: relative;\n    }\n    .hero-copy {\n      padding: clamp(34px, 6vw, 78px);\n      align-self: center;\n      position: relative;\n      z-index: 1;\n    }\n    .eyebrow {\n      display: inline-flex;\n      align-items: center;\n      gap: 9px;\n      font-size: 11px;\n      font-weight: 800;\n      letter-spacing: .15em;\n      text-transform: uppercase;\n    }\n    .eyebrow::before {\n      content: \"\";\n      width: 23px;\n      height: 2px;\n      background: currentColor;\n    }\n    h1, h2, h3, p { margin-top: 0; }\n    .hero h1 {\n      max-width: 540px;\n      margin: 19px 0 20px;\n      font: 400 clamp(65px, 8.5vw, 116px)/.82 var(--display);\n      letter-spacing: -.045em;\n      text-transform: uppercase;\n    }\n    .hero h1 span {\n      display: block;\n      color: var(--paper);\n      -webkit-text-stroke: 1px var(--paper);\n      text-shadow: 4px 4px 0 rgba(29, 33, 28, .12);\n    }\n    .hero-copy > p {\n      max-width: 360px;\n      font-size: 15px;\n      line-height: 1.65;\n      color: rgba(29, 33, 28, .8);\n      margin-bottom: 26px;\n    }\n    .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; }\n    .text-link {\n      font-size: 12px;\n      font-weight: 800;\n      letter-spacing: .08em;\n      text-transform: uppercase;\n      padding: 12px 4px;\n      border-bottom: 1px solid currentColor;\n    }\n    .hero-art {\n      min-height: 570px;\n      display: grid;\n      place-items: center;\n      position: relative;\n      background: #d9ed75;\n      overflow: hidden;\n    }\n    .hero-art::before {\n      content: \"\";\n      width: 76%;\n      aspect-ratio: 1;\n      position: absolute;\n      border-radius: 50%;\n      background: var(--paper);\n      top: 50%;\n      left: 50%;\n      transform: translate(-50%, -50%);\n    }\n    .hero-art::after {\n      content: \"RIDE YOUR OWN LINE\";\n      position: absolute;\n      right: 18px;\n      top: 50%;\n      writing-mode: vertical-rl;\n      font: 400 11px var(--body);\n      letter-spacing: .2em;\n      transform: translateY(-50%);\n    }\n    .hero-art svg {\n      width: min(100%, 570px);\n      position: relative;\n      z-index: 1;\n      filter: drop-shadow(8px 13px 0 rgba(29, 33, 28, .12));\n    }\n    .art-sticker {\n      position: absolute;\n      z-index: 2;\n      left: 10%;\n      bottom: 11%;\n      width: 93px;\n      height: 93px;\n      border-radius: 50%;\n      background: var(--orange);\n      color: var(--paper);\n      display: grid;\n      place-items: center;\n      text-align: center;\n      font: 400 18px/.9 var(--display);\n      transform: rotate(-13deg);\n      border: 2px solid var(--ink);\n    }\n\n    .ticker {\n      background: var(--ink);\n      color: var(--paper);\n      overflow: hidden;\n      white-space: nowrap;\n      padding: 14px 0;\n    }\n    .ticker-track {\n      display: flex;\n      width: max-content;\n      gap: 27px;\n      align-items: center;\n      font: 400 18px var(--display);\n      letter-spacing: .08em;\n      text-transform: uppercase;\n    }\n    .ticker-track span:nth-child(even) { color: var(--lime); }\n    .ticker-track b { color: var(--orange); font-size: 20px; }\n\n    .section { padding: 88px 0; }\n    .section-heading {\n      display: flex;\n      align-items: end;\n      justify-content: space-between;\n      gap: 30px;\n      margin-bottom: 35px;\n    }\n    .section-heading h2 {\n      font: 400 clamp(44px, 6vw, 72px)/.9 var(--display);\n      letter-spacing: -.025em;\n      text-transform: uppercase;\n      margin: 13px 0 0;\n    }\n    .section-heading p {\n      max-width: 330px;\n      color: var(--muted);\n      font-size: 14px;\n      line-height: 1.6;\n      margin: 0 0 3px;\n    }\n    .shop-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 16px;\n    }\n    .shop-card {\n      position: relative;\n      min-height: 380px;\n      padding: 24px;\n      overflow: hidden;\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      border: 1px solid var(--line);\n      background: #e6e2d9;\n    }\n    .shop-card:nth-child(2) { background: #d9ed75; }\n    .shop-card:nth-child(3) { background: #f15a32; }\n    .card-top {\n      display: flex;\n      justify-content: space-between;\n      align-items: flex-start;\n      position: relative;\n      z-index: 1;\n    }\n    .card-number {\n      font: 400 13px var(--display);\n      letter-spacing: .1em;\n    }\n    .card-icon {\n      width: 36px;\n      height: 36px;\n      display: grid;\n      place-items: center;\n      border: 1px solid currentColor;\n      border-radius: 50%;\n      font-size: 18px;\n    }\n    .shop-card h3 {\n      position: relative;\n      z-index: 1;\n      margin: 0;\n      font: 400 36px/.9 var(--display);\n      text-transform: uppercase;\n    }\n    .shop-card h3 small {\n      display: block;\n      font: 700 11px var(--body);\n      letter-spacing: .12em;\n      margin-top: 13px;\n    }\n    .deck-art {\n      width: 110px;\n      height: 250px;\n      border-radius: 55px 55px 38px 38px;\n      position: absolute;\n      top: 48px;\n      left: 50%;\n      transform: translateX(-50%) rotate(31deg);\n      background: var(--orange);\n      border: 4px solid var(--ink);\n      box-shadow: inset 0 0 0 8px rgba(244,240,231,.22);\n    }\n    .deck-art::before, .deck-art::after {\n      content: \"\";\n      position: absolute;\n      width: 29px;\n      height: 29px;\n      border-radius: 50%;\n      background: var(--ink);\n      left: 50%;\n      transform: translateX(-50%);\n      box-shadow: -27px 0 0 var(--ink), 27px 0 0 var(--ink);\n    }\n    .deck-art::before { top: 40px; }\n    .deck-art::after { bottom: 40px; }\n    .deck-art .deck-stripe {\n      position: absolute;\n      height: 70%;\n      width: 17px;\n      background: var(--lime);\n      top: 15%;\n      left: 50%;\n      transform: translateX(-50%);\n      border-radius: 9px;\n    }\n    .shoe-art {\n      position: absolute;\n      width: 190px;\n      height: 94px;\n      border: 4px solid var(--ink);\n      border-radius: 60% 36% 35% 25%;\n      background: var(--paper);\n      left: 50%;\n      top: 43%;\n      transform: translate(-50%, -50%) rotate(-22deg);\n      box-shadow: 0 18px 0 -8px var(--orange);\n    }\n    .shoe-art::before {\n      content: \"\";\n      position: absolute;\n      width: 64px;\n      height: 27px;\n      border: 3px solid var(--ink);\n      border-radius: 50%;\n      top: 8px;\n      left: 57px;\n      transform: rotate(-10deg);\n    }\n    .shoe-art::after {\n      content: \"\";\n      position: absolute;\n      width: 100%;\n      height: 14px;\n      bottom: -5px;\n      left: -2px;\n      background: var(--lime);\n      border: 3px solid var(--ink);\n      border-radius: 0 0 30px 20px;\n    }\n    .lesson-art {\n      position: absolute;\n      width: 210px;\n      height: 210px;\n      border-radius: 50%;\n      background: var(--lime);\n      border: 3px solid var(--ink);\n      left: 50%;\n      top: 44%;\n      transform: translate(-50%, -50%);\n    }\n    .lesson-art::before {\n      content: \"OLLIE!\";\n      position: absolute;\n      inset: 0;\n      display: grid;\n      place-items: center;\n      font: 400 40px var(--display);\n      transform: rotate(-14deg);\n    }\n    .shop-card:nth-child(3) .card-icon { color: var(--paper); }\n    .shop-card:nth-child(3) .lesson-art { background: var(--paper); }\n\n    .lessons {\n      background: var(--ink);\n      color: var(--paper);\n      padding: 88px 0;\n    }\n    .lessons .section-heading p { color: #b8bbb2; }\n    .lessons .eyebrow { color: var(--lime); }\n    .lesson-layout {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 60px;\n      align-items: center;\n    }\n    .lesson-copy h2 {\n      font: 400 clamp(50px, 7vw, 88px)/.86 var(--display);\n      text-transform: uppercase;\n      letter-spacing: -.03em;\n      margin: 16px 0 23px;\n    }\n    .lesson-copy h2 span { color: var(--lime); }\n    .lesson-copy > p {\n      max-width: 440px;\n      color: #b8bbb2;\n      font-size: 15px;\n      line-height: 1.7;\n      margin-bottom: 28px;\n    }\n    .lesson-points {\n      list-style: none;\n      padding: 0;\n      margin: 0 0 30px;\n      border-top: 1px solid rgba(244,240,231,.2);\n    }\n    .lesson-points li {\n      padding: 14px 0;\n      border-bottom: 1px solid rgba(244,240,231,.2);\n      display: flex;\n      justify-content: space-between;\n      gap: 15px;\n      font-size: 13px;\n      font-weight: 700;\n    }\n    .lesson-points span { color: var(--lime); }\n    .lesson-visual {\n      background: var(--orange);\n      min-height: 440px;\n      position: relative;\n      display: grid;\n      place-items: center;\n      overflow: hidden;\n    }\n    .lesson-visual::before {\n      content: \"\";\n      position: absolute;\n      width: 340px;\n      height: 340px;\n      border-radius: 50%;\n      border: 1px solid rgba(29,33,28,.25);\n      box-shadow: 0 0 0 28px rgba(29,33,28,.05), 0 0 0 56px rgba(29,33,28,.04);\n    }\n    .lesson-visual svg { width: min(90%, 390px); position: relative; z-index: 1; }\n    .lesson-tag {\n      position: absolute;\n      z-index: 2;\n      right: 20px;\n      top: 20px;\n      background: var(--paper);\n      color: var(--ink);\n      padding: 10px 13px;\n      font-size: 10px;\n      font-weight: 800;\n      letter-spacing: .1em;\n      text-transform: uppercase;\n      transform: rotate(4deg);\n    }\n\n    .quote-section { padding: 78px 0; text-align: center; }\n    .quote-mark { color: var(--orange); font: 70px/.5 Georgia, serif; }\n    blockquote {\n      max-width: 800px;\n      margin: 20px auto 20px;\n      font: 400 clamp(27px, 4.3vw, 48px)/1.08 var(--display);\n      text-transform: uppercase;\n    }\n    .quote-credit {\n      color: var(--muted);\n      font-size: 11px;\n      font-weight: 700;\n      letter-spacing: .13em;\n      text-transform: uppercase;\n    }\n\n    .visit {\n      background: var(--lime);\n      padding: 66px 0;\n    }\n    .visit-inner {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 30px;\n    }\n    .visit h2 {\n      font: 400 clamp(46px, 6vw, 74px)/.88 var(--display);\n      text-transform: uppercase;\n      margin: 13px 0 12px;\n    }\n    .visit p { margin: 0; font-size: 14px; color: #454a38; }\n    .visit .button { flex-shrink: 0; }\n\n    footer { background: var(--ink); color: var(--paper); padding: 32px 0; }\n    .footer-inner {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      gap: 24px;\n    }\n    .footer-note { color: #aeb1a8; font-size: 11px; }\n    .socials { display: flex; gap: 20px; font-size: 11px; font-weight: 700; text-transform: uppercase; }\n    .socials a:hover { color: var(--lime); }\n\n    @media (max-width: 800px) {\n      .wrap { width: min(100% - 32px, 620px); }\n      .nav { min-height: 66px; }\n      .nav-links { display: none; }\n      .hero { padding: 20px 0 42px; }\n      .hero-grid { grid-template-columns: 1fr; }\n      .hero-copy { padding: 42px 30px 40px; }\n      .hero h1 { font-size: clamp(68px, 15vw, 105px); }\n      .hero-art { min-height: 390px; }\n      .hero-art svg { max-width: 430px; }\n      .shop-grid { grid-template-columns: 1fr; }\n      .shop-card { min-height: 340px; }\n      .section { padding: 66px 0; }\n      .section-heading { display: block; }\n      .section-heading p { margin-top: 18px; }\n      .lesson-layout { grid-template-columns: 1fr; gap: 36px; }\n      .lesson-visual { min-height: 350px; }\n      .lessons { padding: 66px 0; }\n    }\n    @media (max-width: 520px) {\n      .announcement { font-size: 9px; }\n      .nav-cta { padding: 12px 13px; font-size: 10px; }\n      .brand { font-size: 18px; }\n      .hero-copy { padding: 37px 24px; }\n      .hero-copy > p { font-size: 14px; }\n      .hero-art { min-height: 320px; }\n      .art-sticker { width: 74px; height: 74px; font-size: 15px; }\n      .visit-inner { align-items: flex-start; flex-direction: column; }\n      .footer-inner { flex-direction: column; align-items: flex-start; }\n      .socials { flex-wrap: wrap; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"announcement\">Free shipping on orders over $100 <span>\u2014 roll through</span></div>\n\n  <header>\n    <div class=\"wrap nav\">\n      <a class=\"brand\" href=\"#\" aria-label=\"Sidewalk home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M4 15.5 19 8.5M6 18l14-6.5\" stroke=\"#f4f0e7\" stroke-width=\"2.6\" stroke-linecap=\"round\"/>\n            <circle cx=\"7\" cy=\"19\" r=\"1.5\" fill=\"#f4f0e7\"/>\n            <circle cx=\"18\" cy=\"10.5\" r=\"1.5\" fill=\"#f4f0e7\"/>\n          </svg>\n        </span>\n        Sidewalk\n      </a>\n      <nav class=\"nav-links\" aria-label=\"Main navigation\">\n        <a href=\"#shop\">Shop</a>\n        <a href=\"#lessons\">Lessons</a>\n        <a href=\"#story\">Our story</a>\n        <a href=\"#visit\">Find us</a>\n      </nav>\n      <a class=\"nav-cta\" href=\"#lessons\">Book a lesson <span class=\"arrow\">\u2197</span></a>\n    </div>\n  </header>\n\n  <main>\n    <section class=\"hero\">\n      <div class=\"wrap hero-grid\">\n        <div class=\"hero-copy\">\n          <div class=\"eyebrow\">Your neighborhood skate shop</div>\n          <h1>Good days.<span>Great rides.</span></h1>\n          <p>Boards, bits, and the people who\u2019ll teach you what to do with them. Come find your next favorite thing on four wheels.</p>\n          <div class=\"hero-actions\">\n            <a class=\"button\" href=\"#shop\">Shop the goods <span class=\"arrow\">\u2197</span></a>\n            <a class=\"text-link\" href=\"#lessons\">Start skating</a>\n          </div>\n        </div>\n        <div class=\"hero-art\" aria-label=\"Illustration of a skateboarder in motion\">\n          <svg viewBox=\"0 0 560 530\" role=\"img\" aria-hidden=\"true\">\n            <!-- motion marks -->\n            <path d=\"M46 180h92M28 207h75M74 235h55M405 118h74M430 142h54\" stroke=\"#1d211c\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n            <path d=\"M117 428c53 21 101 31 165 29\" fill=\"none\" stroke=\"#1d211c\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-dasharray=\"2 12\"/>\n            <!-- skateboard deck -->\n            <g transform=\"rotate(-13 286 414)\">\n              <path d=\"M150 415c0-17 13-30 30-30h205c17 0 30 13 30 30s-13 30-30 30H180c-17 0-30-13-30-30Z\" fill=\"#f15a32\" stroke=\"#1d211c\" stroke-width=\"7\"/>\n              <path d=\"M197 399h171\" stroke=\"#f4f0e7\" stroke-width=\"8\" stroke-linecap=\"round\"/>\n              <path d=\"M213 413h140\" stroke=\"#1d211c\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n              <path d=\"M205 445v16m147-16v16\" stroke=\"#1d211c\" stroke-width=\"7\"/>\n              <circle cx=\"202\" cy=\"466\" r=\"13\" fill=\"#1d211c\"/>\n              <circle cx=\"359\" cy=\"466\" r=\"13\" fill=\"#1d211c\"/>\n            </g>\n            <!-- legs -->\n            <path d=\"M270 322c-25 22-47 47-70 73l-34 17\" fill=\"none\" stroke=\"#1d211c\" stroke-width=\"22\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            <path d=\"M322 318c27 20 50 41 72 65l35 11\" fill=\"none\" stroke=\"#1d211c\" stroke-width=\"22\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            <!-- socks / shoes -->\n            <path d=\"m165 402-26 12c-9 4-12 13-7 20 4 6 13 8 20 4l30-15Z\" fill=\"#f4f0e7\" stroke=\"#1d211c\" stroke-width=\"6\" stroke-linejoin=\"round\"/>\n            <path d=\"m423 388 27 7c10 3 14 11 11 19-3 8-11 11-20 9l-32-8Z\" fill=\"#f4f0e7\" stroke=\"#1d211c\" stroke-width=\"6\" stroke-linejoin=\"round\"/>\n            <!-- torso -->\n            <path d=\"m264 178 72 20-18 121-71-17Z\" fill=\"#f15a32\" stroke=\"#1d211c\" stroke-width=\"7\" stroke-linejoin=\"round\"/>\n            <path d=\"m273 204 50 14\" stroke=\"#f4f0e7\" stroke-width=\"8\" stroke-linecap=\"round\"/>\n            <path d=\"m256 286 65 18\" stroke=\"#1d211c\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n            <!-- arms -->\n            <path d=\"m267 194-67-42-48 20\" fill=\"none\" stroke=\"#1d211c\" stroke-width=\"19\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            <path d=\"m324 204 60-58 48 9\" fill=\"none\" stroke=\"#1d211c\" stroke-width=\"19\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            <circle cx=\"149\" cy=\"172\" r=\"12\" fill=\"#f4f0e7\" stroke=\"#1d211c\" stroke-width=\"6\"/>\n            <circle cx=\"441\" cy=\"155\" r=\"12\" fill=\"#f4f0e7\" stroke=\"#1d211c\" stroke-width=\"6\"/>\n            <!-- neck and head -->\n            <path d=\"m281 166 3-23 34 4 1 29\" fill=\"#d99c72\" stroke=\"#1d211c\" stroke-width=\"6\" stroke-linejoin=\"round\"/>\n            <path d=\"M270 119c2-29 25-47 51-39 22 7 31 30 22 53l-9 24-55-13Z\" fill=\"#d99c72\" stroke=\"#1d211c\" stroke-width=\"7\" stroke-linejoin=\"round\"/>\n            <!-- helmet -->\n            <path d=\"M268 116c-2-29 18-51 48-51 26 0 43 16 45 39-26-8-58-5-93 12Z\" fill=\"#d9ed75\" stroke=\"#1d211c\" stroke-width=\"7\" stroke-linejoin=\"round\"/>\n            <path d=\"m282 104 62-7\" stroke=\"#1d211c\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n            <!-- little spark -->\n            <path d=\"m478 255 8 18 19 3-16 11 3 19-14-13-17 9 8-18-12-14 19 2Z\" fill=\"#f15a32\" stroke=\"#1d211c\" stroke-width=\"4\" stroke-linejoin=\"round\"/>\n          </svg>\n          <div class=\"art-sticker\">GOOD<br />VIBES<br />ONLY</div>\n        </div>\n      </div>\n    </section>\n\n    <div class=\"ticker\" aria-label=\"Skate shop, lessons, and good times\">\n      <div class=\"ticker-track\">\n        <span>Pick a board</span><b>\u2733</b><span>Find your people</span><b>\u2733</b><span>Learn a trick</span><b>\u2733</b><span>Repeat forever</span><b>\u2733</b>\n        <span>Pick a board</span><b>\u2733</b><span>Find your people</span><b>\u2733</b><span>Learn a trick</span><b>\u2733</b><span>Repeat forever</span><b>\u2733</b>\n      </div>\n    </div>\n\n    <section class=\"section\" id=\"shop\">\n      <div class=\"wrap\">\n        <div class=\"section-heading\">\n          <div>\n            <div class=\"eyebrow\">The good stuff</div>\n            <h2>Built for<br />the long ride.</h2>\n          </div>\n          <p>Whether you\u2019re setting up your first board or replacing the wheels you\u2019ve worn down to nothing, we\u2019ve got you.</p>\n        </div>\n        <div class=\"shop-grid\">\n          <a class=\"shop-card\" href=\"#visit\">\n            <div class=\"card-top\"><span class=\"card-number\">01 / DECKS</span><span class=\"card-icon\">\u2197</span></div>\n            <div class=\"deck-art\" aria-hidden=\"true\"><span class=\"deck-stripe\"></span></div>\n            <h3>Find your<br />new deck<small>Boards & complete setups</small></h3>\n          </a>\n          <a class=\"shop-card\" href=\"#visit\">\n            <div class=\"card-top\"><span class=\"card-number\">02 / FOOTWEAR</span><span class=\"card-icon\">\u2197</span></div>\n            <div class=\"shoe-art\" aria-hidden=\"true\"></div>\n            <h3>Grip &<br />go<small>Skate shoes and apparel</small></h3>\n          </a>\n          <a class=\"shop-card\" href=\"#lessons\">\n            <div class=\"card-top\"><span class=\"card-number\">03 / LESSONS</span><span class=\"card-icon\">\u2197</span></div>\n            <div class=\"lesson-art\" aria-hidden=\"true\"></div>\n            <h3>Learn the<br />ropes<small>Good coaching. No pressure.</small></h3>\n          </a>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"lessons\" id=\"lessons\">\n      <div class=\"wrap lesson-layout\">\n        <div class=\"lesson-copy\">\n          <div class=\"eyebrow\">First push to first trick</div>\n          <h2>Learn at<br /><span>your pace.</span></h2>\n          <p>New to skating? Getting back into it? Our friendly coaches make learning feel less like a lesson and more like a really good afternoon.</p>\n          <ul class=\"lesson-points\">\n            <li>Small groups, big encouragement <span>01</span></li>\n            <li>Boards and safety gear included <span>02</span></li>\n            <li>All ages, all skill levels <span>03</span></li>\n          </ul>\n          <a class=\"button light\" href=\"mailto:hello@sidewalkskate.example\">Book your first session <span class=\"arrow\">\u2197</span></a>\n        </div>\n        <div class=\"lesson-visual\">\n          <div class=\"lesson-tag\">Beginner friendly \u00b7 Always</div>\n          <svg viewBox=\"0 0 420 360\" role=\"img\" aria-label=\"A student practicing on a skateboard\">\n            <!-- ground -->\n            <path d=\"M40 294h340\" stroke=\"#1d211c\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n            <!-- board -->\n            <path d=\"M102 282c0-10 9-18 19-18h182c10 0 19 8 19 18s-9 18-19 18H121c-10 0-19-8-19-18Z\" fill=\"#d9ed75\" stroke=\"#1d211c\" stroke-width=\"5\"/>\n            <path d=\"M148 299v9m127-9v9\" stroke=\"#1d211c\" stroke-width=\"5\"/>\n            <circle cx=\"145\" cy=\"314\" r=\"9\" fill=\"#1d211c\"/>\n            <circle cx=\"278\" cy=\"314\" r=\"9\" fill=\"#1d211c\"/>\n            <!-- legs -->\n            <path d=\"m194 213-31 48-37 8m73-58 43 48 34 10\" fill=\"none\" stroke=\"#1d211c\" stroke-width=\"17\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            <!-- body -->\n            <path d=\"m188 128 58 8 5 80-65 4Z\" fill=\"#f4f0e7\" stroke=\"#1d211c\" stroke-width=\"6\" stroke-linejoin=\"round\"/>\n            <!-- arms -->\n            <path d=\"m193 143-55-26-39 14m139 9 43-43 42 7\" fill=\"none\" stroke=\"#1d211c\" stroke-width=\"14\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            <circle cx=\"94\" cy=\"132\" r=\"9\" fill=\"#f4f0e7\" stroke=\"#1d211c\" stroke-width=\"5\"/>\n            <circle cx=\"331\" cy=\"100\" r=\"9\" fill=\"#f4f0e7\" stroke=\"#1d211c\" stroke-width=\"5\"/>\n            <!-- head and helmet -->\n            <circle cx=\"214\" cy=\"101\" r=\"28\" fill=\"#d99c72\" stroke=\"#1d211c\" stroke-width=\"6\"/>\n            <path d=\"M184 94c2-25 21-39 44-35 18 3 30 18 29 37-23-8-49-8-73-2Z\" fill=\"#d9ed75\" stroke=\"#1d211c\" stroke-width=\"6\"/>\n            <!-- stars -->\n            <path d=\"m75 70 7 14 15 2-11 10 3 15-14-8-13 8 3-15-11-10 15-2Z\" fill=\"#f4f0e7\" stroke=\"#1d211c\" stroke-width=\"3\"/>\n            <path d=\"m351 202 5 10 11 2-8 7 2 11-10-6-10 6 2-11-8-7 11-2Z\" fill=\"#d9ed75\" stroke=\"#1d211c\" stroke-width=\"3\"/>\n          </svg>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"quote-section\" id=\"story\">\n      <div class=\"wrap\">\n        <div class=\"quote-mark\">\u201c</div>\n        <blockquote>Skateboarding isn\u2019t about getting good. It\u2019s about having a good time getting there.</blockquote>\n        <div class=\"quote-credit\">The Sidewalk way \u00b7 Since 2014</div>\n      </div>\n    </section>\n\n    <section class=\"visit\" id=\"visit\">\n      <div class=\"wrap visit-inner\">\n        <div>\n          <div class=\"eyebrow\">Come say hey</div>\n          <h2>Your spot.<br />Our spot.</h2>\n          <p>42 Maple Street, Eastside \u00b7 Open every day, 11am\u20137pm</p>\n        </div>\n        <a class=\"button\" href=\"https://maps.google.com/?q=42+Maple+Street\" target=\"_blank\" rel=\"noreferrer\">Get directions <span class=\"arrow\">\u2197</span></a>\n      </div>\n    </section>\n  </main>\n\n  <footer>\n    <div class=\"wrap footer-inner\">\n      <a class=\"brand\" href=\"#\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M4 15.5 19 8.5M6 18l14-6.5\" stroke=\"#f4f0e7\" stroke-width=\"2.6\" stroke-linecap=\"round\"/>\n            <circle cx=\"7\" cy=\"19\" r=\"1.5\" fill=\"#f4f0e7\"/>\n            <circle cx=\"18\" cy=\"10.5\" r=\"1.5\" fill=\"#f4f0e7\"/>\n          </svg>\n        </span>\n        Sidewalk\n      </a>\n      <div class=\"footer-note\">Good boards. Good people. Good days. \u00a9 2024 Sidewalk Skate Shop.</div>\n      <div class=\"socials\">\n        <a href=\"#visit\">Instagram</a>\n        <a href=\"#visit\">TikTok</a>\n        <a href=\"mailto:hello@sidewalkskate.example\">Email us</a>\n      </div>\n    </div>\n  </footer>\n</body>\n</html>\n"}