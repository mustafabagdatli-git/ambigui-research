{"brief": "B2", "model": "openai/gpt-6-luna", "i": 3, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <meta name=\"theme-color\" content=\"#fff9ee\">\n  <meta name=\"description\" content=\"Big discoveries, little scientists. Explore hands-on exhibits, playful experiments, and family fun at Wonderworks Children's Science Museum.\">\n  <title>Wonderworks \u2014 A Children's Science Museum</title>\n  <style>\n    :root {\n      --ink: #18243d;\n      --muted: #5f6b7d;\n      --cream: #fff9ee;\n      --paper: #ffffff;\n      --blue: #3978e8;\n      --blue-dark: #2358bb;\n      --coral: #f56f5d;\n      --yellow: #ffd45c;\n      --mint: #bdebd9;\n      --lavender: #ded8ff;\n      --line: rgba(24, 36, 61, 0.12);\n      --shadow: 0 16px 42px rgba(29, 49, 84, 0.1);\n      --radius: 24px;\n      --content: 1160px;\n    }\n\n    * { box-sizing: border-box; }\n\n    html { scroll-behavior: smooth; }\n\n    body {\n      margin: 0;\n      background: var(--cream);\n      color: var(--ink);\n      font-family: \"Trebuchet MS\", \"Avenir Next\", Avenir, system-ui, sans-serif;\n      line-height: 1.5;\n    }\n\n    a { color: inherit; text-decoration: none; }\n\n    a:focus-visible,\n    button:focus-visible {\n      outline: 3px solid var(--coral);\n      outline-offset: 4px;\n    }\n\n    .container {\n      width: min(var(--content), calc(100% - 48px));\n      margin-inline: auto;\n    }\n\n    .announcement {\n      padding: 9px 16px;\n      background: var(--ink);\n      color: white;\n      text-align: center;\n      font-size: 13px;\n      font-weight: 700;\n      letter-spacing: 0.02em;\n    }\n\n    .announcement a {\n      color: var(--yellow);\n      text-decoration: underline;\n      text-underline-offset: 3px;\n    }\n\n    .site-header {\n      position: relative;\n      z-index: 2;\n      background: var(--cream);\n    }\n\n    .nav {\n      min-height: 82px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 32px;\n    }\n\n    .brand {\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      flex-shrink: 0;\n      font-size: 23px;\n      font-weight: 900;\n      letter-spacing: -0.06em;\n    }\n\n    .brand-mark {\n      width: 39px;\n      height: 39px;\n      display: grid;\n      place-items: center;\n      border-radius: 13px;\n      background: var(--coral);\n      color: white;\n      transform: rotate(-7deg);\n    }\n\n    .brand-mark svg { width: 25px; height: 25px; }\n\n    .brand span:last-child { color: var(--blue); }\n\n    .nav-links {\n      display: flex;\n      align-items: center;\n      gap: clamp(18px, 3vw, 36px);\n      color: #48546a;\n      font-size: 14px;\n      font-weight: 700;\n    }\n\n    .nav-links a:hover { color: var(--blue); }\n\n    .button {\n      min-height: 48px;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: 9px;\n      padding: 0 21px;\n      border: 0;\n      border-radius: 999px;\n      background: var(--blue);\n      color: white;\n      font: inherit;\n      font-size: 14px;\n      font-weight: 800;\n      box-shadow: 0 6px 0 var(--blue-dark);\n      transition: transform 160ms ease, box-shadow 160ms ease, background 160ms ease;\n    }\n\n    .button:hover {\n      background: #2d6ddd;\n      box-shadow: 0 3px 0 var(--blue-dark);\n      transform: translateY(3px);\n    }\n\n    .button-coral {\n      background: var(--coral);\n      box-shadow: 0 6px 0 #d65449;\n    }\n\n    .button-coral:hover {\n      background: #ef6354;\n      box-shadow: 0 3px 0 #d65449;\n    }\n\n    .button svg { width: 17px; height: 17px; }\n\n    .hero {\n      padding: 47px 0 76px;\n      overflow: hidden;\n    }\n\n    .hero-grid {\n      display: grid;\n      grid-template-columns: 0.92fr 1.08fr;\n      align-items: center;\n      gap: 38px;\n    }\n\n    .eyebrow {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      margin: 0 0 17px;\n      color: var(--blue);\n      font-size: 12px;\n      font-weight: 900;\n      letter-spacing: 0.13em;\n      text-transform: uppercase;\n    }\n\n    .eyebrow-dot {\n      width: 9px;\n      height: 9px;\n      border-radius: 50%;\n      background: var(--coral);\n      box-shadow: 0 0 0 5px rgba(245, 111, 93, 0.15);\n    }\n\n    h1, h2, h3, p { margin-top: 0; }\n\n    h1 {\n      max-width: 560px;\n      margin-bottom: 21px;\n      font-size: clamp(48px, 6vw, 76px);\n      line-height: 0.99;\n      letter-spacing: -0.075em;\n    }\n\n    h1 .highlight {\n      position: relative;\n      z-index: 0;\n      white-space: nowrap;\n    }\n\n    h1 .highlight::after {\n      position: absolute;\n      z-index: -1;\n      right: -3px;\n      bottom: 4px;\n      left: -3px;\n      height: 18px;\n      border-radius: 50%;\n      background: var(--yellow);\n      content: \"\";\n      transform: rotate(-2deg);\n    }\n\n    .hero-copy {\n      max-width: 470px;\n      margin-bottom: 27px;\n      color: var(--muted);\n      font-size: 17px;\n      line-height: 1.7;\n    }\n\n    .hero-actions {\n      display: flex;\n      flex-wrap: wrap;\n      align-items: center;\n      gap: 18px;\n    }\n\n    .text-link {\n      display: inline-flex;\n      align-items: center;\n      gap: 7px;\n      color: var(--ink);\n      font-size: 14px;\n      font-weight: 800;\n    }\n\n    .text-link:hover { color: var(--blue); }\n\n    .text-link svg { width: 16px; height: 16px; }\n\n    .hero-note {\n      display: flex;\n      align-items: center;\n      gap: 11px;\n      margin-top: 32px;\n      color: var(--muted);\n      font-size: 12px;\n      font-weight: 700;\n    }\n\n    .avatar-stack {\n      display: flex;\n      padding-left: 4px;\n    }\n\n    .avatar {\n      width: 31px;\n      height: 31px;\n      display: grid;\n      place-items: center;\n      margin-left: -5px;\n      border: 2px solid var(--cream);\n      border-radius: 50%;\n      background: var(--mint);\n      font-size: 16px;\n    }\n\n    .avatar:nth-child(2) { background: #ffd6c9; }\n    .avatar:nth-child(3) { background: var(--lavender); }\n\n    .hero-art {\n      position: relative;\n      min-height: 470px;\n      display: grid;\n      place-items: center;\n    }\n\n    .art-blob {\n      position: absolute;\n      inset: 14px 15px 5px 12px;\n      border-radius: 48% 52% 45% 55% / 50% 42% 58% 50%;\n      background: #dff3e9;\n      transform: rotate(-4deg);\n    }\n\n    .hero-art svg {\n      position: relative;\n      width: 100%;\n      max-width: 640px;\n      filter: drop-shadow(0 15px 15px rgba(41, 68, 93, 0.09));\n    }\n\n    .floating-label {\n      position: absolute;\n      z-index: 1;\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      padding: 11px 14px;\n      border: 1px solid rgba(24, 36, 61, 0.06);\n      border-radius: 16px;\n      background: white;\n      box-shadow: var(--shadow);\n      font-size: 12px;\n      font-weight: 900;\n    }\n\n    .floating-label span { font-size: 19px; }\n    .label-top { top: 56px; right: 4px; transform: rotate(4deg); }\n    .label-bottom { bottom: 44px; left: 4px; transform: rotate(-4deg); }\n\n    .welcome-strip {\n      position: relative;\n      z-index: 1;\n      margin-top: -16px;\n      padding: 22px 28px;\n      border: 1px solid var(--line);\n      border-radius: 20px;\n      background: var(--paper);\n      box-shadow: 0 10px 30px rgba(29, 49, 84, 0.06);\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 20px;\n    }\n\n    .welcome-strip strong {\n      display: block;\n      margin-bottom: 2px;\n      font-size: 16px;\n    }\n\n    .welcome-strip p {\n      margin-bottom: 0;\n      color: var(--muted);\n      font-size: 13px;\n    }\n\n    .welcome-hours {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      color: var(--ink);\n      font-size: 13px;\n      font-weight: 800;\n      white-space: nowrap;\n    }\n\n    .clock-icon {\n      width: 38px;\n      height: 38px;\n      display: grid;\n      place-items: center;\n      border-radius: 12px;\n      background: #fff0c7;\n      font-size: 19px;\n    }\n\n    .section { padding: 100px 0; }\n\n    .section-heading {\n      max-width: 640px;\n      margin: 0 auto 42px;\n      text-align: center;\n    }\n\n    .section-heading .eyebrow { justify-content: center; }\n\n    h2 {\n      margin-bottom: 12px;\n      font-size: clamp(34px, 4.3vw, 52px);\n      line-height: 1.06;\n      letter-spacing: -0.065em;\n    }\n\n    .section-heading > p:last-child {\n      margin-bottom: 0;\n      color: var(--muted);\n      font-size: 16px;\n    }\n\n    .experiences { padding-top: 105px; }\n\n    .experience-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 20px;\n    }\n\n    .experience-card {\n      min-height: 290px;\n      display: flex;\n      flex-direction: column;\n      padding: 25px;\n      border: 1px solid rgba(24, 36, 61, 0.07);\n      border-radius: var(--radius);\n      background: white;\n      box-shadow: 0 8px 25px rgba(29, 49, 84, 0.05);\n      transition: transform 180ms ease, box-shadow 180ms ease;\n    }\n\n    .experience-card:hover {\n      transform: translateY(-5px);\n      box-shadow: var(--shadow);\n    }\n\n    .experience-card:nth-child(1) { background: #eef6ff; }\n    .experience-card:nth-child(2) { background: #fff0e9; }\n    .experience-card:nth-child(3) { background: #f0f8e8; }\n\n    .card-illustration {\n      width: 100%;\n      height: 112px;\n      display: grid;\n      place-items: center;\n      margin-bottom: 18px;\n      border-radius: 17px;\n      background: rgba(255, 255, 255, 0.63);\n      font-size: 56px;\n    }\n\n    .experience-card h3 {\n      margin-bottom: 7px;\n      font-size: 21px;\n      letter-spacing: -0.04em;\n    }\n\n    .experience-card p {\n      margin-bottom: 17px;\n      color: #5c6878;\n      font-size: 14px;\n    }\n\n    .experience-card .text-link { margin-top: auto; }\n\n    .visit {\n      position: relative;\n      overflow: hidden;\n      background: var(--ink);\n      color: white;\n    }\n\n    .visit::before,\n    .visit::after {\n      position: absolute;\n      border: 1px solid rgba(255, 255, 255, 0.09);\n      border-radius: 50%;\n      content: \"\";\n      pointer-events: none;\n    }\n\n    .visit::before {\n      width: 430px;\n      height: 430px;\n      top: -230px;\n      right: -95px;\n      box-shadow: 0 0 0 35px rgba(255,255,255,0.025), 0 0 0 80px rgba(255,255,255,0.02);\n    }\n\n    .visit::after {\n      width: 230px;\n      height: 230px;\n      bottom: -150px;\n      left: 7%;\n      box-shadow: 0 0 0 30px rgba(255,255,255,0.025), 0 0 0 65px rgba(255,255,255,0.02);\n    }\n\n    .visit-grid {\n      position: relative;\n      z-index: 1;\n      display: grid;\n      grid-template-columns: 1fr 0.9fr;\n      align-items: center;\n      gap: 70px;\n    }\n\n    .visit .eyebrow { color: var(--yellow); }\n    .visit h2 { max-width: 480px; }\n    .visit-copy { max-width: 500px; color: #c4ccda; font-size: 16px; }\n    .visit .button { margin-top: 9px; }\n\n    .visit-details {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 12px;\n    }\n\n    .detail-card {\n      padding: 21px;\n      border: 1px solid rgba(255,255,255,0.12);\n      border-radius: 18px;\n      background: rgba(255,255,255,0.07);\n    }\n\n    .detail-card:first-child { grid-column: span 2; }\n\n    .detail-icon { margin-bottom: 10px; font-size: 23px; }\n\n    .detail-card strong {\n      display: block;\n      margin-bottom: 3px;\n      font-size: 14px;\n    }\n\n    .detail-card p {\n      margin-bottom: 0;\n      color: #b9c2d2;\n      font-size: 13px;\n    }\n\n    .events { background: #fff; }\n\n    .events-top {\n      display: flex;\n      align-items: end;\n      justify-content: space-between;\n      gap: 20px;\n      margin-bottom: 34px;\n    }\n\n    .events-top .section-heading {\n      margin: 0;\n      text-align: left;\n    }\n\n    .events-top .eyebrow { justify-content: flex-start; }\n\n    .event-grid {\n      display: grid;\n      grid-template-columns: 1.15fr 1fr 1fr;\n      gap: 18px;\n    }\n\n    .event-card {\n      overflow: hidden;\n      border: 1px solid var(--line);\n      border-radius: 20px;\n      background: white;\n    }\n\n    .event-art {\n      height: 170px;\n      display: grid;\n      place-items: center;\n      font-size: 68px;\n    }\n\n    .event-card:nth-child(1) .event-art { background: #ffe4a7; }\n    .event-card:nth-child(2) .event-art { background: #d9efff; }\n    .event-card:nth-child(3) .event-art { background: #eadfff; }\n\n    .event-info { padding: 18px 20px 20px; }\n\n    .event-date {\n      color: var(--coral);\n      font-size: 11px;\n      font-weight: 900;\n      letter-spacing: 0.09em;\n      text-transform: uppercase;\n    }\n\n    .event-info h3 {\n      margin: 6px 0 7px;\n      font-size: 18px;\n      letter-spacing: -0.035em;\n    }\n\n    .event-info p {\n      margin-bottom: 0;\n      color: var(--muted);\n      font-size: 13px;\n    }\n\n    .newsletter {\n      padding: 72px 0;\n      background: #fff0cc;\n    }\n\n    .newsletter-inner {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 40px;\n    }\n\n    .newsletter-copy { max-width: 510px; }\n\n    .newsletter-copy .eyebrow { margin-bottom: 11px; }\n\n    .newsletter h2 {\n      margin-bottom: 9px;\n      font-size: clamp(30px, 4vw, 42px);\n    }\n\n    .newsletter-copy p:last-child {\n      margin-bottom: 0;\n      color: #5e6471;\n      font-size: 14px;\n    }\n\n    .signup {\n      width: min(100%, 420px);\n      display: flex;\n      padding: 6px;\n      border: 1px solid rgba(24, 36, 61, 0.13);\n      border-radius: 999px;\n      background: white;\n      box-shadow: 0 7px 18px rgba(68, 57, 28, 0.06);\n    }\n\n    .signup input {\n      min-width: 0;\n      flex: 1;\n      padding: 0 15px;\n      border: 0;\n      outline: 0;\n      border-radius: 999px;\n      background: transparent;\n      color: var(--ink);\n      font: inherit;\n      font-size: 13px;\n    }\n\n    .signup input::placeholder { color: #8992a0; }\n\n    .signup .button {\n      min-height: 43px;\n      padding-inline: 17px;\n      font-size: 12px;\n    }\n\n    .site-footer {\n      padding: 36px 0;\n      background: var(--ink);\n      color: white;\n    }\n\n    .footer-inner {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 24px;\n    }\n\n    .footer-inner .brand { font-size: 20px; }\n    .footer-inner .brand-mark { width: 34px; height: 34px; border-radius: 11px; }\n    .footer-inner .brand-mark svg { width: 21px; height: 21px; }\n\n    .footer-links {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 20px;\n      color: #c3cbd8;\n      font-size: 12px;\n      font-weight: 700;\n    }\n\n    .footer-links a:hover { color: var(--yellow); }\n\n    .copyright {\n      margin: 0;\n      color: #9ea9ba;\n      font-size: 11px;\n      white-space: nowrap;\n    }\n\n    @media (max-width: 850px) {\n      .nav { gap: 16px; }\n      .nav-links { gap: 16px; }\n      .nav-links a:nth-child(3) { display: none; }\n      .hero-grid { grid-template-columns: 1fr 1fr; gap: 12px; }\n      .hero-art { min-height: 390px; }\n      .visit-grid { gap: 36px; }\n      .event-grid { grid-template-columns: repeat(2, 1fr); }\n      .event-card:first-child { grid-column: span 2; }\n      .event-card:first-child .event-art { height: 200px; }\n      .footer-inner { flex-wrap: wrap; }\n    }\n\n    @media (max-width: 620px) {\n      .container { width: min(100% - 36px, var(--content)); }\n      .announcement { font-size: 11px; }\n      .nav { min-height: 70px; }\n      .brand { font-size: 20px; }\n      .brand-mark { width: 34px; height: 34px; }\n      .nav-links { display: none; }\n      .nav > .button { min-height: 42px; padding-inline: 15px; font-size: 12px; }\n      .hero { padding: 42px 0 53px; }\n      .hero-grid { grid-template-columns: 1fr; }\n      .hero-copy { font-size: 15px; }\n      h1 { max-width: 470px; font-size: clamp(48px, 14vw, 68px); }\n      .hero-art { min-height: 320px; margin-top: 8px; }\n      .art-blob { inset: 12px 4px 0; }\n      .label-top { top: 28px; right: 0; }\n      .label-bottom { bottom: 18px; left: 0; }\n      .welcome-strip { align-items: flex-start; padding: 19px; }\n      .welcome-strip p { max-width: 230px; }\n      .welcome-hours { gap: 8px; font-size: 11px; }\n      .clock-icon { width: 33px; height: 33px; flex-shrink: 0; }\n      .section { padding: 72px 0; }\n      .experiences { padding-top: 74px; }\n      .section-heading { margin-bottom: 30px; }\n      .experience-grid { grid-template-columns: 1fr; gap: 13px; }\n      .experience-card { min-height: auto; padding: 20px; }\n      .card-illustration { height: 100px; }\n      .visit-grid { grid-template-columns: 1fr; gap: 32px; }\n      .visit-details { gap: 10px; }\n      .detail-card { padding: 17px; }\n      .events-top { align-items: flex-start; flex-direction: column; }\n      .event-grid { grid-template-columns: 1fr; }\n      .event-card:first-child { grid-column: auto; }\n      .event-art, .event-card:first-child .event-art { height: 155px; }\n      .newsletter { padding: 58px 0; }\n      .newsletter-inner { align-items: stretch; flex-direction: column; gap: 25px; }\n      .signup { width: 100%; }\n      .signup .button { padding-inline: 13px; }\n      .footer-inner { align-items: flex-start; flex-direction: column; gap: 20px; }\n      .footer-links { gap: 14px; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      html { scroll-behavior: auto; }\n      *, *::before, *::after {\n        transition-duration: 0.01ms !important;\n        animation-duration: 0.01ms !important;\n      }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"announcement\">\n    Little explorers, big discoveries \u2014 <a href=\"#visit\">plan your visit this week</a>!\n  </div>\n\n  <header class=\"site-header\">\n    <div class=\"container nav\">\n      <a class=\"brand\" href=\"#\" aria-label=\"Wonderworks home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 32 32\" fill=\"none\">\n            <path d=\"M16 3.5 18.7 12l8.8.1-7.1 5.2 2.7 8.4-7.1-5.2-7.1 5.2 2.7-8.4-7.1-5.2 8.8-.1L16 3.5Z\" fill=\"currentColor\"/>\n            <circle cx=\"25.5\" cy=\"6.5\" r=\"2\" fill=\"#FFD45C\"/>\n          </svg>\n        </span>\n        <span>Wonder<span>works</span></span>\n      </a>\n\n      <nav class=\"nav-links\" aria-label=\"Main navigation\">\n        <a href=\"#explore\">Explore</a>\n        <a href=\"#visit\">Plan your visit</a>\n        <a href=\"#events\">Events</a>\n      </nav>\n\n      <a class=\"button\" href=\"#visit\">\n        Get tickets\n        <svg viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\">\n          <path d=\"M4 10h11m-4-4 4 4-4 4\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </svg>\n      </a>\n    </div>\n  </header>\n\n  <main>\n    <section class=\"hero\">\n      <div class=\"container hero-grid\">\n        <div class=\"hero-content\">\n          <p class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> A little curiosity goes a long way</p>\n          <h1>Big ideas for <span class=\"highlight\">little</span> minds.</h1>\n          <p class=\"hero-copy\">\n            Come wonder, make, test, and play. At Wonderworks, science isn't just something you learn \u2014 it's something you do together.\n          </p>\n          <div class=\"hero-actions\">\n            <a class=\"button button-coral\" href=\"#explore\">\n              Explore the museum\n              <svg viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\">\n                <path d=\"M4 10h11m-4-4 4 4-4 4\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n            </a>\n            <a class=\"text-link\" href=\"#visit\">\n              Plan your visit\n              <svg viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\">\n                <path d=\"M4 10h11m-4-4 4 4-4 4\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n            </a>\n          </div>\n          <div class=\"hero-note\">\n            <div class=\"avatar-stack\" aria-hidden=\"true\">\n              <span class=\"avatar\">\ud83d\udc67</span>\n              <span class=\"avatar\">\ud83d\udc66</span>\n              <span class=\"avatar\">\ud83e\uddd2</span>\n            </div>\n            <span>Made for curious kids ages 2\u201312</span>\n          </div>\n        </div>\n\n        <div class=\"hero-art\" aria-label=\"Illustration of a smiling rocket flying among planets and stars\" role=\"img\">\n          <div class=\"art-blob\"></div>\n          <div class=\"floating-label label-top\"><span>\ud83e\ude90</span> Out-of-this-world fun</div>\n          <div class=\"floating-label label-bottom\"><span>\u2728</span> Play is how we learn</div>\n          <svg viewBox=\"0 0 640 520\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n            <defs>\n              <linearGradient id=\"rocketBody\" x1=\"264\" y1=\"112\" x2=\"378\" y2=\"354\" gradientUnits=\"userSpaceOnUse\">\n                <stop stop-color=\"#fff\"/>\n                <stop offset=\"1\" stop-color=\"#e9efff\"/>\n              </linearGradient>\n              <linearGradient id=\"flame\" x1=\"320\" y1=\"330\" x2=\"320\" y2=\"449\" gradientUnits=\"userSpaceOnUse\">\n                <stop stop-color=\"#ffd45c\"/>\n                <stop offset=\"1\" stop-color=\"#f56f5d\"/>\n              </linearGradient>\n            </defs>\n            <!-- stars -->\n            <path d=\"m99 122 5 14 14 5-14 5-5 14-5-14-14-5 14-5 5-14Zm426 182 4 11 11 4-11 4-4 11-4-11-11-4 11-4 4-11ZM170 380l3 9 9 3-9 3-3 9-3-9-9-3 9-3 3-9Z\" fill=\"#fff\" opacity=\".9\"/>\n            <circle cx=\"150\" cy=\"214\" r=\"4\" fill=\"#ffd45c\"/>\n            <circle cx=\"474\" cy=\"119\" r=\"5\" fill=\"#f56f5d\"/>\n            <circle cx=\"491\" cy=\"405\" r=\"4\" fill=\"#3978e8\"/>\n            <circle cx=\"214\" cy=\"90\" r=\"3\" fill=\"#fff\"/>\n            <circle cx=\"421\" cy=\"442\" r=\"3\" fill=\"#fff\"/>\n            <!-- orbit -->\n            <ellipse cx=\"327\" cy=\"270\" rx=\"258\" ry=\"152\" transform=\"rotate(-18 327 270)\" stroke=\"#91cdb2\" stroke-width=\"3\" stroke-dasharray=\"7 11\" opacity=\".75\"/>\n            <!-- planets -->\n            <circle cx=\"118\" cy=\"327\" r=\"48\" fill=\"#f56f5d\"/>\n            <path d=\"M78 323c24-15 53-17 79-7M84 341c22-12 45-13 68-5\" stroke=\"#ffb199\" stroke-width=\"7\" stroke-linecap=\"round\"/>\n            <circle cx=\"501\" cy=\"200\" r=\"47\" fill=\"#ffd45c\"/>\n            <path d=\"M465 194c18-12 39-13 63-5M470 211c17-9 35-10 53-4\" stroke=\"#fff0b5\" stroke-width=\"7\" stroke-linecap=\"round\"/>\n            <circle cx=\"463\" cy=\"377\" r=\"27\" fill=\"#b8a9ff\"/>\n            <ellipse cx=\"463\" cy=\"377\" rx=\"43\" ry=\"10\" transform=\"rotate(-22 463 377)\" stroke=\"#a392ef\" stroke-width=\"7\"/>\n            <!-- rocket flame -->\n            <path d=\"M284 333c-3 40-28 60-17 92 8 23 31 30 53 30 25 0 46-12 51-34 6-29-18-48-21-88h-66Z\" fill=\"url(#flame)\"/>\n            <path d=\"M303 352c-2 21-16 31-9 48 4 11 15 15 27 15 13 0 22-7 24-18 3-17-11-28-13-45h-29Z\" fill=\"#fff4b8\"/>\n            <!-- rocket fins -->\n            <path d=\"m264 279-54 52c-8 8-2 20 9 18l64-13 14-58-33 1Zm111 0 53 52c8 8 2 20-9 18l-63-13-14-58 33 1Z\" fill=\"#f56f5d\" stroke=\"#d9584d\" stroke-width=\"5\" stroke-linejoin=\"round\"/>\n            <!-- rocket body -->\n            <path d=\"M320 82c-40 34-67 99-67 171v80c0 15 12 27 27 27h80c15 0 27-12 27-27v-80c0-72-27-137-67-171Z\" fill=\"url(#rocketBody)\" stroke=\"#263755\" stroke-width=\"7\"/>\n            <path d=\"M320 82c-15 13-28 31-39 52h78c-11-21-24-39-39-52Z\" fill=\"#3978e8\" stroke=\"#263755\" stroke-width=\"7\" stroke-linejoin=\"round\"/>\n            <!-- window -->\n            <circle cx=\"320\" cy=\"227\" r=\"42\" fill=\"#9de1e9\" stroke=\"#263755\" stroke-width=\"7\"/>\n            <circle cx=\"307\" cy=\"215\" r=\"11\" fill=\"white\" opacity=\".7\"/>\n            <!-- happy face -->\n            <circle cx=\"307\" cy=\"229\" r=\"4\" fill=\"#263755\"/>\n            <circle cx=\"333\" cy=\"229\" r=\"4\" fill=\"#263755\"/>\n            <path d=\"M309 245c6 8 16 8 22 0\" stroke=\"#263755\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n            <!-- details -->\n            <path d=\"M276 306h18m52 0h18\" stroke=\"#b6c6ea\" stroke-width=\"6\" stroke-linecap=\"round\"/>\n            <circle cx=\"320\" cy=\"321\" r=\"6\" fill=\"#ffd45c\"/>\n            <!-- small astronaut -->\n            <circle cx=\"173\" cy=\"133\" r=\"20\" fill=\"#fff\" stroke=\"#263755\" stroke-width=\"4\"/>\n            <path d=\"M157 132c7-11 25-13 33-1v10h-33v-9Z\" fill=\"#bdebd9\"/>\n            <path d=\"M165 155 160 166m24-11 5 11\" stroke=\"#263755\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n            <path d=\"m157 165 12 4 11-4\" stroke=\"#263755\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n            <!-- sparkle trails -->\n            <path d=\"m219 187 4 8 8 3-8 3-4 8-3-8-8-3 8-3 3-8Zm233 56 3 6 6 2-6 3-3 6-2-6-6-3 6-2 2-6Z\" fill=\"#fff\"/>\n          </svg>\n        </div>\n      </div>\n\n      <div class=\"container\">\n        <div class=\"welcome-strip\">\n          <div>\n            <strong>Come curious. Leave inspired.</strong>\n            <p>One joyful day out, with a million things to try.</p>\n          </div>\n          <div class=\"welcome-hours\">\n            <span class=\"clock-icon\" aria-hidden=\"true\">\ud83d\udd58</span>\n            <span>Open today<br>9:00 am \u2013 5:00 pm</span>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section experiences\" id=\"explore\">\n      <div class=\"container\">\n        <div class=\"section-heading\">\n          <p class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> Pick your adventure</p>\n          <h2>Hands-on fun for every kind of curious.</h2>\n          <p>There are no wrong turns here \u2014 just new things to discover around every corner.</p>\n        </div>\n\n        <div class=\"experience-grid\">\n          <article class=\"experience-card\">\n            <div class=\"card-illustration\" aria-hidden=\"true\">\ud83d\ude80</div>\n            <h3>Blast Off!</h3>\n            <p>Build a rocket, launch it sky-high, and find out what makes things fly.</p>\n            <a class=\"text-link\" href=\"#visit\">Explore space <span aria-hidden=\"true\">\u2192</span></a>\n          </article>\n          <article class=\"experience-card\">\n            <div class=\"card-illustration\" aria-hidden=\"true\">\ud83e\uddea</div>\n            <h3>Messy Science</h3>\n            <p>Mix, fizz, bubble, and make a little mess in our anything-goes lab.</p>\n            <a class=\"text-link\" href=\"#events\">See lab activities <span aria-hidden=\"true\">\u2192</span></a>\n          </article>\n          <article class=\"experience-card\">\n            <div class=\"card-illustration\" aria-hidden=\"true\">\ud83c\udf3f</div>\n            <h3>Nature Works</h3>\n            <p>Get close to the tiny wonders, big questions, and amazing life all around us.</p>\n            <a class=\"text-link\" href=\"#events\">Explore the outdoors <span aria-hidden=\"true\">\u2192</span></a>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section visit\" id=\"visit\">\n      <div class=\"container visit-grid\">\n        <div>\n          <p class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> Your next great day out</p>\n          <h2>Make a day of discovering.</h2>\n          <p class=\"visit-copy\">\n            Bring your favorite grown-up and your biggest questions. We\u2019ll take care of the rest \u2014 from easy parking to a cozy spot for snack breaks.\n          </p>\n          <a class=\"button button-coral\" href=\"mailto:hello@wonderworks.example\">\n            Plan your visit\n            <svg viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\">\n              <path d=\"M4 10h11m-4-4 4 4-4 4\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            </svg>\n          </a>\n        </div>\n\n        <div class=\"visit-details\">\n          <div class=\"detail-card\">\n            <div class=\"detail-icon\" aria-hidden=\"true\">\ud83d\udccd</div>\n            <strong>Find us</strong>\n            <p>42 Curiosity Lane, Brightville<br>Easy parking right around the corner.</p>\n          </div>\n          <div class=\"detail-card\">\n            <div class=\"detail-icon\" aria-hidden=\"true\">\ud83c\udf9f\ufe0f</div>\n            <strong>Tickets</strong>\n            <p>Little scientists under 2 visit free.</p>\n          </div>\n          <div class=\"detail-card\">\n            <div class=\"detail-icon\" aria-hidden=\"true\">\ud83e\uddc3</div>\n            <strong>Good to know</strong>\n            <p>Snacks welcome. Big imaginations encouraged.</p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section events\" id=\"events\">\n      <div class=\"container\">\n        <div class=\"events-top\">\n          <div class=\"section-heading\">\n            <p class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> Coming up at Wonderworks</p>\n            <h2>More reasons to come play.</h2>\n          </div>\n          <a class=\"text-link\" href=\"mailto:hello@wonderworks.example\">\n            All events <span aria-hidden=\"true\">\u2192</span>\n          </a>\n        </div>\n\n        <div class=\"event-grid\">\n          <article class=\"event-card\">\n            <div class=\"event-art\" aria-hidden=\"true\">\ud83e\udee7</div>\n            <div class=\"event-info\">\n              <span class=\"event-date\">Every day \u00b7 11:00 am</span>\n              <h3>Bubble Lab Live</h3>\n              <p>How big can a bubble get? Come find out with our science crew.</p>\n            </div>\n          </article>\n          <article class=\"event-card\">\n            <div class=\"event-art\" aria-hidden=\"true\">\ud83e\udea8</div>\n            <div class=\"event-info\">\n              <span class=\"event-date\">Saturday \u00b7 1:30 pm</span>\n              <h3>Rock Detectives</h3>\n              <p>Crack the clues hidden in rocks, crystals, and fossils.</p>\n            </div>\n          </article>\n          <article class=\"event-card\">\n            <div class=\"event-art\" aria-hidden=\"true\">\ud83c\udf08</div>\n            <div class=\"event-info\">\n              <span class=\"event-date\">Sunday \u00b7 10:30 am</span>\n              <h3>Color Lab</h3>\n              <p>Mix, match, and make something wonderfully unexpected.</p>\n            </div>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"newsletter\" aria-labelledby=\"newsletter-title\">\n      <div class=\"container newsletter-inner\">\n        <div class=\"newsletter-copy\">\n          <p class=\"eyebrow\"><span class=\"eyebrow-dot\"></span> A little wonder in your inbox</p>\n          <h2 id=\"newsletter-title\">Curiosity looks good on you.</h2>\n          <p>Get the scoop on new exhibits, family events, and fun things to try at home.</p>\n        </div>\n        <form class=\"signup\" action=\"#\" method=\"get\">\n          <label for=\"email\" class=\"visually-hidden\"></label>\n          <input id=\"email\" type=\"email\" name=\"email\" placeholder=\"Your email address\" aria-label=\"Your email address\" required>\n          <button class=\"button\" type=\"submit\">Count me in <span aria-hidden=\"true\">\u2192</span></button>\n        </form>\n      </div>\n    </section>\n  </main>\n\n  <footer class=\"site-footer\">\n    <div class=\"container footer-inner\">\n      <a class=\"brand\" href=\"#\" aria-label=\"Wonderworks home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 32 32\" fill=\"none\">\n            <path d=\"M16 3.5 18.7 12l8.8.1-7.1 5.2 2.7 8.4-7.1-5.2-7.1 5.2 2.7-8.4-7.1-5.2 8.8-.1L16 3.5Z\" fill=\"currentColor\"/>\n            <circle cx=\"25.5\" cy=\"6.5\" r=\"2\" fill=\"#FFD45C\"/>\n          </svg>\n        </span>\n        <span>Wonder<span>works</span></span>\n      </a>\n      <nav class=\"footer-links\" aria-label=\"Footer navigation\">\n        <a href=\"#explore\">Explore</a>\n        <a href=\"#visit\">Visit</a>\n        <a href=\"#events\">Events</a>\n        <a href=\"mailto:hello@wonderworks.example\">Contact</a>\n      </nav>\n      <p class=\"copyright\">\u00a9 2025 Wonderworks Museum</p>\n    </div>\n  </footer>\n\n  <style>\n    .visually-hidden {\n      position: absolute;\n      width: 1px;\n      height: 1px;\n      padding: 0;\n      margin: -1px;\n      overflow: hidden;\n      clip: rect(0, 0, 0, 0);\n      white-space: nowrap;\n      border: 0;\n    }\n  </style>\n</body>\n</html>"}