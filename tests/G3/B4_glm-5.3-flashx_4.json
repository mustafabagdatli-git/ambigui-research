{"brief": "B4", "model": "z-ai/glm-5.3-flashx", "i": 4, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Half-Light Press \u2014 Poems for the Hour Between</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --paper:#F6F1E7;\n    --paper-deep:#EFE7D7;\n    --ink:#1E1A15;\n    --ink-soft:#5A5245;\n    --vermilion:#B23A24;\n    --olive:#6E6A4E;\n    --rule:#C9BFA9;\n  }\n  *{margin:0;padding:0;box-sizing:border-box}\n  html{scroll-behavior:smooth}\n  body{\n    background:var(--paper);\n    color:var(--ink);\n    font-family:'Newsreader',serif;\n    font-size:18px;\n    line-height:1.65;\n    -webkit-font-smoothing:antialiased;\n  }\n  ::selection{background:var(--vermilion);color:var(--paper)}\n  .wrap{max-width:1100px;margin:0 auto;padding:0 6vw}\n\n  /* grain */\n  body::before{\n    content:\"\";position:fixed;inset:0;pointer-events:none;z-index:50;opacity:.5;\n    background-image:repeating-linear-gradient(0deg,transparent 0 2px,rgba(30,26,21,.014) 2px 3px);\n  }\n\n  /* ---------- masthead ---------- */\n  header{\n    display:flex;justify-content:space-between;align-items:baseline;\n    padding-top:34px;padding-bottom:14px;\n    border-bottom:1.5px solid var(--ink);\n    position:relative;\n  }\n  header::after{content:\"\";position:absolute;left:0;right:0;bottom:3px;border-bottom:.5px solid var(--ink)}\n  .wordmark{\n    font-family:'Fraunces',serif;font-weight:600;font-size:20px;letter-spacing:.02em;\n  }\n  .wordmark em{font-style:italic;color:var(--vermilion)}\n  nav{display:flex;gap:34px}\n  nav a{\n    color:var(--ink-soft);text-decoration:none;font-size:15px;letter-spacing:.08em;\n    text-transform:uppercase;font-family:'Fraunces',serif;font-weight:400;\n    transition:color .2s;\n  }\n  nav a:hover{color:var(--vermilion)}\n  @media(max-width:640px){nav{display:none}}\n\n  /* ---------- hero ---------- */\n  .hero{padding:9vh 0 8vh;position:relative}\n  .kicker{\n    font-family:'Fraunces',serif;font-size:14px;letter-spacing:.28em;text-transform:uppercase;\n    color:var(--vermilion);margin-bottom:3.2rem;display:flex;align-items:center;gap:16px;\n  }\n  .kicker::after{content:\"\";height:1px;width:72px;background:var(--vermilion)}\n  h1{\n    font-family:'Fraunces',serif;font-weight:340;\n    font-size:clamp(2.6rem,6.4vw,5.4rem);\n    line-height:1.08;letter-spacing:-.015em;\n    max-width:16ch;\n  }\n  h1 .ital{font-style:italic;font-weight:400}\n  h1 .hollow{\n    -webkit-text-stroke:1.5px var(--ink);color:transparent;font-weight:500;\n  }\n  .hero-foot{\n    display:flex;justify-content:space-between;align-items:flex-end;\n    margin-top:6vh;gap:40px;flex-wrap:wrap;\n  }\n  .hero-note{max-width:36ch;color:var(--ink-soft);font-size:1.05rem}\n  .stamp{\n    width:112px;height:112px;border:1.5px solid var(--ink);border-radius:50%;\n    display:flex;align-items:center;justify-content:center;text-align:center;\n    font-family:'Fraunces',serif;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;\n    line-height:1.7;transform:rotate(-7deg);color:var(--ink);flex-shrink:0;\n    box-shadow:inset 0 0 0 4px var(--paper), inset 0 0 0 5px var(--rule);\n    animation:tilt 6s ease-in-out infinite alternate;\n  }\n  @keyframes tilt{from{transform:rotate(-7deg)}to{transform:rotate(-2deg)}}\n\n  /* ---------- signature: revisions poem ---------- */\n  .revisions{\n    border-top:1.5px solid var(--ink);border-bottom:1.5px solid var(--ink);\n    background:var(--paper-deep);\n    padding:7vh 0;\n  }\n  .rev-head{display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:10px;margin-bottom:2.6rem}\n  .rev-head h2{font-family:'Fraunces',serif;font-weight:400;font-size:1.5rem}\n  .rev-head span{font-size:15px;color:var(--ink-soft);font-style:italic}\n  .poem{\n    font-family:'Fraunces',serif;font-weight:340;\n    font-size:clamp(1.5rem,3.6vw,2.6rem);\n    line-height:1.75;max-width:26em;\n  }\n  .swappable{\n    display:inline-block;cursor:pointer;position:relative;\n    border-bottom:2px solid var(--vermilion);\n    transition:color .25s;\n    white-space:nowrap;\n  }\n  .swappable:hover{color:var(--vermilion)}\n  .swappable.alt{color:var(--vermilion)}\n  .swappable::after{\n    content:attr(data-alt);\n    position:absolute;left:0;top:100%;white-space:nowrap;\n    font-size:.42em;font-style:italic;letter-spacing:.02em;\n    color:var(--ink-soft);opacity:0;transform:translateY(4px);\n    transition:opacity .25s,transform .25s;pointer-events:none;\n    padding-top:.35em;\n  }\n  .swappable:hover::after{opacity:1;transform:translateY(0)}\n  .rev-note{margin-top:3.2rem;font-size:15px;color:var(--ink-soft);font-style:italic;max-width:52ch}\n  .rev-note b{color:var(--vermilion);font-weight:600}\n\n  /* ---------- titles shelf ---------- */\n  .shelf{padding:8vh 0 9vh}\n  .section-title{\n    font-family:'Fraunces',serif;font-weight:400;font-size:1.5rem;margin-bottom:3rem;\n    display:flex;align-items:baseline;gap:20px;\n  }\n  .section-title small{font-size:15px;color:var(--ink-soft);font-style:italic;font-family:'Newsreader',serif}\n  .books{display:flex;gap:0;align-items:flex-end;justify-content:center;flex-wrap:wrap;padding-bottom:0}\n  .book{\n    writing-mode:vertical-rl;\n    font-family:'Fraunces',serif;\n    display:flex;align-items:center;justify-content:space-between;\n    padding:26px 0;margin:0 -1px;\n    border:1.5px solid var(--ink);\n    letter-spacing:.05em;\n    transition:transform .3s ease, box-shadow .3s ease;\n    cursor:pointer;\n    position:relative;\n  }\n  .book:hover{\n    transform:translateY(-18px) rotate(-1.5deg);\n    box-shadow:6px 10px 0 rgba(30,26,21,.14);\n    z-index:2;\n  }\n  .book .author{font-size:11px;letter-spacing:.2em;text-transform:uppercase;opacity:.75;margin-top:18px}\n  .book .title-fs{font-size:17px;font-weight:500}\n  .b1{background:var(--vermilion);color:var(--paper);height:290px;width:56px}\n  .b2{background:var(--ink);color:var(--paper);height:330px;width:64px}\n  .b3{background:var(--paper);color:var(--ink);height:250px;width:52px}\n  .b4{background:var(--olive);color:var(--paper);height:305px;width:70px}\n  .b5{background:var(--paper-deep);color:var(--ink);height:270px;width:58px}\n  .b6{background:var(--ink);color:var(--paper);height:340px;width:60px}\n  .b7{background:var(--vermilion);color:var(--paper);height:260px;width:54px}\n  .shelf-board{\n    height:10px;background:var(--ink);max-width:760px;margin:0 auto;\n    box-shadow:0 6px 0 var(--rule);\n  }\n  .shelf-caption{text-align:center;margin-top:3.4rem;color:var(--ink-soft);font-size:15px;font-style:italic}\n  .shelf-caption a{color:var(--vermilion);text-decoration:none;border-bottom:1px solid var(--vermilion)}\n\n  /* ---------- manifesto ---------- */\n  .manifesto{\n    background:var(--ink);color:var(--paper);\n    padding:9vh 0;\n  }\n  .manifesto .inner{display:grid;grid-template-columns:1fr 2fr;gap:6vw;align-items:start}\n  @media(max-width:760px){.manifesto .inner{grid-template-columns:1fr;gap:2.4rem}}\n  .manifesto h2{\n    font-family:'Fraunces',serif;font-weight:400;font-size:1.5rem;color:var(--paper);\n  }\n  .manifesto h2 span{color:var(--vermilion);display:block;font-style:italic}\n  .manifesto p{\n    font-size:clamp(1.25rem,2.4vw,1.7rem);line-height:1.6;font-weight:300;\n    font-family:'Fraunces',serif;\n  }\n  .manifesto p + p{margin-top:1.6em}\n  .manifesto em{color:#E4A88F;font-style:italic}\n  .drop{\n    float:left;font-size:4.6rem;line-height:.85;padding:.08em .12em 0 0;\n    font-family:'Fraunces',serif;color:var(--vermilion);font-weight:500;\n  }\n\n  /* ---------- letterpress signup ---------- */\n  .signup{padding:9vh 0 10vh;text-align:center}\n  .signup h2{\n    font-family:'Fraunces',serif;font-weight:340;\n    font-size:clamp(1.9rem,4vw,3rem);line-height:1.2;max-width:22ch;margin:0 auto 1rem;\n  }\n  .signup p{color:var(--ink-soft);max-width:44ch;margin:0 auto 2.6rem;font-style:italic}\n  .signup form{display:flex;justify-content:center;gap:0;max-width:520px;margin:0 auto;border:1.5px solid var(--ink)}\n  .signup input{\n    flex:1;border:none;background:transparent;padding:16px 20px;\n    font-family:'Newsreader',serif;font-size:1rem;color:var(--ink);outline:none;min-width:0;\n  }\n  .signup input::placeholder{color:var(--ink-soft);font-style:italic}\n  .signup button{\n    border:none;background:var(--vermilion);color:var(--paper);\n    font-family:'Fraunces',serif;font-size:14px;letter-spacing:.14em;text-transform:uppercase;\n    padding:0 28px;cursor:pointer;transition:background .25s;\n  }\n  .signup button:hover{background:var(--ink)}\n  .signup .msg{margin-top:1.2rem;font-size:15px;color:var(--olive);min-height:1.5em;font-style:italic}\n\n  /* ---------- footer ---------- */\n  footer{\n    border-top:1.5px solid var(--ink);\n    padding:3.4rem 0 4rem;\n    display:flex;justify-content:space-between;align-items:flex-start;gap:30px;flex-wrap:wrap;\n  }\n  footer .fm{font-family:'Fraunces',serif;font-size:1.1rem}\n  footer .fm em{color:var(--vermilion);font-style:italic}\n  footer .cols{display:flex;gap:70px;flex-wrap:wrap}\n  footer .col h4{\n    font-size:12px;letter-spacing:.22em;text-transform:uppercase;\n    font-family:'Fraunces',serif;font-weight:500;margin-bottom:.8rem;\n  }\n  footer .col a{display:block;color:var(--ink-soft);text-decoration:none;font-size:15px;padding:.18em 0;transition:color .2s}\n  footer .col a:hover{color:var(--vermilion)}\n  footer .fine{width:100%;margin-top:2.4rem;font-size:13.5px;color:var(--ink-soft);font-style:italic;\n    border-top:.5px solid var(--rule);padding-top:1.2rem;display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px}\n</style>\n</head>\n<body>\n\n<div class=\"wrap\">\n  <header>\n    <div class=\"wordmark\">Half-<em>Light</em> Press</div>\n    <nav>\n      <a href=\"#titles\">Titles</a>\n      <a href=\"#about\">About</a>\n      <a href=\"#letter\">The Letter</a>\n    </nav>\n  </header>\n</div>\n\n<!-- HERO -->\n<div class=\"wrap\">\n  <section class=\"hero\">\n    <div class=\"kicker\">Est. 2019 \u00b7 Providence, RI \u00b7 Twelve poems per season</div>\n    <h1>\n      We publish poems that hold <span class=\"hollow\">the hour</span> between\n      <span class=\"ital\">dusk and dark</span> \u2014 and refuse to let it go.\n    </h1>\n    <div class=\"hero-foot\">\n      <p class=\"hero-note\">\n        Half-Light is a small press of narrow ambition and long patience:\n        two chapbooks, one full collection, and one broadside per season,\n        letterpressed by hand and stitched by hand.\n      </p>\n      <div class=\"stamp\">Set by hand<br>\u00b7<br>Sewn by hand</div>\n    </div>\n  </section>\n</div>\n\n<!-- SIGNATURE: REVISIONS -->\n<section class=\"revisions\">\n  <div class=\"wrap\">\n    <div class=\"rev-head\">\n      <h2>The Revision, Recovered</h2>\n      <span>from the notebooks of Ada Vane, \u201cVigil\u201d (Forthcoming, Spring)</span>\n    </div>\n    <p class=\"poem\" id=\"poem\">\n      Some evenings the <span class=\"swappable\" data-alt=\"the press's preferred reading\">window</span><br>\n      holds more <span class=\"swappable\" data-alt=\"her second choice\">weather</span> than the sky,<br>\n      and I sit <span class=\"swappable\" data-alt=\"revised from \u201cwaiting\u201d\">counting</span> the lamps<br>\n      as if they were <span class=\"swappable\" data-alt=\"the earliest draft read \u201cyears\u201d\">miles</span> I meant to keep.\n    </p>\n    <p class=\"rev-note\">\n      Click any <b>underlined word</b> to turn back through the poet\u2019s drafts \u2014 every\n      poem we publish arrives carrying the ghosts of the words it almost was.\n      Visit again; the variants don\u2019t repeat in order.\n    </p>\n  </div>\n</section>\n\n<!-- SHELF -->\n<div class=\"wrap\" id=\"titles\">\n  <section class=\"shelf\">\n    <div class=\"section-title\">Recent Titles <small>\u2014 hover to pull one from the shelf</small></div>\n    <div class=\"books\">\n      <div class=\"book b1\"><span class=\"title-fs\">Vigil</span><span class=\"author\">Ada Vane</span></div>\n      <div class=\"book b2\"><span class=\"title-fs\">Field Notes in Amber</span><span class=\"author\">J. Okonkwo-Hale</span></div>\n      <div class=\"book b3\"><span class=\"title-fs\">Salt Almanac</span><span class=\"author\">Mira Deloach</span></div>\n      <div class=\"book b4\"><span class=\"title-fs\">The Long Blue Hour</span><span class=\"author\">Anthology</span></div>\n      <div class=\"book b5\"><span class=\"title-fs\">Orrery</span><span class=\"author\">T. Marsh</span></div>\n      <div class=\"book b6\"><span class=\"title-fs\">Letters to a Kestrel</span><span class=\"author\">S. Ferreira</span></div>\n      <div class=\"book b7\"><span class=\"title-fs\">Winter Pastoral</span><span class=\"author\">R. Whitcomb</span></div>\n    </div>\n    <div class=\"shelf-board\"></div>\n    <p class=\"shelf-caption\">Chapbooks, $14 \u00b7 Collections, $22 \u00b7 Broadsides, $9 \u2014\n      <a href=\"#letter\">write to us</a> and we\u2019ll tell you what\u2019s still in print.</p>\n  </section>\n</div>\n\n<!-- MANIFESTO -->\n<section class=\"manifesto\" id=\"about\">\n  <div class=\"wrap inner\">\n    <h2>Why We<br>Do This<span>slowly</span></h2>\n    <div>\n      <p><span class=\"drop\">W</span>e print few books, and we print them slowly, because a poem\n      deserves a body made with care \u2014 paper with tooth, ink pressed deep enough to\n      <em>catch the light sideways</em>, and a spine that opens without complaint ten years on.</p>\n      <p>We believe the small press is not a rehearsal for a larger one. It is its own\n      country, with its own weather. Our editions are small because our attention is\n      <em>not divisible</em>: twelve poems a season, each one argued over at the kitchen\n      table until it earns its ink.</p>\n      <p>If that sounds like your kind of patience, the door is open.</p>\n    </div>\n  </div>\n</section>\n\n<!-- SIGNUP -->\n<div class=\"wrap\" id=\"letter\">\n  <section class=\"signup\">\n    <h2>One poem in your letterbox, <span style=\"font-style:italic\">the first Tuesday</span> of every month.</h2>\n    <p>The Half-Light Letter: a single poem, a note from the composing room, and what\u2019s on the press. No noise, ever.</p>\n    <form id=\"subForm\">\n      <input type=\"email\" id=\"email\" placeholder=\"you@somewhere.quiet\" required>\n      <button type=\"submit\">Subscribe</button>\n    </form>\n    <div class=\"msg\" id=\"msg\"></div>\n  </section>\n</div>\n\n<!-- FOOTER -->\n<div class=\"wrap\">\n  <footer>\n    <div class=\"fm\">Half-<em>Light</em> Press<br><small style=\"font-size:13px;color:var(--ink-soft);font-family:'Newsreader',serif\">PO Box 4012, Providence, RI</small></div>\n    <div class=\"cols\">\n      <div class=\"col\">\n        <h4>Press</h4>\n        <a href=\"#titles\">Titles</a>\n        <a href=\"#about\">About</a>\n        <a href=\"#letter\">The Letter</a>\n      </div>\n      <div class=\"col\">\n        <h4>Poets</h4>\n        <a href=\"#letter\">Submit</a>\n        <a href=\"#letter\">Rights</a>\n        <a href=\"#letter\">Contact</a>\n      </div>\n    </div>\n    <div class=\"fine\">\n      <span>\u00a9 2025 Half-Light Press. All poems remain the property of their weather.</span>\n      <span>Set in Fraunces &amp; Newsreader.</span>\n    </div>\n  </footer>\n</div>\n\n<script>\n  // Each underlined word cycles through the poet's discarded drafts.\n  const variants = {\n    \"window\":  [\"window\",\"pane\",\"glass\",\"doorway\",\"mirror\"],\n    \"weather\": [\"weather\",\"silver\",\"thunder\",\"evening\",\"light\"],\n    \"counting\":[\"counting\",\"minding\",\"numbering\",\"watching\"],\n    \"miles\":   [\"miles\",\"years\",\"winters\",\"letters\",\"harbors\"]\n  };\n  document.querySelectorAll('.swappable').forEach(el => {\n    const key = el.textContent.trim();\n    const pool = variants[key] || [key];\n    let i = Math.max(0, pool.indexOf(key));\n    el.addEventListener('click', () => {\n      i = (i + 1) % pool.length;\n      el.textContent = pool[i];\n      el.classList.add('alt');\n      el.setAttribute('data-alt', i === 0 ? 'the poet\u2019s settled word' : 'a discarded draft');\n      setTimeout(() => el.classList.remove('alt'), 600);\n    });\n  });\n\n  // Signup \u2014 honest local feedback only.\n  document.getElementById('subForm').addEventListener('submit', e => {\n    e.preventDefault();\n    const email = document.getElementById('email').value.trim();\n    const msg = document.getElementById('msg');\n    if (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)) {\n      msg.textContent = 'That address doesn\u2019t look quite finished \u2014 like a line without its turn.';\n      msg.style.color = 'var(--vermilion)';\n      return;\n    }\n    msg.textContent = 'Welcome. The next letter leaves the composing room on the first Tuesday.';\n    msg.style.color = 'var(--olive)';\n    e.target.reset();\n  });\n</script>\n</body>\n</html>\n"}