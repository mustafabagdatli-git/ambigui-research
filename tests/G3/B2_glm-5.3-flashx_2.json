{"brief": "B2", "model": "z-ai/glm-5.3-flashx", "i": 2, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Curiosity Lab \u2014 Children's Science Museum</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Space+Grotesk:wght@400;500;700&display=swap\" rel=\"stylesheet\">\n<style>\n:root{\n  --cream:#FFF6E9;\n  --ink:#2B2118;\n  --coral:#FF5C39;\n  --teal:#0E8A7B;\n  --sun:#FFC531;\n  --sky:#BFE3E0;\n  --pink:#FF8FA3;\n}\n*{margin:0;padding:0;box-sizing:border-box}\nhtml{scroll-behavior:smooth}\nbody{\n  background:var(--cream);\n  color:var(--ink);\n  font-family:'Space Grotesk',sans-serif;\n  overflow-x:hidden;\n}\nh1,h2,h3,.baloo{font-family:'Baloo 2',cursive}\n::selection{background:var(--sun);color:var(--ink)}\n\n/* ---------- NAV ---------- */\nnav{\n  position:fixed;top:0;left:0;right:0;z-index:50;\n  display:flex;align-items:center;justify-content:space-between;\n  padding:14px 4vw;\n}\n.logo{\n  display:flex;align-items:center;gap:10px;\n  font-family:'Baloo 2';font-weight:800;font-size:1.3rem;\n}\n.logo svg{width:36px;height:36px}\nnav .links{display:flex;gap:26px}\nnav a{\n  color:var(--ink);text-decoration:none;font-weight:500;font-size:.95rem;\n  position:relative;padding:4px 2px;\n}\nnav a::after{\n  content:\"\";position:absolute;left:0;right:100%;bottom:0;height:3px;\n  background:var(--coral);border-radius:3px;transition:right .25s ease;\n}\nnav a:hover::after{right:0}\n.nav-cta{\n  background:var(--coral);color:#fff !important;\n  padding:10px 22px;border-radius:999px;font-weight:700;\n  box-shadow:0 4px 0 #c73d1f;transition:transform .15s, box-shadow .15s;\n}\n.nav-cta:hover{transform:translateY(2px);box-shadow:0 2px 0 #c73d1f}\n.nav-cta::after{display:none}\n@media(max-width:760px){nav .links a:not(.nav-cta){display:none}}\n\n/* ---------- HERO ---------- */\n.hero{\n  min-height:100vh;position:relative;\n  display:flex;flex-direction:column;justify-content:center;\n  padding:120px 6vw 60px;\n}\n.hero-grid{\n  display:grid;grid-template-columns:1.2fr .8fr;gap:40px;align-items:center;\n}\n@media(max-width:900px){.hero-grid{grid-template-columns:1fr}}\n.kicker{\n  display:inline-flex;align-items:center;gap:8px;\n  background:var(--sun);padding:8px 18px;border-radius:999px;\n  font-weight:700;font-size:.85rem;letter-spacing:.08em;text-transform:uppercase;\n  transform:rotate(-2deg);margin-bottom:24px;\n}\n.hero h1{\n  font-size:clamp(2.8rem,7vw,5.6rem);\n  line-height:.98;font-weight:800;\n}\n.hero h1 .squig{color:var(--teal);position:relative;display:inline-block}\n.hero h1 .squig svg{\n  position:absolute;left:0;right:0;bottom:-14px;width:100%;height:16px;\n}\n.hero p{\n  margin:26px 0 34px;font-size:1.15rem;max-width:46ch;line-height:1.6;\n}\n.btn-row{display:flex;gap:18px;flex-wrap:wrap;align-items:center}\n.btn{\n  font-family:'Baloo 2';font-weight:700;font-size:1.1rem;\n  text-decoration:none;border:none;cursor:pointer;\n  padding:16px 34px;border-radius:999px;transition:transform .15s;\n  display:inline-flex;align-items:center;gap:10px;\n}\n.btn-primary{background:var(--teal);color:#fff;box-shadow:0 6px 0 #07544b}\n.btn-primary:hover{transform:translateY(-3px) rotate(-1deg)}\n.btn-primary:active{transform:translateY(2px);box-shadow:0 2px 0 #07544b}\n.btn-ghost{\n  background:transparent;color:var(--ink);\n  box-shadow:inset 0 0 0 3px var(--ink);\n}\n.btn-ghost:hover{background:var(--sun);transform:rotate(1deg)}\n/* hero blob art */\n.hero-art{position:relative;display:flex;justify-content:center}\n.blob{\n  width:min(440px,80vw);animation:bob 6s ease-in-out infinite;\n}\n@keyframes bob{0%,100%{transform:translateY(0) rotate(0deg)}50%{transform:translateY(-16px) rotate(2deg)}}\n.spin-badge{\n  position:absolute;bottom:0;right:6%;width:110px;height:110px;\n  animation:spin 14s linear infinite;\n}\n@keyframes spin{to{transform:rotate(360deg)}}\n.floaty{position:absolute;animation:floaty 5s ease-in-out infinite}\n@keyframes floaty{0%,100%{transform:translateY(0)}50%{transform:translateY(-20px)}}\n\n/* stats strip */\n.stats{\n  display:flex;gap:0;margin-top:70px;flex-wrap:wrap;\n  border:3px solid var(--ink);border-radius:24px;overflow:hidden;\n  background:#fff;\n}\n.stat{\n  flex:1;min-width:160px;padding:22px 26px;\n  border-right:3px solid var(--ink);\n}\n.stat:last-child{border-right:none}\n.stat .num{font-family:'Baloo 2';font-weight:800;font-size:2rem;color:var(--coral)}\n.stat .lbl{font-size:.85rem;text-transform:uppercase;letter-spacing:.1em}\n\n/* ---------- TICKER ---------- */\n.ticker{\n  background:var(--ink);color:var(--cream);overflow:hidden;\n  padding:16px 0;transform:rotate(-1.2deg) scale(1.02);\n  margin:60px 0;border-top:4px solid var(--ink);border-bottom:4px solid var(--ink);\n}\n.ticker-track{display:flex;gap:0;white-space:nowrap;animation:scroll 22s linear infinite}\n.ticker span{\n  font-family:'Baloo 2';font-weight:700;font-size:1.3rem;\n  padding:0 28px;display:inline-flex;align-items:center;gap:28px;\n}\n.ticker .star{color:var(--sun)}\n@keyframes scroll{to{transform:translateX(-50%)}}\n\n/* ---------- EXHIBITS ---------- */\nsection{padding:80px 6vw}\n.sec-head{max-width:640px;margin-bottom:50px}\n.sec-head h2{font-size:clamp(2rem,4.5vw,3.2rem);font-weight:800;line-height:1.05}\n.sec-head p{margin-top:14px;line-height:1.6}\n.exhibits{\n  display:grid;grid-template-columns:repeat(12,1fr);gap:26px;\n}\n.ex-card{\n  border:3px solid var(--ink);border-radius:26px;overflow:hidden;\n  background:#fff;display:flex;flex-direction:column;\n  transition:transform .25s ease, box-shadow .25s ease;\n  box-shadow:0 0 0 rgba(0,0,0,0);\n}\n.ex-card:hover{transform:translateY(-8px) rotate(-1deg);box-shadow:8px 10px 0 var(--ink)}\n.ex-card .art{height:190px;position:relative;overflow:hidden;flex-shrink:0}\n.ex-card .art svg{width:100%;height:100%;display:block;transition:transform .4s}\n.ex-card:hover .art svg{transform:scale(1.06)}\n.ex-card .body{padding:22px 24px 26px;flex:1;display:flex;flex-direction:column;gap:10px}\n.tag{\n  align-self:flex-start;font-size:.72rem;font-weight:700;letter-spacing:.1em;\n  text-transform:uppercase;padding:5px 14px;border-radius:999px;\n  border:2px solid var(--ink);\n}\n.ex-card h3{font-size:1.5rem;font-weight:800}\n.ex-card p{font-size:.95rem;line-height:1.55;flex:1}\n.ex-card .link{\n  font-family:'Baloo 2';font-weight:700;color:var(--teal);\n  display:inline-flex;align-items:center;gap:6px;cursor:pointer;\n}\n.ex-card .link:hover{color:var(--coral)}\n.ex1{grid-column:span 5;transform:rotate(-1deg)}\n.ex2{grid-column:span 4;transform:rotate(1deg);margin-top:34px}\n.ex3{grid-column:span 3;transform:rotate(-.6deg);margin-top:-14px}\n.ex4{grid-column:span 4;margin-top:-24px}\n.ex5{grid-column:span 4;margin-top:10px;transform:rotate(1deg)}\n.ex6{grid-column:span 4;transform:rotate(-1deg);margin-top:-8px}\n@media(max-width:900px){\n  .ex1,.ex2,.ex3,.ex4,.ex5,.ex6{grid-column:span 12;margin-top:0;transform:none}\n}\n\n/* ---------- VISIT BANNER ---------- */\n.visit{\n  background:var(--teal);color:var(--cream);\n  border-top:4px solid var(--ink);border-bottom:4px solid var(--ink);\n  position:relative;overflow:hidden;\n}\n.visit .inner{\n  display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center;\n  max-width:1150px;margin:0 auto;\n}\n@media(max-width:860px){.visit .inner{grid-template-columns:1fr}}\n.visit h2{font-size:clamp(2rem,4vw,3rem);font-weight:800;line-height:1.05}\n.visit h2 em{color:var(--sun);font-style:normal}\n.visit p{margin:18px 0 28px;line-height:1.6;opacity:.92}\n.visit-list{list-style:none;display:flex;flex-direction:column;gap:16px}\n.visit-list li{\n  display:flex;gap:16px;align-items:flex-start;background:rgba(255,255,255,.08);\n  border:2px solid rgba(255,255,255,.35);border-radius:18px;padding:16px 20px;\n  transition:transform .2s, background .2s;\n}\n.visit-list li:hover{transform:translateX(8px);background:rgba(255,255,255,.15)}\n.visit-list .dot{\n  width:38px;height:38px;flex-shrink:0;border-radius:12px;\n  display:grid;place-items:center;font-family:'Baloo 2';font-weight:800;\n  background:var(--sun);color:var(--ink);\n}\n.visit-list b{font-family:'Baloo 2';font-size:1.05rem}\n.visit-list span{font-size:.9rem;opacity:.85}\n\n/* ---------- FOOTER ---------- */\nfooter{\n  background:var(--ink);color:var(--cream);padding:70px 6vw 30px;\n}\n.foot-top{\n  display:flex;justify-content:space-between;align-items:flex-start;gap:40px;\n  flex-wrap:wrap;padding-bottom:44px;border-bottom:2px dashed rgba(255,246,233,.3);\n}\n.foot-top h2{font-size:clamp(1.8rem,4vw,2.8rem);max-width:18ch;line-height:1.1}\n.foot-cols{display:flex;gap:70px;flex-wrap:wrap}\n.foot-cols h4{font-family:'Baloo 2';font-size:1.05rem;margin-bottom:14px;color:var(--sun)}\n.foot-cols a{display:block;color:var(--cream);text-decoration:none;opacity:.75;margin-bottom:10px;font-size:.92rem}\n.foot-cols a:hover{opacity:1;color:var(--sun)}\n.foot-bottom{\n  display:flex;justify-content:space-between;flex-wrap:wrap;gap:14px;\n  padding-top:26px;font-size:.82rem;opacity:.6;\n}\n</style>\n</head>\n<body>\n\n<nav>\n  <div class=\"logo\">\n    <svg viewBox=\"0 0 40 40\"><circle cx=\"20\" cy=\"20\" r=\"18\" fill=\"#FFC531\" stroke=\"#2B2118\" stroke-width=\"3\"/><circle cx=\"14\" cy=\"16\" r=\"3\" fill=\"#2B2118\"/><circle cx=\"26\" cy=\"16\" r=\"3\" fill=\"#2B2118\"/><path d=\"M13 25 Q20 31 27 25\" stroke=\"#2B2118\" stroke-width=\"3\" fill=\"none\" stroke-linecap=\"round\"/></svg>\n    Curiosity&nbsp;Lab\n  </div>\n  <div class=\"links\">\n    <a href=\"#exhibits\">Exhibits</a>\n    <a href=\"#visit\">Plan a Visit</a>\n    <a href=\"#footer\">For Schools</a>\n    <a href=\"#footer\" class=\"nav-cta\">Get Tickets</a>\n  </div>\n</nav>\n\n<!-- HERO -->\n<header class=\"hero\">\n  <div class=\"hero-grid\">\n    <div>\n      <div class=\"kicker\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\"><path d=\"M8 0l2 6 6 2-6 2-2 6-2-6-6-2 6-2z\" fill=\"#2B2118\"/></svg>\n        Now open \u00b7 Ages 0\u201312 &amp; their grown-ups\n      </div>\n      <h1>\n        Where questions<br>\n        get <span class=\"squig\">louder<span viewBox=\"0 0 200 16\" preserveAspectRatio=\"none\" style=\"position:absolute\"><svg viewBox=\"0 0 200 16\" preserveAspectRatio=\"none\"><path d=\"M2 10 Q20 2 40 10 T80 10 T120 10 T160 10 T198 10\" stroke=\"#FF5C39\" stroke-width=\"6\" fill=\"none\" stroke-linecap=\"round\"/></svg></span></span><br>\n        than the answers.\n      </h1>\n      <p>A hands-on science museum built at kid height. Touch the tornado, climb the skeleton, launch the rocket \u2014 and yes, you can press that big red button.</p>\n      <div class=\"btn-row\">\n        <a href=\"#exhibits\" class=\"btn btn-primary\">Explore the Lab\n          <svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\"><path d=\"M3 9h11M9 3l6 6-6 6\" stroke=\"#fff\" stroke-width=\"2.5\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n        </a>\n        <a href=\"#visit\" class=\"btn btn-ghost\">Plan a visit</a>\n      </div>\n    </div>\n\n    <div class=\"hero-art\">\n      <!-- floating bubbles -->\n      <svg class=\"floaty\" style=\"top:4%;left:0\" width=\"54\" height=\"54\" viewBox=\"0 0 54 54\">\n        <circle cx=\"27\" cy=\"27\" r=\"24\" fill=\"#BFE3E0\" stroke=\"#2B2118\" stroke-width=\"3\"/>\n        <circle cx=\"19\" cy=\"19\" r=\"5\" fill=\"#fff\"/>\n      </svg>\n      <svg class=\"floaty\" style=\"top:10%;right:4%;animation-delay:1s\" width=\"44\" height=\"44\" viewBox=\"0 0 44 44\">\n        <path d=\"M22 2l5 15 15 5-15 5-5 15-5-15-15-5 15-5z\" fill=\"#FF8FA3\" stroke=\"#2B2118\" stroke-width=\"3\" stroke-linejoin=\"round\"/>\n      </svg>\n      <svg class=\"floaty\" style=\"top:58%;left:-6%;animation-delay:2s\" width=\"46\" height=\"46\" viewBox=\"0 0 46 46\">\n        <circle cx=\"23\" cy=\"23\" r=\"20\" fill=\"#FFC531\" stroke=\"#2B2118\" stroke-width=\"3\"/>\n        <circle cx=\"23\" cy=\"23\" r=\"9\" fill=\"#fff\"/>\n      </svg>\n\n      <!-- main blob illustration: kid scientist -->\n      <svg class=\"blob\" viewBox=\"0 0 440 420\">\n        <path d=\"M220 15c95 0 200 60 200 190s-90 200-200 200S20 340 20 205 125 15 220 15z\" fill=\"#FF5C39\" stroke=\"#2B2118\" stroke-width=\"5\"/>\n        <!-- head -->\n        <circle cx=\"220\" cy=\"165\" r=\"72\" fill=\"#FFF6E9\" stroke=\"#2B2118\" stroke-width=\"5\"/>\n        <!-- goggles -->\n        <circle cx=\"196\" cy=\"155\" r=\"20\" fill=\"#BFE3E0\" stroke=\"#2B2118\" stroke-width=\"5\"/>\n        <circle cx=\"248\" cy=\"155\" r=\"20\" fill=\"#BFE3E0\" stroke=\"#2B2118\" stroke-width=\"5\"/>\n        <line x1=\"216\" y1=\"155\" x2=\"228\" y2=\"155\" stroke=\"#2B2118\" stroke-width=\"5\"/>\n        <circle cx=\"192\" cy=\"150\" r=\"5\" fill=\"#fff\"/>\n        <circle cx=\"244\" cy=\"150\" r=\"5\" fill=\"#fff\"/>\n        <!-- smile -->\n        <path d=\"M198 195 Q220 214 244 194\" stroke=\"#2B2118\" stroke-width=\"5\" fill=\"none\" stroke-linecap=\"round\"/>\n        <!-- hair sprout -->\n        <path d=\"M220 93 Q222 72 210 62 M220 93 Q230 70 244 68\" stroke=\"#2B2118\" stroke-width=\"5\" fill=\"none\" stroke-linecap=\"round\"/>\n        <!-- lab coat body -->\n        <path d=\"M150 395 Q160 280 220 275 Q280 280 290 395 Z\" fill=\"#fff\" stroke=\"#2B2118\" stroke-width=\"5\"/>\n        <line x1=\"220\" y1=\"278\" x2=\"220\" y2=\"340\" stroke=\"#2B2118\" stroke-width=\"4\"/>\n        <!-- arms -->\n        <path d=\"M158 310 Q115 300 100 262\" stroke=\"#2B2118\" stroke-width=\"5\" fill=\"none\" stroke-linecap=\"round\"/>\n        <path d=\"M282 310 Q330 305 350 268\" stroke=\"#2B2118\" stroke-width=\"5\" fill=\"none\" stroke-linecap=\"round\"/>\n        <circle cx=\"98\" cy=\"256\" r=\"13\" fill=\"#FFC531\" stroke=\"#2B2118\" stroke-width=\"4\"/>\n        <circle cx=\"353\" cy=\"262\" r=\"13\" fill=\"#FFC531\" stroke=\"#2B2118\" stroke-width=\"4\"/>\n        <!-- flask in left hand -->\n        <path d=\"M88 240 h20 v10 l12 24 a8 8 0 0 1-8 10 h-28 a8 8 0 0 1-8-10 l12-24 z\" fill=\"#BFE3E0\" stroke=\"#2B2118\" stroke-width=\"4\" stroke-linejoin=\"round\"/>\n        <path d=\"M78 268 h40 l6 12 a6 6 0 0 1-6 8 h-40 a6 6 0 0 1-6-8 z\" fill=\"#0E8A7B\" stroke=\"#2B2118\" stroke-width=\"4\" stroke-linejoin=\"round\"/>\n        <!-- bubbles from flask -->\n        <circle cx=\"92\" cy=\"228\" r=\"4\" fill=\"#0E8A7B\"/>\n        <circle cx=\"104\" cy=\"214\" r=\"6\" fill=\"#0E8A7B\"/>\n        <circle cx=\"90\" cy=\"200\" r=\"5\" fill=\"#0E8A7B\"/>\n        <!-- sparkles right -->\n        <path d=\"M368 190 l4 12 12 4-12 4-4 12-4-12-12-4 12-4z\" fill=\"#FFC531\" stroke=\"#2B2118\" stroke-width=\"3\" stroke-linejoin=\"round\"/>\n        <path d=\"M398 232 l3 9 9 3-9 3-3 9-3-9-9-3 9-3z\" fill=\"#FF8FA3\" stroke=\"#2B2118\" stroke-width=\"3\" stroke-linejoin=\"round\"/>\n        <!-- pocket -->\n        <rect x=\"240\" y=\"320\" width=\"34\" height=\"30\" rx=\"6\" fill=\"#FFF6E9\" stroke=\"#2B2118\" stroke-width=\"4\"/>\n        <path d=\"M250 335 l4 6 8-12\" stroke=\"#0E8A7B\" stroke-width=\"4\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n      </svg>\n\n      <!-- rotating badge -->\n      <svg class=\"spin-badge\" viewBox=\"0 0 110 110\">\n        <defs><path id=\"circ\" d=\"M55,55 m-40,0 a40,40 0 1,1 80,0 a40,40 0 1,1 -80,0\"/></defs>\n        <circle cx=\"55\" cy=\"55\" r=\"52\" fill=\"#FFC531\" stroke=\"#2B2118\" stroke-width=\"4\"/>\n        <text font-family=\"'Baloo 2'\" font-weight=\"800\" font-size=\"13.5\" fill=\"#2B2118\">\n          <textPath href=\"#circ\">HANDS ON \u00b7 MINDS ON \u00b7 HANDS ON \u00b7</textPath>\n        </text>\n        <path d=\"M55 38l4.5 12 12.5.8-9.5 8 3 12.2L55 64l-10.5 7 3-12.2-9.5-8 12.5-.8z\" fill=\"#FF5C39\" stroke=\"#2B2118\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n      </svg>\n    </div>\n  </div>\n\n  <div class=\"stats\">\n    <div class=\"stat\"><div class=\"num\">72k</div><div class=\"lbl\">Little scientists a year</div></div>\n    <div class=\"stat\"><div class=\"num\">40+</div><div class=\"lbl\">Hands-on exhibits</div></div>\n    <div class=\"stat\"><div class=\"num\">0</div><div class=\"lbl\">\"Do not touch\" signs</div></div>\n    <div class=\"stat\"><div class=\"num\">\u221e</div><div class=\"lbl\">Questions per visit</div></div>\n  </div>\n</header>\n\n<!-- TICKER -->\n<div class=\"ticker\" aria-hidden=\"true\">\n  <div class=\"ticker-track\" id=\"ticker\"></div>\n</div>\n\n<!-- EXHIBITS -->\n<section id=\"exhibits\">\n  <div class=\"sec-head\">\n    <div class=\"kicker\" style=\"background:var(--pink)\">The Zones</div>\n    <h2 style=\"margin-top:14px\">Six rooms.<br>Zero sitting still.</h2>\n    <p>Every exhibit was tested by an actual panel of six-year-olds with permission to be as curious as they want.</p>\n  </div>\n\n  <div class=\"exhibits\">\n    <!-- Water Works -->\n    <article class=\"ex-card ex1\">\n      <div class=\"art\" style=\"background:#BFE3E0\">\n        <svg viewBox=\"0 0 500 190\" preserveAspectRatio=\"xMidYMid slice\">\n          <path d=\"M0 130 Q60 100 120 130 T240 130 T360 130 T480 130 T600 130 V190 H0 Z\" fill=\"#0E8A7B\"/>\n          <path d=\"M0 145 Q60 118 120 145 T240 145 T360 145 T480 145 T600 145 V190 H0 Z\" fill=\"#2AA99A\" opacity=\".7\"/>\n          <!-- dam wheels -->\n          <circle cx=\"130\" cy=\"80\" r=\"34\" fill=\"none\" stroke=\"#2B2118\" stroke-width=\"5\"/>\n          <g stroke=\"#2B2118\" stroke-width=\"5\">\n            <line x1=\"130\" y1=\"46\" x2=\"130\" y2=\"114\"/><line x1=\"96\" y1=\"80\" x2=\"164\" y2=\"80\"/>\n            <line x1=\"106\" y1=\"56\" x2=\"154\" y2=\"104\"/><line x1=\"154\" y1=\"56\" x2=\"106\" y2=\"104\"/>\n          </g>\n          <circle cx=\"130\" cy=\"80\" r=\"9\" fill=\"#FFC531\" stroke=\"#2B2118\" stroke-width=\"4\"/>\n          <!-- pipe + drops -->\n          <path d=\"M300 40 h70 v50 q0 12 -14 12 h-42 q-14 0 -14 -12 z\" fill=\"#fff\" stroke=\"#2B2118\" stroke-width=\"5\"/>\n          <circle cx=\"335\" cy=\"130\" r=\"7\" fill=\"#0E8A7B\" stroke=\"#2B2118\" stroke-width=\"3\"/>\n          <circle cx=\"355\" cy=\"158\" r=\"5\" fill=\"#0E8A7B\" stroke=\"#2B2118\" stroke-width=\"3\"/>\n          <circle cx=\"318\" cy=\"165\" r=\"4\" fill=\"#0E8A7B\" stroke=\"#2B2118\" stroke-width=\"3\"/>\n          <!-- duck -->\n          <path d=\"M430 120 q22 -20 40 -2 q14 -4 16 8 q-2 12 -18 12 h-40 q-8 0 -8 -9 q0 -9 10 -9z\" fill=\"#FFC531\" stroke=\"#2B2118\" stroke-width=\"4\"/>\n          <circle cx=\"458\" cy=\"112\" r=\"3\" fill=\"#2B2118\"/>\n        </svg>\n      </div>\n      <div class=\"body\">\n        <span class=\"tag\" style=\"background:#BFE3E0\">Physics \u00b7 Ages 4+</span>\n        <h3>Water Works</h3>\n        <p>Build dams, race rubber ducks through rapids, and crank the giant Archimedes screw. Waterproof aprons provided \u2014 splashing is the point.</p>\n        <span class=\"link\">See the zone <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\"><path d=\"M2 7h9M7 2l5 5-5 5\" stroke=\"currentColor\" stroke-width=\"2.5\" fill=\"none\" stroke-linecap=\"round\"/></svg></span>\n      </div>\n    </article>\n\n    <!-- Space Loft -->\n    <article class=\"ex-card ex2\">\n      <div class=\"art\" style=\"background:#2B2118\">\n        <svg viewBox=\"0 0 420 190\" preserveAspectRatio=\"xMidYMid slice\">\n          <circle cx=\"60\" cy=\"40\" r=\"2.5\" fill=\"#FFF6E9\"/><circle cx=\"150\" cy=\"90\" r=\"2\" fill=\"#FFF6E9\"/>\n          <circle cx=\"330\" cy=\"30\" r=\"2.5\" fill=\"#FFF6E9\"/><circle cx=\"390\" cy=\"120\" r=\"2\" fill=\"#FFF6E9\"/>\n          <circle cx=\"250\" cy=\"140\" r=\"2\" fill=\"#FFF6E9\"/><circle cx=\"100\" cy=\"160\" r=\"2.5\" fill=\"#FFF6E9\"/>\n          <!-- rocket -->\n          <g transform=\"translate(200,95) rotate(12)\">\n            <path d=\"M0 -70 Q26 -35 26 15 Q26 25 16 25 h-32 q-10 0 -10 -25 Q-26 -35 0 -70z\" fill=\"#FF5C39\" stroke=\"#FFF6E9\" stroke-width=\"4\"/>\n            <circle cx=\"0\" cy=\"-25\" r=\"12\" fill=\"#BFE3E0\" stroke=\"#FFF6E9\" stroke-width=\"4\"/>\n            <path d=\"M-26 5 L-44 35 L-24 30 Z M26 5 L44 35 L24 30 Z\" fill=\"#FFC531\" stroke=\"#FFF6E9\" stroke-width=\"4\" stroke-linejoin=\"round\"/>\n            <path d=\"M-12 26 Q0 58 12 26 Q6 40 0 40 Q-6 40 -12 26z\" fill=\"#FFC531\" stroke=\"#FFF6E9\" stroke-width=\"3\" stroke-linejoin=\"round\"/>\n          </g>\n          <!-- planet -->\n          <circle cx=\"80\" cy=\"130\" r=\"26\" fill=\"#FF8FA3\" stroke=\"#FFF6E9\" stroke-width=\"3\"/>\n          <ellipse cx=\"80\" cy=\"130\" rx=\"42\" ry=\"10\" fill=\"none\" stroke=\"#FFC531\" stroke-width=\"4\"/>\n        </svg>\n      </div>\n      <div class=\"body\">\n        <span class=\"tag\" style=\"background:#FFC531\">Astronomy \u00b7 Ages 5+</span>\n        <h3>The Space Loft</h3>\n        <p>Strap into a rope-and-pulley \"mission\" to deliver cargo across the ceiling of the museum. Zero gravity, 100% teamwork.</p>\n        <span class=\"link\">See the zone <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\"><path d=\"M2 7h9M7 2l5 5-5 5\" stroke=\"currentColor\" stroke-width=\"2.5\" fill=\"none\" stroke-linecap=\"round\"/></svg></span>\n      </div>\n    </article>\n\n    <!-- Tiny Lab -->\n    <article class=\"ex-card ex3\">\n      <div class=\"art\" style=\"background:#FFC531\">\n        <svg viewBox=\"0 0 300 190\" preserveAspectRatio=\"xMidYMid slice\">\n          <rect x=\"40\" y=\"70\" width=\"220\" height=\"14\" rx=\"7\" fill=\"#2B2118\"/>\n          <!-- beakers on shelf -->\n          <path d=\"M90 30 h22 v8 l12 22 a6 6 0 0 1-6 8 h-34 a6 6 0 0 1-6-8 l12-22z\" fill=\"#fff\" stroke=\"#2B2118\" stroke-width=\"4\" stroke-linejoin=\"round\"/>\n          <path d=\"M82 58 h38 l3 6 a4 4 0 0 1-4 5 h-36 a4 4 0 0 1-4-5z\" fill=\"#FF5C39\"/>\n          <rect x=\"150\" y=\"34\" width=\"26\" height=\"42\" rx=\"5\" fill=\"#BFE3E0\" stroke=\"#2B2118\" stroke-width=\"4\"/>\n          <rect x=\"150\" y=\"56\" width=\"26\" height=\"20\" rx=\"4\" fill=\"#0E8A7B\"/>\n          <path d=\"M226 34 l14 42 h-28z\" fill=\"#FF8FA3\" stroke=\"#2B2118\" stroke-width=\"4\" stroke-linejoin=\"round\"/>\n          <!-- bubbles -->\n          <circle cx=\"98\" cy=\"22\" r=\"4\" fill=\"#FF5C39\"/><circle cx=\"163\" cy=\"26\" r=\"4\" fill=\"#0E8A7B\"/>\n          <circle cx=\"222\" cy=\"26\" r=\"4\" fill=\"#FF8FA3\"/>\n        </svg>\n      </div>\n      <div class=\"body\">\n        <span class=\"tag\" style=\"background:#FF8FA3\">Chemistry \u00b7 Ages 0\u20135</span>\n        <h3>Tiny Lab</h3>\n        <p>Soft blocks, big magnifiers and squishy \"molecules\" for our smallest visitors. Grown-ups kneel \u2014 everything is toddler-height.</p>\n        <span class=\"link\">See the zone <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\"><path d=\"M2 7h9M7 2l5 5-5 5\" stroke=\"currentColor\" stroke-width=\"2.5\" fill=\"none\" stroke-linecap=\"round\"/></svg></span>\n      </div>\n    </article>\n\n    <!-- Creature Corner -->\n    <article class=\"ex-card ex4\">\n      <div class=\"art\" style=\"background:#0E8A7B\">\n        <svg viewBox=\"0 0 420 190\" preserveAspectRatio=\"xMidYMid slice\">\n          <!-- ant -->\n          <g transform=\"translate(120,100)\">\n            <ellipse cx=\"0\" cy=\"0\" rx=\"24\" ry=\"17\" fill=\"#FF5C39\" stroke=\"#2B2118\" stroke-width=\"4\"/>\n            <ellipse cx=\"30\" cy=\"-8\" rx=\"15\" ry=\"12\" fill=\"#FF5C39\" stroke=\"#2B2118\" stroke-width=\"4\"/>\n            <ellipse cx=\"52\" cy=\"-16\" rx=\"10\" ry=\"8\" fill=\"#FF5C39\" stroke=\"#2B2118\" stroke-width=\"4\"/>\n            <path d=\"M56 -22 q10 -16 22 -14 M58 -18 q16 -8 26 0\" stroke=\"#2B2118\" stroke-width=\"3.5\" fill=\"none\" stroke-linecap=\"round\"/>\n            <path d=\"M-6 14 l-6 20 M10 16 l2 20 M26 4 l14 14\" stroke=\"#2B2118\" stroke-width=\"3.5\" stroke-linecap=\"round\"/>\n          </g>\n          <!-- leaf -->\n          <path d=\"M300 40 q50 -10 70 30 q-50 14 -70 -30z\" fill=\"#BFE3E0\" stroke=\"#2B2118\" stroke-width=\"4\"/>\n          <line x1=\"308\" y1=\"66\" x2=\"360\" y2=\"48\" stroke=\"#2B2118\" stroke-width=\"3.5\"/>\n          <circle cx=\"350\" cy=\"140\" r=\"20\" fill=\"none\" stroke=\"#FFF6E9\" stroke-width=\"4\"/>\n          <circle cx=\"350\" cy=\"140\" r=\"20\" fill=\"none\" stroke=\"#FFF6E9\" stroke-width=\"4\" stroke-dasharray=\"6 8\"/>\n        </svg>\n      </div>\n      <div class=\"body\">\n        <span class=\"tag\" style=\"background:#BFE3E0\">Biology \u00b7 All ages</span>\n        <h3>Creature Corner</h3>\n        <p>Meet our stick insects, watch a bee highway buzz overhead, and crawl through the ant-vision tunnel \u2014 the world, six inches tall.</p>\n        <span class=\"link\">See the zone <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\"><path d=\"M2 7h9M7 2l5 5-5 5\" stroke=\"currentColor\" stroke-width=\"2.5\" fill=\"none\" stroke-linecap=\"round\"/></svg></span>\n      </div>\n    </article>\n\n    <!-- Sound Stair -->\n    <article class=\"ex-card ex5\">\n      <div class=\"art\" style=\"background:#FF8FA3\">\n        <svg viewBox=\"0 0 420 190\" preserveAspectRatio=\"xMidYMid slice\">\n          <g fill=\"#FFF6E9\" stroke=\"#2B2118\" stroke-width=\"4\">\n            <rect x=\"50\" y=\"130\" width=\"44\" height=\"46\" rx=\"6\"/>\n            <rect x=\"106\" y=\"106\" width=\"44\" height=\"70\" rx=\"6\"/>\n            <rect x=\"162\" y=\"80\" width=\"44\" height=\"96\" rx=\"6\"/>\n            <rect x=\"218\" y=\"54\" width=\"44\" height=\"122\" rx=\"6\"/>\n          </g>\n          <!-- sound waves -->\n          <path d=\"M300 60 q18 32 0 64 M318 44 q28 48 0 96 M336 28 q40 64 0 128\" stroke=\"#2B2118\" stroke-width=\"4.5\" fill=\"none\" stroke-linecap=\"round\"/>\n          <circle cx=\"76\" cy=\"118\" r=\"5\" fill=\"#2B2118\"/><circle cx=\"132\" cy=\"94\" r=\"5\" fill=\"#2B2118\"/>\n          <circle cx=\"188\" cy=\"68\" r=\"5\" fill=\"#2B2118\"/><circle cx=\"244\" cy=\"42\" r=\"5\" fill=\"#2B2118\"/>\n        </svg>\n      </div>\n      <div class=\"body\">\n        <span class=\"tag\" style=\"background:#FF5C39;color:#fff\">Sound \u00b7 Ages 3+</span>\n        <h3>The Sound Stair</h3>\n        <p>Every step plays a note. Climb a scale, stomp a drumline, then conduct the whole room from the giant podium up top.</p>\n        <span class=\"link\">See the zone <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\"><path d=\"M2 7h9M7 2l5 5-5 5\" stroke=\"currentColor\" stroke-width=\"2.5\" fill=\"none\" stroke-linecap=\"round\"/></svg></span>\n      </div>\n    </article>\n\n    <!-- Maker Garage -->\n    <article class=\"ex-card ex6\">\n      <div class=\"art\" style=\"background:#2AA99A\">\n        <svg viewBox=\"0 0 420 190\" preserveAspectRatio=\"xMidYMid slice\">\n          <!-- robot -->\n          <rect x=\"140\" y=\"60\" width=\"80\" height=\"66\" rx=\"14\" fill=\"#FFF6E9\" stroke=\"#2B2118\" stroke-width=\"4.5\"/>\n          <rect x=\"158\" y=\"80\" width=\"44\" height=\"26\" rx=\"6\" fill=\"#BFE3E0\" stroke=\"#2B2118\" stroke-width=\"4\"/>\n          <circle cx=\"170\" cy=\"93\" r=\"4\" fill=\"#2B2118\"/><circle cx=\"190\" cy=\"93\" r=\"4\" fill=\"#2B2118\"/>\n          <line x1=\"180\" y1=\"60\" x2=\"180\" y2=\"42\" stroke=\"#2B2118\" stroke-width=\"4.5\"/>\n          <circle cx=\"180\" cy=\"36\" r=\"8\" fill=\"#FFC531\" stroke=\"#2B2118\" stroke-width=\"4\"/>\n          <path d=\"M140 76 h-24 M220 76 h24\" stroke=\"#2B2118\" stroke-width=\"4.5\" stroke-linecap=\"round\"/>\n          <circle cx=\"112\" cy=\"76\" r=\"8\" fill=\"#FF8FA3\" stroke=\"#2B2118\" stroke-width=\"4\"/>\n          <circle cx=\"248\" cy=\"76\" r=\"8\" fill=\"#FF8FA3\" stroke=\"#2B2118\" stroke-width=\"4\"/>\n          <rect x=\"158\" y=\"126\" width=\"16\" height=\"34\" fill=\"#2B2118\"/><rect x=\"186\" y=\"126\" width=\"16\" height=\"34\" fill=\"#2B2118\"/>\n          <!-- gears -->\n          <g stroke=\"#2B2118\" stroke-width=\"4\">\n            <circle cx=\"330\" cy=\"80\" r=\"26\" fill=\"#FFC531\"/><circle cx=\"330\" cy=\"80\" r=\"9\" fill=\"#2AA99A\"/>\n            <g stroke-linecap=\"round\"><line x1=\"330\" y1=\"48\" x2=\"330\" y2=\"58\"/><line x1=\"330\" y1=\"102\" x2=\"330\" y2=\"112\"/><line x1=\"298\" y1=\"80\" x2=\"308\" y2=\"80\"/><line x1=\"352\" y1=\"80\" x2=\"362\" y2=\"80\"/><line x1=\"307\" y1=\"57\" x2=\"314\" y2=\"64\"/><line x1=\"346\" y1=\"96\" x2=\"353\" y2=\"103\"/><line x1=\"307\" y1=\"103\" x2=\"314\" y2=\"96\"/><line x1=\"346\" y1=\"64\" x2=\"353\" y2=\"57\"/></g>\n            <circle cx=\"292\" cy=\"130\" r=\"18\" fill=\"#FF5C39\"/><circle cx=\"292\" cy=\"130\" r=\"6\" fill=\"#FFF6E9\"/>\n          </g>\n        </svg>\n      </div>\n      <div class=\"body\">\n        <span class=\"tag\" style=\"background:#FFF6E9\">Engineering \u00b7 Ages 6+</span>\n        <h3>Maker Garage</h3>\n        <p>Real tools, real wood, real wobble. Build a marble machine, test it, fix it, break it \u2014 then build it weirder.</p>\n        <span class=\"link\">See the zone <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\"><path d=\"M2 7h9M7 2l5 5-5 5\" stroke=\"currentColor\" stroke-width=\"2.5\" fill=\"none\" stroke-linecap=\"round\"/></svg></span>\n      </div>\n    </article>\n  </div>\n</section>\n\n<!-- VISIT -->\n<section class=\"visit\" id=\"visit\">\n  <div class=\"inner\">\n    <div>\n      <h2>Everything <em>glows</em> brighter when a kid figures it out.</h2>\n      <p>Open Tuesday through Sunday, 9am\u20135pm. Weekends get busy \u2014 book ahead and skip the line straight to the bubbles.</p>\n      <a href=\"#footer\" class=\"btn btn-primary\" style=\"background:var(--sun);color:var(--ink);box-shadow:0 6px 0 #c79200\">Book tickets</a>\n    </div>\n    <ul class=\"visit-list\">\n      <li><span class=\"dot\">1</span><div><b>Where</b><br><span>42 Wonder Wharf, by the old carousel \u2014 there's a giant orange arch, you can't miss it.</span></div></li>\n      <li><span class=\"dot\">2</span><div><b>When</b><br><span>Tue\u2013Sun, 9:00\u201317:00. Quiet mornings for sensory-friendly visits on first Sundays.</span></div></li>\n      <li><span class=\"dot\">3</span><div><b>How much</b><br><span>Kids $9, grown-ups $12, under-twos free. School trips are always free.</span></div></li>\n      <li><span class=\"dot\">4</span><div><b>Bring</b><br><span>Spare socks for the climb zone and a question you can't answer yet.</span></div></li>\n    </ul>\n  </div>\n</section>\n\n<!-- FOOTER -->\n<footer id=\"footer\">\n  <div class=\"foot-top\">\n    <h2>Still curious? Good. That's the whole idea.</h2>\n    <div class=\"foot-cols\">\n      <div>\n        <h4>Visit</h4>\n        <a href=\"#visit\">Tickets &amp; hours</a>\n        <a href=\"#visit\">Getting here</a>\n        <a href=\"#visit\">Accessibility</a>\n      </div>\n      <div>\n        <h4>Learn</h4>\n        <a href=\"#exhibits\">School programs</a>\n        <a href=\"#exhibits\">Birthday labs</a>\n        <a href=\"#exhibits\">Camps</a>\n      </div>\n      <div>\n        <h4>Us</h4>\n        <a href=\"#\">About</a>\n        <a href=\"#\">Volunteer</a>\n        <a href=\"#\">Contact</a>\n      </div>\n    </div>\n  </div>\n  <div class=\"foot-bottom\">\n    <span>\u00a9 2025 Curiosity Lab Children's Science Museum</span>\n    <span>Made with glue sticks and good questions.</span>\n  </div>\n</footer>\n\n<script>\n// build ticker (duplicated for seamless loop)\nconst items = [\"Touch everything\",\"Ask why twice\",\"Bubbles at 2pm\",\"Splashes welcome\",\"Grown-ups must be supervised\",\"Big red button works\"];\nconst track = document.getElementById('ticker');\nconst half = items.map(t=>`<span>${t}<svg class=\"star\" width=\"16\" height=\"16\" viewBox=\"0 0 16 16\"><path d=\"M8 0l2 6 6 2-6 2-2 6-2-6-6-2 6-2z\" fill=\"currentColor\"/></svg></span>`).join('');\ntrack.innerHTML = half + half;\n\n// gentle parallax on hero floaties\ndocument.addEventListener('mousemove', e=>{\n  const x = (e.clientX/innerWidth - .5), y = (e.clientY/innerHeight - .5);\n  document.querySelectorAll('.floaty').forEach((el,i)=>{\n    const f = (i+1)*6;\n    el.style.translate = `${x*f}px ${y*f}px`;\n  });\n});\n</script>\n</body>\n</html>\n"}