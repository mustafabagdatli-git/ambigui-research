{"brief": "B2", "model": "anthropic/claude-haiku-5.5", "i": 0, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Spark! Children's Science Museum</title>\n<meta name=\"description\" content=\"A hands-on science museum for curious kids. Experiment, build, explore, and discover.\">\n<style>\n  :root {\n    --navy: #1b2a52;\n    --navy-deep: #111b38;\n    --sun: #ffc83d;\n    --coral: #ff6b5b;\n    --teal: #2ec4b6;\n    --violet: #7c5cff;\n    --mint: #bff3e6;\n    --cream: #fff8ec;\n    --white: #ffffff;\n    --ink: #22304f;\n    --muted: #5d6b8a;\n    --radius: 24px;\n    --shadow: 0 12px 30px rgba(27, 42, 82, 0.12);\n  }\n\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  html { scroll-behavior: smooth; }\n\n  body {\n    font-family: \"Trebuchet MS\", \"Avenir Next\", \"Segoe UI\", system-ui, sans-serif;\n    color: var(--ink);\n    background: var(--cream);\n    line-height: 1.6;\n    overflow-x: hidden;\n  }\n\n  img, svg { display: block; max-width: 100%; }\n  a { color: inherit; text-decoration: none; }\n\n  .container {\n    width: min(1160px, 92%);\n    margin-inline: auto;\n  }\n\n  h1, h2, h3 {\n    font-family: \"Arial Rounded MT Bold\", \"Trebuchet MS\", system-ui, sans-serif;\n    line-height: 1.15;\n    color: var(--navy);\n  }\n\n  h1 { font-size: clamp(2.6rem, 6vw, 4.6rem); letter-spacing: -0.02em; }\n  h2 { font-size: clamp(2rem, 4vw, 2.9rem); letter-spacing: -0.01em; }\n  h3 { font-size: 1.35rem; }\n\n  .eyebrow {\n    display: inline-block;\n    font-weight: 700;\n    font-size: 0.85rem;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    color: var(--coral);\n    margin-bottom: 0.8rem;\n  }\n\n  .section { padding: clamp(4rem, 9vw, 7rem) 0; }\n  .section-head { text-align: center; max-width: 640px; margin: 0 auto 3.5rem; }\n  .section-head p { color: var(--muted); margin-top: 1rem; font-size: 1.1rem; }\n\n  /* Buttons */\n  .btn {\n    display: inline-flex;\n    align-items: center;\n    gap: 0.5rem;\n    padding: 0.95rem 1.7rem;\n    border-radius: 999px;\n    font-weight: 700;\n    font-size: 1rem;\n    border: 3px solid transparent;\n    cursor: pointer;\n    transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;\n    font-family: inherit;\n  }\n  .btn:hover { transform: translateY(-3px); }\n  .btn:focus-visible, .nav-links a:focus-visible, .toggle:focus-visible, input:focus-visible {\n    outline: 3px solid var(--violet);\n    outline-offset: 3px;\n  }\n  .btn-primary { background: var(--coral); color: var(--white); box-shadow: 0 8px 0 #d4493d; }\n  .btn-primary:hover { box-shadow: 0 11px 0 #d4493d; }\n  .btn-sun { background: var(--sun); color: var(--navy); box-shadow: 0 8px 0 #d9a520; }\n  .btn-sun:hover { box-shadow: 0 11px 0 #d9a520; }\n  .btn-ghost { background: transparent; color: var(--navy); border-color: var(--navy); }\n  .btn-ghost:hover { background: var(--navy); color: var(--white); }\n  .btn-small { padding: 0.6rem 1.2rem; font-size: 0.95rem; }\n\n  /* Header */\n  header {\n    position: sticky;\n    top: 0;\n    z-index: 50;\n    background: rgba(255, 248, 236, 0.92);\n    backdrop-filter: blur(10px);\n    border-bottom: 1px solid rgba(27, 42, 82, 0.08);\n  }\n  .nav {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    height: 76px;\n  }\n  .logo {\n    display: flex;\n    align-items: center;\n    gap: 0.6rem;\n    font-family: \"Arial Rounded MT Bold\", system-ui, sans-serif;\n    font-size: 1.5rem;\n    color: var(--navy);\n  }\n  .logo-mark { width: 42px; height: 42px; }\n  .nav-links {\n    display: flex;\n    gap: 2rem;\n    list-style: none;\n    font-weight: 700;\n  }\n  .nav-links a {\n    position: relative;\n    color: var(--navy);\n    padding: 0.3rem 0;\n  }\n  .nav-links a::after {\n    content: \"\";\n    position: absolute;\n    left: 0; bottom: -4px;\n    width: 0; height: 3px;\n    border-radius: 3px;\n    background: var(--coral);\n    transition: width 0.2s ease;\n  }\n  .nav-links a:hover::after { width: 100%; }\n  .nav-cta { display: flex; align-items: center; gap: 1rem; }\n  .toggle {\n    display: none;\n    background: none;\n    border: none;\n    cursor: pointer;\n    padding: 0.4rem;\n  }\n  .toggle span {\n    display: block;\n    width: 26px; height: 3px;\n    background: var(--navy);\n    margin: 5px 0;\n    border-radius: 2px;\n  }\n\n  /* Hero */\n  .hero {\n    position: relative;\n    padding: clamp(3rem, 7vw, 6rem) 0 clamp(4rem, 8vw, 7rem);\n    overflow: hidden;\n    background:\n      radial-gradient(circle at 15% 20%, rgba(255, 200, 61, 0.35) 0, transparent 35%),\n      radial-gradient(circle at 85% 30%, rgba(46, 196, 182, 0.28) 0, transparent 40%),\n      var(--cream);\n  }\n  .hero-grid {\n    display: grid;\n    grid-template-columns: 1.1fr 1fr;\n    gap: 3rem;\n    align-items: center;\n  }\n  .hero p.lead {\n    font-size: 1.2rem;\n    color: var(--muted);\n    margin: 1.5rem 0 2.2rem;\n    max-width: 520px;\n  }\n  .hero-actions { display: flex; flex-wrap: wrap; gap: 1rem; }\n  .hero-badges {\n    display: flex;\n    gap: 0.6rem;\n    flex-wrap: wrap;\n    margin-top: 2.2rem;\n  }\n  .badge {\n    background: var(--white);\n    border-radius: 999px;\n    padding: 0.45rem 1rem;\n    font-size: 0.9rem;\n    font-weight: 700;\n    color: var(--navy);\n    box-shadow: var(--shadow);\n  }\n  .hero-art {\n    position: relative;\n    aspect-ratio: 1;\n    width: 100%;\n    max-width: 520px;\n    justify-self: center;\n  }\n  .hero-art svg { width: 100%; height: 100%; }\n  .float { animation: float 6s ease-in-out infinite; }\n  .float.delay { animation-delay: -3s; }\n  .spin { transform-origin: 260px 260px; animation: spin 24s linear infinite; }\n  .bob { animation: bob 4s ease-in-out infinite; }\n  @keyframes float {\n    0%, 100% { transform: translateY(0); }\n    50% { transform: translateY(-14px); }\n  }\n  @keyframes bob {\n    0%, 100% { transform: translateY(0) rotate(-3deg); }\n    50% { transform: translateY(-8px) rotate(3deg); }\n  }\n  @keyframes spin {\n    to { transform: rotate(360deg); }\n  }\n\n  /* Info strip */\n  .strip {\n    background: var(--navy);\n    color: var(--white);\n    padding: 1.2rem 0;\n  }\n  .strip-inner {\n    display: flex;\n    justify-content: space-around;\n    flex-wrap: wrap;\n    gap: 1rem;\n    font-weight: 700;\n    text-align: center;\n  }\n  .strip-inner span { color: var(--sun); }\n\n  /* Exhibits */\n  .exhibits-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));\n    gap: 1.6rem;\n  }\n  .exhibit {\n    background: var(--white);\n    border-radius: var(--radius);\n    padding: 2rem;\n    box-shadow: var(--shadow);\n    position: relative;\n    transition: transform 0.25s ease;\n    border: 3px solid transparent;\n  }\n  .exhibit:hover { transform: translateY(-8px) rotate(-0.5deg); border-color: var(--accent); }\n  .exhibit-icon {\n    width: 76px; height: 76px;\n    border-radius: 22px;\n    background: var(--accent);\n    display: grid;\n    place-items: center;\n    margin-bottom: 1.3rem;\n  }\n  .exhibit-icon svg { width: 46px; height: 46px; }\n  .exhibit h3 { margin-bottom: 0.5rem; }\n  .exhibit p { color: var(--muted); font-size: 0.98rem; }\n  .age-tag {\n    display: inline-block;\n    margin-top: 1rem;\n    font-size: 0.8rem;\n    font-weight: 700;\n    padding: 0.25rem 0.75rem;\n    border-radius: 999px;\n    background: var(--cream);\n    color: var(--navy);\n  }\n\n  /* Experiment band */\n  .band {\n    background: linear-gradient(135deg, var(--violet), #4a6cf7 60%, var(--teal));\n    color: var(--white);\n    border-radius: 36px;\n    padding: clamp(2.5rem, 6vw, 4.5rem);\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 3rem;\n    align-items: center;\n    position: relative;\n    overflow: hidden;\n  }\n  .band h2 { color: var(--white); }\n  .band p { margin: 1rem 0 1.8rem; opacity: 0.92; font-size: 1.08rem; }\n  .band .btn-sun { }\n  .schedule {\n    background: rgba(255, 255, 255, 0.14);\n    border: 2px solid rgba(255, 255, 255, 0.25);\n    border-radius: 24px;\n    padding: 1.6rem;\n    backdrop-filter: blur(4px);\n  }\n  .schedule h3 { color: var(--white); margin-bottom: 1rem; font-size: 1.15rem; }\n  .show {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding: 0.9rem 0;\n    border-bottom: 1px dashed rgba(255, 255, 255, 0.35);\n    gap: 1rem;\n  }\n  .show:last-child { border-bottom: none; }\n  .show strong { display: block; font-size: 1.02rem; }\n  .show small { opacity: 0.85; }\n  .time {\n    background: var(--sun);\n    color: var(--navy);\n    font-weight: 700;\n    padding: 0.35rem 0.8rem;\n    border-radius: 12px;\n    white-space: nowrap;\n    font-size: 0.9rem;\n  }\n\n  /* Stats */\n  .stats {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 1.5rem;\n    text-align: center;\n  }\n  .stat {\n    padding: 2rem 1rem;\n    border-radius: var(--radius);\n    background: var(--white);\n    box-shadow: var(--shadow);\n  }\n  .stat-number {\n    font-family: \"Arial Rounded MT Bold\", system-ui, sans-serif;\n    font-size: clamp(2.2rem, 4vw, 3rem);\n    color: var(--coral);\n    line-height: 1;\n  }\n  .stat-label { color: var(--muted); font-weight: 700; margin-top: 0.5rem; }\n\n  /* Tickets */\n  .tickets {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 1.8rem;\n    align-items: stretch;\n  }\n  .ticket {\n    background: var(--white);\n    border-radius: var(--radius);\n    padding: 2.4rem 2rem;\n    box-shadow: var(--shadow);\n    display: flex;\n    flex-direction: column;\n    position: relative;\n    border-top: 10px solid var(--accent);\n  }\n  .ticket.featured {\n    transform: translateY(-14px);\n    background: var(--navy);\n    color: var(--white);\n  }\n  .ticket.featured h3, .ticket.featured .price { color: var(--white); }\n  .ticket.featured .ticket-note, .ticket.featured li { color: rgba(255,255,255,0.85); }\n  .ribbon {\n    position: absolute;\n    top: -16px; right: 24px;\n    background: var(--sun);\n    color: var(--navy);\n    font-weight: 700;\n    font-size: 0.8rem;\n    padding: 0.35rem 0.9rem;\n    border-radius: 999px;\n    box-shadow: 0 4px 0 #d9a520;\n  }\n  .price {\n    font-family: \"Arial Rounded MT Bold\", system-ui, sans-serif;\n    font-size: 2.8rem;\n    color: var(--navy);\n    margin: 0.5rem 0;\n    line-height: 1;\n  }\n  .price small { font-size: 1rem; font-weight: 400; color: var(--muted); }\n  .ticket-note { color: var(--muted); font-size: 0.95rem; margin-bottom: 1.4rem; }\n  .ticket ul {\n    list-style: none;\n    margin-bottom: 2rem;\n    flex: 1;\n  }\n  .ticket li {\n    padding: 0.45rem 0 0.45rem 1.8rem;\n    position: relative;\n    color: var(--ink);\n  }\n  .ticket li::before {\n    content: \"\";\n    position: absolute;\n    left: 0; top: 0.8rem;\n    width: 14px; height: 14px;\n    border-radius: 50%;\n    background: var(--teal);\n  }\n  .ticket .btn { justify-content: center; }\n  .ticket.featured .btn-ghost { color: var(--white); border-color: var(--white); }\n  .ticket.featured .btn-ghost:hover { background: var(--white); color: var(--navy); }\n\n  /* Visit */\n  .visit-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 2rem;\n  }\n  .info-card {\n    background: var(--white);\n    border-radius: var(--radius);\n    padding: 2.2rem;\n    box-shadow: var(--shadow);\n  }\n  .info-card h3 { margin-bottom: 1rem; display: flex; align-items: center; gap: 0.6rem; }\n  .hours { width: 100%; border-collapse: collapse; }\n  .hours td {\n    padding: 0.7rem 0;\n    border-bottom: 1px solid var(--cream);\n  }\n  .hours td:last-child { text-align: right; font-weight: 700; color: var(--navy); }\n  .tips { list-style: none; }\n  .tips li {\n    padding: 0.6rem 0 0.6rem 2rem;\n    position: relative;\n    color: var(--muted);\n  }\n  .tips li::before {\n    content: \"\u2605\";\n    position: absolute;\n    left: 0;\n    color: var(--sun);\n    font-size: 1.1rem;\n  }\n  .map {\n    grid-column: 1 / -1;\n    border-radius: var(--radius);\n    overflow: hidden;\n    background: linear-gradient(135deg, #cfeee8, #e4f3ff);\n    min-height: 260px;\n    position: relative;\n    box-shadow: var(--shadow);\n  }\n  .map svg { position: absolute; inset: 0; width: 100%; height: 100%; }\n  .map-label {\n    position: absolute;\n    left: 50%; top: 50%;\n    transform: translate(-50%, -50%);\n    background: var(--white);\n    padding: 1rem 1.4rem;\n    border-radius: 18px;\n    box-shadow: var(--shadow);\n    text-align: center;\n    white-space: nowrap;\n  }\n  .map-label strong { display: block; color: var(--navy); font-size: 1.05rem; }\n  .map-label span { color: var(--muted); font-size: 0.92rem; }\n\n  /* Testimonials */\n  .quotes {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 1.6rem;\n  }\n  .quote {\n    background: var(--white);\n    border-radius: var(--radius);\n    padding: 2rem;\n    box-shadow: var(--shadow);\n    position: relative;\n  }\n  .quote p { font-size: 1.05rem; color: var(--ink); margin-bottom: 1.2rem; }\n  .quote p::before { content: \"\\201C\"; font-size: 3rem; line-height: 0; color: var(--teal); vertical-align: -1rem; margin-right: 0.2rem; }\n  .who { display: flex; align-items: center; gap: 0.8rem; }\n  .avatar {\n    width: 46px; height: 46px; border-radius: 50%;\n    display: grid; place-items: center;\n    font-weight: 700; color: var(--white);\n    background: var(--accent);\n  }\n  .who strong { display: block; color: var(--navy); }\n  .who small { color: var(--muted); }\n\n  /* Membership CTA */\n  .join {\n    background: var(--sun);\n    border-radius: 36px;\n    padding: clamp(2.5rem, 6vw, 4rem);\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    gap: 2rem;\n    flex-wrap: wrap;\n    position: relative;\n    overflow: hidden;\n  }\n  .join h2 { color: var(--navy); max-width: 560px; }\n  .join p { color: var(--navy); margin-top: 0.6rem; opacity: 0.85; max-width: 520px; }\n\n  /* Footer */\n  footer {\n    background: var(--navy-deep);\n    color: rgba(255,255,255,0.8);\n    padding: 4.5rem 0 2rem;\n    margin-top: 2rem;\n  }\n  .footer-grid {\n    display: grid;\n    grid-template-columns: 1.6fr 1fr 1fr 1.4fr;\n    gap: 2.5rem;\n  }\n  footer h4 {\n    color: var(--white);\n    margin-bottom: 1rem;\n    font-family: \"Arial Rounded MT Bold\", system-ui, sans-serif;\n  }\n  footer ul { list-style: none; }\n  footer li { margin-bottom: 0.55rem; }\n  footer a:hover { color: var(--sun); }\n  footer .logo { color: var(--white); margin-bottom: 1rem; }\n  .newsletter { display: flex; gap: 0.5rem; margin-top: 0.5rem; }\n  .newsletter input {\n    flex: 1;\n    min-width: 0;\n    padding: 0.8rem 1rem;\n    border-radius: 999px;\n    border: none;\n    font-family: inherit;\n    font-size: 0.95rem;\n  }\n  .newsletter button {\n    padding: 0.8rem 1.2rem;\n    border-radius: 999px;\n    border: none;\n    background: var(--coral);\n    color: var(--white);\n    font-weight: 700;\n    cursor: pointer;\n    font-family: inherit;\n  }\n  .newsletter button:hover { background: #ff846f; }\n  .fine {\n    margin-top: 3rem;\n    padding-top: 1.5rem;\n    border-top: 1px solid rgba(255,255,255,0.12);\n    display: flex;\n    justify-content: space-between;\n    flex-wrap: wrap;\n    gap: 1rem;\n    font-size: 0.9rem;\n  }\n\n  /* Responsive */\n  @media (max-width: 960px) {\n    .hero-grid, .band, .visit-grid { grid-template-columns: 1fr; }\n    .hero-art { max-width: 420px; order: -1; }\n    .stats { grid-template-columns: repeat(2, 1fr); }\n    .tickets, .quotes { grid-template-columns: 1fr; max-width: 520px; margin-inline: auto; }\n    .ticket.featured { transform: none; }\n    .footer-grid { grid-template-columns: 1fr 1fr; }\n  }\n\n  @media (max-width: 760px) {\n    .toggle { display: block; }\n    .nav-links {\n      position: absolute;\n      top: 76px; left: 0; right: 0;\n      flex-direction: column;\n      gap: 0;\n      background: var(--cream);\n      border-bottom: 1px solid rgba(27,42,82,0.08);\n      max-height: 0;\n      overflow: hidden;\n      transition: max-height 0.3s ease;\n    }\n    .nav-links.open { max-height: 400px; }\n    .nav-links li a { display: block; padding: 1rem 4%; }\n    .nav-cta .btn { display: none; }\n    .strip-inner { justify-content: center; }\n    .stats { grid-template-columns: 1fr 1fr; }\n    .footer-grid { grid-template-columns: 1fr; }\n  }\n\n  @media (max-width: 480px) {\n    .stats { grid-template-columns: 1fr; }\n    .hero-actions .btn { width: 100%; justify-content: center; }\n    .show { flex-direction: column; align-items: flex-start; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    *, *::before, *::after { animation: none !important; transition: none !important; }\n    html { scroll-behavior: auto; }\n  }\n</style>\n</head>\n<body>\n\n<!-- HEADER -->\n<header>\n  <div class=\"container nav\">\n    <a href=\"#top\" class=\"logo\" aria-label=\"Spark Children's Science Museum home\">\n      <svg class=\"logo-mark\" viewBox=\"0 0 48 48\" aria-hidden=\"true\">\n        <circle cx=\"24\" cy=\"24\" r=\"22\" fill=\"#ffc83d\"/>\n        <ellipse cx=\"24\" cy=\"24\" rx=\"17\" ry=\"7\" fill=\"none\" stroke=\"#1b2a52\" stroke-width=\"3\" transform=\"rotate(-30 24 24)\"/>\n        <ellipse cx=\"24\" cy=\"24\" rx=\"17\" ry=\"7\" fill=\"none\" stroke=\"#ff6b5b\" stroke-width=\"3\" transform=\"rotate(30 24 24)\"/>\n        <circle cx=\"24\" cy=\"24\" r=\"4.5\" fill=\"#1b2a52\"/>\n      </svg>\n      Spark!\n    </a>\n\n    <ul class=\"nav-links\" id=\"navLinks\">\n      <li><a href=\"#exhibits\">Exhibits</a></li>\n      <li><a href=\"#experiments\">Live Shows</a></li>\n      <li><a href=\"#tickets\">Tickets</a></li>\n      <li><a href=\"#visit\">Plan Your Visit</a></li>\n      <li><a href=\"#membership\">Membership</a></li>\n    </ul>\n\n    <div class=\"nav-cta\">\n      <a href=\"#tickets\" class=\"btn btn-primary btn-small\">Buy Tickets</a>\n      <button class=\"toggle\" id=\"menuToggle\" aria-label=\"Toggle menu\" aria-expanded=\"false\" aria-controls=\"navLinks\">\n        <span></span><span></span><span></span>\n      </button>\n    </div>\n  </div>\n</header>\n\n<main id=\"top\">\n\n  <!-- HERO -->\n  <section class=\"hero\">\n    <div class=\"container hero-grid\">\n      <div>\n        <span class=\"eyebrow\">Ages 2 to 12 &middot; Hands-on science</span>\n        <h1>Where curious minds get their hands dirty.</h1>\n        <p class=\"lead\">\n          Mix colors, build bridges, dig up dinosaurs, and make lightning in a jar.\n          Spark is a place where questions come first and every answer is something you can touch.\n        </p>\n        <div class=\"hero-actions\">\n          <a href=\"#tickets\" class=\"btn btn-primary\">Get Tickets</a>\n          <a href=\"#exhibits\" class=\"btn btn-ghost\">Explore Exhibits</a>\n        </div>\n        <div class=\"hero-badges\">\n          <span class=\"badge\">Open 7 days a week</span>\n          <span class=\"badge\">Free under 2s</span>\n          <span class=\"badge\">Rain or shine</span>\n        </div>\n      </div>\n\n      <div class=\"hero-art\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 520 520\">\n          <!-- backdrop -->\n          <circle cx=\"260\" cy=\"260\" r=\"230\" fill=\"#fff\" opacity=\"0.6\"/>\n          <circle cx=\"260\" cy=\"260\" r=\"180\" fill=\"#bff3e6\"/>\n\n          <!-- orbit rings -->\n          <g class=\"spin\">\n            <ellipse cx=\"260\" cy=\"260\" rx=\"210\" ry=\"70\" fill=\"none\" stroke=\"#1b2a52\" stroke-width=\"4\" stroke-dasharray=\"12 14\" transform=\"rotate(-18 260 260)\"/>\n            <circle cx=\"458\" cy=\"210\" r=\"14\" fill=\"#ff6b5b\"/>\n          </g>\n\n          <!-- central atom -->\n          <g class=\"bob\">\n            <ellipse cx=\"260\" cy=\"260\" rx=\"150\" ry=\"58\" fill=\"none\" stroke=\"#7c5cff\" stroke-width=\"16\" transform=\"rotate(-30 260 260)\"/>\n            <ellipse cx=\"260\" cy=\"260\" rx=\"150\" ry=\"58\" fill=\"none\" stroke=\"#2ec4b6\" stroke-width=\"16\" transform=\"rotate(30 260 260)\"/>\n            <ellipse cx=\"260\" cy=\"260\" rx=\"150\" ry=\"58\" fill=\"none\" stroke=\"#ff6b5b\" stroke-width=\"16\"/>\n            <circle cx=\"260\" cy=\"260\" r=\"46\" fill=\"#ffc83d\"/>\n            <circle cx=\"244\" cy=\"246\" r=\"10\" fill=\"#fff\" opacity=\"0.6\"/>\n          </g>\n\n          <!-- floating objects -->\n          <g class=\"float\">\n            <rect x=\"60\" y=\"90\" width=\"90\" height=\"110\" rx=\"14\" fill=\"#fff\" stroke=\"#1b2a52\" stroke-width=\"4\"/>\n            <path d=\"M72 150 Q90 130 105 150 T138 150 L138 190 L72 190 Z\" fill=\"#2ec4b6\"/>\n            <rect x=\"82\" y=\"72\" width=\"46\" height=\"18\" rx=\"6\" fill=\"#1b2a52\"/>\n          </g>\n\n          <g class=\"float delay\">\n            <path d=\"M400 330 L430 390 L370 390 Z\" fill=\"#ff6b5b\" stroke=\"#1b2a52\" stroke-width=\"4\" stroke-linejoin=\"round\"/>\n            <circle cx=\"400\" cy=\"330\" r=\"10\" fill=\"#fff\" stroke=\"#1b2a52\" stroke-width=\"4\"/>\n          </g>\n\n          <g class=\"float\">\n            <circle cx=\"110\" cy=\"390\" r=\"34\" fill=\"#7c5cff\"/>\n            <circle cx=\"98\" cy=\"378\" r=\"8\" fill=\"#fff\" opacity=\"0.5\"/>\n            <circle cx=\"140\" cy=\"420\" r=\"16\" fill=\"#ffc83d\"/>\n            <circle cx=\"88\" cy=\"425\" r=\"10\" fill=\"#ff6b5b\"/>\n          </g>\n\n          <!-- sparkles -->\n          <g fill=\"#ffc83d\" stroke=\"#1b2a52\" stroke-width=\"3\" stroke-linejoin=\"round\">\n            <path d=\"M440 110 L448 130 L468 138 L448 146 L440 166 L432 146 L412 138 L432 130 Z\" class=\"bob\"/>\n            <path d=\"M190 40 L196 54 L210 60 L196 66 L190 80 L184 66 L170 60 L184 54 Z\"/>\n          </g>\n        </svg>\n      </div>\n    </div>\n  </section>\n\n  <!-- INFO STRIP -->\n  <div class=\"strip\">\n    <div class=\"container strip-inner\">\n      <div>Open <span>10am &ndash; 5pm</span> daily</div>\n      <div>Over <span>40</span> hands-on exhibits</div>\n      <div>Live shows <span>every hour</span></div>\n      <div>Lunch-friendly <span>picnic area</span></div>\n    </div>\n  </div>\n\n  <!-- EXHIBITS -->\n  <section class=\"section\" id=\"exhibits\">\n    <div class=\"container\">\n      <div class=\"section-head\">\n        <span class=\"eyebrow\">Explore</span>\n        <h2>Six worlds to wander in</h2>\n        <p>Every gallery is built around something to try, touch, build, or break (safely, of course).</p>\n      </div>\n\n      <div class=\"exhibits-grid\">\n\n        <article class=\"exhibit\" style=\"--accent: #2ec4b6;\">\n          <div class=\"exhibit-icon\">\n            <svg viewBox=\"0 0 48 48\" aria-hidden=\"true\">\n              <path d=\"M18 6h12M20 6v12L10 36a4 4 0 0 0 3.5 6h21a4 4 0 0 0 3.5-6L28 18V6\" fill=\"none\" stroke=\"#fff\" stroke-width=\"3.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/>\n              <circle cx=\"20\" cy=\"33\" r=\"3\" fill=\"#fff\"/>\n              <circle cx=\"29\" cy=\"30\" r=\"2\" fill=\"#fff\"/>\n            </svg>\n          </div>\n          <h3>Bubble &amp; Brew Lab</h3>\n          <p>Mix, pour, and foam your way through chemical reactions. Warning: things may fizz over.</p>\n          <span class=\"age-tag\">Ages 4+</span>\n        </article>\n\n        <article class=\"exhibit\" style=\"--accent: #ff6b5b;\">\n          <div class=\"exhibit-icon\">\n            <svg viewBox=\"0 0 48 48\" aria-hidden=\"true\">\n              <path d=\"M10 40 L24 8 L38 40 Z\" fill=\"#fff\" opacity=\"0.25\"/>\n              <path d=\"M12 30c4-2 6 2 10 0s6-2 10 0 4 2 4 2\" fill=\"none\" stroke=\"#fff\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n              <path d=\"M14 22c3-1 5 2 8 0\" fill=\"none\" stroke=\"#fff\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n              <circle cx=\"34\" cy=\"14\" r=\"4\" fill=\"#fff\"/>\n            </svg>\n          </div>\n          <h3>Dino Dig Pit</h3>\n          <p>Brush away the dirt, uncover fossils, and piece together a skeleton that once roamed Earth.</p>\n          <span class=\"age-tag\">Ages 3+</span>\n        </article>\n\n        <article class=\"exhibit\" style=\"--accent: #7c5cff;\">\n          <div class=\"exhibit-icon\">\n            <svg viewBox=\"0 0 48 48\" aria-hidden=\"true\">\n              <rect x=\"12\" y=\"16\" width=\"24\" height=\"18\" rx=\"5\" fill=\"#fff\"/>\n              <circle cx=\"19\" cy=\"25\" r=\"3\" fill=\"#7c5cff\"/>\n              <circle cx=\"29\" cy=\"25\" r=\"3\" fill=\"#7c5cff\"/>\n              <path d=\"M24 16V10\" stroke=\"#fff\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n              <circle cx=\"24\" cy=\"8\" r=\"3\" fill=\"#ffc83d\"/>\n              <path d=\"M16 36v4M32 36v4\" stroke=\"#fff\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n            </svg>\n          </div>\n          <h3>Robot Workshop</h3>\n          <p>Code a bot to navigate a maze, then build your own gear-driven machine from scratch.</p>\n          <span class=\"age-tag\">Ages 5+</span>\n        </article>\n\n        <article class=\"exhibit\" style=\"--accent: #ffb020;\">\n          <div class=\"exhibit-icon\">\n            <svg viewBox=\"0 0 48 48\" aria-hidden=\"true\">\n              <circle cx=\"24\" cy=\"20\" r=\"9\" fill=\"#fff\"/>\n              <path d=\"M24 4v4M24 32v4M8 20h4M36 20h4M13 9l3 3M32 28l3 3M35 9l-3 3M16 28l-3 3\" stroke=\"#fff\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n              <path d=\"M18 40h12\" stroke=\"#fff\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n            </svg>\n          </div>\n          <h3>Weather Station</h3>\n          <p>Make your own cloud, spin a tornado in a bottle, and forecast tomorrow like a pro.</p>\n          <span class=\"age-tag\">Ages 3+</span>\n        </article>\n\n        <article class=\"exhibit\" style=\"--accent: #ff8fab;\">\n          <div class=\"exhibit-icon\">\n            <svg viewBox=\"0 0 48 48\" aria-hidden=\"true\">\n              <path d=\"M8 36 Q24 8 40 36\" fill=\"none\" stroke=\"#fff\" stroke-width=\"3.5\" stroke-linecap=\"round\"/>\n              <circle cx=\"14\" cy=\"34\" r=\"4\" fill=\"#fff\"/>\n              <circle cx=\"34\" cy=\"34\" r=\"4\" fill=\"#fff\"/>\n              <circle cx=\"24\" cy=\"14\" r=\"5\" fill=\"#fff\"/>\n            </svg>\n          </div>\n          <h3>Gravity Playground</h3>\n          <p>Roll, drop, slide, and launch. Discover why some things fall faster than others.</p>\n          <span class=\"age-tag\">All ages</span>\n        </article>\n\n        <article class=\"exhibit\" style=\"--accent: #1b2a52;\">\n          <div class=\"exhibit-icon\">\n            <svg viewBox=\"0 0 48 48\" aria-hidden=\"true\">\n              <circle cx=\"24\" cy=\"24\" r=\"17\" fill=\"none\" stroke=\"#fff\" stroke-width=\"3\"/>\n              <circle cx=\"24\" cy=\"24\" r=\"4\" fill=\"#ffc83d\"/>\n              <circle cx=\"16\" cy=\"18\" r=\"2.5\" fill=\"#fff\"/>\n              <circle cx=\"32\" cy=\"30\" r=\"2\" fill=\"#fff\"/>\n              <circle cx=\"30\" cy=\"16\" r=\"1.8\" fill=\"#fff\"/>\n              <path d=\"M24 7v3M24 38v3M7 24h3M38 24h3\" stroke=\"#fff\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n            </svg>\n          </div>\n          <h3>Tiny Universe</h3>\n          <p>Peer through microscopes at pond water, insect wings, and the glittering science of snowflakes.</p>\n          <span class=\"age-tag\">Ages 6+</span>\n        </article>\n\n      </div>\n    </div>\n  </section>\n\n  <!-- EXPERIMENTS / LIVE SHOWS -->\n  <section class=\"section\" id=\"experiments\" style=\"padding-top: 0;\">\n    <div class=\"container\">\n      <div class=\"band\">\n        <div>\n          <span class=\"eyebrow\" style=\"color: var(--sun);\">Live on stage</span>\n          <h2>Science shows happen every hour.</h2>\n          <p>Our educators light fires (small ones), freeze bananas with liquid nitrogen, and turn bubbles into giant walkable spheres. Sit close. You might get splashed.</p>\n          <a href=\"#tickets\" class=\"btn btn-sun\">Add a Show to Your Visit</a>\n        </div>\n        <div class=\"schedule\">\n          <h3>Today's Stage Schedule</h3>\n          <div class=\"show\">\n            <div>\n              <strong>Frozen Fireworks</strong>\n              <small>Chemistry &middot; 20 min</small>\n            </div>\n            <span class=\"time\">11:00</span>\n          </div>\n          <div class=\"show\">\n            <div>\n              <strong>Giant Bubble Challenge</strong>\n              <small>Physics &middot; 25 min</small>\n            </div>\n            <span class=\"time\">1:00</span>\n          </div>\n          <div class=\"show\">\n            <div>\n              <strong>Mystery Dinner Lab</strong>\n              <small>Biology &middot; 30 min</small>\n            </div>\n            <span class=\"time\">3:00</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- STATS -->\n  <section class=\"section\" style=\"padding-top: 0;\">\n    <div class=\"container stats\">\n      <div class=\"stat\">\n        <div class=\"stat-number\">250K+</div>\n        <div class=\"stat-label\">Young explorers each year</div>\n      </div>\n      <div class=\"stat\">\n        <div class=\"stat-number\">120+</div>\n        <div class=\"stat-label\">Experiments to try</div>\n      </div>\n      <div class=\"stat\">\n        <div class=\"stat-number\">45</div>\n        <div class=\"stat-label\">Local school partners</div>\n      </div>\n      <div class=\"stat\">\n        <div class=\"stat-number\">4.9</div>\n        <div class=\"stat-label\">Average family rating</div>\n      </div>\n    </div>\n  </section>\n\n  <!-- TICKETS -->\n  <section class=\"section\" id=\"tickets\" style=\"padding-top: 0;\">\n    <div class=\"container\">\n      <div class=\"section-head\">\n        <span class=\"eyebrow\">Tickets</span>\n        <h2>Pick your adventure</h2>\n        <p>Tickets are timed for smoother visits. Save 15% when you book online ahead of time.</p>\n      </div>\n\n      <div class=\"tickets\">\n        <div class=\"ticket\" style=\"--accent: #2ec4b6;\">\n          <h3>Little Explorer</h3>\n          <div class=\"price\">$14 <small>/ person</small></div>\n          <p class=\"ticket-note\">Ages 2 to 5, with one adult</p>\n          <ul>\n            <li>Toddler-friendly gallery access</li>\n            <li>Unlimited Dino Dig sessions</li>\n            <li>Free sticker sheet</li>\n          </ul>\n          <a href=\"#visit\" class=\"btn btn-ghost\">Choose Explorer</a>\n        </div>\n\n        <div class=\"ticket featured\" style=\"--accent: #ffc83d;\">\n          <span class=\"ribbon\">Most popular</span>\n          <h3>Full Discovery</h3>\n          <div class=\"price\">$22 <small>/ person</small></div>\n          <p class=\"ticket-note\">Ages 6 and up, all exhibits included</p>\n          <ul>\n            <li>Access to all 40+ exhibits</li>\n            <li>Two live science shows</li>\n            <li>Robot Workshop build session</li>\n            <li>Bring-back pass for 7 days</li>\n          </ul>\n          <a href=\"#visit\" class=\"btn btn-primary\" style=\"justify-content:center;\">Buy Discovery Tickets</a>\n        </div>\n\n        <div class=\"ticket\" style=\"--accent: #7c5cff;\">\n          <h3>Family Lab Pass</h3>\n          <div class=\"price\">$68 <small>/ family</small></div>\n          <p class=\"ticket-note\">Up to 2 adults and 4 children</p>\n          <ul>\n            <li>Everything in Full Discovery</li>\n            <li>Planetarium dome show</li>\n            <li>Family photo keepsake</li>\n            <li>Priority birthday party booking</li>\n          </ul>\n          <a href=\"#visit\" class=\"btn btn-ghost\">Get Family Pass</a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- VISIT -->\n  <section class=\"section\" id=\"visit\" style=\"padding-top: 0;\">\n    <div class=\"container visit-grid\">\n      <div class=\"info-card\">\n        <h3>&#128337; Hours</h3>\n        <table class=\"hours\">\n          <tr><td>Monday &ndash; Thursday</td><td>10:00 am &ndash; 5:00 pm</td></tr>\n          <tr><td>Friday &ndash; Saturday</td><td>9:00 am &ndash; 7:00 pm</td></tr>\n          <tr><td>Sunday</td><td>10:00 am &ndash; 5:00 pm</td></tr>\n          <tr><td>Holidays</td><td>Check calendar</td></tr>\n        </table>\n      </div>\n\n      <div class=\"info-card\">\n        <h3>&#128161; Good to know</h3>\n        <ul class=\"tips\">\n          <li>Arrive early for the best time slots at Dino Dig.</li>\n          <li>Stroller parking and nursing rooms on every floor.</li>\n          <li>Lockers available for coats and lunches.</li>\n          <li>Free Wi-Fi and a quiet room for sensory breaks.</li>\n        </ul>\n      </div>\n\n      <div class=\"map\" role=\"img\" aria-label=\"Illustrated map showing the museum location in a park\">\n        <svg viewBox=\"0 0 1000 300\" preserveAspectRatio=\"xMidYMid slice\" aria-hidden=\"true\">\n          <path d=\"M0 220 Q250 170 500 210 T1000 190 L1000 300 L0 300 Z\" fill=\"#8fdcc7\"/>\n          <path d=\"M0 80 Q300 40 520 90 T1000 70\" fill=\"none\" stroke=\"#fff\" stroke-width=\"22\" stroke-linecap=\"round\" opacity=\"0.9\"/>\n          <path d=\"M120 0 Q180 150 140 300\" fill=\"none\" stroke=\"#fff\" stroke-width=\"16\" opacity=\"0.8\"/>\n          <path d=\"M700 0 Q760 150 880 300\" fill=\"none\" stroke=\"#fff\" stroke-width=\"16\" opacity=\"0.8\"/>\n          <circle cx=\"220\" cy=\"130\" r=\"22\" fill=\"#2ec4b6\" opacity=\"0.6\"/>\n          <circle cx=\"820\" cy=\"110\" r=\"30\" fill=\"#7c5cff\" opacity=\"0.35\"/>\n          <rect x=\"300\" y=\"200\" width=\"30\" height=\"30\" rx=\"6\" fill=\"#ffc83d\" opacity=\"0.8\"/>\n          <rect x=\"650\" y=\"180\" width=\"26\" height=\"26\" rx=\"6\" fill=\"#ff6b5b\" opacity=\"0.7\"/>\n        </svg>\n        <div class=\"map-label\">\n          <strong>Spark Science Center</strong>\n          <span>184 Meadow Lane &middot; Free park parking</span>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- TESTIMONIALS -->\n  <section class=\"section\" style=\"padding-top: 0;\">\n    <div class=\"container\">\n      <div class=\"section-head\">\n        <span class=\"eyebrow\">Happy families</span>\n        <h2>Heard around the lab</h2>\n      </div>\n      <div class=\"quotes\">\n        <figure class=\"quote\" style=\"--accent: #ff6b5b;\">\n          <p>My son asked to go back the very next day. He still talks about the bubble that was bigger than him.</p>\n          <figcaption class=\"who\">\n            <span class=\"avatar\">M</span>\n            <div><strong>Maria R.</strong><small>Parent of a 6-year-old</small></div>\n          </figcaption>\n        </figure>\n        <figure class=\"quote\" style=\"--accent: #2ec4b6;\">\n          <p>Our class visited for a field trip and the educators made every kid feel like a real scientist.</p>\n          <figcaption class=\"who\">\n            <span class=\"avatar\">D</span>\n            <div><strong>Daniel K.</strong><small>3rd grade teacher</small></div>\n          </figcaption>\n        </figure>\n        <figure class=\"quote\" style=\"--accent: #7c5cff;\">\n          <p>Even my teenager, who swore he was too old for this, spent an hour building robots. Worth every penny.</p>\n          <figcaption class=\"who\">\n            <span class=\"avatar\">A</span>\n            <div><strong>Aisha T.</strong><small>Parent of two</small></div>\n          </figcaption>\n        </figure>\n      </div>\n    </div>\n  </section>\n\n  <!-- MEMBERSHIP -->\n  <section class=\"section\" id=\"membership\" style=\"padding-top: 0;\">\n    <div class=\"container\">\n      <div class=\"join\">\n        <div>\n          <h2>Make Spark your science home.</h2>\n          <p>Become a member for unlimited visits, free guest passes, early access to new exhibits, and 10% off birthday parties.</p>\n        </div>\n        <a href=\"#tickets\" class=\"btn btn-primary\">Join from $89/year</a>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<!-- FOOTER -->\n<footer>\n  <div class=\"container\">\n    <div class=\"footer-grid\">\n      <div>\n        <a href=\"#top\" class=\"logo\">\n          <svg class=\"logo-mark\" viewBox=\"0 0 48 48\" aria-hidden=\"true\">\n            <circle cx=\"24\" cy=\"24\" r=\"22\" fill=\"#ffc83d\"/>\n            <ellipse cx=\"24\" cy=\"24\" rx=\"17\" ry=\"7\" fill=\"none\" stroke=\"#1b2a52\" stroke-width=\"3\" transform=\"rotate(-30 24 24)\"/>\n            <ellipse cx=\"24\" cy=\"24\" rx=\"17\" ry=\"7\" fill=\"none\" stroke=\"#ff6b5b\" stroke-width=\"3\" transform=\"rotate(30 24 24)\"/>\n            <circle cx=\"24\" cy=\"24\" r=\"4.5\" fill=\"#1b2a52\"/>\n          </svg>\n          Spark!\n        </a>\n        <p>A hands-on children's science museum for curious minds of every age.</p>\n      </div>\n\n      <div>\n        <h4>Visit</h4>\n        <ul>\n          <li><a href=\"#tickets\">Tickets</a></li>\n          <li><a href=\"#visit\">Hours &amp; Location</a></li>\n          <li><a href=\"#visit\">Accessibility</a></li>\n          <li><a href=\"#visit\">Parking</a></li>\n        </ul>\n      </div>\n\n      <div>\n        <h4>Learn</h4>\n        <ul>\n          <li><a href=\"#exhibits\">Exhibits</a></li>\n          <li><a href=\"#experiments\">Live Shows</a></li>\n          <li><a href=\"#experiments\">School Programs</a></li>\n          <li><a href=\"#experiments\">Summer Camps</a></li>\n        </ul>\n      </div>\n\n      <div>\n        <h4>Stay in the loop</h4>\n        <p>Weekly activity ideas and event news, straight to your inbox.</p>\n        <form class=\"newsletter\" onsubmit=\"event.preventDefault(); this.querySelector('button').textContent='Thanks!';\">\n          <label for=\"email\" class=\"sr-only\" style=\"position:absolute;left:-9999px;\">Email address</label>\n          <input type=\"email\" id=\"email\" placeholder=\"you@example.com\" required>\n          <button type=\"submit\">Sign up</button>\n        </form>\n      </div>\n    </div>\n\n    <div class=\"fine\">\n      <span>&copy; 2025 Spark Children's Science Museum. A nonprofit educational institution.</span>\n      <span>Privacy &middot; Terms &middot; Accessibility</span>\n    </div>\n  </div>\n</footer>\n\n<script>\n  const toggle = document.getElementById('menuToggle');\n  const links = document.getElementById('navLinks');\n  toggle.addEventListener('click', () => {\n    const open = links.classList.toggle('open');\n    toggle.setAttribute('aria-expanded', open);\n  });\n  links.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {\n    links.classList.remove('open');\n    toggle.setAttribute('aria-expanded', 'false');\n  }));\n</script>\n\n</body>\n</html>\n"}