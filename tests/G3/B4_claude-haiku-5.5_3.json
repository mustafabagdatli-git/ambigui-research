{"brief": "B4", "model": "anthropic/claude-haiku-5.5", "i": 3, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Quiet Hinge Press \u00b7 Poetry, printed slowly</title>\n<meta name=\"description\" content=\"Quiet Hinge Press is a small independent poetry press publishing three to four collections a year.\">\n<style>\n  :root {\n    --paper: #f6f1e7;\n    --paper-deep: #ede5d3;\n    --ink: #1d1b18;\n    --ink-soft: #5b564d;\n    --oxblood: #7a2e2a;\n    --sage: #56624f;\n    --rule: #d6cbb5;\n    --serif: \"Iowan Old Style\", \"Palatino Linotype\", Palatino, \"Book Antiqua\", Georgia, serif;\n    --sans: \"Helvetica Neue\", Helvetica, Arial, sans-serif;\n    --max: 1120px;\n  }\n\n  *, *::before, *::after { box-sizing: border-box; }\n\n  html { scroll-behavior: smooth; }\n\n  body {\n    margin: 0;\n    background: var(--paper);\n    color: var(--ink);\n    font-family: var(--serif);\n    font-size: 1.0625rem;\n    line-height: 1.6;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  img, svg { display: block; max-width: 100%; }\n  a { color: inherit; }\n  a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible {\n    outline: 2px solid var(--oxblood);\n    outline-offset: 3px;\n  }\n\n  .skip-link {\n    position: absolute; left: -9999px; top: 0;\n    background: var(--ink); color: var(--paper); padding: .5rem 1rem; z-index: 100;\n  }\n  .skip-link:focus { left: 1rem; top: 1rem; }\n\n  .wrap { max-width: var(--max); margin: 0 auto; padding: 0 1.5rem; }\n\n  .eyebrow {\n    font-family: var(--sans);\n    font-size: .75rem;\n    letter-spacing: .18em;\n    text-transform: uppercase;\n    color: var(--oxblood);\n    margin: 0 0 1rem;\n  }\n\n  h1, h2, h3 { font-weight: 400; line-height: 1.15; margin: 0; }\n  h1 { font-size: clamp(2.5rem, 5.5vw, 4.25rem); letter-spacing: -.01em; }\n  h2 { font-size: clamp(1.9rem, 3.5vw, 2.7rem); }\n  h3 { font-size: 1.35rem; }\n\n  .section { padding: clamp(4rem, 9vw, 7rem) 0; }\n  .section + .section { border-top: 1px solid var(--rule); }\n\n  .btn {\n    display: inline-block;\n    font-family: var(--sans);\n    font-size: .9rem;\n    letter-spacing: .04em;\n    text-decoration: none;\n    padding: .85rem 1.5rem;\n    border: 1px solid var(--ink);\n    background: var(--ink);\n    color: var(--paper);\n    transition: background .2s, color .2s, border-color .2s;\n    cursor: pointer;\n  }\n  .btn:hover { background: transparent; color: var(--ink); }\n  .btn-ghost { background: transparent; color: var(--ink); }\n  .btn-ghost:hover { background: var(--ink); color: var(--paper); }\n\n  /* ---------- Header ---------- */\n  header.site {\n    position: sticky; top: 0; z-index: 50;\n    background: rgba(246, 241, 231, .92);\n    backdrop-filter: blur(6px);\n    border-bottom: 1px solid var(--rule);\n  }\n  .bar {\n    display: flex; align-items: center; justify-content: space-between;\n    height: 72px; gap: 1rem;\n  }\n  .logo {\n    text-decoration: none; display: flex; align-items: baseline; gap: .5rem;\n    font-size: 1.25rem; letter-spacing: .01em;\n  }\n  .logo em { font-style: italic; color: var(--oxblood); }\n  .logo small {\n    font-family: var(--sans); font-size: .65rem; letter-spacing: .2em;\n    text-transform: uppercase; color: var(--ink-soft);\n  }\n  nav ul {\n    list-style: none; display: flex; gap: 2rem; margin: 0; padding: 0;\n    font-family: var(--sans); font-size: .9rem;\n  }\n  nav a { text-decoration: none; padding: .25rem 0; border-bottom: 1px solid transparent; }\n  nav a:hover { border-bottom-color: var(--oxblood); }\n\n  /* ---------- Hero ---------- */\n  .hero { padding: clamp(4rem, 10vw, 8rem) 0 clamp(3.5rem, 8vw, 6rem); }\n  .hero-grid {\n    display: grid; grid-template-columns: 1.25fr 1fr; gap: 4rem; align-items: center;\n  }\n  .hero p.lead {\n    font-size: 1.25rem; color: var(--ink-soft); max-width: 34rem; margin: 1.75rem 0 2.25rem;\n  }\n  .cta-row { display: flex; flex-wrap: wrap; gap: .85rem; }\n\n  .hero-art {\n    position: relative; aspect-ratio: 4 / 5; width: 100%; max-width: 420px; justify-self: center;\n  }\n  .hero-art svg { width: 100%; height: 100%; }\n\n  /* ---------- Book covers (pure CSS / SVG) ---------- */\n  .cover {\n    position: relative;\n    aspect-ratio: 2 / 3;\n    width: 100%;\n    padding: 1.4rem 1.3rem;\n    display: flex; flex-direction: column; justify-content: space-between;\n    color: var(--paper);\n    box-shadow: 0 1px 0 rgba(0,0,0,.08), 0 14px 30px -18px rgba(29,27,24,.55);\n    overflow: hidden;\n  }\n  .cover::before { /* spine */\n    content: \"\"; position: absolute; left: 0; top: 0; bottom: 0; width: 10px;\n    background: rgba(0,0,0,.18);\n  }\n  .cover::after { /* soft grain */\n    content: \"\"; position: absolute; inset: 0;\n    background: repeating-linear-gradient(0deg, rgba(255,255,255,.035) 0 1px, transparent 1px 3px);\n    pointer-events: none;\n  }\n  .cover .c-series {\n    font-family: var(--sans); font-size: .6rem; letter-spacing: .22em; text-transform: uppercase; opacity: .85;\n  }\n  .cover .c-title { font-size: 1.45rem; line-height: 1.1; margin-top: auto; }\n  .cover .c-title em { display: block; font-size: .95rem; margin-top: .4rem; opacity: .9; }\n  .cover .c-author {\n    font-family: var(--sans); font-size: .7rem; letter-spacing: .14em; text-transform: uppercase;\n    margin-top: 1.2rem; border-top: 1px solid rgba(255,255,255,.35); padding-top: .7rem;\n  }\n  .cover svg.c-mark { position: absolute; right: -18%; top: 18%; width: 78%; opacity: .22; }\n\n  .c-oxblood { background: linear-gradient(160deg, #8b3a34, #5c2320); }\n  .c-sage    { background: linear-gradient(160deg, #6b7a5f, #424c3b); }\n  .c-slate   { background: linear-gradient(160deg, #4d5661, #2c323a); }\n  .c-ochre   { background: linear-gradient(160deg, #a77a3c, #6e4f23); }\n\n  /* ---------- Featured ---------- */\n  .featured-grid {\n    display: grid; grid-template-columns: minmax(220px, 340px) 1fr; gap: clamp(2.5rem, 6vw, 5rem); align-items: start;\n  }\n  .featured-meta .tag {\n    display: inline-block; font-family: var(--sans); font-size: .72rem; letter-spacing: .16em; text-transform: uppercase;\n    border: 1px solid var(--ink); padding: .3rem .6rem; margin-bottom: 1.25rem;\n  }\n  .featured-meta h2 { margin-bottom: .5rem; }\n  .featured-meta .byline { font-style: italic; color: var(--ink-soft); margin: 0 0 1.5rem; }\n  .featured-meta p { max-width: 36rem; }\n  .poem {\n    margin: 2rem 0; padding: 1.5rem 0 1.5rem 1.5rem;\n    border-left: 2px solid var(--oxblood);\n    font-style: italic; font-size: 1.1rem; line-height: 1.75;\n  }\n  .poem p { margin: 0 0 1rem; }\n  .poem footer { font-style: normal; font-family: var(--sans); font-size: .8rem; color: var(--ink-soft); }\n  .meta-list {\n    display: flex; flex-wrap: wrap; gap: .5rem 1.75rem; list-style: none; padding: 0; margin: 1.75rem 0 2rem;\n    font-family: var(--sans); font-size: .85rem; color: var(--ink-soft);\n  }\n\n  /* ---------- Catalogue ---------- */\n  .section-head {\n    display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; flex-wrap: wrap;\n    margin-bottom: 3rem;\n  }\n  .section-head p { max-width: 30rem; margin: 0; color: var(--ink-soft); }\n  .catalogue {\n    display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 2.75rem 2rem;\n    list-style: none; padding: 0; margin: 0;\n  }\n  .book { display: flex; flex-direction: column; }\n  .book .cover { margin-bottom: 1.25rem; transition: transform .35s ease; }\n  .book:hover .cover { transform: translateY(-4px); }\n  .book h3 { font-size: 1.2rem; }\n  .book .author { font-style: italic; color: var(--ink-soft); margin: .25rem 0 .75rem; }\n  .book .desc { font-size: .95rem; color: var(--ink-soft); margin: 0 0 1rem; flex: 1; }\n  .book .row {\n    display: flex; justify-content: space-between; align-items: center;\n    font-family: var(--sans); font-size: .85rem; border-top: 1px solid var(--rule); padding-top: .8rem;\n  }\n  .book .row a { text-decoration: none; border-bottom: 1px solid var(--oxblood); color: var(--oxblood); }\n  .book .row a:hover { color: var(--ink); border-color: var(--ink); }\n\n  /* ---------- Principles ---------- */\n  .principles {\n    display: grid; grid-template-columns: repeat(3, 1fr); gap: 3rem;\n    list-style: none; padding: 0; margin: 0;\n  }\n  .principles li { border-top: 2px solid var(--ink); padding-top: 1.25rem; }\n  .principles .num {\n    font-family: var(--sans); font-size: .75rem; letter-spacing: .15em; color: var(--oxblood);\n  }\n  .principles h3 { margin: .6rem 0 .75rem; }\n  .principles p { margin: 0; color: var(--ink-soft); }\n\n  /* ---------- Submissions ---------- */\n  .submit { background: var(--paper-deep); }\n  .submit-grid {\n    display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2.5rem, 6vw, 5rem); align-items: start;\n  }\n  .status {\n    display: inline-flex; align-items: center; gap: .6rem; font-family: var(--sans); font-size: .9rem;\n    padding: .55rem .9rem; border: 1px solid var(--sage); color: var(--sage); margin-bottom: 1.5rem;\n  }\n  .status::before {\n    content: \"\"; width: 8px; height: 8px; border-radius: 50%; background: var(--sage);\n  }\n  .submit dl { margin: 0; }\n  .submit dt {\n    font-family: var(--sans); font-size: .75rem; letter-spacing: .14em; text-transform: uppercase;\n    color: var(--ink-soft); margin-top: 1.25rem;\n  }\n  .submit dd { margin: .25rem 0 0; }\n  .submit ul { padding-left: 1.1rem; margin: .5rem 0 0; }\n  .submit li { margin-bottom: .35rem; }\n\n  /* ---------- Newsletter ---------- */\n  form.subscribe { display: grid; gap: 1rem; }\n  form.subscribe label {\n    font-family: var(--sans); font-size: .8rem; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-soft);\n    display: grid; gap: .4rem;\n  }\n  form.subscribe input, form.subscribe select, form.subscribe textarea {\n    font: inherit; font-size: 1rem; letter-spacing: normal; text-transform: none; color: var(--ink);\n    background: var(--paper); border: 1px solid var(--ink); padding: .75rem .9rem; border-radius: 0;\n    width: 100%;\n  }\n  form.subscribe .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }\n  form.subscribe .checkbox {\n    display: flex; gap: .6rem; align-items: flex-start; font-family: var(--sans);\n    font-size: .85rem; letter-spacing: normal; text-transform: none; color: var(--ink-soft);\n  }\n  form.subscribe .checkbox input { width: auto; margin-top: .3rem; }\n  .form-note { font-family: var(--sans); font-size: .8rem; color: var(--ink-soft); margin: 0; }\n\n  /* ---------- Footer ---------- */\n  footer.site-foot { background: var(--ink); color: var(--paper); padding: 4rem 0 2rem; }\n  .foot-grid {\n    display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 2.5rem;\n  }\n  .foot-grid h4 {\n    font-family: var(--sans); font-size: .72rem; letter-spacing: .16em; text-transform: uppercase;\n    margin: 0 0 1rem; color: #c9bfa8; font-weight: 400;\n  }\n  .foot-grid ul { list-style: none; padding: 0; margin: 0; display: grid; gap: .5rem; font-size: .95rem; }\n  .foot-grid a { text-decoration: none; opacity: .9; }\n  .foot-grid a:hover { text-decoration: underline; }\n  .foot-brand p { color: #c9bfa8; max-width: 22rem; margin: .75rem 0 0; font-size: .95rem; }\n  .foot-base {\n    margin-top: 3.5rem; padding-top: 1.5rem; border-top: 1px solid #3a3731;\n    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem;\n    font-family: var(--sans); font-size: .8rem; color: #a59c8a;\n  }\n\n  /* ---------- Responsive ---------- */\n  @media (max-width: 900px) {\n    .hero-grid, .featured-grid, .submit-grid { grid-template-columns: 1fr; }\n    .hero-art { max-width: 340px; order: -1; }\n    .principles { grid-template-columns: 1fr; gap: 2rem; }\n    .foot-grid { grid-template-columns: 1fr 1fr; }\n  }\n  @media (max-width: 640px) {\n    nav ul { gap: 1rem; font-size: .8rem; }\n    .logo small { display: none; }\n    form.subscribe .row2 { grid-template-columns: 1fr; }\n    .foot-grid { grid-template-columns: 1fr; }\n  }\n  @media (max-width: 480px) {\n    nav ul li:nth-child(3) { display: none; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    html { scroll-behavior: auto; }\n    * { transition: none !important; }\n  }\n</style>\n</head>\n<body>\n\n<a class=\"skip-link\" href=\"#main\">Skip to content</a>\n\n<header class=\"site\">\n  <div class=\"wrap bar\">\n    <a class=\"logo\" href=\"#top\" aria-label=\"Quiet Hinge Press home\">\n      <span>Quiet <em>Hinge</em></span>\n      <small>Poetry Press</small>\n    </a>\n    <nav aria-label=\"Primary\">\n      <ul>\n        <li><a href=\"#catalogue\">Catalogue</a></li>\n        <li><a href=\"#about\">About</a></li>\n        <li><a href=\"#submit\">Submit</a></li>\n        <li><a href=\"#subscribe\">Newsletter</a></li>\n      </ul>\n    </nav>\n  </div>\n</header>\n\n<main id=\"main\">\n\n  <!-- Hero -->\n  <section class=\"hero\" id=\"top\">\n    <div class=\"wrap hero-grid\">\n      <div>\n        <p class=\"eyebrow\">Independent poetry \u00b7 Est. 2014 \u00b7 Four books a year</p>\n        <h1>Poems printed slowly, for readers who read slowly.</h1>\n        <p class=\"lead\">\n          Quiet Hinge is a small press in a converted cooperage, publishing collections\n          by emerging and established poets. Each title is hand-set, short-run,\n          and built to be reread.\n        </p>\n        <div class=\"cta-row\">\n          <a class=\"btn\" href=\"#catalogue\">Browse the catalogue</a>\n          <a class=\"btn btn-ghost\" href=\"#submit\">Send a manuscript</a>\n        </div>\n      </div>\n\n      <div class=\"hero-art\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 400 500\" preserveAspectRatio=\"xMidYMid meet\">\n          <rect x=\"0\" y=\"0\" width=\"400\" height=\"500\" fill=\"#ede5d3\"/>\n          <!-- hinge/door motif -->\n          <rect x=\"60\" y=\"70\" width=\"210\" height=\"360\" fill=\"#7a2e2a\"/>\n          <rect x=\"60\" y=\"70\" width=\"210\" height=\"360\" fill=\"none\" stroke=\"#1d1b18\" stroke-width=\"2\"/>\n          <rect x=\"230\" y=\"70\" width=\"110\" height=\"360\" fill=\"#f6f1e7\" stroke=\"#1d1b18\" stroke-width=\"2\"/>\n          <line x1=\"230\" y1=\"70\" x2=\"230\" y2=\"430\" stroke=\"#1d1b18\" stroke-width=\"2\"/>\n          <circle cx=\"250\" cy=\"265\" r=\"5\" fill=\"#1d1b18\"/>\n          <circle cx=\"104\" cy=\"120\" r=\"4\" fill=\"#f6f1e7\"/>\n          <circle cx=\"104\" cy=\"380\" r=\"4\" fill=\"#f6f1e7\"/>\n          <path d=\"M60 150 Q 130 130 200 150 T 270 150\" fill=\"none\" stroke=\"#f6f1e7\" stroke-width=\"1.5\" opacity=\".6\"/>\n          <path d=\"M80 200 Q 140 182 200 200\" fill=\"none\" stroke=\"#f6f1e7\" stroke-width=\"1.5\" opacity=\".4\"/>\n          <path d=\"M80 330 Q 150 312 220 330\" fill=\"none\" stroke=\"#f6f1e7\" stroke-width=\"1.5\" opacity=\".4\"/>\n          <text x=\"200\" y=\"468\" text-anchor=\"middle\" font-family=\"Georgia, serif\" font-size=\"15\" fill=\"#5b564d\" font-style=\"italic\">Quiet Hinge \u00b7 No. 37</text>\n        </svg>\n      </div>\n    </div>\n  </section>\n\n  <!-- Featured -->\n  <section class=\"section\" aria-labelledby=\"featured-title\">\n    <div class=\"wrap featured-grid\">\n      <div>\n        <div class=\"cover c-oxblood\">\n          <svg class=\"c-mark\" viewBox=\"0 0 100 100\" aria-hidden=\"true\"><circle cx=\"50\" cy=\"50\" r=\"40\" fill=\"none\" stroke=\"#f6f1e7\" stroke-width=\"1.5\"/><circle cx=\"50\" cy=\"50\" r=\"26\" fill=\"none\" stroke=\"#f6f1e7\" stroke-width=\"1.5\"/><circle cx=\"50\" cy=\"50\" r=\"12\" fill=\"none\" stroke=\"#f6f1e7\" stroke-width=\"1.5\"/></svg>\n          <div class=\"c-series\">Quiet Hinge \u00b7 No. 37</div>\n          <div class=\"c-title\">The Tide Table<em>for a Drowned Orchard</em></div>\n          <div class=\"c-author\">Adaeze Mwangi</div>\n        </div>\n      </div>\n\n      <div class=\"featured-meta\">\n        <span class=\"tag\">New this season</span>\n        <h2 id=\"featured-title\">The Tide Table for a Drowned Orchard</h2>\n        <p class=\"byline\">Adaeze Mwangi</p>\n        <p>\n          A sequence of sixty-one poems that trace a family's coastal farm through three\n          floods, two funerals, and one very stubborn pear tree. Mwangi writes with\n          the precision of a surveyor and the patience of someone who has learned\n          to wait for water to go down.\n        </p>\n\n        <blockquote class=\"poem\">\n          <p>We measured the orchard by what the sea had taken:<br>\n          four rows, one well, the word for ladder in my mother's language.</p>\n          <p>The pear stood on, salt-white to the knee,<br>\n          and kept its small hard fruit like a argument it had not finished.</p>\n          <footer>\u2014 from \u201cLow Water, Second Season\u201d</footer>\n        </blockquote>\n\n        <ul class=\"meta-list\">\n          <li>96 pages</li>\n          <li>Flexi-bound, cloth spine</li>\n          <li>Letterpress, 300 copies</li>\n          <li>\u00a318 / $24</li>\n        </ul>\n\n        <div class=\"cta-row\">\n          <a class=\"btn\" href=\"#\">Order the book</a>\n          <a class=\"btn btn-ghost\" href=\"#\">Read a sample (PDF)</a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Catalogue -->\n  <section class=\"section\" id=\"catalogue\" aria-labelledby=\"catalogue-title\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <div>\n          <p class=\"eyebrow\">Catalogue</p>\n          <h2 id=\"catalogue-title\">Recent and forthcoming</h2>\n        </div>\n        <p>Every title is set by hand in a single typeface chosen for that book, printed on\n          uncoated stock, and bound in runs of two to four hundred copies.</p>\n      </div>\n\n      <ul class=\"catalogue\">\n        <li class=\"book\">\n          <div class=\"cover c-sage\">\n            <div class=\"c-series\">No. 36 \u00b7 2024</div>\n            <div class=\"c-title\">Inventory of Small Weathers<em>poems</em></div>\n            <div class=\"c-author\">Tom\u00e1s Reyes-Bell</div>\n          </div>\n          <h3>Inventory of Small Weathers</h3>\n          <p class=\"author\">Tom\u00e1s Reyes-Bell</p>\n          <p class=\"desc\">Forecasts for the weather inside a house after a long absence. Winner of the 2024 Fenwick Prize.</p>\n          <div class=\"row\"><span>\u00a315 \u00b7 Paperback</span><a href=\"#\">Details</a></div>\n        </li>\n\n        <li class=\"book\">\n          <div class=\"cover c-slate\">\n            <div class=\"c-series\">No. 35 \u00b7 2024</div>\n            <div class=\"c-title\">Nightshift Glossary<em>a lexicon in twelve hours</em></div>\n            <div class=\"c-author\">Priya Lind</div>\n          </div>\n          <h3>Nightshift Glossary</h3>\n          <p class=\"author\">Priya Lind</p>\n          <p class=\"desc\">An alphabetized guide to the words hospital workers use after midnight, and what they mean once you have stayed.</p>\n          <div class=\"row\"><span>\u00a315 \u00b7 Paperback</span><a href=\"#\">Details</a></div>\n        </li>\n\n        <li class=\"book\">\n          <div class=\"cover c-ochre\">\n            <div class=\"c-series\">No. 34 \u00b7 2023</div>\n            <div class=\"c-title\">Letters to the Hive<em>and their replies</em></div>\n            <div class=\"c-author\">Oskar Belanger</div>\n          </div>\n          <h3>Letters to the Hive</h3>\n          <p class=\"author\">Oskar Belanger</p>\n          <p class=\"desc\">Short, formal letters addressed to a beekeeping collective that has stopped answering. Illustrated with pressed wax.</p>\n          <div class=\"row\"><span>\u00a312 \u00b7 Chapbook</span><a href=\"#\">Details</a></div>\n        </li>\n\n        <li class=\"book\">\n          <div class=\"cover c-oxblood\">\n            <div class=\"c-series\">Forthcoming \u00b7 2025</div>\n            <div class=\"c-title\">Hinge Country<em>selected poems, 1998\u20132024</em></div>\n            <div class=\"c-author\">Marguerite Ash</div>\n          </div>\n          <h3>Hinge Country</h3>\n          <p class=\"author\">Marguerite Ash</p>\n          <p class=\"desc\">A selected volume spanning a long career, arranged by the places each poem was written from.</p>\n          <div class=\"row\"><span>Pre-order \u00b7 \u00a320</span><a href=\"#\">Notify me</a></div>\n        </li>\n      </ul>\n    </div>\n  </section>\n\n  <!-- About -->\n  <section class=\"section\" id=\"about\" aria-labelledby=\"about-title\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <div>\n          <p class=\"eyebrow\">About the press</p>\n          <h2 id=\"about-title\">Small on purpose</h2>\n        </div>\n        <p>Founded by two poets and a bookbinder, Quiet Hinge exists to make books that\n          feel considered in the hand. We are not trying to be everywhere. We are trying\n          to be exactly right.</p>\n      </div>\n\n      <ol class=\"principles\">\n        <li>\n          <span class=\"num\">01</span>\n          <h3>Hand-set type</h3>\n          <p>Every book is composed by hand from metal and wood type. We proof on paper, not screens,\n            and we read every line aloud before it goes to press.</p>\n        </li>\n        <li>\n          <span class=\"num\">02</span>\n          <h3>Short runs</h3>\n          <p>Print runs of 200 to 400 copies keep us honest. Nothing sits in a warehouse waiting\n            to be pulped, and nothing goes out of print by accident.</p>\n        </li>\n        <li>\n          <span class=\"num\">03</span>\n          <h3>Paid reading</h3>\n          <p>Every submission is read by at least two editors and paid for. Shortlisted poets\n            receive a fee, a written response, and a copy of the finished book.</p>\n        </li>\n      </ol>\n    </div>\n  </section>\n\n  <!-- Submissions -->\n  <section class=\"section submit\" id=\"submit\" aria-labelledby=\"submit-title\">\n    <div class=\"wrap submit-grid\">\n      <div>\n        <p class=\"eyebrow\">Submissions</p>\n        <h2 id=\"submit-title\">Send us your manuscript</h2>\n        <p style=\"margin-top:1.25rem;\">We publish full-length collections and chapbooks. We are especially interested in\n          work that takes formal risks, works in translation, and manuscripts from poets\n          who have not yet had a book out.</p>\n        <p class=\"status\">Open for full-length manuscripts until 30 September</p>\n\n        <dl>\n          <dt>Full-length</dt>\n          <dd>48 to 80 pages of poems \u00b7 Reading fee \u00a30 \u00b7 Response within 4 months</dd>\n          <dt>Chapbook</dt>\n          <dd>16 to 24 pages \u00b7 Reading fee \u00a30 \u00b7 Response within 3 months</dd>\n          <dt>Format</dt>\n          <dd>\n            <ul>\n              <li>One PDF, single column, name removed from the file</li>\n              <li>A cover letter of no more than 150 words</li>\n              <li>A table of contents</li>\n            </ul>\n          </dd>\n        </dl>\n      </div>\n\n      <div>\n        <p class=\"eyebrow\" style=\"color: var(--ink);\">Keep in touch</p>\n        <h3 style=\"margin-bottom:1rem;\" id=\"subscribe\">Quarterly letter, no more than that</h3>\n        <p style=\"margin-top:0; color: var(--ink-soft);\">New titles, reading windows, and the occasional poem that didn\u2019t make it into a book.</p>\n\n        <form class=\"subscribe\" action=\"#\" method=\"post\" onsubmit=\"event.preventDefault(); this.querySelector('.form-note').textContent='Thank you. Please check your inbox to confirm.';\">\n          <div class=\"row2\">\n            <label>First name\n              <input type=\"text\" name=\"first\" autocomplete=\"given-name\">\n            </label>\n            <label>Email\n              <input type=\"email\" name=\"email\" required autocomplete=\"email\">\n            </label>\n          </div>\n          <label>I am mostly interested in\n            <select name=\"interest\">\n              <option>Reading new books</option>\n              <option>Submitting my work</option>\n              <option>Events and readings</option>\n              <option>All of the above</option>\n            </select>\n          </label>\n          <label class=\"checkbox\">\n            <input type=\"checkbox\" name=\"consent\" required>\n            <span>I agree to receive the quarterly letter. I can unsubscribe at any time.</span>\n          </label>\n          <button class=\"btn\" type=\"submit\">Subscribe</button>\n          <p class=\"form-note\" aria-live=\"polite\">We never share addresses. Ever.</p>\n        </form>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer class=\"site-foot\">\n  <div class=\"wrap\">\n    <div class=\"foot-grid\">\n      <div class=\"foot-brand\">\n        <div class=\"logo\" style=\"color: var(--paper);\"><span>Quiet <em style=\"color:#d9a79f\">Hinge</em></span></div>\n        <p>An independent poetry press. Four books a year, printed in small runs, bound by hand.</p>\n      </div>\n      <div>\n        <h4>Press</h4>\n        <ul>\n          <li><a href=\"#catalogue\">Catalogue</a></li>\n          <li><a href=\"#about\">About</a></li>\n          <li><a href=\"#\">Authors</a></li>\n          <li><a href=\"#\">Events</a></li>\n        </ul>\n      </div>\n      <div>\n        <h4>Readers</h4>\n        <ul>\n          <li><a href=\"#\">Bookshops</a></li>\n          <li><a href=\"#\">Wholesale</a></li>\n          <li><a href=\"#\">Shipping</a></li>\n          <li><a href=\"#subscribe\">Newsletter</a></li>\n        </ul>\n      </div>\n      <div>\n        <h4>Contact</h4>\n        <ul>\n          <li><a href=\"mailto:hello@quiethinge.example\">hello@quiethinge.example</a></li>\n          <li><a href=\"#\">Instagram</a></li>\n          <li><a href=\"#\">Mastodon</a></li>\n        </ul>\n      </div>\n    </div>\n    <div class=\"foot-base\">\n      <span>\u00a9 2025 Quiet Hinge Press. All rights revert to authors.</span>\n      <span>Set in Iowan Old Style. Printed on uncoated stock.</span>\n    </div>\n  </div>\n</footer>\n\n</body>\n</html>\n"}