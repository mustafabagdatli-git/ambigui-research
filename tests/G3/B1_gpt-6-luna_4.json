{"brief": "B1", "model": "openai/gpt-6-luna", "i": 4, "finish": "stop", "html": "<!doctype html>\n<html lang=\"en-GB\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#f7f5ef\">\n  <meta name=\"description\" content=\"Friendly, reliable family plumbers serving Leeds and nearby areas. From dripping taps to bathroom installations, we're here to help.\">\n  <title>Hearth & Flow Plumbing | Leeds</title>\n  <style>\n    :root {\n      --ink: #19333a;\n      --muted: #627477;\n      --teal: #167c78;\n      --teal-dark: #106763;\n      --mint: #dcefeb;\n      --cream: #f7f5ef;\n      --white: #fffefa;\n      --coral: #f07d5d;\n      --line: #e6e5dc;\n      --shadow: 0 22px 60px rgba(25, 51, 58, .11);\n      --radius: 22px;\n    }\n\n    * { box-sizing: border-box; }\n\n    html { scroll-behavior: smooth; }\n\n    body {\n      margin: 0;\n      background: var(--cream);\n      color: var(--ink);\n      font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      line-height: 1.6;\n    }\n\n    a { color: inherit; }\n\n    a:focus-visible,\n    button:focus-visible {\n      outline: 3px solid var(--coral);\n      outline-offset: 4px;\n    }\n\n    .wrap {\n      width: min(1160px, calc(100% - 48px));\n      margin-inline: auto;\n    }\n\n    .topbar {\n      background: var(--ink);\n      color: #fff;\n      font-size: .82rem;\n      letter-spacing: .02em;\n    }\n\n    .topbar-inner {\n      min-height: 38px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 16px;\n    }\n\n    .topbar p { margin: 0; }\n\n    .topbar a {\n      color: #bde8de;\n      text-decoration: none;\n      font-weight: 700;\n    }\n\n    header {\n      position: relative;\n      z-index: 2;\n      background: rgba(247, 245, 239, .94);\n      border-bottom: 1px solid rgba(25, 51, 58, .08);\n    }\n\n    .nav {\n      min-height: 82px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 32px;\n    }\n\n    .brand {\n      display: inline-flex;\n      align-items: center;\n      gap: 11px;\n      text-decoration: none;\n      line-height: 1.05;\n    }\n\n    .brand-mark {\n      width: 42px;\n      height: 42px;\n      display: grid;\n      place-items: center;\n      border-radius: 14px;\n      color: white;\n      background: var(--teal);\n    }\n\n    .brand-name {\n      display: block;\n      font-size: 1rem;\n      font-weight: 850;\n      letter-spacing: -.04em;\n    }\n\n    .brand-sub {\n      display: block;\n      margin-top: 4px;\n      color: var(--muted);\n      font-size: .68rem;\n      font-weight: 700;\n      letter-spacing: .12em;\n      text-transform: uppercase;\n    }\n\n    .nav-links {\n      display: flex;\n      align-items: center;\n      gap: 30px;\n      margin: 0;\n      padding: 0;\n      list-style: none;\n    }\n\n    .nav-links a {\n      color: #385157;\n      font-size: .9rem;\n      font-weight: 650;\n      text-decoration: none;\n    }\n\n    .nav-links a:hover { color: var(--teal); }\n\n    .button {\n      min-height: 48px;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: 9px;\n      padding: 0 20px;\n      border: 0;\n      border-radius: 999px;\n      background: var(--teal);\n      color: white;\n      font: inherit;\n      font-size: .92rem;\n      font-weight: 750;\n      text-decoration: none;\n      transition: background .2s ease, transform .2s ease;\n    }\n\n    .button:hover {\n      background: var(--teal-dark);\n      transform: translateY(-2px);\n    }\n\n    .button-light {\n      background: white;\n      color: var(--ink);\n      box-shadow: 0 5px 18px rgba(25, 51, 58, .08);\n    }\n\n    .button-light:hover { background: #f0f7f4; }\n\n    .hero {\n      position: relative;\n      overflow: hidden;\n      padding: 78px 0 72px;\n    }\n\n    .hero::before {\n      content: \"\";\n      position: absolute;\n      width: 560px;\n      height: 560px;\n      top: -280px;\n      right: -140px;\n      border-radius: 50%;\n      background: #e9f1e9;\n      z-index: -1;\n    }\n\n    .hero-grid {\n      display: grid;\n      grid-template-columns: 1.04fr .96fr;\n      align-items: center;\n      gap: 70px;\n    }\n\n    .eyebrow {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      margin: 0 0 20px;\n      color: var(--teal-dark);\n      font-size: .76rem;\n      font-weight: 850;\n      letter-spacing: .13em;\n      text-transform: uppercase;\n    }\n\n    .eyebrow::before {\n      content: \"\";\n      width: 23px;\n      height: 2px;\n      background: var(--coral);\n    }\n\n    h1, h2, h3, p { margin-top: 0; }\n\n    h1 {\n      max-width: 640px;\n      margin-bottom: 22px;\n      font-size: clamp(3rem, 6vw, 5.35rem);\n      line-height: .99;\n      letter-spacing: -.075em;\n    }\n\n    h1 span { color: var(--teal); }\n\n    .hero-copy {\n      max-width: 520px;\n      margin-bottom: 28px;\n      color: var(--muted);\n      font-size: 1.1rem;\n    }\n\n    .hero-actions {\n      display: flex;\n      align-items: center;\n      flex-wrap: wrap;\n      gap: 13px;\n    }\n\n    .hero-note {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      margin: 22px 0 0;\n      color: var(--muted);\n      font-size: .88rem;\n    }\n\n    .hero-note svg { color: var(--teal); }\n\n    .hero-art {\n      position: relative;\n      min-height: 440px;\n      display: grid;\n      place-items: center;\n    }\n\n    .art-card {\n      position: relative;\n      width: min(100%, 475px);\n      aspect-ratio: 1 / .92;\n      overflow: hidden;\n      display: grid;\n      place-items: center;\n      border-radius: 42% 42% 32px 32px;\n      background: #d9ece6;\n    }\n\n    .art-card::before,\n    .art-card::after {\n      content: \"\";\n      position: absolute;\n      border: 1px solid rgba(22, 124, 120, .18);\n      border-radius: 50%;\n    }\n\n    .art-card::before {\n      width: 370px;\n      height: 370px;\n      right: -145px;\n      top: -125px;\n    }\n\n    .art-card::after {\n      width: 270px;\n      height: 270px;\n      left: -130px;\n      bottom: -115px;\n    }\n\n    .art-card svg {\n      position: relative;\n      z-index: 1;\n      width: 88%;\n      max-height: 390px;\n    }\n\n    .art-tag {\n      position: absolute;\n      z-index: 2;\n      display: flex;\n      align-items: center;\n      gap: 11px;\n      padding: 13px 17px;\n      border: 1px solid rgba(25, 51, 58, .06);\n      border-radius: 16px;\n      background: var(--white);\n      box-shadow: var(--shadow);\n      font-size: .84rem;\n      font-weight: 750;\n    }\n\n    .art-tag strong {\n      display: block;\n      font-size: .93rem;\n    }\n\n    .art-tag small {\n      display: block;\n      color: var(--muted);\n      font-size: .75rem;\n      font-weight: 550;\n    }\n\n    .tag-rating { left: -24px; top: 54px; }\n    .tag-family { right: -22px; bottom: 42px; }\n\n    .tag-icon {\n      width: 39px;\n      height: 39px;\n      display: grid;\n      place-items: center;\n      border-radius: 12px;\n      background: #fff0e9;\n      color: var(--coral);\n    }\n\n    .tag-family .tag-icon {\n      background: var(--mint);\n      color: var(--teal);\n    }\n\n    .trust-strip {\n      padding: 20px 0;\n      border-top: 1px solid var(--line);\n      border-bottom: 1px solid var(--line);\n      background: rgba(255, 254, 250, .65);\n    }\n\n    .trust-inner {\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      gap: 18px;\n    }\n\n    .trust-item {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 11px;\n      color: #385157;\n      font-size: .86rem;\n      font-weight: 700;\n    }\n\n    .trust-item svg { color: var(--teal); flex: 0 0 auto; }\n\n    section { scroll-margin-top: 24px; }\n\n    .section {\n      padding: 92px 0;\n    }\n\n    .section-heading {\n      max-width: 620px;\n      margin: 0 auto 42px;\n      text-align: center;\n    }\n\n    .section-heading .eyebrow { justify-content: center; }\n\n    h2 {\n      margin-bottom: 14px;\n      font-size: clamp(2.1rem, 4vw, 3.25rem);\n      line-height: 1.08;\n      letter-spacing: -.06em;\n    }\n\n    .section-heading > p:last-child {\n      margin-bottom: 0;\n      color: var(--muted);\n      font-size: 1rem;\n    }\n\n    .services-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 18px;\n    }\n\n    .service-card {\n      min-height: 230px;\n      padding: 27px;\n      border: 1px solid var(--line);\n      border-radius: var(--radius);\n      background: var(--white);\n      transition: transform .2s ease, box-shadow .2s ease;\n    }\n\n    .service-card:hover {\n      transform: translateY(-4px);\n      box-shadow: var(--shadow);\n    }\n\n    .service-icon {\n      width: 48px;\n      height: 48px;\n      display: grid;\n      place-items: center;\n      margin-bottom: 21px;\n      border-radius: 15px;\n      background: var(--mint);\n      color: var(--teal);\n    }\n\n    .service-card h3 {\n      margin-bottom: 8px;\n      font-size: 1.1rem;\n      letter-spacing: -.025em;\n    }\n\n    .service-card p {\n      margin-bottom: 0;\n      color: var(--muted);\n      font-size: .92rem;\n    }\n\n    .about {\n      padding: 74px 0;\n      background: var(--ink);\n      color: white;\n    }\n\n    .about-grid {\n      display: grid;\n      grid-template-columns: .94fr 1.06fr;\n      align-items: center;\n      gap: 72px;\n    }\n\n    .about-art {\n      position: relative;\n      min-height: 360px;\n      display: grid;\n      place-items: center;\n      overflow: hidden;\n      border-radius: 30px;\n      background: #27464c;\n    }\n\n    .about-art::before {\n      content: \"\";\n      position: absolute;\n      width: 340px;\n      height: 340px;\n      border: 1px solid rgba(189, 232, 222, .22);\n      border-radius: 50%;\n    }\n\n    .about-art svg { position: relative; width: 215px; }\n\n    .about-copy .eyebrow { color: #a4ded1; }\n\n    .about-copy h2 { max-width: 500px; }\n\n    .about-copy > p:not(.eyebrow) {\n      max-width: 530px;\n      color: #c4d2d1;\n    }\n\n    .about-points {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 14px 22px;\n      margin: 27px 0 30px;\n      padding: 0;\n      list-style: none;\n    }\n\n    .about-points li {\n      display: flex;\n      align-items: center;\n      gap: 9px;\n      font-size: .9rem;\n      font-weight: 650;\n    }\n\n    .about-points svg { color: #94d8c9; flex: 0 0 auto; }\n\n    .reviews { background: #f0f4ee; }\n\n    .review-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 18px;\n    }\n\n    .review-card {\n      padding: 26px;\n      border: 1px solid rgba(25, 51, 58, .08);\n      border-radius: var(--radius);\n      background: var(--white);\n    }\n\n    .stars {\n      margin-bottom: 14px;\n      color: #dd8c46;\n      letter-spacing: .15em;\n      font-size: .98rem;\n    }\n\n    .review-card blockquote {\n      margin: 0 0 21px;\n      color: #385157;\n      font-size: .96rem;\n    }\n\n    .reviewer {\n      display: flex;\n      align-items: center;\n      gap: 11px;\n      font-size: .85rem;\n      font-weight: 750;\n    }\n\n    .review-avatar {\n      width: 36px;\n      height: 36px;\n      display: grid;\n      place-items: center;\n      border-radius: 50%;\n      background: var(--mint);\n      color: var(--teal-dark);\n      font-size: .78rem;\n    }\n\n    .reviewer small {\n      display: block;\n      color: var(--muted);\n      font-size: .74rem;\n      font-weight: 550;\n    }\n\n    .area-contact {\n      padding: 84px 0;\n    }\n\n    .contact-panel {\n      position: relative;\n      overflow: hidden;\n      display: grid;\n      grid-template-columns: 1.2fr .8fr;\n      align-items: center;\n      gap: 50px;\n      padding: 48px;\n      border-radius: 30px;\n      background: #e0efea;\n    }\n\n    .contact-panel::after {\n      content: \"\";\n      position: absolute;\n      width: 280px;\n      height: 280px;\n      right: 20%;\n      top: -190px;\n      border: 1px solid rgba(22, 124, 120, .16);\n      border-radius: 50%;\n      pointer-events: none;\n    }\n\n    .contact-panel h2 {\n      max-width: 540px;\n      margin-bottom: 12px;\n    }\n\n    .contact-panel p { color: #536c6c; }\n\n    .contact-side {\n      position: relative;\n      z-index: 1;\n      text-align: center;\n    }\n\n    .contact-side p {\n      margin-bottom: 8px;\n      color: var(--muted);\n      font-size: .83rem;\n      font-weight: 700;\n    }\n\n    .phone-link {\n      display: block;\n      margin-bottom: 18px;\n      color: var(--ink);\n      font-size: clamp(1.6rem, 3vw, 2rem);\n      font-weight: 850;\n      letter-spacing: -.045em;\n      text-decoration: none;\n    }\n\n    .areas-line {\n      margin-top: 28px;\n      color: var(--muted);\n      font-size: .88rem;\n    }\n\n    footer {\n      padding: 30px 0;\n      background: #122a30;\n      color: #c4d2d1;\n      font-size: .83rem;\n    }\n\n    .footer-inner {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 20px;\n    }\n\n    .footer-inner p { margin: 0; }\n\n    .footer-links {\n      display: flex;\n      gap: 20px;\n    }\n\n    .footer-links a {\n      color: #c4d2d1;\n      text-decoration: none;\n    }\n\n    .footer-links a:hover { color: white; }\n\n    @media (max-width: 900px) {\n      .hero-grid { gap: 34px; }\n      .nav-links { gap: 17px; }\n      .about-grid { gap: 40px; }\n      .contact-panel { gap: 25px; padding: 38px; }\n    }\n\n    @media (max-width: 720px) {\n      .wrap { width: min(100% - 34px, 560px); }\n      .topbar-inner { min-height: 34px; font-size: .72rem; }\n      .topbar-inner p:first-child { display: none; }\n      .topbar-inner { justify-content: center; }\n      .nav { min-height: 70px; flex-wrap: wrap; gap: 10px; padding: 12px 0; }\n      .nav-links { order: 3; width: 100%; justify-content: space-between; gap: 8px; }\n      .nav-links a { font-size: .79rem; }\n      .nav > .button { min-height: 42px; padding-inline: 14px; font-size: .82rem; }\n      .brand-mark { width: 38px; height: 38px; }\n      .hero { padding: 54px 0 52px; }\n      .hero-grid { grid-template-columns: 1fr; gap: 38px; }\n      h1 { max-width: 540px; font-size: clamp(3.1rem, 13vw, 4.6rem); }\n      .hero-copy { font-size: 1rem; }\n      .hero-art { min-height: 340px; }\n      .art-card { width: min(86%, 390px); }\n      .tag-rating { left: 0; top: 25px; }\n      .tag-family { right: 0; bottom: 22px; }\n      .trust-inner { grid-template-columns: 1fr 1fr; gap: 15px 8px; }\n      .trust-item { justify-content: flex-start; font-size: .77rem; }\n      .section { padding: 68px 0; }\n      .section-heading { margin-bottom: 30px; }\n      .services-grid { grid-template-columns: 1fr 1fr; gap: 12px; }\n      .service-card { min-height: 0; padding: 20px; }\n      .service-icon { margin-bottom: 15px; }\n      .service-card h3 { font-size: 1rem; }\n      .service-card p { font-size: .84rem; }\n      .about { padding: 58px 0; }\n      .about-grid { grid-template-columns: 1fr; gap: 35px; }\n      .about-art { min-height: 270px; }\n      .about-art svg { width: 175px; }\n      .review-grid { grid-template-columns: 1fr; }\n      .review-card { padding: 23px; }\n      .area-contact { padding: 62px 0; }\n      .contact-panel { grid-template-columns: 1fr; gap: 28px; padding: 30px 24px; }\n      .contact-side { text-align: left; }\n      .footer-inner { align-items: flex-start; flex-direction: column; }\n    }\n\n    @media (max-width: 420px) {\n      .services-grid { grid-template-columns: 1fr; }\n      .service-card { display: grid; grid-template-columns: 48px 1fr; column-gap: 15px; }\n      .service-icon { grid-row: span 2; margin: 0; }\n      .service-card h3 { align-self: end; }\n      .service-card p { grid-column: 2; }\n      .hero-actions { align-items: stretch; flex-direction: column; }\n      .hero-actions .button { width: 100%; }\n      .about-points { grid-template-columns: 1fr; }\n      .art-tag { padding: 10px 12px; }\n      .tag-rating { left: -2px; }\n      .tag-family { right: -2px; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      html { scroll-behavior: auto; }\n      *, *::before, *::after {\n        transition-duration: .01ms !important;\n        animation-duration: .01ms !important;\n        animation-iteration-count: 1 !important;\n      }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"topbar\">\n    <div class=\"wrap topbar-inner\">\n      <p>Local, family-run plumbing in Leeds</p>\n      <p>Need a hand? <a href=\"tel:+441135550148\">Call our friendly team</a></p>\n    </div>\n  </div>\n\n  <header>\n    <nav class=\"wrap nav\" aria-label=\"Main navigation\">\n      <a class=\"brand\" href=\"#home\" aria-label=\"Hearth and Flow Plumbing home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg width=\"25\" height=\"25\" viewBox=\"0 0 24 24\" fill=\"none\">\n            <path d=\"M4 13.5 12 6l8 7.5v5.2a1.3 1.3 0 0 1-1.3 1.3H5.3A1.3 1.3 0 0 1 4 18.7v-5.2Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/>\n            <path d=\"M9 20v-5.2a3 3 0 0 1 6 0V20M3 12l9-8 9 8\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          </svg>\n        </span>\n        <span>\n          <span class=\"brand-name\">Hearth &amp; Flow</span>\n          <span class=\"brand-sub\">Plumbing \u00b7 Leeds</span>\n        </span>\n      </a>\n\n      <ul class=\"nav-links\">\n        <li><a href=\"#services\">Services</a></li>\n        <li><a href=\"#about\">Our family</a></li>\n        <li><a href=\"#reviews\">Reviews</a></li>\n        <li><a href=\"#contact\">Areas</a></li>\n      </ul>\n\n      <a class=\"button\" href=\"tel:+441135550148\">\n        <svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n          <path d=\"M7.2 3.5H4.7A1.7 1.7 0 0 0 3 5.2C3 14 10 21 18.8 21a1.7 1.7 0 0 0 1.7-1.7v-2.5l-4.4-1.4-1.8 2.1a14.7 14.7 0 0 1-5.8-5.8l2.1-1.8-1.4-4.4Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </svg>\n        Call us\n      </a>\n    </nav>\n  </header>\n\n  <main>\n    <section class=\"hero\" id=\"home\">\n      <div class=\"wrap hero-grid\">\n        <div>\n          <p class=\"eyebrow\">Good people. Good plumbing.</p>\n          <h1>Leeds plumbing,<br><span>done properly.</span></h1>\n          <p class=\"hero-copy\">From a tap that won\u2019t stop dripping to a bathroom you\u2019ll love, our family team brings honest advice and a tidy finish to every job.</p>\n          <div class=\"hero-actions\">\n            <a class=\"button\" href=\"tel:+441135550148\">\n              Call for a friendly chat\n              <svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n                <path d=\"M5 12h14M13 6l6 6-6 6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n            </a>\n            <a class=\"button button-light\" href=\"#services\">Explore our services</a>\n          </div>\n          <p class=\"hero-note\">\n            <svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n              <path d=\"m5 12 4.2 4.2L19 6.5\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            </svg>\n            Clear quotes, no fuss, and respect for your home.\n          </p>\n        </div>\n\n        <div class=\"hero-art\" aria-label=\"Illustration o