{"brief": "B6", "model": "z-ai/glm-5.3-flashx", "i": 4, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>HOOKUP SKATES \u2014 Shop &amp; Lessons</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Grotesk:wght@400;500;700&display=swap\" rel=\"stylesheet\">\n<style>\n:root{\n  --ink:#141210;\n  --paper:#f4f0e8;\n  --orange:#ff4d00;\n  --yellow:#ffd400;\n  --line:#141210;\n}\n*{margin:0;padding:0;box-sizing:border-box}\nhtml{scroll-behavior:smooth}\nbody{\n  font-family:'Space Grotesk',sans-serif;\n  background:var(--paper);\n  color:var(--ink);\n  overflow-x:hidden;\n}\n::selection{background:var(--orange);color:var(--paper)}\n\n/* ---------- NAV ---------- */\nnav{\n  position:sticky;top:0;z-index:100;\n  display:flex;justify-content:space-between;align-items:center;\n  padding:14px 32px;\n  background:var(--paper);\n  border-bottom:3px solid var(--line);\n}\n.logo{font-family:'Archivo Black';font-size:1.25rem;letter-spacing:-.02em;display:flex;align-items:center;gap:10px}\n.logo svg{display:block}\n.nav-links{display:flex;gap:28px;list-style:none;align-items:center}\n.nav-links a{\n  text-decoration:none;color:var(--ink);font-weight:700;font-size:.85rem;\n  text-transform:uppercase;letter-spacing:.08em;position:relative;\n}\n.nav-links a::after{\n  content:\"\";position:absolute;left:0;bottom:-4px;height:3px;width:0;\n  background:var(--orange);transition:width .2s;\n}\n.nav-links a:hover::after{width:100%}\n.cart-btn{\n  background:var(--ink);color:var(--paper);border:none;cursor:pointer;\n  font-family:inherit;font-weight:700;font-size:.85rem;padding:10px 18px;\n  display:flex;align-items:center;gap:8px;transition:background .2s;\n}\n.cart-btn:hover{background:var(--orange)}\n#cartCount{background:var(--yellow);color:var(--ink);border-radius:50%;width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;font-size:.75rem}\n\n/* ---------- MARQUEE ---------- */\n.marquee{\n  background:var(--ink);color:var(--yellow);\n  overflow:hidden;white-space:nowrap;padding:10px 0;\n  border-bottom:3px solid var(--line);\n}\n.marquee-inner{display:inline-block;animation:scroll 22s linear infinite}\n.marquee span{font-family:'Archivo Black';text-transform:uppercase;font-size:.9rem;letter-spacing:.1em;padding:0 24px}\n@keyframes scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}\n\n/* ---------- HERO ---------- */\n.hero{\n  padding:80px 32px 60px;position:relative;\n  border-bottom:3px solid var(--line);\n}\n.hero h1{\n  font-family:'Archivo Black';\n  font-size:clamp(3rem,10vw,8.5rem);\n  line-height:.92;text-transform:uppercase;letter-spacing:-.03em;\n}\n.hero h1 .outline{\n  color:transparent;-webkit-text-stroke:3px var(--ink);\n}\n.hero h1 .pop{color:var(--orange)}\n.hero p.lede{max-width:520px;margin-top:28px;font-size:1.1rem;line-height:1.6;font-weight:500}\n.hero-cta{display:flex;gap:16px;margin-top:36px;flex-wrap:wrap}\n.btn{\n  font-family:'Archivo Black';text-transform:uppercase;letter-spacing:.05em;\n  padding:16px 32px;font-size:.9rem;cursor:pointer;text-decoration:none;\n  border:3px solid var(--line);transition:transform .15s,box-shadow .15s;\n  display:inline-block;\n}\n.btn-primary{background:var(--orange);color:var(--paper);box-shadow:6px 6px 0 var(--line)}\n.btn-ghost{background:var(--paper);color:var(--ink);box-shadow:6px 6px 0 var(--line)}\n.btn:hover{transform:translate(-2px,-2px);box-shadow:8px 8px 0 var(--line)}\n.btn:active{transform:translate(2px,2px);box-shadow:2px 2px 0 var(--line)}\n.hero-skate{\n  position:absolute;right:6vw;top:50%;transform:translateY(-50%) rotate(-12deg);\n  pointer-events:none;\n}\n@media(max-width:900px){.hero-skate{display:none}}\n\n/* ---------- SECTION HEADERS ---------- */\n.sec-head{\n  display:flex;align-items:baseline;justify-content:space-between;\n  padding:56px 32px 28px;flex-wrap:wrap;gap:12px;\n}\n.sec-head h2{font-family:'Archivo Black';font-size:clamp(1.8rem,4.5vw,3rem);text-transform:uppercase;letter-spacing:-.02em}\n.sec-head h2 em{font-style:normal;color:var(--orange)}\n.sec-head .kicker{font-weight:700;text-transform:uppercase;letter-spacing:.12em;font-size:.8rem;border:2px solid var(--ink);padding:6px 12px}\n\n/* ---------- SHOP ---------- */\n#shop{border-bottom:3px solid var(--line)}\n.grid{\n  display:grid;gap:0;border-top:3px solid var(--line);\n}\n.card{\n  border-right:3px solid var(--line);border-bottom:3px solid var(--line);\n  padding:32px;position:relative;background:var(--paper);\n  transition:background .2s;\n}\n.grid-cols-4 .card{grid-column:span 1}\n@media(max-width:1000px){.grid-cols-4{grid-template-columns:repeat(2,1fr)}}\n@media(max-width:560px){.grid-cols-4{grid-template-columns:1fr}.card{border-right:none}}\n.card:hover{background:#fff}\n.card .tag{\n  position:absolute;top:16px;left:16px;background:var(--yellow);\n  font-weight:700;font-size:.7rem;text-transform:uppercase;letter-spacing:.1em;\n  padding:4px 10px;transform:rotate(-3deg);\n}\n.deck-art{height:220px;display:flex;align-items:center;justify-content:center;margin-bottom:20px}\n.card h3{font-family:'Archivo Black';font-size:1.1rem;text-transform:uppercase}\n.card .sub{font-size:.9rem;margin:6px 0 16px;min-height:2.4em;line-height:1.2;font-weight:500}\n.card-foot{display:flex;justify-content:space-between;align-items:center}\n.price{font-family:'Archivo Black';font-size:1.15rem}\n.add{\n  background:var(--ink);color:var(--paper);border:none;padding:10px 18px;\n  font-family:inherit;font-weight:700;font-size:.8rem;text-transform:uppercase;\n  letter-spacing:.08em;cursor:pointer;transition:background .2s;\n}\n.add:hover{background:var(--orange)}\n.add.added{background:var(--orange)}\n\n/* ---------- LESSONS ---------- */\n#lessons{background:var(--ink);color:var(--paper);border-bottom:3px solid var(--line)}\n#lessons .sec-head .kicker{border-color:var(--paper);color:var(--yellow)}\n.lesson-row{\n  display:grid;grid-template-columns:110px 1fr 1fr 200px;\n  gap:24px;align-items:center;\n  padding:28px 32px;border-top:1px solid #3a3733;cursor:pointer;\n  transition:background .2s;\n}\n.lesson-row:hover{background:#201d1a}\n.lesson-row:first-of-type{border-top:none}\n.lvl{\n  font-family:'Archivo Black';font-size:1rem;color:var(--yellow);\n  text-transform:uppercase;transform:rotate(-3deg);display:inline-block;\n}\n.lesson-row h3{font-family:'Archivo Black';font-size:1.4rem;text-transform:uppercase;letter-spacing:-.01em}\n.lesson-row .meta{font-weight:500;color:#b8b2a8;font-size:.95rem;line-height:1.5}\n.book-btn{\n  justify-self:end;background:transparent;color:var(--paper);\n  border:2px solid var(--paper);padding:12px 24px;font-family:'Archivo Black';\n  text-transform:uppercase;font-size:.8rem;letter-spacing:.06em;cursor:pointer;\n  transition:.2s;white-space:nowrap;\n}\n.book-btn:hover{background:var(--orange);border-color:var(--orange);color:var(--paper)}\n@media(max-width:820px){\n  .lesson-row{grid-template-columns:1fr;gap:10px}\n  .book-btn{justify-self:start}\n}\n.lessons-note{padding:24px 32px 56px;color:#b8b2a8;font-weight:500;max-width:640px}\n\n/* ---------- ABOUT / STRIPES ---------- */\n.about{\n  padding:72px 32px;display:grid;grid-template-columns:1fr 1fr;gap:64px;\n  border-bottom:3px solid var(--line);align-items:center;\n}\n@media(max-width:820px){.about{grid-template-columns:1fr}}\n.about h2{font-family:'Archivo Black';font-size:clamp(1.8rem,4vw,2.8rem);text-transform:uppercase;line-height:1.05;letter-spacing:-.02em}\n.about h2 em{font-style:normal;color:var(--orange)}\n.about p{margin-top:20px;line-height:1.7;font-weight:500;font-size:1.05rem}\n.stats{display:grid;grid-template-columns:1fr 1fr;gap:3px;border:3px solid var(--line)}\n.stat{background:var(--paper);padding:28px;transition:background .2s}\n.stat:hover{background:var(--yellow)}\n.stat b{font-family:'Archivo Black';font-size:2.2rem;display:block}\n.stat span{font-weight:700;text-transform:uppercase;font-size:.75rem;letter-spacing:.1em}\n\n/* ---------- FOOTER ---------- */\nfooter{background:var(--orange);color:var(--paper);padding:56px 32px 32px}\n.foot-top{display:flex;justify-content:space-between;flex-wrap:wrap;gap:32px;margin-bottom:48px}\n.foot-top h2{font-family:'Archivo Black';font-size:clamp(2rem,6vw,4.5rem);text-transform:uppercase;letter-spacing:-.03em;line-height:.95}\n.foot-links{display:flex;gap:48px;flex-wrap:wrap}\n.foot-links div h4{font-family:'Archivo Black';text-transform:uppercase;font-size:.85rem;margin-bottom:12px;color:var(--ink)}\n.foot-links a{display:block;color:var(--paper);text-decoration:none;font-weight:500;padding:3px 0}\n.foot-links a:hover{text-decoration:underline}\n.foot-bottom{border-top:2px solid var(--paper);padding-top:20px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-weight:500;font-size:.85rem}\n\n/* ---------- TOAST ---------- */\n#toast{\n  position:fixed;bottom:24px;left:50%;transform:translate(-50%,120%);\n  background:var(--ink);color:var(--yellow);padding:14px 28px;\n  font-family:'Archivo Black';text-transform:uppercase;font-size:.85rem;\n  border:3px solid var(--yellow);z-index:200;transition:transform .3s;\n  letter-spacing:.05em;\n}\n#toast.show{transform:translate(-50%,0)}\n</style>\n</head>\n<body>\n\n<nav>\n  <div class=\"logo\">\n    <svg width=\"34\" height=\"20\" viewBox=\"0 0 34 20\" fill=\"none\">\n      <rect x=\"1\" y=\"1\" width=\"32\" height=\"9\" rx=\"4.5\" stroke=\"#141210\" stroke-width=\"2.5\" fill=\"#ff4d00\"/>\n      <circle cx=\"9\" cy=\"16\" r=\"3\" fill=\"#141210\"/>\n      <circle cx=\"25\" cy=\"16\" r=\"3\" fill=\"#141210\"/>\n    </svg>\n    HOOKUP SKATES\n  </div>\n  <ul class=\"nav-links\">\n    <li><a href=\"#shop\">Shop</a></li>\n    <li><a href=\"#lessons\">Lessons</a></li>\n    <li><a href=\"#about\">About</a></li>\n    <li><button class=\"cart-btn\" id=\"cartBtn\">\n      Cart <span id=\"cartCount\">0</span>\n    </button></li>\n  </ul>\n</nav>\n\n<div class=\"marquee\">\n  <div class=\"marquee-inner\" id=\"marqueeInner\">\n    <span>\u2605 New decks in stock \u2605 Free grip tape with any complete \u2605 Kids camps every Saturday \u2605 Beginner lessons start weekly \u2605 Push, don't scroll \u2605</span>\n  </div>\n</div>\n\n<header class=\"hero\">\n  <h1>Ride<br><span class=\"outline\">Harder.</span><br><span class=\"pop\">Fall</span><br>Forward.</h1>\n  <p class=\"lede\">Your local skate shop and school since 2011. Decks, completes, trucks and wheels picked by people who actually skate \u2014 plus lessons for total beginners to street-ready shredders.</p>\n  <div class=\"hero-cta\">\n    <a href=\"#shop\" class=\"btn btn-primary\">Shop Decks</a>\n    <a href=\"#lessons\" class=\"btn btn-ghost\">Book a Lesson</a>\n  </div>\n  <svg class=\"hero-skate\" width=\"340\" height=\"110\" viewBox=\"0 0 340 110\" fill=\"none\">\n    <rect x=\"10\" y=\"10\" width=\"320\" height=\"52\" rx=\"26\" fill=\"#141210\"/>\n    <rect x=\"24\" y=\"22\" width=\"292\" height=\"28\" rx=\"14\" fill=\"#ffd400\"/>\n    <path d=\"M60 22 h40 v28 h-40z\" fill=\"#ff4d00\" opacity=\".9\"/>\n    <path d=\"M180 22 h50 v28 h-50z\" fill=\"#141210\"/>\n    <circle cx=\"80\" cy=\"86\" r=\"18\" fill=\"#f4f0e8\" stroke=\"#141210\" stroke-width=\"6\"/>\n    <circle cx=\"260\" cy=\"86\" r=\"18\" fill=\"#f4f0e8\" stroke=\"#141210\" stroke-width=\"6\"/>\n  </svg>\n</header>\n\n<section id=\"shop\">\n  <div class=\"sec-head\">\n    <h2>The <em>Shop</em></h2>\n    <span class=\"kicker\">Deck season is now</span>\n  </div>\n  <div class=\"grid grid-cols-4\">\n\n    <div class=\"card\">\n      <span class=\"tag\">Best Seller</span>\n      <div class=\"deck-art\">\n        <svg width=\"90\" height=\"210\" viewBox=\"0 0 90 210\">\n          <path d=\"M45 4 C70 4 82 14 82 40 L82 170 C82 196 70 206 45 206 C20 206 8 196 8 170 L8 40 C8 14 20 4 45 4Z\" fill=\"#141210\"/>\n          <circle cx=\"45\" cy=\"70\" r=\"24\" fill=\"#ff4d00\"/>\n          <circle cx=\"45\" cy=\"140\" r=\"14\" fill=\"#ffd400\"/>\n        </svg>\n      </div>\n      <h3>Blackout 8.25\"</h3>\n      <p class=\"sub\">7-ply maple, mellow concave. Our house deck for all-around street.</p>\n      <div class=\"card-foot\"><span class=\"price\">$64</span><button class=\"add\" onclick=\"addToCart(this,'Blackout 8.25&quot;')\">Add</button></div>\n    </div>\n\n    <div class=\"card\">\n      <span class=\"tag\">Complete</span>\n      <div class=\"deck-art\">\n        <svg width=\"90\" height=\"210\" viewBox=\"0 0 90 210\">\n          <path d=\"M45 4 C70 4 82 14 82 40 L82 170 C82 196 70 206 45 206 C20 206 8 196 8 170 L8 40 C8 14 20 4 45 4Z\" fill=\"#ffd400\"/>\n          <path d=\"M45 30 L58 90 L45 150 L32 90 Z\" fill=\"#141210\"/>\n          <circle cx=\"45\" cy=\"90\" r=\"8\" fill=\"#ff4d00\"/>\n        </svg>\n      </div>\n      <h3>First Push Complete</h3>\n      <p class=\"sub\">Deck, trucks, wheels, bearings \u2014 gripped and ready out of the box.</p>\n      <div class=\"card-foot\"><span class=\"price\">$139</span><button class=\"add\" onclick=\"addToCart(this,'First Push Complete')\">Add</button></div>\n    </div>\n\n    <div class=\"card\">\n      <span class=\"tag\">Kids</span>\n      <div class=\"deck-art\">\n        <svg width=\"90\" height=\"210\" viewBox=\"0 0 90 210\">\n          <path d=\"M45 4 C70 4 82 14 82 40 L82 170 C82 196 70 206 45 206 C20 206 8 196 8 170 L8 40 C8 14 20 4 45 4Z\" fill=\"#ff4d00\"/>\n          <rect x=\"28\" y=\"50\" width=\"34\" height=\"34\" fill=\"#f4f0e8\" transform=\"rotate(8 45 67)\"/>\n          <circle cx=\"45\" cy=\"130\" r=\"18\" fill=\"#141210\"/>\n        </svg>\n      </div>\n      <h3>Grom Cruiser 7.0\"</h3>\n      <p class=\"sub\">Shorter wheelbase, softer wheels. Built for small rippers.</p>\n      <div class=\"card-foot\"><span class=\"price\">$99</span><button class=\"add\" onclick=\"addToCart(this,'Grom Cruiser')\">Add</button></div>\n    </div>\n\n    <div class=\"card\">\n      <span class=\"tag\">Wheels</span>\n      <div class=\"deck-art\">\n        <svg width=\"140\" height=\"210\" viewBox=\"0 0 140 210\">\n          <circle cx=\"45\" cy=\"70\" r=\"34\" fill=\"#141210\"/><circle cx=\"45\" cy=\"70\" r=\"14\" fill=\"#ffd400\"/>\n          <circle cx=\"95\" cy=\"70\" r=\"34\" fill=\"#141210\"/><circle cx=\"95\" cy=\"70\" r=\"14\" fill=\"#ffd400\"/>\n          <circle cx=\"45\" cy=\"140\" r=\"34\" fill=\"#141210\"/><circle cx=\"45\" cy=\"140\" r=\"14\" fill=\"#ff4d00\"/>\n          <circle cx=\"95\" cy=\"140\" r=\"34\" fill=\"#141210\"/><circle cx=\"95\" cy=\"140\" r=\"14\" fill=\"#ff4d00\"/>\n        </svg>\n      </div>\n      <h3>Sliders 54mm 99a</h3>\n      <p class=\"sub\">Hard urethane, locked-in slides, smooth over crust. Set of 4.</p>\n      <div class=\"card-foot\"><span class=\"price\">$38</span><button class=\"add\" onclick=\"addToCart(this,'Sliders 54mm')\">Add</button></div>\n    </div>\n\n  </div>\n</section>\n\n<section id=\"lessons\">\n  <div class=\"sec-head\">\n    <h2>Ska<em style=\"color:var(--yellow)\">te</em> School</h2>\n    <span class=\"kicker\">All gear provided</span>\n  </div>\n\n  <div class=\"lesson-row\">\n    <span class=\"lvl\">Level 1</span>\n    <div><h3>Never Skated</h3></div>\n    <p class=\"meta\">Saturdays \u00b7 10:00\u201311:30 AM \u00b7 Max 8 riders<br>Stance, pushing, stopping, falling safely. Zero experience needed.</p>\n    <button class=\"book-btn\" onclick=\"bookLesson('Never Skated')\">Book \u2014 $45</button>\n  </div>\n\n  <div class=\"lesson-row\">\n    <span class=\"lvl\">Level 2</span>\n    <div><h3>Rolling Basics</h3></div>\n    <p class=\"meta\">Saturdays \u00b7 12:00\u20131:30 PM \u00b7 Max 8 riders<br>Ollies, tic-tacs, ramps, and park etiquette. Bring your board or borrow ours.</p>\n    <button class=\"book-btn\" onclick=\"bookLesson('Rolling Basics')\">Book \u2014 $45</button>\n  </div>\n\n  <div class=\"lesson-row\">\n    <span class=\"lvl\">Level 3</span>\n    <div><h3>Street Ready</h3></div>\n    <p class=\"meta\">Sundays \u00b7 10:00 AM\u201312:00 PM \u00b7 Max 6 riders<br>Flip tricks, ledges, rails, and lines. Coached by shop team riders.</p>\n    <button class=\"book-btn\" onclick=\"bookLesson('Street Ready')\">Book \u2014 $60</button>\n  </div>\n\n  <div class=\"lesson-row\">\n    <span class=\"lvl\">Camps</span>\n    <div><h3>School Holiday Camp</h3></div>\n    <p class=\"meta\">Mon\u2013Fri \u00b7 9 AM\u20131 PM \u00b7 Ages 7\u201314<br>A full week of skating, games, and a Friday demo for the parents.</p>\n    <button class=\"book-btn\" onclick=\"bookLesson('Holiday Camp')\">Book \u2014 $220</button>\n  </div>\n\n  <p class=\"lessons-note\">First lesson includes free shop membership: 10% off everything, priority deck service, and open-session access. Helmets required \u2014 we loan them free.</p>\n</section>\n\n<section class=\"about\" id=\"about\">\n  <div>\n    <h2>Built by skaters,<br><em>for skaters.</em></h2>\n    <p>HOOKUP SKATES started as a shoebox of spare parts in a garage in 2011. Fourteen years later we're a full shop, a skate school, and the reason half the town's kids know what a kickflip is. Every deck we sell is one we'd ride, and every coach on staff competes or films. Come say hi \u2014 the coffee's free and so is the advice.</p>\n  </div>\n  <div class=\"stats\">\n    <div class=\"stat\"><b>14</b><span>Years rolling</span></div>\n    <div class=\"stat\"><b>2,300+</b><span>Riders taught</span></div>\n    <div class=\"stat\"><b>6</b><span>Certified coaches</span></div>\n    <div class=\"stat\"><b>100%</b><span>Independent</span></div>\n  </div>\n</section>\n\n<footer>\n  <div class=\"foot-top\">\n    <h2>See you<br>at the park.</h2>\n    <div class=\"foot-links\">\n      <div>\n        <h4>Shop</h4>\n        <a href=\"#shop\">Decks</a><a href=\"#shop\">Completes</a><a href=\"#shop\">Wheels</a><a href=\"#shop\">Hardware</a>\n      </div>\n      <div>\n        <h4>Lessons</h4>\n        <a href=\"#lessons\">Beginner</a><a href=\"#lessons\">Intermediate</a><a href=\"#lessons\">Camps</a>\n      </div>\n      <div>\n        <h4>Visit</h4>\n        <a href=\"#\">12 Curbside Ave</a><a href=\"#\">Open 7 days, 10\u20137</a><a href=\"#\">hello@hookupskates.com</a>\n      </div>\n    </div>\n  </div>\n  <div class=\"foot-bottom\">\n    <span>\u00a9 2025 HOOKUP SKATES. Push, don't scroll.</span>\n    <span>Skateboarding is not a crime.</span>\n  </div>\n</footer>\n\n<div id=\"toast\"></div>\n\n<script>\nlet cart = 0;\nconst toast = document.getElementById('toast');\nlet toastTimer;\n\nfunction showToast(msg){\n  toast.textContent = msg;\n  toast.classList.add('show');\n  clearTimeout(toastTimer);\n  toastTimer = setTimeout(()=>toast.classList.remove('show'), 2200);\n}\n\nfunction addToCart(btn, name){\n  cart++;\n  document.getElementById('cartCount').textContent = cart;\n  btn.classList.add('added');\n  btn.textContent = '\u2713 Added';\n  setTimeout(()=>{btn.classList.remove('added');btn.textContent='Add';},1200);\n  showToast(name + ' added to cart');\n}\n\nfunction bookLesson(name){\n  showToast(name + ' \u2014 booking request sent!');\n}\n\n// duplicate marquee content for seamless loop\nconst mi = document.getElementById('marqueeInner');\nmi.innerHTML += mi.innerHTML;\n</script>\n</body>\n</html>\n"}