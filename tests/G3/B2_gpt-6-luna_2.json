{"brief": "B2", "model": "openai/gpt-6-luna", "i": 2, "finish": "stop", "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#fff9ed\">\n  <title>WonderLab \u2014 A Museum for Curious Kids</title>\n  <style>\n    :root {\n      --ink: #17223b;\n      --cream: #fff9ed;\n      --paper: #ffffff;\n      --coral: #ff705e;\n      --yellow: #ffd65a;\n      --blue: #75d8e8;\n      --lavender: #c9b8ff;\n      --green: #b8e2a2;\n      --muted: #657086;\n      --radius: 24px;\n    }\n\n    * { box-sizing: border-box; }\n\n    html { scroll-behavior: smooth; }\n\n    body {\n      margin: 0;\n      color: var(--ink);\n      background: var(--cream);\n      font-family: \"Trebuchet MS\", \"Avenir Next\", Avenir, system-ui, sans-serif;\n      -webkit-font-smoothing: antialiased;\n    }\n\n    a { color: inherit; text-decoration: none; }\n\n    .shell {\n      width: min(1160px, calc(100% - 48px));\n      margin-inline: auto;\n    }\n\n    .announcement {\n      padding: 10px 16px;\n      text-align: center;\n      color: var(--ink);\n      background: var(--yellow);\n      font-size: 13px;\n      font-weight: 800;\n      letter-spacing: .02em;\n    }\n\n    .announcement a {\n      margin-left: 7px;\n      text-decoration: underline;\n      text-underline-offset: 3px;\n    }\n\n    header {\n      position: relative;\n      z-index: 2;\n      background: var(--cream);\n    }\n\n    .nav {\n      min-height: 82px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 24px;\n    }\n\n    .brand {\n      display: inline-flex;\n      align-items: center;\n      gap: 10px;\n      font-weight: 1000;\n      font-size: 24px;\n      letter-spacing: -1.2px;\n    }\n\n    .brand-mark {\n      width: 38px;\n      height: 38px;\n      display: grid;\n      place-items: center;\n      border-radius: 13px 13px 13px 4px;\n      color: var(--ink);\n      background: var(--coral);\n      transform: rotate(-5deg);\n    }\n\n    .brand-mark svg { width: 25px; height: 25px; }\n\n    .nav-links {\n      display: flex;\n      align-items: center;\n      gap: 30px;\n      font-size: 14px;\n      font-weight: 700;\n    }\n\n    .nav-links a:not(.nav-cta):hover { color: #e85449; }\n\n    .nav-cta, .button {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: 10px;\n      min-height: 48px;\n      padding: 0 21px;\n      border-radius: 999px;\n      background: var(--ink);\n      color: white;\n      font-size: 14px;\n      font-weight: 800;\n      transition: transform .2s, box-shadow .2s;\n    }\n\n    .nav-cta:hover, .button:hover {\n      transform: translateY(-2px);\n      box-shadow: 0 8px 18px #17223b25;\n    }\n\n    .hero {\n      padding: 42px 0 66px;\n      overflow: hidden;\n    }\n\n    .hero-grid {\n      display: grid;\n      grid-template-columns: 1fr 1.02fr;\n      align-items: center;\n      gap: 54px;\n    }\n\n    .eyebrow {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      margin-bottom: 18px;\n      color: #e45f50;\n      font-size: 12px;\n      font-weight: 900;\n      letter-spacing: .13em;\n      text-transform: uppercase;\n    }\n\n    .eyebrow::before {\n      content: \"\";\n      width: 22px;\n      height: 3px;\n      border-radius: 3px;\n      background: currentColor;\n    }\n\n    h1, h2, h3, p { margin-top: 0; }\n\n    h1 {\n      max-width: 570px;\n      margin-bottom: 22px;\n      font-size: clamp(48px, 6.4vw, 82px);\n      line-height: .98;\n      letter-spacing: -.075em;\n    }\n\n    h1 span {\n      position: relative;\n      z-index: 0;\n      white-space: nowrap;\n    }\n\n    h1 span::after {\n      content: \"\";\n      position: absolute;\n      z-index: -1;\n      left: 0;\n      right: -5px;\n      bottom: 4px;\n      height: 17px;\n      border-radius: 12px;\n      background: var(--yellow);\n      transform: rotate(-2deg);\n    }\n\n    .hero-copy {\n      max-width: 460px;\n      margin-bottom: 27px;\n      color: var(--muted);\n      font-size: 17px;\n      line-height: 1.7;\n    }\n\n    .hero-actions {\n      display: flex;\n      flex-wrap: wrap;\n      align-items: center;\n      gap: 12px;\n    }\n\n    .button.primary { background: var(--coral); }\n    .button.secondary {\n      color: var(--ink);\n      background: transparent;\n      border: 1.5px solid #d8d4cb;\n    }\n\n    .button .arrow { font-size: 19px; line-height: 0; }\n\n    .hero-note {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      margin-top: 24px;\n      color: var(--muted);\n      font-size: 12px;\n      font-weight: 700;\n    }\n\n    .avatar-stack { display: flex; padding-left: 2px; }\n    .avatar {\n      width: 27px;\n      height: 27px;\n      display: grid;\n      place-items: center;\n      margin-left: -4px;\n      border: 2px solid var(--cream);\n      border-radius: 50%;\n      background: var(--blue);\n      font-size: 14px;\n    }\n    .avatar:nth-child(2) { background: var(--coral); }\n    .avatar:nth-child(3) { background: var(--yellow); }\n\n    .hero-art {\n      position: relative;\n      min-height: 470px;\n      display: grid;\n      place-items: center;\n      border-radius: 46% 54% 44% 56% / 51% 42% 58% 49%;\n      background: #bdebf0;\n      isolation: isolate;\n    }\n\n    .hero-art::before {\n      content: \"\";\n      position: absolute;\n      z-index: -1;\n      inset: 20px -22px -17px 24px;\n      border: 2px dashed #17223b36;\n      border-radius: 53% 47% 57% 43% / 42% 54% 46% 58%;\n      transform: rotate(5deg);\n    }\n\n    .art-sun {\n      position: absolute;\n      top: 37px;\n      right: 53px;\n      width: 77px;\n      height: 77px;\n      border-radius: 50%;\n      background: var(--yellow);\n      box-shadow: 0 0 0 12px #ffd65a33;\n    }\n\n    .art-sun::before, .art-sun::after {\n      content: \"\u2726\";\n      position: absolute;\n      color: var(--ink);\n      font-size: 21px;\n    }\n    .art-sun::before { top: -12px; left: -17px; }\n    .art-sun::after { right: -17px; bottom: 0; font-size: 15px; }\n\n    .art-label {\n      position: absolute;\n      z-index: 1;\n      top: 40px;\n      left: 27px;\n      padding: 10px 15px;\n      border: 2px solid var(--ink);\n      border-radius: 50%;\n      background: var(--paper);\n      font-size: 12px;\n      font-weight: 900;\n      transform: rotate(-9deg);\n    }\n\n    .art-label::after {\n      content: \"\u2198\";\n      position: absolute;\n      right: -24px;\n      bottom: -26px;\n      font-size: 24px;\n      transform: rotate(17deg);\n    }\n\n    .art-svg {\n      width: min(87%, 470px);\n      height: auto;\n      overflow: visible;\n      filter: drop-shadow(0 18px 10px #17223b18);\n    }\n\n    .float-star {\n      position: absolute;\n      color: var(--coral);\n      font-size: 34px;\n      animation: bob 3s ease-in-out infinite;\n    }\n    .star-one { left: 8%; bottom: 24%; }\n    .star-two { right: 8%; bottom: 20%; color: #8871dc; animation-delay: .7s; }\n    .float-dot {\n      position: absolute;\n      left: 17%;\n      top: 28%;\n      width: 13px;\n      height: 13px;\n      border-radius: 50%;\n      background: var(--coral);\n    }\n\n    @keyframes bob {\n      50% { transform: translateY(-8px) rotate(8deg); }\n    }\n\n    .ticker {\n      background: var(--ink);\n      color: white;\n      overflow: hidden;\n    }\n    .ticker-inner {\n      min-height: 54px;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      flex-wrap: wrap;\n      gap: 13px 25px;\n      padding: 12px 0;\n      font-size: 12px;\n      font-weight: 800;\n      letter-spacing: .08em;\n      text-transform: uppercase;\n    }\n    .ticker span { color: var(--yellow); font-size: 17px; }\n\n    .section { padding: 88px 0; }\n    .section-heading {\n      display: flex;\n      align-items: end;\n      justify-content: space-between;\n      gap: 24px;\n      margin-bottom: 32px;\n    }\n\n    .section-heading h2 {\n      max-width: 540px;\n      margin: 0;\n      font-size: clamp(34px, 4vw, 50px);\n      line-height: 1.05;\n      letter-spacing: -.06em;\n    }\n\n    .section-heading p {\n      max-width: 350px;\n      margin: 0;\n      color: var(--muted);\n      line-height: 1.65;\n    }\n\n    .text-link {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      white-space: nowrap;\n      font-size: 14px;\n      font-weight: 900;\n    }\n    .text-link:hover { color: #e85449; }\n\n    .exhibit-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 18px;\n    }\n\n    .exhibit-card {\n      min-height: 300px;\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      padding: 25px;\n      border-radius: var(--radius);\n      overflow: hidden;\n      transition: transform .2s;\n    }\n    .exhibit-card:hover { transform: translateY(-5px); }\n    .exhibit-card:nth-child(1) { background: var(--yellow); }\n    .exhibit-card:nth-child(2) { background: var(--lavender); }\n    .exhibit-card:nth-child(3) { background: var(--green); }\n\n    .exhibit-top {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n    }\n    .tag {\n      padding: 7px 10px;\n      border-radius: 99px;\n      background: #ffffff80;\n      font-size: 10px;\n      font-weight: 900;\n      letter-spacing: .08em;\n      text-transform: uppercase;\n    }\n    .card-icon {\n      width: 88px;\n      height: 88px;\n      display: grid;\n      place-items: center;\n      border: 2px solid #17223b25;\n      border-radius: 50%;\n      background: #ffffff48;\n      font-size: 43px;\n      transform: rotate(-8deg);\n    }\n    .exhibit-card h3 {\n      margin: 0 0 8px;\n      font-size: 25px;\n      letter-spacing: -.05em;\n    }\n    .exhibit-card p {\n      max-width: 270px;\n      margin: 0;\n      color: #17223bcc;\n      font-size: 14px;\n      line-height: 1.55;\n    }\n\n    .visit-band {\n      display: grid;\n      grid-template-columns: 1.1fr .9fr;\n      align-items: center;\n      gap: 35px;\n      padding: 42px;\n      border-radius: 30px;\n      background: #f1eaff;\n    }\n    .visit-band h2 {\n      margin-bottom: 12px;\n      font-size: clamp(32px, 4vw, 46px);\n      line-height: 1.05;\n      letter-spacing: -.06em;\n    }\n    .visit-band p {\n      max-width: 470px;\n      margin-bottom: 22px;\n      color: var(--muted);\n      line-height: 1.65;\n    }\n    .visit-facts {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 12px;\n    }\n    .fact {\n      padding: 18px;\n      border: 1px solid #17223b16;\n      border-radius: 16px;\n      background: #ffffffa6;\n    }\n    .fact strong {\n      display: block;\n      margin-bottom: 5px;\n      font-size: 13px;\n    }\n    .fact span {\n      color: var(--muted);\n      font-size: 12px;\n      line-height: 1.5;\n    }\n\n    .events { background: var(--paper); }\n    .event-list { display: grid; gap: 12px; }\n    .event {\n      display: grid;\n      grid-template-columns: 80px 1fr auto;\n      align-items: center;\n      gap: 22px;\n      padding: 17px 21px;\n      border: 1px solid #eae8e2;\n      border-radius: 18px;\n      transition: border-color .2s, transform .2s;\n    }\n    .event:hover { border-color: var(--coral); transform: translateX(3px); }\n    .event-date {\n      width: 66px;\n      height: 66px;\n      display: grid;\n      place-content: center;\n      border-radius: 14px;\n      background: #fff0d1;\n      text-align: center;\n    }\n    .event-date span {\n      font-size: 10px;\n      font-weight: 900;\n      letter-spacing: .1em;\n      text-transform: uppercase;\n    }\n    .event-date strong { font-size: 23px; line-height: 1.1; }\n    .event h3 { margin: 0 0 5px; font-size: 17px; }\n    .event p { margin: 0; color: var(--muted); font-size: 13px; }\n    .event-arrow { font-size: 23px; font-weight: 700; }\n\n    .newsletter {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 28px;\n      padding: 33px 38px;\n      border-radius: 24px;\n      background: var(--blue);\n    }\n    .newsletter h2 {\n      margin: 0 0 7px;\n      font-size: 29px;\n      letter-spacing: -.05em;\n    }\n    .newsletter p { margin: 0; color: #33465b; font-size: 14px; }\n    .signup {\n      display: flex;\n      width: min(100%, 410px);\n      padding: 5px;\n      border-radius: 999px;\n      background: white;\n    }\n    .signup input {\n      min-width: 0;\n      flex: 1;\n      padding: 0 15px;\n      border: 0;\n      outline: 0;\n      border-radius: 999px;\n      color: var(--ink);\n      font: inherit;\n      font-size: 13px;\n    }\n    .signup button {\n      min-height: 43px;\n      padding: 0 17px;\n      border: 0;\n      border-radius: 999px;\n      color: white;\n      background: var(--ink);\n      font: inherit;\n      font-size: 12px;\n      font-weight: 800;\n      cursor: pointer;\n    }\n\n    footer {\n      padding: 37px 0 26px;\n      background: var(--cream);\n    }\n    .footer-row {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 20px;\n      padding-bottom: 24px;\n      border-bottom: 1px solid #17223b1a;\n    }\n    .footer-links {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 22px;\n      color: var(--muted);\n      font-size: 12px;\n      font-weight: 700;\n    }\n    .copyright {\n      padding-top: 17px;\n      color: #8990a0;\n      font-size: 11px;\n    }\n\n    @media (max-width: 850px) {\n      .nav-links { gap: 17px; }\n      .hero-grid { gap: 28px; }\n      .hero-art { min-height: 390px; }\n      .section { padding: 68px 0; }\n      .visit-band { padding: 30px; }\n    }\n\n    @media (max-width: 680px) {\n      .shell { width: min(100% - 32px, 540px); }\n      .announcement { font-size: 11px; }\n      .nav { min-height: 70px; }\n      .brand { font-size: 21px; }\n      .nav-links a:not(.nav-cta) { display: none; }\n      .nav-cta { min-height: 42px; padding: 0 15px; font-size: 12px; }\n      .hero { padding: 25px 0 47px; }\n      .hero-grid { grid-template-columns: 1fr; gap: 34px; }\n      h1 { font-size: clamp(52px, 14vw, 76px); }\n      .hero-copy { font-size: 15px; }\n      .hero-art { min-height: 340px; margin: 0 10px 5px; }\n      .art-svg { width: 88%; }\n      .art-label { top: 24px; left: 13px; }\n      .ticker-inner { gap: 8px 14px; font-size: 10px; }\n      .section-heading { align-items: start; flex-direction: column; }\n      .section-heading p { font-size: 14px; }\n      .exhibit-grid { grid-template-columns: 1fr; }\n      .exhibit-card { min-height: 250px; }\n      .visit-band { grid-template-columns: 1fr; gap: 24px; padding: 26px 22px; }\n      .event { grid-template-columns: 58px 1fr auto; gap: 12px; padding: 13px; }\n      .event-date { width: 54px; height: 58px; }\n      .event h3 { font-size: 15px; }\n      .event p { font-size: 11px; }\n      .event-arrow { font-size: 19px; }\n      .newsletter { align-items: stretch; flex-direction: column; padding: 27px 22px; }\n      .signup { width: 100%; }\n      .footer-row { align-items: flex-start; flex-direction: column; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      *, *::before, *::after {\n        scroll-behavior: auto !important;\n        animation-duration: .01ms !important;\n        animation-iteration-count: 1 !important;\n        transition-duration: .01ms !important;\n      }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"announcement\">\n    Little scientists, big discoveries \u2014 summer camp registration is open!\n    <a href=\"#events\">Explore camps \u2197</a>\n  </div>\n\n  <header>\n    <nav class=\"nav shell\" aria-label=\"Main navigation\">\n      <a class=\"brand\" href=\"#\" aria-label=\"WonderLab home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 32 32\" fill=\"none\">\n            <path d=\"M10 5h12M13 5v8l-6 11a2 2 0 0 0 1.8 3h14.4a2 2 0 0 0 1.8-3l-6-11V5\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            <path d=\"M10 21h12\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n            <circle cx=\"14\" cy=\"18\" r=\"1.3\" fill=\"currentColor\"/>\n            <circle cx=\"19\" cy=\"24\" r=\"1.3\" fill=\"currentColor\"/>\n          </svg>\n        </span>\n        wonderlab\n      </a>\n      <div class=\"nav-links\">\n        <a href=\"#exhibits\">Explore</a>\n        <a href=\"#visit\">Plan your visit</a>\n        <a href=\"#events\">What's on</a>\n        <a class=\"nav-cta\" href=\"#visit\">Get tickets <span aria-hidden=\"true\">\u2197</span></a>\n      </div>\n    </nav>\n  </header>\n\n  <main>\n    <section class=\"hero\">\n      <div class=\"hero-grid shell\">\n        <div>\n          <div class=\"eyebrow\">A hands-on science museum</div>\n          <h1>Big questions.<br>Little <span>explorers.</span></h1>\n          <p class=\"hero-copy\">\n            Come get wonderfully curious. From giant bubbles to wiggly worms,\n            WonderLab is where kids discover that science is all around them.\n          </p>\n          <div class=\"hero-actions\">\n            <a class=\"button primary\" href=\"#visit\">Plan your visit <span class=\"arrow\" aria-hidden=\"true\">\u2192</span></a>\n            <a class=\"button secondary\" href=\"#exhibits\">Explore exhibits</a>\n          </div>\n          <div class=\"hero-note\">\n            <div class=\"avatar-stack\" aria-hidden=\"true\">\n              <span class=\"avatar\">\ud83e\uddd2</span><span class=\"avatar\">\ud83d\udc67</span><span class=\"avatar\">\ud83e\uddd1</span>\n            </div>\n            <span>Made for curious minds ages 2\u201312</span>\n          </div>\n        </div>\n\n        <div class=\"hero-art\" aria-label=\"Illustration of a colorful science experiment\">\n          <div class=\"art-sun\" aria-hidden=\"true\"></div>\n          <div class=\"art-label\">WOW!<br>SCIENCE</div>\n          <span class=\"float-dot\" aria-hidden=\"true\"></span>\n          <span class=\"float-star star-one\" aria-hidden=\"true\">\u2726</span>\n          <span class=\"float-star star-two\" aria-hidden=\"true\">\u2733</span>\n          <svg class=\"art-svg\" viewBox=\"0 0 500 420\" role=\"img\" aria-labelledby=\"art-title\">\n            <title id=\"art-title\">A bubbling beaker and a happy little planet</title>\n            <ellipse cx=\"250\" cy=\"375\" rx=\"155\" ry=\"17\" fill=\"#17223b\" opacity=\".12\"/>\n            <!-- orbit -->\n            <ellipse cx=\"263\" cy=\"185\" rx=\"191\" ry=\"92\" fill=\"none\" stroke=\"#17223b\" stroke-width=\"3\" stroke-dasharray=\"7 11\" transform=\"rotate(-17 263 185)\" opacity=\".45\"/>\n            <!-- planet -->\n            <g transform=\"translate(355 76) rotate(12)\">\n              <circle cx=\"42\" cy=\"42\" r=\"38\" fill=\"#ff705e\" stroke=\"#17223b\" stroke-width=\"3\"/>\n              <ellipse cx=\"42\" cy=\"42\" rx=\"59\" ry=\"17\" fill=\"none\" stroke=\"#17223b\" stroke-width=\"5\" transform=\"rotate(-18 42 42)\"/>\n              <circle cx=\"30\" cy=\"37\" r=\"3.5\" fill=\"#17223b\"/>\n              <circle cx=\"53\" cy=\"37\" r=\"3.5\" fill=\"#17223b\"/>\n              <path d=\"M33 51q9 9 18 0\" fill=\"none\" stroke=\"#17223b\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n            </g>\n            <!-- bubbles -->\n            <circle cx=\"127\" cy=\"127\" r=\"17\" fill=\"#fff\" stroke=\"#17223b\" stroke-width=\"3\"/>\n            <circle cx=\"168\" cy=\"96\" r=\"10\" fill=\"#ffd65a\" stroke=\"#17223b\" stroke-width=\"3\"/>\n            <circle cx=\"113\" cy=\"183\" r=\"8\" fill=\"#c9b8ff\" stroke=\"#17223b\" stroke-width=\"3\"/>\n            <path d=\"M122 124l7 4\" stroke=\"#fff\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n            <!-- beaker -->\n            <path d=\"M185 107h124M211 107v65l-68 133c-9 18 4 40 24 40h152c20 0 33-22 24-40l-68-133v-65\" fill=\"#fff9ed\" stroke=\"#17223b\" stroke-width=\"7\" stroke-linejoin=\"round\"/>\n            <path d=\"M181 241c35-18 54 10 87 0 32-10 52-21 85-1l22 43c8 15-3 33-20 33H164c-17 0-28-18-20-33z\" fill=\"#75d8e8\"/>\n            <path d=\"M181 241c35-18 54 10 87 0 32-10 52-21 85-1\" fill=\"none\" stroke=\"#17223b\" stroke-width=\"6\" stroke-linecap=\"round\"/>\n            <path d=\"M224 191h33M217 210h24M278 190h23\" stroke=\"#17223b\" stroke-width=\"4\" stroke-linecap=\"round\" opacity=\".55\"/>\n            <!-- little bubbles in liquid -->\n            <circle cx=\"207\" cy=\"267\" r=\"8\" fill=\"#fff\" stroke=\"#17223b\" stroke-width=\"3\"/>\n            <circle cx=\"285\" cy=\"278\" r=\"12\" fill=\"#ffd65a\" stroke=\"#17223b\" stroke-width=\"3\"/>\n            <circle cx=\"327\" cy=\"257\" r=\"6\" fill=\"#c9b8ff\" stroke=\"#17223b\" stroke-width=\"3\"/>\n            <!-- base -->\n            <path d=\"M187 347h126\" stroke=\"#17223b\" stroke-width=\"7\" stroke-linecap=\"round\"/>\n            <!-- sparkles -->\n            <path d=\"M91 263l5 12 12 5-12 5-5 12-5-12-12-5 12-5z\" fill=\"#ffd65a\" stroke=\"#17223b\" stroke-width=\"2\"/>\n            <path d=\"M393 237l4 9 9 4-9 4-4 9-4-9-9-4 9-4z\" fill=\"#c9b8ff\" stroke=\"#17223b\" stroke-width=\"2\"/>\n          </svg>\n        </div>\n      </div>\n    </section>\n\n    <div class=\"ticker\" aria-label=\"Museum highlights\">\n      <div class=\"ticker-inner shell\">\n        <span>\u2726</span> Play is how we learn <span>\u2726</span>\n        100+ things to touch <span>\u2726</span>\n        Wonder every day <span>\u2726</span>\n      </div>\n    </div>\n\n    <section class=\"section shell\" id=\"exhibits\">\n      <div class=\"section-heading\">\n        <div>\n          <div class